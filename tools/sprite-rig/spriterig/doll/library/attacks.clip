clip bow_shot
fps 12
loop no
weapon bow
tags attack ranged
# left hand holds the bow out; right hand draws to the cheek (string follows the right hand automatically)
0   larm=30,0,10 lfore=40 rarm=20,0,10 rfore=40 lleg=12 lknee=8 rleg=-8 spine=4 bob=-0.02
3   ease=out  raise  larm=88,0,-5 lfore=0 rarm=85,0,-25 rfore=100 spine=0,30,0 head=0,-25,0
7   ease=inout  draw  rarm=80,0,35 rfore=150 rhand=0,0,0 spine=-4,40,0
9   hold
10  ease=snap hit  release  rarm=70,0,70 rfore=20
12  ease=back  rarm=60,0,80 rfore=10 spine=-2,35,0
16  ease=out  =0

