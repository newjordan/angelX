# Weapon attack library. `weapon` lists the weapon types a clip suits (first = best).
# Every attack: guard -> anticipation (ease=out) -> strike (ease=in, smear, hit) -> follow-through (ease=back/out) -> recover.
# Shared guard pose (copy/paste-friendly):
#   rarm=25,0,10 rfore=75 larm=15,0,15 lfore=45 lleg=12 lknee=10 rleg=-8 rknee=12 spine=6 bob=-0.03

clip guard
fps 8
weapon sword axe dagger greatsword spear staff shield bow unarmed
tags idle
0   rarm=25,0,10 rfore=75 larm=15,0,15 lfore=45 lleg=12 lknee=10 rleg=-8 rknee=12 spine=6 bob=-0.03
4   rarm=27,0,10 rfore=78 larm=17,0,15 lfore=48 spine=8 bob=-0.045
8   =0

clip slash
fps 12
loop no
weapon sword axe dagger
tags attack
0   rarm=25,0,10 rfore=75 larm=15,0,15 lfore=45 lleg=12 lknee=10 rleg=-8 rknee=12 spine=6 bob=-0.03
3   ease=out  anticipation  rarm=155,0,25 rfore=35 spine=-8,-25,0 chest=0,-10 larm=40,0,20 lfore=60
5   ease=in smear hit  rarm=40,0,-15 rfore=5 spine=18,20,0 chest=0,10 lleg=30 lknee=25 rleg=-25 bob=-0.08
7   ease=back  follow  rarm=0,0,-25 rfore=15 spine=22,30,0
10  ease=out  rarm=15,0,5 rfore=60 spine=10,5,0 chest=0,0 bob=-0.04
13  =0

clip overhead
fps 12
loop no
weapon greatsword axe sword
tags attack heavy
0   rarm=25,0,10 rfore=75 larm=15,0,15 lfore=45 lleg=12 lknee=10 rleg=-8 rknee=12 spine=6 bob=-0.03
4   ease=out  windup  rarm=175,0,5 rfore=40 larm=170,0,-10 lfore=45 spine=-15 chest=-8 bob=0.0 lleg=5
5   hold
7   ease=in smear hit  rarm=45,0,-5 rfore=0 larm=45,0,-5 lfore=5 spine=35 chest=10 lleg=35 lknee=40 rleg=-25 rknee=10 bob=-0.14
10  ease=back  rarm=25,0,-5 larm=25,0,-5 spine=40 bob=-0.15
14  ease=out  rarm=25,0,10 rfore=75 larm=15,0,15 lfore=45 spine=10 chest=0 lleg=12 lknee=10 rleg=-8 rknee=12 bob=-0.04
16  =0

clip thrust
fps 12
loop no
weapon spear sword dagger staff
tags attack
0   rarm=25,0,10 rfore=75 larm=15,0,15 lfore=45 lleg=12 lknee=10 rleg=-8 rknee=12 spine=6 bob=-0.03
3   ease=out  pullback  rarm=-25,0,15 rfore=110 larm=40,0,5 lfore=70 spine=-6,-20,0 hips=0,-0.03,-0.06
5   ease=in smear hit  rarm=88,0,-5 rfore=0 rhand=0,0,0 larm=-10,0,20 lfore=20 spine=14,15,0 lleg=45 lknee=35 rleg=-30 hips=0,-0.10,0.16
8   ease=back  rarm=80,0,0 spine=12,10,0 hips=0,-0.09,0.12
