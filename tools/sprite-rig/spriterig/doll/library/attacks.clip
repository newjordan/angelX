9   smear  root=0,-360,0 rarm=70,0,60
12  ease=out  root=0,-360,0 rarm=25,0,10 rfore=75 larm=15,0,15 lfore=45 spine=6 bob=-0.03

clip combo
fps 12
loop no
weapon sword axe dagger
tags attack combo
# three-hit chain: forehand, backhand, finishing thrust (hits on 4, 8, 14)
