# Native build outputs, credentials and private operator state
**/target*/
# This Rust module directory is source, not a Cargo build output.
!cockpit/src/agent/tools/build/targets/
!cockpit/src/agent/tools/build/targets/**
**/node_modules/
**/.venv/
**/__pycache__/
**/.angel*/
**/.local/
**/.rustup/
**/.dream-loop/
**/.cache/
**/.pytest_cache/
**/.env
**/.env.*
# Repo-local operator env (live API keys, host aliases); sourced by bin/angelX.
.angel.env
.angel.*.env
**/*.log
**/*.err
**/*.swp
**/*.pem
**/*.key
notes/first-run-playground/
off-limits/
.github/workflows/
angel_test_output/
.astra-tmp/
.refactor-notes/
artifacts/
.vercel
.vercelignore
website/
HANDOFF.md

# Research-map state that `/labyrinth init` writes into this checkout.
/labyrinth/
cockpit/systems/*/engine
cockpit/systems/*/*.pending
# Locally harvested art/code datasets (licences recorded per item in their own
# manifest/; nothing here is distributable from this repo).
/datasets/
delve/build/
