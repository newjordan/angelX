# landmark (assets/world3d/lighthouse/landmark.set, hand-placed)
# The Bickering Beacon: the lighthouse itself, a banded tower on a rocky point
# of the back edge, over the tree line, its lamp lit.
rock-3     rock    at 300 0 -8 size 64 12 44 id light-point
rock-5     rock    at 340 0 -6 size 26 9 28 id light-rock-e
rock-9     rock    at 262 0 -8 size 24 8 26 id light-rock-w
