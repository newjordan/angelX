set training-yard
# The Training Yard: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Painted on open floor, not blocks: straw on the flags, three quintains at (6.5,6.5) (12,6.5) (17.5,6.5), archery butts and blade racks on the north wall, torches at the way back down.

# the ground: its top is the floor line
box    floor   at 192 -4 112 size 384 4 224

# the north wall, columns 0 to 23
box    stone   at 192 -4 8 size 384 52 16

# the south wall, columns 0 to 10 (at 81% of its height, for the camera)
box    stone   at 88 -4 212 size 176 10 8  # TODO prims: wedge
box    stone   at 88 -4 220 size 176 16.5 8

# the south wall, columns 13 to 23 (at 81% of its height, for the camera)
box    stone   at 296 -4 212 size 176 10 8  # TODO prims: wedge
box    stone   at 296 -4 220 size 176 16.5 8

# the west wall, rows 1 to 12
box    stone   at 8 -4 112 size 16 52 192

# the east wall, rows 1 to 12
box    stone   at 376 -4 112 size 16 52 192

# the south door, columns 11 to 12
box    door    at 192 -4 225 size 32 5 2 id door-south

# stall at 17,9 6x2 (at 74% of its height, for the camera)
box    wood    at 320 0 169 size 92 8.5 10 id stall
box    cloth   at 280 8.5 169 size 6 2.5 6
box    cloth   at 292 8.5 169 size 6 2.5 6
box    cloth   at 304 8.5 169 size 6 2.5 6
box    cloth   at 316 8.5 169 size 6 2.5 6
box    cloth   at 328 8.5 169 size 6 2.5 6
box    cloth   at 340 8.5 169 size 6 2.5 6
box    cloth   at 352 8.5 169 size 6 2.5 6
box    wood    at 274 0 159 size 2 16 2
box    wood    at 366 0 159 size 2 16 2
box    wood    at 274 0 174 size 2 16 2
box    wood    at 366 0 174 size 2 16 2
box    cloth   at 320 16 166.5 size 94 1.5 17  # TODO prims: wedge
