set keg-yard
# Powder Keg Yard: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Painted on open floor, not blocks: the posts and bales in the courtyard, the knights' bench and a rack of spare kegs along the west wall, a stone dais under the start mark, the gate home (2,12).

# the ground: its top is the floor line
box    floor   at 192 -4 8 size 384 4 16
box    floor   at 8 -4 120 size 16 4 208
box    sand    at 192 -4 24 size 352 4 16
box    floor   at 376 -4 120 size 16 4 208
box    sand    at 56 -4 120 size 80 4 176
box    road    at 192 -4 112 size 192 4 160
box    sand    at 328 -4 120 size 80 4 176
box    sand    at 192 -4 200 size 192 4 16
box    floor   at 192 -4 216 size 352 4 16

# the north wall, columns 0 to 23
box    stone   at 192 -4 8 size 384 52 16

# the south wall, columns 0 to 23 (at 81% of its height, for the camera)
box    stone   at 192 -4 212 size 384 10 8  # TODO prims: wedge
box    stone   at 192 -4 220 size 384 16.5 8

# the west wall, rows 1 to 12
box    stone   at 8 -4 112 size 16 52 192

# the east wall, rows 1 to 12
box    stone   at 376 -4 112 size 16 52 192

# stand at 6,1 17x1
box    slate   at 232 0 28.67 size 270 6 4.67 id stand-1  # TODO prims: stairs
box    slate   at 232 0 24 size 270 9 4.67
box    slate   at 232 0 19.33 size 270 12 4.67

# stand at 18,2 5x10
box    slate   at 293.88 0 112 size 9.75 6 158 id stand-2  # TODO prims: stairs
box    slate   at 303.63 0 112 size 9.75 9 158
box    slate   at 313.38 0 112 size 9.75 12 158
box    slate   at 323.13 0 112 size 9.75 15 158
box    slate   at 332.88 0 112 size 9.75 18 158
box    slate   at 342.63 0 112 size 9.75 21 158
box    slate   at 352.38 0 112 size 9.75 24 158
box    slate   at 362.13 0 112 size 9.75 27 158

# stand at 6,12 17x1
box    slate   at 232 0 195.33 size 270 6 4.67 id stand-3  # TODO prims: stairs
box    slate   at 232 0 200 size 270 9 4.67
box    slate   at 232 0 204.67 size 270 12 4.67

# plate at 2,12 2x1
box    stone   at 48 0 200 size 30 1.5 14 id plate  # TODO prims: stairs

# landmark (assets/world3d/keg-yard/landmark.set, hand-placed)
# Powder Keg Yard: a thick-walled powder magazine with its lightning rod over the north wall, and kegs stacked on the north tiers.
# Hand-placed by the landmark pass on the room's blocked back band and what lies behind it,
# so it never stands on a tile a knight walks or hides the floor from the camera.

# the powder magazine, rising over the north wall in the west
box    stone   at 52 0 0 size 64 62 28 id lm-magazine
hip    slate   at 52 62 0 size 72 14 30
cylinder-8 metal   at 52 76 0 size 2.5 8 2.5 id lm-rod
box    door    at 52 0 14.2 size 16 26 2
box    metal   at 34 52 14.2 size 7 8 1.5
box    metal   at 70 52 14.2 size 7 8 1.5
# kegs stacked in threes on the north tiers, standing on the top tier
cylinder-10 wood    at 140 9 20.5 size 9 9 9
cylinder-10 wood    at 150 9 20.5 size 9 9 9
cylinder-10 wood    at 160 9 20.5 size 9 9 9
cylinder-10 wood    at 145 18 20.5 size 9 9 9
cylinder-10 wood    at 155 18 20.5 size 9 9 9
cylinder-10 wood    at 150 27 20.5 size 9 9 9
cylinder-10 wood    at 220 9 20.5 size 9 9 9
cylinder-10 wood    at 230 9 20.5 size 9 9 9
cylinder-10 wood    at 240 9 20.5 size 9 9 9
cylinder-10 wood    at 225 18 20.5 size 9 9 9
cylinder-10 wood    at 235 18 20.5 size 9 9 9
cylinder-10 wood    at 230 27 20.5 size 9 9 9
