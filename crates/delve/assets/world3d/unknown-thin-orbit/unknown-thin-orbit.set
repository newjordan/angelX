set unknown-thin-orbit
# The Thin Orbit: 32 x 20 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 512 320
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 256 -4 40 size 512 4 80
box    floor   at 40 -4 200 size 80 4 240
box    floor   at 144 -4 96 size 64 4 32
box    floor   at 256 -4 200 size 96 4 240
box    floor   at 368 -4 96 size 64 4 32
box    floor   at 472 -4 200 size 80 4 240
box    floor   at 96 -4 104 size 32 4 16
box    floor   at 192 -4 160 size 32 4 128
box    floor   at 320 -4 160 size 32 4 128
box    floor   at 416 -4 104 size 32 4 16
box    floor   at 152 -4 216 size 48 4 208
box    floor   at 360 -4 216 size 48 4 208
box    floor   at 104 -4 160 size 48 4 64
box    floor   at 408 -4 160 size 48 4 64
box    floor   at 104 -4 216 size 48 4 16
box    floor   at 408 -4 216 size 48 4 16
box    floor   at 120 -4 272 size 16 4 96
box    floor   at 392 -4 272 size 16 4 96
box    floor   at 96 -4 280 size 32 4 80
box    floor   at 192 -4 280 size 32 4 80
box    floor   at 320 -4 280 size 32 4 80
box    floor   at 416 -4 280 size 32 4 80

# pits: holes in the floor, dark below

# the north wall, columns 0 to 14
box    stone   at 120 -4 8 size 240 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8

# the north wall, columns 17 to 31
box    stone   at 392 -4 8 size 240 52 16
box    metal   at 504 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 504 51 8 size 8 10.4 8

# the south wall, columns 0 to 14 (at 81% of its height, for the camera)
box    stone   at 120 -4 308 size 240 10 8  # TODO prims: wedge
box    stone   at 120 -4 316 size 240 16.5 8
box    metal   at 8 12.5 316 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 8 15 316 size 6 6.5 6

# the south wall, columns 17 to 31 (at 81% of its height, for the camera)
box    stone   at 392 -4 308 size 240 10 8  # TODO prims: wedge
box    stone   at 392 -4 316 size 240 16.5 8
box    metal   at 504 12.5 316 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 504 15 316 size 6 6.5 6

# the west wall, rows 1 to 8
box    stone   at 8 -4 80 size 16 52 128

# the west wall, rows 11 to 18 (at 12% of its height, for the camera)
box    stone   at 8 -4 200 size 16 9.5 48  # TODO prims: wedge
box    stone   at 8 -4 264 size 16 52 80

# the east wall, rows 1 to 8
box    stone   at 504 -4 80 size 16 52 128

# the east wall, rows 11 to 18 (at 12% of its height, for the camera)
box    stone   at 504 -4 200 size 16 9.5 48  # TODO prims: wedge
box    stone   at 504 -4 264 size 16 52 80

# the north door, columns 15 to 16
box    door    at 256 -4 -1 size 32 36 2 id door-north
box    stone   at 256 32 8 size 32 16 16  # TODO prims: arch

# the south door, columns 15 to 16
box    door    at 256 -4 321 size 32 5 2 id door-south

# the west door, rows 9 to 10
box    door    at -1 -4 160 size 2 36 32 id door-west
box    stone   at 8 32 160 size 16 16 32  # TODO prims: arch

# the east door, rows 9 to 10
box    door    at 513 -4 160 size 2 36 32 id door-east
box    stone   at 504 32 160 size 16 16 32  # TODO prims: arch

