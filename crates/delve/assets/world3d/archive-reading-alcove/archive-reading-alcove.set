box    wood    at 120 0 40 size 15 4.5 15
box    wood    at 136 0 40 size 15 4.5 15

# shelf at 15,2 3x1 (at 19% of its height, for the camera)
box    wood    at 248 0 40 size 15 5 15 id shelf-3
box    wood    at 264 0 40 size 15 5 15
box    wood    at 280 0 40 size 15 4.5 15

# shelf at 19,2 3x1 (at 19% of its height, for the camera)
box    wood    at 312 0 40 size 15 5 15 id shelf-4
box    wood    at 328 0 40 size 15 4.5 15
box    wood    at 344 0 40 size 15 4.5 15

# shelf at 7,3 2x2 (at 69% of its height, for the camera)
