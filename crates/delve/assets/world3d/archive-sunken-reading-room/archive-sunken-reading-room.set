set archive-sunken-reading-room
# The Sunken Reading Room: 34 x 20 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 544 320
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 272 -4 40 size 544 4 80
box    floor   at 56 -4 88 size 112 4 16
box    floor   at 272 -4 200 size 160 4 240
box    floor   at 488 -4 88 size 112 4 16
box    floor   at 48 -4 208 size 96 4 224
box    floor   at 496 -4 208 size 96 4 224
box    floor   at 144 -4 160 size 96 4 96
box    floor   at 400 -4 160 size 96 4 96
box    floor   at 104 -4 272 size 16 4 96
box    floor   at 440 -4 272 size 16 4 96
box    floor   at 152 -4 280 size 80 4 80
box    floor   at 392 -4 280 size 80 4 80

# water, 3 below the floor line
box    water   at 152 -4 96 size 80 1 32
box    water   at 392 -4 96 size 80 1 32
box    water   at 104 -4 104 size 16 1 16
box    water   at 440 -4 104 size 16 1 16
box    water   at 144 -4 216 size 96 1 16
box    water   at 400 -4 216 size 96 1 16
box    water   at 152 -4 232 size 80 1 16
box    water   at 392 -4 232 size 80 1 16

