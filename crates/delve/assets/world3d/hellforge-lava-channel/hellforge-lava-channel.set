set hellforge-lava-channel
# The Lava Channel: 34 x 20 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 544 320
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 272 -4 24 size 544 4 48
box    floor   at 24 -4 184 size 48 4 272
box    floor   at 104 -4 184 size 16 4 272
box    floor   at 168 -4 184 size 16 4 272
box    floor   at 272 -4 184 size 96 4 272
box    floor   at 376 -4 184 size 16 4 272
box    floor   at 440 -4 184 size 16 4 272
box    floor   at 520 -4 184 size 48 4 272
box    floor   at 72 -4 160 size 48 4 160
box    floor   at 136 -4 160 size 48 4 160
box    floor   at 200 -4 160 size 48 4 160
box    floor   at 344 -4 160 size 48 4 160
box    floor   at 408 -4 160 size 48 4 160
box    floor   at 472 -4 160 size 48 4 160
box    floor   at 72 -4 296 size 48 4 48
box    floor   at 136 -4 296 size 48 4 48
box    floor   at 200 -4 296 size 48 4 48
box    floor   at 344 -4 296 size 48 4 48
box    floor   at 408 -4 296 size 48 4 48
box    floor   at 472 -4 296 size 48 4 48

# lava, 2 below the floor line
box    fire    at 72 -4 64 size 48 2 32
box    fire    at 136 -4 64 size 48 2 32
box    fire    at 200 -4 64 size 48 2 32
box    fire    at 344 -4 64 size 48 2 32
box    fire    at 408 -4 64 size 48 2 32
box    fire    at 472 -4 64 size 48 2 32
box    fire    at 72 -4 256 size 48 2 32
box    fire    at 136 -4 256 size 48 2 32
box    fire    at 200 -4 256 size 48 2 32
box    fire    at 344 -4 256 size 48 2 32
box    fire    at 408 -4 256 size 48 2 32
box    fire    at 472 -4 256 size 48 2 32

# the north wall, columns 0 to 15
box    stone   at 128 -4 8 size 256 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8

# the north wall, columns 18 to 33
box    stone   at 416 -4 8 size 256 52 16
box    metal   at 536 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 536 51 8 size 8 10.4 8

# the south wall, columns 0 to 15 (at 81% of its height, for the camera)
box    stone   at 128 -4 308 size 256 10 8  # TODO prims: wedge
box    stone   at 128 -4 316 size 256 16.5 8
box    metal   at 8 12.5 316 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 8 15 316 size 6 6.5 6

# the south wall, columns 18 to 33 (at 81% of its height, for the camera)
box    stone   at 416 -4 308 size 256 10 8  # TODO prims: wedge
box    stone   at 416 -4 316 size 256 16.5 8
box    metal   at 536 12.5 316 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 536 15 316 size 6 6.5 6

# the west wall, rows 1 to 8
box    stone   at 8 -4 80 size 16 52 128

# the west wall, rows 11 to 18 (at 12% of its height, for the camera)
box    stone   at 8 -4 200 size 16 9.5 48  # TODO prims: wedge
box    stone   at 8 -4 264 size 16 52 80

# the east wall, rows 1 to 8
box    stone   at 536 -4 80 size 16 52 128

# the east wall, rows 11 to 18 (at 12% of its height, for the camera)
box    stone   at 536 -4 200 size 16 9.5 48  # TODO prims: wedge
box    stone   at 536 -4 264 size 16 52 80

# the north door, columns 16 to 17
box    door    at 272 -4 -1 size 32 36 2 id door-north
box    stone   at 272 32 8 size 32 16 16  # TODO prims: arch

# the south door, columns 16 to 17
box    door    at 272 -4 321 size 32 5 2 id door-south

# the west door, rows 9 to 10
box    door    at -1 -4 160 size 2 36 32 id door-west
box    stone   at 8 32 160 size 16 16 32  # TODO prims: arch

# the east door, rows 9 to 10
box    door    at 545 -4 160 size 2 36 32 id door-east
box    stone   at 536 32 160 size 16 16 32  # TODO prims: arch

# slag at 6,3 1x1
sphere rock    at 104 0 56 size 13 12 13 id slag-1  # TODO prims: blob
gem    fire    at 104 8 56 size 6 5 6

# slag at 27,3 1x1
sphere rock    at 440 0 56 size 13 12 13 id slag-2  # TODO prims: blob
gem    fire    at 439 8 56 size 6 5 6

# slag at 7,6 2x1 (at 99% of its height, for the camera)
sphere rock    at 128 0 104 size 29 11.5 13 id slag-3  # TODO prims: blob
gem    fire    at 127 7.5 104 size 6 5 6

# slag at 25,6 2x1 (at 99% of its height, for the camera)
sphere rock    at 416 0 104 size 29 11.5 13 id slag-4  # TODO prims: blob
gem    fire    at 418 7.5 104 size 6 5 6

# slag at 7,13 2x1
sphere rock    at 128 0 216 size 29 12 13 id slag-5  # TODO prims: blob
gem    fire    at 128 8 216 size 6 5 6

# slag at 25,13 2x1
sphere rock    at 416 0 216 size 29 12 13 id slag-6  # TODO prims: blob
gem    fire    at 414 8 216 size 6 5 6

# slag at 6,16 1x1
sphere rock    at 104 0 264 size 13 12 13 id slag-7  # TODO prims: blob
gem    fire    at 106 8 264 size 6 5 6

# slag at 27,16 1x1
sphere rock    at 440 0 264 size 13 12 13 id slag-8  # TODO prims: blob
gem    fire    at 442 8 264 size 6 5 6

# torches by the doors (at 78% of its height, for the camera)
box    metal   at 248 18 16 size 3 6 3
cone   fire    at 248 24 16 size 4 7 4
box    metal   at 296 18 16 size 3 6 3
cone   fire    at 296 24 16 size 4 7 4
box    metal   at 16 18 136 size 3 6 3
cone   fire    at 16 24 136 size 4 7 4
box    metal   at 16 4 184 size 3 5 3
cone   fire    at 16 9 184 size 4 5 4
box    metal   at 528 18 136 size 3 6 3
cone   fire    at 528 24 136 size 4 7 4
box    metal   at 528 4 184 size 3 5 3
cone   fire    at 528 9 184 size 4 5 4
