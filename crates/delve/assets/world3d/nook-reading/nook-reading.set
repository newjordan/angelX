set nook-reading
# The Quiet Room: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# A nook hangs off a fight room by one doorway, in the west wall here; torches flank it. Its furniture is the room's whole business.

# the ground: its top is the floor line
box    floor   at 192 -4 112 size 384 4 224

# the north wall, columns 0 to 23
box    stone   at 192 -4 8 size 384 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8
box    metal   at 376 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 376 51 8 size 8 10.4 8

# the south wall, columns 0 to 23 (at 81% of its height, for the camera)
box    stone   at 192 -4 212 size 384 10 8  # TODO prims: wedge
box    stone   at 192 -4 220 size 384 16.5 8
box    metal   at 8 12.5 220 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 8 15 220 size 6 6.5 6
box    metal   at 376 12.5 220 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 376 15 220 size 6 6.5 6

# the west wall, rows 1 to 5
box    stone   at 8 -4 56 size 16 52 80

# the west wall, rows 8 to 12 (at 12% of its height, for the camera)
box    stone   at 8 -4 152 size 16 9.5 48  # TODO prims: wedge
box    stone   at 8 -4 192 size 16 52 32

# the east wall, rows 1 to 12
box    stone   at 376 -4 112 size 16 52 192

# the west door, rows 6 to 7
box    door    at -1 -4 112 size 2 36 32 id door-west
box    stone   at 8 32 112 size 16 16 32  # TODO prims: arch

# table at 5,4 1x1 (at 49% of its height, for the camera)
box    wood    at 88 0 72 size 14 5 14 id table-1
box    cloth   at 88 5 72 size 15 0.5 15

# table at 9,4 1x1 (at 49% of its height, for the camera)
box    wood    at 152 0 72 size 14 5 14 id table-2
box    cloth   at 152 5 72 size 15 0.5 15

# table at 14,4 1x1 (at 49% of its height, for the camera)
box    wood    at 232 0 72 size 14 5 14 id table-3
box    cloth   at 232 5 72 size 15 0.5 15

# table at 18,4 1x1 (at 49% of its height, for the camera)
box    wood    at 296 0 72 size 14 5 14 id table-4
box    cloth   at 296 5 72 size 15 0.5 15

# table at 5,9 1x1 (at 70% of its height, for the camera)
box    wood    at 88 0 152 size 14 7.5 14 id table-5
box    cloth   at 88 7.5 152 size 15 0.5 15

# table at 9,9 1x1 (at 54% of its height, for the camera)
box    wood    at 152 0 152 size 14 5.5 14 id table-6
box    cloth   at 152 5.5 152 size 15 0.5 15

# table at 14,9 1x1 (at 54% of its height, for the camera)
box    wood    at 232 0 152 size 14 5.5 14 id table-7
box    cloth   at 232 5.5 152 size 15 0.5 15

# table at 18,9 1x1 (at 70% of its height, for the camera)
box    wood    at 296 0 152 size 14 7.5 14 id table-8
box    cloth   at 296 7.5 152 size 15 0.5 15

# bookcase at 2,1 7x1
box    wood    at 88 0 24 size 110 28 14 id bookcase-1
box    cloth   at 88 3 31.25 size 108 22 0.5

# bookcase at 15,1 7x1
box    wood    at 296 0 24 size 110 28 14 id bookcase-2
box    cloth   at 296 3 31.25 size 108 22 0.5

# rug at 10,2 4x11
box    rug     at 192 0 120 size 62 0.6 174 id rug

# fixed to the far wall: windows, banners, hearths, lamps
box    metal   at 56 18 16 size 3 5 3
cone   fire    at 56 23 16 size 5 7 5
box    metal   at 328 18 16 size 3 5 3
cone   fire    at 328 23 16 size 5 7 5

