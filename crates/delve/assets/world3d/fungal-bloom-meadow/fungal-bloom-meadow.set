set fungal-bloom-meadow
# The Bloom Meadow: 40 x 24 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 640 384
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    ground  at 320 -4 40 size 640 4 80
box    ground  at 40 -4 232 size 80 4 304
box    ground  at 160 -4 232 size 64 4 304
box    ground  at 320 -4 232 size 160 4 304
box    ground  at 480 -4 232 size 64 4 304
