set college-library
# Floating Library: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Painted on open floor, not blocks: three books floating over the rug (130,190,250 by 100), rolling ladders (139,245), reading lamps.

# the ground: its top is the floor line
box    floor   at 192 -4 112 size 384 4 224

# the north wall, columns 0 to 23
box    stone   at 192 -4 8 size 384 52 16

# the south wall, columns 0 to 23 (at 81% of its height, for the camera)
box    stone   at 192 -4 212 size 384 10 8  # TODO prims: wedge
box    stone   at 192 -4 220 size 384 16.5 8

# the west wall, rows 1 to 12
box    stone   at 8 -4 112 size 16 52 192

# the east wall, rows 1 to 12
box    stone   at 376 -4 112 size 16 52 192

# bookcase at 2,2 6x2 (at 19% of its height, for the camera)
box    wood    at 80 0 48 size 94 5.5 30 id bookcase-1
box    cloth   at 80 0.5 63.25 size 92 4.5 0.5

# bookcase at 10,2 4x2 (at 19% of its height, for the camera)
box    wood    at 192 0 48 size 62 5.5 30 id bookcase-2
box    cloth   at 192 0.5 63.25 size 60 4.5 0.5

# bookcase at 16,2 6x2 (at 19% of its height, for the camera)
box    wood    at 304 0 48 size 94 5.5 30 id bookcase-3
box    cloth   at 304 0.5 63.25 size 92 4.5 0.5

# bookcase at 3,7 3x2 (at 27% of its height, for the camera)
box    wood    at 72 0 128 size 46 6 30 id bookcase-4
box    cloth   at 72 0.5 143.25 size 44 5 0.5

# bookcase at 18,7 3x2 (at 27% of its height, for the camera)
box    wood    at 312 0 128 size 46 6 30 id bookcase-5
box    cloth   at 312 0.5 143.25 size 44 5 0.5

# desk at 6,9 2x1 (at 64% of its height, for the camera)
box    wood    at 112 0 152 size 30 5.5 14 id desk-1
box    plaster at 112 5.5 152 size 31 0.5 15

# desk at 16,9 2x1 (at 64% of its height, for the camera)
box    wood    at 272 0 152 size 30 5.5 14 id desk-2
box    plaster at 272 5.5 152 size 31 0.5 15

# rug at 7,5 10x4
box    rug     at 192 0 112 size 158 0.6 62 id rug

# plate at 11,12 2x1
box    stone   at 192 0 200 size 30 1.5 14 id plate  # TODO prims: stairs
