set cavern-stalactite-garden
# The Stalactite Garden: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    ground  at 192 -4 24 size 384 4 48
box    ground  at 24 -4 136 size 48 4 176
box    ground  at 88 -4 64 size 48 4 32
box    ground  at 192 -4 136 size 128 4 176
box    ground  at 296 -4 64 size 48 4 32
box    ground  at 360 -4 136 size 48 4 176
box    ground  at 56 -4 112 size 16 4 96
box    ground  at 120 -4 72 size 16 4 16
box    ground  at 264 -4 72 size 16 4 16
box    ground  at 328 -4 112 size 16 4 96
box    ground  at 80 -4 152 size 32 4 144
box    ground  at 304 -4 152 size 32 4 144
box    ground  at 112 -4 112 size 32 4 32
box    ground  at 272 -4 112 size 32 4 32
box    ground  at 112 -4 152 size 32 4 16
box    ground  at 272 -4 152 size 32 4 16
box    ground  at 104 -4 192 size 16 4 64
box    ground  at 280 -4 192 size 16 4 64
box    ground  at 56 -4 200 size 16 4 48
box    ground  at 120 -4 200 size 16 4 48
box    ground  at 264 -4 200 size 16 4 48
box    ground  at 328 -4 200 size 16 4 48

# water, 3 below the floor line
box    water   at 56 -4 56 size 16 1 16
box    water   at 120 -4 56 size 16 1 16
box    water   at 264 -4 56 size 16 1 16
box    water   at 328 -4 56 size 16 1 16
box    water   at 112 -4 88 size 32 1 16
box    water   at 272 -4 88 size 32 1 16
box    water   at 112 -4 136 size 32 1 16
box    water   at 272 -4 136 size 32 1 16
box    water   at 56 -4 168 size 16 1 16
box    water   at 120 -4 168 size 16 1 16
box    water   at 264 -4 168 size 16 1 16
box    water   at 328 -4 168 size 16 1 16

