box    floor   at 496 -4 192 size 64 4 160
box    floor   at 552 -4 192 size 16 4 160
box    floor   at 160 -4 344 size 96 4 80
box    floor   at 512 -4 344 size 96 4 80

# lava, 2 below the floor line
box    fire    at 160 -4 88 size 96 2 16
box    fire    at 512 -4 88 size 96 2 16
box    fire    at 120 -4 104 size 16 2 16
box    fire    at 176 -4 104 size 64 2 16
