set hellforge-furnace-hall
# The Furnace Hall: 42 x 24 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 672 384
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 336 -4 40 size 672 4 80
box    floor   at 56 -4 232 size 112 4 304
box    floor   at 336 -4 232 size 256 4 304
box    floor   at 616 -4 232 size 112 4 304
box    floor   at 136 -4 192 size 16 4 192
