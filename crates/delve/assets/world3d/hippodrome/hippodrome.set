set hippodrome
# The Rusty Hippodrome: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Painted on open ground, not blocks: the oval track, the start line at the east end, the bookie's booth (17,4.5), race-day bunting, the coach gate (19,12).

