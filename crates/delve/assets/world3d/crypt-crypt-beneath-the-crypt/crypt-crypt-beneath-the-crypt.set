set crypt-crypt-beneath-the-crypt
# The Crypt Beneath the Crypt: 42 x 24 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 672 384
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 336 -4 48 size 672 4 96
box    floor   at 56 -4 240 size 112 4 288
box    floor   at 136 -4 104 size 16 4 16
box    floor   at 336 -4 240 size 288 4 288
box    floor   at 536 -4 104 size 16 4 16
