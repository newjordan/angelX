# landmark (assets/world3d/aqueduct/landmark.set, hand-placed)
# Unnecessary Aqueduct: an arcade of seven arches along the back carrying a stone channel, with a cistern house at each end.
# Hand-placed by the landmark pass on the room's blocked back band and what lies behind it,
# so it never stands on a tile a knight walks or hides the floor from the camera.

# the arcade behind the north wall: the road leaves under the middle arch
arch-12 stone   at 24 0 -8 size 56 50 16 id lm-arch-1
arch-12 stone   at 80 0 -8 size 56 50 16 id lm-arch-2
arch-12 stone   at 136 0 -8 size 56 50 16 id lm-arch-3
arch-12 stone   at 192 0 -8 size 56 50 16 id lm-arch-4
arch-12 stone   at 248 0 -8 size 56 50 16 id lm-arch-5
arch-12 stone   at 304 0 -8 size 56 50 16 id lm-arch-6
arch-12 stone   at 360 0 -8 size 56 50 16 id lm-arch-7
# the channel over the arches, its water and rims
box    stone   at 192 50 -8 size 392 8 22 id lm-channel
box    water   at 192 58 -8 size 380 2.5 12
box    stone   at 192 58 -16.5 size 392 5 3
box    stone   at 192 58 0.5 size 392 5 3
# a cistern house at either end
box    stone   at 14 0 -6 size 28 56 24 id lm-cistern-west
pyramid slate   at 14 56 -6 size 34 18 30
box    stone   at 370 0 -6 size 28 56 24 id lm-cistern-east
pyramid slate   at 370 56 -6 size 34 18 30
