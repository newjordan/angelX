# A small yard on one room's stage (docs/WORLD-3D.md): a timber house with
# a gable roof, a well, a fence line, two trees and a path. Stage pixels:
# x right, y up, z down the floor toward the viewer.
set sample-yard
camera room 768 448
plate 1536 1024

# The ground, a little past the stage on every side (the plate's margin).
plane grass   at 384 0 224   size 840 0 500

# The path from the door down out of the yard, and a branch to the well.
plane path    at 240 0.5 336   size 34 0 238
plane path    at 396 0.5 279   size 290 0 24 turn 8.4

# The house: a stone footing, timber walls, a door and two windows on the
# front, a stepped gable roof (one `gable` line once the primitive library
# lands) and a chimney.
box   stone   at 240 0 170     size 158 8 98    id house-footing
box   wood    at 240 8 170     size 150 62 90   id house-walls
box   door    at 240 8 215.5   size 26 42 3     id house-door
box   window  at 190 34 215.5  size 20 18 3
box   window  at 290 34 215.5  size 20 18 3
box   roof    at 240 70 170    size 166 7 106   id house-roof
box   roof    at 240 77 170    size 166 7 88
box   roof    at 240 84 170    size 166 7 70
box   roof    at 240 91 170    size 166 7 52
box   roof    at 240 98 170    size 166 7 34
box   roof    at 240 105 170   size 166 6 16
box   stone   at 290 84 160    size 14 40 14    id chimney

# The well: a ring of stone, water inside, two posts, a bar and a roof.
box   stone   at 560 0 257     size 40 18 6     id well
box   stone   at 560 0 223     size 40 18 6
box   stone   at 543 0 240     size 6 18 28
box   stone   at 577 0 240     size 6 18 28
plane water   at 560 12 240    size 28 0 28
box   wood    at 545 18 240    size 4 34 4
box   wood    at 575 18 240    size 4 34 4
box   wood    at 560 46 240    size 34 3 3
box   roof    at 560 52 240    size 52 6 32
box   roof    at 560 58 240    size 52 5 16

# Two trees: a pointed one at the left, a round one at the back right.
box   trunk   at 110 0 330     size 10 30 10
cone  foliage at 110 22 330    size 64 84 64    id tree-west
box   trunk   at 680 0 140     size 10 26 10
sphere foliage at 680 20 140   size 62 56 62    id tree-east

# A fence line along the front of the yard and up its right side.
box   wood    at 535 10 395    size 410 3 2     id fence-front
box   wood    at 535 19 395    size 410 3 2
box   wood    at 330 0 395     size 4 24 4
box   wood    at 364 0 395     size 4 24 4
box   wood    at 398 0 395     size 4 24 4
box   wood    at 432 0 395     size 4 24 4
box   wood    at 466 0 395     size 4 24 4
box   wood    at 500 0 395     size 4 24 4
box   wood    at 534 0 395     size 4 24 4
box   wood    at 568 0 395     size 4 24 4
box   wood    at 602 0 395     size 4 24 4
box   wood    at 636 0 395     size 4 24 4
box   wood    at 670 0 395     size 4 24 4
box   wood    at 704 0 395     size 4 24 4
box   wood    at 740 0 395     size 4 24 4
box   wood    at 740 10 322    size 146 3 2 turn 90  id fence-side
box   wood    at 740 19 322    size 146 3 2 turn 90
box   wood    at 740 0 358     size 4 24 4
box   wood    at 740 0 322     size 4 24 4
box   wood    at 740 0 286     size 4 24 4
box   wood    at 740 0 250     size 4 24 4

# A few stones in the grass.
sphere rock   at 430 0 365     size 22 12 18
sphere rock   at 447 0 372     size 12 8 10
gem   rock    at 90 0 410      size 18 14 16 turn 30
