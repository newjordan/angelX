set hellforge-great-anvil
# The Great Anvil: 40 x 24 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 640 384
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 320 -4 192 size 640 4 384

# the north wall, columns 0 to 18
box    stone   at 152 -4 8 size 304 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8

# the north wall, columns 21 to 39
box    stone   at 488 -4 8 size 304 52 16
box    metal   at 632 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 632 51 8 size 8 10.4 8

# the south wall, columns 0 to 18 (at 81% of its height, for the camera)
box    stone   at 152 -4 372 size 304 10 8  # TODO prims: wedge
box    stone   at 152 -4 380 size 304 16.5 8
box    metal   at 8 12.5 380 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 8 15 380 size 6 6.5 6

# the south wall, columns 21 to 39 (at 81% of its height, for the camera)
box    stone   at 488 -4 372 size 304 10 8  # TODO prims: wedge
box    stone   at 488 -4 380 size 304 16.5 8
box    metal   at 632 12.5 380 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 632 15 380 size 6 6.5 6

# the west wall, rows 1 to 10
box    stone   at 8 -4 96 size 16 52 160

# the west wall, rows 13 to 22 (at 12% of its height, for the camera)
box    stone   at 8 -4 232 size 16 9.5 48  # TODO prims: wedge
box    stone   at 8 -4 312 size 16 52 112

# the east wall, rows 1 to 10
box    stone   at 632 -4 96 size 16 52 160

# the east wall, rows 13 to 22 (at 12% of its height, for the camera)
box    stone   at 632 -4 232 size 16 9.5 48  # TODO prims: wedge
box    stone   at 632 -4 312 size 16 52 112

# the north door, columns 19 to 20
box    door    at 320 -4 -1 size 32 36 2 id door-north
box    stone   at 320 32 8 size 32 16 16  # TODO prims: arch

# the south door, columns 19 to 20
box    door    at 320 -4 385 size 32 5 2 id door-south

# the west door, rows 11 to 12
box    door    at -1 -4 192 size 2 36 32 id door-west
box    stone   at 8 32 192 size 16 16 32  # TODO prims: arch

# the east door, rows 11 to 12
box    door    at 641 -4 192 size 2 36 32 id door-east
box    stone   at 632 32 192 size 16 16 32  # TODO prims: arch

