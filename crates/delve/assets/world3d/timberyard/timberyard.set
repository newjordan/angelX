set timberyard
# Splinter's Timberyard: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Painted on open ground, not blocks: five logs lying across the lane (numbered jumps), cart ruts, LOGS signs.

