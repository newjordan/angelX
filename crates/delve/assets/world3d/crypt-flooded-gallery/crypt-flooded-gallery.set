set crypt-flooded-gallery
# The Flooded Gallery: 36 x 20 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 576 320
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 288 -4 32 size 576 4 64
box    floor   at 40 -4 192 size 80 4 256
box    floor   at 288 -4 192 size 192 4 256
box    floor   at 536 -4 192 size 80 4 256
box    floor   at 120 -4 160 size 16 4 160
box    floor   at 456 -4 160 size 16 4 160
box    floor   at 96 -4 160 size 32 4 128
box    floor   at 160 -4 160 size 64 4 128
box    floor   at 416 -4 160 size 64 4 128
box    floor   at 480 -4 160 size 32 4 128
box    floor   at 136 -4 288 size 112 4 64
box    floor   at 440 -4 288 size 112 4 64

# pits: holes in the floor, dark below

# the north wall, columns 0 to 16
box    stone   at 136 -4 8 size 272 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8

# the north wall, columns 19 to 35
