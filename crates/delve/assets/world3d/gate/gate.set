box    stone   at 285 38 -2 size 9 7 22
box    stone   at 302 38 -2 size 9 7 22
box    stone   at 319 38 -2 size 9 7 22
box    stone   at 336 38 -2 size 9 7 22
box    stone   at 353 38 -2 size 9 7 22
# a round turret at each end of the wall
frustum-10 stone   at 16 0 0 size 30 52 30 id lm-turret-west
cylinder-10 stone   at 16 52 0 size 32 5 32
cone-10 slate   at 16 57 0 size 32 16 32
frustum-10 stone   at 368 0 0 size 30 52 30 id lm-turret-east
cylinder-10 stone   at 368 52 0 size 32 5 32
cone-10 slate   at 368 57 0 size 32 16 32
