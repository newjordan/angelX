set college-grounds
# College Courtyard: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Painted on open ground, not blocks: shrubs by the paths, two outdoor tables (3,11.5) (18,11.5), the door plates into the halls.

# the ground: its top is the floor line
box    floor   at 192 -4 8 size 384 4 16
box    floor   at 8 -4 120 size 16 4 208
box    grass   at 72 -4 88 size 112 4 144
box    road    at 192 -4 112 size 128 4 192
box    grass   at 312 -4 88 size 112 4 144
box    floor   at 376 -4 120 size 16 4 208
box    road    at 72 -4 184 size 112 4 48
box    road    at 312 -4 184 size 112 4 48
box    floor   at 192 -4 216 size 352 4 16

# the north wall, columns 0 to 23
box    stone   at 192 -4 8 size 384 52 16

# the south wall, columns 0 to 23 (at 81% of its height, for the camera)
box    stone   at 192 -4 212 size 384 10 8  # TODO prims: wedge
box    stone   at 192 -4 220 size 384 16.5 8

# the west wall, rows 1 to 12
box    stone   at 8 -4 112 size 16 52 192

# the east wall, rows 1 to 12
box    stone   at 376 -4 112 size 16 52 192

# cottage at 5,1 7x2
box    stone   at 136 0 32 size 106 18 28 id cottage
box    slate   at 136 18 32 size 108 12 30  # TODO prims: gable
box    door    at 136 0 46.5 size 8 12 1
box    window  at 97.5 7 46.5 size 6 5 1
box    window  at 118.5 7 46.5 size 6 5 1
box    window  at 164 7 46.5 size 6 5 1

# tower at 17,2 5x5 (at 14% of its height, for the camera)
box    stone   at 312 0 72 size 76 5.5 76 id tower  # TODO prims: cylinder
cone   slate   at 312 5.5 72 size 80 7.5 80  # TODO prims: pyramid
box    window  at 312 3 110.25 size 4 1 1.5

# fountain at 10,6 3x2 (at 99% of its height, for the camera)
box    stone   at 184 0 112 size 44 4.5 28 id fountain
box    water   at 184 4.5 112 size 40 1 24
box    stone   at 184 4.5 112 size 4 13 4  # TODO prims: cylinder
sphere water   at 184 17.5 112 size 6 4 6

# plate at 8,3 2x1
box    stone   at 144 0 56 size 30 1.5 14 id plate-1  # TODO prims: stairs

# plate at 18,7 2x1
box    stone   at 304 0 120 size 30 1.5 14 id plate-2  # TODO prims: stairs

# plate at 11,12 2x1
box    stone   at 192 0 200 size 30 1.5 14 id plate-3  # TODO prims: stairs

# landmark (assets/world3d/college-grounds/landmark.set, hand-placed)
# The wizard's tower standing up behind the east wall; the school's clock tower and wings.
# the wizard's tower: a shaft in the wall, a round drum standing out of it, a gallery, a lantern chamber, a slate spire
cylinder-16 stone at 312 0 8 size 44 52 16
cylinder-16 stone at 312 48 9 size 44 20 34
box    window  at 312 54 25.8 size 5 10 2
box    window  at 312 61 25.8 size 5 6 2
cylinder-16 stone at 312 68 9 size 50 4 42
cylinder-12 stone at 312 72 9 size 32 8 26
cone-12 slate  at 312 80 9 size 38 8 32
# the school: a clock tower in the middle of the long front, a pavilion at each end, two chimneys
box    stone   at 136 0 28 size 30 46 20
box    window  at 136 30 38.5 size 6 8 1.5
pyramid slate  at 136 46 28 size 36 20 28
box    stone   at 88 0 32 size 14 34 26
pyramid slate  at 88 34 32 size 18 12 30
box    stone   at 184 0 32 size 14 34 26
pyramid slate  at 184 34 32 size 18 12 30
box    brick   at 104 26 26 size 6 12 6
box    brick   at 168 26 26 size 6 12 6
arch-8 stone   at 136 0 44 size 18 22 8
