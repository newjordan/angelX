box    stone   at 336 4 185.5 size 12 20 7
box    stone   at 336 24 185.5 size 14 2.5 9

# torches by the doors (at 81% of its height, for the camera)
box    metal   at 168 18 16 size 3 6 3
cone   fire    at 168 24 16 size 4 7 4
box    metal   at 216 18 16 size 3 6 3
cone   fire    at 216 24 16 size 4 7 4
box    metal   at 16 18 88 size 3 6 3
cone   fire    at 16 24 88 size 4 7 4
box    metal   at 16 4 136 size 3 5 3
cone   fire    at 16 9 136 size 4 5.5 4
box    metal   at 368 18 88 size 3 6 3
cone   fire    at 368 24 88 size 4 7 4
box    metal   at 368 4 136 size 3 5 3
cone   fire    at 368 9 136 size 4 5.5 4
