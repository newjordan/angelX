set nook-ossuary
# The Bone Dominoes: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# A nook hangs off a fight room by one doorway, in the west wall here; torches flank it. Its furniture is the room's whole business.

# the ground: its top is the floor line
box    floor   at 192 -4 112 size 384 4 224

# the north wall, columns 0 to 23
box    stone   at 192 -4 8 size 384 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8
box    metal   at 376 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 376 51 8 size 8 10.4 8

# the south wall, columns 0 to 23 (at 81% of its height, for the camera)
box    stone   at 192 -4 212 size 384 10 8  # TODO prims: wedge
box    stone   at 192 -4 220 size 384 16.5 8
box    metal   at 8 12.5 220 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 8 15 220 size 6 6.5 6
box    metal   at 376 12.5 220 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 376 15 220 size 6 6.5 6

# the west wall, rows 1 to 5
box    stone   at 8 -4 56 size 16 52 80

# the west wall, rows 8 to 12 (at 12% of its height, for the camera)
box    stone   at 8 -4 152 size 16 9.5 48  # TODO prims: wedge
box    stone   at 8 -4 192 size 16 52 32

# the east wall, rows 1 to 12
box    stone   at 376 -4 112 size 16 52 192

# the west door, rows 6 to 7
box    door    at -1 -4 112 size 2 36 32 id door-west
box    stone   at 8 32 112 size 16 16 32  # TODO prims: arch

# coffer at 11,6 2x2 (at 46% of its height, for the camera)
box    bone    at 192 0 112 size 30 6 30 id coffer
box    metal   at 192 1 127.25 size 28 4 0.5

# skull-stack at 7,6 1x2 (at 51% of its height, for the camera)
box    bone    at 120 -4 112 size 12 11 28 id skull-stack-1  # TODO prims: cylinder
box    bone    at 120 7 112 size 14 1 30

# skull-stack at 16,6 1x2 (at 51% of its height, for the camera)
box    bone    at 264 -4 112 size 12 11 28 id skull-stack-2  # TODO prims: cylinder
box    bone    at 264 7 112 size 14 1 30

# torches by the doors (at 81% of its height, for the camera)
box    metal   at 16 18 88 size 3 6 3
cone   fire    at 16 24 88 size 4 7 4
box    metal   at 16 4 136 size 3 5 3
cone   fire    at 16 9 136 size 4 5.5 4
