set cavern-sunken-gallery
# The Sunken Gallery: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    ground  at 192 -4 16 size 384 4 32
box    ground  at 40 -4 128 size 80 4 192
box    ground  at 192 -4 48 size 128 4 32
box    ground  at 344 -4 128 size 80 4 192
box    ground  at 96 -4 112 size 32 4 128
box    ground  at 288 -4 112 size 32 4 128
box    ground  at 192 -4 144 size 96 4 160
box    ground  at 128 -4 112 size 32 4 64
box    ground  at 256 -4 112 size 32 4 64
box    ground  at 136 -4 192 size 16 4 64
box    ground  at 248 -4 192 size 16 4 64
box    ground  at 104 -4 208 size 48 4 32
box    ground  at 280 -4 208 size 48 4 32

# water, 3 below the floor line
box    water   at 104 -4 40 size 48 1 16
box    water   at 280 -4 40 size 48 1 16
box    water   at 120 -4 64 size 16 1 32
box    water   at 264 -4 64 size 16 1 32
box    water   at 136 -4 72 size 16 1 16
box    water   at 248 -4 72 size 16 1 16
box    water   at 128 -4 152 size 32 1 16
box    water   at 256 -4 152 size 32 1 16
box    water   at 120 -4 176 size 16 1 32
box    water   at 264 -4 176 size 16 1 32
box    water   at 96 -4 184 size 32 1 16
box    water   at 288 -4 184 size 32 1 16

# the north wall, columns 0 to 10
box    rock    at 88 -4 8 size 176 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8

# the north wall, columns 13 to 23
box    rock    at 296 -4 8 size 176 52 16
box    metal   at 376 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 376 51 8 size 8 10.4 8

# the south wall, columns 0 to 10 (at 81% of its height, for the camera)
box    rock    at 88 -4 212 size 176 10 8  # TODO prims: wedge
box    rock    at 88 -4 220 size 176 16.5 8
box    metal   at 8 12.5 220 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 8 15 220 size 6 6.5 6

# the south wall, columns 13 to 23 (at 81% of its height, for the camera)
box    rock    at 296 -4 212 size 176 10 8  # TODO prims: wedge
box    rock    at 296 -4 220 size 176 16.5 8
box    metal   at 376 12.5 220 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 376 15 220 size 6 6.5 6

# the west wall, rows 1 to 5
box    rock    at 8 -4 56 size 16 52 80

# the west wall, rows 8 to 12 (at 12% of its height, for the camera)
box    rock    at 8 -4 152 size 16 9.5 48  # TODO prims: wedge
box    rock    at 8 -4 192 size 16 52 32

# the east wall, rows 1 to 5
box    rock    at 376 -4 56 size 16 52 80

# the east wall, rows 8 to 12 (at 12% of its height, for the camera)
box    rock    at 376 -4 152 size 16 9.5 48  # TODO prims: wedge
box    rock    at 376 -4 192 size 16 52 32

# the north door, columns 11 to 12
box    door    at 192 -4 -1 size 32 36 2 id door-north
box    rock    at 192 32 8 size 32 16 16  # TODO prims: arch

# the south door, columns 11 to 12
box    door    at 192 -4 225 size 32 5 2 id door-south

# the west door, rows 6 to 7
box    door    at -1 -4 112 size 2 36 32 id door-west
box    rock    at 8 32 112 size 16 16 32  # TODO prims: arch

# the east door, rows 6 to 7
box    door    at 385 -4 112 size 2 36 32 id door-east
box    rock    at 376 32 112 size 16 16 32  # TODO prims: arch

