# landmark (assets/world3d/sluice/landmark.set, hand-placed)
# The Sluice of Excuses: two stone piers with the wooden gate raised between them, the beam over it and the valve wheel.
# Hand-placed by the landmark pass on the room's blocked back band and what lies behind it,
# so it never stands on a tile a knight walks or hides the floor from the camera.

# the piers either side of the north door gap
box    stone   at 160 0 -2 size 24 56 28 id lm-pier-west
box    stone   at 224 0 -2 size 24 56 28 id lm-pier-east
# the gate, raised a hand, and the race under it
box    wood    at 192 6 -9 size 40 44 5 id lm-sluice-gate
box    water   at 192 0 -11.5 size 40 4 23
# the beam across the piers, with the valve wheel on its stem
box    wood    at 192 56 -8 size 76 6 12 id lm-beam
cylinder-8 metal   at 192 62 -8 size 4 10 4
cylinder-12 metal   at 192 70 -8 size 16 2 16 id lm-valve-wheel
cylinder-8 metal   at 178 44 -9 size 2.5 14 2.5
cylinder-8 metal   at 206 44 -9 size 2.5 14 2.5
