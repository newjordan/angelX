set crypt-ossuary-wall
# The Ossuary Wall: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 192 -4 112 size 384 4 224

# the north wall, columns 0 to 10
box    stone   at 88 -4 8 size 176 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8

# the north wall, columns 13 to 23
box    stone   at 296 -4 8 size 176 52 16
box    metal   at 376 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 376 51 8 size 8 10.4 8

# the south wall, columns 0 to 10 (at 81% of its height, for the camera)
box    stone   at 88 -4 212 size 176 10 8  # TODO prims: wedge
box    stone   at 88 -4 220 size 176 16.5 8
box    metal   at 8 12.5 220 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 8 15 220 size 6 6.5 6

# the south wall, columns 13 to 23 (at 81% of its height, for the camera)
box    stone   at 296 -4 212 size 176 10 8  # TODO prims: wedge
box    stone   at 296 -4 220 size 176 16.5 8
box    metal   at 376 12.5 220 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 376 15 220 size 6 6.5 6

# the west wall, rows 1 to 5
box    stone   at 8 -4 56 size 16 52 80

# the west wall, rows 8 to 12 (at 12% of its height, for the camera)
box    stone   at 8 -4 152 size 16 9.5 48  # TODO prims: wedge
box    stone   at 8 -4 192 size 16 52 32

# the east wall, rows 1 to 5
box    stone   at 376 -4 56 size 16 52 80

# the east wall, rows 8 to 12 (at 12% of its height, for the camera)
box    stone   at 376 -4 152 size 16 9.5 48  # TODO prims: wedge
box    stone   at 376 -4 192 size 16 52 32

# the north door, columns 11 to 12
box    door    at 192 -4 -1 size 32 36 2 id door-north
box    stone   at 192 32 8 size 32 16 16  # TODO prims: arch

# the south door, columns 11 to 12
box    door    at 192 -4 225 size 32 5 2 id door-south

# the west door, rows 6 to 7
box    door    at -1 -4 112 size 2 36 32 id door-west
box    stone   at 8 32 112 size 16 16 32  # TODO prims: arch

# the east door, rows 6 to 7
box    door    at 385 -4 112 size 2 36 32 id door-east
box    stone   at 376 32 112 size 16 16 32  # TODO prims: arch

# tomb at 1,1 2x2
box    stone   at 32 0 32 size 30 5 30 id pillar-1
box    stone   at 32 5 41.5 size 12 22 7
box    stone   at 32 27 41.5 size 14 3 9

# tomb at 21,1 2x2
box    stone   at 352 0 32 size 30 5 30 id pillar-2
box    stone   at 352 5 41.5 size 12 22 7
box    stone   at 352 27 41.5 size 14 3 9

# tomb at 3,2 2x1 (at 49% of its height, for the camera)
box    stone   at 64 0 40 size 28 4 12 id tomb-1
box    stone   at 64 4 40 size 30 1.5 14

# tomb at 8,2 3x1 (at 49% of its height, for the camera)
box    stone   at 152 0 40 size 44 4 12 id tomb-2
box    stone   at 152 4 40 size 46 1.5 14

# tomb at 13,2 3x1 (at 49% of its height, for the camera)
box    stone   at 232 0 40 size 44 4 12 id tomb-3
box    stone   at 232 4 40 size 46 1.5 14

# tomb at 19,2 2x1 (at 49% of its height, for the camera)
box    stone   at 320 0 40 size 28 4 12 id tomb-4
box    stone   at 320 4 40 size 30 1.5 14

# tomb at 7,4 1x1 (at 70% of its height, for the camera)
box    stone   at 120 0 72 size 12 6 12 id tomb-5
box    stone   at 120 6 72 size 14 2 14

# tomb at 16,4 1x1 (at 70% of its height, for the camera)
box    stone   at 264 0 72 size 12 6 12 id tomb-6
box    stone   at 264 6 72 size 14 2 14

# tomb at 7,9 1x1 (at 74% of its height, for the camera)
box    stone   at 120 0 152 size 12 6.5 12 id tomb-7
box    stone   at 120 6.5 152 size 14 2 14

# tomb at 16,9 1x1 (at 74% of its height, for the camera)
box    stone   at 264 0 152 size 12 6.5 12 id tomb-8
box    stone   at 264 6.5 152 size 14 2 14

# tomb at 1,11 4x1 (at 58% of its height, for the camera)
box    stone   at 48 0 184 size 60 5 12 id tomb-9
box    stone   at 48 5 184 size 62 1.5 14

# tomb at 8,11 3x1 (at 58% of its height, for the camera)
box    stone   at 152 0 184 size 44 5 12 id tomb-10
box    stone   at 152 5 184 size 46 1.5 14

# tomb at 13,11 3x1 (at 58% of its height, for the camera)
box    stone   at 232 0 184 size 44 5 12 id tomb-11
box    stone   at 232 5 184 size 46 1.5 14

# tomb at 19,11 4x1 (at 58% of its height, for the camera)
box    stone   at 336 0 184 size 60 5 12 id tomb-12
box    stone   at 336 5 184 size 62 1.5 14

