set fungal-toadstool-nook
# The Toadstool Nook: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    ground  at 192 -4 16 size 384 4 32
box    ground  at 64 -4 128 size 128 4 192
box    ground  at 192 -4 128 size 64 4 192
box    ground  at 320 -4 128 size 128 4 192
box    ground  at 152 -4 112 size 16 4 128
box    ground  at 232 -4 112 size 16 4 128
box    ground  at 136 -4 112 size 16 4 96
box    ground  at 248 -4 112 size 16 4 96
box    ground  at 144 -4 208 size 32 4 32
box    ground  at 240 -4 208 size 32 4 32

# the spore pool, 2 below the floor line
box    mud     at 144 -4 40 size 32 2 16
box    mud     at 240 -4 40 size 32 2 16
box    mud     at 136 -4 56 size 16 2 16
box    mud     at 248 -4 56 size 16 2 16
box    mud     at 136 -4 176 size 16 2 32
box    mud     at 248 -4 176 size 16 2 32
box    mud     at 152 -4 184 size 16 2 16
box    mud     at 232 -4 184 size 16 2 16

# the north wall, columns 0 to 10
box    rock    at 88 -4 8 size 176 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8

# the north wall, columns 13 to 23
box    rock    at 296 -4 8 size 176 52 16
