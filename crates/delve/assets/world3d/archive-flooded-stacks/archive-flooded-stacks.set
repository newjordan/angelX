set archive-flooded-stacks
# The Flooded Stacks: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 192 -4 8 size 384 4 16
box    floor   at 8 -4 120 size 16 4 208
box    floor   at 192 -4 120 size 256 4 208
box    floor   at 376 -4 120 size 16 4 208
box    floor   at 40 -4 64 size 48 4 32
box    floor   at 344 -4 64 size 48 4 32
box    floor   at 40 -4 112 size 48 4 32
box    floor   at 344 -4 112 size 48 4 32
box    floor   at 40 -4 160 size 48 4 32
box    floor   at 344 -4 160 size 48 4 32
box    floor   at 40 -4 216 size 48 4 16
box    floor   at 344 -4 216 size 48 4 16

# water, 3 below the floor line
box    water   at 40 -4 32 size 48 1 32
box    water   at 344 -4 32 size 48 1 32
box    water   at 40 -4 88 size 48 1 16
box    water   at 344 -4 88 size 48 1 16
box    water   at 40 -4 136 size 48 1 16
box    water   at 344 -4 136 size 48 1 16
box    water   at 40 -4 192 size 48 1 32
box    water   at 344 -4 192 size 48 1 32

