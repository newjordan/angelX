set fungal-fairy-ring
# The Fairy Ring, a chamber of the Fungal Deep: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    ground  at 192 -4 24 size 384 4 48
box    ground  at 32 -4 136 size 64 4 176
box    ground  at 192 -4 136 size 160 4 176
box    ground  at 352 -4 136 size 64 4 176
box    ground  at 104 -4 112 size 16 4 96
box    ground  at 280 -4 112 size 16 4 96
box    ground  at 80 -4 112 size 32 4 64
box    ground  at 304 -4 112 size 32 4 64
box    ground  at 88 -4 200 size 48 4 48
box    ground  at 296 -4 200 size 48 4 48

# the spore pool, 2 below the floor line
box    mud     at 88 -4 56 size 48 2 16
box    mud     at 296 -4 56 size 48 2 16
box    mud     at 80 -4 72 size 32 2 16
box    mud     at 304 -4 72 size 32 2 16
box    mud     at 80 -4 160 size 32 2 32
box    mud     at 304 -4 160 size 32 2 32
box    mud     at 104 -4 168 size 16 2 16
box    mud     at 280 -4 168 size 16 2 16

# the north wall, columns 0 to 10
box    rock    at 88 -4 8 size 176 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8

# the north wall, columns 13 to 23
box    rock    at 296 -4 8 size 176 52 16
box    metal   at 376 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 376 51 8 size 8 10.4 8

# the south wall, columns 0 to 10 (at 81% of its height, for the camera)
