set hellforge-slag-flats
# The Slag Flats: 48 x 28 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 768 448
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 384 -4 40 size 768 4 80
box    floor   at 40 -4 264 size 80 4 368
box    floor   at 384 -4 264 size 512 4 368
box    floor   at 728 -4 264 size 80 4 368
box    floor   at 104 -4 120 size 48 4 16
box    floor   at 664 -4 120 size 48 4 16
box    floor   at 104 -4 224 size 48 4 128
box    floor   at 664 -4 224 size 48 4 128
box    floor   at 104 -4 328 size 48 4 16
box    floor   at 664 -4 328 size 48 4 16
box    floor   at 104 -4 408 size 48 4 80
box    floor   at 664 -4 408 size 48 4 80

# lava, 2 below the floor line
box    fire    at 104 -4 96 size 48 2 32
box    fire    at 664 -4 96 size 48 2 32
box    fire    at 104 -4 144 size 48 2 32
box    fire    at 664 -4 144 size 48 2 32
box    fire    at 104 -4 304 size 48 2 32
box    fire    at 664 -4 304 size 48 2 32
box    fire    at 104 -4 352 size 48 2 32
box    fire    at 664 -4 352 size 48 2 32

