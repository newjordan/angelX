set tower-stars
# Star Observatory: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Painted on open floor, not blocks: the dial of stars over the floor, the stairs (19,3) and (4,12).

# the ground: its top is the floor line
box    floor   at 192 -4 112 size 384 4 224

# the north wall, columns 0 to 23
box    stone   at 192 -4 8 size 384 52 16

# the south wall, columns 0 to 23 (at 81% of its height, for the camera)
box    stone   at 192 -4 212 size 384 10 8  # TODO prims: wedge
box    stone   at 192 -4 220 size 384 16.5 8

# the west wall, rows 1 to 12
box    stone   at 8 -4 112 size 16 52 192

# the east wall, rows 1 to 12
box    stone   at 376 -4 112 size 16 52 192

# desk at 10,3 4x2 (at 54% of its height, for the camera)
box    wood    at 192 0 64 size 62 5 30 id desk
box    plaster at 192 5 64 size 63 0.5 31

# bookcase at 3,3 3x2 (at 24% of its height, for the camera)
box    wood    at 72 0 64 size 46 5.5 30 id bookcase
box    cloth   at 72 0.5 79.25 size 44 4.5 0.5

# telescope at 16,8 4x2 (at 91% of its height, for the camera)
box    metal   at 288 0 144 size 58 4.5 26 id telescope
box    metal   at 288 4.5 144 size 4 6 4
box    metal   at 288 10.5 144 size 28 4.5 5 turn 25
sphere metal   at 300 10.5 139 size 6 6.5 6

# plate at 19,3 2x1
box    stone   at 320 0 56 size 30 1.5 14 id plate-1  # TODO prims: stairs

# plate at 4,12 2x1
box    stone   at 80 0 200 size 30 1.5 14 id plate-2  # TODO prims: stairs

# fixed to the far wall: windows, banners, hearths, lamps
box    window  at 70 22 15.75 size 8 10 2.5
box    window  at 188 22 15.75 size 8 10 2.5
box    window  at 270 22 15.75 size 8 10 2.5
