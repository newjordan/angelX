set wizard-study
# Bartosz's Study: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Painted on open floor, not blocks: a hearth with a fire (16,5.5), jars on the shelves, three pinned creature sketches, a familiar.

# the ground: its top is the floor line
box    floor   at 192 -4 112 size 384 4 224

# the north wall, columns 0 to 23
box    stone   at 192 -4 8 size 384 52 16

# the south wall, columns 0 to 23 (at 81% of its height, for the camera)
box    stone   at 192 -4 212 size 384 10 8  # TODO prims: wedge
box    stone   at 192 -4 220 size 384 16.5 8

# the west wall, rows 1 to 12
box    stone   at 8 -4 112 size 16 52 192

# the east wall, rows 1 to 12
box    stone   at 376 -4 112 size 16 52 192

# bookcase at 3,2 5x2 (at 19% of its height, for the camera)
box    wood    at 88 0 48 size 78 5.5 30 id bookcase-1
box    cloth   at 88 0.5 63.25 size 76 4.5 0.5

# bookcase at 16,2 5x2 (at 19% of its height, for the camera)
box    wood    at 296 0 48 size 78 5.5 30 id bookcase-2
box    cloth   at 296 0.5 63.25 size 76 4.5 0.5

# desk at 10,3 4x2 (at 54% of its height, for the camera)
box    wood    at 192 0 64 size 62 5 30 id desk
box    plaster at 192 5 64 size 63 0.5 31

# table at 5,8 2x1 (at 64% of its height, for the camera)
box    wood    at 96 0 136 size 30 5.5 14 id table
box    cloth   at 96 5.5 136 size 31 0.5 15

# rug at 8,5 7x7
box    rug     at 184 0 136 size 110 0.6 110 id rug

# plate at 11,12 2x1
box    stone   at 192 0 200 size 30 1.5 14 id plate  # TODO prims: stairs

# fixed to the far wall: windows, banners, hearths, lamps
box    window  at 149 22 15.75 size 8 10 2.5
box    window  at 242 22 15.75 size 8 10 2.5
