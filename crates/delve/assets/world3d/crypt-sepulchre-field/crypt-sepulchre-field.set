set crypt-sepulchre-field
# The Sepulchre Field: 40 x 24 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 640 384
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 320 -4 56 size 640 4 112
box    floor   at 56 -4 248 size 112 4 272
box    floor   at 192 -4 248 size 64 4 272
box    floor   at 320 -4 248 size 96 4 272
box    floor   at 448 -4 248 size 64 4 272
box    floor   at 584 -4 248 size 112 4 272
box    floor   at 136 -4 192 size 48 4 128
box    floor   at 248 -4 192 size 48 4 128
box    floor   at 392 -4 192 size 48 4 128
box    floor   at 504 -4 192 size 48 4 128
box    floor   at 136 -4 328 size 48 4 112
box    floor   at 248 -4 328 size 48 4 112
box    floor   at 392 -4 328 size 48 4 112
box    floor   at 504 -4 328 size 48 4 112

# pits: holes in the floor, dark below

