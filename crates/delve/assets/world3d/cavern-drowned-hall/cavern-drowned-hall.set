set cavern-drowned-hall
# The Drowned Hall: 48 x 28 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 768 448
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    ground  at 384 -4 24 size 768 4 48
box    ground  at 32 -4 248 size 64 4 400
box    ground  at 384 -4 248 size 384 4 400
box    ground  at 736 -4 248 size 64 4 400
box    ground  at 128 -4 128 size 128 4 64
box    ground  at 640 -4 128 size 128 4 64
box    ground  at 128 -4 224 size 128 4 64
box    ground  at 640 -4 224 size 128 4 64
box    ground  at 128 -4 320 size 128 4 64
box    ground  at 640 -4 320 size 128 4 64
box    ground  at 128 -4 424 size 128 4 48
box    ground  at 640 -4 424 size 128 4 48

# water, 3 below the floor line
box    water   at 128 -4 72 size 128 1 48
box    water   at 640 -4 72 size 128 1 48
box    water   at 128 -4 176 size 128 1 32
box    water   at 640 -4 176 size 128 1 32
box    water   at 128 -4 272 size 128 1 32
box    water   at 640 -4 272 size 128 1 32
box    water   at 128 -4 376 size 128 1 48
box    water   at 640 -4 376 size 128 1 48

# the north wall, columns 0 to 22
box    rock    at 184 -4 8 size 368 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8

# the north wall, columns 25 to 47
box    rock    at 584 -4 8 size 368 52 16
