set crypt-catacomb-shelves
# The Catacomb Shelves: 48 x 28 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 768 448
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 384 -4 64 size 768 4 128
box    floor   at 48 -4 288 size 96 4 320
box    floor   at 384 -4 288 size 416 4 320
box    floor   at 720 -4 288 size 96 4 320
box    floor   at 136 -4 224 size 80 4 128
box    floor   at 632 -4 224 size 80 4 128
box    floor   at 136 -4 384 size 80 4 128
box    floor   at 632 -4 384 size 80 4 128

# pits: holes in the floor, dark below

