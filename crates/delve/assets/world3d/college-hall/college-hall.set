set college-hall
# Great Hall: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Painted on open floor, not blocks: candles and books on the tables.

# the ground: its top is the floor line
box    floor   at 192 -4 112 size 384 4 224

# the north wall, columns 0 to 23
box    stone   at 192 -4 8 size 384 52 16

# the south wall, columns 0 to 23 (at 81% of its height, for the camera)
box    stone   at 192 -4 212 size 384 10 8  # TODO prims: wedge
box    stone   at 192 -4 220 size 384 16.5 8

# the west wall, rows 1 to 12
box    stone   at 8 -4 112 size 16 52 192

# the east wall, rows 1 to 12
box    stone   at 376 -4 112 size 16 52 192

# table at 4,8 5x2 (at 64% of its height, for the camera)
box    wood    at 104 0 144 size 78 5.5 30 id table-1
box    cloth   at 104 5.5 144 size 79 0.5 31

# table at 15,8 5x2 (at 64% of its height, for the camera)
box    wood    at 280 0 144 size 78 5.5 30 id table-2
box    cloth   at 280 5.5 144 size 79 0.5 31

# column at 7,5 1x1 (at 24% of its height, for the camera)
box    stone   at 120 -4 88 size 12 11.5 12 id column-1  # TODO prims: cylinder
box    stone   at 120 7.5 88 size 14 0.5 14

# column at 16,5 1x1 (at 24% of its height, for the camera)
box    stone   at 264 -4 88 size 12 11.5 12 id column-2  # TODO prims: cylinder
box    stone   at 264 7.5 88 size 14 0.5 14

# rug at 10,6 4x6
box    rug     at 192 0 144 size 62 0.6 94 id rug

# plate at 11,3 2x1
box    stone   at 192 0 56 size 30 1.5 14 id plate-1  # TODO prims: stairs

# plate at 3,4 2x1
box    stone   at 64 0 72 size 30 1.5 14 id plate-2  # TODO prims: stairs

# plate at 19,4 2x1
box    stone   at 320 0 72 size 30 1.5 14 id plate-3  # TODO prims: stairs

# plate at 11,12 2x1
box    stone   at 192 0 200 size 30 1.5 14 id plate-4  # TODO prims: stairs

# fixed to the far wall: windows, banners, hearths, lamps
box    stone   at 170 0 15.75 size 28 20 2.5
box    fire    at 170 2 16.5 size 16 9 2
box    cloth   at 104 14 15.75 size 10 26 2.5
box    cloth   at 270 14 15.75 size 10 26 2.5
