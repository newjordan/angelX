# landmark (assets/world3d/saltworks/landmark.set, hand-placed)
# Saltspite Works: a brick boiling house with its tall chimney, and the graduation tower of brushwood over the brine.
# Hand-placed by the landmark pass on the room's blocked back band and what lies behind it,
# so it never stands on a tile a knight walks or hides the floor from the camera.

# the boiling house and its chimney
box    brick   at 96 0 -2 size 96 28 28 id lm-boiling-house
gable  slate   at 96 28 -2 size 104 18 32
frustum-10 brick   at 130 0 -9 size 16 66 16 id lm-chimney
box    brick   at 130 66 -9 size 13 4 13
box    door    at 80 0 12.5 size 14 20 2
# the graduation tower: a timber frame packed with brushwood over a brine trough
box    stone   at 292 0 -2 size 128 6 22 id lm-brine-trough
box    thatch  at 292 6 -4 size 112 40 9 id lm-graduation
box    wood    at 240 6 -4 size 5 46 14
box    wood    at 266 6 -4 size 5 46 14
