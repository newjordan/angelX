set saltworks
# Saltspite Works: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Painted on open ground, not blocks: salt heaps, kerbs round the pans (rows 2..4), the barge plate (19,10).

