set causeway
# Toll Troll Causeway: 24 x 14 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 384 224
plate 1536 1024
# Painted on open ground, not blocks: the dressed kerbs along the water (rows 3 and 10), signs, the troll.

# the ground: its top is the floor line
box    ground  at 88 -4 8 size 176 4 16
box    grass   at 192 -4 40 size 32 4 80
