set archive-drowned-stacks
# The Drowned Stacks: 36 x 20 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 576 320
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 288 -4 16 size 576 4 32
box    floor   at 8 -4 176 size 16 4 288
box    floor   at 288 -4 176 size 448 4 288
box    floor   at 568 -4 176 size 16 4 288
box    floor   at 40 -4 160 size 48 4 160
box    floor   at 536 -4 160 size 48 4 160
box    floor   at 40 -4 304 size 48 4 32
box    floor   at 536 -4 304 size 48 4 32

# water, 3 below the floor line
box    water   at 40 -4 56 size 48 1 48
box    water   at 536 -4 56 size 48 1 48
box    water   at 40 -4 264 size 48 1 48
box    water   at 536 -4 264 size 48 1 48

