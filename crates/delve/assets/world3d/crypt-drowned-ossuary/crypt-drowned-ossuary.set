set crypt-drowned-ossuary
# The Drowned Ossuary: 34 x 20 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 544 320
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 272 -4 16 size 544 4 32
box    floor   at 24 -4 176 size 48 4 288
box    floor   at 272 -4 56 size 352 4 48
box    floor   at 520 -4 176 size 48 4 288
box    floor   at 72 -4 160 size 48 4 192
box    floor   at 472 -4 160 size 48 4 192
box    floor   at 104 -4 200 size 16 4 240
box    floor   at 272 -4 200 size 224 4 240
box    floor   at 440 -4 200 size 16 4 240
box    floor   at 136 -4 160 size 48 4 96
box    floor   at 408 -4 160 size 48 4 96
box    floor   at 136 -4 280 size 48 4 80
box    floor   at 408 -4 280 size 48 4 80
box    floor   at 72 -4 304 size 48 4 32
box    floor   at 472 -4 304 size 48 4 32

# pits: holes in the floor, dark below

# the north wall, columns 0 to 15
box    stone   at 128 -4 8 size 256 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8

# the north wall, columns 18 to 33
box    stone   at 416 -4 8 size 256 52 16
box    metal   at 536 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 536 51 8 size 8 10.4 8

# the south wall, columns 0 to 15 (at 81% of its height, for the camera)
