set hellforge-great-forge-ring
# The Great Forge Ring: 48 x 28 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 768 448
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 384 -4 40 size 768 4 80
box    floor   at 72 -4 264 size 144 4 368
box    floor   at 384 -4 264 size 320 4 368
box    floor   at 696 -4 264 size 144 4 368
box    floor   at 152 -4 224 size 16 4 224
box    floor   at 616 -4 224 size 16 4 224
box    floor   at 192 -4 224 size 64 4 192
box    floor   at 576 -4 224 size 64 4 192
box    floor   at 184 -4 408 size 80 4 80
box    floor   at 584 -4 408 size 80 4 80

# lava, 2 below the floor line
box    fire    at 184 -4 96 size 80 2 32
box    fire    at 584 -4 96 size 80 2 32
box    fire    at 192 -4 120 size 64 2 16
box    fire    at 576 -4 120 size 64 2 16
box    fire    at 192 -4 344 size 64 2 48
box    fire    at 576 -4 344 size 64 2 48
box    fire    at 152 -4 352 size 16 2 32
box    fire    at 616 -4 352 size 16 2 32

# the north wall, columns 0 to 22
