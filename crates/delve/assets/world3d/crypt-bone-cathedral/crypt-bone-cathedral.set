set crypt-bone-cathedral
# The Bone Cathedral: 48 x 28 tiles of 16 stage pixels.
# Made from the game's own layout by angel-delve world3d::blockout; written by the
# write_world3d_sets test (ANGEL_WORLD3D_SETS=1). Change the generator, not this file.
camera room 768 448
plate 1536 1024
# Torches flank every doorway; bars close them while the fight lasts (sprites).

# the ground: its top is the floor line
box    floor   at 384 -4 224 size 768 4 448

# the north wall, columns 0 to 22
box    stone   at 184 -4 8 size 368 52 16
box    metal   at 8 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 8 51 8 size 8 10.4 8

# the north wall, columns 25 to 47
box    stone   at 584 -4 8 size 368 52 16
box    metal   at 760 48 8 size 10 3 10  # TODO prims: frustum
cone   fire    at 760 51 8 size 8 10.4 8

# the south wall, columns 0 to 22 (at 81% of its height, for the camera)
box    stone   at 184 -4 436 size 368 10 8  # TODO prims: wedge
box    stone   at 184 -4 444 size 368 16.5 8
box    metal   at 8 12.5 444 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 8 15 444 size 6 6.5 6

# the south wall, columns 25 to 47 (at 81% of its height, for the camera)
box    stone   at 584 -4 436 size 368 10 8  # TODO prims: wedge
box    stone   at 584 -4 444 size 368 16.5 8
box    metal   at 760 12.5 444 size 8 2.5 8  # TODO prims: frustum
cone   fire    at 760 15 444 size 6 6.5 6

# the west wall, rows 1 to 12
box    stone   at 8 -4 112 size 16 52 192

# the west wall, rows 15 to 26 (at 12% of its height, for the camera)
