box    stone   at 8 -4 360 size 16 52 144

# the east wall, rows 1 to 12
box    stone   at 760 -4 112 size 16 52 192

# the east wall, rows 15 to 26 (at 12% of its height, for the camera)
box    stone   at 760 -4 264 size 16 9.5 48  # TODO prims: wedge
box    stone   at 760 -4 360 size 16 52 144

# the north door, columns 23 to 24
box    door    at 384 -4 -1 size 32 36 2 id door-north
box    stone   at 384 32 8 size 32 16 16  # TODO prims: arch

# the south door, columns 23 to 24
box    door    at 384 -4 449 size 32 5 2 id door-south

# the west door, rows 13 to 14
