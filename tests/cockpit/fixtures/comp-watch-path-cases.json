{
  "path_scoped_shell_cat_is_preflight": [
    {
      "kind": "shell_hay_is_product_inspect",
      "input": "cat src/kernel.cu",
      "expected": true
    },
    {
      "kind": "shell_hay_is_product_inspect",
      "input": "head -n 80 src/kernel.cu",
      "expected": true
    },
    {
      "kind": "shell_hay_is_product_inspect",
      "input": "tail -20 ./src/kernel.cu",
      "expected": true
    },
    {
      "kind": "shell_hay_is_product_inspect",
      "input": "cat kernel.cu",
      "expected": false
    },
    {
      "kind": "shell_hay_is_product_inspect",
      "input": "cat LIVING_HANDOFF.md",
      "expected": false
    },
    {
      "kind": "shell_hay_is_product_inspect",
      "input": "cat /tmp/kernel.cu",
      "expected": false
    },
    {
      "kind": "shell_hay_is_product_inspect",
      "input": "cat src/kernel.cu | wc -l",
      "expected": false
    },
    {
      "kind": "shell_hay_is_product_inspect",
      "input": "",
      "expected": false
    },
    {
      "kind": "is_local_preflight_call",
      "input": "cat src/kernel.cu",
      "expected": true,
      "message": "path-scoped cat is candidate preflight"
    },
    {
      "kind": "is_local_preflight_call",
      "input": "head -n 80 src/kernel.cu",
      "expected": true,
      "message": "path-scoped head is candidate preflight"
    },
    {
      "kind": "is_local_preflight_call",
      "input": "cat kernel.cu",
      "expected": false,
      "message": "workspace basename cat stays recon"
    },
    {
      "kind": "is_local_preflight_call",
      "input": "cat LIVING_HANDOFF.md",
      "expected": false,
      "message": "cat of a board name must not launder as preflight"
    }
  ],
