# The fen town as data: tile rows, the villagers' stopping places and the routes
# between them. Generated by generate.mjs from the native map (town.rs) and its walking routes;
# the parity tests compare the module to the native town on every tick.

type Row is Data:
  Row{w0: U32, w1: U32, w2: U32, w3: U32, w4: U32}

