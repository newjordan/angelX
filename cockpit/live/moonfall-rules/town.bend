  row_1(U32.is_lt(i, 14), i)

def row_word(+r: Row, +w: U32) -> U32:
  match r:
    case Row{+w0, +w1, +w2, +w3, +w4}:
      Bool.pick(U32, U32.is_lt(w, 2), Bool.pick(U32, U32.is_lt(w, 1), w0, w1), Bool.pick(U32, U32.is_lt(w, 4), Bool.pick(U32, U32.is_lt(w, 3), w2, w3), w4))

# The tile class at column tx, row ty: 0 grass, 1 cobble, 2 water, 3 bridge, 4 plank,
# 5 reeds, 6 hedge, 7 ditch, 8 door, 9 gate, 10 a wall. Beyond the map is water.
def cls_in(+tx: U32, +r: Row) -> U32:
  U32.and(U32.shrn(row_word(r, (tx / 8 : U32)), Nat.mul(U32.to_nat((tx % 8 : U32)), 4n)), 15)

def cls_at(+tx: U32, +ty: U32) -> U32:
  cls_in(tx, row(ty))

def cls_pick(+ok: Bool, +tx: U32, +ty: U32) -> U32:
  match ok:
    case True{}:
      cls_at(tx, ty)
    case False{}:
      2

def cls(+tx: U32, +ty: U32) -> U32:
  cls_pick(Bool.and(U32.is_lt(tx, 38), U32.is_lt(ty, 28)), tx, ty)

