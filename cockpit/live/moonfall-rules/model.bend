def s_n_wisps(+r: Sess) -> U32:
  vg(s_w(r), 2, 2, 0)

def s_n_rewind(+r: Sess) -> U32:
  vg(s_w(r), 2, 2, 1)

def s_n_notice(+r: Sess) -> U32:
  vg(s_w(r), 2, 2, 2)
