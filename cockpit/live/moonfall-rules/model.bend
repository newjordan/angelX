import Base

# The records of the Moonfall rules, and a getter and a setter for every field they use.
# Generated by generate.mjs from its field lists; do not edit by hand.

# A tree of words: four children to a node, three deep, so 64 slots. A slot is named by the
# three base-four digits of its place.
type V is Data:
  Lf{x: U32}
  Qd{a: V, b: V, c: V, d: V}

def v_pick(+n: U32, +a: V, +b: V, +c: V, +d: V) -> V:
  Bool.pick(V, U32.is_lt(n, 2), Bool.pick(V, U32.is_eq(n, 0), a, b), Bool.pick(V, U32.is_eq(n, 2), c, d))

def v_child(+t: V, +n: U32) -> V:
  match t:
    case Lf{_}:
      t
    case Qd{+a, +b, +c, +d}:
      v_pick(n, a, b, c, d)

def v_leaf(+t: V) -> U32:
  match t:
    case Lf{+x}:
      x
    case Qd{_, _, _, _}:
      0

def v_put(+t: V, +n: U32, +child: V) -> V:
  match t:
    case Lf{_}:
      t
    case Qd{+a, +b, +c, +d}:
      Qd{Bool.pick(V, U32.is_eq(n, 0), child, a), Bool.pick(V, U32.is_eq(n, 1), child, b), Bool.pick(V, U32.is_eq(n, 2), child, c), Bool.pick(V, U32.is_eq(n, 3), child, d)}

def vg(+t: V, +a: U32, +b: U32, +c: U32) -> U32:
  v_leaf(v_child(v_child(v_child(t, a), b), c))

def vs(+t: V, +a: U32, +b: U32, +c: U32, +v: U32) -> V:
  +t1 = v_child(t, a)
  +t2 = v_child(t1, b)
  v_put(t, a, v_put(t1, b, v_put(t2, c, Lf{v})))

def v_zero() -> V:
  +l = {Lf{0} : V}
  +r = {Qd{l, l, l, l} : V}
  +q = {Qd{r, r, r, r} : V}
  Qd{q, q, q, q}

type Kn is Data:
  Kn{w: V}

type Wp is Data:
  Wp{x: U32, y: U32, mode: U32, t: U32, aim: U32, born: U32}

type Nw is Data:
  Nw{kind: U32, a: U32, b: U32, left: U32}

type In is Data:
  In{id: U32, valid: U32, interact: U32, take: U32, swing: U32, ult: U32, play: U32, bomb: U32, dash: U32, mx: U32, my: U32, ax: U32, ay: U32}

type He is Data:
