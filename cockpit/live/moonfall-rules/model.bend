def k_id(+r: Kn) -> U32:
  match r:
    case Kn{+w}:
      vg(w, 0, 0, 0)

def k_set_id(+r: Kn, +v: U32) -> Kn:
  match r:
    case Kn{+w}:
      Kn{vs(w, 0, 0, 0, v)}

