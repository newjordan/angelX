import Base
# Bannerpeak's world, baked from crates/delve/assets/bannerpeak/*.map by the same
# compose pass layout::world runs: six sections laid on one 434 by 64 grid, a later
# section writing over an earlier, a mark glyph read out and left as air. A row
# travels as runs of one code, so the air costs nothing; a mark travels as its
# cell, and the eight signboards as a word code (see layout::sign_text).
type Run is Data:
  Run{col: U32, code: U32, len: U32}
type P is Data:
  P{x: U32, y: U32}
type FoeMark is Data:
  FoeMark{kind: U32, x: U32, y: U32}
type Sign is Data:
  Sign{x: U32, y: U32, word: U32}
def width() -> U32:
  434
def height() -> U32:
  64
