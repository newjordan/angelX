def desperate.last_stand.k4(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +shots: J.Val, +deeds: J.Val, +d: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
