def desperate.last_stand.k10(+enemy: J.Val, +shots: J.Val, +deeds: J.Val, +d: F32, +t: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +deeds = {foes.cue(deeds, "last_stand_ring") : J.Val}
  desperate.last_stand.k5(enemy, shots, deeds, d, t)

def desperate.last_stand.if12(_c: Bool, +enemy: J.Val, +shots: J.Val, +deeds: J.Val, +d: F32, +t: U32, +aim: F32, +step: F32, +_t11: List<&2, U32>, +angle: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
