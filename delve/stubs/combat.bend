      +shots = {J.push(shots, desperate.bolt(enemy, angle, 4.5, 10, "orb")) : J.Val}
      desperate.last_stand.loop8(_t8, enemy, shots, deeds, turn)

def desperate.last_stand.if7(_c: Bool, +enemy: J.Val, +shots: J.Val, +deeds: J.Val, +t: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +turn = {(cb.f((t - desperate.ARMS_FROM() : U32)) * 0.16 : F32) : F32}
      desperate.last_stand.loop8(cb.range(3), enemy, shots, deeds, turn)
    case False{}:
      desperate.last_stand.k6(enemy, shots, deeds)

def desperate.last_stand.k5(+enemy: J.Val, +shots: J.Val, +deeds: J.Val, +d: F32, +t: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
