# --- peasant.rs: Scarecrows taunt this room while standing, else the knights are seen

def peasant.sights(+tick: W.W, +scarecrows: J.Val, +enemy: J.Val, +knights: J.Val, +images: J.Val) -> J.Val:
  +out = {J.JA{Nil{}} : J.Val}
  peasant.sights.loop4(J.items(scarecrows), tick, enemy, knights, images, out)

def peasant.sights.k2(+out: J.Val) -> J.Val:
  out

def peasant.sights.if3(_c: Bool, +enemy: J.Val, +knights: J.Val, +images: J.Val, +out: J.Val) -> J.Val:
  match _c:
    case True{}:
      press.sights(enemy, knights, images)
    case False{}:
      peasant.sights.k2(out)

def peasant.sights.k1(+enemy: J.Val, +knights: J.Val, +images: J.Val, +out: J.Val) -> J.Val:
  peasant.sights.if3(U32.is_eq(J.len(out), 0), enemy, knights, images, out)

def peasant.sights.if5(_c: Bool, +tick: W.W, +enemy: J.Val, +knights: J.Val, +images: J.Val, +out: J.Val, +_t4: List<&2, J.Val>, +d: J.Val) -> J.Val:
  match _c:
    case True{}:
      +out = {J.push(out, cb.of_pair(J.f32(J.get(d, "x")), J.f32(J.get(d, "y")))) : J.Val}
      peasant.sights.loop4(_t4, tick, enemy, knights, images, out)
    case False{}:
      peasant.sights.loop4(_t4, tick, enemy, knights, images, out)

def peasant.sights.loop4(+_xs: List<&2, J.Val>, +tick: W.W, +enemy: J.Val, +knights: J.Val, +images: J.Val, +out: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      peasant.sights.k1(enemy, knights, images, out)
    case Con{+d, +_t4}:
      peasant.sights.if5(W.lt(tick, W.of_j(J.get(d, "until"))), tick, enemy, knights, images, out, _t4, d)

# --- tune.rs: a foe's step stretched or shortened by the room's pace

def tune.foe_step(+enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +room: J.Val, +barred: Bool) -> J.Val:
  +dx = {(cb.gf(enemy, "x") - fx : F32) : F32}
  +dy = {(cb.gf(enemy, "y") - fy : F32) : F32}
  +d = {cb.hyp(dx, dy) : F32}
  tune.foe_step.if5(Bool.or(F32.is_eq(d, 0.0), (d > tune.LONGEST_STEP() : F32)), enemy, fx, fy, pace, room, barred, dx, dy)

def tune.foe_step.k2(+enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +dx: F32, +dy: F32) -> J.Val:
  +enemy = {cb.sf(enemy, "x", (fx + dx * pace : F32)) : J.Val}
  +enemy = {cb.sf(enemy, "y", (fy + dy * pace : F32)) : J.Val}
  enemy

def tune.foe_step.k4(+_t: F32 & F32, +enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +dx: F32, +dy: F32) -> J.Val:
  (+nx, +ny) = _t
  +enemy = {cb.sf(enemy, "x", nx) : J.Val}
  +enemy = {cb.sf(enemy, "y", ny) : J.Val}
  enemy

def tune.foe_step.if3(_c: Bool, +enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +room: J.Val, +barred: Bool, +dx: F32, +dy: F32) -> J.Val:
  match _c:
    case True{}:
      tune.foe_step.k4(rules.Grid.slide(room, barred, (cb.gf(enemy, "x"), cb.gf(enemy, "y")), ((dx * (pace - 1.0 : F32) : F32), (dy * (pace - 1.0 : F32) : F32)), monsters.Enemy.radius(enemy), foes.mover(cb.gs(enemy, "kind"))), enemy, fx, fy, pace, dx, dy)
    case False{}:
      tune.foe_step.k2(enemy, fx, fy, pace, dx, dy)

def tune.foe_step.k1(+enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +room: J.Val, +barred: Bool, +dx: F32, +dy: F32) -> J.Val:
  tune.foe_step.if3((pace > 1.0 : F32), enemy, fx, fy, pace, room, barred, dx, dy)

def tune.foe_step.if5(_c: Bool, +enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +room: J.Val, +barred: Bool, +dx: F32, +dy: F32) -> J.Val:
  match _c:
    case True{}:
      enemy
    case False{}:
      tune.foe_step.k1(enemy, fx, fy, pace, room, barred, dx, dy)

# --- wishcraft.rs: a chilled monster's step

def wishcraft.slow(+enemy: J.Val, +fx: F32, +fy: F32, +room: J.Val, +barred: Bool) -> J.Val:
  wishcraft.slow.if2(U32.is_eq(cb.gu(enemy, "chilled"), 0), enemy, fx, fy, room, barred)

def wishcraft.slow.k1(+enemy: J.Val, +fx: F32, +fy: F32, +room: J.Val, +barred: Bool) -> J.Val:
  +enemy = {cb.su0(enemy, "chilled", (cb.gu(enemy, "chilled") - 1 : U32)) : J.Val}
  tune.foe_step(enemy, fx, fy, 0.6, room, barred)

def wishcraft.slow.if2(_c: Bool, +enemy: J.Val, +fx: F32, +fy: F32, +room: J.Val, +barred: Bool) -> J.Val:
  match _c:
    case True{}:
      enemy
    case False{}:
      wishcraft.slow.k1(enemy, fx, fy, room, barred)

# --- skills.rs: foes cannot walk through a standing barricade

def skills.shove(+enemy: J.Val, +barricades: J.Val) -> J.Val:
  skills.shove.loop2(J.items(barricades), enemy)

def skills.shove.k1(+enemy: J.Val) -> J.Val:
  enemy

def skills.shove.k8(+enemy: J.Val, +_t2: List<&2, J.Val>, +px: F32, +py: F32, +reach: F32, +ux: F32, +uy: F32) -> J.Val:
  +enemy = {cb.sf(enemy, "x", (px + ux * reach : F32)) : J.Val}
  +enemy = {cb.sf(enemy, "y", (py + uy * reach : F32)) : J.Val}
  skills.shove.loop2(_t2, enemy)

def skills.shove.k10(+_t: F32 & F32, +enemy: J.Val, +_t2: List<&2, J.Val>, +px: F32, +py: F32, +reach: F32, +ux: F32, +uy: F32) -> J.Val:
  (+wx, +wy) = _t
  +ux = {wx : F32}
  +uy = {wy : F32}
  skills.shove.k8(enemy, _t2, px, py, reach, ux, uy)

def skills.shove.if9(_c: Bool, +enemy: J.Val, +_t2: List<&2, J.Val>, +ax: F32, +ay: F32, +bx: F32, +by: F32, +px: F32, +py: F32, +reach: F32, +ux: F32, +uy: F32) -> J.Val:
  match _c:
    case True{}:
      skills.shove.k10(rules.unit(RS.f_neg((by - ay : F32)), (bx - ax : F32)), enemy, _t2, px, py, reach, ux, uy)
    case False{}:
      skills.shove.k8(enemy, _t2, px, py, reach, ux, uy)

def skills.shove.if7(_c: Bool, +enemy: J.Val, +_t2: List<&2, J.Val>, +ax: F32, +ay: F32, +bx: F32, +by: F32, +px: F32, +py: F32, +reach: F32, +dx: F32, +dy: F32, +d: F32) -> J.Val:
  match _c:
    case True{}:
      +ux = {(dx / d : F32) : F32}
      +uy = {(dy / d : F32) : F32}
      skills.shove.if9(Bool.not((d > 0.001 : F32)), enemy, _t2, ax, ay, bx, by, px, py, reach, ux, uy)
    case False{}:
      skills.shove.loop2(_t2, enemy)

def skills.shove.k6(+enemy: J.Val, +_t2: List<&2, J.Val>, +ax: F32, +ay: F32, +bx: F32, +by: F32, +dx0: F32, +dy0: F32, +t: F32) -> J.Val:
  +px = {(ax + t * dx0 : F32) : F32}
  +py = {(ay + t * dy0 : F32) : F32}
  +reach = {(monsters.Enemy.radius(enemy) * 0.7 + 0.5 : F32) : F32}
  +dx = {(cb.gf(enemy, "x") - px : F32) : F32}
  +dy = {(cb.gf(enemy, "y") - py : F32) : F32}
  +d = {cb.hyp(dx, dy) : F32}
  skills.shove.if7((d < reach : F32), enemy, _t2, ax, ay, bx, by, px, py, reach, dx, dy, d)

def skills.shove.if11(_c: Bool, +enemy: J.Val, +_t2: List<&2, J.Val>, +ax: F32, +ay: F32, +bx: F32, +by: F32, +dx0: F32, +dy0: F32, +length: F32, +t: F32) -> J.Val:
  match _c:
    case True{}:
      +t = {RS.f_clamp((((cb.gf(enemy, "x") - ax : F32) * dx0 + (cb.gf(enemy, "y") - ay : F32) * dy0 : F32) / length : F32), 0.0, 1.0) : F32}
      skills.shove.k6(enemy, _t2, ax, ay, bx, by, dx0, dy0, t)
    case False{}:
      skills.shove.k6(enemy, _t2, ax, ay, bx, by, dx0, dy0, t)

def skills.shove.k5(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +_t2: List<&2, J.Val>, +ax: F32, +ay: F32) -> J.Val:
  (+bx, +by) = _t
  +dx0 = {(bx - ax : F32) : F32}
  +dy0 = {(by - ay : F32) : F32}
  +length = {(dx0 * dx0 + dy0 * dy0 : F32) : F32}
  +t = {0.0 : F32}
  skills.shove.if11((length > 0.0 : F32), enemy, _t2, ax, ay, bx, by, dx0, dy0, length, t)

def skills.shove.k4(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +_t2: List<&2, J.Val>, +w: J.Val) -> J.Val:
  (+ax, +ay) = _t
  skills.shove.k5(cb.pair(J.get(w, "b")), enemy, _t2, ax, ay)

def skills.shove.if3(_c: Bool, +enemy: J.Val, +_t2: List<&2, J.Val>, +w: J.Val) -> J.Val:
  match _c:
    case True{}:
      skills.shove.k4(cb.pair(J.get(w, "a")), enemy, _t2, w)
    case False{}:
      skills.shove.loop2(_t2, enemy)

def skills.shove.loop2(+_xs: List<&2, J.Val>, +enemy: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      skills.shove.k1(enemy)
    case Con{+w, +_t2}:
      skills.shove.if3(J.is_null(J.get(w, "fall")), enemy, _t2, w)

# --- ledge.rs: a walker side-on keeps the ground it walks on (not yet ported)

def ledge.fall(+enemy: J.Val, +room: J.Val, +barred: Bool) -> J.Val:
  enemy

# --- hireling.rs

def hireling.ROAR_REACH() -> F32:
  7.0

# --- stakes.rs: a deep floor's extra shots in a fan

def stakes.fan_out(+fury: U32, +shots: List<&2, J.Val>, +from: U32) -> List<&2, J.Val>:
  +fired = {Nil{} : List<&2, J.Val>}
  +i = {0 : U32}
  stakes.fan_out.loop6(shots, fury, shots, from, fired, i)

def stakes.fan_out.k2(+out: List<&2, J.Val>) -> List<&2, J.Val>:
  out

def stakes.fan_out.loop5(+_xs: List<&2, F32>, +fury: U32, +out: List<&2, J.Val>, +_t3: List<&2, J.Val>, +shot: J.Val, +_t4: List<&2, U32>, +turn: F32) -> List<&2, J.Val>:
  match _xs:
    case Nil{}:
      stakes.fan_out.loop4(_t4, fury, out, _t3, shot)
    case Con{+sign, +_t5}:
      +t = {(turn * sign : F32) : F32}
      +c = {F32.cos(t) : F32}
      +s2 = {F32.sin(t) : F32}
      +copy = {shot : J.Val}
      +copy = {cb.sf(copy, "vx", (cb.gf(shot, "vx") * c - cb.gf(shot, "vy") * s2 : F32)) : J.Val}
      +copy = {cb.sf(copy, "vy", (cb.gf(shot, "vx") * s2 + cb.gf(shot, "vy") * c : F32)) : J.Val}
      +out = {List.append(&2, J.Val, out, [copy]) : List<&2, J.Val>}
      stakes.fan_out.loop5(_t5, fury, out, _t3, shot, _t4, turn)

def stakes.fan_out.loop4(+_xs: List<&2, U32>, +fury: U32, +out: List<&2, J.Val>, +_t3: List<&2, J.Val>, +shot: J.Val) -> List<&2, J.Val>:
  match _xs:
    case Nil{}:
      stakes.fan_out.loop3(_t3, fury, out)
    case Con{+k0, +_t4}:
      +turn = {(0.2 * cb.f((k0 + 1 : U32)) : F32) : F32}
      stakes.fan_out.loop5([1.0, F32.neg(1.0)], fury, out, _t3, shot, _t4, turn)

def stakes.fan_out.loop3(+_xs: List<&2, J.Val>, +fury: U32, +out: List<&2, J.Val>) -> List<&2, J.Val>:
  match _xs:
    case Nil{}:
      stakes.fan_out.k2(out)
    case Con{+shot, +_t3}:
      stakes.fan_out.loop4(cb.range(fury), fury, out, _t3, shot)

def stakes.fan_out.k1(+fury: U32, +shots: List<&2, J.Val>, +fired: List<&2, J.Val>) -> List<&2, J.Val>:
  +out = {shots : List<&2, J.Val>}
  stakes.fan_out.loop3(fired, fury, out)

def stakes.fan_out.k7(+fury: U32, +shots: List<&2, J.Val>, +from: U32, +fired: List<&2, J.Val>, +i: U32, +_t6: List<&2, J.Val>) -> List<&2, J.Val>:
  +i = {(i + 1 : U32) : U32}
  stakes.fan_out.loop6(_t6, fury, shots, from, fired, i)

def stakes.fan_out.if8(_c: Bool, +fury: U32, +shots: List<&2, J.Val>, +from: U32, +fired: List<&2, J.Val>, +i: U32, +_t6: List<&2, J.Val>, +s: J.Val) -> List<&2, J.Val>:
  match _c:
    case True{}:
      +fired = {List.append(&2, J.Val, fired, [s]) : List<&2, J.Val>}
      stakes.fan_out.k7(fury, shots, from, fired, i, _t6)
    case False{}:
      stakes.fan_out.k7(fury, shots, from, fired, i, _t6)

def stakes.fan_out.loop6(+_xs: List<&2, J.Val>, +fury: U32, +shots: List<&2, J.Val>, +from: U32, +fired: List<&2, J.Val>, +i: U32) -> List<&2, J.Val>:
  match _xs:
    case Nil{}:
      stakes.fan_out.k1(fury, shots, fired)
    case Con{+s, +_t6}:
      stakes.fan_out.if8(Bool.and(U32.is_ge(i, from), Bool.and(J.is_null(cb.gj(cb.gj(cb.gj(s, "traits"), "path"), "beam")), U32.is_lt(U32.from_nat(List.length(&2, J.Val, fired)), 12))), fury, shots, from, fired, i, _t6, s)

# --- rules.rs

def rules.Run.foes_left(+run: J.Val) -> Bool:
  rules.Run.foes_left.loop2(J.items(cb.gj(run, "enemies")))

def rules.Run.foes_left.k1() -> Bool:
  False{}

def rules.Run.foes_left.if3(_c: Bool, +_t2: List<&2, J.Val>) -> Bool:
  match _c:
    case True{}:
      True{}
    case False{}:
      rules.Run.foes_left.loop2(_t2)

def rules.Run.foes_left.loop2(+_xs: List<&2, J.Val>) -> Bool:
  match _xs:
    case Nil{}:
      rules.Run.foes_left.k1()
    case Con{+e, +_t2}:
      rules.Run.foes_left.if3(Bool.not(String.eq(cb.gs(e, "kind"), "dummy")), _t2)

# --- the default ShotTraits (rules.rs), which core's desperate.bolt builds shots with

def projectile.ShotTraits.default() -> J.Val:
  patterns.ShotTraits.default()
