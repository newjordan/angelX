      desperate.last_stand.if12(Bool.not((off < (step * cb.f(desperate.RING_LANE()) / 2.0 : F32) : F32)), enemy, shots, deeds, d, t, aim, step, _t11, angle)

def desperate.last_stand.if9(_c: Bool, +enemy: J.Val, +shots: J.Val, +deeds: J.Val, +d: F32, +tx: F32, +ty: F32, +t: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
