# --- rules.rs: mix

def rules.mix(+x: W.W) -> W.W:
  +h = {W.xor(x, W.shr(x, 33)) : W.W}
  +h = {W.mul(h, W.W{4283543511, 3981806797}) : W.W}
  +h = {W.xor(h, W.shr(h, 33)) : W.W}
  +h = {W.mul(h, W.W{3301882366, 444984403}) : W.W}
  W.xor(h, W.shr(h, 33))

# --- wishcraft.rs: how a knight's shot is sized

def wishcraft.Projectile.sized(+shot: J.Val) -> Bool:
  Bool.and(Bool.and(Bool.not(cb.gb(shot, "hostile")), U32.is_gt(cb.gu(cb.gj(shot, "traits"), "owner"), 0)), Bool.not(cb.gb(cb.gj(shot, "traits"), "borrowed")))

def wishcraft.rate_pct(+beat: U32) -> U32:
  wishcraft.rate_pct.if2(U32.is_eq(beat, 0), beat)

def wishcraft.rate_pct.k1(+beat: U32) -> U32:
  RS.u_clamp(RS.u_isqrt((10000 * beat / wishcraft.BEAT_REF() : U32)), wishcraft.RATE_MIN_PCT(), wishcraft.RATE_MAX_PCT())

def wishcraft.rate_pct.if2(_c: Bool, +beat: U32) -> U32:
  match _c:
    case True{}:
      100
    case False{}:
      wishcraft.rate_pct.k1(beat)

def wishcraft.Projectile.scale(+shot: J.Val) -> F32:
  wishcraft.Projectile.scale.if2(Bool.not(wishcraft.Projectile.sized(shot)), shot)

def wishcraft.Projectile.scale.k1(+shot: J.Val) -> F32:
  +size = {(100 + wishcraft.SIZE_STEP_PCT() * RS.u_min(cb.gu(cb.gj(shot, "traits"), "size"), 3) : U32) : U32}
  +pct = {(wishcraft.BASE_PCT() * wishcraft.rate_pct(cb.gu(cb.gj(shot, "traits"), "beat")) * size : U32) : U32}
  (cb.f(RS.u_max(pct, (wishcraft.FLOOR_PCT() * 10000 : U32))) / 1000000.0 : F32)

def wishcraft.Projectile.scale.if2(_c: Bool, +shot: J.Val) -> F32:
  match _c:
    case True{}:
      1.0
    case False{}:
      wishcraft.Projectile.scale.k1(shot)

def wishcraft.Projectile.reach(+shot: J.Val) -> F32:
  wishcraft.Projectile.reach.if2(Bool.not(wishcraft.Projectile.sized(shot)), shot)

def wishcraft.Projectile.reach.k1(+shot: J.Val) -> F32:
  (wishcraft.HIT_REACH() * RS.f_max((wishcraft.Projectile.scale(shot) - (cb.f(wishcraft.BASE_PCT()) / 100.0 : F32) : F32), 0.0) : F32)

def wishcraft.Projectile.reach.if2(_c: Bool, +shot: J.Val) -> F32:
  match _c:
    case True{}:
      (wishcraft.SIZE_REACH() * cb.f(RS.u_min(cb.gu(cb.gj(shot, "traits"), "size"), 3)) : F32)
    case False{}:
      wishcraft.Projectile.reach.k1(shot)

