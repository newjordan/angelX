def desperate.last_stand(+enemy: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +d = {desperate.Enemy.desperation(enemy) : F32}
  desperate.last_stand.if14(Bool.not((d > 0.0 : F32)), enemy, target, shots, deeds, d)

def desperate.last_stand.k6(+enemy: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (enemy, shots, deeds)

def desperate.last_stand.loop8(+_xs: List<&2, U32>, +enemy: J.Val, +shots: J.Val, +deeds: J.Val, +turn: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
