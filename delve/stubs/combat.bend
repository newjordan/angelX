def desperate.last_stand.loop11(+_xs: List<&2, U32>, +enemy: J.Val, +shots: J.Val, +deeds: J.Val, +d: F32, +t: U32, +aim: F32, +step: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
