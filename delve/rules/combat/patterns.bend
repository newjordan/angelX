# i as f32 / (n - 1).max(1) as f32 - 0.5

def patterns.frac(+i: U32, +n: U32) -> F32:
  ((cb.f(i) / cb.f(RS.u_max((n - 1 : U32), 1)) : F32) - 0.5 : F32)

# (i as f32 - (n - 1) as f32 / 2.0)

