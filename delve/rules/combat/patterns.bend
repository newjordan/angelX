# A number from 0 to 1, the same for the same volley and `k`.

def patterns.Aim.roll(+aim: J.Val, +k: U32) -> F32:
  +h = {W.xor(W.xor(cb.gw(aim, "salt"), W.mul(W.of_u32(cb.gu(aim, "count")), W.W{0, 2654435769})), W.shl(W.of_u32(k), 40)) : W.W}
  (cb.f(W.rem_u32(rules.mix(h), 10000)) / 10000.0 : F32)

def patterns.Aim.start(+aim: J.Val) -> F32:
  (cb.f(W.rem_u32(rules.mix(cb.gw(aim, "salt")), 10000)) / 10000.0 * cb.TAU() : F32)

