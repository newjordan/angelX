    case True{}:
      (enemy, shots)
    case False{}:
      patterns.volley.plain.k2(enemy, depth, src, at, pace, room, barred, salt, step, shield_line, shots, sig)

def patterns.volley.plain.k1(+enemy: J.Val, +pack: String, +depth: U32, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +sig = {patterns.signature(cb.gs(enemy, "kind"), pack, cb.gb(enemy, "elite")) : J.Val}
  patterns.volley.plain.if9(J.is_null(sig), enemy, depth, src, at, pace, room, barred, salt, step, shield_line, shots, sig)

def patterns.volley.plain.if10(_c: Bool, +enemy: J.Val, +pack: String, +depth: U32, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      (enemy, shots)
    case False{}:
      patterns.volley.plain.k1(enemy, pack, depth, src, at, pace, room, barred, salt, step, shield_line, shots)
