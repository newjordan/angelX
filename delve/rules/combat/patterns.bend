      patterns.wall.loop5(_t5, aim, n, gap, px, py, fx, fy, chinks, out)
    case False{}:
      patterns.wall.loop5(_t5, aim, n, gap, px, py, fx, fy, chinks, out)

def patterns.wall.if6(_c: Bool, +aim: J.Val, +n: U32, +gap: U32, +px: F32, +py: F32, +fx: F32, +fy: F32, +chinks: List<&2, U32>, +out: List<&2, Sigma<&2, &2, F32, _ => F32>>, +_t5: List<&2, U32>, +i: U32) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
  match _c:
    case True{}:
      +k = {(patterns.centred(i, n) * patterns.WALL_SPACING() : F32) : F32}
      +x = {(fx + px * k : F32) : F32}
      +y = {(fy + py * k : F32) : F32}
      patterns.wall.if7(Bool.not(rules.Grid.stops_body(cb.gj(cb.gj(aim, "grid"), "room"), cb.gb(cb.gj(aim, "grid"), "barred"), x, y, patterns.BODY())), aim, n, gap, px, py, fx, fy, chinks, out, _t5, x, y)
    case False{}:
      patterns.wall.loop5(_t5, aim, n, gap, px, py, fx, fy, chinks, out)

def patterns.wall.loop5(+_xs: List<&2, U32>, +aim: J.Val, +n: U32, +gap: U32, +px: F32, +py: F32, +fx: F32, +fy: F32, +chinks: List<&2, U32>, +out: List<&2, Sigma<&2, &2, F32, _ => F32>>) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
