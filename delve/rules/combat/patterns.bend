  patterns.landing.if3((r > 1.0 : F32), aim, fx, fy, ux, uy, r)

# The angles of a gap ring's shots: a turning ring with the slots inside
# GAP_HALF of the gap's middle left out.

def patterns.gap_ring(+aim: J.Val) -> List<&2, F32>:
  +n = {patterns.Aim.count_of(aim, patterns.GAP_RING_0(), patterns.GAP_RING_1()) : U32}
  +gap = {(patterns.Aim.line(aim) + (patterns.Aim.roll(aim, 6) - 0.5 : F32) * 2.0 * patterns.GAP_SWING() : F32) : F32}
  +turn = {(cb.f(cb.gu(aim, "count")) * 0.13 : F32) : F32}
  +out = {Nil{} : List<&2, F32>}
  patterns.gap_ring.loop2(cb.range(n), n, gap, turn, out)

def patterns.gap_ring.k1(+out: List<&2, F32>) -> List<&2, F32>:
  List.reverse(&2, F32, out)

def patterns.gap_ring.if3(_c: Bool, +n: U32, +gap: F32, +turn: F32, +out: List<&2, F32>, +_t2: List<&2, U32>, +a: F32) -> List<&2, F32>:
  match _c:
    case True{}:
      +out = {a <> out : List<&2, F32>}
      patterns.gap_ring.loop2(_t2, n, gap, turn, out)
    case False{}:
      patterns.gap_ring.loop2(_t2, n, gap, turn, out)

def patterns.gap_ring.loop2(+_xs: List<&2, U32>, +n: U32, +gap: F32, +turn: F32, +out: List<&2, F32>) -> List<&2, F32>:
  match _xs:
    case Nil{}:
      patterns.gap_ring.k1(out)
    case Con{+i, +_t2}:
      +a = {(turn + cb.f(i) * cb.TAU() / cb.f(n) : F32) : F32}
      +off = {RS.f_atan2(F32.sin((a - gap : F32)), F32.cos((a - gap : F32))) : F32}
      patterns.gap_ring.if3((RS.f_abs(off) >= patterns.GAP_HALF() : F32), n, gap, turn, out, _t2, a)

# How many shots of an n-slot wall the shield line's second wall leaves out.

def patterns.thinned(+n: U32) -> U32:
  ((RS.u_sat_sub(n, patterns.WALL_GAP()) * patterns.PAVISE_THINS() + 50 : U32) / 100 : U32)

# A wall's spots: n slots a unit apart across the line at the shooter, slot
# `gap` and the next left out; `thin` more left out evenly along it, each a
# chink a slot wide (never an end, nor beside the gap, nor beside another);
# and any in stone left out.

def patterns.wall(+aim: J.Val, +n: U32, +gap: U32, +thin: U32) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
  +line = {patterns.Aim.line(aim) : F32}
  +px = {F32.neg(F32.sin(line)) : F32}
  +py = {F32.cos(line) : F32}
  patterns.wall.k1(cb.gp(aim, "from"), aim, n, gap, thin, px, py)

def patterns.wall.k4(+out: List<&2, Sigma<&2, &2, F32, _ => F32>>) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
  List.reverse(&2, Sigma<&2, &2, F32, _ => F32>, out)

def patterns.wall.if7(_c: Bool, +aim: J.Val, +n: U32, +gap: U32, +px: F32, +py: F32, +fx: F32, +fy: F32, +chinks: List<&2, U32>, +out: List<&2, Sigma<&2, &2, F32, _ => F32>>, +_t5: List<&2, U32>, +x: F32, +y: F32) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
