# A guardian's charged beam: a warning line for `warn` ticks from `from`, then
# a burn of `burn` ticks that sweeps `arc` radians starting at `angle`.

def patterns.charged_beam(+room: J.Val, +barred: Bool, +src: Sigma<&2, &2, F32, _ => F32>, +angle: F32, +arc: F32, +warn: U32, +burn: U32, +kind: String, +damage: U32) -> J.Val:
  +burn = {RS.u_max(burn, 2) : U32}
