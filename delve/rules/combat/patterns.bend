def patterns.wall.k2(+aim: J.Val, +n: U32, +gap: U32, +thin: U32, +px: F32, +py: F32, +fx: F32, +fy: F32, +roomv: List<&2, U32>) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
