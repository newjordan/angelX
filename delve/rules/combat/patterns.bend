    case False{}:
      patterns.wall.loop9(_t9, aim, n, gap, thin, px, py, fx, fy, roomv)

def patterns.wall.k10(+aim: J.Val, +n: U32, +gap: U32, +thin: U32, +px: F32, +py: F32, +fx: F32, +fy: F32, +roomv: List<&2, U32>, +_t9: List<&2, U32>, +i: U32) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
  patterns.wall.if11(Bool.and(patterns.wall.open(i, gap), Bool.and(U32.is_ne((i + 1 : U32), gap), U32.is_ne(i, (gap + patterns.WALL_GAP() : U32)))), aim, n, gap, thin, px, py, fx, fy, roomv, _t9, i)

def patterns.wall.if12(_c: Bool, +aim: J.Val, +n: U32, +gap: U32, +thin: U32, +px: F32, +py: F32, +fx: F32, +fy: F32, +roomv: List<&2, U32>, +_t9: List<&2, U32>, +i: U32) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
  match _c:
    case True{}:
      patterns.wall.loop9(_t9, aim, n, gap, thin, px, py, fx, fy, roomv)
    case False{}:
      patterns.wall.k10(aim, n, gap, thin, px, py, fx, fy, roomv, _t9, i)

def patterns.wall.loop9(+_xs: List<&2, U32>, +aim: J.Val, +n: U32, +gap: U32, +thin: U32, +px: F32, +py: F32, +fx: F32, +fy: F32, +roomv: List<&2, U32>) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
  match _xs:
    case Nil{}:
      patterns.wall.k2(aim, n, gap, thin, px, py, fx, fy, roomv)
    case Con{+i, +_t9}:
      patterns.wall.if12(U32.is_eq(i, 0), aim, n, gap, thin, px, py, fx, fy, roomv, _t9, i)

def patterns.wall.k1(+_t: Sigma<&2, &2, F32, _ => F32>, +aim: J.Val, +n: U32, +gap: U32, +thin: U32, +px: F32, +py: F32) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
  (+fx, +fy) = _t
  +roomv = {Nil{} : List<&2, U32>}
  patterns.wall.loop9(cb.range(RS.u_sat_sub(n, 1)), aim, n, gap, thin, px, py, fx, fy, roomv)

def patterns.wall.open(+i: U32, +gap: U32) -> Bool:
  Bool.or(U32.is_lt(i, gap), U32.is_ge(i, (gap + patterns.WALL_GAP() : U32)))

# The first open spot in from the left (or right) wall on row y.

def patterns.edge(+aim: J.Val, +y: F32, +left: Bool, +w: F32) -> Maybe<&2, F32>:
  +end = {RS.i_mul(RS.f_as_i32((w / 2.0 : F32)), 2) : U32}
  patterns.edge.if5(U32.is_lt(end, 2), aim, y, left, w, end)

def patterns.edge.k2() -> Maybe<&2, F32>:
  None{}

def patterns.edge.if4(_c: Bool, +aim: J.Val, +y: F32, +left: Bool, +w: F32, +_t3: List<&2, U32>, +x: F32) -> Maybe<&2, F32>:
  match _c:
    case True{}:
      Some{Bool.pick(F32, left, (x + 0.3 : F32), (x - 0.3 : F32))}
    case False{}:
      patterns.edge.loop3(_t3, aim, y, left, w)

def patterns.edge.loop3(+_xs: List<&2, U32>, +aim: J.Val, +y: F32, +left: Bool, +w: F32) -> Maybe<&2, F32>:
  match _xs:
    case Nil{}:
      patterns.edge.k2()
    case Con{+k0, +_t3}:
      +k = {(k0 + 1 : U32) : U32}
      +d = {(cb.f(k) * 0.5 : F32) : F32}
      +x = {Bool.pick(F32, left, d, (w - d : F32)) : F32}
      patterns.edge.if4(Bool.not(rules.Grid.stops_body(cb.gj(cb.gj(aim, "grid"), "room"), cb.gb(cb.gj(aim, "grid"), "barred"), x, y, patterns.BODY())), aim, y, left, w, _t3, x)

def patterns.edge.k1(+aim: J.Val, +y: F32, +left: Bool, +w: F32, +end: U32) -> Maybe<&2, F32>:
  patterns.edge.loop3(cb.range((end - 1 : U32)), aim, y, left, w)

def patterns.edge.if5(_c: Bool, +aim: J.Val, +y: F32, +left: Bool, +w: F32, +end: U32) -> Maybe<&2, F32>:
  match _c:
    case True{}:
      None{}
    case False{}:
      patterns.edge.k1(aim, y, left, w, end)

# One volley of `emitter`, into `shots`.

def patterns.emit(+emitter: String, +aim: J.Val, +shots: J.Val) -> J.Val:
  patterns.emit.if42(U32.is_ge(J.len(shots), rules.MAX_PROJECTILES()), emitter, aim, shots)

def patterns.emit.k4(+shots: J.Val) -> J.Val:
  J.truncate(shots, rules.MAX_PROJECTILES())

def patterns.emit.loop6(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t6}:
      +path = {patterns.waits((i * patterns.BURST_GAP() : U32)) : J.Val}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, line, patterns.BURST_2(), path, patterns.LIFE())) : J.Val}
      patterns.emit.loop6(_t6, aim, shots, line, fx, fy)

def patterns.emit.loop8(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +toward: F32, +n: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t8}:
      +a = {(toward + patterns.LEAD_ARC() * patterns.frac(i, n) : F32) : F32}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, a, patterns.LEAD_2(), patterns.Path.default(), patterns.LIFE())) : J.Val}
      patterns.emit.loop8(_t8, aim, shots, fx, fy, toward, n)

def patterns.emit.k7(+_t: Sigma<&2, &2, F32, _ => F32>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +ax: F32, +ay: F32) -> J.Val:
  (+pcx, +pcy) = _t
  +ahead_x = {(ax + pcx * patterns.LEAD_AHEAD() : F32) : F32}
  +ahead_y = {(ay + pcy * patterns.LEAD_AHEAD() : F32) : F32}
  +toward = {RS.f_atan2((ahead_y - fy : F32), (ahead_x - fx : F32)) : F32}
  +n = {patterns.Aim.count_of(aim, patterns.LEAD_0(), patterns.LEAD_1()) : U32}
  patterns.emit.loop8(cb.range(n), aim, shots, fx, fy, toward, n)

def patterns.emit.loop9(+_xs: List<&2, F32>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+a, +_t9}:
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, a, patterns.GAP_RING_2(), patterns.Path.default(), patterns.LIFE())) : J.Val}
      patterns.emit.loop9(_t9, aim, shots, fx, fy)

def patterns.emit.loop11(+_xs: List<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +petals: U32, +turn: F32, +lean: F32, +_t10: List<&2, U32>, +a: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.loop10(_t10, aim, shots, fx, fy, petals, turn, lean)
    case Con{+_h11, +_t11}:
      (+off, +speed) = _h11
      +path = {patterns.Path.default() : J.Val}
      +path = {cb.sf(path, "turn", lean) : J.Val}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, (a + off : F32), speed, path, patterns.LIFE())) : J.Val}
      patterns.emit.loop11(_t11, aim, shots, fx, fy, petals, turn, lean, _t10, a)

def patterns.emit.loop10(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +petals: U32, +turn: F32, +lean: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+k, +_t10}:
      +a = {(turn + cb.f(k) * cb.TAU() / cb.f(petals) : F32) : F32}
      patterns.emit.loop11(patterns.flower_offsets(), aim, shots, fx, fy, petals, turn, lean, _t10, a)

def patterns.emit.loop14(+_xs: List<&2, F32>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +start: F32, +_t12: List<&2, U32>, +j: U32, +_t13: List<&2, F32>, +way: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.loop13(_t13, aim, shots, fx, fy, start, _t12, j)
    case Con{+arm, +_t14}:
      +offset = {Bool.pick(F32, (way < 0.0 : F32), 0.13, 0.0) : F32}
      +a = {(start + arm + offset + way * cb.f(j) * patterns.SPIRAL_STEP() : F32) : F32}
      +path = {patterns.waits((j * patterns.SPIRAL_GAP() : U32)) : J.Val}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, a, patterns.TWIN_SPIRAL_2(), path, patterns.LIFE())) : J.Val}
      patterns.emit.loop14(_t14, aim, shots, fx, fy, start, _t12, j, _t13, way)

def patterns.emit.loop13(+_xs: List<&2, F32>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +start: F32, +_t12: List<&2, U32>, +j: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.loop12(_t12, aim, shots, fx, fy, start)
    case Con{+way, +_t13}:
      patterns.emit.loop14([0.0, cb.PI()], aim, shots, fx, fy, start, _t12, j, _t13, way)

def patterns.emit.loop12(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +start: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+j, +_t12}:
      patterns.emit.loop13([1.0, F32.neg(1.0)], aim, shots, fx, fy, start, _t12, j)

def patterns.emit.loop15(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t15}:
      +side = {Bool.pick(F32, U32.is_eq(U32.mod(i, 2), 0), 1.0, F32.neg(1.0)) : F32}
      +path = {patterns.waits((i * patterns.WEAVE_GAP() : U32)) : J.Val}
      +path = {cb.sf(path, "wave", (patterns.WEAVE_REACH() * side : F32)) : J.Val}
      +path = {cb.sf(path, "wave_rate", patterns.WEAVE_RATE()) : J.Val}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, line, patterns.WEAVE_2(), path, patterns.LIFE())) : J.Val}
      patterns.emit.loop15(_t15, aim, shots, line, fx, fy)

def patterns.emit.loop16(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32, +n: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t16}:
      +off = {(patterns.CURVE_ARC() * patterns.frac(i, n) : F32) : F32}
      +path = {patterns.Path.default() : J.Val}
      +path = {cb.sf(path, "turn", (RS.f_neg(RS.f_signum(off)) * patterns.CURVE_TURN() : F32)) : J.Val}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, (line + off : F32), patterns.CURVE_2(), path, patterns.LIFE())) : J.Val}
      patterns.emit.loop16(_t16, aim, shots, line, fx, fy, n)

def patterns.emit.loop17(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +n: U32, +turn: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t17}:
      +path = {patterns.Path.default() : J.Val}
      +path = {cb.sf(path, "accel", patterns.SURGE_GAIN()) : J.Val}
      +path = {cb.sf(path, "top", patterns.SURGE_TOP()) : J.Val}
      +a = {(turn + cb.f(i) * cb.TAU() / cb.f(n) : F32) : F32}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, a, patterns.SURGE_2(), path, patterns.LIFE())) : J.Val}
      patterns.emit.loop17(_t17, aim, shots, fx, fy, n, turn)

def patterns.emit.loop18(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +n: U32, +turn: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t18}:
      +path = {patterns.Path.default() : J.Val}
      +path = {cb.sf(path, "accel", RS.f_neg(patterns.REAIM_BRAKE())) : J.Val}
      +path = {cb.sf(path, "top", 0.0) : J.Val}
      +path = {cb.su(path, "fuse", patterns.REAIM_FUSE()) : J.Val}
      +path = {cb.sj(path, "then", patterns.then_aim(patterns.REAIM_SPEED())) : J.Val}
      +a = {(turn + cb.f(i) * cb.TAU() / cb.f(n) : F32) : F32}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, a, patterns.REAIM_2(), path, patterns.LIFE())) : J.Val}
      patterns.emit.loop18(_t18, aim, shots, fx, fy, n, turn)

def patterns.emit.loop19(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32, +n: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t19}:
      +a = {(line + patterns.centred(i, n) * 0.3 : F32) : F32}
      +path = {patterns.Path.default() : J.Val}
      +path = {cb.su(path, "fuse", patterns.SPLIT_FUSE()) : J.Val}
      +path = {cb.sj(path, "then", patterns.then_burst(patterns.SPLIT_RING(), patterns.SPLIT_SPEED())) : J.Val}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, a, patterns.SPLIT_2(), path, patterns.LIFE())) : J.Val}
      patterns.emit.loop19(_t19, aim, shots, line, fx, fy, n)

def patterns.emit.loop20(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32, +n: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t20}:
      +a = {(line + patterns.BOUNCE_ARC() * patterns.frac(i, n) : F32) : F32}
      +shot = {patterns.Aim.shot(aim, fx, fy, a, patterns.BOUNCE_2(), patterns.Path.default(), (6 * rules.HZ() : U32)) : J.Val}
      +shot = {cb.sj(shot, "traits", cb.su(cb.gj(shot, "traits"), "bounce", 1)) : J.Val}
      +shots = {J.push(shots, shot) : J.Val}
      patterns.emit.loop20(_t20, aim, shots, line, fx, fy, n)

def patterns.emit.loop21(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +side: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+k, +_t21}:
      +a = {(line + (cb.f(k) - cb.f(side) / 2.0 : F32) * patterns.BEAM_FAN() : F32) : F32}
      +shots = {J.push(shots, patterns.beam(aim, a, 0.0, patterns.BEAM_WARN(), patterns.BEAM_BURN())) : J.Val}
      patterns.emit.loop21(_t21, aim, shots, line, side)

def patterns.emit.if22(_c: Bool, +aim: J.Val, +shots: J.Val, +line: F32, +way: F32, +per: F32) -> J.Val:
  match _c:
    case True{}:
      +shots = {J.push(shots, patterns.beam(aim, (line + patterns.SWEEP_ARC() / 2.0 * way : F32), RS.f_neg(per), patterns.SWEEP_WARN(), patterns.SWEEP_BURN())) : J.Val}
      patterns.emit.k4(shots)
    case False{}:
      patterns.emit.k4(shots)

def patterns.emit.loop23(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32, +n: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t23}:
      +a = {(line + patterns.centred(i, n) * patterns.MINE_SPREAD() : F32) : F32}
      +path = {patterns.Path.default() : J.Val}
      +path = {cb.sf(path, "accel", RS.f_neg(patterns.MINE_BRAKE())) : J.Val}
      +path = {cb.sf(path, "top", 0.0) : J.Val}
      +path = {cb.su(path, "fuse", patterns.MINE_FUSE()) : J.Val}
      +path = {cb.sj(path, "then", patterns.then_burst(patterns.MINE_RING(), patterns.MINE_SPEED())) : J.Val}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, a, patterns.MINES_2(), path, patterns.LIFE())) : J.Val}
      patterns.emit.loop23(_t23, aim, shots, line, fx, fy, n)

def patterns.emit.loop25(+_xs: List<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: J.Val, +shots: J.Val, +line: F32, +n: U32, +first: U32, +second: U32, +thin: U32, +_t24: List<&2, U32>, +wait: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.loop24(_t24, aim, shots, line, n, first, second, thin)
    case Con{+_h25, +_t25}:
      (+wx, +wy) = _h25
      +shots = {J.push(shots, patterns.Aim.shot(aim, wx, wy, line, patterns.GAP_WALL_2(), patterns.waits(wait), patterns.LIFE())) : J.Val}
      patterns.emit.loop25(_t25, aim, shots, line, n, first, second, thin, _t24, wait)

def patterns.emit.loop24(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +n: U32, +first: U32, +second: U32, +thin: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+pass, +_t24}:
      +gap = {Bool.pick(U32, U32.is_eq(pass, 0), first, second) : U32}
      +wait = {Bool.pick(U32, U32.is_eq(pass, 0), 0, patterns.WALL_FOLLOWS()) : U32}
      +thn = {Bool.pick(U32, U32.is_eq(pass, 0), 0, thin) : U32}
      patterns.emit.loop25(patterns.wall(aim, n, gap, thn), aim, shots, line, n, first, second, thin, _t24, wait)

def patterns.emit.m29(+_s: Maybe<&2, F32>, +aim: J.Val, +shots: J.Val, +ay: F32, +w: F32, +h: F32, +_t26: List<&2, U32>, +left: Bool, +_t27: List<&2, F32>, +y: F32) -> J.Val:
  match _s:
    case Some{+x}:
      +mark = {patterns.Path.default() : J.Val}
      +mark = {cb.su(mark, "wait", patterns.CROSS_MARK()) : J.Val}
      +mark = {cb.sb(mark, "mark", True{}) : J.Val}
      +a = {Bool.pick(F32, left, 0.0, cb.PI()) : F32}
      +shots = {J.push(shots, patterns.Aim.shot(aim, x, y, a, patterns.CROSS_SPEED(), mark, patterns.LIFE())) : J.Val}
      patterns.emit.loop27(_t27, aim, shots, ay, w, h, _t26, left)
    case None{}:
      +y = {y : F32}
      patterns.emit.loop27(_t27, aim, shots, ay, w, h, _t26, left)

def patterns.emit.k28(+aim: J.Val, +shots: J.Val, +ay: F32, +w: F32, +h: F32, +_t26: List<&2, U32>, +left: Bool, +_t27: List<&2, F32>, +y: F32) -> J.Val:
  patterns.emit.m29(patterns.edge(aim, y, left, w), aim, shots, ay, w, h, _t26, left, _t27, y)

def patterns.emit.if30(_c: Bool, +aim: J.Val, +shots: J.Val, +ay: F32, +w: F32, +h: F32, +_t26: List<&2, U32>, +left: Bool, +_t27: List<&2, F32>, +y: F32) -> J.Val:
  match _c:
    case True{}:
      patterns.emit.loop27(_t27, aim, shots, ay, w, h, _t26, left)
    case False{}:
      patterns.emit.k28(aim, shots, ay, w, h, _t26, left, _t27, y)

def patterns.emit.loop27(+_xs: List<&2, F32>, +aim: J.Val, +shots: J.Val, +ay: F32, +w: F32, +h: F32, +_t26: List<&2, U32>, +left: Bool) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.loop26(_t26, aim, shots, ay, w, h)
    case Con{+dy, +_t27}:
      +y = {(ay + dy : F32) : F32}
      patterns.emit.if30(Bool.not(Bool.and((0.5 <= y : F32), (y < (h - 0.5 : F32) : F32))), aim, shots, ay, w, h, _t26, left, _t27, y)

def patterns.emit.loop26(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +ay: F32, +w: F32, +h: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+side, +_t26}:
      +left = {U32.is_eq(side, 0) : Bool}
      +rows = {Bool.pick(List<&2, F32>, left, patterns.CROSS_LEFT(), patterns.CROSS_RIGHT()) : List<&2, F32>}
      patterns.emit.loop27(rows, aim, shots, ay, w, h, _t26, left)

def patterns.emit.m32(+_s: Maybe<&2, F32>, +aim: J.Val, +shots: J.Val, +w: F32, +h: F32, +n: U32, +_t31: List<&2, U32>, +i: U32, +x: F32) -> J.Val:
  match _s:
    case Some{+y}:
      +speed = {(patterns.RAIN_2() + patterns.Aim.roll(aim, (40 + i : U32)) * patterns.RAIN_SPREAD() : F32) : F32}
      +path = {patterns.Path.default() : J.Val}
      +path = {cb.su(path, "wait", (patterns.RAIN_MARK() + U32.mod(i, 3) * 4 : U32)) : J.Val}
      +path = {cb.sb(path, "mark", True{}) : J.Val}
      +ttl = {(RS.f_as_u32((h / speed * cb.f(rules.HZ()) : F32)) + rules.HZ() : U32) : U32}
      +shots = {J.push(shots, patterns.Aim.shot(aim, x, (y + 0.3 : F32), (cb.PI() / 2.0 : F32), speed, path, ttl)) : J.Val}
      patterns.emit.loop31(_t31, aim, shots, w, h, n)
    case None{}:
      +x = {x : F32}
      patterns.emit.loop31(_t31, aim, shots, w, h, n)

def patterns.emit.loop31(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +w: F32, +h: F32, +n: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t31}:
      +x = {(((cb.f(i) + 0.2 : F32) + patterns.Aim.roll(aim, (10 + i : U32)) * 0.6 : F32) / cb.f(n) * w : F32) : F32}
      patterns.emit.m32(patterns.rain_y(aim, x), aim, shots, w, h, n, _t31, i, x)

def patterns.emit.loop33(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32, +n: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t33}:
      +a = {(line + 1.8 * patterns.frac(i, n) : F32) : F32}
      +path = {patterns.Path.default() : J.Val}
      +path = {cb.sf(path, "seek", patterns.SEEKER_TURN()) : J.Val}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, a, patterns.SEEKER_2(), path, patterns.SEEKER_LIFE())) : J.Val}
      patterns.emit.loop33(_t33, aim, shots, line, fx, fy, n)

def patterns.emit.loop34(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t34}:
      +path = {patterns.waits((i * patterns.DART_GAP() : U32)) : J.Val}
      +path = {cb.sskip(path, "form", "dart", "plain") : J.Val}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, line, patterns.DARTS_2(), path, patterns.LIFE())) : J.Val}
      patterns.emit.loop34(_t34, aim, shots, line, fx, fy)

def patterns.emit.loop35(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32, +n: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t35}:
      +a = {(line + patterns.centred(i, n) * patterns.ORB_SPREAD() : F32) : F32}
      +path = {patterns.Path.default() : J.Val}
      +path = {cb.sskip(path, "form", "orb", "plain") : J.Val}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, a, patterns.ORBS_2(), path, patterns.ORB_LIFE())) : J.Val}
      patterns.emit.loop35(_t35, aim, shots, line, fx, fy, n)

def patterns.emit.k39(+_t: Sigma<&2, &2, F32, _ => F32>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +ax: F32, +ay: F32, +n: U32, +turn: F32, +_t36: List<&2, U32>) -> J.Val:
  (+lx, +ly) = _t
  +dx = {(lx - fx : F32) : F32}
  +dy = {(ly - fy : F32) : F32}
  +speed = {(cb.hyp(dx, dy) / (cb.f(patterns.LOB_FLIGHT()) * rules.DT() : F32) : F32) : F32}
  +path = {patterns.Path.default() : J.Val}
  +path = {cb.sskip(path, "form", "lob", "plain") : J.Val}
  +path = {cb.su(path, "fuse", patterns.LOB_FLIGHT()) : J.Val}
  +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, RS.f_atan2(dy, dx), speed, path, (patterns.LOB_FLIGHT() + 2 : U32))) : J.Val}
  patterns.emit.loop36(_t36, aim, shots, fx, fy, ax, ay, n, turn)

def patterns.emit.m38(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +ax: F32, +ay: F32, +n: U32, +turn: F32, +_t36: List<&2, U32>, +sx: F32) -> J.Val:
  match _s:
    case Some{+land}:
      patterns.emit.k39(land, aim, shots, fx, fy, ax, ay, n, turn, _t36)
    case None{}:
      +sx = {sx : F32}
      patterns.emit.loop36(_t36, aim, shots, fx, fy, ax, ay, n, turn)

def patterns.emit.k37(+aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +ax: F32, +ay: F32, +n: U32, +turn: F32, +_t36: List<&2, U32>, +sx: F32, +sy: F32) -> J.Val:
  patterns.emit.m38(patterns.landing(aim, fx, fy, sx, sy), aim, shots, fx, fy, ax, ay, n, turn, _t36, sx)

def patterns.emit.if40(_c: Bool, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +ax: F32, +ay: F32, +n: U32, +turn: F32, +_t36: List<&2, U32>, +i: U32, +sx: F32, +sy: F32) -> J.Val:
  match _c:
    case True{}:
      +a = {(turn + cb.f(i) * cb.TAU() / cb.f((n - 1 : U32)) : F32) : F32}
      +sx = {(ax + F32.cos(a) * patterns.LOB_SCATTER() : F32) : F32}
      +sy = {(ay + F32.sin(a) * patterns.LOB_SCATTER() : F32) : F32}
      patterns.emit.k37(aim, shots, fx, fy, ax, ay, n, turn, _t36, sx, sy)
    case False{}:
      patterns.emit.k37(aim, shots, fx, fy, ax, ay, n, turn, _t36, sx, sy)

def patterns.emit.loop36(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +fx: F32, +fy: F32, +ax: F32, +ay: F32, +n: U32, +turn: F32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t36}:
      +sx = {ax : F32}
      +sy = {ay : F32}
      patterns.emit.if40(U32.is_ne(i, 0), aim, shots, fx, fy, ax, ay, n, turn, _t36, i, sx, sy)

def patterns.emit.loop41(+_xs: List<&2, U32>, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32, +n: U32) -> J.Val:
  match _xs:
    case Nil{}:
      patterns.emit.k4(shots)
    case Con{+i, +_t41}:
      +a = {(line + patterns.DRIFT_ARC() * patterns.frac(i, n) : F32) : F32}
      +path = {patterns.Path.default() : J.Val}
      +path = {cb.sf(path, "accel", RS.f_neg(patterns.DRIFT_BRAKE())) : J.Val}
      +path = {cb.sf(path, "top", patterns.DRIFT_TOP()) : J.Val}
      +shots = {J.push(shots, patterns.Aim.shot(aim, fx, fy, a, patterns.DRIFT_2(), path, patterns.DRIFT_LIFE())) : J.Val}
      patterns.emit.loop41(_t41, aim, shots, line, fx, fy, n)

def patterns.emit.m5(+_s: PatternsEmitter, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32, +ax: F32, +ay: F32) -> J.Val:
  match _s:
    case EM.Burst{}:
      patterns.emit.loop6(cb.range(patterns.Aim.count_of(aim, patterns.BURST_0(), patterns.BURST_1())), aim, shots, line, fx, fy)
    case EM.Lead{}:
      patterns.emit.k7(cb.gp(aim, "pace"), aim, shots, fx, fy, ax, ay)
    case EM.GapRing{}:
      patterns.emit.loop9(patterns.gap_ring(aim), aim, shots, fx, fy)
    case EM.Flower{}:
      +petals = {patterns.Aim.count_of(aim, patterns.FLOWER_0(), patterns.FLOWER_1()) : U32}
      +turn = {(cb.f(cb.gu(aim, "count")) * patterns.FLOWER_TURN() + patterns.Aim.start(aim) : F32) : F32}
      +lean = {Bool.pick(F32, U32.is_eq(U32.mod(cb.gu(aim, "count"), 2), 0), patterns.FLOWER_LEAN(), RS.f_neg(patterns.FLOWER_LEAN())) : F32}
      patterns.emit.loop10(cb.range(petals), aim, shots, fx, fy, petals, turn, lean)
    case EM.TwinSpiral{}:
      +start = {(patterns.Aim.start(aim) + cb.f(cb.gu(aim, "count")) * patterns.SPIRAL_STEP() : F32) : F32}
      patterns.emit.loop12(cb.range(patterns.Aim.count_of(aim, patterns.TWIN_SPIRAL_0(), patterns.TWIN_SPIRAL_1())), aim, shots, fx, fy, start)
    case EM.Weave{}:
      patterns.emit.loop15(cb.range(patterns.Aim.count_of(aim, patterns.WEAVE_0(), patterns.WEAVE_1())), aim, shots, line, fx, fy)
    case EM.Curve{}:
      +n = {patterns.Aim.count_of(aim, patterns.CURVE_0(), patterns.CURVE_1()) : U32}
      patterns.emit.loop16(cb.range(n), aim, shots, line, fx, fy, n)
    case EM.Surge{}:
      +n = {patterns.Aim.count_of(aim, patterns.SURGE_0(), patterns.SURGE_1()) : U32}
      +turn = {(patterns.Aim.roll(aim, 3) * cb.TAU() : F32) : F32}
      patterns.emit.loop17(cb.range(n), aim, shots, fx, fy, n, turn)
    case EM.Reaim{}:
      +n = {patterns.Aim.count_of(aim, patterns.REAIM_0(), patterns.REAIM_1()) : U32}
      +turn = {(patterns.Aim.roll(aim, 4) * cb.TAU() : F32) : F32}
      patterns.emit.loop18(cb.range(n), aim, shots, fx, fy, n, turn)
    case EM.Split{}:
      +n = {patterns.Aim.count_of(aim, patterns.SPLIT_0(), patterns.SPLIT_1()) : U32}
      patterns.emit.loop19(cb.range(n), aim, shots, line, fx, fy, n)
    case EM.Bounce{}:
      +n = {patterns.Aim.count_of(aim, patterns.BOUNCE_0(), patterns.BOUNCE_1()) : U32}
      patterns.emit.loop20(cb.range(n), aim, shots, line, fx, fy, n)
    case EM.Laser{}:
      +side = {(2 * U32.div(cb.gu(aim, "step"), 2) : U32) : U32}
      patterns.emit.loop21(cb.range((side + 1 : U32)), aim, shots, line, side)
    case EM.Sweep{}:
      +way = {Bool.pick(F32, U32.is_eq(U32.mod(cb.gu(aim, "count"), 2), 0), 1.0, F32.neg(1.0)) : F32}
      +per = {(patterns.SWEEP_ARC() / cb.f((patterns.SWEEP_BURN() - 1 : U32)) * way : F32) : F32}
      +shots = {J.push(shots, patterns.beam(aim, (line - patterns.SWEEP_ARC() / 2.0 * way : F32), per, patterns.SWEEP_WARN(), patterns.SWEEP_BURN())) : J.Val}
      patterns.emit.if22(U32.is_ge(cb.gu(aim, "step"), 2), aim, shots, line, way, per)
    case EM.Mines{}:
      +n = {patterns.Aim.count_of(aim, patterns.MINES_0(), patterns.MINES_1()) : U32}
      patterns.emit.loop23(cb.range(n), aim, shots, line, fx, fy, n)
    case EM.GapWall{}:
      +n = {patterns.Aim.count_of(aim, patterns.GAP_WALL_0(), patterns.GAP_WALL_1()) : U32}
      +roomn = {(n - patterns.WALL_GAP() - 1 : U32) : U32}
      +first = {(((cb.gu(aim, "count") * 3 : U32) + RS.f_as_usize((patterns.Aim.roll(aim, 5) * 5.0 : F32)) : U32) % roomn + 1 : U32) : U32}
      +second = {(((first + 4 : U32) % roomn : U32) + 1 : U32) : U32}
      +thin = {Bool.pick(U32, cb.gb(aim, "shield_line"), patterns.thinned(n), 0) : U32}
      patterns.emit.loop24(cb.range(2), aim, shots, line, n, first, second, thin)
    case EM.Crossfire{}:
      +w = {layout.Room.width(cb.gj(cb.gj(aim, "grid"), "room")) : F32}
      +h = {layout.Room.height(cb.gj(cb.gj(aim, "grid"), "room")) : F32}
      patterns.emit.loop26(cb.range(2), aim, shots, ay, w, h)
    case EM.Rain{}:
      +w = {layout.Room.width(cb.gj(cb.gj(aim, "grid"), "room")) : F32}
      +h = {layout.Room.height(cb.gj(cb.gj(aim, "grid"), "room")) : F32}
      +n = {patterns.Aim.count_of(aim, patterns.RAIN_0(), patterns.RAIN_1()) : U32}
      patterns.emit.loop31(cb.range(n), aim, shots, w, h, n)
    case EM.Seeker{}:
      +n = {patterns.Aim.count_of(aim, patterns.SEEKER_0(), patterns.SEEKER_1()) : U32}
      patterns.emit.loop33(cb.range(n), aim, shots, line, fx, fy, n)
    case EM.Darts{}:
      patterns.emit.loop34(cb.range(patterns.Aim.count_of(aim, patterns.DARTS_0(), patterns.DARTS_1())), aim, shots, line, fx, fy)
    case EM.Orbs{}:
      +n = {patterns.Aim.count_of(aim, patterns.ORBS_0(), patterns.ORBS_1()) : U32}
      patterns.emit.loop35(cb.range(n), aim, shots, line, fx, fy, n)
    case EM.Lob{}:
      +n = {patterns.Aim.count_of(aim, patterns.LOBS_0(), patterns.LOBS_1()) : U32}
      +turn = {(patterns.Aim.roll(aim, 7) * cb.TAU() : F32) : F32}
      patterns.emit.loop36(cb.range(n), aim, shots, fx, fy, ax, ay, n, turn)
    case EM.Drift{}:
      +n = {patterns.Aim.count_of(aim, patterns.DRIFT_0(), patterns.DRIFT_1()) : U32}
      patterns.emit.loop41(cb.range(n), aim, shots, line, fx, fy, n)

def patterns.emit.k3(+_t: Sigma<&2, &2, F32, _ => F32>, +emitter: String, +aim: J.Val, +shots: J.Val, +line: F32, +fx: F32, +fy: F32) -> J.Val:
  (+ax, +ay) = _t
  patterns.emit.m5(patterns.Emitter.of(emitter), aim, shots, line, fx, fy, ax, ay)

def patterns.emit.k2(+_t: Sigma<&2, &2, F32, _ => F32>, +emitter: String, +aim: J.Val, +shots: J.Val, +line: F32) -> J.Val:
  (+fx, +fy) = _t
  patterns.emit.k3(cb.gp(aim, "at"), emitter, aim, shots, line, fx, fy)

def patterns.emit.k1(+emitter: String, +aim: J.Val, +shots: J.Val) -> J.Val:
  +line = {patterns.Aim.line(aim) : F32}
  patterns.emit.k2(cb.gp(aim, "from"), emitter, aim, shots, line)

def patterns.emit.if42(_c: Bool, +emitter: String, +aim: J.Val, +shots: J.Val) -> J.Val:
  match _c:
    case True{}:
      shots
    case False{}:
      patterns.emit.k1(emitter, aim, shots)

def patterns.flower_offsets() -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
  [(F32.neg(0.09), patterns.FLOWER_2()), (0.0, (patterns.FLOWER_2() + 1.2 : F32)), (0.09, patterns.FLOWER_2())]

# Then::Aim(speed) and Then::Burst(n, speed) as serde writes them.

def patterns.then_aim(+speed: F32) -> J.Val:
  +o = {J.obj() : J.Val}
  +o = {J.set(o, "aim", J.of_f32(speed)) : J.Val}
  o

def patterns.then_burst(+n: U32, +speed: F32) -> J.Val:
  +o = {J.obj() : J.Val}
  +o = {J.set(o, "burst", J.JA{[J.of_u32(n), J.of_f32(speed)]}) : J.Val}
  o

# The first y down from the top of the room, on the half-unit grid, where
# a drop's body is not stopped.

def patterns.rain_y(+aim: J.Val, +x: F32) -> Maybe<&2, F32>:
  patterns.rain_y.loop2(cb.range(11), aim, x)

def patterns.rain_y.k1() -> Maybe<&2, F32>:
  None{}

def patterns.rain_y.if3(_c: Bool, +aim: J.Val, +x: F32, +_t2: List<&2, U32>, +y: F32) -> Maybe<&2, F32>:
  match _c:
    case True{}:
      Some{y}
    case False{}:
      patterns.rain_y.loop2(_t2, aim, x)

def patterns.rain_y.loop2(+_xs: List<&2, U32>, +aim: J.Val, +x: F32) -> Maybe<&2, F32>:
  match _xs:
    case Nil{}:
      patterns.rain_y.k1()
    case Con{+k0, +_t2}:
      +y = {(cb.f((k0 + 1 : U32)) * 0.5 : F32) : F32}
      patterns.rain_y.if3(Bool.not(rules.Grid.stops_body(cb.gj(cb.gj(aim, "grid"), "room"), cb.gb(cb.gj(aim, "grid"), "barred"), x, y, patterns.BODY())), aim, x, _t2, y)

# Equal to Path::default()?

def patterns.Path.is_default(+path: J.Val) -> Bool:
  Bool.and(Bool.and(Bool.and(U32.is_eq(cb.gu(path, "age"), 0), U32.is_eq(cb.gu(path, "wait"), 0)), Bool.and(Bool.not(cb.gb(path, "held")), Bool.not(cb.gb(path, "mark")))), Bool.and(Bool.and(Bool.and(F32.is_eq(cb.gf(path, "accel"), 0.0), F32.is_eq(cb.gf(path, "top"), 0.0)), Bool.and(F32.is_eq(cb.gf(path, "turn"), 0.0), F32.is_eq(cb.gf(path, "seek"), 0.0))), Bool.and(Bool.and(F32.is_eq(cb.gf(path, "wave"), 0.0), F32.is_eq(cb.gf(path, "wave_rate"), 0.0)), Bool.and(Bool.and(U32.is_eq(cb.gu(path, "fuse"), 0), J.eq(cb.gj(path, "then"), J.JS{"nothing"})), Bool.and(J.is_null(cb.gj(path, "beam")), String.eq(cb.gs(path, "form"), "plain"))))))

# The knight (id, x, y) nearest (x, y): the first of equals.

def patterns.nearest(+knights: J.Val, +x: F32, +y: F32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  +best = {None{} : Maybe<&2, Sigma<&2, &2, F32, _ => F32>>}
  +bd = {0.0 : F32}
  patterns.nearest.loop2(J.items(knights), x, y, best, bd)

def patterns.nearest.k1(+best: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  best

def patterns.nearest.if4(_c: Bool, +x: F32, +y: F32, +best: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +bd: F32, +_t2: List<&2, J.Val>, +kx: F32, +ky: F32, +d: F32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  match _c:
    case True{}:
      +best = {Some{(kx, ky)} : Maybe<&2, Sigma<&2, &2, F32, _ => F32>>}
      +bd = {d : F32}
      patterns.nearest.loop2(_t2, x, y, best, bd)
    case False{}:
      patterns.nearest.loop2(_t2, x, y, best, bd)

def patterns.nearest.m3(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +x: F32, +y: F32, +best: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +bd: F32, +_t2: List<&2, J.Val>, +kx: F32, +ky: F32, +d: F32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  match _s:
    case None{}:
      +best = {Some{(kx, ky)} : Maybe<&2, Sigma<&2, &2, F32, _ => F32>>}
      +bd = {d : F32}
      patterns.nearest.loop2(_t2, x, y, best, bd)
    case Some{+b}:
      patterns.nearest.if4((d < bd : F32), x, y, best, bd, _t2, kx, ky, d)

def patterns.nearest.loop2(+_xs: List<&2, J.Val>, +x: F32, +y: F32, +best: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +bd: F32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  match _xs:
    case Nil{}:
      patterns.nearest.k1(best)
    case Con{+k, +_t2}:
      +kx = {J.f32(J.nth(k, 1)) : F32}
      +ky = {J.f32(J.nth(k, 2)) : F32}
      +d = {cb.hyp((kx - x : F32), (ky - y : F32)) : F32}
      patterns.nearest.m3(best, x, y, best, bd, _t2, kx, ky, d)

# A pattern shot's step before it moves: its wait, its speed, its turns, its
# weave and its fuse. Bursts go into `pops`. Answers (bullet, pops, hold): hold
# is Steer::Hold, else the shot flies. A shot with an empty path is left as it was.

def patterns.steer(+bullet: J.Val, +knights: J.Val, +pops: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +path = {cb.gj(cb.gj(bullet, "traits"), "path") : J.Val}
  patterns.steer.if26(U32.is_gt(cb.gu(path, "wait"), 0), bullet, knights, pops, path)

def patterns.steer.k7(+bullet: J.Val, +pops: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (bullet, pops, False{})

def patterns.steer.k10(+bullet: J.Val, +pops: J.Val, +path: J.Val, +fast: F32, +to: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +bullet = {cb.sf(bullet, "vx", (F32.cos(to) * fast : F32)) : J.Val}
  +bullet = {cb.sf(bullet, "vy", (F32.sin(to) * fast : F32)) : J.Val}
  +path = {cb.sf(path, "accel", 0.0) : J.Val}
  +path = {cb.sf(path, "top", fast) : J.Val}
  +bullet = {cb.sj(bullet, "traits", cb.sj(cb.gj(bullet, "traits"), "path", path)) : J.Val}
  patterns.steer.k7(bullet, pops)

def patterns.steer.k12(+_t: Sigma<&2, &2, F32, _ => F32>, +bullet: J.Val, +pops: J.Val, +path: J.Val, +fast: F32, +to: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+kx, +ky) = _t
  +to = {RS.f_atan2((ky - cb.gf(bullet, "y") : F32), (kx - cb.gf(bullet, "x") : F32)) : F32}
  patterns.steer.k10(bullet, pops, path, fast, to)

def patterns.steer.m11(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +bullet: J.Val, +pops: J.Val, +path: J.Val, +fast: F32, +to: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _s:
    case Some{+kn}:
      patterns.steer.k12(kn, bullet, pops, path, fast, to)
    case None{}:
      +to = {to : F32}
      patterns.steer.k10(bullet, pops, path, fast, to)

def patterns.steer.k9(+bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +heading: F32, +then: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +fast = {J.f32(J.get(then, "aim")) : F32}
  +to = {heading : F32}
  patterns.steer.m11(patterns.nearest(knights, cb.gf(bullet, "x"), cb.gf(bullet, "y")), bullet, pops, path, fast, to)

def patterns.steer.k15(+bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +heading: F32, +then: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +bullet = {cb.su(bullet, "ttl", 0) : J.Val}
  (bullet, pops, True{})

def patterns.steer.loop16(+_xs: List<&2, U32>, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +heading: F32, +then: J.Val, +n: U32, +fast: F32, +turn: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _xs:
    case Nil{}:
      patterns.steer.k15(bullet, knights, pops, path, heading, then)
    case Con{+i, +_t16}:
      +a = {(turn + cb.f(i) * cb.TAU() / cb.f(n) : F32) : F32}
      +tr = {patterns.ShotTraits.default() : J.Val}
      +tr = {cb.su(tr, "owner", cb.gu(cb.gj(bullet, "traits"), "owner")) : J.Val}
      +tr = {cb.sb0(tr, "borrowed", cb.gb(cb.gj(bullet, "traits"), "borrowed")) : J.Val}
      +pop = {patterns.Projectile.fresh(cb.gf(bullet, "x"), cb.gf(bullet, "y"), (F32.cos(a) * fast : F32), (F32.sin(a) * fast : F32), cb.gb(bullet, "hostile"), cb.gs(bullet, "kind"), cb.gu(bullet, "damage"), (5 * rules.HZ() : U32), tr) : J.Val}
      +pop = {cb.sj(pop, "look", bosses.Art.look_of(cb.gj(bullet, "look"))) : J.Val}
      +pops = {J.push(pops, pop) : J.Val}
      patterns.steer.loop16(_t16, bullet, knights, pops, path, heading, then, n, fast, turn)

def patterns.steer.k14(+bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +heading: F32, +then: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +n = {J.u32(J.nth(J.get(then, "burst"), 0)) : U32}
  +fast = {J.f32(J.nth(J.get(then, "burst"), 1)) : F32}
  +turn = {(cb.f(W.rem_u32(rules.mix(W.xor(W.xor(W.of_u32(cb.gu(path, "age")), W.shl(W.of_u32(F32.bits(cb.gf(bullet, "x"))), 20)), W.of_u32(F32.bits(cb.gf(bullet, "y"))))), 628)) / 100.0 : F32) : F32}
  patterns.steer.loop16(cb.range(n), bullet, knights, pops, path, heading, then, n, fast, turn)

def patterns.steer.if17(_c: Bool, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +heading: F32, +then: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      (bullet, pops, False{})
    case False{}:
      patterns.steer.k14(bullet, knights, pops, path, heading, then)

def patterns.steer.if13(_c: Bool, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +heading: F32, +then: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      patterns.steer.if17(J.is_null(J.get(then, "burst")), bullet, knights, pops, path, heading, then)
    case False{}:
      patterns.steer.k9(bullet, knights, pops, path, heading, then)

def patterns.steer.if8(_c: Bool, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +heading: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +then = {cb.gj(path, "then") : J.Val}
      patterns.steer.if13(J.is_null(J.get(then, "aim")), bullet, knights, pops, path, heading, then)
    case False{}:
      patterns.steer.k7(bullet, pops)

def patterns.steer.k6(+bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +heading: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +bullet = {cb.sj(bullet, "traits", cb.sj(cb.gj(bullet, "traits"), "path", path)) : J.Val}
  patterns.steer.if8(Bool.and(U32.is_gt(cb.gu(path, "fuse"), 0), U32.is_eq(cb.gu(path, "age"), cb.gu(path, "fuse"))), bullet, knights, pops, path, heading)

def patterns.steer.if18(_c: Bool, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +heading: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +t = {cb.f(cb.gu(path, "age")) : F32}
      +side = {(cb.gf(path, "wave") * ((F32.sin((cb.gf(path, "wave_rate") * t : F32)) - F32.sin((cb.gf(path, "wave_rate") * (t - 1.0 : F32) : F32)) : F32)) : F32) : F32}
      +bullet = {cb.sf(bullet, "x", (cb.gf(bullet, "x") + F32.neg(F32.sin(heading)) * side : F32)) : J.Val}
      +bullet = {cb.sf(bullet, "y", (cb.gf(bullet, "y") + F32.cos(heading) * side : F32)) : J.Val}
      patterns.steer.k6(bullet, knights, pops, path, heading)
    case False{}:
      patterns.steer.k6(bullet, knights, pops, path, heading)

def patterns.steer.k5(+bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +heading: F32, +nxt: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  patterns.steer.if18(Bool.and(Bool.not(F32.is_eq(cb.gf(path, "wave"), 0.0)), (nxt > 0.0 : F32)), bullet, knights, pops, path, heading)

def patterns.steer.if19(_c: Bool, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +heading: F32, +nxt: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +bullet = {cb.sf(bullet, "vx", (F32.cos(heading) * nxt : F32)) : J.Val}
      +bullet = {cb.sf(bullet, "vy", (F32.sin(heading) * nxt : F32)) : J.Val}
      patterns.steer.k5(bullet, knights, pops, path, heading, nxt)
    case False{}:
      patterns.steer.k5(bullet, knights, pops, path, heading, nxt)

def patterns.steer.k4(+bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +speed: F32, +heading: F32, +nxt: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  patterns.steer.if19(Bool.or((speed > 0.0 : F32), (nxt > 0.0 : F32)), bullet, knights, pops, path, heading, nxt)

def patterns.steer.k22(+_t: Sigma<&2, &2, F32, _ => F32>, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +speed: F32, +heading: F32, +nxt: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+kx, +ky) = _t
  +want = {RS.f_atan2((ky - cb.gf(bullet, "y") : F32), (kx - cb.gf(bullet, "x") : F32)) : F32}
  +off = {RS.f_atan2(F32.sin((want - heading : F32)), F32.cos((want - heading : F32))) : F32}
  +most = {(cb.gf(path, "seek") * rules.DT() : F32) : F32}
  +heading = {(heading + RS.f_clamp(off, RS.f_neg(most), most) : F32) : F32}
  patterns.steer.k4(bullet, knights, pops, path, speed, heading, nxt)

def patterns.steer.m21(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +speed: F32, +heading: F32, +nxt: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _s:
    case Some{+kn}:
      patterns.steer.k22(kn, bullet, knights, pops, path, speed, heading, nxt)
    case None{}:
      +heading = {heading : F32}
      patterns.steer.k4(bullet, knights, pops, path, speed, heading, nxt)

def patterns.steer.if20(_c: Bool, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +speed: F32, +heading: F32, +nxt: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      patterns.steer.m21(patterns.nearest(knights, cb.gf(bullet, "x"), cb.gf(bullet, "y")), bullet, knights, pops, path, speed, heading, nxt)
    case False{}:
      patterns.steer.k4(bullet, knights, pops, path, speed, heading, nxt)

def patterns.steer.k3(+bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +speed: F32, +heading: F32, +nxt: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +heading = {(heading + cb.gf(path, "turn") * rules.DT() : F32) : F32}
  patterns.steer.if20((cb.gf(path, "seek") > 0.0 : F32), bullet, knights, pops, path, speed, heading, nxt)

def patterns.steer.if24(_c: Bool, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +speed: F32, +heading: F32, +nxt: F32, +change: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +nxt = {RS.f_min((speed + change : F32), cb.gf(path, "top")) : F32}
      patterns.steer.k3(bullet, knights, pops, path, speed, heading, nxt)
    case False{}:
      +nxt = {RS.f_max((speed - change : F32), cb.gf(path, "top")) : F32}
      patterns.steer.k3(bullet, knights, pops, path, speed, heading, nxt)

def patterns.steer.if23(_c: Bool, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val, +speed: F32, +heading: F32, +nxt: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +change = {(RS.f_abs(cb.gf(path, "accel")) * rules.DT() : F32) : F32}
      patterns.steer.if24((speed < cb.gf(path, "top") : F32), bullet, knights, pops, path, speed, heading, nxt, change)
    case False{}:
      patterns.steer.k3(bullet, knights, pops, path, speed, heading, nxt)

def patterns.steer.k2(+bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +path = {cb.su(path, "age", RS.u_min((cb.gu(path, "age") + 1 : U32), 65535)) : J.Val}
  +speed = {cb.hyp(cb.gf(bullet, "vx"), cb.gf(bullet, "vy")) : F32}
  +heading = {RS.f_atan2(cb.gf(bullet, "vy"), cb.gf(bullet, "vx")) : F32}
  +nxt = {speed : F32}
  patterns.steer.if23(Bool.not(F32.is_eq(cb.gf(path, "accel"), 0.0)), bullet, knights, pops, path, speed, heading, nxt)

def patterns.steer.if25(_c: Bool, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      (bullet, pops, False{})
    case False{}:
      patterns.steer.k2(bullet, knights, pops, path)

def patterns.steer.k1(+bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +path = {cb.sb(path, "held", False{}) : J.Val}
  +bullet = {cb.sj(bullet, "traits", cb.sj(cb.gj(bullet, "traits"), "path", path)) : J.Val}
  patterns.steer.if25(patterns.Path.is_default(path), bullet, knights, pops, path)

def patterns.steer.if26(_c: Bool, +bullet: J.Val, +knights: J.Val, +pops: J.Val, +path: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +path = {cb.su(path, "wait", (cb.gu(path, "wait") - 1 : U32)) : J.Val}
      +path = {cb.sb(path, "held", True{}) : J.Val}
      +bullet = {cb.sj(bullet, "traits", cb.sj(cb.gj(bullet, "traits"), "path", path)) : J.Val}
      +bullet = {cb.su(bullet, "ttl", RS.u_sat_sub(cb.gu(bullet, "ttl"), 1)) : J.Val}
      (bullet, pops, True{})
    case False{}:
      patterns.steer.k1(bullet, knights, pops, path)

# A shot's family, from what its path does.

def patterns.family(+shot: J.Val) -> String:
  +path = {cb.gj(cb.gj(shot, "traits"), "path") : J.Val}
  patterns.family.if20(String.eq(cb.gs(path, "form"), "dart"), shot, path)

def patterns.family.k10() -> String:
  "plain"

def patterns.family.if11(_c: Bool) -> String:
  match _c:
    case True{}:
      "hook"
    case False{}:
      patterns.family.k10()

def patterns.family.k9(+path: J.Val) -> String:
  patterns.family.if11(Bool.not(F32.is_eq(cb.gf(path, "turn"), 0.0)))

def patterns.family.if12(_c: Bool, +path: J.Val) -> String:
  match _c:
    case True{}:
      "brake"
    case False{}:
      patterns.family.k9(path)

def patterns.family.k8(+path: J.Val) -> String:
  patterns.family.if12(Bool.or((cb.gf(path, "accel") < 0.0 : F32), J.has(cb.gj(path, "then"), "aim")), path)

def patterns.family.if13(_c: Bool, +path: J.Val) -> String:
  match _c:
    case True{}:
      "quicken"
    case False{}:
      patterns.family.k8(path)

def patterns.family.k7(+path: J.Val) -> String:
  patterns.family.if13((cb.gf(path, "accel") > 0.0 : F32), path)

def patterns.family.if14(_c: Bool, +path: J.Val) -> String:
  match _c:
    case True{}:
      "seeker"
    case False{}:
      patterns.family.k7(path)

def patterns.family.k6(+path: J.Val) -> String:
  patterns.family.if14((cb.gf(path, "seek") > 0.0 : F32), path)

def patterns.family.if15(_c: Bool, +path: J.Val) -> String:
  match _c:
    case True{}:
      "wave"
    case False{}:
      patterns.family.k6(path)

def patterns.family.k5(+path: J.Val) -> String:
  patterns.family.if15(Bool.not(F32.is_eq(cb.gf(path, "wave"), 0.0)), path)

def patterns.family.if16(_c: Bool, +path: J.Val) -> String:
  match _c:
    case True{}:
      "bounce"
    case False{}:
      patterns.family.k5(path)

def patterns.family.k4(+shot: J.Val, +path: J.Val) -> String:
  patterns.family.if16(U32.is_gt(cb.gu(cb.gj(shot, "traits"), "bounce"), 0), path)

def patterns.family.if17(_c: Bool, +shot: J.Val, +path: J.Val) -> String:
  match _c:
    case True{}:
      "split"
    case False{}:
      patterns.family.k4(shot, path)

def patterns.family.k3(+shot: J.Val, +path: J.Val) -> String:
  patterns.family.if17(J.has(cb.gj(path, "then"), "burst"), shot, path)

def patterns.family.if18(_c: Bool, +shot: J.Val, +path: J.Val) -> String:
  match _c:
    case True{}:
      "lob"
    case False{}:
      patterns.family.k3(shot, path)

def patterns.family.k2(+shot: J.Val, +path: J.Val) -> String:
  patterns.family.if18(String.eq(cb.gs(path, "form"), "lob"), shot, path)

def patterns.family.if19(_c: Bool, +shot: J.Val, +path: J.Val) -> String:
  match _c:
    case True{}:
      "orb"
    case False{}:
      patterns.family.k2(shot, path)

def patterns.family.k1(+shot: J.Val, +path: J.Val) -> String:
  patterns.family.if19(String.eq(cb.gs(path, "form"), "orb"), shot, path)

def patterns.family.if20(_c: Bool, +shot: J.Val, +path: J.Val) -> String:
  match _c:
    case True{}:
      "dart"
    case False{}:
      patterns.family.k1(shot, path)

# How far past a knight's body `shot` strikes.

def patterns.girth(+shot: J.Val) -> F32:
  +form = {cb.gs(cb.gj(cb.gj(shot, "traits"), "path"), "form") : String}
  patterns.girth.if6(String.eq(form, "dart"), form)

def patterns.girth.k3() -> F32:
  patterns.STRIKE()

def patterns.girth.if4(_c: Bool) -> F32:
  match _c:
    case True{}:
      patterns.LOB_SPLASH()
    case False{}:
      patterns.girth.k3()

def patterns.girth.k2(+form: String) -> F32:
  patterns.girth.if4(String.eq(form, "lob"))

def patterns.girth.if5(_c: Bool, +form: String) -> F32:
  match _c:
    case True{}:
      patterns.ORB_STRIKE()
    case False{}:
      patterns.girth.k2(form)

def patterns.girth.k1(+form: String) -> F32:
  patterns.girth.if5(String.eq(form, "orb"), form)

def patterns.girth.if6(_c: Bool, +form: String) -> F32:
  match _c:
    case True{}:
      patterns.DART_STRIKE()
    case False{}:
      patterns.girth.k1(form)

def patterns.body(+shot: J.Val) -> F32:
  patterns.body.if10(wishcraft.Projectile.sized(shot), shot)

def patterns.body.k5() -> F32:
  patterns.BODY()

def patterns.body.if6(_c: Bool) -> F32:
  match _c:
    case True{}:
      0.0
    case False{}:
      patterns.body.k5()

def patterns.body.k4(+form: String) -> F32:
  patterns.body.if6(String.eq(form, "lob"))

def patterns.body.if7(_c: Bool, +form: String) -> F32:
  match _c:
    case True{}:
      patterns.ORB_BODY()
    case False{}:
      patterns.body.k4(form)

def patterns.body.k3(+form: String) -> F32:
  patterns.body.if7(String.eq(form, "orb"), form)

def patterns.body.if8(_c: Bool, +form: String) -> F32:
  match _c:
    case True{}:
      patterns.DART_BODY()
    case False{}:
      patterns.body.k3(form)

def patterns.body.k2(+shot: J.Val) -> F32:
  +form = {cb.gs(cb.gj(cb.gj(shot, "traits"), "path"), "form") : String}
  patterns.body.if8(String.eq(form, "dart"), form)

def patterns.body.if9(_c: Bool, +shot: J.Val) -> F32:
  match _c:
    case True{}:
      (patterns.KNIGHT_BODY() + wishcraft.Projectile.reach(shot) : F32)
    case False{}:
      patterns.body.k2(shot)

def patterns.body.k1(+shot: J.Val) -> F32:
  patterns.body.if9(Bool.not(cb.gb(shot, "hostile")), shot)

def patterns.body.if10(_c: Bool, +shot: J.Val) -> F32:
  match _c:
    case True{}:
      +base = {(cb.f(wishcraft.BASE_PCT()) / 100.0 : F32) : F32}
      (patterns.KNIGHT_BODY() * RS.f_min((wishcraft.Projectile.scale(shot) / base : F32), 1.0) + wishcraft.Projectile.reach(shot) : F32)
    case False{}:
      patterns.body.k1(shot)

# Where a lob comes down, and how high it is now (units): its shadow's spot
# run on to its landing at its ground speed.

def patterns.lob_flight(+shot: J.Val) -> Maybe<&2, Sigma<&2, &2, Sigma<&2, &2, F32, _ => F32>, _ => F32>>:
  +path = {cb.gj(cb.gj(shot, "traits"), "path") : J.Val}
  patterns.lob_flight.if2(Bool.or(Bool.not(String.eq(cb.gs(path, "form"), "lob")), U32.is_eq(cb.gu(path, "fuse"), 0)), shot, path)

def patterns.lob_flight.k1(+shot: J.Val, +path: J.Val) -> Maybe<&2, Sigma<&2, &2, Sigma<&2, &2, F32, _ => F32>, _ => F32>>:
  +left = {cb.f(RS.u_sat_sub(cb.gu(path, "fuse"), cb.gu(path, "age"))) : F32}
  +landx = {(cb.gf(shot, "x") + cb.gf(shot, "vx") * rules.DT() * left : F32) : F32}
  +landy = {(cb.gf(shot, "y") + cb.gf(shot, "vy") * rules.DT() * left : F32) : F32}
  +thrown = {(cb.hyp(cb.gf(shot, "vx"), cb.gf(shot, "vy")) * rules.DT() * cb.f(cb.gu(path, "fuse")) : F32) : F32}
  +k = {(cb.f(cb.gu(path, "age")) / cb.f(cb.gu(path, "fuse")) : F32) : F32}
  Some{((landx, landy), (4.0 * patterns.LOB_RISE() * thrown * k * (1.0 - k : F32) : F32))}

def patterns.lob_flight.if2(_c: Bool, +shot: J.Val, +path: J.Val) -> Maybe<&2, Sigma<&2, &2, Sigma<&2, &2, F32, _ => F32>, _ => F32>>:
  match _c:
    case True{}:
      None{}
    case False{}:
      patterns.lob_flight.k1(shot, path)

def patterns.DEPTH_STEP(+i: U32) -> U32:
  patterns.DEPTH_STEP.m1(i)

def patterns.DEPTH_STEP.m1(+_s: U32) -> U32:
  match _s:
    case 2:
      1
    case 3:
      2
    case 4:
      2
    case 5:
      3
    case _:
      0

def patterns.HEAD_STEP(+i: U32) -> U32:
  patterns.HEAD_STEP.m1(i)

def patterns.HEAD_STEP.m1(+_s: U32) -> U32:
  match _s:
    case 2:
      1
    case 3:
      2
    case 4:
      3
    case _:
      0

# The thickness a volley gets on this floor, with this many knights, from an
# elite or not.

def patterns.Sight.step(+depth: U32, +heads: U32, +elite: Bool) -> U32:
  +floor = {patterns.DEPTH_STEP((RS.u_clamp(depth, 1, 6) - 1 : U32)) : U32}
  +hs = {patterns.HEAD_STEP(RS.u_min(heads, 4)) : U32}
  RS.u_min((floor + hs + Bool.to_u32(elite) : U32), patterns.MOST_STEP())

# Index of the knight nearest (x, y), and its spot: the first of equals.

def patterns.nearest_ix(+knights: J.Val, +x: F32, +y: F32) -> Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>:
  +best = {None{} : Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>}
  +bd = {0.0 : F32}
  patterns.nearest_ix.loop2(cb.range(J.len(knights)), knights, x, y, best, bd)

def patterns.nearest_ix.k1(+best: Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>) -> Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>:
  best

def patterns.nearest_ix.if5(_c: Bool, +knights: J.Val, +x: F32, +y: F32, +best: Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>, +bd: F32, +_t2: List<&2, U32>, +i: U32, +kx: F32, +ky: F32, +d: F32) -> Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>:
  match _c:
    case True{}:
      +best = {Some{(i, (kx, ky))} : Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>}
      +bd = {d : F32}
      patterns.nearest_ix.loop2(_t2, knights, x, y, best, bd)
    case False{}:
      patterns.nearest_ix.loop2(_t2, knights, x, y, best, bd)

def patterns.nearest_ix.m4(+_s: Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>, +knights: J.Val, +x: F32, +y: F32, +best: Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>, +bd: F32, +_t2: List<&2, U32>, +i: U32, +kx: F32, +ky: F32, +d: F32) -> Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>:
  match _s:
    case None{}:
      +best = {Some{(i, (kx, ky))} : Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>}
      +bd = {d : F32}
      patterns.nearest_ix.loop2(_t2, knights, x, y, best, bd)
    case Some{+b}:
      patterns.nearest_ix.if5((d < bd : F32), knights, x, y, best, bd, _t2, i, kx, ky, d)

def patterns.nearest_ix.k3(+_t: Sigma<&2, &2, F32, _ => F32>, +knights: J.Val, +x: F32, +y: F32, +best: Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>, +bd: F32, +_t2: List<&2, U32>, +i: U32) -> Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>:
  (+kx, +ky) = _t
  +d = {cb.hyp((kx - x : F32), (ky - y : F32)) : F32}
  patterns.nearest_ix.m4(best, knights, x, y, best, bd, _t2, i, kx, ky, d)

def patterns.nearest_ix.loop2(+_xs: List<&2, U32>, +knights: J.Val, +x: F32, +y: F32, +best: Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>, +bd: F32) -> Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>:
  match _xs:
    case Nil{}:
      patterns.nearest_ix.k1(best)
    case Con{+i, +_t2}:
      +k = {cb.pair(J.nth(knights, i)) : Sigma<&2, &2, F32, _ => F32>}
      patterns.nearest_ix.k3(k, knights, x, y, best, bd, _t2, i)

# A monster's volley this tick, if its signature's beat has come; a guardian's
# from its `.boss` file's named patterns and phases. The Sight is flattened:
# knights (spots), paces, pack, depth, heads. Answers (enemy, shots).

def patterns.volley(+enemy: J.Val, +knights: J.Val, +paces: J.Val, +pack: String, +depth: U32, +heads: U32, +room: J.Val, +barred: Bool, +seed: W.W, +bosses: J.Val, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  patterns.volley.m1(patterns.nearest_ix(knights, cb.gf(enemy, "x"), cb.gf(enemy, "y")), enemy, knights, paces, pack, depth, heads, room, barred, seed, bosses, shots)

def patterns.volley.m1(+_s: Maybe<&2, Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>>, +enemy: J.Val, +knights: J.Val, +paces: J.Val, +pack: String, +depth: U32, +heads: U32, +room: J.Val, +barred: Bool, +seed: W.W, +bosses: J.Val, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _s:
    case None{}:
      (enemy, shots)
    case Some{+found}:
      patterns.volley.go(enemy, knights, paces, pack, depth, heads, room, barred, seed, bosses, shots, found)

def patterns.volley.go(+enemy: J.Val, +knights: J.Val, +paces: J.Val, +pack: String, +depth: U32, +heads: U32, +room: J.Val, +barred: Bool, +seed: W.W, +bosses: J.Val, +shots: J.Val, +found: Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  patterns.volley.go.k1(found, enemy, paces, pack, depth, heads, room, barred, seed, bosses, shots)

def patterns.volley.go.k5(+enemy: J.Val, +pack: String, +depth: U32, +room: J.Val, +barred: Bool, +shots: J.Val, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +step: U32, +salt: W.W, +fx: F32, +fy: F32, +shield_line: Bool) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  patterns.volley.plain(enemy, pack, depth, (fx, fy), at, pace, room, barred, salt, step, shield_line, shots)

def patterns.volley.go.if6(_c: Bool, +enemy: J.Val, +pack: String, +depth: U32, +room: J.Val, +barred: Bool, +shots: J.Val, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +step: U32, +salt: W.W, +boss: J.Val, +wanted: Bool, +fx: F32, +fy: F32, +shield_line: Bool) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      patterns.volley.boss(enemy, boss, (fx, fy), at, pace, room, barred, salt, step, shield_line, wanted, shots)
    case False{}:
      patterns.volley.go.k5(enemy, pack, depth, room, barred, shots, at, pace, step, salt, fx, fy, shield_line)

def patterns.volley.go.k4(+enemy: J.Val, +pack: String, +depth: U32, +room: J.Val, +barred: Bool, +shots: J.Val, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +is_boss: Bool, +step: U32, +salt: W.W, +boss: J.Val, +has_boss: Bool, +wanted: Bool, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +shield_line = {Bool.and(String.eq(cb.gs(enemy, "kind"), "pavise"), Bool.not(is_boss)) : Bool}
  patterns.volley.go.if6(has_boss, enemy, pack, depth, room, barred, shots, at, pace, step, salt, boss, wanted, fx, fy, shield_line)

def patterns.volley.go.k9(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +pack: String, +depth: U32, +room: J.Val, +barred: Bool, +shots: J.Val, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +is_boss: Bool, +step: U32, +salt: W.W, +boss: J.Val, +has_boss: Bool, +wanted: Bool) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+fx, +fy) = _t
  patterns.volley.go.k4(enemy, pack, depth, room, barred, shots, at, pace, is_boss, step, salt, boss, has_boss, wanted, fx, fy)

def patterns.volley.go.m8(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +enemy: J.Val, +pack: String, +depth: U32, +room: J.Val, +barred: Bool, +shots: J.Val, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +is_boss: Bool, +step: U32, +salt: W.W, +boss: J.Val, +has_boss: Bool, +wanted: Bool, +fx: F32, +fy: F32, +nozzle: Sigma<&2, &2, F32, _ => F32>) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _s:
    case None{}:
      patterns.volley.go.k9(nozzle, enemy, pack, depth, room, barred, shots, at, pace, is_boss, step, salt, boss, has_boss, wanted)
    case Some{+hit}:
      +fx = {fx : F32}
      patterns.volley.go.k4(enemy, pack, depth, room, barred, shots, at, pace, is_boss, step, salt, boss, has_boss, wanted, fx, fy)

def patterns.volley.go.if7(_c: Bool, +enemy: J.Val, +pack: String, +depth: U32, +room: J.Val, +barred: Bool, +shots: J.Val, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +is_boss: Bool, +step: U32, +salt: W.W, +boss: J.Val, +has_boss: Bool, +wanted: Bool, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +nozzle = {((cb.gf(enemy, "x") - 0.3 : F32), (cb.gf(enemy, "y") - 2.2 : F32)) : Sigma<&2, &2, F32, _ => F32>}
      patterns.volley.go.m8(rules.Grid.shot_stop(room, barred, (cb.gf(enemy, "x"), cb.gf(enemy, "y")), cb.aff(nozzle)), enemy, pack, depth, room, barred, shots, at, pace, is_boss, step, salt, boss, has_boss, wanted, fx, fy, nozzle)
    case False{}:
      patterns.volley.go.k4(enemy, pack, depth, room, barred, shots, at, pace, is_boss, step, salt, boss, has_boss, wanted, fx, fy)

def patterns.volley.go.k3(+enemy: J.Val, +pack: String, +depth: U32, +room: J.Val, +barred: Bool, +seed: W.W, +bosses: J.Val, +shots: J.Val, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +is_boss: Bool, +step: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +salt = {W.xor(seed, W.shl(W.of_u32(cb.gu(enemy, "id")), 24)) : W.W}
  +boss = {J.nth(bosses, RS.u_min(J.u32(J.get(enemy, "boss")), 65535)) : J.Val}
  +has_boss = {Bool.and(is_boss, U32.is_lt(J.u32(J.get(enemy, "boss")), J.len(bosses))) : Bool}
  +wanted = {String.eq(cb.gs(room, "kind"), "wanted") : Bool}
  +funnel = {Bool.and(Bool.and(has_boss, String.eq(cb.gs(boss, "id"), "grinwick")), Bool.not(wanted)) : Bool}
  +fx = {cb.gf(enemy, "x") : F32}
  +fy = {cb.gf(enemy, "y") : F32}
  patterns.volley.go.if7(funnel, enemy, pack, depth, room, barred, shots, at, pace, is_boss, step, salt, boss, has_boss, wanted, fx, fy)

def patterns.volley.go.if11(_c: Bool, +enemy: J.Val, +pack: String, +depth: U32, +room: J.Val, +barred: Bool, +seed: W.W, +bosses: J.Val, +shots: J.Val, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +is_boss: Bool, +step: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +step = {RS.u_min(step, patterns.DEMON_STEP()) : U32}
      patterns.volley.go.k3(enemy, pack, depth, room, barred, seed, bosses, shots, at, pace, is_boss, step)
    case False{}:
      patterns.volley.go.k3(enemy, pack, depth, room, barred, seed, bosses, shots, at, pace, is_boss, step)

def patterns.volley.go.if10(_c: Bool, +enemy: J.Val, +pack: String, +depth: U32, +heads: U32, +room: J.Val, +barred: Bool, +seed: W.W, +bosses: J.Val, +shots: J.Val, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +is_boss: Bool, +step: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +step = {Bool.pick(U32, U32.is_ge(heads, 4), 1, 0) : U32}
      patterns.volley.go.k3(enemy, pack, depth, room, barred, seed, bosses, shots, at, pace, is_boss, step)
    case False{}:
      patterns.volley.go.if11(String.eq(cb.gs(enemy, "kind"), "demon"), enemy, pack, depth, room, barred, seed, bosses, shots, at, pace, is_boss, step)

def patterns.volley.go.k2(+enemy: J.Val, +pack: String, +depth: U32, +heads: U32, +room: J.Val, +barred: Bool, +seed: W.W, +bosses: J.Val, +shots: J.Val, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +is_boss = {Bool.not(J.is_null(J.get(enemy, "boss"))) : Bool}
  +step = {patterns.Sight.step(depth, heads, cb.gb(enemy, "elite")) : U32}
  patterns.volley.go.if10(is_boss, enemy, pack, depth, heads, room, barred, seed, bosses, shots, at, pace, is_boss, step)

def patterns.volley.go.if12(_c: Bool, +enemy: J.Val, +paces: J.Val, +pack: String, +depth: U32, +heads: U32, +room: J.Val, +barred: Bool, +seed: W.W, +bosses: J.Val, +shots: J.Val, +i: U32, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +pace = {cb.pair(J.nth(paces, i)) : Sigma<&2, &2, F32, _ => F32>}
      patterns.volley.go.k2(enemy, pack, depth, heads, room, barred, seed, bosses, shots, at, pace)
    case False{}:
      patterns.volley.go.k2(enemy, pack, depth, heads, room, barred, seed, bosses, shots, at, pace)

def patterns.volley.go.k1(+_t: Sigma<&2, &2, U32, _ => Sigma<&2, &2, F32, _ => F32>>, +enemy: J.Val, +paces: J.Val, +pack: String, +depth: U32, +heads: U32, +room: J.Val, +barred: Bool, +seed: W.W, +bosses: J.Val, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+i, +at) = _t
  +pace = {(0.0, 0.0) : Sigma<&2, &2, F32, _ => F32>}
  patterns.volley.go.if12(U32.is_lt(i, J.len(paces)), enemy, paces, pack, depth, heads, room, barred, seed, bosses, shots, i, at, pace)

# A guardian's volley: its file's named attacks and its phases chain.

def patterns.volley.boss(+enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  patterns.volley.boss.if19(Bool.and(wanted, Bool.not(outlaw.shooting(cb.gu(enemy, "stage")))), enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots)

def patterns.volley.boss.k5(+enemy: J.Val, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (enemy, shots)

def patterns.volley.boss.loop7(+_xs: List<&2, U32>, +enemy: J.Val, +shots: J.Val, +first: U32, +soot: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _xs:
    case Nil{}:
      patterns.volley.boss.k5(enemy, shots)
    case Con{+si, +_t7}:
      +shots = {J.set_nth(shots, (first + si : U32), J.set(J.nth(shots, (first + si : U32)), "look", soot)) : J.Val}
      patterns.volley.boss.loop7(_t7, enemy, shots, first, soot)

def patterns.volley.boss.if6(_c: Bool, +enemy: J.Val, +shots: J.Val, +first: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +soot = {J.JA{[J.JS{"soot"}, J.JS{"coal"}]} : J.Val}
      patterns.volley.boss.loop7(cb.range(RS.u_sat_sub(J.len(shots), first)), enemy, shots, first, soot)
    case False{}:
      patterns.volley.boss.k5(enemy, shots)

def patterns.volley.boss.k4(+enemy: J.Val, +boss: J.Val, +shots: J.Val, +first: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  patterns.volley.boss.if6(String.eq(cb.gs(boss, "id"), "grinwick"), enemy, shots, first)

def patterns.volley.boss.if11(_c: Bool, +enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val, +first: U32, +ph: J.Val, +count: U32, +phase: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +emitter = {J.str(J.nth(cb.gj(ph, "chain"), phase)) : String}
      +kind = {bosses.Bolt.shot(cb.gs(ph, "bolt"), cb.gs(boss, "only_in")) : String}
      +aim = {patterns.Aim.make(src, at, pace, room, barred, count, salt, step, kind, cb.gu(ph, "damage"), patterns.volley.size(emitter, wanted), shield_line) : J.Val}
      +shots = {patterns.emit(emitter, aim, shots) : J.Val}
      +enemy = {cb.su(enemy, "pattern_volleys", (count + 1 : U32)) : J.Val}
      patterns.volley.boss.k4(enemy, boss, shots, first)
    case False{}:
      patterns.volley.boss.k4(enemy, boss, shots, first)

def patterns.volley.boss.if10(_c: Bool, +enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val, +first: U32, +ph: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +count = {cb.gu(enemy, "pattern_volleys") : U32}
      +phase = {U32.mod((count / RS.u_max(cb.gu(ph, "volleys"), 1) : U32), RS.u_max(J.len(cb.gj(ph, "chain")), 1)) : U32}
      patterns.volley.boss.if11(U32.is_lt(phase, J.len(cb.gj(ph, "chain"))), enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, ph, count, phase)
    case False{}:
      patterns.volley.boss.k4(enemy, boss, shots, first)

def patterns.volley.boss.if9(_c: Bool, +enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val, +first: U32, +raging: Bool, +ph: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +every = {patterns.volley.quicken(enemy, cb.gu(ph, "every"), raging, wanted) : U32}
      +tick = {(cb.gu(enemy, "age") + 7 : U32) : U32}
      patterns.volley.boss.if10(U32.is_eq(U32.mod(tick, every), 0), enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, ph)
    case False{}:
      patterns.volley.boss.k4(enemy, boss, shots, first)

def patterns.volley.boss.if8(_c: Bool, +enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val, +first: U32, +raging: Bool, +rank: U32, +phases: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +ph = {phases : J.Val}
      patterns.volley.boss.if9(U32.is_le(bosses.Stage.rank(cb.gs(ph, "from")), rank), enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, ph)
    case False{}:
      patterns.volley.boss.k4(enemy, boss, shots, first)

def patterns.volley.boss.k3(+enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val, +first: U32, +raging: Bool, +rank: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +phases = {cb.gj(boss, "phases") : J.Val}
  patterns.volley.boss.if8(Bool.not(J.is_null(phases)), enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank, phases)

def patterns.volley.boss.if15(_c: Bool, +enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val, +first: U32, +raging: Bool, +rank: U32, +attacks: J.Val, +_t12: List<&2, U32>, +attack: J.Val, +emitter: String, +every: U32, +tick: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +kind = {bosses.Bolt.shot(cb.gs(attack, "bolt"), cb.gs(boss, "only_in")) : String}
      +aim = {patterns.Aim.make(src, at, pace, room, barred, (tick / every : U32), salt, step, kind, cb.gu(attack, "damage"), patterns.volley.size(emitter, wanted), shield_line) : J.Val}
      +shots = {patterns.emit(emitter, aim, shots) : J.Val}
      patterns.volley.boss.loop12(_t12, enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank, attacks)
    case False{}:
      patterns.volley.boss.loop12(_t12, enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank, attacks)

def patterns.volley.boss.k14(+enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val, +first: U32, +raging: Bool, +rank: U32, +attacks: J.Val, +_t12: List<&2, U32>, +index: U32, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +emitter = {J.str(J.get(pat, "named")) : String}
  +every = {patterns.volley.quicken(enemy, cb.gu(attack, "every"), raging, wanted) : U32}
  +tick = {(cb.gu(enemy, "age") + index * 11 : U32) : U32}
  patterns.volley.boss.if15(U32.is_eq(U32.mod(tick, every), 0), enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank, attacks, _t12, attack, emitter, every, tick)

def patterns.volley.boss.if16(_c: Bool, +enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val, +first: U32, +raging: Bool, +rank: U32, +attacks: J.Val, +_t12: List<&2, U32>, +index: U32, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      patterns.volley.boss.loop12(_t12, enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank, attacks)
    case False{}:
      patterns.volley.boss.k14(enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank, attacks, _t12, index, attack, pat)

def patterns.volley.boss.k13(+enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val, +first: U32, +raging: Bool, +rank: U32, +attacks: J.Val, +_t12: List<&2, U32>, +index: U32, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  patterns.volley.boss.if16(U32.is_gt(bosses.Stage.rank(cb.gs(attack, "from")), rank), enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank, attacks, _t12, index, attack, pat)

def patterns.volley.boss.if17(_c: Bool, +enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val, +first: U32, +raging: Bool, +rank: U32, +attacks: J.Val, +_t12: List<&2, U32>, +index: U32, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      patterns.volley.boss.loop12(_t12, enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank, attacks)
    case False{}:
      patterns.volley.boss.k13(enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank, attacks, _t12, index, attack, pat)

def patterns.volley.boss.loop12(+_xs: List<&2, U32>, +enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val, +first: U32, +raging: Bool, +rank: U32, +attacks: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _xs:
    case Nil{}:
      patterns.volley.boss.k3(enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank)
    case Con{+index, +_t12}:
      +attack = {J.nth(attacks, index) : J.Val}
      +pat = {cb.gj(attack, "pattern") : J.Val}
      patterns.volley.boss.if17(J.is_null(J.get(pat, "named")), enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank, attacks, _t12, index, attack, pat)

def patterns.volley.boss.k2(+enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +first = {J.len(shots) : U32}
  +stage = {Bool.pick(String, wanted, "rage", bosses.Boss.stage(boss, cb.gu(enemy, "hp"), cb.gu(enemy, "max_hp"))) : String}
  +raging = {Bool.pick(Bool, wanted, Bool.and((cb.gf(boss, "rage") > 0.0 : F32), (cb.f(cb.gu(enemy, "hp")) < (cb.gf(boss, "rage") * cb.f(cb.gu(enemy, "max_hp")) : F32) : F32)), String.eq(stage, "rage")) : Bool}
  +rank = {bosses.Stage.rank(stage) : U32}
  +attacks = {cb.gj(boss, "attacks") : J.Val}
  patterns.volley.boss.loop12(cb.range(J.len(attacks)), enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots, first, raging, rank, attacks)

def patterns.volley.boss.if18(_c: Bool, +enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      (enemy, shots)
    case False{}:
      patterns.volley.boss.k2(enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots)

def patterns.volley.boss.k1(+enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  patterns.volley.boss.if18(Bool.not(signatures.shooting(enemy, boss, wanted)), enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots)

def patterns.volley.boss.if19(_c: Bool, +enemy: J.Val, +boss: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +wanted: Bool, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      (enemy, shots)
    case False{}:
      patterns.volley.boss.k1(enemy, boss, src, at, pace, room, barred, salt, step, shield_line, wanted, shots)

def patterns.volley.quicken(+enemy: J.Val, +every: U32, +raging: Bool, +wanted: Bool) -> U32:
  +e = {Bool.pick(U32, raging, RS.u_max((every * 2 / 3 : U32), 4), RS.u_max(every, 4)) : U32}
  patterns.volley.quicken.if2(wanted, enemy, e)

def patterns.volley.quicken.k1(+e: U32) -> U32:
  e

def patterns.volley.quicken.if2(_c: Bool, +enemy: J.Val, +e: U32) -> U32:
  match _c:
    case True{}:
      (desperate.Enemy.beat(enemy, e) * outlaw.pattern_pace(cb.gu(enemy, "stage")) : U32)
    case False{}:
      patterns.volley.quicken.k1(e)

def patterns.volley.size(+emitter: String, +wanted: Bool) -> Maybe<&2, U32>:
  patterns.volley.size.if2(wanted, emitter)

def patterns.volley.size.k1(+emitter: String) -> Maybe<&2, U32>:
  Some{patterns.Emitter.guardian_count(emitter)}

def patterns.volley.size.if2(_c: Bool, +emitter: String) -> Maybe<&2, U32>:
  match _c:
    case True{}:
      None{}
    case False{}:
      patterns.volley.size.k1(emitter)

# A monster's own signature volley.

def patterns.volley.plain(+enemy: J.Val, +pack: String, +depth: U32, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  patterns.volley.plain.if10(Bool.or(Bool.and(String.eq(cb.gs(enemy, "kind"), "slime"), U32.is_ne(cb.gu(enemy, "stage"), 0)), Bool.or(Bool.and(String.eq(cb.gs(enemy, "kind"), "hollow"), U32.is_eq(cb.gu(enemy, "stage"), 1)), Bool.and(String.eq(cb.gs(enemy, "kind"), "pit_tyrant"), U32.is_ne(cb.gu(enemy, "stage"), 0)))), enemy, pack, depth, src, at, pace, room, barred, salt, step, shield_line, shots)

def patterns.volley.plain.k5(+enemy: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +shots: J.Val, +sig: J.Val, +chain: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +count = {cb.gu(enemy, "pattern_volleys") : U32}
  +pick = {J.nth(chain, U32.mod(count, J.len(chain))) : J.Val}
  +emitter = {J.str(J.nth(pick, 0)) : String}
  +kind = {J.str(J.nth(pick, 1)) : String}
  +aim = {patterns.Aim.make(src, at, pace, room, barred, count, salt, step, kind, J.u32(J.get(sig, "damage")), None{}, shield_line) : J.Val}
  +shots = {patterns.emit(emitter, aim, shots) : J.Val}
  +enemy = {cb.su(enemy, "pattern_volleys", (count + 1 : U32)) : J.Val}
  (enemy, shots)

def patterns.volley.plain.if6(_c: Bool, +enemy: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +shots: J.Val, +sig: J.Val, +chain: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      (enemy, shots)
    case False{}:
      patterns.volley.plain.k5(enemy, src, at, pace, room, barred, salt, step, shield_line, shots, sig, chain)

def patterns.volley.plain.k4(+enemy: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +shots: J.Val, +sig: J.Val, +starter: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +every = {desperate.Enemy.beat(enemy, (J.u32(J.get(sig, "every")) * starter / 100 : U32)) : U32}
  +tick = {(cb.gu(enemy, "age") + cb.gu(enemy, "id") * 13 : U32) : U32}
  +chain = {J.get(sig, "chain") : J.Val}
  patterns.volley.plain.if6(Bool.or(Bool.not(U32.is_eq(U32.mod(tick, every), 0)), U32.is_eq(J.len(chain), 0)), enemy, src, at, pace, room, barred, salt, step, shield_line, shots, sig, chain)

def patterns.volley.plain.if7(_c: Bool, +enemy: J.Val, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +shots: J.Val, +sig: J.Val, +starter: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +starter = {135 : U32}
      patterns.volley.plain.k4(enemy, src, at, pace, room, barred, salt, step, shield_line, shots, sig, starter)
    case False{}:
      patterns.volley.plain.k4(enemy, src, at, pace, room, barred, salt, step, shield_line, shots, sig, starter)

def patterns.volley.plain.k3(+enemy: J.Val, +depth: U32, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +shots: J.Val, +sig: J.Val, +starter: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  patterns.volley.plain.if7(U32.is_eq(depth, 2), enemy, src, at, pace, room, barred, salt, step, shield_line, shots, sig, starter)

def patterns.volley.plain.if8(_c: Bool, +enemy: J.Val, +depth: U32, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +shots: J.Val, +sig: J.Val, +starter: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +starter = {180 : U32}
      patterns.volley.plain.k3(enemy, depth, src, at, pace, room, barred, salt, step, shield_line, shots, sig, starter)
    case False{}:
      patterns.volley.plain.k3(enemy, depth, src, at, pace, room, barred, salt, step, shield_line, shots, sig, starter)

def patterns.volley.plain.k2(+enemy: J.Val, +depth: U32, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +shots: J.Val, +sig: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +starter = {100 : U32}
  patterns.volley.plain.if8(U32.is_eq(depth, 1), enemy, depth, src, at, pace, room, barred, salt, step, shield_line, shots, sig, starter)

def patterns.volley.plain.if9(_c: Bool, +enemy: J.Val, +depth: U32, +src: Sigma<&2, &2, F32, _ => F32>, +at: Sigma<&2, &2, F32, _ => F32>, +pace: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +salt: W.W, +step: U32, +shield_line: Bool, +shots: J.Val, +sig: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
