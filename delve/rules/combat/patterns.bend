    case Con{+i, +_t5}:
      patterns.wall.if6(Bool.and(patterns.wall.open(i, gap), Bool.not(patterns.has_u(chinks, i))), aim, n, gap, px, py, fx, fy, chinks, out, _t5, i)

def patterns.wall.k3(+aim: J.Val, +n: U32, +gap: U32, +px: F32, +py: F32, +fx: F32, +fy: F32, +chinks: List<&2, U32>) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
  +out = {Nil{} : List<&2, Sigma<&2, &2, F32, _ => F32>>}
  patterns.wall.loop5(cb.range(n), aim, n, gap, px, py, fx, fy, chinks, out)

def patterns.wall.loop8(+_xs: List<&2, U32>, +aim: J.Val, +n: U32, +gap: U32, +thin: U32, +px: F32, +py: F32, +fx: F32, +fy: F32, +roomv: List<&2, U32>, +rlen: U32, +chinks: List<&2, U32>) -> List<&2, Sigma<&2, &2, F32, _ => F32>>:
