# Where a lob thrown from `from` at `spot` comes down: no further than
# LOB_REACH, inside the room, on open ground (drawn back toward the thrower
# off stone); None if there is nowhere.

def patterns.landing(+aim: J.Val, +fx: F32, +fy: F32, +sx: F32, +sy: F32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  +dx = {(sx - fx : F32) : F32}
  +dy = {(sy - fy : F32) : F32}
  +d = {RS.f_max(cb.hyp(dx, dy), 0.01) : F32}
  +reach = {RS.f_min(d, patterns.LOB_REACH()) : F32}
  +ux = {(dx / d : F32) : F32}
  +uy = {(dy / d : F32) : F32}
  +r = {reach : F32}
  patterns.landing.loop2(aim, fx, fy, ux, uy, r)

def patterns.landing.k1() -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  None{}

