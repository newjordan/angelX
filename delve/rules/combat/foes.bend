    case False{}:
      foes.act.if28(Bool.and(String.eq(kind, "slime"), U32.is_lt(U32.mod(cb.gu(enemy, "age"), 40), 12)), enemy, room, barred, seed, shots, deeds, kind, seen, tx, ty, cx, cy, dist, aim, mover, r, beat)

def foes.act.if14(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +tx: F32, +ty: F32, +cx: F32, +cy: F32, +dist: F32, +aim: F32, +mover: U32, +r: F32, +beat: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  match _c:
    case True{}:
      +enemy = {foes.keep_off(enemy, room, barred, mover, r, dist, cx, cy, 8.0, 12.0, 2.0) : J.Val}
      foes.act.if15(Bool.and(U32.is_eq(U32.mod(beat, 150), 60), U32.is_lt(cb.gu(enemy, "stage"), foes.NECRO_RAISES())), enemy, shots, deeds)
    case False{}:
      foes.act.if16(String.eq(kind, "warboar"), enemy, room, barred, seed, shots, deeds, kind, seen, tx, ty, cx, cy, dist, aim, mover, r, beat)

def foes.act.if5(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +tx: F32, +ty: F32, +cx: F32, +cy: F32, +dist: F32, +aim: F32, +mover: U32, +r: F32, +beat: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  match _c:
    case True{}:
      foes.act.if6(U32.is_eq(cb.gu(enemy, "stage"), 0), enemy, room, barred, shots, deeds, seen, tx, ty, cx, cy, dist, mover, r)
    case False{}:
      foes.act.if14(String.eq(kind, "necromancer"), enemy, room, barred, seed, shots, deeds, kind, seen, tx, ty, cx, cy, dist, aim, mover, r, beat)

def foes.act.k3(+_t: F32 & F32, +enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  (+cx, +cy) = _t
  +dist = {cb.hyp((tx - cb.gf(enemy, "x") : F32), (ty - cb.gf(enemy, "y") : F32)) : F32}
  +aim = {RS.f_atan2((ty - cb.gf(enemy, "y") : F32), (tx - cb.gf(enemy, "x") : F32)) : F32}
  +mover = {foes.mover(kind) : U32}
  +r = {monsters.Enemy.radius(enemy) : F32}
  +enemy = {cb.su(enemy, "timer", (cb.gu(enemy, "timer") + 1 : U32)) : J.Val}
  +beat = {(cb.gu(enemy, "timer") + cb.gu(enemy, "id") * 7 : U32) : U32}
  foes.act.if5(String.eq(kind, "sapper"), enemy, room, barred, seed, shots, deeds, kind, seen, tx, ty, cx, cy, dist, aim, mover, r, beat)

def foes.act.k2(+enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  foes.act.k3(rules.unit((tx - cb.gf(enemy, "x") : F32), (ty - cb.gf(enemy, "y") : F32)), enemy, room, barred, seed, shots, deeds, kind, seen, tx, ty)

def foes.act.k67(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  (+tx, +ty) = _t
  foes.act.k2(enemy, room, barred, seed, shots, deeds, kind, seen, tx, ty)

def foes.act.m66(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  match _s:
    case Some{+t}:
      foes.act.k67(t, enemy, room, barred, seed, shots, deeds, kind, seen)
    case None{}:
      +tx = {tx : F32}
      foes.act.k2(enemy, room, barred, seed, shots, deeds, kind, seen, tx, ty)

def foes.act.k1(+enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  +target = {cb.nearest2(heroes, cb.gf(enemy, "x"), cb.gf(enemy, "y")) : Maybe<&2, Sigma<&2, &2, F32, _ => F32>>}
  +seen = {Maybe.is_some(&2, Sigma<&2, &2, F32, _ => F32>, target) : Bool}
  +tx = {cb.gf(enemy, "x") : F32}
  +ty = {(cb.gf(enemy, "y") + 1.0 : F32) : F32}
  foes.act.m66(target, enemy, room, barred, seed, shots, deeds, kind, seen, tx, ty)

def foes.act.if68(_c: Bool, +enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  match _c:
    case True{}:
      (enemy, shots, deeds, False{})
    case False{}:
      foes.act.k1(enemy, heroes, room, barred, seed, shots, deeds, kind)
