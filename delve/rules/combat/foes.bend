# Walk `(dx, dy)` at `speed` a second with wall sliding; answers the distance moved.

def foes.walk(+enemy: J.Val, +room: J.Val, +barred: Bool, +mover: U32, +r: F32, +dx: F32, +dy: F32, +speed: F32) -> Sigma<&2, &2, J.Val, _ => F32>:
  foes.walk.k1(rules.Grid.slide(room, barred, (cb.gf(enemy, "x"), cb.gf(enemy, "y")), ((dx * speed * rules.DT() : F32), (dy * speed * rules.DT() : F32)), r, mover), enemy)

def foes.walk.k1(+_t: F32 & F32, +enemy: J.Val) -> Sigma<&2, &2, J.Val, _ => F32>:
  (+x, +y) = _t
  +moved = {cb.hyp((x - cb.gf(enemy, "x") : F32), (y - cb.gf(enemy, "y") : F32)) : F32}
  +enemy = {cb.sf(enemy, "x", x) : J.Val}
  +enemy = {cb.sf(enemy, "y", y) : J.Val}
  (enemy, moved)

# Keep between `near` and `far` of the nearest knight, sidling between.

def foes.keep_off(+enemy: J.Val, +room: J.Val, +barred: Bool, +mover: U32, +r: F32, +dist: F32, +cx: F32, +cy: F32, +near: F32, +far: F32, +speed: F32) -> J.Val:
  +side = {Bool.pick(F32, U32.is_eq(U32.mod(cb.gu(enemy, "id"), 2), 0), 1.0, F32.neg(1.0)) : F32}
  +wx = {(RS.f_neg(cy) * side : F32) : F32}
  +wy = {(cx * side : F32) : F32}
  foes.keep_off.if3((dist < near : F32), enemy, room, barred, mover, r, dist, cx, cy, far, speed, wx, wy)

def foes.keep_off.k2(+_t: Sigma<&2, &2, J.Val, _ => F32>) -> J.Val:
