def foes.joined(+kind: String) -> Bool:
  Bool.or(Bool.or(Bool.or(String.eq(kind, "sapper"), String.eq(kind, "necromancer")), Bool.or(String.eq(kind, "warboar"), String.eq(kind, "slime"))), Bool.or(Bool.or(Bool.or(String.eq(kind, "goblin"), String.eq(kind, "hob")), Bool.or(String.eq(kind, "shaman"), String.eq(kind, "ward"))), Bool.or(Bool.or(String.eq(kind, "risen"), String.eq(kind, "broodmarrow")), Bool.or(String.eq(kind, "oathbound"), String.eq(kind, "whirlgrave")))))

def foes.spawn(+deeds: J.Val, +kind: String, +x: F32, +y: F32, +stage: U32) -> J.Val:
  +deeds = {cb.sj(deeds, "spawns", J.push(cb.gj(deeds, "spawns"), J.JA{[J.JS{kind}, J.of_f32(x), J.of_f32(y), J.of_u32(stage)]})) : J.Val}
  deeds

def foes.cue(+deeds: J.Val, +cue: String) -> J.Val:
  +deeds = {cb.sj(deeds, "cues", J.push(cb.gj(deeds, "cues"), J.JS{cue})) : J.Val}
  deeds

def foes.ram(+deeds: J.Val, +x: F32, +y: F32, +reach: F32, +damage: U32, +dx: F32, +dy: F32) -> J.Val:
  +deeds = {cb.sj(deeds, "rams", J.push(cb.gj(deeds, "rams"), J.JA{[J.of_f32(x), J.of_f32(y), J.of_f32(reach), J.of_u32(damage), cb.of_pair(dx, dy)]})) : J.Val}
  deeds

