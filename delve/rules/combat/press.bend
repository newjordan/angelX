    case False{}:
      press.held.k1(enemy)

def press.held.if6(_c: Bool, +enemy: J.Val) -> Sigma<&2, &2, J.Val, _ => Bool>:
  match _c:
    case True{}:
      +enemy = {cb.sj(enemy, "wits", cb.su(cb.gj(enemy, "wits"), "steady", (cb.gu(cb.gj(enemy, "wits"), "steady") - 1 : U32))) : J.Val}
