# One tick of a held monster's wits, before it acts: a long hold slides off a
# steady monster, and a long hold ending makes it steady. True while it is
# still held this tick. Answers (enemy, held).

def press.held(+enemy: J.Val) -> Sigma<&2, &2, J.Val, _ => Bool>:
  +enemy = {cb.sj(enemy, "wits", cb.su(cb.gj(enemy, "wits"), "flinch", RS.u_sat_sub(cb.gu(cb.gj(enemy, "wits"), "flinch"), 1))) : J.Val}
  press.held.if6(U32.is_gt(cb.gu(cb.gj(enemy, "wits"), "steady"), 0), enemy)

def press.held.k3(+enemy: J.Val) -> Sigma<&2, &2, J.Val, _ => Bool>:
  (enemy, True{})

def press.held.if4(_c: Bool, +enemy: J.Val) -> Sigma<&2, &2, J.Val, _ => Bool>:
  match _c:
    case True{}:
      +enemy = {cb.sj(enemy, "wits", cb.su(cb.gj(enemy, "wits"), "steady", press.STEADY())) : J.Val}
      press.held.k3(enemy)
    case False{}:
      press.held.k3(enemy)

def press.held.k2(+enemy: J.Val) -> Sigma<&2, &2, J.Val, _ => Bool>:
  +enemy = {cb.su(enemy, "frozen", (cb.gu(enemy, "frozen") - 1 : U32)) : J.Val}
  +enemy = {cb.sj(enemy, "wits", cb.su(cb.gj(enemy, "wits"), "held", RS.u_min((cb.gu(cb.gj(enemy, "wits"), "held") + 1 : U32), 65535))) : J.Val}
  press.held.if4(Bool.and(U32.is_eq(cb.gu(enemy, "frozen"), 0), U32.is_ge(cb.gu(cb.gj(enemy, "wits"), "held"), press.LONG_HOLD())), enemy)

def press.held.if5(_c: Bool, +enemy: J.Val) -> Sigma<&2, &2, J.Val, _ => Bool>:
  match _c:
    case True{}:
      +enemy = {cb.sj(enemy, "wits", cb.su(cb.gj(enemy, "wits"), "held", 0)) : J.Val}
      (enemy, False{})
    case False{}:
      press.held.k2(enemy)

def press.held.k1(+enemy: J.Val) -> Sigma<&2, &2, J.Val, _ => Bool>:
  press.held.if5(U32.is_eq(cb.gu(enemy, "frozen"), 0), enemy)

def press.held.if7(_c: Bool, +enemy: J.Val) -> Sigma<&2, &2, J.Val, _ => Bool>:
  match _c:
    case True{}:
      +enemy = {cb.su(enemy, "frozen", 0) : J.Val}
