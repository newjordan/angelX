# A party-wide control ultimate cast now: its hold, full or short as the last
# one was long ago or not. Answers (run, hold).

def press.Run.control_hold(+run: J.Val, +full: U32, +echo: U32) -> J.Val & U32:
  +short = {False{} : Bool}
  press.Run.control_hold.m4(cb.gow(cb.gj(run, "feel"), "control"), run, full, echo, short)

