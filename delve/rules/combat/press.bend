  (run, full)

def press.Run.control_hold.if3(_c: Bool, +run: J.Val, +full: U32, +echo: U32) -> J.Val & U32:
  match _c:
    case True{}:
      +run = {cb.sj(run, "cues", J.push(cb.gj(run, "cues"), J.JS{"ult_echo"})) : J.Val}
      (run, echo)
    case False{}:
      press.Run.control_hold.k2(run, full)

def press.Run.control_hold.k1(+run: J.Val, +full: U32, +echo: U32, +short: Bool) -> J.Val & U32:
  +run = {cb.sj(run, "feel", cb.sow(cb.gj(run, "feel"), "control", Some{cb.gw(run, "tick")})) : J.Val}
  press.Run.control_hold.if3(short, run, full, echo)

def press.Run.control_hold.m4(+_s: Maybe<&2, W.W>, +run: J.Val, +full: U32, +echo: U32, +short: Bool) -> J.Val & U32:
  match _s:
    case Some{+at}:
      +short = {W.lt(W.sat_sub(cb.gw(run, "tick"), at), W.of_u32(press.ECHO())) : Bool}
      press.Run.control_hold.k1(run, full, echo, short)
    case None{}:
      +short = {False{} : Bool}
      press.Run.control_hold.k1(run, full, echo, short)

