  +enemy = {critters.quicken(enemy, fx, fy, cb.gj(ctx, "room"), cb.gb(ctx, "barred")) : J.Val}
  +enemy = {wishcraft.slow(enemy, fx, fy, cb.gj(ctx, "room"), cb.gb(ctx, "barred")) : J.Val}
  +enemy = {skills.shove(enemy, cb.gj(ctx, "barricades")) : J.Val}
  hunt.step.if20(Bool.and(Bool.and(cb.gb(ctx, "side"), Bool.not(monsters.EnemyKind.flies(cb.gs(enemy, "kind")))), Bool.not(outlaw.own_gravity(enemy, cb.gj(ctx, "room")))), enemy, ctx, shots, deeds, rest, fx, fy)

def hunt.step.loop21(+_xs: List<&2, J.Val>, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +rest: F32, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _xs:
    case Nil{}:
      hunt.step.k14(enemy, ctx, shots, deeds, rest, fx, fy)
    case Con{+b, +_t21}:
      +shots = {J.push(shots, b) : J.Val}
      hunt.step.loop21(_t21, enemy, ctx, shots, deeds, rest, fx, fy)

def hunt.step.k13(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +rest: F32, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  hunt.step.loop21(J.items(cb.gj(deeds, "bursts")), enemy, ctx, shots, deeds, rest, fx, fy)

def hunt.step.k26(+_t: Sigma<&2, &2, J.Val, _ => J.Val>, +ctx: J.Val, +deeds: J.Val, +rest: F32, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+enemy, +shots) = _t
  +deeds = {cb.sj(deeds, "bursts", J.JA{Nil{}}) : J.Val}
  hunt.step.k13(enemy, ctx, shots, deeds, rest, fx, fy)

def hunt.step.k25(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32, +boss: J.Val, +before: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  hunt.step.k26(signatures.hold(enemy, boss, shots, fired, cb.gj(deeds, "bursts"), (cb.gu(ctx, "standing") + before : U32), cb.gu(ctx, "heads")), ctx, deeds, rest, fx, fy)

def hunt.step.loop27(+_xs: List<&2, U32>, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32, +boss: J.Val, +before: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _xs:
    case Nil{}:
      hunt.step.k25(enemy, ctx, shots, deeds, rest, fired, fx, fy, boss, before)
    case Con{+si, +_t27}:
      +before = {(before + signatures.weight(J.nth(shots, si)) : U32) : U32}
      hunt.step.loop27(_t27, enemy, ctx, shots, deeds, rest, fired, fx, fy, boss, before)

def hunt.step.if24(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32, +boss: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +before = {0 : U32}
      hunt.step.loop27(cb.range(RS.u_min(fired, J.len(shots))), enemy, ctx, shots, deeds, rest, fired, fx, fy, boss, before)
    case False{}:
      hunt.step.k13(enemy, ctx, shots, deeds, rest, fx, fy)

def hunt.step.k23(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32, +boss: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  hunt.step.if24(Bool.not(cb.gb(ctx, "wanted")), enemy, ctx, shots, deeds, rest, fired, fx, fy, boss)

def hunt.step.if30(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32, +boss: J.Val, +look: J.Val, +_t29: List<&2, U32>, +si: U32, +s: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +s = {cb.sj(s, "look", look) : J.Val}
      +shots = {J.set_nth(shots, (fired + si : U32), s) : J.Val}
      hunt.step.loop29(_t29, enemy, ctx, shots, deeds, rest, fired, fx, fy, boss, look)
    case False{}:
      hunt.step.loop29(_t29, enemy, ctx, shots, deeds, rest, fired, fx, fy, boss, look)

def hunt.step.loop29(+_xs: List<&2, U32>, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32, +boss: J.Val, +look: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _xs:
    case Nil{}:
      hunt.step.k23(enemy, ctx, shots, deeds, rest, fired, fx, fy, boss)
    case Con{+si, +_t29}:
      +s = {J.nth(shots, (fired + si : U32)) : J.Val}
      hunt.step.if30(String.eq(cb.gs(cb.gj(cb.gj(s, "traits"), "path"), "form"), "plain"), enemy, ctx, shots, deeds, rest, fired, fx, fy, boss, look, _t29, si, s)

def hunt.step.if28(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32, +boss: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +look = {J.JA{[J.JS{"boss-art"}, J.JS{cb.gs(boss, "id")}]} : J.Val}
      hunt.step.loop29(cb.range(RS.u_sat_sub(J.len(shots), fired)), enemy, ctx, shots, deeds, rest, fired, fx, fy, boss, look)
    case False{}:
      hunt.step.k23(enemy, ctx, shots, deeds, rest, fired, fx, fy, boss)

def hunt.step.if22(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32, +boss: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      hunt.step.if28(bosses.Art.known(cb.gs(boss, "id")), enemy, ctx, shots, deeds, rest, fired, fx, fy, boss)
    case False{}:
      hunt.step.k13(enemy, ctx, shots, deeds, rest, fx, fy)

def hunt.step.k12(+_t: Sigma<&2, &2, J.Val, _ => J.Val>, +ctx: J.Val, +deeds: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+enemy, +shots) = _t
  +boss = {J.nth(cb.gj(ctx, "bosses"), J.u32(J.get(enemy, "boss"))) : J.Val}
  +has_boss = {Bool.and(Bool.not(J.is_null(J.get(enemy, "boss"))), U32.is_lt(J.u32(J.get(enemy, "boss")), J.len(cb.gj(ctx, "bosses")))) : Bool}
  hunt.step.if22(has_boss, enemy, ctx, shots, deeds, rest, fired, fx, fy, boss)

def hunt.step.k11(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  hunt.step.k12(patterns.volley(enemy, living, paces, cb.gs(ctx, "pack"), cb.gu(ctx, "depth"), cb.gu(ctx, "heads"), cb.gj(ctx, "room"), cb.gb(ctx, "barred"), cb.gw(ctx, "seed"), cb.gj(ctx, "bosses"), shots), ctx, deeds, rest, fired, fx, fy)

def hunt.step.if31(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +shots = {J.JA{stakes.fan_out(cb.gu(enemy, "fury"), J.items(shots), fired)} : J.Val}
      hunt.step.k11(enemy, ctx, shots, deeds, living, paces, rest, fired, fx, fy)
    case False{}:
      hunt.step.k11(enemy, ctx, shots, deeds, living, paces, rest, fired, fx, fy)

def hunt.step.k10(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +guardian = {Bool.and(Bool.not(J.is_null(J.get(enemy, "boss"))), Bool.not(cb.gb(ctx, "wanted"))) : Bool}
  hunt.step.if31(Bool.and(Bool.and(U32.is_gt(cb.gu(enemy, "fury"), 0), U32.is_gt(J.len(shots), fired)), Bool.not(guardian)), enemy, ctx, shots, deeds, living, paces, rest, fired, fx, fy)

def hunt.step.if32(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +enemy = {tune.foe_step(enemy, fx, fy, cb.gf(ctx, "foe_pace"), cb.gj(ctx, "room"), cb.gb(ctx, "barred")) : J.Val}
      hunt.step.k10(enemy, ctx, shots, deeds, living, paces, rest, fired, fx, fy)
    case False{}:
      hunt.step.k10(enemy, ctx, shots, deeds, living, paces, rest, fired, fx, fy)

def hunt.step.k9(+_t: Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>, +ctx: J.Val, +living: J.Val, +paces: J.Val, +rest: F32, +fired: U32, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+enemy, (+shots, +deeds)) = _t
  hunt.step.if32(Bool.not(F32.is_eq(cb.gf(ctx, "foe_pace"), 1.0)), enemy, ctx, shots, deeds, living, paces, rest, fired, fx, fy)

def hunt.step.k8(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +rest = {cb.gf(enemy, "y") : F32}
  +fired = {J.len(shots) : U32}
  +fx = {cb.gf(enemy, "x") : F32}
  +fy = {cb.gf(enemy, "y") : F32}
  hunt.step.k9(monsters.act(enemy, living, cb.gj(ctx, "room"), cb.gb(ctx, "barred"), cb.gw(ctx, "seed"), cb.gj(ctx, "bosses"), shots, deeds), ctx, living, paces, rest, fired, fx, fy)

def hunt.step.if33(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      (enemy, shots, deeds)
    case False{}:
      hunt.step.k8(enemy, ctx, shots, deeds, living, paces)

def hunt.step.k7(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +enemy = {cb.su(enemy, "age", RS.u_sat_add(cb.gu(enemy, "age"), 1)) : J.Val}
  hunt.step.if33(U32.is_lt(cb.gu(enemy, "age"), rules.TELEGRAPH()), enemy, ctx, shots, deeds, living, paces)

def hunt.step.k35(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val, +_t34: List<&2, J.Val>, +pace: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +paces = {J.push(paces, pace) : J.Val}
  hunt.step.loop34(_t34, enemy, ctx, shots, deeds, living, paces)

def hunt.step.if38(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val, +_t34: List<&2, J.Val>, +lv: J.Val, +pace: J.Val, +found: Bool, +_t36: List<&2, U32>, +i: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +pace = {J.nth(cb.gj(ctx, "paces"), i) : J.Val}
      hunt.step.loop36(_t36, enemy, ctx, shots, deeds, living, paces, _t34, lv, pace, found)
    case False{}:
      hunt.step.loop36(_t36, enemy, ctx, shots, deeds, living, paces, _t34, lv, pace, found)

def hunt.step.if37(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val, +_t34: List<&2, J.Val>, +lv: J.Val, +pace: J.Val, +found: Bool, +_t36: List<&2, U32>, +i: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +found = {True{} : Bool}
      hunt.step.if38(U32.is_lt(i, J.len(cb.gj(ctx, "paces"))), enemy, ctx, shots, deeds, living, paces, _t34, lv, pace, found, _t36, i)
    case False{}:
      hunt.step.loop36(_t36, enemy, ctx, shots, deeds, living, paces, _t34, lv, pace, found)

def hunt.step.loop36(+_xs: List<&2, U32>, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val, +_t34: List<&2, J.Val>, +lv: J.Val, +pace: J.Val, +found: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _xs:
    case Nil{}:
      hunt.step.k35(enemy, ctx, shots, deeds, living, paces, _t34, pace)
    case Con{+i, +_t36}:
      +kn = {J.nth(cb.gj(ctx, "knights"), i) : J.Val}
      hunt.step.if37(Bool.and(Bool.not(found), Bool.and(F32.is_eq(J.f32(J.nth(kn, 1)), J.f32(J.nth(lv, 0))), F32.is_eq(J.f32(J.nth(kn, 2)), J.f32(J.nth(lv, 1))))), enemy, ctx, shots, deeds, living, paces, _t34, lv, pace, found, _t36, i)

def hunt.step.loop34(+_xs: List<&2, J.Val>, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +living: J.Val, +paces: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _xs:
    case Nil{}:
      hunt.step.k7(enemy, ctx, shots, deeds, living, paces)
    case Con{+lv, +_t34}:
      +pace = {cb.of_pair(0.0, 0.0) : J.Val}
      +found = {False{} : Bool}
      hunt.step.loop36(cb.range(J.len(cb.gj(ctx, "knights"))), enemy, ctx, shots, deeds, living, paces, _t34, lv, pace, found)

def hunt.step.k6(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +living = {peasant.sights(cb.gw(ctx, "tick"), cb.gj(ctx, "scarecrows"), enemy, cb.gj(ctx, "knights"), cb.gj(ctx, "decoys")) : J.Val}
  +living = {minions.roared(cb.gj(ctx, "raised"), enemy, living) : J.Val}
  +paces = {J.JA{Nil{}} : J.Val}
  hunt.step.loop34(J.items(living), enemy, ctx, shots, deeds, living, paces)

def hunt.step.if39(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      (enemy, shots, deeds)
    case False{}:
      hunt.step.k6(enemy, ctx, shots, deeds)

def hunt.step.k5(+_t: Sigma<&2, &2, J.Val, _ => Bool>, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+enemy, +still) = _t
  hunt.step.if39(still, enemy, ctx, shots, deeds)

def hunt.step.k4(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  hunt.step.k5(press.held(enemy), ctx, shots, deeds)

def hunt.step.if40(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      (enemy, shots, deeds)
    case False{}:
      hunt.step.k4(enemy, ctx, shots, deeds)

def hunt.step.k3(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  hunt.step.if40(monsters.Enemy.asleep(enemy, cb.gw(ctx, "tick")), enemy, ctx, shots, deeds)

def hunt.step.if41(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +enemy = {cb.su(enemy, "age", RS.u_sat_add(cb.gu(enemy, "age"), 1)) : J.Val}
