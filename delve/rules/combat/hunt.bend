def hunt.step.k1(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  hunt.step.if42(cb.gb(ctx, "holding"), enemy, ctx, shots, deeds)

def hunt.step.if43(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      (enemy, shots, deeds)
    case False{}:
      hunt.step.k1(enemy, ctx, shots, deeds)

def hunt.out_of(+x0: F32, +y0: F32, +x1: F32, +y1: F32, +x: F32, +y: F32) -> F32:
  (RS.f_max((x0 - x : F32), 0.0) + RS.f_max((x - x1 : F32), 0.0) + RS.f_max((y0 - y : F32), 0.0) + RS.f_max((y - y1 : F32), 0.0) : F32)
