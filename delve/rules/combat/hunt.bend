  match _c:
    case True{}:
      +enemy = {cb.sf(enemy, "x", fx) : J.Val}
      +enemy = {cb.sf(enemy, "y", fy) : J.Val}
      hunt.step.k16(enemy, shots, deeds)
    case False{}:
      hunt.step.k16(enemy, shots, deeds)

def hunt.step.if18(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val, +fx: F32, +fy: F32, +h: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +lr = {J.nth(cb.gj(ctx, "leashes"), h) : J.Val}
      +x0 = {J.f32(J.nth(lr, 0)) : F32}
      +y0 = {J.f32(J.nth(lr, 1)) : F32}
      +x1 = {J.f32(J.nth(lr, 2)) : F32}
      +y1 = {J.f32(J.nth(lr, 3)) : F32}
      +now = {hunt.out_of(x0, y0, x1, y1, cb.gf(enemy, "x"), cb.gf(enemy, "y")) : F32}
      +was = {hunt.out_of(x0, y0, x1, y1, fx, fy) : F32}
      hunt.step.if19((now > was : F32), enemy, shots, deeds, fx, fy)
    case False{}:
      hunt.step.k16(enemy, shots, deeds)

