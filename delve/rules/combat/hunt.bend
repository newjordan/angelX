# One foe's turn. Answers (enemy, shots, deeds).

def hunt.step(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +enemy = {cb.sj(enemy, "signature", cb.sb(cb.gj(enemy, "signature"), "lingering", Bool.and(U32.is_ne(cb.gu(cb.gj(enemy, "signature"), "blow"), 0), hunt.has_blow(cb.gj(ctx, "lingering"), cb.gu(cb.gj(enemy, "signature"), "blow"))))) : J.Val}
  hunt.step.if43(U32.is_eq(cb.gu(enemy, "hp"), 0), enemy, ctx, shots, deeds)

