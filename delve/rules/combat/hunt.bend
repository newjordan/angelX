import Base

# Is this knight there to be hunted: standing, not fled, not aloft?

def peasant.Hero.targetable(+hero: J.Val) -> Bool:
  Bool.and(Bool.and(U32.is_gt(cb.gu(hero, "hp"), 0), Bool.not(cb.gb(hero, "stone"))), Bool.and(U32.is_eq(cb.gu(hero, "flee_ticks"), 0), Bool.not(cb.gb(hero, "aloft"))))

# runes.rs: this knight carries an Invisibility rune.

def runes.Hero.invisible(+hero: J.Val) -> Bool:
  Bool.and(String.eq(J.str(J.get(cb.gj(hero, "rune"), "kind")), "invisibility"), U32.is_gt(J.u32(J.get(cb.gj(hero, "rune"), "left")), 0))

