def hunt.step.k2(+enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  hunt.step.if41(cb.gb(enemy, "dormant"), enemy, ctx, shots, deeds)

def hunt.step.if42(_c: Bool, +enemy: J.Val, +ctx: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
