def case.patterns.volley(input: J.Val) -> J.Val:
  (enemy: Enemy, shots: J.Val) = patterns.volley(J.get(input, "enemy"), J.get(input, "knights"), J.get(input, "paces"), cb.gs(input, "pack"), cb.gu(input, "depth"), cb.gu(input, "heads"), J.get(input, "room"), cb.gb(input, "barred"), cb.gw(input, "seed"), J.get(input, "bosses"), J.get(input, "shots"))
  o: J.Val = J.obj()
  o = J.set(o, "enemy", enemy)
  J.set(o, "shots", shots)

def case.press.held(input: J.Val) -> J.Val:
  (enemy: Enemy, held: Bool) = press.held(J.get(input, "enemy"))
  o: J.Val = J.obj()
  o = J.set(o, "enemy", enemy)
  J.set(o, "held", J.of_bool(held))

def case.press.sights(input: J.Val) -> J.Val:
  press.sights(J.get(input, "enemy"), J.get(input, "knights"), J.get(input, "images"))

def case.critters.quicken(input: J.Val) -> J.Val:
  critters.quicken(J.get(input, "enemy"), cb.gf(input, "fx"), cb.gf(input, "fy"), J.get(input, "room"), cb.gb(input, "barred"))
