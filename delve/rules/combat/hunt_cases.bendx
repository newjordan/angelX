# Cases recorded from the Rust original (tests/rules/hunt_bend_cases__tests.rs).
import Base

def cb.leaf_out(enemy: Enemy, shots: J.Val, deeds: Deeds, done: Bool) -> J.Val:
  o: J.Val = J.obj()
  o = J.set(o, "enemy", enemy)
  o = J.set(o, "shots", shots)
  o = J.set(o, "deeds", deeds)
  J.set(o, "done", J.of_bool(done))

def case.hunt.Run.foes_turn(input: J.Val) -> J.Val:
  &(run: J.Val, sortie: J.Val, deeds: J.Val) = hunt.Run.foes_turn(J.get(input, "run"), J.get(input, "sortie"))
  o: J.Val = J.obj()
  o = J.set(o, "run", J.set(J.obj(), "enemies", J.get(run, "enemies")))
  o = J.set(o, "sortie", J.set(J.obj(), "shots", J.get(sortie, "shots")))
  J.set(o, "deeds", deeds)

def case.monsters.act(input: J.Val) -> J.Val:
  (enemy: Enemy, shots: J.Val, deeds: Deeds) = monsters.act(J.get(input, "enemy"), J.get(input, "heroes"), J.get(input, "room"), cb.gb(input, "barred"), cb.gw(input, "seed"), J.get(input, "bosses"), J.get(input, "shots"), foes.Deeds.default())
  o: J.Val = J.obj()
  o = J.set(o, "enemy", enemy)
  o = J.set(o, "shots", shots)
  J.set(o, "deeds", deeds)

def case.foes.act(input: J.Val) -> J.Val:
  (enemy: Enemy, shots: J.Val, deeds: Deeds, done: Bool) = foes.act(J.get(input, "enemy"), J.get(input, "heroes"), J.get(input, "room"), cb.gb(input, "barred"), cb.gw(input, "seed"), J.get(input, "shots"), foes.Deeds.default())
  cb.leaf_out(enemy, shots, deeds, done)

