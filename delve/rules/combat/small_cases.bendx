# Cases recorded from the Rust original (tests/rules/cover_bend_cases__tests.rs).
import Base

def case.monsters.EnemyKind.radius(input: J.Val) -> J.Val:
  J.of_f32(monsters.EnemyKind.radius(cb.gs(input, "k")))

def case.monsters.EnemyKind.hp(input: J.Val) -> J.Val:
  J.of_u32(monsters.EnemyKind.hp(cb.gs(input, "k")))

def case.monsters.EnemyKind.elite(input: J.Val) -> J.Val:
  J.of_bool(monsters.EnemyKind.elite(cb.gs(input, "k")))

def case.monsters.EnemyKind.flies(input: J.Val) -> J.Val:
  J.of_bool(monsters.EnemyKind.flies(cb.gs(input, "k")))

def case.monsters.EnemyKind.bounty(input: J.Val) -> J.Val:
  J.of_u32(monsters.EnemyKind.bounty(cb.gs(input, "k")))

def case.loot.drop_chance(input: J.Val) -> J.Val:
  J.of_u32(loot.drop_chance(cb.gs(input, "k")))

def case.loot.spoil_chance(input: J.Val) -> J.Val:
  J.of_u32(loot.spoil_chance(cb.gs(input, "k")))

def case.critters.EnemyKind.critter(input: J.Val) -> J.Val:
  J.of_bool(critters.EnemyKind.critter(cb.gs(input, "k")))

def case.pacing.camp_foes(input: J.Val) -> J.Val:
  J.of_u32(pacing.camp_foes(cb.gu(input, "depth"), cb.gu(input, "doors")))

def case.cover.counted(input: J.Val) -> J.Val:
  J.of_bool(cover.counted(input))

def case.cover.area(input: J.Val) -> J.Val:
  J.of_f32(cover.area(input))

def case.cover.view(input: J.Val) -> J.Val:
  J.of_f32(cover.view(J.get(input, "room")))

def case.cover.covered(input: J.Val) -> J.Val:
  J.of_f32(cover.covered(J.get(input, "shots"), cb.gf(input, "view")))

def case.cover.hold(input: J.Val) -> J.Val:
  (shots: J.Val, retired: U32) = cover.hold(J.get(input, "shots"), cb.gf(input, "view"))
  J.set(J.set(J.obj(), "shots", shots), "retired", J.of_u32(retired))

def case.cover.retire(input: J.Val) -> J.Val:
  (shots: J.Val, retired: U32) = cover.retire(J.get(input, "shots"), cb.gf(input, "view"), cb.gf(input, "share"))
  J.set(J.set(J.obj(), "shots", shots), "retired", J.of_u32(retired))

def case.bosses.Boss.stage(input: J.Val) -> J.Val:
  J.of_str(bosses.Boss.stage(J.get(input, "boss"), cb.gu(input, "hp"), cb.gu(input, "max_hp")))

def case.bosses.Bolt.shot(input: J.Val) -> J.Val:
  J.of_str(bosses.Bolt.shot(cb.gs(input, "bolt"), cb.gs(input, "pack")))

def case.bosses.Stage.per_second(input: J.Val) -> J.Val:
  J.of_u32(bosses.Stage.per_second(cb.gs(input, "s")))

def case.bosses.Stage.on_screen(input: J.Val) -> J.Val:
  J.of_u32(bosses.Stage.on_screen(cb.gs(input, "s")))

def case.signatures.shooting(input: J.Val) -> J.Val:
  J.of_bool(signatures.shooting(J.get(input, "enemy"), J.get(input, "boss"), cb.gb(input, "wanted")))

def case.signatures.due(input: J.Val) -> J.Val:
  match (signatures.due(J.get(input, "enemy"), J.get(input, "boss"), cb.gs(input, "stage")) : U32?):
    case Some{k: U32}:
      return J.of_u32(k)
    case None{}:
      return J.JNull{}

def case.signatures.hold(input: J.Val) -> J.Val:
  (enemy: Enemy, shots: J.Val) = signatures.hold(J.get(input, "enemy"), J.get(input, "boss"), J.get(input, "shots"), cb.gu(input, "from"), J.get(input, "bursts"), cb.gu(input, "standing"), cb.gu(input, "heads"))
  J.set(J.set(J.obj(), "enemy", enemy), "shots", shots)
