# crates/delve/src/rules/foes.rs: the second company's steps (sappers,
# necromancers, warboars, slimes, hobs, shamans, wards, and the rest), and what
# they make as Deeds. A Deeds is an object of arrays (foes::Deeds), a tuple one
# array, a position [x, y].
import Base

# Walk `(dx, dy)` at `speed` a second with wall sliding; answers the distance moved.
def foes.walk(enemy: Enemy, room: Room, barred: Bool, mover: U32, r: F32, dx: F32, dy: F32, speed: F32) -> (Enemy, F32):
  &(x: F32, y: F32) = rules.Grid.slide(room, barred, (enemy.x, enemy.y), ((dx * speed * rules.DT() : F32), (dy * speed * rules.DT() : F32)), r, mover)
  moved: F32 = cb.hyp((x - enemy.x : F32), (y - enemy.y : F32))
  enemy.x = x
  enemy.y = y
  (enemy, moved)

# Keep between `near` and `far` of the nearest knight, sidling between.
def foes.keep_off(enemy: Enemy, room: Room, barred: Bool, mover: U32, r: F32, dist: F32, cx: F32, cy: F32, near: F32, far: F32, speed: F32) -> Enemy:
  side: F32 = Bool.pick(F32, U32.is_eq(U32.mod(enemy.id, 2), 0), 1.0, F32.neg(1.0))
  wx: F32 = (RS.f_neg(cy) * side : F32)
  wy: F32 = (cx * side : F32)
  if (dist < near : F32):
    wx = RS.f_neg(cx)
    wy = RS.f_neg(cy)
  elif (dist > far : F32):
    wx = cx
    wy = cy
  (e2: Enemy, moved: F32) = foes.walk(enemy, room, barred, mover, r, wx, wy, speed)
  e2

def foes.joined(kind: String) -> Bool:
  Bool.or(Bool.or(Bool.or(String.eq(kind, "sapper"), String.eq(kind, "necromancer")), Bool.or(String.eq(kind, "warboar"), String.eq(kind, "slime"))),
    Bool.or(Bool.or(Bool.or(String.eq(kind, "goblin"), String.eq(kind, "hob")), Bool.or(String.eq(kind, "shaman"), String.eq(kind, "ward"))),
      Bool.or(Bool.or(String.eq(kind, "risen"), String.eq(kind, "broodmarrow")), Bool.or(String.eq(kind, "oathbound"), String.eq(kind, "whirlgrave")))))

def foes.spawn(deeds: Deeds, kind: String, x: F32, y: F32, stage: U32) -> Deeds:
  deeds.spawns = J.push(deeds.spawns, J.JA{[J.JS{kind}, J.of_f32(x), J.of_f32(y), J.of_u32(stage)]})
  deeds

def foes.cue(deeds: Deeds, cue: String) -> Deeds:
  deeds.cues = J.push(deeds.cues, J.JS{cue})
  deeds

def foes.ram(deeds: Deeds, x: F32, y: F32, reach: F32, damage: U32, dx: F32, dy: F32) -> Deeds:
  deeds.rams = J.push(deeds.rams, J.JA{[J.of_f32(x), J.of_f32(y), J.of_f32(reach), J.of_u32(damage), cb.of_pair(dx, dy)]})
  deeds

# One of the second company's steps. False for any other monster. Answers
# (enemy, shots, deeds, handled).
def foes.act(enemy: Enemy, heroes: J.Val, room: Room, barred: Bool, seed: W.W, shots: J.Val, deeds: Deeds) -> (Enemy, J.Val, Deeds, Bool):
  kind: String = enemy.kind
  if Bool.not(foes.joined(kind)):
    return (enemy, shots, deeds, False{})
  target: (F32, F32)? = cb.nearest2(heroes, enemy.x, enemy.y)
  seen: Bool = Maybe.is_some(&2, Sigma<&2, &2, F32, _ => F32>, target)
  tx: F32 = enemy.x
  ty: F32 = (enemy.y + 1.0 : F32)
  match (target : (F32, F32)?):
    case Some{t: (F32, F32)}:
      (tx, ty) = t
    case None{}:
      tx = tx
  &(cx: F32, cy: F32) = rules.unit((tx - enemy.x : F32), (ty - enemy.y : F32))
  dist: F32 = cb.hyp((tx - enemy.x : F32), (ty - enemy.y : F32))
  aim: F32 = RS.f_atan2((ty - enemy.y : F32), (tx - enemy.x : F32))
  mover: U32 = foes.mover(kind)
  r: F32 = monsters.Enemy.radius(enemy)
  enemy.timer = (enemy.timer + 1 : U32)
  beat: U32 = (enemy.timer + enemy.id * 7 : U32)
  if String.eq(kind, "sapper"):
    if U32.is_eq(enemy.stage, 0):
      # Close in to a few steps off, plant, then run.
      gx: F32 = (tx - cx * 5.5 : F32)
      gy: F32 = (ty - cy * 5.5 : F32)
      &(ux: F32, uy: F32) = rules.unit((gx - enemy.x : F32), (gy - enemy.y : F32))
      if (cb.hyp((gx - enemy.x : F32), (gy - enemy.y : F32)) > 0.5 : F32):
        (enemy, mv: F32) = foes.walk(enemy, room, barred, mover, r, ux, uy, 5.0)
      if Bool.and(Bool.and(U32.is_ge(enemy.timer, (100 + U32.mod(enemy.id, 5) * 9 : U32)), seen), (dist < 7.5 : F32)):
        deeds.kegs = J.push(deeds.kegs, cb.of_pair(enemy.x, enemy.y))
        enemy.stage = 1
        enemy.timer = 0
    else:
      (enemy, mv: F32) = foes.walk(enemy, room, barred, mover, r, RS.f_neg(cx), RS.f_neg(cy), 6.5)
      if U32.is_ge(enemy.timer, 40):
        enemy.stage = 0
        enemy.timer = 0
  elif String.eq(kind, "necromancer"):
    enemy = foes.keep_off(enemy, room, barred, mover, r, dist, cx, cy, 8.0, 12.0, 2.0)
    # Bones for three raisings; then only its orbs.
    if Bool.and(U32.is_eq(U32.mod(beat, 150), 60), U32.is_lt(enemy.stage, foes.NECRO_RAISES())):
      enemy.stage = (enemy.stage + 1 : U32)
      deeds = foes.spawn(deeds, "skeleton", (enemy.x + F32.neg(1.0) * 2.2 : F32), (enemy.y + 1.2 : F32), 0)
      deeds = foes.spawn(deeds, "skeleton", (enemy.x + 1.0 * 2.2 : F32), (enemy.y + 1.2 : F32), 0)
      deeds = foes.cue(deeds, "necro_raise")
  elif String.eq(kind, "warboar"):
    if U32.is_eq(enemy.stage, 0):
      (enemy, mv: F32) = foes.walk(enemy, room, barred, mover, r, cx, cy, 2.6)
      if Bool.and(Bool.and(U32.is_ge(enemy.timer, 60), seen), (dist < 18.0 : F32)):
        enemy.stage = 1
        enemy.timer = 0
        enemy.dir = (cx, cy)
    elif U32.is_eq(enemy.stage, 1):
      if U32.is_ge(enemy.timer, foes.BOAR_WINDUP()):
        enemy.stage = 2
        enemy.timer = 0
    elif U32.is_eq(enemy.stage, 2):
      (ddx: F32, ddy: F32) = enemy.dir
      (enemy, moved: F32) = foes.walk(enemy, room, barred, mover, r, ddx, ddy, foes.BOAR_SPEED())
      deeds = foes.ram(deeds, enemy.x, enemy.y, (r + 0.7 : F32), 24, ddx, ddy)
      if (moved < (foes.BOAR_SPEED() * rules.DT() * 0.3 : F32) : F32):
        enemy.stage = 3
        enemy.timer = 0
        deeds = foes.cue(deeds, "boar_dazed")
      elif U32.is_gt(enemy.timer, 45):
        enemy.stage = 0
        enemy.timer = 0
    else:
      if U32.is_ge(enemy.timer, 50):
        enemy.stage = 0
        enemy.timer = 0
  elif Bool.and(String.eq(kind, "slime"), U32.is_lt(U32.mod(enemy.age, 40), 12)):
    # Hops: a lunge, a squat.
    (enemy, mv: F32) = foes.walk(enemy, room, barred, mover, r, cx, cy, (6.0 - cb.f(enemy.stage) : F32))
  elif String.eq(kind, "risen"):
    # Humphrey: a lurching shamble, a rising wind-up, then the shove.
    if U32.is_eq(enemy.stage, 0):
      lurch: F32 = Bool.pick(F32, U32.is_lt(U32.mod(beat, 36), 22), 2.1, 0.9)
      (enemy, mv: F32) = foes.walk(enemy, room, barred, mover, r, cx, cy, lurch)
      enemy.dir = (cx, cy)
      if Bool.and(Bool.and(seen, (dist < 3.6 : F32)), U32.is_ge(enemy.timer, 24)):
        enemy.stage = 1
        enemy.timer = 0
    elif U32.is_eq(enemy.stage, 1):
      # Arms up, jaw loose: the party has a moment to step aside.
      enemy.dir = (cx, cy)
      if U32.is_ge(enemy.timer, 20):
        enemy.stage = 2
        enemy.timer = 0
        enemy.dir = (cx, cy)
        deeds = foes.cue(deeds, "risen_shove")
    elif U32.is_eq(enemy.stage, 2):
      (ddx: F32, ddy: F32) = enemy.dir
      (enemy, moved: F32) = foes.walk(enemy, room, barred, mover, r, ddx, ddy, 14.0)
      deeds = foes.ram(deeds, enemy.x, enemy.y, (r + 0.9 : F32), 12, ddx, ddy)
      if Bool.or((moved < (14.0 * rules.DT() * 0.3 : F32) : F32), U32.is_ge(enemy.timer, 12)):
        enemy.stage = 3
        enemy.timer = 0
    else:
      # Winded, hands on knees, deeply opposed to exercise.
      if U32.is_ge(enemy.timer, 36):
        enemy.stage = 0
        enemy.timer = 0
  elif String.eq(kind, "broodmarrow"):
    # A hill of hide that answers arrows with offspring.
    if U32.is_eq(enemy.stage, 0):
      enemy = foes.keep_off(enemy, room, barred, mover, r, dist, cx, cy, 4.5, 10.0, 1.6)
      if Bool.and(Bool.and(U32.is_ge(enemy.timer, 80), seen), (dist < 17.0 : F32)):
        enemy.stage = 1
        enemy.timer = 0
    elif U32.is_eq(enemy.stage, 1):
      if U32.is_ge(enemy.timer, foes.BROOD_WINDUP()):
        if U32.is_gt(enemy.hp, foes.BROOD_RIP()):
          enemy.hp = (enemy.hp - foes.BROOD_RIP() : U32)
          sx: F32 = (enemy.x + cx * r * 0.7 : F32)
          sy: F32 = (enemy.y + cy * r * 0.7 : F32)
          deeds.flings = J.push(deeds.flings, J.JA{[cb.of_pair(sx, sy), cb.of_pair(tx, ty)]})
          deeds = foes.cue(deeds, "brood_rip")
        enemy.stage = 2
        enemy.timer = 0
    else:
      if U32.is_ge(enemy.timer, foes.BROOD_REST()):
        enemy.stage = 0
        enemy.timer = 0
  elif String.eq(kind, "whirlgrave"):
    if U32.is_eq(enemy.stage, 0):
      enemy = foes.keep_off(enemy, room, barred, mover, r, dist, cx, cy, 7.0, 11.0, 1.9)
      if Bool.and(U32.is_eq(U32.mod(enemy.timer, 130), 60), seen):
        deeds.wells = J.push(deeds.wells, cb.of_pair(enemy.x, enemy.y))
        enemy.stage = 1
        enemy.timer = 0
    else:
      if U32.is_ge(enemy.timer, foes.WELL_SPAN()):
        enemy.stage = 0
        enemy.timer = 0
  elif String.eq(kind, "oathbound"):
    if U32.is_eq(enemy.stage, 0):
      enemy = foes.keep_off(enemy, room, barred, mover, r, dist, cx, cy, 2.0, 8.0, 2.4)
    else:
      enemy = foes.keep_off(enemy, room, barred, mover, r, dist, cx, cy, 2.0, 8.0, 4.2)
      if Bool.and(Bool.and(U32.is_eq(U32.mod(enemy.timer, 70), 40), seen), (dist < 5.0 : F32)):
        deeds = foes.ram(deeds, enemy.x, enemy.y, (r + 0.9 : F32), 10, cx, cy)
  elif String.eq(kind, "hob"):
    h: W.W = cb.wander_mix(seed, enemy.id, (enemy.age / 75 : U32))
    gx: F32 = (enemy.origin_x + (cb.byte0(h) - 0.5 : F32) * 10.0 : F32)
    gy: F32 = (enemy.origin_y + (cb.byte1(h) - 0.5 : F32) * 7.0 : F32)
    &(ux: F32, uy: F32) = rules.unit((gx - enemy.x : F32), (gy - enemy.y : F32))
    (enemy, mv: F32) = foes.walk(enemy, room, barred, mover, r, ux, uy, 2.4)
    if Bool.and(Bool.and(U32.is_eq(U32.mod(beat, 95), 40), seen), (dist < 20.0 : F32)):
      deeds.lobs = J.push(deeds.lobs, J.JA{[cb.of_pair(enemy.x, enemy.y), cb.of_pair(tx, ty)]})
  elif String.eq(kind, "shaman"):
    enemy = foes.keep_off(enemy, room, barred, mover, r, dist, cx, cy, 9.0, 13.0, 2.2)
    if Bool.and(Bool.and(U32.is_eq(U32.mod(beat, 180), 90), seen), (dist < 15.0 : F32)):
      deeds = foes.spawn(deeds, "ward", (tx + F32.neg(1.0) * 3.2 : F32), (ty + F32.neg(1.0) * 3.2 : F32), 0)
      deeds = foes.spawn(deeds, "ward", (tx + 1.0 * 3.2 : F32), (ty + F32.neg(1.0) * 3.2 : F32), 0)
      deeds = foes.spawn(deeds, "ward", (tx + F32.neg(1.0) * 3.2 : F32), (ty + 1.0 * 3.2 : F32), 0)
      deeds = foes.spawn(deeds, "ward", (tx + 1.0 * 3.2 : F32), (ty + 1.0 * 3.2 : F32), 0)
      deeds = foes.cue(deeds, "shaman_wards")
  elif String.eq(kind, "ward"):
    if Bool.and(U32.is_eq(U32.mod(beat, 40), 0), seen):
      shots = foes.fire(shots, enemy.x, enemy.y, aim, 8.0, "orb", 8)
    if U32.is_ge(enemy.timer, foes.WARD_STANDS()):
      enemy.hp = 0
  (enemy, shots, deeds, True{})
