def signatures.special(+boss: J.Val) -> Bool:
  Bool.or(String.eq(cb.gs(boss, "id"), signatures.RIPPER()), String.eq(cb.gs(boss, "id"), signatures.ENGINE()))

# It may shoot this tick: not mid-signature, nor winding up or spent after a
# charge-up (an outlaw keeps its own stages).

def signatures.shooting(+enemy: J.Val, +boss: J.Val, +wanted: Bool) -> Bool:
