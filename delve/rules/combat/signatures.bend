      +kept = {volley : U32}
      signatures.hold.k3(enemy, shots, bursts, standing, room, kept)

def signatures.hold.if7(_c: Bool, +enemy: J.Val, +shots: J.Val, +from: U32, +bursts: J.Val, +standing: U32, +room: U32, +reserve: U32, +volley: U32, +spent: U32, +kept: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
