def signatures.hold.loop9(+_xs: List<&2, U32>, +enemy: J.Val, +shots: J.Val, +from: U32, +bursts: J.Val, +standing: U32, +room: U32, +reserve: U32, +volley: U32, +start: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
