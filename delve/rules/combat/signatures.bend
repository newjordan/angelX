  +per_second = {bosses.Stage.per_second(stage) : U32}
  +on_screen = {bosses.Stage.on_screen(stage) : U32}
  +room = {(on_screen * RS.u_max(heads, 1) : U32) : U32}
  +enemy = {cb.sj(enemy, "signature", cb.su(cb.gj(enemy, "signature"), "spent", RS.u_sat_sub(cb.gu(cb.gj(enemy, "signature"), "spent"), per_second))) : J.Val}
  +reserve = {0 : U32}
  signatures.hold.m10(signatures.due(enemy, boss, stage), enemy, boss, shots, from, bursts, standing, room, reserve)

