  +left = {RS.u_sat_sub(room, (standing + kept : U32)) : U32}
  signatures.hold.loop5(J.items(bursts), enemy, shots, left)

def signatures.hold.if8(_c: Bool, +enemy: J.Val, +shots: J.Val, +from: U32, +bursts: J.Val, +standing: U32, +room: U32, +volley: U32, +spent: U32, +kept: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +shots = {J.truncate(shots, from) : J.Val}
      +kept = {0 : U32}
