    case False{}:
      signatures.hold.loop5(_t5, enemy, shots, left)

def signatures.hold.loop5(+_xs: List<&2, J.Val>, +enemy: J.Val, +shots: J.Val, +left: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _xs:
    case Nil{}:
      signatures.hold.k4(enemy, shots)
    case Con{+shot, +_t5}:
      +w = {signatures.weight(shot) : U32}
      signatures.hold.if6(U32.is_le(w, left), enemy, shots, left, _t5, shot, w)

