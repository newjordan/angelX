  +fy = {cb.gf(enemy, "y") : F32}
  +stride = {(speed * rules.DT() / 4.0 : F32) : F32}
  +stopped = {False{} : Bool}
  signatures.dash_for.loop3(cb.range(4), enemy, room, barred, bounce, damage, blow, deeds, fx, fy, stride, stopped)

