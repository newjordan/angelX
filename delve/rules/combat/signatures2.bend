# What a guardian's charge-up strikes with carries this tag.

def signatures.tag(+enemy: J.Val) -> U32:
  RS.u_max(U32.xor(RS.u_rotl(cb.gu(enemy, "id"), 16), cb.gu(cb.gj(enemy, "signature"), "cycle")), 1)

# Ticks a charged beam burns sweeping its arc at BEAM_TURN.

def signatures.beam_burn(+up: J.Val) -> U32:
  RS.f_as_u32(RS.f_clamp(F32.ceil((RS.f_abs(cb.gf(up, "arc")) / signatures.BEAM_TURN() * cb.f(rules.HZ()) : F32)), cb.f(patterns.SWEEP_BURN()), 255.0))

# A slam's clear lane, in degrees.

def signatures.slam_lane(+up: J.Val) -> F32:
  RS.f_max(cb.gf(up, "arc"), RS.f_to_degrees((signatures.SLAM_GAP() / tide.RING_GAP() : F32)))

