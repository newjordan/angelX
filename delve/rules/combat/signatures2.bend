  +r = {monsters.Enemy.radius(enemy) : F32}
  signatures.dash_for.if6(rules.Grid.clear(room, barred, nx, ny, r, 1), enemy, room, barred, bounce, damage, blow, deeds, fx, fy, stride, stopped, _t3, dx, dy, nx, ny, r)

def signatures.dash_for.if4(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +bounce: Bool, +damage: U32, +blow: U32, +deeds: J.Val, +fx: F32, +fy: F32, +stride: F32, +stopped: Bool, +_t3: List<&2, U32>) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      signatures.dash_for.k5(cb.gp(enemy, "dir"), enemy, room, barred, bounce, damage, blow, deeds, fx, fy, stride, stopped, _t3)
    case False{}:
      signatures.dash_for.loop3(_t3, enemy, room, barred, bounce, damage, blow, deeds, fx, fy, stride, stopped)

def signatures.dash_for.loop3(+_xs: List<&2, U32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +bounce: Bool, +damage: U32, +blow: U32, +deeds: J.Val, +fx: F32, +fy: F32, +stride: F32, +stopped: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _xs:
    case Nil{}:
      signatures.dash_for.k1(enemy, damage, blow, deeds, fx, fy, stopped)
    case Con{+i, +_t3}:
      signatures.dash_for.if4(Bool.not(stopped), enemy, room, barred, bounce, damage, blow, deeds, fx, fy, stride, stopped, _t3)

# The nearest of `heroes` to the guardian.

def signatures.nearest(+enemy: J.Val, +heroes: J.Val) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  cb.nearest2(heroes, cb.gf(enemy, "x"), cb.gf(enemy, "y"))

# The clear spot nearest `to` where the guardian fits, if any near.

def signatures.clear_near(+enemy: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  +best = {None{} : Maybe<&2, Sigma<&2, &2, F32, _ => F32>>}
  +bd = {0 : U32}
  signatures.clear_near.loop2(cb.range(17), enemy, room, barred, tx, ty, best, bd)

def signatures.clear_near.k1(+best: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  best

def signatures.clear_near.if6(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32, +best: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +bd: U32, +_t2: List<&2, U32>, +dy0: U32, +_t3: List<&2, U32>, +sx: F32, +sy: F32, +d: U32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  match _c:
    case True{}:
      +best = {Some{(sx, sy)} : Maybe<&2, Sigma<&2, &2, F32, _ => F32>>}
      +bd = {d : U32}
      signatures.clear_near.loop3(_t3, enemy, room, barred, tx, ty, best, bd, _t2, dy0)
    case False{}:
      signatures.clear_near.loop3(_t3, enemy, room, barred, tx, ty, best, bd, _t2, dy0)

def signatures.clear_near.m5(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +enemy: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32, +best: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +bd: U32, +_t2: List<&2, U32>, +dy0: U32, +_t3: List<&2, U32>, +sx: F32, +sy: F32, +d: U32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  match _s:
    case None{}:
      +best = {Some{(sx, sy)} : Maybe<&2, Sigma<&2, &2, F32, _ => F32>>}
      +bd = {d : U32}
      signatures.clear_near.loop3(_t3, enemy, room, barred, tx, ty, best, bd, _t2, dy0)
    case Some{+b}:
      signatures.clear_near.if6(U32.is_lt(d, bd), enemy, room, barred, tx, ty, best, bd, _t2, dy0, _t3, sx, sy, d)

def signatures.clear_near.if4(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32, +best: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +bd: U32, +_t2: List<&2, U32>, +dy0: U32, +_t3: List<&2, U32>, +dx: U32, +dy: U32, +sx: F32, +sy: F32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  match _c:
    case True{}:
      +d = {(RS.i_mul(dx, dx) + RS.i_mul(dy, dy) : U32) : U32}
      signatures.clear_near.m5(best, enemy, room, barred, tx, ty, best, bd, _t2, dy0, _t3, sx, sy, d)
    case False{}:
      signatures.clear_near.loop3(_t3, enemy, room, barred, tx, ty, best, bd, _t2, dy0)

def signatures.clear_near.loop3(+_xs: List<&2, U32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32, +best: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +bd: U32, +_t2: List<&2, U32>, +dy0: U32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  match _xs:
    case Nil{}:
      signatures.clear_near.loop2(_t2, enemy, room, barred, tx, ty, best, bd)
    case Con{+dx0, +_t3}:
      +dx = {RS.i_sub(dx0, 8) : U32}
      +dy = {RS.i_sub(dy0, 8) : U32}
      +sx = {(tx + RS.i_as_f32(dx) * 0.5 : F32) : F32}
      +sy = {(ty + RS.i_as_f32(dy) * 0.5 : F32) : F32}
      signatures.clear_near.if4(rules.Grid.clear(room, barred, sx, sy, monsters.Enemy.radius(enemy), 1), enemy, room, barred, tx, ty, best, bd, _t2, dy0, _t3, dx, dy, sx, sy)

def signatures.clear_near.loop2(+_xs: List<&2, U32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32, +best: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +bd: U32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  match _xs:
    case Nil{}:
      signatures.clear_near.k1(best)
    case Con{+dy0, +_t2}:
      signatures.clear_near.loop3(cb.range(17), enemy, room, barred, tx, ty, best, bd, _t2, dy0)

# What a guardian's charge-up shows when it begins.

def signatures.begin(+enemy: J.Val, +boss: J.Val, +up: J.Val, +target: Sigma<&2, &2, F32, _ => F32>, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +fx = {cb.gf(enemy, "x") : F32}
  +fy = {cb.gf(enemy, "y") : F32}
  signatures.begin.k1(target, enemy, boss, up, room, barred, seed, deeds, fx, fy)

def signatures.begin.k3(+enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (enemy, deeds)

def signatures.begin.k5(+enemy: J.Val, +deeds: J.Val, +fx: F32, +fy: F32, +bdx: F32, +bdy: F32, +bbx: F32, +bby: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +enemy = {cb.sp2(enemy, "dir", (bdx, bdy)) : J.Val}
  +rail = {J.obj() : J.Val}
  +rail = {cb.sp2(rail, "a", (fx, fy)) : J.Val}
  +rail = {cb.sp2(rail, "b", (bbx, bby)) : J.Val}
  +enemy = {cb.sj(enemy, "signature", cb.sj(cb.gj(enemy, "signature"), "rails", J.JA{[rail]})) : J.Val}
  signatures.begin.k3(enemy, deeds)

def signatures.begin.k8(+enemy: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +fx: F32, +fy: F32, +aim: F32, +bests: F32, +bdx: F32, +bdy: F32, +bbx: F32, +bby: F32, +k: U32, +have: Bool, +_t6: List<&2, F32>) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +k = {(k + 1 : U32) : U32}
  signatures.begin.loop6(_t6, enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have)

def signatures.begin.if9(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +fx: F32, +fy: F32, +aim: F32, +bests: F32, +bdx: F32, +bdy: F32, +bbx: F32, +bby: F32, +k: U32, +have: Bool, +_t6: List<&2, F32>, +dx: F32, +dy: F32, +bx: F32, +by: F32, +score: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +have = {True{} : Bool}
      +bests = {score : F32}
      +bdx = {dx : F32}
      +bdy = {dy : F32}
      +bbx = {bx : F32}
      +bby = {by : F32}
      signatures.begin.k8(enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have, _t6)
    case False{}:
      signatures.begin.k8(enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have, _t6)

def signatures.begin.k7(+enemy: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +fx: F32, +fy: F32, +aim: F32, +bests: F32, +bdx: F32, +bdy: F32, +bbx: F32, +bby: F32, +k: U32, +have: Bool, +_t6: List<&2, F32>, +dx: F32, +dy: F32, +bx: F32, +by: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +reach = {cb.hyp((bx - fx : F32), (by - fy : F32)) : F32}
  +score = {(RS.f_min(reach, signatures.LANE_LEAST()) * 10.0 - cb.f(k) : F32) : F32}
  signatures.begin.if9(Bool.or(Bool.not(have), (score >= bests : F32)), enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have, _t6, dx, dy, bx, by, score)

def signatures.begin.if12(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +fx: F32, +fy: F32, +aim: F32, +bests: F32, +bdx: F32, +bdy: F32, +bbx: F32, +bby: F32, +k: U32, +have: Bool, +_t6: List<&2, F32>, +dx: F32, +dy: F32, +bx: F32, +by: F32, +open: Bool, +_t10: List<&2, U32>, +px: F32, +py: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +bx = {px : F32}
      +by = {py : F32}
      signatures.begin.loop10(_t10, enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have, _t6, dx, dy, bx, by, open)
    case False{}:
      +open = {False{} : Bool}
      signatures.begin.loop10(_t10, enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have, _t6, dx, dy, bx, by, open)

def signatures.begin.if11(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +fx: F32, +fy: F32, +aim: F32, +bests: F32, +bdx: F32, +bdy: F32, +bbx: F32, +bby: F32, +k: U32, +have: Bool, +_t6: List<&2, F32>, +dx: F32, +dy: F32, +bx: F32, +by: F32, +open: Bool, +_t10: List<&2, U32>, +n0: U32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +n = {cb.f((n0 + 1 : U32)) : F32}
      +px = {(fx + dx * n * 0.5 : F32) : F32}
      +py = {(fy + dy * n * 0.5 : F32) : F32}
      signatures.begin.if12(rules.Grid.clear(room, barred, px, py, monsters.Enemy.radius(enemy), 1), enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have, _t6, dx, dy, bx, by, open, _t10, px, py)
    case False{}:
      signatures.begin.loop10(_t10, enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have, _t6, dx, dy, bx, by, open)

def signatures.begin.loop10(+_xs: List<&2, U32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +fx: F32, +fy: F32, +aim: F32, +bests: F32, +bdx: F32, +bdy: F32, +bbx: F32, +bby: F32, +k: U32, +have: Bool, +_t6: List<&2, F32>, +dx: F32, +dy: F32, +bx: F32, +by: F32, +open: Bool) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _xs:
    case Nil{}:
      signatures.begin.k7(enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have, _t6, dx, dy, bx, by)
    case Con{+n0, +_t10}:
      signatures.begin.if11(open, enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have, _t6, dx, dy, bx, by, open, _t10, n0)

def signatures.begin.loop6(+_xs: List<&2, F32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +fx: F32, +fy: F32, +aim: F32, +bests: F32, +bdx: F32, +bdy: F32, +bbx: F32, +bby: F32, +k: U32, +have: Bool) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _xs:
    case Nil{}:
      signatures.begin.k5(enemy, deeds, fx, fy, bdx, bdy, bbx, bby)
    case Con{+turn, +_t6}:
      +angle = {(aim + turn : F32) : F32}
      +dx = {F32.cos(angle) : F32}
      +dy = {F32.sin(angle) : F32}
      +bx = {fx : F32}
      +by = {fy : F32}
      +open = {True{} : Bool}
      signatures.begin.loop10(cb.range(60), enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have, _t6, dx, dy, bx, by, open)

def signatures.begin.m16(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +enemy: J.Val, +deeds: J.Val, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _s:
    case Some{+spot}:
      +enemy = {cb.sj(enemy, "signature", cb.sp2(cb.gj(enemy, "signature"), "mark", spot)) : J.Val}
      signatures.begin.k3(enemy, deeds)
    case None{}:
      +enemy = {cb.sj(enemy, "signature", cb.sp2(cb.gj(enemy, "signature"), "mark", (fx, fy))) : J.Val}
      signatures.begin.k3(enemy, deeds)

def signatures.begin.if15(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +fx: F32, +fy: F32, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +enemy = {cb.sj(enemy, "signature", cb.sp2(cb.gj(enemy, "signature"), "jump_from", (fx, fy))) : J.Val}
      +enemy = {cb.sj(enemy, "signature", cb.sp2(cb.gj(enemy, "signature"), "mark", (fx, fy))) : J.Val}
      signatures.begin.m16(signatures.clear_near(enemy, room, barred, tx, ty), enemy, deeds, fx, fy)
    case False{}:
      signatures.begin.k3(enemy, deeds)

def signatures.begin.if14(_c: Bool, +enemy: J.Val, +boss: J.Val, +up: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +ux: F32, +uy: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +arc = {RS.f_to_radians(cb.gf(up, "arc")) : F32}
      +way = {Bool.pick(F32, U32.is_eq(U32.mod(cb.gu(cb.gj(enemy, "signature"), "cycle"), 2), 0), 1.0, F32.neg(1.0)) : F32}
      +aim = {RS.f_atan2(uy, ux) : F32}
      +beam = {patterns.charged_beam(room, barred, (fx, fy), (aim - arc / 2.0 * way : F32), (arc * way : F32), RS.u_min(cb.gu(up, "wind"), 255), signatures.beam_burn(up), bosses.Bolt.shot(cb.gs(up, "bolt"), cb.gs(boss, "only_in")), cb.gu(up, "damage")) : J.Val}
      +beam = {cb.sj(beam, "traits", cb.su0(cb.gj(beam, "traits"), "blow", cb.gu(cb.gj(enemy, "signature"), "blow"))) : J.Val}
      +deeds = {cb.sj(deeds, "bursts", J.push(cb.gj(deeds, "bursts"), beam)) : J.Val}
      signatures.begin.k3(enemy, deeds)
    case False{}:
      signatures.begin.if15(String.eq(cb.gs(up, "kind"), "leap"), enemy, room, barred, deeds, fx, fy, tx, ty)

def signatures.begin.if13(_c: Bool, +enemy: J.Val, +boss: J.Val, +up: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +ux: F32, +uy: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +beat = {W.xor(W.xor(seed, W.shl(W.of_u32(cb.gu(enemy, "id")), 16)), W.of_u32(cb.gu(cb.gj(enemy, "signature"), "cycle"))) : W.W}
      +slam = {tide.Ravage.cast(fx, fy, cb.gu(up, "shots"), signatures.slam_lane(up), cb.gf(up, "speed"), cb.gu(up, "damage"), beat) : J.Val}
      +slam = {cb.su0(slam, "blow", cb.gu(cb.gj(enemy, "signature"), "blow")) : J.Val}
      +deeds = {cb.sj(deeds, "ravages", J.push(cb.gj(deeds, "ravages"), slam)) : J.Val}
      +deeds = {foes.cue(deeds, "ravage") : J.Val}
      signatures.begin.k3(enemy, deeds)
    case False{}:
      signatures.begin.if14(String.eq(cb.gs(up, "kind"), "beam"), enemy, boss, up, room, barred, deeds, fx, fy, tx, ty, ux, uy)

def signatures.begin.if4(_c: Bool, +enemy: J.Val, +boss: J.Val, +up: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +ux: F32, +uy: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +aim = {RS.f_atan2(uy, ux) : F32}
      +turns = {[0.0, F32.neg(0.35), 0.35, F32.neg(0.7), 0.7, F32.neg(1.2), 1.2, F32.neg(1.8), 1.8, cb.PI()] : List<&2, F32>}
      +bestk = {0 : U32}
      +bests = {0.0 : F32}
      +bdx = {1.0 : F32}
      +bdy = {0.0 : F32}
      +bbx = {fx : F32}
      +bby = {fy : F32}
      +k = {0 : U32}
      +have = {False{} : Bool}
      signatures.begin.loop6(turns, enemy, room, barred, deeds, fx, fy, aim, bests, bdx, bdy, bbx, bby, k, have)
    case False{}:
      signatures.begin.if13(String.eq(cb.gs(up, "kind"), "slam"), enemy, boss, up, room, barred, seed, deeds, fx, fy, tx, ty, ux, uy)

def signatures.begin.k2(+_t: F32 & F32, +enemy: J.Val, +boss: J.Val, +up: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +fx: F32, +fy: F32, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+ux, +uy) = _t
  +enemy = {cb.sp2(enemy, "dir", (ux, uy)) : J.Val}
  +deeds = {cb.sj(deeds, "sounds", J.push(cb.gj(deeds, "sounds"), J.JS{"boss_roar"})) : J.Val}
  signatures.begin.if4(String.eq(cb.gs(up, "kind"), "charge"), enemy, boss, up, room, barred, seed, deeds, fx, fy, tx, ty, ux, uy)

def signatures.begin.k1(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +boss: J.Val, +up: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +fx: F32, +fy: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+tx, +ty) = _t
  signatures.begin.k2(rules.unit((tx - fx : F32), (ty - fy : F32)), enemy, boss, up, room, barred, seed, deeds, fx, fy, tx, ty)

# A ring of shots round the guardian (an inhale's breath out, a leap's landing).

def signatures.ring(+enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> J.Val:
  +n = {cb.gu(up, "shots") : U32}
  signatures.ring.if5(U32.is_eq(n, 0), enemy, boss, up, deeds, n)

def signatures.ring.k3(+deeds: J.Val) -> J.Val:
  deeds

def signatures.ring.loop4(+_xs: List<&2, U32>, +enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val, +step: F32, +start: F32) -> J.Val:
  match _xs:
    case Nil{}:
      signatures.ring.k3(deeds)
    case Con{+i, +_t4}:
      +a = {(start + cb.f(i) * step : F32) : F32}
      +t = {patterns.ShotTraits.default() : J.Val}
      +t = {cb.su0(t, "blow", cb.gu(cb.gj(enemy, "signature"), "blow")) : J.Val}
      +deeds = {cb.sj(deeds, "bursts", J.push(cb.gj(deeds, "bursts"), patterns.Projectile.fresh(cb.gf(enemy, "x"), cb.gf(enemy, "y"), (F32.cos(a) * cb.gf(up, "speed") : F32), (F32.sin(a) * cb.gf(up, "speed") : F32), True{}, bosses.Bolt.shot(cb.gs(up, "bolt"), cb.gs(boss, "only_in")), cb.gu(up, "damage"), (6 * rules.HZ() : U32), t))) : J.Val}
      signatures.ring.loop4(_t4, enemy, boss, up, deeds, step, start)

def signatures.ring.k2(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val, +n: U32, +step: F32) -> J.Val:
  (+dx, +dy) = _t
  +start = {(RS.f_atan2(dy, dx) + step / 2.0 : F32) : F32}
  signatures.ring.loop4(cb.range(n), enemy, boss, up, deeds, step, start)

def signatures.ring.k1(+enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val, +n: U32) -> J.Val:
  +step = {(cb.TAU() / cb.f(n) : F32) : F32}
  signatures.ring.k2(cb.gp(enemy, "dir"), enemy, boss, up, deeds, n, step)

def signatures.ring.if5(_c: Bool, +enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val, +n: U32) -> J.Val:
  match _c:
    case True{}:
      deeds
    case False{}:
      signatures.ring.k1(enemy, boss, up, deeds, n)

# The blow of the charge-up it has wound.

def signatures.strike(+enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  signatures.strike.if8(String.eq(cb.gs(up, "kind"), "charge"), enemy, boss, up, deeds)

def signatures.strike.k4(+enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +deeds = {signatures.ring(enemy, boss, up, deeds) : J.Val}
  +deeds = {cb.sj(deeds, "sounds", J.push(cb.gj(deeds, "sounds"), J.JS{"gas_release"})) : J.Val}
  +deeds = {cb.su(deeds, "shake", 6) : J.Val}
  (signatures.stage(enemy, signatures.DAZED()), deeds)

def signatures.strike.if5(_c: Bool, +enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      (signatures.stage(enemy, signatures.JUMP()), deeds)
    case False{}:
      signatures.strike.k4(enemy, boss, up, deeds)

def signatures.strike.k3(+enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  signatures.strike.if5(String.eq(cb.gs(up, "kind"), "leap"), enemy, boss, up, deeds)

def signatures.strike.if6(_c: Bool, +enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +deeds = {cb.sj(deeds, "sounds", J.push(cb.gj(deeds, "sounds"), J.JS{"spell_fire"})) : J.Val}
      (signatures.stage(enemy, signatures.DAZED()), deeds)
    case False{}:
      signatures.strike.k3(enemy, boss, up, deeds)

def signatures.strike.k2(+enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  signatures.strike.if6(String.eq(cb.gs(up, "kind"), "beam"), enemy, boss, up, deeds)

def signatures.strike.if7(_c: Bool, +enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +deeds = {cb.su(deeds, "shake", 10) : J.Val}
      (signatures.stage(enemy, signatures.DAZED()), deeds)
    case False{}:
      signatures.strike.k2(enemy, boss, up, deeds)

def signatures.strike.k1(+enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  signatures.strike.if7(String.eq(cb.gs(up, "kind"), "slam"), enemy, boss, up, deeds)

def signatures.strike.k9(+enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +deeds = {cb.su(deeds, "shake", 8) : J.Val}
  (signatures.stage(enemy, signatures.DASH()), deeds)

def signatures.strike.k12(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val, +ax: F32, +ay: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+bx, +by) = _t
  +enemy = {cb.sp2(enemy, "dir", cb.unit((bx - ax : F32), (by - ay : F32))) : J.Val}
  signatures.strike.k9(enemy, boss, up, deeds)

def signatures.strike.k11(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val, +r: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+ax, +ay) = _t
  signatures.strike.k12(cb.gp(r, "b"), enemy, boss, up, deeds, ax, ay)

def signatures.strike.if10(_c: Bool, +enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +r = {J.nth(cb.gj(cb.gj(enemy, "signature"), "rails"), 0) : J.Val}
      signatures.strike.k11(cb.gp(r, "a"), enemy, boss, up, deeds, r)
    case False{}:
      signatures.strike.k9(enemy, boss, up, deeds)

def signatures.strike.if8(_c: Bool, +enemy: J.Val, +boss: J.Val, +up: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      signatures.strike.if10(U32.is_gt(J.len(cb.gj(cb.gj(enemy, "signature"), "rails")), 0), enemy, boss, up, deeds)
    case False{}:
      signatures.strike.k1(enemy, boss, up, deeds)

# A guardian's charge-ups from its file, one tick: when one is due (and its
# burst is in its allowance) it stands and winds up where everyone can see,
# then strikes, then stands spent. True while it is busy at one, so it neither
# walks nor shoots. Answers (enemy, deeds, busy).

def signatures.wind(+enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  signatures.wind.if30(Bool.or(signatures.special(boss), U32.is_eq(J.len(cb.gj(boss, "windups")), 0)), enemy, boss, heroes, room, barred, seed, deeds)

def signatures.wind.k4(+enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (enemy, deeds, True{})

def signatures.wind.k8(+_t: Sigma<&2, &2, J.Val, _ => J.Val>) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+enemy, +deeds) = _t
  signatures.wind.k4(enemy, deeds)

def signatures.wind.if7(_c: Bool, +enemy: J.Val, +boss: J.Val, +deeds: J.Val, +up: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      signatures.wind.k8(signatures.strike(enemy, boss, up, deeds))
    case False{}:
      signatures.wind.k4(enemy, deeds)

def signatures.wind.k6(+enemy: J.Val, +boss: J.Val, +deeds: J.Val, +up: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  signatures.wind.if7(U32.is_ge(cb.gu(enemy, "timer"), cb.gu(up, "wind")), enemy, boss, deeds, up)

def signatures.wind.if9(_c: Bool, +enemy: J.Val, +boss: J.Val, +deeds: J.Val, +up: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +deeds = {cb.sj(deeds, "pulls", J.push(cb.gj(deeds, "pulls"), J.JA{[J.of_f32(cb.gf(enemy, "x")), J.of_f32(cb.gf(enemy, "y")), J.of_f32((monsters.Enemy.radius(enemy) + signatures.PULL_KEEP() : F32))]})) : J.Val}
      signatures.wind.k6(enemy, boss, deeds, up)
    case False{}:
      signatures.wind.k6(enemy, boss, deeds, up)

def signatures.wind.if13(_c: Bool, +enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +enemy = {signatures.stage(enemy, signatures.DAZED()) : J.Val}
      signatures.wind.k4(enemy, deeds)
    case False{}:
      signatures.wind.k4(enemy, deeds)

def signatures.wind.k12(+enemy: J.Val, +deeds: J.Val, +stopped: Bool, +arrived: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  signatures.wind.if13(Bool.or(Bool.or(stopped, arrived), U32.is_ge(cb.gu(enemy, "timer"), 45)), enemy, deeds)

def signatures.wind.k15(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +deeds: J.Val, +stopped: Bool, +arrived: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+rbx, +rby) = _t
  +arrived = {(cb.hyp((rbx - cb.gf(enemy, "x") : F32), (rby - cb.gf(enemy, "y") : F32)) < 1.0 : F32) : Bool}
  signatures.wind.k12(enemy, deeds, stopped, arrived)

def signatures.wind.if14(_c: Bool, +enemy: J.Val, +deeds: J.Val, +stopped: Bool, +arrived: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +r0 = {J.nth(cb.gj(cb.gj(enemy, "signature"), "rails"), 0) : J.Val}
      signatures.wind.k15(cb.gp(r0, "b"), enemy, deeds, stopped, arrived)
    case False{}:
      signatures.wind.k12(enemy, deeds, stopped, arrived)

def signatures.wind.k11(+_t: Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+enemy, (+deeds, +stopped)) = _t
  +arrived = {True{} : Bool}
  signatures.wind.if14(U32.is_gt(J.len(cb.gj(cb.gj(enemy, "signature"), "rails")), 0), enemy, deeds, stopped, arrived)

def signatures.wind.k20(+_t: F32 & F32, +enemy: J.Val, +boss: J.Val, +deeds: J.Val, +up: J.Val, +bx: F32, +by: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+backx, +backy) = _t
  +deeds = {cb.sj(deeds, "sweeps", J.push(cb.gj(deeds, "sweeps"), J.JA{[cb.of_pair(bx, by), cb.of_pair(bx, by), J.of_f32((signatures.LANDING() + rules.HERO_RADIUS() : F32)), J.of_u32(cb.gu(up, "damage")), cb.of_pair(backx, backy), J.of_u32(cb.gu(cb.gj(enemy, "signature"), "blow"))]})) : J.Val}
  +deeds = {signatures.ring(enemy, boss, up, deeds) : J.Val}
  +deeds = {cb.sj(deeds, "sounds", J.push(cb.gj(deeds, "sounds"), J.JS{"rock_land"})) : J.Val}
  +deeds = {cb.su(deeds, "shake", 10) : J.Val}
  +enemy = {signatures.stage(enemy, signatures.DAZED()) : J.Val}
  signatures.wind.k4(enemy, deeds)

def signatures.wind.if19(_c: Bool, +enemy: J.Val, +boss: J.Val, +deeds: J.Val, +up: J.Val, +ax: F32, +ay: F32, +bx: F32, +by: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +enemy = {cb.sf(enemy, "x", bx) : J.Val}
      +enemy = {cb.sf(enemy, "y", by) : J.Val}
      signatures.wind.k20(rules.unit((ax - bx : F32), (ay - by : F32)), enemy, boss, deeds, up, bx, by)
    case False{}:
      signatures.wind.k4(enemy, deeds)

def signatures.wind.k18(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +boss: J.Val, +deeds: J.Val, +up: J.Val, +t: F32, +ax: F32, +ay: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+bx, +by) = _t
  +enemy = {cb.sf(enemy, "x", (ax + (bx - ax : F32) * t : F32)) : J.Val}
  +enemy = {cb.sf(enemy, "y", (ay + (by - ay : F32) * t : F32)) : J.Val}
  signatures.wind.if19(U32.is_ge(cb.gu(enemy, "timer"), signatures.FLIGHT()), enemy, boss, deeds, up, ax, ay, bx, by)

def signatures.wind.k17(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +boss: J.Val, +deeds: J.Val, +up: J.Val, +t: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+ax, +ay) = _t
  signatures.wind.k18(cb.gp(cb.gj(enemy, "signature"), "mark"), enemy, boss, deeds, up, t, ax, ay)

def signatures.wind.if22(_c: Bool, +enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +enemy = {cb.sj(enemy, "signature", cb.sj(cb.gj(enemy, "signature"), "rails", J.JA{Nil{}})) : J.Val}
      +enemy = {signatures.stage(enemy, 0) : J.Val}
      signatures.wind.k4(enemy, deeds)
    case False{}:
      signatures.wind.k4(enemy, deeds)

def signatures.wind.if21(_c: Bool, +enemy: J.Val, +deeds: J.Val, +up: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      signatures.wind.if22(U32.is_ge(cb.gu(enemy, "timer"), signatures.spent_for(up)), enemy, deeds)
    case False{}:
      +enemy = {signatures.stage(enemy, 0) : J.Val}
      (enemy, deeds, False{})

def signatures.wind.if16(_c: Bool, +enemy: J.Val, +boss: J.Val, +deeds: J.Val, +up: J.Val, +st: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +t = {RS.f_min((cb.f(cb.gu(enemy, "timer")) / cb.f(signatures.FLIGHT()) : F32), 1.0) : F32}
      signatures.wind.k17(cb.gp(cb.gj(enemy, "signature"), "jump_from"), enemy, boss, deeds, up, t)
    case False{}:
      signatures.wind.if21(U32.is_eq(st, signatures.DAZED()), enemy, deeds, up)

def signatures.wind.if10(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +up: J.Val, +st: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      signatures.wind.k11(signatures.dash_for(enemy, room, barred, cb.gf(up, "speed"), False{}, cb.gu(up, "damage"), cb.gu(cb.gj(enemy, "signature"), "blow"), deeds))
    case False{}:
      signatures.wind.if16(U32.is_eq(st, signatures.JUMP()), enemy, boss, deeds, up, st)

def signatures.wind.if5(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +up: J.Val, +st: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      signatures.wind.if9(String.eq(cb.gs(up, "kind"), "inhale"), enemy, boss, deeds, up)
    case False{}:
      signatures.wind.if10(U32.is_eq(st, signatures.DASH()), enemy, boss, room, barred, deeds, up, st)

def signatures.wind.k3(+enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +up = {J.nth(cb.gj(boss, "windups"), cb.gu(cb.gj(enemy, "signature"), "windup")) : J.Val}
  +st = {cb.gu(enemy, "stage") : U32}
  signatures.wind.if5(U32.is_eq(st, signatures.WIND()), enemy, boss, room, barred, deeds, up, st)

def signatures.wind.if23(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +enemy = {signatures.stage(enemy, 0) : J.Val}
      (enemy, deeds, False{})
    case False{}:
      signatures.wind.k3(enemy, boss, room, barred, deeds)

def signatures.wind.k2(+enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  signatures.wind.if23(U32.is_ge(cb.gu(cb.gj(enemy, "signature"), "windup"), J.len(cb.gj(boss, "windups"))), enemy, boss, room, barred, deeds)

def signatures.wind.k28(+_t: Sigma<&2, &2, J.Val, _ => J.Val>, +boss: J.Val, +room: J.Val, +barred: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+enemy, +deeds) = _t
  +enemy = {signatures.stage(enemy, signatures.WIND()) : J.Val}
  (enemy, deeds, True{})

def signatures.wind.k27(+enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +k: U32, +up: J.Val, +cost: U32, +target: Sigma<&2, &2, F32, _ => F32>) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +enemy = {cb.sj(enemy, "signature", cb.su(cb.gj(enemy, "signature"), "spent", (cb.gu(cb.gj(enemy, "signature"), "spent") + cost : U32))) : J.Val}
  +enemy = {cb.sj(enemy, "signature", cb.sb(cb.gj(enemy, "signature"), "active", True{})) : J.Val}
  +enemy = {cb.sj(enemy, "signature", cb.su(cb.gj(enemy, "signature"), "windup", k)) : J.Val}
  +enemy = {cb.sj(enemy, "signature", cb.su(cb.gj(enemy, "signature"), "cycle", (cb.gu(cb.gj(enemy, "signature"), "cycle") + 1 : U32))) : J.Val}
  +enemy = {cb.sj(enemy, "signature", cb.su0(cb.gj(enemy, "signature"), "blow", signatures.tag(enemy))) : J.Val}
  signatures.wind.k28(signatures.begin(enemy, boss, up, target, room, barred, seed, deeds), boss, room, barred)

def signatures.wind.if29(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +k: U32, +up: J.Val, +cost: U32, +target: Sigma<&2, &2, F32, _ => F32>) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      (enemy, deeds, False{})
    case False{}:
      signatures.wind.k27(enemy, boss, room, barred, seed, deeds, k, up, cost, target)

def signatures.wind.m26(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +k: U32, +up: J.Val, +cost: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _s:
    case None{}:
      (enemy, deeds, False{})
    case Some{+target}:
      signatures.wind.if29(U32.is_gt((cb.gu(cb.gj(enemy, "signature"), "spent") + cost : U32), signatures.BANK()), enemy, boss, room, barred, seed, deeds, k, up, cost, target)

def signatures.wind.m25(+_s: Maybe<&2, U32>, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _s:
    case None{}:
      (enemy, deeds, False{})
    case Some{+k}:
      +up = {J.nth(cb.gj(boss, "windups"), k) : J.Val}
      +cost = {(bosses.ChargeUp.burst(up) * rules.HZ() : U32) : U32}
      signatures.wind.m26(signatures.nearest(enemy, heroes), enemy, boss, room, barred, seed, deeds, k, up, cost)

def signatures.wind.if24(_c: Bool, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +now: String) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      signatures.wind.m25(signatures.due(enemy, boss, now), enemy, boss, heroes, room, barred, seed, deeds)
    case False{}:
      signatures.wind.k2(enemy, boss, room, barred, deeds)

def signatures.wind.k1(+enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +enemy = {cb.su(enemy, "timer", (cb.gu(enemy, "timer") + 1 : U32)) : J.Val}
  +now = {bosses.Boss.stage(boss, cb.gu(enemy, "hp"), cb.gu(enemy, "max_hp")) : String}
  signatures.wind.if24(U32.is_eq(cb.gu(enemy, "stage"), 0), enemy, boss, heroes, room, barred, seed, deeds, now)

def signatures.wind.if30(_c: Bool, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      (enemy, deeds, False{})
    case False{}:
      signatures.wind.k1(enemy, boss, heroes, room, barred, seed, deeds)

# The unruly guardians' own stage machines. Answers (enemy, deeds, handled).

def signatures.act(+enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  signatures.act.if26(Bool.not(signatures.special(boss)), enemy, boss, heroes, room, barred, seed, deeds)

def signatures.act.k2(+enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (enemy, deeds, True{})

def signatures.act.if8(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +enemy = {cb.sof(enemy, "size", Some{(cb.gf(boss, "radius") * 2.0 : F32)}) : J.Val}
      +enemy = {cb.sj(enemy, "signature", cb.su(cb.gj(enemy, "signature"), "left", Bool.pick(U32, raging, 3, 1))) : J.Val}
      +enemy = {signatures.begin_rip(enemy, room, barred, seed) : J.Val}
      signatures.act.k2(enemy, deeds)
    case False{}:
      signatures.act.k2(enemy, deeds)

def signatures.act.if13(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +enemy = {cb.sof(enemy, "size", Some{(cb.gf(boss, "radius") * 2.0 : F32)}) : J.Val}
      +enemy = {signatures.begin_rip(enemy, room, barred, seed) : J.Val}
      signatures.act.k2(enemy, deeds)
    case False{}:
      +enemy = {signatures.stage(enemy, signatures.DAZED()) : J.Val}
      signatures.act.k2(enemy, deeds)

def signatures.act.if12(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +enemy = {cb.sj(enemy, "signature", cb.su(cb.gj(enemy, "signature"), "left", RS.u_sat_sub(cb.gu(cb.gj(enemy, "signature"), "left"), 1))) : J.Val}
      signatures.act.if13(U32.is_gt(cb.gu(cb.gj(enemy, "signature"), "left"), 0), enemy, boss, room, barred, seed, deeds)
    case False{}:
      signatures.act.k2(enemy, deeds)

def signatures.act.k11(+_t: Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +raging: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+enemy, (+deeds, +stop)) = _t
  +cloud = {cb.lit("{\"x\":f00000000,\"y\":f00000000,\"vx\":f00000000,\"vy\":f00000000,\"age\":0,\"owner\":0,\"power\":4,\"tint\":2}") : J.Val}
  +cloud = {J.set(J.set(cloud, "x", J.of_f32(cb.gf(enemy, "x"))), "y", J.of_f32(cb.gf(enemy, "y"))) : J.Val}
  +cloud = {J.set(cloud, "tint", J.of_u32(Bool.pick(U32, raging, 3, 2))) : J.Val}
  +deeds = {cb.sj(deeds, "clouds", J.push(cb.gj(deeds, "clouds"), cloud)) : J.Val}
  signatures.act.if12(Bool.or(stop, U32.is_ge(cb.gu(enemy, "timer"), 33)), enemy, boss, room, barred, seed, deeds)

def signatures.act.if14(_c: Bool, +enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +enemy = {signatures.stage(enemy, 0) : J.Val}
      signatures.act.k2(enemy, deeds)
    case False{}:
      signatures.act.k2(enemy, deeds)

def signatures.act.if10(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +st: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      signatures.act.k11(signatures.dash(enemy, room, barred, signatures.RIP_SPEED(), True{}, deeds), boss, room, barred, seed, raging)
    case False{}:
      signatures.act.if14(Bool.and(U32.is_eq(st, signatures.DAZED()), U32.is_ge(cb.gu(enemy, "timer"), 42)), enemy, deeds)

def signatures.act.if9(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +st: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +enemy = {signatures.stage(enemy, signatures.DASH()) : J.Val}
      +deeds = {cb.sj(deeds, "sounds", J.push(cb.gj(deeds, "sounds"), J.JS{"gas_release"})) : J.Val}
      +deeds = {cb.su(deeds, "shake", 12) : J.Val}
      signatures.act.k2(enemy, deeds)
    case False{}:
      signatures.act.if10(U32.is_eq(st, signatures.DASH()), enemy, boss, room, barred, seed, deeds, raging, st)

def signatures.act.if7(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +st: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +deeds = {cb.sj(deeds, "pulls", J.push(cb.gj(deeds, "pulls"), J.JA{[J.of_f32(cb.gf(enemy, "x")), J.of_f32(cb.gf(enemy, "y")), J.of_f32(0.1)]})) : J.Val}
      signatures.act.if8(U32.is_ge(cb.gu(enemy, "timer"), (signatures.BREATH() * 3 : U32)), enemy, boss, room, barred, seed, deeds, raging)
    case False{}:
      signatures.act.if9(Bool.and(U32.is_eq(st, signatures.TELL()), U32.is_ge(cb.gu(enemy, "timer"), signatures.RIP_TELL())), enemy, boss, room, barred, seed, deeds, raging, st)

def signatures.act.if6(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +st: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +enemy = {signatures.stage(enemy, signatures.INHALE()) : J.Val}
      signatures.act.k2(enemy, deeds)
    case False{}:
      signatures.act.if7(U32.is_eq(st, signatures.INHALE()), enemy, boss, room, barred, seed, deeds, raging, st)

def signatures.act.k5(+enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +st = {cb.gu(enemy, "stage") : U32}
  signatures.act.if6(Bool.and(U32.is_eq(st, 0), U32.is_ge(cb.gu(enemy, "timer"), 72)), enemy, boss, room, barred, seed, deeds, raging, st)

def signatures.act.k17(+_t: F32 & F32, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+nx, +ny) = _t
  +enemy = {cb.sf(enemy, "x", nx) : J.Val}
  +enemy = {cb.sf(enemy, "y", ny) : J.Val}
  signatures.act.k5(enemy, boss, room, barred, seed, deeds, raging)

def signatures.act.k16(+_t: F32 & F32, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+ux, +uy) = _t
  signatures.act.k17(rules.Grid.slide(room, barred, (cb.gf(enemy, "x"), cb.gf(enemy, "y")), ((ux * 3.0 * rules.DT() : F32), (uy * 3.0 * rules.DT() : F32)), monsters.Enemy.radius(enemy), 1), enemy, boss, room, barred, seed, deeds, raging)

def signatures.act.if15(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      signatures.act.k16(rules.unit(((layout.Room.width(room) / 2.0 : F32) - cb.gf(enemy, "x") : F32), ((layout.Room.height(room) / 2.0 : F32) - cb.gf(enemy, "y") : F32)), enemy, boss, room, barred, seed, deeds, raging)
    case False{}:
      signatures.act.k5(enemy, boss, room, barred, seed, deeds, raging)

def signatures.act.k4(+enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +radius: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +enemy = {cb.sof(enemy, "size", Some{radius}) : J.Val}
  signatures.act.if15(U32.is_eq(cb.gu(enemy, "stage"), 0), enemy, boss, room, barred, seed, deeds, raging)

def signatures.act.if20(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +radius: F32, +bsx: F32, +bsy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +enemy = {cb.sf(enemy, "x", bsx) : J.Val}
      +enemy = {cb.sf(enemy, "y", bsy) : J.Val}
      signatures.act.k4(enemy, boss, room, barred, seed, deeds, raging, radius)
    case False{}:
      signatures.act.k4(enemy, boss, room, barred, seed, deeds, raging, radius)

def signatures.act.k19(+enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +radius: F32, +have: Bool, +bsx: F32, +bsy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  signatures.act.if20(have, enemy, boss, room, barred, seed, deeds, raging, radius, bsx, bsy)

def signatures.act.if24(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +radius: F32, +have: Bool, +bd: U32, +bsx: F32, +bsy: F32, +_t21: List<&2, U32>, +dy0: U32, +_t22: List<&2, U32>, +sx: F32, +sy: F32, +d: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +have = {True{} : Bool}
      +bd = {d : U32}
      +bsx = {sx : F32}
      +bsy = {sy : F32}
      signatures.act.loop22(_t22, enemy, boss, room, barred, seed, deeds, raging, radius, have, bd, bsx, bsy, _t21, dy0)
    case False{}:
      signatures.act.loop22(_t22, enemy, boss, room, barred, seed, deeds, raging, radius, have, bd, bsx, bsy, _t21, dy0)

def signatures.act.if23(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +radius: F32, +have: Bool, +bd: U32, +bsx: F32, +bsy: F32, +_t21: List<&2, U32>, +dy0: U32, +_t22: List<&2, U32>, +dx: U32, +dy: U32, +sx: F32, +sy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +d = {(RS.i_mul(dx, dx) + RS.i_mul(dy, dy) : U32) : U32}
      signatures.act.if24(Bool.or(Bool.not(have), U32.is_lt(d, bd)), enemy, boss, room, barred, seed, deeds, raging, radius, have, bd, bsx, bsy, _t21, dy0, _t22, sx, sy, d)
    case False{}:
      signatures.act.loop22(_t22, enemy, boss, room, barred, seed, deeds, raging, radius, have, bd, bsx, bsy, _t21, dy0)

def signatures.act.loop22(+_xs: List<&2, U32>, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +radius: F32, +have: Bool, +bd: U32, +bsx: F32, +bsy: F32, +_t21: List<&2, U32>, +dy0: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _xs:
    case Nil{}:
      signatures.act.loop21(_t21, enemy, boss, room, barred, seed, deeds, raging, radius, have, bd, bsx, bsy)
    case Con{+dx0, +_t22}:
      +dx = {RS.i_sub(dx0, 8) : U32}
      +dy = {RS.i_sub(dy0, 8) : U32}
      +sx = {(cb.gf(enemy, "x") + RS.i_as_f32(dx) * 0.5 : F32) : F32}
      +sy = {(cb.gf(enemy, "y") + RS.i_as_f32(dy) * 0.5 : F32) : F32}
      signatures.act.if23(rules.Grid.clear(room, barred, sx, sy, radius, 1), enemy, boss, room, barred, seed, deeds, raging, radius, have, bd, bsx, bsy, _t21, dy0, _t22, dx, dy, sx, sy)

def signatures.act.loop21(+_xs: List<&2, U32>, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +radius: F32, +have: Bool, +bd: U32, +bsx: F32, +bsy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _xs:
    case Nil{}:
      signatures.act.k19(enemy, boss, room, barred, seed, deeds, raging, radius, have, bsx, bsy)
    case Con{+dy0, +_t21}:
      signatures.act.loop22(cb.range(17), enemy, boss, room, barred, seed, deeds, raging, radius, have, bd, bsx, bsy, _t21, dy0)

def signatures.act.if18(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +raging: Bool, +radius: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +have = {False{} : Bool}
      +bd = {0 : U32}
      +bsx = {cb.gf(enemy, "x") : F32}
      +bsy = {cb.gf(enemy, "y") : F32}
      signatures.act.loop21(cb.range(17), enemy, boss, room, barred, seed, deeds, raging, radius, have, bd, bsx, bsy)
    case False{}:
      signatures.act.k4(enemy, boss, room, barred, seed, deeds, raging, radius)

def signatures.act.k25(+_t: Sigma<&2, &2, J.Val, _ => J.Val>) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  (+enemy, +deeds) = _t
  signatures.act.k2(enemy, deeds)

def signatures.act.if3(_c: Bool, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      +raging = {(cb.f(cb.gu(enemy, "hp")) < (cb.f(cb.gu(enemy, "max_hp")) * 0.4 : F32) : F32) : Bool}
      +radius = {(cb.gf(boss, "radius") * signatures.swell(enemy) : F32) : F32}
      signatures.act.if18(Bool.and(Bool.or((radius > monsters.Enemy.radius(enemy) : F32), U32.is_eq(cb.gu(enemy, "stage"), signatures.TELL())), Bool.not(rules.Grid.clear(room, barred, cb.gf(enemy, "x"), cb.gf(enemy, "y"), radius, 1))), enemy, boss, room, barred, seed, deeds, raging, radius)
    case False{}:
      signatures.act.k25(signatures.engine(enemy, boss, heroes, room, barred, seed, deeds))

def signatures.act.k1(+enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  +enemy = {cb.sj(enemy, "signature", cb.sb(cb.gj(enemy, "signature"), "active", True{})) : J.Val}
  +enemy = {cb.su(enemy, "timer", (cb.gu(enemy, "timer") + 1 : U32)) : J.Val}
  signatures.act.if3(String.eq(cb.gs(boss, "id"), signatures.RIPPER()), enemy, boss, heroes, room, barred, seed, deeds)

def signatures.act.if26(_c: Bool, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>:
  match _c:
    case True{}:
      (enemy, deeds, False{})
    case False{}:
      signatures.act.k1(enemy, boss, heroes, room, barred, seed, deeds)

def signatures.lay_rails(+enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W) -> J.Val:
  +tx = {(layout.Room.width(room) / 2.0 : F32) : F32}
  +ty = {(layout.Room.height(room) / 2.0 : F32) : F32}
  signatures.lay_rails.if10(U32.is_gt(J.len(heroes), 0), enemy, heroes, room, barred, seed, tx, ty)

def signatures.lay_rails.k3(+enemy: J.Val, +sorted: List<&2, J.Val>) -> J.Val:
  +enemy = {cb.sj(enemy, "signature", cb.sj(cb.gj(enemy, "signature"), "rails", J.JA{sorted})) : J.Val}
  +enemy = {cb.sj(enemy, "signature", cb.su(cb.gj(enemy, "signature"), "rail", 0)) : J.Val}
  +enemy = {cb.sj(enemy, "signature", cb.su(cb.gj(enemy, "signature"), "left", Bool.pick(U32, U32.is_lt((cb.gu(enemy, "hp") * 2 : U32), cb.gu(enemy, "max_hp")), 3, 1))) : J.Val}
  +enemy = {cb.sj(enemy, "signature", cb.su(cb.gj(enemy, "signature"), "cycle", (cb.gu(cb.gj(enemy, "signature"), "cycle") + 1 : U32))) : J.Val}
  signatures.stage(enemy, signatures.TELL())

def signatures.lay_rails.loop4(+_xs: List<&2, J.Val>, +enemy: J.Val, +sorted: List<&2, J.Val>) -> J.Val:
  match _xs:
    case Nil{}:
      signatures.lay_rails.k3(enemy, sorted)
    case Con{+rail, +_t4}:
      +sorted = {signatures.insert_by_reach(sorted, rail) : List<&2, J.Val>}
      signatures.lay_rails.loop4(_t4, enemy, sorted)

def signatures.lay_rails.k2(+enemy: J.Val, +rails: List<&2, J.Val>) -> J.Val:
  +sorted = {Nil{} : List<&2, J.Val>}
  signatures.lay_rails.loop4(rails, enemy, sorted)

def signatures.lay_rails.k6(+enemy: J.Val, +room: J.Val, +barred: Bool, +aim: F32, +jitter: F32, +rails: List<&2, J.Val>, +_t5: List<&2, U32>, +bx: F32, +by: F32) -> J.Val:
  +rail = {J.obj() : J.Val}
  +rail = {cb.sp2(rail, "a", (cb.gf(enemy, "x"), cb.gf(enemy, "y"))) : J.Val}
  +rail = {cb.sp2(rail, "b", (bx, by)) : J.Val}
  +rails = {List.append(&2, J.Val, rails, [rail]) : List<&2, J.Val>}
  signatures.lay_rails.loop5(_t5, enemy, room, barred, aim, jitter, rails)

def signatures.lay_rails.if9(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +aim: F32, +jitter: F32, +rails: List<&2, J.Val>, +_t5: List<&2, U32>, +dx: F32, +dy: F32, +bx: F32, +by: F32, +open: Bool, +_t7: List<&2, U32>, +px: F32, +py: F32) -> J.Val:
  match _c:
    case True{}:
      +bx = {px : F32}
      +by = {py : F32}
      signatures.lay_rails.loop7(_t7, enemy, room, barred, aim, jitter, rails, _t5, dx, dy, bx, by, open)
    case False{}:
      +open = {False{} : Bool}
      signatures.lay_rails.loop7(_t7, enemy, room, barred, aim, jitter, rails, _t5, dx, dy, bx, by, open)

def signatures.lay_rails.if8(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +aim: F32, +jitter: F32, +rails: List<&2, J.Val>, +_t5: List<&2, U32>, +dx: F32, +dy: F32, +bx: F32, +by: F32, +open: Bool, +_t7: List<&2, U32>, +n0: U32) -> J.Val:
  match _c:
    case True{}:
      +n = {cb.f((n0 + 1 : U32)) : F32}
      +px = {(cb.gf(enemy, "x") + dx * n * 0.5 : F32) : F32}
      +py = {(cb.gf(enemy, "y") + dy * n * 0.5 : F32) : F32}
      signatures.lay_rails.if9(rules.Grid.clear(room, barred, px, py, monsters.Enemy.radius(enemy), 1), enemy, room, barred, aim, jitter, rails, _t5, dx, dy, bx, by, open, _t7, px, py)
    case False{}:
      signatures.lay_rails.loop7(_t7, enemy, room, barred, aim, jitter, rails, _t5, dx, dy, bx, by, open)

def signatures.lay_rails.loop7(+_xs: List<&2, U32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +aim: F32, +jitter: F32, +rails: List<&2, J.Val>, +_t5: List<&2, U32>, +dx: F32, +dy: F32, +bx: F32, +by: F32, +open: Bool) -> J.Val:
  match _xs:
    case Nil{}:
      signatures.lay_rails.k6(enemy, room, barred, aim, jitter, rails, _t5, bx, by)
    case Con{+n0, +_t7}:
      signatures.lay_rails.if8(open, enemy, room, barred, aim, jitter, rails, _t5, dx, dy, bx, by, open, _t7, n0)

def signatures.lay_rails.loop5(+_xs: List<&2, U32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +aim: F32, +jitter: F32, +rails: List<&2, J.Val>) -> J.Val:
  match _xs:
    case Nil{}:
      signatures.lay_rails.k2(enemy, rails)
    case Con{+k, +_t5}:
      +angle = {(aim + jitter + (cb.f(k) - 1.0 : F32) * 0.72 : F32) : F32}
      +dx = {F32.cos(angle) : F32}
      +dy = {F32.sin(angle) : F32}
      +bx = {cb.gf(enemy, "x") : F32}
      +by = {cb.gf(enemy, "y") : F32}
      +open = {True{} : Bool}
      signatures.lay_rails.loop7(cb.range(120), enemy, room, barred, aim, jitter, rails, _t5, dx, dy, bx, by, open)

def signatures.lay_rails.k1(+enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +tx: F32, +ty: F32) -> J.Val:
  +aim = {RS.f_atan2((ty - cb.gf(enemy, "y") : F32), (tx - cb.gf(enemy, "x") : F32)) : F32}
  +jitter = {(cb.f(W.rem_u32(rules.mix(W.xor(seed, W.of_u32(cb.gu(cb.gj(enemy, "signature"), "cycle")))), 100)) * 0.004 - 0.2 : F32) : F32}
  +rails = {Nil{} : List<&2, J.Val>}
  signatures.lay_rails.loop5(cb.range(3), enemy, room, barred, aim, jitter, rails)

def signatures.lay_rails.k11(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W) -> J.Val:
  (+tx, +ty) = _t
  signatures.lay_rails.k1(enemy, room, barred, seed, tx, ty)

def signatures.lay_rails.if10(_c: Bool, +enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +tx: F32, +ty: F32) -> J.Val:
  match _c:
    case True{}:
      signatures.lay_rails.k11(cb.pair(J.nth(heroes, 0)), enemy, room, barred, seed)
    case False{}:
      signatures.lay_rails.k1(enemy, room, barred, seed, tx, ty)

def signatures.reach_of(+rail: J.Val) -> F32:
  signatures.reach_of.k1(cb.gp(rail, "a"), rail)

def signatures.reach_of.k2(+_t: Sigma<&2, &2, F32, _ => F32>, +ax: F32, +ay: F32) -> F32:
  (+bx, +by) = _t
  cb.hyp((bx - ax : F32), (by - ay : F32))

def signatures.reach_of.k1(+_t: Sigma<&2, &2, F32, _ => F32>, +rail: J.Val) -> F32:
  (+ax, +ay) = _t
  signatures.reach_of.k2(cb.gp(rail, "b"), ax, ay)

# Insert after every earlier rail whose reach is not shorter (stable, descending).

def signatures.insert_by_reach(+sorted: List<&2, J.Val>, +rail: J.Val) -> List<&2, J.Val>:
  signatures.insert_by_reach.m1(sorted, sorted, rail)

def signatures.insert_by_reach.k2(+rail: J.Val, +h: J.Val, +t: List<&2, J.Val>) -> List<&2, J.Val>:
  h <> signatures.insert_by_reach(t, rail)

def signatures.insert_by_reach.if3(_c: Bool, +sorted: List<&2, J.Val>, +rail: J.Val, +h: J.Val, +t: List<&2, J.Val>) -> List<&2, J.Val>:
  match _c:
    case True{}:
      rail <> sorted
    case False{}:
      signatures.insert_by_reach.k2(rail, h, t)

def signatures.insert_by_reach.m1(+_s: List<&2, J.Val>, +sorted: List<&2, J.Val>, +rail: J.Val) -> List<&2, J.Val>:
  match _s:
    case Nil{}:
      [rail]
    case Con{+h, +t}:
      signatures.insert_by_reach.if3((signatures.reach_of(rail) > signatures.reach_of(h) : F32), sorted, rail, h, t)

def signatures.engine(+enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  signatures.engine.if32(Bool.and(U32.is_lt((cb.gu(enemy, "hp") * 2 : U32), cb.gu(enemy, "max_hp")), Bool.not(cb.gb(cb.gj(enemy, "signature"), "babies"))), enemy, boss, heroes, room, barred, seed, deeds)

def signatures.engine.k2(+enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (enemy, deeds)

def signatures.engine.if9(_c: Bool, +enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +enemy = {signatures.lay_rails(enemy, heroes, room, barred, seed) : J.Val}
      +deeds = {cb.sj(deeds, "sounds", J.push(cb.gj(deeds, "sounds"), J.JS{"engine_whistle"})) : J.Val}
      signatures.engine.k2(enemy, deeds)
    case False{}:
      signatures.engine.k2(enemy, deeds)

def signatures.engine.k8(+enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  signatures.engine.if9(U32.is_ge(cb.gu(enemy, "timer"), 105), enemy, heroes, room, barred, seed, deeds)

def signatures.engine.if10(_c: Bool, +enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +deeds = {cb.sj(deeds, "slams", J.push(cb.gj(deeds, "slams"), cb.of_pair(cb.gf(enemy, "x"), cb.gf(enemy, "y")))) : J.Val}
      signatures.engine.k8(enemy, heroes, room, barred, seed, deeds)
    case False{}:
      signatures.engine.k8(enemy, heroes, room, barred, seed, deeds)

def signatures.engine.k7(+_t: F32 & F32, +enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+nx, +ny) = _t
  +enemy = {cb.sf(enemy, "x", nx) : J.Val}
  +enemy = {cb.sf(enemy, "y", ny) : J.Val}
  signatures.engine.if10(U32.is_eq(cb.gu(enemy, "timer"), 36), enemy, heroes, room, barred, seed, deeds)

def signatures.engine.k6(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+ddx, +ddy) = _t
  signatures.engine.k7(rules.Grid.slide(room, barred, (cb.gf(enemy, "x"), cb.gf(enemy, "y")), ((ddx * cb.gf(boss, "speed") * rules.DT() : F32), (ddy * cb.gf(boss, "speed") * rules.DT() : F32)), monsters.Enemy.radius(enemy), 1), enemy, heroes, room, barred, seed, deeds)

def signatures.engine.k5(+_t: F32 & F32, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+ux, +uy) = _t
  +wobble = {(F32.sin((cb.f(cb.gu(enemy, "timer")) * 0.3 : F32)) * 0.45 : F32) : F32}
  +enemy = {cb.sp2(enemy, "dir", cb.unit((ux - uy * wobble : F32), (uy + ux * wobble : F32))) : J.Val}
  signatures.engine.k6(cb.gp(enemy, "dir"), enemy, boss, heroes, room, barred, seed, deeds)

def signatures.engine.k4(+enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  signatures.engine.k5(rules.unit((tx - cb.gf(enemy, "x") : F32), (ty - cb.gf(enemy, "y") : F32)), enemy, boss, heroes, room, barred, seed, deeds)

def signatures.engine.k12(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+tx, +ty) = _t
  signatures.engine.k4(enemy, boss, heroes, room, barred, seed, deeds, tx, ty)

def signatures.engine.if11(_c: Bool, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      signatures.engine.k12(cb.pair(J.nth(heroes, 0)), enemy, boss, heroes, room, barred, seed, deeds)
    case False{}:
      signatures.engine.k4(enemy, boss, heroes, room, barred, seed, deeds, tx, ty)

def signatures.engine.k14(+enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +enemy = {signatures.stage(enemy, signatures.DASH()) : J.Val}
  +deeds = {cb.su(deeds, "shake", 8) : J.Val}
  signatures.engine.k2(enemy, deeds)

def signatures.engine.k17(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +deeds: J.Val, +rax: F32, +ray: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+rbx, +rby) = _t
  +enemy = {cb.sp2(enemy, "dir", cb.unit((rbx - rax : F32), (rby - ray : F32))) : J.Val}
  signatures.engine.k14(enemy, deeds)

def signatures.engine.k16(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +deeds: J.Val, +rail: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+rax, +ray) = _t
  signatures.engine.k17(cb.pair(J.get(rail, "b")), enemy, deeds, rax, ray)

def signatures.engine.if15(_c: Bool, +enemy: J.Val, +deeds: J.Val, +rail: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      signatures.engine.k16(cb.pair(J.get(rail, "a")), enemy, deeds, rail)
    case False{}:
      signatures.engine.k14(enemy, deeds)

def signatures.engine.if22(_c: Bool, +enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +enemy = {cb.sj(enemy, "signature", cb.su(cb.gj(enemy, "signature"), "rail", RS.u_min((cb.gu(cb.gj(enemy, "signature"), "rail") + 1 : U32), 2))) : J.Val}
      +enemy = {cb.sj(enemy, "signature", cb.sp2(cb.gj(enemy, "signature"), "jump_from", (cb.gf(enemy, "x"), cb.gf(enemy, "y")))) : J.Val}
      +enemy = {signatures.stage(enemy, signatures.JUMP()) : J.Val}
      signatures.engine.k2(enemy, deeds)
    case False{}:
      +enemy = {signatures.stage(enemy, signatures.DAZED()) : J.Val}
      signatures.engine.k2(enemy, deeds)

def signatures.engine.if21(_c: Bool, +enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +enemy = {cb.sj(enemy, "signature", cb.su(cb.gj(enemy, "signature"), "left", RS.u_sat_sub(cb.gu(cb.gj(enemy, "signature"), "left"), 1))) : J.Val}
      signatures.engine.if22(U32.is_gt(cb.gu(cb.gj(enemy, "signature"), "left"), 0), enemy, deeds)
    case False{}:
      signatures.engine.k2(enemy, deeds)

def signatures.engine.k20(+enemy: J.Val, +deeds: J.Val, +stopped: Bool, +arrived: Bool) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  signatures.engine.if21(Bool.or(Bool.or(stopped, arrived), U32.is_ge(cb.gu(enemy, "timer"), 45)), enemy, deeds)

def signatures.engine.k24(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +deeds: J.Val, +stopped: Bool, +arrived: Bool) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+rbx, +rby) = _t
  +arrived = {(cb.hyp((rbx - cb.gf(enemy, "x") : F32), (rby - cb.gf(enemy, "y") : F32)) < 1.4 : F32) : Bool}
  signatures.engine.k20(enemy, deeds, stopped, arrived)

def signatures.engine.if23(_c: Bool, +enemy: J.Val, +deeds: J.Val, +rail: J.Val, +stopped: Bool, +arrived: Bool) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      signatures.engine.k24(cb.pair(J.get(rail, "b")), enemy, deeds, stopped, arrived)
    case False{}:
      signatures.engine.k20(enemy, deeds, stopped, arrived)

def signatures.engine.k19(+_t: Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>, +rail: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+enemy, (+deeds, +stopped)) = _t
  +arrived = {True{} : Bool}
  signatures.engine.if23(Bool.not(J.is_null(rail)), enemy, deeds, rail, stopped, arrived)

def signatures.engine.if27(_c: Bool, +enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +enemy = {signatures.stage(enemy, signatures.TELL()) : J.Val}
      +deeds = {cb.sj(deeds, "sounds", J.push(cb.gj(deeds, "sounds"), J.JS{"engine_whistle"})) : J.Val}
      signatures.engine.k2(enemy, deeds)
    case False{}:
      signatures.engine.k2(enemy, deeds)

def signatures.engine.k26(+enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  signatures.engine.if27(U32.is_ge(cb.gu(enemy, "timer"), 24), enemy, deeds)

def signatures.engine.k30(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +deeds: J.Val, +t: F32, +jx: F32, +jy: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+rax, +ray) = _t
  +enemy = {cb.sf(enemy, "x", (jx + (rax - jx : F32) * t : F32)) : J.Val}
  +enemy = {cb.sf(enemy, "y", (jy + (ray - jy : F32) * t : F32)) : J.Val}
  signatures.engine.k26(enemy, deeds)

def signatures.engine.k29(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +deeds: J.Val, +rail: J.Val, +t: F32) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  (+jx, +jy) = _t
  signatures.engine.k30(cb.pair(J.get(rail, "a")), enemy, deeds, t, jx, jy)

def signatures.engine.if28(_c: Bool, +enemy: J.Val, +deeds: J.Val, +rail: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +t = {RS.f_min((cb.f(cb.gu(enemy, "timer")) / 24.0 : F32), 1.0) : F32}
      signatures.engine.k29(cb.gp(cb.gj(enemy, "signature"), "jump_from"), enemy, deeds, rail, t)
    case False{}:
      signatures.engine.k26(enemy, deeds)

def signatures.engine.if31(_c: Bool, +enemy: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +enemy = {cb.sj(enemy, "signature", cb.sj(cb.gj(enemy, "signature"), "rails", J.JA{Nil{}})) : J.Val}
      +enemy = {signatures.stage(enemy, 0) : J.Val}
      signatures.engine.k2(enemy, deeds)
    case False{}:
      signatures.engine.k2(enemy, deeds)

def signatures.engine.if25(_c: Bool, +enemy: J.Val, +deeds: J.Val, +st: U32, +rail: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      signatures.engine.if28(Bool.not(J.is_null(rail)), enemy, deeds, rail)
    case False{}:
      signatures.engine.if31(Bool.and(U32.is_eq(st, signatures.DAZED()), U32.is_ge(cb.gu(enemy, "timer"), 36)), enemy, deeds)

def signatures.engine.if18(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +st: U32, +rail: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      signatures.engine.k19(signatures.dash(enemy, room, barred, 38.0, False{}, deeds), rail)
    case False{}:
      signatures.engine.if25(U32.is_eq(st, signatures.JUMP()), enemy, deeds, st, rail)

def signatures.engine.if13(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +deeds: J.Val, +st: U32, +rail: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      signatures.engine.if15(Bool.not(J.is_null(rail)), enemy, deeds, rail)
    case False{}:
      signatures.engine.if18(U32.is_eq(st, signatures.DASH()), enemy, room, barred, deeds, st, rail)

def signatures.engine.if3(_c: Bool, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val, +st: U32, +rail: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +tx = {cb.gf(enemy, "x") : F32}
      +ty = {cb.gf(enemy, "y") : F32}
      signatures.engine.if11(U32.is_gt(J.len(heroes), 0), enemy, boss, heroes, room, barred, seed, deeds, tx, ty)
    case False{}:
      signatures.engine.if13(Bool.and(U32.is_eq(st, signatures.TELL()), U32.is_ge(cb.gu(enemy, "timer"), signatures.RAIL_TELL())), enemy, room, barred, deeds, st, rail)

def signatures.engine.k1(+enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  +st = {cb.gu(enemy, "stage") : U32}
  +rail = {J.nth(cb.gj(cb.gj(enemy, "signature"), "rails"), cb.gu(cb.gj(enemy, "signature"), "rail")) : J.Val}
  signatures.engine.if3(U32.is_eq(st, 0), enemy, boss, heroes, room, barred, seed, deeds, st, rail)

def signatures.engine.loop33(+_xs: List<&2, U32>, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _xs:
    case Nil{}:
      signatures.engine.k1(enemy, boss, heroes, room, barred, seed, deeds)
    case Con{+k, +_t33}:
      +a = {(cb.f(k) * 1.5707964 : F32) : F32}
      +reach = {(monsters.Enemy.radius(enemy) + 2.0 : F32) : F32}
      +deeds = {foes.spawn(deeds, "spiderling", (cb.gf(enemy, "x") + F32.cos(a) * reach : F32), (cb.gf(enemy, "y") + F32.sin(a) * reach : F32), signatures.TENDER()) : J.Val}
      signatures.engine.loop33(_t33, enemy, boss, heroes, room, barred, seed, deeds)

def signatures.engine.if32(_c: Bool, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => J.Val>:
  match _c:
    case True{}:
      +enemy = {cb.sj(enemy, "signature", cb.sb(cb.gj(enemy, "signature"), "babies", True{})) : J.Val}
      signatures.engine.loop33(cb.range(4), enemy, boss, heroes, room, barred, seed, deeds)
    case False{}:
      signatures.engine.k1(enemy, boss, heroes, room, barred, seed, deeds)
