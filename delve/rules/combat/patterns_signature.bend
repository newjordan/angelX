    case True{}:
      cb.lit("{\"every\":110,\"damage\":12,\"chain\":[[\"gap_wall\",\"bone\"]]}")
    case False{}:
      patterns.signature.a45(k, p, e)

def patterns.signature.a45(+k: String, +p: String, +e: Bool) -> J.Val:
  patterns.signature.if45(Bool.and(String.eq(k, "spitter"), String.eq(p, "fungal")), k, p, e)

def patterns.signature.if45(hit: Bool, +k: String, +p: String, +e: Bool) -> J.Val:
  match hit:
    case True{}:
      cb.lit("{\"every\":130,\"damage\":12,\"chain\":[[\"split\",\"spore\"],[\"lob\",\"spore\"]]}")
    case False{}:
      patterns.signature.a46(k, p, e)

def patterns.signature.a46(+k: String, +p: String, +e: Bool) -> J.Val:
  patterns.signature.if46(Bool.and(String.eq(k, "slime"), String.eq(p, "fungal")), k, p, e)

def patterns.signature.if46(hit: Bool, +k: String, +p: String, +e: Bool) -> J.Val:
  match hit:
    case True{}:
      cb.lit("{\"every\":140,\"damage\":10,\"chain\":[[\"mines\",\"spore\"]]}")
    case False{}:
      patterns.signature.a47(k, p, e)

def patterns.signature.a47(+k: String, +p: String, +e: Bool) -> J.Val:
  patterns.signature.if47(String.eq(k, "hollow"), k, p, e)

def patterns.signature.if47(hit: Bool, +k: String, +p: String, +e: Bool) -> J.Val:
  match hit:
    case True{}:
      cb.lit("{\"every\":140,\"damage\":14,\"chain\":[[\"sweep\",\"eye\"]]}")
    case False{}:
      patterns.signature.a48(k, p, e)

def patterns.signature.a48(+k: String, +p: String, +e: Bool) -> J.Val:
  patterns.signature.if48(String.eq(k, "oathbound"), k, p, e)

def patterns.signature.if48(hit: Bool, +k: String, +p: String, +e: Bool) -> J.Val:
  match hit:
    case True{}:
      cb.lit("{\"every\":110,\"damage\":14,\"chain\":[[\"twin_spiral\",\"eye\"],[\"drift\",\"eye\"]]}")
    case False{}:
      patterns.signature.a49(k, p, e)

def patterns.signature.a49(+k: String, +p: String, +e: Bool) -> J.Val:
  patterns.signature.if49(True{}, k, p, e)

def patterns.signature.if49(hit: Bool, +k: String, +p: String, +e: Bool) -> J.Val:
  match hit:
    case True{}:
      J.JNull{}
    case False{}:
      J.JNull{}

def patterns.signature(+kind: String, +pack: String, +elite: Bool) -> J.Val:
  patterns.signature.a0(kind, pack, elite)

