def monsters.walker.k9(+_t: F32 & F32, +enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +mover: U32, +mx: F32, +my: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+ux, +uy) = _t
  +mx = {(ux * 6.5 * rules.DT() : F32) : F32}
  +my = {(uy * 6.5 * rules.DT() : F32) : F32}
  monsters.walker.k3(enemy, room, barred, shots, deeds, kind, target, mover, mx, my)

