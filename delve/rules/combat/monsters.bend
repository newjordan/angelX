  match _c:
    case True{}:
      +mx = {(cx * 1.8 * rules.DT() : F32) : F32}
      +my = {(cy * 1.8 * rules.DT() : F32) : F32}
      monsters.walker.k3(enemy, room, barred, shots, deeds, kind, target, mover, mx, my)
    case False{}:
      monsters.walker.if13(String.eq(kind, "imp"), enemy, room, barred, shots, deeds, kind, target, cx, cy, age, mover, mx, my)

def monsters.walker.if10(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +cx: F32, +cy: F32, +age: U32, +mover: U32, +mx: F32, +my: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +h = {cb.wander_mix(seed, cb.gu(enemy, "id"), (age / 90 : U32)) : W.W}
      +gx = {(cb.gf(enemy, "origin_x") + (cb.byte0(h) - 0.5 : F32) * 12.0 : F32) : F32}
      +gy = {(cb.gf(enemy, "origin_y") + (cb.byte1(h) - 0.5 : F32) * 8.0 : F32) : F32}
      monsters.walker.k11(rules.unit((gx - cb.gf(enemy, "x") : F32), (gy - cb.gf(enemy, "y") : F32)), enemy, room, barred, shots, deeds, kind, target, mover, mx, my)
    case False{}:
      monsters.walker.if12(Bool.or(String.eq(kind, "wraith"), String.eq(kind, "demon")), enemy, room, barred, shots, deeds, kind, target, cx, cy, age, mover, mx, my)

def monsters.walker.if8(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +cx: F32, +cy: F32, +age: U32, +mover: U32, +mx: F32, +my: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +wobble = {(F32.sin((cb.f(age) * 0.31 : F32)) * 0.9 : F32) : F32}
      monsters.walker.k9(rules.unit((cx - cy * wobble : F32), (cy + cx * wobble : F32)), enemy, room, barred, shots, deeds, kind, target, mover, mx, my)
    case False{}:
      monsters.walker.if10(String.eq(kind, "skeleton"), enemy, room, barred, seed, shots, deeds, kind, target, cx, cy, age, mover, mx, my)

def monsters.walker.k2(+_t: F32 & F32, +enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+cx, +cy) = _t
  +age = {(cb.gu(enemy, "age") + cb.gu(enemy, "id") * 13 : U32) : U32}
  +mover = {foes.mover(kind) : U32}
  +mx = {0.0 : F32}
  +my = {0.0 : F32}
  monsters.walker.if8(String.eq(kind, "bat"), enemy, room, barred, seed, shots, deeds, kind, target, cx, cy, age, mover, mx, my)

def monsters.walker.k1(+enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  monsters.walker.k2(rules.unit((tx - cb.gf(enemy, "x") : F32), (ty - cb.gf(enemy, "y") : F32)), enemy, room, barred, seed, shots, deeds, kind, target)

def monsters.walker.k17(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+tx, +ty) = _t
  monsters.walker.k1(enemy, room, barred, seed, shots, deeds, kind, target, tx, ty)

def monsters.walker.m16(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +enemy: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +kind: String, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _s:
    case Some{+t}:
      monsters.walker.k17(t, enemy, room, barred, seed, shots, deeds, kind, target)
    case None{}:
      +tx = {tx : F32}
      monsters.walker.k1(enemy, room, barred, seed, shots, deeds, kind, target, tx, ty)

# A guardian's step: its file's movement, then each of its attacks on their
# own beat, half again as often once its health falls below its rage.

def monsters.act_boss(+enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  monsters.act_boss.k1(signatures.act(enemy, boss, heroes, room, barred, seed, deeds), boss, heroes, room, barred, seed, shots)

def monsters.act_boss.k9(+enemy: J.Val, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (enemy, shots, deeds)

def monsters.act_boss.k15(+enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val, +kind: String, +n: U32, +_t14: List<&2, U32>, +angle: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +shots = {J.push(shots, patterns.Projectile.fresh(cb.gf(enemy, "x"), cb.gf(enemy, "y"), (F32.cos(angle) * cb.gf(attack, "speed") : F32), (F32.sin(angle) * cb.gf(attack, "speed") : F32), True{}, kind, cb.gu(attack, "damage"), (8 * rules.HZ() : U32), patterns.ShotTraits.default())) : J.Val}
  monsters.act_boss.loop14(_t14, enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, kind, n)

def monsters.act_boss.if19(_c: Bool, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val, +kind: String, +n: U32, +_t14: List<&2, U32>, +i: U32, +angle: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +angle = {(spin * 3.0 + cb.f(i) * cb.TAU() / cb.f(n) : F32) : F32}
      monsters.act_boss.k15(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, kind, n, _t14, angle)
    case False{}:
      monsters.act_boss.k15(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, kind, n, _t14, angle)

def monsters.act_boss.if18(_c: Bool, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val, +kind: String, +n: U32, +_t14: List<&2, U32>, +i: U32, +angle: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +angle = {(spin + cb.f(i) * cb.TAU() / cb.f(n) : F32) : F32}
      monsters.act_boss.k15(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, kind, n, _t14, angle)
    case False{}:
      monsters.act_boss.if19(String.eq(J.str(pat), "spiral"), enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, kind, n, _t14, i, angle)

def monsters.act_boss.if17(_c: Bool, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val, +kind: String, +n: U32, +_t14: List<&2, U32>, +i: U32, +angle: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +arc = {RS.f_to_radians(cb.gf(attack, "arc")) : F32}
      +angle = {(aim + arc * (cb.f(i) / cb.f(RS.u_max((n - 1 : U32), 1)) - 0.5 : F32) : F32) : F32}
      monsters.act_boss.k15(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, kind, n, _t14, angle)
    case False{}:
      monsters.act_boss.if18(String.eq(J.str(pat), "ring"), enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, kind, n, _t14, i, angle)

def monsters.act_boss.if16(_c: Bool, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val, +kind: String, +n: U32, +_t14: List<&2, U32>, +i: U32, +angle: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +angle = {(aim + (cb.f(i) - cb.f((n - 1 : U32)) / 2.0 : F32) * 0.06 : F32) : F32}
      monsters.act_boss.k15(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, kind, n, _t14, angle)
    case False{}:
      monsters.act_boss.if17(String.eq(J.str(pat), "fan"), enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, kind, n, _t14, i, angle)

def monsters.act_boss.loop14(+_xs: List<&2, U32>, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val, +kind: String, +n: U32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _xs:
    case Nil{}:
      monsters.act_boss.loop10(_t10, enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks)
    case Con{+i, +_t14}:
      +angle = {aim : F32}
      monsters.act_boss.if16(String.eq(J.str(pat), "aimed"), enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, kind, n, _t14, i, angle)

def monsters.act_boss.k13(+enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +kind = {bosses.Bolt.shot(cb.gs(attack, "bolt"), cb.gs(boss, "only_in")) : String}
  +n = {RS.u_max(cb.gu(attack, "shots"), 1) : U32}
  monsters.act_boss.loop14(cb.range(n), enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, kind, n)

def monsters.act_boss.k21(+enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  monsters.act_boss.loop10(_t10, enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks)

def monsters.act_boss.k23(+enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val, +ravage: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +deeds = {cb.sj(deeds, "ravages", J.push(cb.gj(deeds, "ravages"), ravage)) : J.Val}
  +deeds = {foes.cue(deeds, "ravage") : J.Val}
  monsters.act_boss.k21(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat)

def monsters.act_boss.if24(_c: Bool, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val, +ravage: J.Val, +art: String) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +ravage = {cb.sos0(ravage, "boss_art", Some{art}) : J.Val}
      monsters.act_boss.k23(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, ravage)
    case False{}:
      monsters.act_boss.k23(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, ravage)

def monsters.act_boss.if22(_c: Bool, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +beat = {W.xor(W.xor(seed, W.shl(W.of_u32(age), 12)), W.of_u32(cb.gu(enemy, "id"))) : W.W}
      +ravage = {tide.Ravage.cast(cb.gf(enemy, "x"), cb.gf(enemy, "y"), cb.gu(attack, "shots"), cb.gf(attack, "arc"), cb.gf(attack, "speed"), cb.gu(attack, "damage"), beat) : J.Val}
      +art = {bosses.Art.name_of(cb.gs(boss, "id")) : String}
      monsters.act_boss.if24(Bool.not(String.eq(art, "")), enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat, ravage, art)
    case False{}:
      monsters.act_boss.k21(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat)

def monsters.act_boss.if20(_c: Bool, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      monsters.act_boss.if22(Maybe.is_some(&2, Sigma<&2, &2, F32, _ => F32>, target), enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat)
    case False{}:
      monsters.act_boss.k13(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat)

def monsters.act_boss.k12(+enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  monsters.act_boss.if20(String.eq(J.str(pat), "ravage"), enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat)

def monsters.act_boss.if25(_c: Bool, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      monsters.act_boss.loop10(_t10, enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks)
    case False{}:
      monsters.act_boss.k12(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat)

def monsters.act_boss.k11(+enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +index: U32, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +every = {Bool.pick(U32, String.eq(stage, "rage"), RS.u_max((cb.gu(attack, "every") * 2 / 3 : U32), 4), RS.u_max(cb.gu(attack, "every"), 4)) : U32}
  monsters.act_boss.if25(Bool.not(U32.is_eq(U32.mod((age + index * 11 : U32), every), 0)), enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, attack, pat)

def monsters.act_boss.if26(_c: Bool, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val, +_t10: List<&2, U32>, +index: U32, +attack: J.Val, +pat: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      monsters.act_boss.loop10(_t10, enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks)
    case False{}:
      monsters.act_boss.k11(enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, index, attack, pat)

def monsters.act_boss.loop10(+_xs: List<&2, U32>, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +stage: String, +rank: U32, +attacks: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _xs:
    case Nil{}:
      monsters.act_boss.k9(enemy, shots, deeds)
    case Con{+index, +_t10}:
      +attack = {J.nth(attacks, index) : J.Val}
      +pat = {cb.gj(attack, "pattern") : J.Val}
      monsters.act_boss.if26(Bool.or(Bool.not(J.is_null(J.get(pat, "named"))), U32.is_gt(bosses.Stage.rank(cb.gs(attack, "from")), rank)), enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks, _t10, index, attack, pat)

def monsters.act_boss.k8(+_t: F32 & F32, +enemy: J.Val, +boss: J.Val, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+nx, +ny) = _t
  +enemy = {cb.sf(enemy, "x", nx) : J.Val}
  +enemy = {cb.sf(enemy, "y", ny) : J.Val}
  +stage = {bosses.Boss.stage(boss, cb.gu(enemy, "hp"), cb.gu(enemy, "max_hp")) : String}
  +rank = {bosses.Stage.rank(stage) : U32}
  +attacks = {cb.gj(boss, "attacks") : J.Val}
  monsters.act_boss.loop10(cb.range(J.len(attacks)), enemy, boss, seed, shots, deeds, target, aim, age, spin, stage, rank, attacks)

def monsters.act_boss.k7(+enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +mx: F32, +my: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +mover = {Bool.pick(U32, String.eq(cb.gs(boss, "moves"), "hover"), 2, 1) : U32}
  monsters.act_boss.k8(rules.Grid.slide(room, barred, (cb.gf(enemy, "x"), cb.gf(enemy, "y")), (mx, my), monsters.Enemy.radius(enemy), mover), enemy, boss, seed, shots, deeds, target, aim, age, spin)

def monsters.act_boss.k28(+_t: F32 & F32, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +speed: F32, +mx: F32, +my: F32, +ddx: F32, +ddy: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+ux, +uy) = _t
  +reach = {RS.f_min(cb.hyp(ddx, ddy), (speed * rules.DT() : F32)) : F32}
  +mx = {(ux * reach : F32) : F32}
  +my = {(uy * reach : F32) : F32}
  monsters.act_boss.k7(enemy, boss, room, barred, seed, shots, deeds, target, aim, age, spin, mx, my)

def monsters.act_boss.if27(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +gx: F32, +gy: F32, +speed: F32, +mx: F32, +my: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +ddx = {(gx - cb.gf(enemy, "x") : F32) : F32}
      +ddy = {(gy - cb.gf(enemy, "y") : F32) : F32}
      monsters.act_boss.k28(rules.unit(ddx, ddy), enemy, boss, room, barred, seed, shots, deeds, target, aim, age, spin, speed, mx, my, ddx, ddy)
    case False{}:
      monsters.act_boss.k7(enemy, boss, room, barred, seed, shots, deeds, target, aim, age, spin, mx, my)

def monsters.act_boss.k6(+enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +gx: F32, +gy: F32, +speed: F32, +anchored: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +mx = {0.0 : F32}
  +my = {0.0 : F32}
  monsters.act_boss.if27(Bool.not(anchored), enemy, boss, room, barred, seed, shots, deeds, target, aim, age, spin, gx, gy, speed, mx, my)

def monsters.act_boss.if31(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +gx: F32, +gy: F32, +speed: F32, +anchored: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +anchored = {True{} : Bool}
      monsters.act_boss.k6(enemy, boss, room, barred, seed, shots, deeds, target, aim, age, spin, gx, gy, speed, anchored)
    case False{}:
      monsters.act_boss.k6(enemy, boss, room, barred, seed, shots, deeds, target, aim, age, spin, gx, gy, speed, anchored)

def monsters.act_boss.if30(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +gx: F32, +gy: F32, +speed: F32, +anchored: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +gx = {((layout.Room.width(room) / 2.0 : F32) + F32.sin((cb.f(age) * 0.012 : F32)) * 16.0 : F32) : F32}
      +gy = {(cb.gf(enemy, "origin_y") + F32.sin((cb.f(age) * 0.03 : F32)) * 1.5 : F32) : F32}
      +speed = {RS.f_max(cb.gf(boss, "speed"), 1.0) : F32}
      monsters.act_boss.k6(enemy, boss, room, barred, seed, shots, deeds, target, aim, age, spin, gx, gy, speed, anchored)
    case False{}:
      monsters.act_boss.if31(String.eq(cb.gs(boss, "moves"), "anchor"), enemy, boss, room, barred, seed, shots, deeds, target, aim, age, spin, gx, gy, speed, anchored)

def monsters.act_boss.if29(_c: Bool, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +aim: F32, +age: U32, +spin: F32, +gx: F32, +gy: F32, +speed: F32, +anchored: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +h = {cb.wander_mix(seed, cb.gu(enemy, "id"), (age / 120 : U32)) : W.W}
      +gx = {(cb.gf(enemy, "origin_x") + (cb.byte0(h) - 0.5 : F32) * 18.0 : F32) : F32}
      +gy = {(cb.gf(enemy, "origin_y") + cb.byte1(h) * 9.0 : F32) : F32}
      monsters.act_boss.k6(enemy, boss, room, barred, seed, shots, deeds, target, aim, age, spin, gx, gy, speed, anchored)
    case False{}:
      monsters.act_boss.if30(String.eq(cb.gs(boss, "moves"), "hover"), enemy, boss, room, barred, seed, shots, deeds, target, aim, age, spin, gx, gy, speed, anchored)

def monsters.act_boss.k5(+enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +aim = {RS.f_atan2((ty - cb.gf(enemy, "y") : F32), (tx - cb.gf(enemy, "x") : F32)) : F32}
  +age = {cb.gu(enemy, "age") : U32}
  +spin = {(cb.f(age) * 0.035 + cb.f(W.rem_u32(seed, 17)) * 0.1 : F32) : F32}
  +gx = {tx : F32}
  +gy = {ty : F32}
  +speed = {cb.gf(boss, "speed") : F32}
  +anchored = {False{} : Bool}
  monsters.act_boss.if29(String.eq(cb.gs(boss, "moves"), "drift"), enemy, boss, room, barred, seed, shots, deeds, target, aim, age, spin, gx, gy, speed, anchored)

def monsters.act_boss.k33(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+tx, +ty) = _t
  monsters.act_boss.k5(enemy, boss, room, barred, seed, shots, deeds, target, tx, ty)

def monsters.act_boss.m32(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +enemy: J.Val, +boss: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _s:
    case Some{+t}:
      monsters.act_boss.k33(t, enemy, boss, room, barred, seed, shots, deeds, target)
    case None{}:
      +tx = {tx : F32}
      monsters.act_boss.k5(enemy, boss, room, barred, seed, shots, deeds, target, tx, ty)

def monsters.act_boss.k4(+enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +target = {cb.nearest2(heroes, cb.gf(enemy, "x"), cb.gf(enemy, "y")) : Maybe<&2, Sigma<&2, &2, F32, _ => F32>>}
  +tx = {cb.gf(enemy, "x") : F32}
  +ty = {(cb.gf(enemy, "y") + 1.0 : F32) : F32}
  monsters.act_boss.m32(target, enemy, boss, room, barred, seed, shots, deeds, target, tx, ty)

def monsters.act_boss.if34(_c: Bool, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      (enemy, shots, deeds)
    case False{}:
      monsters.act_boss.k4(enemy, boss, heroes, room, barred, seed, shots, deeds)

def monsters.act_boss.k3(+_t: Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+enemy, (+deeds, +busy)) = _t
  monsters.act_boss.if34(busy, enemy, boss, heroes, room, barred, seed, shots, deeds)

def monsters.act_boss.k2(+enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +busy: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  monsters.act_boss.k3(signatures.wind(enemy, boss, heroes, room, barred, seed, deeds), boss, heroes, room, barred, seed, shots)

def monsters.act_boss.if35(_c: Bool, +enemy: J.Val, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val, +busy: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      (enemy, shots, deeds)
    case False{}:
      monsters.act_boss.k2(enemy, boss, heroes, room, barred, seed, shots, deeds, busy)

def monsters.act_boss.k1(+_t: Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>, +boss: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+enemy, (+deeds, +busy)) = _t
  monsters.act_boss.if35(busy, enemy, boss, heroes, room, barred, seed, shots, deeds, busy)
