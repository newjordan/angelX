      monsters.walker.k3(enemy, room, barred, shots, deeds, kind, target, mover, mx, my)
    case False{}:
      monsters.walker.if14(String.eq(kind, "dragon"), enemy, room, barred, shots, deeds, kind, target, cx, cy, age, mover, mx, my)

