  match _s:
    case Some{+bi}:
      monsters.act.if30(U32.is_lt(bi, J.len(bosses)), enemy, heroes, room, barred, seed, bosses, shots, deeds, bi)
    case None{}:
      +shots = {shots : J.Val}
      monsters.act.k1(enemy, heroes, room, barred, seed, shots, deeds)

