def monsters.walker.if15(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +cx: F32, +cy: F32, +mover: U32, +mx: F32, +my: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
