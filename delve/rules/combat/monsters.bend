def monsters.walker.if14(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +cx: F32, +cy: F32, +age: U32, +mover: U32, +mx: F32, +my: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  match _c:
    case True{}:
      +gx = {(cb.gf(enemy, "origin_x") + F32.sin((cb.f(age) * 0.02 : F32)) * 12.0 : F32) : F32}
      +gy = {(cb.gf(enemy, "origin_y") + F32.sin((cb.f(age) * 0.014 : F32)) * 2.0 : F32) : F32}
      +mx = {(gx - cb.gf(enemy, "x") : F32) : F32}
      +my = {(gy - cb.gf(enemy, "y") : F32) : F32}
      monsters.walker.k3(enemy, room, barred, shots, deeds, kind, target, mover, mx, my)
    case False{}:
      monsters.walker.if15(Bool.and(String.eq(kind, "mimic"), U32.is_lt(U32.mod(age, 36), 14)), enemy, room, barred, shots, deeds, kind, target, cx, cy, mover, mx, my)

