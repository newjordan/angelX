def monsters.walker.k4(+_t: F32 & F32, +enemy: J.Val, +shots: J.Val, +deeds: J.Val, +kind: String, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  (+nx, +ny) = _t
  +enemy = {cb.sf(enemy, "x", nx) : J.Val}
  +enemy = {cb.sf(enemy, "y", ny) : J.Val}
  monsters.walker.if6(String.eq(kind, "dragon"), enemy, shots, deeds, target)

def monsters.walker.k3(+enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +target: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +mover: U32, +mx: F32, +my: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
