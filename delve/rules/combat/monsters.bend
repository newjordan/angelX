def monsters.walker(+enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +seed: W.W, +shots: J.Val, +deeds: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
