# A blow struck the raised shield; true if it knocked the shield aside.

def critters.guard_struck(+enemy: J.Val, +damage: U32) -> Sigma<&2, &2, J.Val, _ => Bool>:
  +enemy = {cb.su0(enemy, "guard", RS.u_sat_add(cb.gu(enemy, "guard"), RS.u_max(damage, 1))) : J.Val}
  critters.guard_struck.if2(U32.is_lt((cb.gu(enemy, "guard") * 100 : U32), (RS.u_max(cb.gu(enemy, "max_hp"), 1) * critters.GUARD_BREAK() : U32)), enemy)

def critters.guard_struck.k1(+enemy: J.Val) -> Sigma<&2, &2, J.Val, _ => Bool>:
  +enemy = {cb.su0(enemy, "guard", 0) : J.Val}
  +enemy = {cb.su(enemy, "stage", 3) : J.Val}
  +enemy = {cb.su(enemy, "timer", RS.u_sat_sub(critters.PAVISE_PANT(), critters.GUARD_DOWN())) : J.Val}
  (enemy, True{})

def critters.guard_struck.if2(_c: Bool, +enemy: J.Val) -> Sigma<&2, &2, J.Val, _ => Bool>:
  match _c:
    case True{}:
      (enemy, False{})
    case False{}:
      critters.guard_struck.k1(enemy)

# Does the raised shield turn a shot flying (vx, vy)?

def critters.blocks(+enemy: J.Val, +vx: F32, +vy: F32) -> Bool:
  critters.blocks.m1(critters.Enemy.shield_up(enemy), vx, vy)

def critters.blocks.k2(+_t: Sigma<&2, &2, F32, _ => F32>, +vx: F32, +vy: F32) -> Bool:
  (+fx, +fy) = _t
  +speed = {RS.f_max(cb.hyp(vx, vy), 0.001) : F32}
  (RS.f_neg((vx * fx + vy * fy : F32)) / speed >= F32.cos(RS.f_to_radians(critters.PAVISE_ARC())) : F32)

def critters.blocks.m1(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +vx: F32, +vy: F32) -> Bool:
  match _s:
    case None{}:
      False{}
    case Some{+f}:
      critters.blocks.k2(f, vx, vy)

# A ring of bell strikes quickens a monster: it covers half again its step.

