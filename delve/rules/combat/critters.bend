def critters.act.loop106(+_xs: List<&2, U32>, +enemy: J.Val, +shots: J.Val, +deeds: J.Val, +turn: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  match _xs:
