    case False{}:
      critters.Enemy.touch.k1(enemy)

def critters.Enemy.latched(+enemy: J.Val) -> Bool:
  Bool.and(String.eq(cb.gs(enemy, "kind"), "leech"), U32.is_eq(cb.gu(enemy, "stage"), 3))

def critters.Enemy.hurts_by_touch(+enemy: J.Val) -> Bool:
  +charge = {Bool.and(U32.is_ne(cb.gu(cb.gj(enemy, "signature"), "blow"), 0), U32.is_eq(cb.gu(enemy, "stage"), signatures.DASH())) : Bool}
  +busy = {Bool.and(cb.gb(cb.gj(enemy, "signature"), "active"), Bool.or(Bool.or(U32.is_eq(cb.gu(enemy, "stage"), signatures.TELL()), U32.is_eq(cb.gu(enemy, "stage"), signatures.JUMP())), Bool.or(U32.is_eq(cb.gu(enemy, "stage"), signatures.DAZED()), U32.is_eq(cb.gu(enemy, "stage"), signatures.WIND())))) : Bool}
  Bool.and(Bool.and(Bool.not(critters.Enemy.buried(enemy)), Bool.not(critters.Enemy.latched(enemy))), Bool.and(Bool.not(charge), Bool.not(busy)))

# The way a raised tower shield faces, if it is up.

