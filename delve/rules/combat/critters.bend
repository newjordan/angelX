# A bog hand under the mire (horrors::sunk).

def horrors.Enemy.sunk(+enemy: J.Val) -> Bool:
  Bool.and(String.eq(cb.gs(enemy, "kind"), "bog_hand"), U32.is_lt(cb.gu(enemy, "stage"), 2))

def critters.Enemy.buried(+enemy: J.Val) -> Bool:
  Bool.or(Bool.and(String.eq(cb.gs(enemy, "kind"), "mole"), Bool.or(U32.is_eq(cb.gu(enemy, "stage"), 1), U32.is_eq(cb.gu(enemy, "stage"), 2))), horrors.Enemy.sunk(enemy))

def critters.Enemy.touch(+enemy: J.Val) -> U32:
  critters.Enemy.touch.if4(String.eq(cb.gs(enemy, "kind"), "biter"), enemy)

