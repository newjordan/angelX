    case False{}:
      critters.act.if21(String.eq(kind, "mole"), enemy, room, barred, shots, deeds, kind, seen, tx, ty, cx, cy, dist, mover, r, beat)

def critters.act.k3(+_t: F32 & F32, +enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  (+cx, +cy) = _t
  +dist = {cb.hyp((tx - cb.gf(enemy, "x") : F32), (ty - cb.gf(enemy, "y") : F32)) : F32}
  +mover = {foes.mover(kind) : U32}
  +r = {monsters.Enemy.radius(enemy) : F32}
  +enemy = {cb.su(enemy, "timer", RS.u_sat_add(cb.gu(enemy, "timer"), 1)) : J.Val}
  +beat = {RS.u_sat_add(cb.gu(enemy, "timer"), RS.u_sat_mul(cb.gu(enemy, "id"), 7)) : U32}
  critters.act.if5(Bool.or(String.eq(kind, "biter"), String.eq(kind, "shard")), enemy, room, barred, shots, deeds, kind, seen, tx, ty, cx, cy, dist, mover, r, beat)

def critters.act.k2(+enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  critters.act.k3(rules.unit((tx - cb.gf(enemy, "x") : F32), (ty - cb.gf(enemy, "y") : F32)), enemy, room, barred, shots, deeds, kind, seen, tx, ty)

def critters.act.k128(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  (+tx, +ty) = _t
  critters.act.k2(enemy, room, barred, shots, deeds, kind, seen, tx, ty)

def critters.act.m127(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  match _s:
    case Some{+t}:
      critters.act.k128(t, enemy, room, barred, shots, deeds, kind, seen)
    case None{}:
      +tx = {tx : F32}
      critters.act.k2(enemy, room, barred, shots, deeds, kind, seen, tx, ty)

def critters.act.k1(+enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  +target = {cb.nearest2(heroes, cb.gf(enemy, "x"), cb.gf(enemy, "y")) : Maybe<&2, Sigma<&2, &2, F32, _ => F32>>}
  +seen = {Maybe.is_some(&2, Sigma<&2, &2, F32, _ => F32>, target) : Bool}
  +tx = {cb.gf(enemy, "x") : F32}
  +ty = {(cb.gf(enemy, "y") + 1.0 : F32) : F32}
  critters.act.m127(target, enemy, room, barred, shots, deeds, kind, seen, tx, ty)

def critters.act.if129(_c: Bool, +enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  match _c:
    case True{}:
      (enemy, shots, deeds, False{})
    case False{}:
      critters.act.k1(enemy, heroes, room, barred, shots, deeds, kind)
