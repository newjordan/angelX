    case False{}:
      horrors.act.if25(String.eq(kind, "wisp"), enemy, room, barred, shots, deeds, seen, cx, cy, dist, mover, r)

def horrors.act.if5(_c: Bool, +enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +cx: F32, +cy: F32, +dist: F32, +mover: U32, +r: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  match _c:
    case True{}:
      horrors.act.if6(U32.is_eq(cb.gu(enemy, "stage"), 0), enemy, room, barred, shots, deeds, seen, cx, cy, dist, mover, r)
    case False{}:
      horrors.act.if13(String.eq(kind, "drowned"), enemy, room, barred, shots, deeds, kind, seen, cx, cy, dist, mover, r)

def horrors.act.k3(+_t: F32 & F32, +enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  (+cx, +cy) = _t
  +dist = {cb.hyp((tx - cb.gf(enemy, "x") : F32), (ty - cb.gf(enemy, "y") : F32)) : F32}
  +mover = {Bool.pick(U32, monsters.EnemyKind.flies(kind), 2, 3) : U32}
  +r = {monsters.Enemy.radius(enemy) : F32}
  +enemy = {cb.su(enemy, "timer", (cb.gu(enemy, "timer") + 1 : U32)) : J.Val}
  horrors.act.if5(String.eq(kind, "bog_hand"), enemy, room, barred, shots, deeds, kind, seen, cx, cy, dist, mover, r)

def horrors.act.k2(+enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  horrors.act.k3(rules.unit((tx - cb.gf(enemy, "x") : F32), (ty - cb.gf(enemy, "y") : F32)), enemy, room, barred, shots, deeds, kind, seen, tx, ty)

def horrors.act.k40(+_t: Sigma<&2, &2, F32, _ => F32>, +enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  (+tx, +ty) = _t
  horrors.act.k2(enemy, room, barred, shots, deeds, kind, seen, tx, ty)

def horrors.act.m39(+_s: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +enemy: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String, +seen: Bool, +tx: F32, +ty: F32) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  match _s:
    case Some{+t}:
      horrors.act.k40(t, enemy, room, barred, shots, deeds, kind, seen)
    case None{}:
      +tx = {tx : F32}
      horrors.act.k2(enemy, room, barred, shots, deeds, kind, seen, tx, ty)

def horrors.act.k1(+enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  +target = {cb.nearest2(heroes, cb.gf(enemy, "x"), cb.gf(enemy, "y")) : Maybe<&2, Sigma<&2, &2, F32, _ => F32>>}
  +seen = {Maybe.is_some(&2, Sigma<&2, &2, F32, _ => F32>, target) : Bool}
  +tx = {cb.gf(enemy, "x") : F32}
  +ty = {(cb.gf(enemy, "y") + 1.0 : F32) : F32}
  horrors.act.m39(target, enemy, room, barred, shots, deeds, kind, seen, tx, ty)

def horrors.act.if41(_c: Bool, +enemy: J.Val, +heroes: J.Val, +room: J.Val, +barred: Bool, +shots: J.Val, +deeds: J.Val, +kind: String) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => Bool>>>:
  match _c:
    case True{}:
      (enemy, shots, deeds, False{})
    case False{}:
      horrors.act.k1(enemy, heroes, room, barred, shots, deeds, kind)
