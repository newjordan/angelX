import Base

# The states an outlaw shoots in.

def outlaw.shooting(+stage: U32) -> Bool:
  Bool.or(Bool.or(U32.is_eq(stage, outlaw.STRAFE()), U32.is_eq(stage, outlaw.PERCH())), U32.is_eq(stage, outlaw.COVER()))

def outlaw.pattern_pace(+stage: U32) -> U32:
  Bool.pick(U32, U32.is_eq(stage, outlaw.COVER()), 2, 1)

# Whether `enemy` is the hall's outlaw, steering itself (gravity and all).

def outlaw.own_gravity(+enemy: J.Val, +room: J.Val) -> Bool:
  Bool.and(String.eq(cb.gs(room, "kind"), "wanted"), Bool.not(J.is_null(J.get(enemy, "boss"))))
