# `mix(seed ^ id << 20 ^ k)`, the hash a wander is chosen by.

def cb.wander_mix(+seed: W.W, +id: U32, +k: U32) -> W.W:
  rules.mix(W.xor(W.xor(seed, W.shl(W.of_u32(id), 20)), W.of_u32(k)))

# (h & 0xff) as f32 / 255.0 and ((h >> 8) & 0xff) as f32 / 255.0

def cb.byte0(+h: W.W) -> F32:
  (cb.f(U32.and(W.lo32(h), 255)) / 255.0 : F32)

def cb.byte1(+h: W.W) -> F32:
  (cb.f(U32.and(W.lo32(W.shr(h, 8)), 255)) / 255.0 : F32)

# A hostile shot of the monsters' plain sort (default traits).

def foes.fire(+shots: J.Val, +x: F32, +y: F32, +angle: F32, +speed: F32, +kind: String, +damage: U32) -> J.Val:
  J.push(shots, patterns.Projectile.fresh(x, y, (F32.cos(angle) * speed : F32), (F32.sin(angle) * speed : F32), True{}, kind, damage, (8 * rules.HZ() : U32), patterns.ShotTraits.default()))

# `Mover::Flier` (2) for a flier, else `Walker` (1).

def foes.mover(+kind: String) -> U32:
  Bool.pick(U32, monsters.EnemyKind.flies(kind), 2, 1)

# rules::unit as a reusable pair.

def cb.unit(+x: F32, +y: F32) -> Sigma<&2, &2, F32, _ => F32>:
  cb.unit.k1(rules.unit(x, y))

def cb.unit.k1(+_t: F32 & F32) -> Sigma<&2, &2, F32, _ => F32>:
  (+a, +b) = _t
  (a, b)
