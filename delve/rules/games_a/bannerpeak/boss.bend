  +boss = bannerpeak.oracle.rest.if2(U32.is_gt(J.len(near), 0), boss, near, elapsed)
  +boss = bannerpeak.oracle.rest.if6(U32.is_eq(J.u32(J.get(boss, "t")), 0), boss, near, seats, elapsed, crowd)
