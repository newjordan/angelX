  bannerpeak.boss.Boss.shape(J.get(input, "boss"))

def case.bannerpeak.boss.Boss.seated(+input: J.Val) -> J.Val:
  bannerpeak.boss.Boss.seated(J.get(input, "boss"), J.u32(J.get(input, "was")), J.u32(J.get(input, "now")))

