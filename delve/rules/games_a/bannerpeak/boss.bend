      +f : U32 = bannerpeak.boss.floor()
      +n : U32 = 1
      +n = bannerpeak.oracle.strike.if1(U32.is_ge(J.u32(J.get(boss, "phase")), 1), n)
      +_t1 = bannerpeak.oracle.strike_waves(boss, 0, n, f)
