      +b = J.set(b, "y", J.of_i32((J.u32(J.get(b, "y")) + RS.i_clamp((((J.u32(J.get(J.nth(mates, m), "fy")) - 20 : U32) * 256 : U32) - J.u32(J.get(b, "y")) : U32), 4294967280, 16) : U32)))
      +k = J.set(k, "bubble", b)
      +self = J.set(self, "seats", bannerpeak.u.put(J.get(self, "seats"), id, k))
      (k, self)
    case False{}:
