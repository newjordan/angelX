    case False{}:
      +k = J.set(k, "pips", J.JU{RS.u_sat_sub(J.u32(J.get(k, "pips")), 1)})
      +k = J.set(k, "chain", J.JU{0})
      +k = J.set(k, "carry", J.JBool{False{}})
      +say = J.push(say, J.JS{"hit"})
      +_t1 : Sigma<&2, &2, U32, _ => U32> = bannerpeak.body.Body.foot(J.get(k, "body"))
