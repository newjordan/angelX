      +k = J.set(k, "body", J.set(J.get(k, "body"), "vy", J.of_i32(0)))
      +k = J.set(k, "body", J.set(J.get(k, "body"), "mode", J.JS{"Air"}))
      +k = J.set(k, "body", J.set(J.get(k, "body"), "ground", J.JBool{False{}}))
      +k = J.set(k, "body", J.set(J.get(k, "body"), "plank", J.JNull{}))
