def bannerpeak.session.Session.touch_board(+self: J.Val, +k: J.Val, +bits: U32, +fx: U32, +fy: U32, +say: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
