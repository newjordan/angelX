def bannerpeak.session.Session.slam(+self: J.Val, +id: U32, +k: J.Val, +x: U32, +y: U32, +radius: U32, +say: J.Val) -> Sigma<&2, &2, J.Val, _ => Sigma<&2, &2, J.Val, _ => J.Val>>:
  +_t1 = bannerpeak.session.Session.fx(self, "Ring", x, y)
