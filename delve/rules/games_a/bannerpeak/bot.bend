def bannerpeak.bot.Session.fight.if13(bpc: Bool, +bo: J.Val, +b: J.Val, +fx: U32, +fy: U32, +held_jump: Bool, +held_down: Bool, +floor: U32, +ground: Bool, +lo: U32, +hi: U32, +on_head: Bool, +dx: U32) -> J.Val:
  match bpc:
