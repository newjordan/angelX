      +creep = bannerpeak.bot.Session.drive.if4(RS.i_lt(RS.i_abs(J.u32(J.get(b, "vx"))), 150), d, creep)
      bannerpeak.bot.Session.drive.if5(RS.i_le(RS.i_abs(dx), 5), creep)

