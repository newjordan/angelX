def bannerpeak.bot.Session.kick_go.if2(bpc: Bool, +self: J.Val, +side: U32, +n: U32, +wait: U32, +limit: U32, +tx: U32, +ty: U32, +bb: J.Val) -> Bool:
  match bpc:
