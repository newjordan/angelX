    case False{}:
      bannerpeak.bot.Session.drop_floor(self, foot_ahead, fy, (r + 1 : U32))

def bannerpeak.bot.Session.drop_floor.if2(bpc: Bool, +self: J.Val, +foot_ahead: U32, +fy: U32, +r: U32) -> Bool:
  match bpc:
