# The boss flashes bright on this tick of the run.

def desperate.Enemy.flashing(+e: J.Val, +tick: W.W) -> Bool:
  desperate.Enemy.flashing.m1(desperate.Enemy.flash_every(e), tick)

def desperate.Enemy.flashing.m1(+s: Maybe<&2, U32>, +tick: W.W) -> Bool:
  match s:
    case Some{+every}:
      U32.is_zero(U32.mod(U32.div(W.lo32(tick), every), 2))
