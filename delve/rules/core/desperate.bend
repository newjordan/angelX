# A guardian, the dragon or the Pit Lord.

def desperate.Enemy.is_boss(+e: J.Val) -> Bool:
  +k = {core.s(e, "kind") : String}
  Bool.or(Bool.not(J.is_null(J.get(e, "boss"))), Bool.or(String.eq(k, "dragon"), String.eq(k, "pit_tyrant")))

# 0 until a boss is under a third of its health, then rising to 1 at the last of it.

def desperate.Enemy.desperation(+e: J.Val) -> F32:
  +hp = {core.u(e, "hp") : U32}
  +mx = {core.u(e, "max_hp") : U32}
