  match _c:
    case True{}:
      0.0
    case False{}:
      desperate.Enemy.desperation.k1(hp, mx)

# Ticks between the flash's turns, if it is flashing.

def desperate.Enemy.flash_every(+e: J.Val) -> Maybe<&2, U32>:
  +d = {desperate.Enemy.desperation(e) : F32}
  desperate.Enemy.flash_every.if2(F32.is_gt(d, 0.0), d)

