  gear.stage.if3(U32.is_le((hp * 100 : U32), (max_hp * gear.HELM_OFF() : U32)))

def gear.stage.if4(_c: Bool, +hp: U32, +max_hp: U32) -> U32:
  match _c:
    case True{}:
      2
    case False{}:
      gear.stage.k1(hp, max_hp)

