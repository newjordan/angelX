# crates/delve/src/rules/fortune.rs — Dame Fortune's Wheel: the delve's game modes.
# A `Mode` is its snake_case word (the serde spelling), a String.

# The wheel's wedges, clockwise from the top.
def fortune.Mode.wheel(i: U32) -> String:
    if U32.is_eq(i, 0):
        return "long_way_down"
    if U32.is_eq(i, 1):
        return "lights_out"
    if U32.is_eq(i, 2):
        return "collapse"
    if U32.is_eq(i, 3):
        return "giants_feast"
    if U32.is_eq(i, 4):
        return "hold_the_stair"
    if U32.is_eq(i, 5):
        return "mimic_fair"
    if U32.is_eq(i, 6):
        return "glass_jaw"
    if U32.is_eq(i, 7):
        return "gauntlet"
    if U32.is_eq(i, 8):
        return "turbo"
    if U32.is_eq(i, 9):
        return "rune_rush"
    if U32.is_eq(i, 10):
        return "all_random"
    if U32.is_eq(i, 11):
        return "ironman"
    if U32.is_eq(i, 12):
        return "hollow_walls"
    return "open_floors"

def fortune.Mode.name(word: String) -> String:
    if String.eq(word, "lights_out"):
        return "Lights Out"
    if String.eq(word, "collapse"):
        return "The Collapse"
    if String.eq(word, "giants_feast"):
        return "Giant's Feast"
    if String.eq(word, "hold_the_stair"):
        return "Hold the Stair"
    if String.eq(word, "mimic_fair"):
        return "Mimic Fair"
    if String.eq(word, "glass_jaw"):
        return "Glass Jaw"
    if String.eq(word, "gauntlet"):
        return "Gauntlet of Guardians"
    if String.eq(word, "turbo"):
        return "Turbo"
    if String.eq(word, "rune_rush"):
        return "Rune Rush"
    if String.eq(word, "all_random"):
        return "All Random"
    if String.eq(word, "ironman"):
        return "Ironman"
    if String.eq(word, "hollow_walls"):
        return "Hollow Walls"
    if String.eq(word, "open_floors"):
        return "Open Floors"
    return "The Long Way Down"

def fortune.Mode.says(word: String) -> String:
    if String.eq(word, "lights_out"):
        return "dark but for lanterns: 1.5x spoils"
    if String.eq(word, "collapse"):
        return "floors fall in: 2x spoils"
    if String.eq(word, "giants_feast"):
        return "giant monsters: 1.5x spoils"
    if String.eq(word, "hold_the_stair"):
        return "a horde a floor: 2x spoils"
    if String.eq(word, "mimic_fair"):
        return "a chest in every won room"
    if String.eq(word, "glass_jaw"):
        return "all hits double: 2x spoils"
    if String.eq(word, "gauntlet"):
        return "straight to the guardians"
    if String.eq(word, "turbo"):
        return "everything a third faster: 2x spoils"
    if String.eq(word, "rune_rush"):
        return "a rune every fight, and more"
    if String.eq(word, "all_random"):
        return "a stranger's ultimate, half charged"
    if String.eq(word, "ironman"):
        return "no second winds: 3x spoils"
    if String.eq(word, "hollow_walls"):
        return "a vault on every floor"
    if String.eq(word, "open_floors"):
        return "no doors between fights: explore"
    return "the delve as it always was"

# How far up Fortune's ladder the wedge sits.
def fortune.Mode.rung(word: String) -> U32:
    if Bool.or(String.eq(word, "collapse"), String.eq(word, "glass_jaw")):
        return 1
    if Bool.or(String.eq(word, "hold_the_stair"), String.eq(word, "gauntlet")):
        return 2
    if Bool.or(Bool.or(String.eq(word, "turbo"), String.eq(word, "rune_rush")), String.eq(word, "all_random")):
        return 3
    if Bool.or(String.eq(word, "ironman"), String.eq(word, "hollow_walls")):
        return 4
    return 0

# What the mode pays: (times, over).
def fortune.Mode.spoils(word: String) -> (U32, U32):
    if Bool.or(String.eq(word, "lights_out"), String.eq(word, "giants_feast")):
        return (3, 2)
    if Bool.or(Bool.or(String.eq(word, "collapse"), String.eq(word, "glass_jaw")), Bool.or(String.eq(word, "hold_the_stair"), String.eq(word, "turbo"))):
        return (2, 1)
    if String.eq(word, "ironman"):
        return (3, 1)
    return (1, 1)

def fortune.Mode.collapse_secs(depth: U32) -> U32:
    return (120 + 30 * depth : U32)

# The wedges a level of Fortune's ladder opens.
def fortune.open_wedges(level: U32) -> [U32]:
    out: [U32] = []
    i: U32 = 0
    while U32.is_lt(i, 14):
        if U32.is_le(fortune.Mode.rung(fortune.Mode.wheel(i)), level):
            out = List.append(&2, U32, out, [i])
        i = (i + 1 : U32)
    return out

# Turbo: down in the delve, one tick in four comes free, so every three steps
# of play run four ticks of the delve.
def fortune.Run.turbo(run: J.Val) -> Bool:
    return Bool.and(fortune.Run.turbo_on(run), U32.is_eq(W.rem_u32(W.of_j(J.get(run, "tick")), 4), 3))

def fortune.Run.turbo_on(run: J.Val) -> Bool:
    return Bool.and(String.eq(core.s(run, "mode"), "turbo"), U32.is_ne(rules.Run.floor(run), 0))

# Glass Jaw: the knights hit and are hit twice as hard.
def fortune.Run.harden(run: J.Val) -> J.Val:
    glass: Bool = String.eq(core.s(run, "mode"), "glass_jaw")
    players: J.Val = J.get(run, "players")
    for (k: String, h: J.Val) in J.fields(players):
        players = J.set(players, k, core.set_b(h, "glass", glass))
    return J.set(run, "players", players)

# No second winds at all (the Pit's Talisman aside).
def fortune.Run.iron(run: J.Val) -> J.Val:
    if Bool.not(String.eq(core.s(run, "mode"), "ironman")):
        return run
    players: J.Val = J.get(run, "players")
    for (k: String, h: J.Val) in J.fields(players):
        players = J.set(players, k, core.set_u(h, "winds", 0))
    return J.set(run, "players", players)

# All Random: every knight's ultimate comes half charged.
def fortune.Run.half_charge(run: J.Val) -> J.Val:
    if Bool.not(String.eq(core.s(run, "mode"), "all_random")):
        return run
    players: J.Val = J.get(run, "players")
    for (k: String, h: J.Val) in J.fields(players):
        players = J.set(players, k, core.set_u(h, "ult_charge", U32.max(core.u(h, "ult_charge"), U32.div(ults.ULT_FULL(), 2))))
    return J.set(run, "players", players)

# `ticks` ticks from now, a Fx::Shake event pushed.
def core.push_shake(run: J.Val, ticks: U32) -> J.Val:
    return J.set(run, "fx", J.push(J.get(run, "fx"), J.set(J.obj(), "Shake", J.JU{ticks})))

def core.push_cue(run: J.Val, cue: String) -> J.Val:
    return J.set(run, "cues", J.push(J.get(run, "cues"), J.JS{cue}))

def core.push_sound(run: J.Val, sound: String) -> J.Val:
    return J.set(run, "sounds", J.push(J.get(run, "sounds"), J.JS{sound}))

# The Collapse: the tick this floor falls in; rocks come down on the living.
def fortune.Run.tick_collapse(run: J.Val) -> J.Val:
    if Bool.or(Bool.not(String.eq(core.s(run, "mode"), "collapse")), home.Run.at_home_now(run)):
        return run
    if J.is_null(J.get(run, "collapse_at")):
        return run
    at: W.W = W.of_j(J.get(run, "collapse_at"))
    tick: W.W = W.of_j(J.get(run, "tick"))
    warn: W.W = W.sat_sub(at, W.of_u32((30 * rules.HZ() : U32)))
    if W.eq(tick, warn):
        run = core.push_cue(run, "collapse_warn")
    if Bool.or(W.lt(tick, at), Bool.not(rules.Run.active(run))):
        return run
    if W.eq(tick, at):
        run = core.push_cue(run, "collapse")
        run = core.push_shake(run, 20)
    living: [J.Val] = []
    for (k: String, h: J.Val) in J.int_fields(J.get(run, "players")):
        if Bool.and(U32.is_ne(core.u(h, "hp"), 0), Bool.not(core.b(h, "stone"))):
            living = List.append(&2, J.Val, living, [core.pair_f(core.f(h, "x"), core.f(h, "y"))])
    past: W.W = W.div_u32(W.sub(tick, at), rules.HZ())
    every: U32 = U32.max(core.usub(24, W.lo32(past)), 8)
    if Bool.or(U32.is_zero(U32.from_nat(List.length(&2, J.Val, living))), Bool.or(U32.is_ne(W.rem_u32(tick, every), 0), U32.is_ge(core.count(J.get(run, "rocks")), 10))):
        return run
    n: U32 = U32.from_nat(List.length(&2, J.Val, living))
    (rng1: W.W, pick: U32) = loot.Rng.below(W.of_j(J.get(run, "rng")), n)
    spot: J.Val = core.or_else(J.nth(J.JA{living}, pick), J.JNull{})
    (rng2: W.W, jx: U32) = loot.Rng.below(rng1, 81)
    (rng3: W.W, jy: U32) = loot.Rng.below(rng2, 81)
    w: F32 = layout.Room.width(rules.Run.room(run))
    h: F32 = layout.Room.height(rules.Run.room(run))
    x: F32 = RS.f_clamp((core.nf(spot, 0) + ((RS.u_as_f32(jx) / 10.0 : F32) - 4.0 : F32) : F32), 3.0, (w - 3.0 : F32))
    y: F32 = RS.f_clamp((core.nf(spot, 1) + ((RS.u_as_f32(jy) / 10.0 : F32) - 4.0 : F32) : F32), 3.0, (h - 3.0 : F32))
    rock: J.Val = J.obj()
    rock = core.set_f(rock, "x", x)
    rock = core.set_f(rock, "y", y)
    rock = core.set_u(rock, "fall", hazards.ROCK_FALL())
    rock = core.set_u(rock, "dust", 0)
    rock = core.set_b(rock, "ember", False{})
    run = J.set(run, "rng", W.to_j(rng3))
    return J.set(run, "rocks", J.push(J.get(run, "rocks"), rock))

# Whether the Collapse is coming, and in how many seconds.
def fortune.Run.collapse_in(run: J.Val) -> U32?:
    if Bool.or(J.is_null(J.get(run, "collapse_at")), Bool.not(String.eq(core.s(run, "mode"), "collapse"))):
        return None{}
    if home.Run.at_home_now(run):
        return None{}
    return Some{W.lo32(W.div_u32(W.sat_sub(W.of_j(J.get(run, "collapse_at")), W.of_j(J.get(run, "tick"))), rules.HZ()))}
