# crates/delve/src/rules/activity.rs — the games played inside a room, in one registry with one lifecycle.
# Rust's `RIDES`, `FOLLIES`, `HOME_ROOMS`, `WORLD` and `PLACES` tables of closures become explicit
# sequences here, in the tables' order. The Round Table adventures and the rides that live in
# their own modules are reached by `<module>.ACTIVITY.on(run)` / `.ride(run, inputs)` / `.end(run)`.

def activity.kind_is(run: J.Val, kind: String) -> Bool:
    return String.eq(layout.Room.kind(rules.Run.room(run)), kind)

# The keys of the seats in `seated`, each laid over a blank map (`joust::reins_all`).
def joust.reins_all(inputs: J.Val, seated: J.Val) -> J.Val:
    out: J.Val = J.obj()
    for id: J.Val in J.items(seated):
        out = J.set(out, U32.show(J.u32(id)), core.or_else(J.get(inputs, U32.show(J.u32(id))), rules.Input.default()))
    return out

# A ride whose game may have ended with its tick: its blank map while the state stands, else none.
def activity.ride_while(run: J.Val, present: Bool) -> (J.Val, J.Val?):
    if present:
        return (run, Some{J.obj()})
    return (run, None{})

# The ride under way, if any, plays its tick; the keys the rest of the step sees.
def activity.Run.ride(run: J.Val, inputs: J.Val) -> (J.Val, J.Val?):
    if activity.kind_is(run, "muster"):
        run = pennon.Run.tick_pennon(run, inputs)
        return activity.ride_while(run, Bool.not(J.is_null(J.get(run, "pennon"))))
    if forest_road.Run.forest_road_showing(run):
        run = forest_road.Run.tick_forest_road(run, inputs)
        return (run, Some{J.obj()})
    if lanternward.ACTIVITY.on(run):
        return lanternward.ACTIVITY.ride(run, inputs)
    if moonfall.ACTIVITY.on(run):
        return moonfall.ACTIVITY.ride(run, inputs)
    if bannerpeak.ACTIVITY.on(run):
        return bannerpeak.ACTIVITY.ride(run, inputs)
    if griffinwing.ACTIVITY.on(run):
        return griffinwing.ACTIVITY.ride(run, inputs)
    if lightgallop.ACTIVITY.on(run):
        return lightgallop.ACTIVITY.ride(run, inputs)
    if knight_racers.ACTIVITY.on(run):
        return knight_racers.ACTIVITY.ride(run, inputs)
    if deathmatch.ACTIVITY.on(run):
        return deathmatch.ACTIVITY.ride(run, inputs)
    if activity.kind_is(run, "workshop"):
        run = rafterwake.Run.tick_rafterwake(run, inputs)
        return activity.ride_while(run, Bool.not(J.is_null(J.get(run, "rafterwake"))))
    if activity.kind_is(run, "tavern"):
        run = brasswake.Run.tick_brasswake(run, inputs)
        return activity.ride_while(run, Bool.not(J.is_null(J.get(run, "brasswake"))))
    if activity.kind_is(run, "bathhouse"):
        run = mossbell.Run.tick_mossbell(run, inputs)
        return activity.ride_while(run, Bool.not(J.is_null(J.get(run, "mossbell"))))
    if activity.kind_is(run, "smithy"):
        run = latch.Run.tick_latch(run, inputs)
        return activity.ride_while(run, Bool.not(J.is_null(J.get(run, "latch"))))
    if activity.kind_is(run, "college_lab"):
        run = cinder.Run.tick_cinder(run, inputs)
        return activity.ride_while(run, Bool.not(J.is_null(J.get(run, "cinder"))))
    if Bool.and(home.Run.at_home_now(run), activity.kind_is(run, "lists")):
        run = joust.Run.tick_lists(run, inputs)
        j: J.Val = J.get(run, "joust")
        if J.is_null(j):
            return (run, None{})
        return (run, Some{joust.reins_all(inputs, joust.Joust.seated(j))})
    if Bool.and(Bool.and(home.Run.at_home_now(run), activity.kind_is(run, "hippodrome")), Bool.not(race3d.Run.race3d_showing(run))):
        run = chariot.Run.tick_hippodrome_race(run, inputs)
        if race3d.Run.race3d_showing(run):
            return (run, Some{J.obj()})
        c: J.Val = J.get(run, "chariot")
        if J.is_null(c):
            return (run, None{})
        return (run, Some{joust.reins_all(inputs, chariot.Chariot.seat_ids(c))})
    if race3d.Run.race3d_showing(run):
        # The keys drive the race, and the knights stand still in the hall.
        run = race3d.Run.tick_race3d(run, inputs)
        return (run, Some{J.obj()})
    return (run, None{})

# A Sanctuary's field banner stands in the room.
def activity.has_banner(room: J.Val) -> Bool:
    match (layout.Room.field_banner(room) : (F32, F32)?):
        case Some{p: (F32, F32)}:
            return True{}
        case None{}:
            return False{}

# The follies' ticks, in order.
def activity.Run.tick_follies(run: J.Val, inputs: J.Val) -> J.Val:
    if Bool.not(J.is_null(altar.Run.wish_altar(run))):
        run = altar.Run.tick_wish_altar(run, inputs)
    if activity.has_banner(rules.Run.room(run)):
        run = classes.Run.tick_field_banner(run, inputs)
    run = folly.Run.tick_folly(run)
    run = race3d.Run.tick_eyrie(run)
    run = nooks.Run.tick_nook(run, inputs)
    run = folly.Run.tick_bats(run)
    run = gantry.Run.tick_gantry(run)
    run = powder.Run.tick_powder(run, inputs)
    return hop.Run.tick_book_hop(run)

# The realm's places' ticks, in order.
def activity.Run.tick_places(run: J.Val, inputs: J.Val) -> J.Val:
    if U32.is_zero(rules.Run.floor(run)):
        run = home.Run.tick_home(run, inputs)
    run = barony.Run.tick_barony(run, inputs)
    run = holdings.Run.tick_holdings(run, inputs)
    run = college.Run.tick_college(run, inputs)
    run = ranch.Run.tick_ranch(run, inputs)
    run = swamp.Run.tick_swamp_notice(run, inputs)
    return merchant.Run.tick_merchant(run)

# The Undercroft room the party stands in plays; true when one did (the stair's landing plays otherwise).
def activity.Run.tick_home_room(run: J.Val, inputs: J.Val) -> (J.Val, Bool):
    if activity.kind_is(run, "fortune"):
        return (fortune.Run.tick_fortune(run, inputs), True{})
    if activity.kind_is(run, "yard"):
        return (yard.Run.tick_yard(run, inputs), True{})
    if activity.kind_is(run, "trophies"):
        run = tavern.Run.tick_wing_plate(run, inputs)
        return (trophies.Run.tick_trophies(run), True{})
    if activity.kind_is(run, "tavern"):
        return (tavern.Run.tick_tavern(run, inputs), True{})
    if alehouse.is_room(layout.Room.kind(rules.Run.room(run))):
        return (alehouse.Run.tick_alehouse(run, inputs), True{})
    k: String = layout.Room.kind(rules.Run.room(run))
    if Bool.or(Bool.or(Bool.or(String.eq(k, "hall"), String.eq(k, "stockpile")), Bool.or(String.eq(k, "muster"), String.eq(k, "workshop"))), String.eq(k, "quarters")):
        return (run, True{})
    if layout.RoomKind.in_world(k):
        return (world.Run.tick_world(run, inputs), True{})
    return (run, False{})

# Every one of the world's games that is on, in order.
def activity.Run.tick_world_games(run: J.Val, inputs: J.Val) -> J.Val:
    run = kingdom.Run.tick_kingdom(run, inputs)
    if activity.kind_is(run, "stables"):
        run = joust.Run.tick_stables(run, inputs)
    if activity.kind_is(run, "forest"):
        run = forest.Run.tick_forest(run)
    run = countryside.Run.tick_countryside(run, inputs)
    return pastimes.Run.tick_pastimes(run, inputs)

# End every game that ends when a view leaves its room.
def activity.Run.end_outside_activities(run: J.Val) -> J.Val:
    for k: String in ["pennon", "forest_road", "rafterwake", "brasswake", "mossbell", "latch", "cinder", "joust", "chariot"]:
        run = J.set(run, k, J.JNull{})
    run = J.del(run, "forest_road")
    run = lanternward.ACTIVITY.end(run)
    run = moonfall.ACTIVITY.end(run)
    run = bannerpeak.ACTIVITY.end(run)
    run = griffinwing.ACTIVITY.end(run)
    run = lightgallop.ACTIVITY.end(run)
    run = knight_racers.ACTIVITY.end(run)
    return deathmatch.ACTIVITY.end(run)
