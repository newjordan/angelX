      aftermath.Run.aftermath.k2(run, inputs, sortie, struck, deeds, phantoms)
    case Con{+p, +_t28}:
      aftermath.Run.aftermath.if29(U32.is_gt(core.u(p, "left"), 0), run, inputs, sortie, struck, deeds, phantoms, _t28, p)

def aftermath.Run.aftermath.k1(+run: J.Val, +inputs: J.Val, +sortie: J.Val, +struck: J.Val, +deeds: J.Val) -> J.Val:
  +phantoms = {[] : List<&2, J.Val>}
  aftermath.Run.aftermath.loop28(J.items(J.get(run, "phantoms")), run, inputs, sortie, struck, deeds, phantoms)

def aftermath.Run.aftermath.if30(_c: Bool, +run: J.Val, +inputs: J.Val, +sortie: J.Val, +struck: J.Val, +deeds: J.Val) -> J.Val:
  match _c:
    case True{}:
      +run = {feats.Run.notice(run, "overkill") : J.Val}
      aftermath.Run.aftermath.k1(run, inputs, sortie, struck, deeds)
    case False{}:
      aftermath.Run.aftermath.k1(run, inputs, sortie, struck, deeds)
