    case False{}:
      knights.unnamed.k1(p)

# `Results::of`'s rows: one per knight that is here.

def floor_stats.rows(+tally: J.Val, +players: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> List<&2, J.Val>:
  +rows = {[] : List<&2, J.Val>}
  floor_stats.rows.loop2(players, tally, rows)

def floor_stats.rows.k1(+rows: List<&2, J.Val>) -> List<&2, J.Val>:
  rows

def floor_stats.rows.if3(_c: Bool, +tally: J.Val, +rows: List<&2, J.Val>, +_t2: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +h: J.Val) -> List<&2, J.Val>:
  match _c:
    case True{}:
      +r = {J.obj() : J.Val}
      +r = {core.set_u(r, "id", rules.Run.step.id(k)) : J.Val}
      +r = {core.set_s(r, "name", knights.Hero.shown_name(h)) : J.Val}
      +r = {J.set(r, "line", floor_stats.Tally.line(tally, rules.Run.step.id(k))) : J.Val}
      +r = {J.set(r, "honours", J.JA{Nil{}}) : J.Val}
      +rows = {List.append(&2, J.Val, rows, [r]) : List<&2, J.Val>}
      floor_stats.rows.loop2(_t2, tally, rows)
    case False{}:
      floor_stats.rows.loop2(_t2, tally, rows)

def floor_stats.rows.loop2(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +tally: J.Val, +rows: List<&2, J.Val>) -> List<&2, J.Val>:
  match _xs:
    case Nil{}:
      floor_stats.rows.k1(rows)
    case Con{+_h2, +_t2}:
      (+k, +h) = _h2
      floor_stats.rows.if3(Bool.not(core.b(h, "absent")), tally, rows, _t2, k, h)

