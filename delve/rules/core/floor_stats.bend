# "you", "host" (any case) and "Knight <n>" stand for no name at all.

def knights.unnamed(+p: String) -> Bool:
  +lower = {String.to_lower(p) : String}
  knights.unnamed.if5(Bool.or(String.eq(lower, "you"), String.eq(lower, "host")), p)

def knights.unnamed.k2() -> Bool:
  False{}

def knights.unnamed.m4(+s: Maybe<&2, U32>) -> Bool:
  match s:
    case Some{+n}:
      True{}
    case None{}:
      False{}

def knights.unnamed.if3(_c: Bool, +p: String) -> Bool:
  match _c:
    case True{}:
      knights.unnamed.m4(U32.read(String.drop(p, 7n)))
    case False{}:
      knights.unnamed.k2()

def knights.unnamed.k1(+p: String) -> Bool:
  knights.unnamed.if3(String.starts_with(p, "Knight "), p)

def knights.unnamed.if5(_c: Bool, +p: String) -> Bool:
  match _c:
    case True{}:
