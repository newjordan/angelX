# i64 as two's complement words: positive means above zero.

def core.i64_pos(+x: W.W) -> Bool:
  Bool.and(Bool.not(W.is_zero(x)), U32.is_lt(W.hi32(x), 2147483648))

# `Wished::impact`: (extra damage over the old pace, gain in percent), if measured.

def floor_stats.Wished.impact(+w: J.Val) -> Maybe<&2, Sigma<&2, &2, W.W, _ => W.W>>:
  +bd = {W.of_j(J.nth(J.get(w, "before"), 0)) : W.W}
  +bt = {W.of_j(J.nth(J.get(w, "before"), 1)) : W.W}
  +ad = {W.of_j(J.nth(J.get(w, "after"), 0)) : W.W}
  +at = {W.of_j(J.nth(J.get(w, "after"), 1)) : W.W}
  floor_stats.Wished.impact.if2(Bool.or(W.lt(bt, floor_stats.SETTLE()), Bool.or(W.lt(at, floor_stats.SETTLE()), W.is_zero(bd))), bd, bt, ad, at)

def floor_stats.Wished.impact.k1(+bd: W.W, +bt: W.W, +ad: W.W, +at: W.W) -> Maybe<&2, Sigma<&2, &2, W.W, _ => W.W>>:
  +expected = {W.div(W.mul(bd, at), bt) : W.W}
  +gain = {W.sub(W.div(W.mul(W.mul(ad, bt), W.of_u32(100)), W.mul(bd, at)), W.of_u32(100)) : W.W}
  Some{(W.sub(ad, expected), gain)}

def floor_stats.Wished.impact.if2(_c: Bool, +bd: W.W, +bt: W.W, +ad: W.W, +at: W.W) -> Maybe<&2, Sigma<&2, &2, W.W, _ => W.W>>:
  match _c:
    case True{}:
      None{}
    case False{}:
      floor_stats.Wished.impact.k1(bd, bt, ad, at)

