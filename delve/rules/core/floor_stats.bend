def floor_stats.honour_value.if10(_c: Bool, +kind: String, +l: J.Val) -> Maybe<&2, W.W>:
  match _c:
    case True{}:
      floor_stats.honour_value.m11(floor_stats.Line.aim(l), kind, l)
    case False{}:
      floor_stats.honour_value.k3(kind, l)

def floor_stats.honour_value.k2(+kind: String, +l: J.Val) -> Maybe<&2, W.W>:
  floor_stats.honour_value.if10(String.eq(kind, "sharpshooter"), kind, l)

def floor_stats.honour_value.if14(_c: Bool, +kind: String, +l: J.Val) -> Maybe<&2, W.W>:
  match _c:
    case True{}:
      Some{W.of_u32(core.u(l, "damage"))}
    case False{}:
      floor_stats.honour_value.k2(kind, l)

def floor_stats.honour_value.k1(+kind: String, +l: J.Val) -> Maybe<&2, W.W>:
  floor_stats.honour_value.if14(String.eq(kind, "hardest_hitter"), kind, l)

def floor_stats.honour_value.if15(_c: Bool, +kind: String, +l: J.Val) -> Maybe<&2, W.W>:
  match _c:
    case True{}:
      Some{W.of_u32(core.u(l, "kills"))}
    case False{}:
      floor_stats.honour_value.k1(kind, l)

# The best value among rows (> 0), if any.

def floor_stats.best(+kind: String, +rows: List<&2, J.Val>) -> Maybe<&2, W.W>:
  +best = {W.zero() : W.W}
  +found = {False{} : Bool}
  floor_stats.best.loop4(rows, kind, best, found)

def floor_stats.best.k2() -> Maybe<&2, W.W>:
  None{}

def floor_stats.best.if3(_c: Bool, +best: W.W) -> Maybe<&2, W.W>:
  match _c:
    case True{}:
      Some{best}
    case False{}:
      floor_stats.best.k2()

def floor_stats.best.k1(+best: W.W, +found: Bool) -> Maybe<&2, W.W>:
  floor_stats.best.if3(found, best)

def floor_stats.best.if6(_c: Bool, +kind: String, +best: W.W, +found: Bool, +_t4: List<&2, J.Val>, +v: W.W) -> Maybe<&2, W.W>:
  match _c:
    case True{}:
      +best = {v : W.W}
      +found = {True{} : Bool}
      floor_stats.best.loop4(_t4, kind, best, found)
    case False{}:
      floor_stats.best.loop4(_t4, kind, best, found)

def floor_stats.best.m5(+s: Maybe<&2, W.W>, +kind: String, +best: W.W, +found: Bool, +_t4: List<&2, J.Val>) -> Maybe<&2, W.W>:
  match s:
    case Some{+v}:
      floor_stats.best.if6(W.gt(v, best), kind, best, found, _t4, v)
    case None{}:
      +found = {found : Bool}
      floor_stats.best.loop4(_t4, kind, best, found)

def floor_stats.best.loop4(+_xs: List<&2, J.Val>, +kind: String, +best: W.W, +found: Bool) -> Maybe<&2, W.W>:
  match _xs:
    case Nil{}:
      floor_stats.best.k1(best, found)
    case Con{+r, +_t4}:
      floor_stats.best.m5(floor_stats.honour_value(kind, J.get(r, "line")), kind, best, found, _t4)

# Each honour goes to whoever tops it, ties shared; the "most" honours only in a party.

def floor_stats.award(+kind: String, +rows: List<&2, J.Val>, +party: U32, +alone: Bool) -> List<&2, J.Val>:
  floor_stats.award.if8(Bool.and(U32.is_lt(party, 2), Bool.not(alone)), kind, rows)

def floor_stats.award.k3(+out: List<&2, J.Val>) -> List<&2, J.Val>:
  out

def floor_stats.award.k5(+kind: String, +best: W.W, +out: List<&2, J.Val>, +_t4: List<&2, J.Val>, +r: J.Val) -> List<&2, J.Val>:
  +out = {List.append(&2, J.Val, out, [r]) : List<&2, J.Val>}
  floor_stats.award.loop4(_t4, kind, best, out)

def floor_stats.award.if7(_c: Bool, +kind: String, +best: W.W, +out: List<&2, J.Val>, +_t4: List<&2, J.Val>, +r: J.Val) -> List<&2, J.Val>:
  match _c:
    case True{}:
      +r = {J.set(r, "honours", J.push(J.get(r, "honours"), J.JS{kind})) : J.Val}
      floor_stats.award.k5(kind, best, out, _t4, r)
    case False{}:
      floor_stats.award.k5(kind, best, out, _t4, r)

def floor_stats.award.m6(+s: Maybe<&2, W.W>, +kind: String, +best: W.W, +out: List<&2, J.Val>, +_t4: List<&2, J.Val>, +r: J.Val) -> List<&2, J.Val>:
  match s:
    case Some{+v}:
      floor_stats.award.if7(W.eq(v, best), kind, best, out, _t4, r)
    case None{}:
      +r = {r : J.Val}
      floor_stats.award.k5(kind, best, out, _t4, r)

def floor_stats.award.loop4(+_xs: List<&2, J.Val>, +kind: String, +best: W.W, +out: List<&2, J.Val>) -> List<&2, J.Val>:
  match _xs:
    case Nil{}:
      floor_stats.award.k3(out)
    case Con{+r, +_t4}:
      floor_stats.award.m6(floor_stats.honour_value(kind, J.get(r, "line")), kind, best, out, _t4, r)

def floor_stats.award.m2(+s: Maybe<&2, W.W>, +kind: String, +rows: List<&2, J.Val>) -> List<&2, J.Val>:
  match s:
    case Some{+best}:
      +out = {[] : List<&2, J.Val>}
      floor_stats.award.loop4(rows, kind, best, out)
    case None{}:
      rows

def floor_stats.award.k1(+kind: String, +rows: List<&2, J.Val>) -> List<&2, J.Val>:
  floor_stats.award.m2(floor_stats.best(kind, rows), kind, rows)

def floor_stats.award.if8(_c: Bool, +kind: String, +rows: List<&2, J.Val>) -> List<&2, J.Val>:
  match _c:
    case True{}:
      rows
    case False{}:
      floor_stats.award.k1(kind, rows)

# `share`: part of a whole, in thousandths.

def floor_stats.share(+part: U32, +whole: W.W) -> W.W:
  floor_stats.share.if2(W.is_zero(whole), part, whole)

def floor_stats.share.k1(+part: U32, +whole: W.W) -> W.W:
  W.div(W.mul(W.of_u32(part), W.of_u32(1000)), whole)

def floor_stats.share.if2(_c: Bool, +part: U32, +whole: W.W) -> W.W:
  match _c:
    case True{}:
      W.zero()
    case False{}:
      floor_stats.share.k1(part, whole)

# The row of the knight with the biggest share of the floor, or None.

def floor_stats.mvp(+rows: List<&2, J.Val>) -> Maybe<&2, U32>:
  +kills = {W.zero() : W.W}
  +damage = {W.zero() : W.W}
  +raised = {W.zero() : W.W}
  floor_stats.mvp.loop12(rows, rows, kills, damage, raised)

def floor_stats.mvp.k3() -> Maybe<&2, U32>:
  None{}

def floor_stats.mvp.if4(_c: Bool, +best_id: U32) -> Maybe<&2, U32>:
  match _c:
    case True{}:
      Some{best_id}
    case False{}:
      floor_stats.mvp.k3()

def floor_stats.mvp.k2(+best_id: U32, +found: Bool) -> Maybe<&2, U32>:
  floor_stats.mvp.if4(found, best_id)

def floor_stats.mvp.if7(_c: Bool, +kills: W.W, +damage: W.W, +raised: W.W, +best_score: W.W, +best_damage: U32, +best_id: U32, +found: Bool, +_t5: List<&2, J.Val>, +score: W.W, +id: U32, +d: U32) -> Maybe<&2, U32>:
  match _c:
    case True{}:
      +best_score = {score : W.W}
      +best_damage = {d : U32}
      +best_id = {id : U32}
      +found = {True{} : Bool}
      floor_stats.mvp.loop5(_t5, kills, damage, raised, best_score, best_damage, best_id, found)
    case False{}:
      floor_stats.mvp.loop5(_t5, kills, damage, raised, best_score, best_damage, best_id, found)

def floor_stats.mvp.k6(+kills: W.W, +damage: W.W, +raised: W.W, +best_score: W.W, +best_damage: U32, +best_id: U32, +found: Bool, +_t5: List<&2, J.Val>, +score: W.W, +id: U32, +d: U32, +better: Bool) -> Maybe<&2, U32>:
  floor_stats.mvp.if7(Bool.and(Bool.not(W.is_zero(score)), Bool.or(better, Bool.not(found))), kills, damage, raised, best_score, best_damage, best_id, found, _t5, score, id, d)

def floor_stats.mvp.if11(_c: Bool, +kills: W.W, +damage: W.W, +raised: W.W, +best_score: W.W, +best_damage: U32, +best_id: U32, +found: Bool, +_t5: List<&2, J.Val>, +score: W.W, +id: U32, +d: U32, +better: Bool) -> Maybe<&2, U32>:
  match _c:
    case True{}:
      +better = {Bool.and(found, U32.is_lt(id, best_id)) : Bool}
      floor_stats.mvp.k6(kills, damage, raised, best_score, best_damage, best_id, found, _t5, score, id, d, better)
    case False{}:
      floor_stats.mvp.k6(kills, damage, raised, best_score, best_damage, best_id, found, _t5, score, id, d, better)

def floor_stats.mvp.if10(_c: Bool, +kills: W.W, +damage: W.W, +raised: W.W, +best_score: W.W, +best_damage: U32, +best_id: U32, +found: Bool, +_t5: List<&2, J.Val>, +score: W.W, +id: U32, +d: U32, +better: Bool) -> Maybe<&2, U32>:
  match _c:
    case True{}:
      +better = {True{} : Bool}
      floor_stats.mvp.k6(kills, damage, raised, best_score, best_damage, best_id, found, _t5, score, id, d, better)
    case False{}:
      floor_stats.mvp.if11(U32.is_eq(d, best_damage), kills, damage, raised, best_score, best_damage, best_id, found, _t5, score, id, d, better)

def floor_stats.mvp.if9(_c: Bool, +kills: W.W, +damage: W.W, +raised: W.W, +best_score: W.W, +best_damage: U32, +best_id: U32, +found: Bool, +_t5: List<&2, J.Val>, +score: W.W, +id: U32, +d: U32, +better: Bool) -> Maybe<&2, U32>:
  match _c:
    case True{}:
      floor_stats.mvp.if10(U32.is_gt(d, best_damage), kills, damage, raised, best_score, best_damage, best_id, found, _t5, score, id, d, better)
    case False{}:
      floor_stats.mvp.k6(kills, damage, raised, best_score, best_damage, best_id, found, _t5, score, id, d, better)

def floor_stats.mvp.if8(_c: Bool, +kills: W.W, +damage: W.W, +raised: W.W, +best_score: W.W, +best_damage: U32, +best_id: U32, +found: Bool, +_t5: List<&2, J.Val>, +score: W.W, +id: U32, +d: U32, +better: Bool) -> Maybe<&2, U32>:
  match _c:
    case True{}:
      +better = {True{} : Bool}
      floor_stats.mvp.k6(kills, damage, raised, best_score, best_damage, best_id, found, _t5, score, id, d, better)
    case False{}:
      floor_stats.mvp.if9(W.eq(score, best_score), kills, damage, raised, best_score, best_damage, best_id, found, _t5, score, id, d, better)

def floor_stats.mvp.loop5(+_xs: List<&2, J.Val>, +kills: W.W, +damage: W.W, +raised: W.W, +best_score: W.W, +best_damage: U32, +best_id: U32, +found: Bool) -> Maybe<&2, U32>:
  match _xs:
    case Nil{}:
      floor_stats.mvp.k2(best_id, found)
    case Con{+r, +_t5}:
      +l = {J.get(r, "line") : J.Val}
      +score = {W.add(W.add(floor_stats.share(core.u(l, "kills"), kills), floor_stats.share(core.u(l, "damage"), damage)), W.div_u32(floor_stats.share(core.u(l, "raised"), raised), 2)) : W.W}
      +id = {core.u(r, "id") : U32}
      +d = {core.u(l, "damage") : U32}
      +better = {False{} : Bool}
      floor_stats.mvp.if8(W.gt(score, best_score), kills, damage, raised, best_score, best_damage, best_id, found, _t5, score, id, d, better)

def floor_stats.mvp.k1(+rows: List<&2, J.Val>, +kills: W.W, +damage: W.W, +raised: W.W) -> Maybe<&2, U32>:
  +best_score = {W.zero() : W.W}
  +best_damage = {0 : U32}
  +best_id = {0 : U32}
  +found = {False{} : Bool}
  floor_stats.mvp.loop5(rows, kills, damage, raised, best_score, best_damage, best_id, found)

def floor_stats.mvp.loop12(+_xs: List<&2, J.Val>, +rows: List<&2, J.Val>, +kills: W.W, +damage: W.W, +raised: W.W) -> Maybe<&2, U32>:
  match _xs:
    case Nil{}:
      floor_stats.mvp.k1(rows, kills, damage, raised)
    case Con{+r, +_t12}:
      +l = {J.get(r, "line") : J.Val}
      +kills = {W.add_u32(kills, core.u(l, "kills")) : W.W}
      +damage = {W.add_u32(damage, core.u(l, "damage")) : W.W}
      +raised = {W.add_u32(raised, core.u(l, "raised")) : W.W}
      floor_stats.mvp.loop12(_t12, rows, kills, damage, raised)

# `impact(tally, players)`: the wish that did the most, as an Impact object, or null.

def floor_stats.impact(+tally: J.Val, +players: J.Val) -> J.Val:
  +best_extra = {W.zero() : W.W}
  +best_gain = {W.zero() : W.W}
  +best = {J.JNull{} : J.Val}
  +held = {J.JNull{} : J.Val}
  +held_dmg = {W.zero() : W.W}
  floor_stats.impact.loop6(J.items(J.get(tally, "wishes")), players, best_extra, best_gain, best, held, held_dmg)

def floor_stats.impact.k3(+players: J.Val, +held: J.Val, +held_dmg: W.W) -> J.Val:
  floor_stats.impact_of(held, players, W.to_j(W.min(held_dmg, W.of_u32(4294967295))), J.JNull{})

def floor_stats.impact.if4(_c: Bool, +players: J.Val, +held: J.Val, +held_dmg: W.W) -> J.Val:
  match _c:
    case True{}:
      J.JNull{}
    case False{}:
      floor_stats.impact.k3(players, held, held_dmg)

def floor_stats.impact.k2(+players: J.Val, +held: J.Val, +held_dmg: W.W) -> J.Val:
  floor_stats.impact.if4(J.is_null(held), players, held, held_dmg)

def floor_stats.impact.if5(_c: Bool, +players: J.Val, +best_extra: W.W, +best_gain: W.W, +best: J.Val, +held: J.Val, +held_dmg: W.W) -> J.Val:
  match _c:
    case True{}:
      floor_stats.impact_of(best, players, W.to_j(W.min(best_extra, W.of_u32(4294967295))), W.to_j(W.min(best_gain, W.of_u32(4294967295))))
    case False{}:
      floor_stats.impact.k2(players, held, held_dmg)

def floor_stats.impact.k1(+players: J.Val, +best_extra: W.W, +best_gain: W.W, +best: J.Val, +held: J.Val, +held_dmg: W.W) -> J.Val:
  floor_stats.impact.if5(Bool.not(J.is_null(best)), players, best_extra, best_gain, best, held, held_dmg)

def floor_stats.impact.if9(_c: Bool, +players: J.Val, +best_extra: W.W, +best_gain: W.W, +best: J.Val, +held: J.Val, +held_dmg: W.W, +_t6: List<&2, J.Val>, +w: J.Val, +ad: W.W) -> J.Val:
  match _c:
    case True{}:
      +held = {w : J.Val}
      +held_dmg = {ad : W.W}
      floor_stats.impact.loop6(_t6, players, best_extra, best_gain, best, held, held_dmg)
    case False{}:
      floor_stats.impact.loop6(_t6, players, best_extra, best_gain, best, held, held_dmg)

def floor_stats.impact.k8(+players: J.Val, +best_extra: W.W, +best_gain: W.W, +best: J.Val, +held: J.Val, +held_dmg: W.W, +_t6: List<&2, J.Val>, +w: J.Val) -> J.Val:
  +ad = {W.of_j(J.nth(J.get(w, "after"), 0)) : W.W}
  floor_stats.impact.if9(Bool.and(Bool.not(W.is_zero(ad)), Bool.or(J.is_null(held), W.ge(ad, held_dmg))), players, best_extra, best_gain, best, held, held_dmg, _t6, w, ad)

def floor_stats.impact.if13(_c: Bool, +players: J.Val, +best_extra: W.W, +best_gain: W.W, +best: J.Val, +held: J.Val, +held_dmg: W.W, +_t6: List<&2, J.Val>, +w: J.Val, +extra: W.W, +gain: W.W) -> J.Val:
  match _c:
    case True{}:
      +best = {w : J.Val}
      +best_extra = {extra : W.W}
      +best_gain = {gain : W.W}
      floor_stats.impact.k8(players, best_extra, best_gain, best, held, held_dmg, _t6, w)
    case False{}:
      floor_stats.impact.k8(players, best_extra, best_gain, best, held, held_dmg, _t6, w)

def floor_stats.impact.if12(_c: Bool, +players: J.Val, +best_extra: W.W, +best_gain: W.W, +best: J.Val, +held: J.Val, +held_dmg: W.W, +_t6: List<&2, J.Val>, +w: J.Val, +extra: W.W, +gain: W.W) -> J.Val:
  match _c:
    case True{}:
      floor_stats.impact.if13(Bool.or(J.is_null(best), W.ge(extra, best_extra)), players, best_extra, best_gain, best, held, held_dmg, _t6, w, extra, gain)
    case False{}:
      floor_stats.impact.k8(players, best_extra, best_gain, best, held, held_dmg, _t6, w)

def floor_stats.impact.k11(+t: Sigma<&2, &2, W.W, _ => W.W>, +players: J.Val, +best_extra: W.W, +best_gain: W.W, +best: J.Val, +held: J.Val, +held_dmg: W.W, +_t6: List<&2, J.Val>, +w: J.Val) -> J.Val:
  (+extra, +gain) = t
  floor_stats.impact.if12(Bool.and(core.i64_pos(extra), core.i64_pos(gain)), players, best_extra, best_gain, best, held, held_dmg, _t6, w, extra, gain)

def floor_stats.impact.m10(+s: Maybe<&2, Sigma<&2, &2, W.W, _ => W.W>>, +players: J.Val, +best_extra: W.W, +best_gain: W.W, +best: J.Val, +held: J.Val, +held_dmg: W.W, +_t6: List<&2, J.Val>, +w: J.Val) -> J.Val:
  match s:
    case Some{+pair}:
      floor_stats.impact.k11(pair, players, best_extra, best_gain, best, held, held_dmg, _t6, w)
    case None{}:
      +best = {best : J.Val}
      floor_stats.impact.k8(players, best_extra, best_gain, best, held, held_dmg, _t6, w)

def floor_stats.impact.if7(_c: Bool, +players: J.Val, +best_extra: W.W, +best_gain: W.W, +best: J.Val, +held: J.Val, +held_dmg: W.W, +_t6: List<&2, J.Val>, +w: J.Val) -> J.Val:
  match _c:
    case True{}:
      floor_stats.impact.m10(floor_stats.Wished.impact(w), players, best_extra, best_gain, best, held, held_dmg, _t6, w)
    case False{}:
      floor_stats.impact.loop6(_t6, players, best_extra, best_gain, best, held, held_dmg)

def floor_stats.impact.loop6(+_xs: List<&2, J.Val>, +players: J.Val, +best_extra: W.W, +best_gain: W.W, +best: J.Val, +held: J.Val, +held_dmg: W.W) -> J.Val:
  match _xs:
    case Nil{}:
      floor_stats.impact.k1(players, best_extra, best_gain, best, held, held_dmg)
    case Con{+w, +_t6}:
      +who = {J.get(players, U32.show(core.u(w, "knight"))) : J.Val}
      floor_stats.impact.if7(Bool.and(Bool.not(J.is_null(who)), Bool.not(core.b(who, "absent"))), players, best_extra, best_gain, best, held, held_dmg, _t6, w)

def floor_stats.impact_of(+w: J.Val, +players: J.Val, +damage: J.Val, +gain: J.Val) -> J.Val:
  +who = {J.get(players, U32.show(core.u(w, "knight"))) : J.Val}
  +name = {"" : String}
  floor_stats.impact_of.if2(Bool.not(J.is_null(who)), w, damage, gain, who, name)

def floor_stats.impact_of.k1(+w: J.Val, +damage: J.Val, +gain: J.Val, +name: String) -> J.Val:
  +i = {J.obj() : J.Val}
  +i = {core.set_u(i, "knight", core.u(w, "knight")) : J.Val}
  +i = {core.set_s(i, "name", name) : J.Val}
  +i = {core.set_s(i, "wish", floor_stats.Wished.name(w)) : J.Val}
  +i = {J.set(i, "damage", damage) : J.Val}
  J.set(i, "gain", gain)

def floor_stats.impact_of.if2(_c: Bool, +w: J.Val, +damage: J.Val, +gain: J.Val, +who: J.Val, +name: String) -> J.Val:
  match _c:
    case True{}:
      +name = {knights.Hero.shown_name(who) : String}
      floor_stats.impact_of.k1(w, damage, gain, name)
    case False{}:
      floor_stats.impact_of.k1(w, damage, gain, name)

# `Results::of`: the tally closed.

def floor_stats.Results.of(+tally: J.Val, +players: J.Val, +depth: U32, +end: String, +tick: W.W) -> J.Val:
  +rows = {floor_stats.rows(tally, J.int_fields(players)) : List<&2, J.Val>}
  +party = {U32.from_nat(List.length(&2, J.Val, rows)) : U32}
  +rows = {floor_stats.award("most_kills", rows, party, False{}) : List<&2, J.Val>}
  +rows = {floor_stats.award("hardest_hitter", rows, party, False{}) : List<&2, J.Val>}
  +rows = {floor_stats.award("sharpshooter", rows, party, True{}) : List<&2, J.Val>}
  +rows = {floor_stats.award("untouched", rows, party, True{}) : List<&2, J.Val>}
  +rows = {floor_stats.award("lifesaver", rows, party, True{}) : List<&2, J.Val>}
  +rows = {floor_stats.award("deep_pockets", rows, party, False{}) : List<&2, J.Val>}
  +mvp = {J.JNull{} : J.Val}
  floor_stats.Results.of.if2(U32.is_ge(party, 2), tally, players, depth, end, tick, rows, mvp)

def floor_stats.Results.of.k1(+tally: J.Val, +players: J.Val, +depth: U32, +end: String, +tick: W.W, +rows: List<&2, J.Val>, +mvp: J.Val) -> J.Val:
  +r = {J.obj() : J.Val}
  +r = {core.set_u(r, "depth", depth) : J.Val}
  +r = {core.set_s(r, "end", end) : J.Val}
  +r = {J.set(r, "ticks", W.to_j(W.sat_sub(tick, W.of_j(J.get(tally, "began"))))) : J.Val}
  +r = {J.set(r, "rows", J.JA{rows}) : J.Val}
  +r = {J.set(r, "mvp", mvp) : J.Val}
  +r = {J.set(r, "wish", floor_stats.impact(tally, players)) : J.Val}
  +r = {J.set(r, "at", W.to_j(tick)) : J.Val}
  core.set_u(r, "stood", 0)

def floor_stats.Results.of.m3(+s: Maybe<&2, U32>, +tally: J.Val, +players: J.Val, +depth: U32, +end: String, +tick: W.W, +rows: List<&2, J.Val>, +mvp: J.Val) -> J.Val:
  match s:
    case Some{+id}:
      +mvp = {J.JU{id} : J.Val}
      floor_stats.Results.of.k1(tally, players, depth, end, tick, rows, mvp)
    case None{}:
      +mvp = {J.JNull{} : J.Val}
      floor_stats.Results.of.k1(tally, players, depth, end, tick, rows, mvp)

def floor_stats.Results.of.if2(_c: Bool, +tally: J.Val, +players: J.Val, +depth: U32, +end: String, +tick: W.W, +rows: List<&2, J.Val>, +mvp: J.Val) -> J.Val:
  match _c:
    case True{}:
      floor_stats.Results.of.m3(floor_stats.mvp(rows), tally, players, depth, end, tick, rows, mvp)
    case False{}:
      floor_stats.Results.of.k1(tally, players, depth, end, tick, rows, mvp)

# Count what each knight dealt this tick (`dealt`: {id: damage}) and the gold they picked up.

def floor_stats.Run.tally_floor(+run: J.Val, +dealt: J.Val) -> J.Val:
  floor_stats.Run.tally_floor.if8(Bool.or(U32.is_zero(rules.Run.floor(run)), Bool.not(rules.Run.active(run))), run, dealt)

def floor_stats.Run.tally_floor.k2(+run: J.Val, +tally: J.Val) -> J.Val:
  J.set(run, "floor_tally", tally)

def floor_stats.Run.tally_floor.if6(_c: Bool, +run: J.Val, +dealt: J.Val, +fighting: Bool, +tally: J.Val, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +id: U32, +gold: U32, +was: U32) -> J.Val:
  match _c:
    case True{}:
      +tally = {floor_stats.Tally.bump(tally, id, "gold", (gold - was : U32)) : J.Val}
      floor_stats.Run.tally_floor.loop3(_t3, run, dealt, fighting, tally)
    case False{}:
      floor_stats.Run.tally_floor.loop3(_t3, run, dealt, fighting, tally)

def floor_stats.Run.tally_floor.k5(+run: J.Val, +dealt: J.Val, +fighting: Bool, +tally: J.Val, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +id: U32, +gold: U32, +purse: J.Val, +was: U32) -> J.Val:
  +tally = {J.set(tally, "purse", core.set_u(purse, k, gold)) : J.Val}
  floor_stats.Run.tally_floor.if6(U32.is_gt(gold, was), run, dealt, fighting, tally, _t3, id, gold, was)

def floor_stats.Run.tally_floor.if7(_c: Bool, +run: J.Val, +dealt: J.Val, +fighting: Bool, +tally: J.Val, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +id: U32, +gold: U32, +purse: J.Val, +was: U32) -> J.Val:
  match _c:
    case True{}:
      +was = {core.u(purse, k) : U32}
      floor_stats.Run.tally_floor.k5(run, dealt, fighting, tally, _t3, k, id, gold, purse, was)
    case False{}:
      floor_stats.Run.tally_floor.k5(run, dealt, fighting, tally, _t3, k, id, gold, purse, was)

def floor_stats.Run.tally_floor.if4(_c: Bool, +run: J.Val, +dealt: J.Val, +fighting: Bool, +tally: J.Val, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +h: J.Val) -> J.Val:
  match _c:
    case True{}:
      +id = {rules.Run.step.id(k) : U32}
      +standing = {Bool.and(U32.is_ne(core.u(h, "hp"), 0), Bool.not(core.b(h, "away"))) : Bool}
      +tally = {floor_stats.Tally.count(tally, id, core.u(dealt, k), Bool.and(fighting, standing)) : J.Val}
      +gold = {realm.Spoils.get(J.get(h, "carried"), "gold") : U32}
      +purse = {J.get(tally, "purse") : J.Val}
      +was = {gold : U32}
      floor_stats.Run.tally_floor.if7(J.has(purse, k), run, dealt, fighting, tally, _t3, k, id, gold, purse, was)
    case False{}:
      floor_stats.Run.tally_floor.loop3(_t3, run, dealt, fighting, tally)

def floor_stats.Run.tally_floor.loop3(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +dealt: J.Val, +fighting: Bool, +tally: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      floor_stats.Run.tally_floor.k2(run, tally)
    case Con{+_h3, +_t3}:
      (+k, +h) = _h3
      floor_stats.Run.tally_floor.if4(Bool.not(core.b(h, "absent")), run, dealt, fighting, tally, _t3, k, h)

def floor_stats.Run.tally_floor.k1(+run: J.Val, +dealt: J.Val) -> J.Val:
  +fighting = {depths.Run.fight_on(run) : Bool}
  +tally = {J.get(run, "floor_tally") : J.Val}
  floor_stats.Run.tally_floor.loop3(J.int_fields(J.get(run, "players")), run, dealt, fighting, tally)

def floor_stats.Run.tally_floor.if8(_c: Bool, +run: J.Val, +dealt: J.Val) -> J.Val:
  match _c:
    case True{}:
      run
    case False{}:
      floor_stats.Run.tally_floor.k1(run, dealt)

def floor_stats.Run.close_floor(+run: J.Val, +end: String) -> J.Val:
  J.set(run, "floor_results", floor_stats.Results.of(J.get(run, "floor_tally"), J.get(run, "players"), rules.Run.floor(run), end, W.of_j(J.get(run, "tick"))))

def floor_stats.Run.close_run(+run: J.Val) -> J.Val:
  floor_stats.Run.close_run.if2(Bool.or(Bool.not(again.Run.over(run)), U32.is_zero(rules.Run.floor(run))), run)

def floor_stats.Run.close_run.k1(+run: J.Val) -> J.Val:
  +run = {floor_stats.Run.close_floor(run, Bool.pick(String, core.phase_is(run, "won"), "won", "fallen")) : J.Val}
  J.set(run, "floor_results", J.set(J.get(run, "floor_results"), "deeds", J.get(run, "deeds")))

def floor_stats.Run.close_run.if2(_c: Bool, +run: J.Val) -> J.Val:
  match _c:
    case True{}:
      run
    case False{}:
      floor_stats.Run.close_run.k1(run)

def floor_stats.Run.stand_verdict(+run: J.Val) -> J.Val:
  +results = {J.get(run, "floor_results") : J.Val}
  floor_stats.Run.stand_verdict.if2(Bool.and(again.Run.over(run), Bool.and(Bool.not(J.is_null(results)), Bool.not(String.eq(core.s(results, "end"), "cleared")))), run, results)

def floor_stats.Run.stand_verdict.k1(+run: J.Val) -> J.Val:
  run

def floor_stats.Run.stand_verdict.if2(_c: Bool, +run: J.Val, +results: J.Val) -> J.Val:
  match _c:
    case True{}:
      J.set(run, "floor_results", core.set_u(results, "stood", core.uadd(core.u(results, "stood"), 1)))
    case False{}:
      floor_stats.Run.stand_verdict.k1(run)

def floor_stats.Run.verdict_hold(+run: J.Val) -> U32:
  +results = {J.get(run, "floor_results") : J.Val}
  +deeds = {0 : U32}
  floor_stats.Run.verdict_hold.if2(Bool.and(Bool.not(J.is_null(results)), Bool.not(String.eq(core.s(results, "end"), "cleared"))), results, deeds)

def floor_stats.Run.verdict_hold.k1(+deeds: U32) -> U32:
  (again.VERDICT_HOLD() + Bool.pick(U32, U32.is_ne(deeds, 0), floor_stats.DEEDS_HOLD(), 0) : U32)

def floor_stats.Run.verdict_hold.if2(_c: Bool, +results: J.Val, +deeds: U32) -> U32:
  match _c:
    case True{}:
      +deeds = {core.count(J.get(results, "deeds")) : U32}
      floor_stats.Run.verdict_hold.k1(deeds)
    case False{}:
      floor_stats.Run.verdict_hold.k1(deeds)
