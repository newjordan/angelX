    case True{}:
      RS.f_max(RS.f_hypot(core.f(bullet, "vx"), core.f(bullet, "vy")), 1.0)
    case False{}:
      wishcraft.home_speed.k1(blade)

# Poisoning hits this tick: (the foe, the knight, how strong). The gas skill's poison, N times over.

def wishcraft.Run.poison_hits(+run: J.Val, +hits: J.Val) -> J.Val:
  wishcraft.Run.poison_hits.loop2(J.items(hits), run)

def wishcraft.Run.poison_hits.k1(+run: J.Val) -> J.Val:
  run

def wishcraft.Run.poison_hits.loop2(+_xs: List<&2, J.Val>, +run: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      wishcraft.Run.poison_hits.k1(run)
    case Con{+hit, +_t2}:
      +foe = {J.u32(J.nth(hit, 0)) : U32}
      +owner = {J.u32(J.nth(hit, 1)) : U32}
      +n = {J.u32(J.nth(hit, 2)) : U32}
      +h = {core.hero(run, owner) : J.Val}
      +base = {Bool.pick(U32, J.is_null(h), skills.POISON_BASE(), hero.Hero.scaled(h, skills.POISON_BASE())) : U32}
      +run = {J.set(run, "works", J.set(J.get(run, "works"), "banes", skills.afflict(J.get(J.get(run, "works"), "banes"), foe, "poison", (base * RS.u_clamp(n, 1, 3) : U32), owner))) : J.Val}
      wishcraft.Run.poison_hits.loop2(_t2, run)
