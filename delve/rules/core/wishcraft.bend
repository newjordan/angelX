  (bullet, False{})

def wishcraft.turn_home.if2(_c: Bool, +bullet: J.Val, +t: J.Val) -> J.Val & Bool:
  match _c:
    case True{}:
      +t = {core.set_u(core.set_u(t, "back", 2), "out", 0) : J.Val}
      (J.set(bullet, "traits", t), True{})
    case False{}:
      wishcraft.turn_home.k1(bullet)

# A homing boomerang's speed back to the hand: its own (the thrown blade's is the blade's).

def wishcraft.home_speed(+bullet: J.Val, +blade: F32) -> F32:
  wishcraft.home_speed.if2(core.b(J.get(bullet, "traits"), "boomerang"), bullet, blade)

