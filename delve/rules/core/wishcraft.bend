  match _c:
    case True{}:
      +ticks = {(wishcraft.CHILL_FOE() * U32.min(c, 3) : U32) : U32}
      core.set_u(enemy, "chilled", U32.max(core.u(enemy, "chilled"), ticks))
    case False{}:
      wishcraft.chill.k1(enemy)

