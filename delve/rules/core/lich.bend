# Rimeleap's next link: the nearest knight within reach other than the one just struck.

# `hands` is an array of [id, x, y]; the answer is that triple, or null.

def lich.next_link(+hands: J.Val, +struck: U32, +x: F32, +y: F32) -> J.Val:
  +best = {J.JNull{} : J.Val}
  +best_d = {0.0 : F32}
  lich.next_link.loop2(J.items(hands), struck, x, y, best, best_d)

def lich.next_link.k1(+best: J.Val) -> J.Val:
  best

def lich.next_link.if4(_c: Bool, +struck: U32, +x: F32, +y: F32, +best: J.Val, +best_d: F32, +_t2: List<&2, J.Val>, +p: J.Val, +d: F32) -> J.Val:
  match _c:
    case True{}:
      +best = {p : J.Val}
      +best_d = {d : F32}
      lich.next_link.loop2(_t2, struck, x, y, best, best_d)
    case False{}:
      lich.next_link.loop2(_t2, struck, x, y, best, best_d)

def lich.next_link.if3(_c: Bool, +struck: U32, +x: F32, +y: F32, +best: J.Val, +best_d: F32, +_t2: List<&2, J.Val>, +p: J.Val, +d: F32) -> J.Val:
  match _c:
    case True{}:
      lich.next_link.if4(Bool.or(J.is_null(best), F32.is_lt(d, best_d)), struck, x, y, best, best_d, _t2, p, d)
    case False{}:
      lich.next_link.loop2(_t2, struck, x, y, best, best_d)

def lich.next_link.loop2(+_xs: List<&2, J.Val>, +struck: U32, +x: F32, +y: F32, +best: J.Val, +best_d: F32) -> J.Val:
  match _xs:
    case Nil{}:
      lich.next_link.k1(best)
    case Con{+p, +_t2}:
      +d = {RS.f_hypot((J.f32(J.nth(p, 1)) - x : F32), (J.f32(J.nth(p, 2)) - y : F32)) : F32}
      lich.next_link.if3(Bool.and(Bool.not(U32.is_eq(J.u32(J.nth(p, 0)), struck)), F32.is_lt(d, lich.BOUNCE_REACH())), struck, x, y, best, best_d, _t2, p, d)

# Chills wear off.

def lich.Run.tick_chill(+run: J.Val) -> J.Val:
  +players = {J.get(run, "players") : J.Val}
  lich.Run.tick_chill.loop2(J.fields(players), run, players)

def lich.Run.tick_chill.k1(+run: J.Val, +players: J.Val) -> J.Val:
  J.set(run, "players", players)

def lich.Run.tick_chill.loop2(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +players: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      lich.Run.tick_chill.k1(run, players)
    case Con{+_h2, +_t2}:
      (+k, +h) = _h2
      +players = {J.set(players, k, core.set_u(h, "chilled", core.usub(core.u(h, "chilled"), 1))) : J.Val}
      lich.Run.tick_chill.loop2(_t2, run, players)
