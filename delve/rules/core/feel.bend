  +b = {core.set_s(b, "kind", kind) : J.Val}
  +b = {core.set_u(b, "weight", RS.u_clamp(weight, 1, 3)) : J.Val}
  +b = {core.set_u(b, "knight", knight) : J.Val}
  +b = {core.set_u(b, "ttl", feel.BLOCK_TICKS()) : J.Val}
