  (+dx, +dy) = t
  feel.Feel.block.k2(rules.unit(ox, oy), f, knight, ax, ay, kind, weight, dx, dy)

# A room ends: its pictures and its ledger clear.

def feel.Feel.clear_room(+f: J.Val) -> J.Val:
  feel.Feel.clear_room.loop2(["impacts", "stuck", "tracers", "puffs", "deaths", "blocks", "glints", "takes", "bolts"], f)

def feel.Feel.clear_room.k1(+f: J.Val) -> J.Val:
  +f = {J.set(f, "ledger", J.obj()) : J.Val}
  +f = {J.set(f, "wounded", J.obj()) : J.Val}
  +f = {J.set(f, "credits", J.JA{Nil{}}) : J.Val}
  +f = {J.set(f, "blows", J.JA{Nil{}}) : J.Val}
  J.set(f, "echoes", J.JA{Nil{}})

def feel.Feel.clear_room.loop2(+_xs: List<&2, String>, +f: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Feel.clear_room.k1(f)
    case Con{+k, +_t2}:
      +f = {J.del(f, k) : J.Val}
      feel.Feel.clear_room.loop2(_t2, f)

# One tick of a vector's `ttl` running down, the spent dropped; `drift` moves puffs.

def feel.age_vec(+xs: List<&2, J.Val>, +puffs: Bool) -> List<&2, J.Val>:
  +out = {[] : List<&2, J.Val>}
  feel.age_vec.loop2(xs, puffs, out)

def feel.age_vec.k1(+out: List<&2, J.Val>) -> List<&2, J.Val>:
  out

def feel.age_vec.if4(_c: Bool, +puffs: Bool, +out: List<&2, J.Val>, +_t2: List<&2, J.Val>, +p: J.Val) -> List<&2, J.Val>:
  match _c:
    case True{}:
      +out = {List.append(&2, J.Val, out, [p]) : List<&2, J.Val>}
      feel.age_vec.loop2(_t2, puffs, out)
    case False{}:
      feel.age_vec.loop2(_t2, puffs, out)

def feel.age_vec.k3(+puffs: Bool, +out: List<&2, J.Val>, +_t2: List<&2, J.Val>, +p: J.Val, +ttl: U32) -> List<&2, J.Val>:
  feel.age_vec.if4(U32.is_gt(ttl, 0), puffs, out, _t2, p)

def feel.age_vec.if7(_c: Bool, +puffs: Bool, +out: List<&2, J.Val>, +_t2: List<&2, J.Val>, +p: J.Val, +ttl: U32) -> List<&2, J.Val>:
  match _c:
    case True{}:
      +p = {core.set_f(p, "x", (core.f(p, "x") + ((core.f(p, "dx") * 0.9 : F32) * rules.DT() : F32) : F32)) : J.Val}
      +p = {core.set_f(p, "y", (core.f(p, "y") + ((core.f(p, "dy") * 0.9 : F32) * rules.DT() : F32) : F32)) : J.Val}
      feel.age_vec.k3(puffs, out, _t2, p, ttl)
    case False{}:
      feel.age_vec.k3(puffs, out, _t2, p, ttl)

def feel.age_vec.if6(_c: Bool, +puffs: Bool, +out: List<&2, J.Val>, +_t2: List<&2, J.Val>, +p: J.Val, +ttl: U32) -> List<&2, J.Val>:
  match _c:
    case True{}:
      +p = {core.set_f(p, "x", (core.f(p, "x") + ((core.f(p, "dx") * 1.5 : F32) * rules.DT() : F32) : F32)) : J.Val}
      +p = {core.set_f(p, "y", (core.f(p, "y") + (((core.f(p, "dy") * 1.5 : F32) * rules.DT() : F32) - (0.6 * rules.DT() : F32) : F32) : F32)) : J.Val}
      feel.age_vec.k3(puffs, out, _t2, p, ttl)
    case False{}:
      feel.age_vec.if7(U32.is_gt(core.u(p, "dust"), 0), puffs, out, _t2, p, ttl)

def feel.age_vec.if5(_c: Bool, +puffs: Bool, +out: List<&2, J.Val>, +_t2: List<&2, J.Val>, +p: J.Val, +ttl: U32) -> List<&2, J.Val>:
  match _c:
    case True{}:
      feel.age_vec.if6(core.b(p, "smoke"), puffs, out, _t2, p, ttl)
    case False{}:
      feel.age_vec.k3(puffs, out, _t2, p, ttl)

def feel.age_vec.loop2(+_xs: List<&2, J.Val>, +puffs: Bool, +out: List<&2, J.Val>) -> List<&2, J.Val>:
  match _xs:
    case Nil{}:
      feel.age_vec.k1(out)
    case Con{+p, +_t2}:
      +ttl = {core.usub(core.u(p, "ttl"), 1) : U32}
      +p = {core.set_u(p, "ttl", ttl) : J.Val}
      feel.age_vec.if5(puffs, puffs, out, _t2, p, ttl)

# One tick of the visuals fading.

def feel.Feel.fade(+f: J.Val) -> J.Val:
  +f = {feel.put(f, "impacts", feel.age_vec(feel.vec(f, "impacts"), False{})) : J.Val}
  +f = {feel.put(f, "tracers", feel.age_vec(feel.vec(f, "tracers"), False{})) : J.Val}
  +f = {feel.put(f, "puffs", feel.age_vec(feel.vec(f, "puffs"), True{})) : J.Val}
  +f = {feel.put(f, "deaths", feel.age_vec(feel.vec(f, "deaths"), False{})) : J.Val}
  +f = {feel.put(f, "blocks", feel.age_vec(feel.vec(f, "blocks"), False{})) : J.Val}
  +f = {feel.put(f, "glints", feel.age_vec(feel.vec(f, "glints"), False{})) : J.Val}
  +f = {feel.put(f, "takes", feel.age_vec(feel.vec(f, "takes"), False{})) : J.Val}
  feel.put(f, "bolts", feel.age_vec(feel.vec(f, "bolts"), False{}))

# A map {id: n} with n added to id's entry.

def feel.add_to(+m: J.Val, +id: U32, +n: U32) -> J.Val:
  core.set_u(m, U32.show(id), core.uadd(core.u(m, U32.show(id)), n))

def feel.Run.tick_feel(+run: J.Val, +credits: J.Val, +grazes: J.Val) -> J.Val:
  +f = {feel.Feel.fade(J.get(run, "feel")) : J.Val}
  +dealt = {J.obj() : J.Val}
  +valour = {J.obj() : J.Val}
  +other = {J.get(f, "credits") : J.Val}
  +f = {J.set(f, "credits", J.JA{Nil{}}) : J.Val}
  +run = {J.set(run, "feel", f) : J.Val}
  feel.Run.tick_feel.loop18(List.append(&2, J.Val, J.items(credits), J.items(other)), run, grazes, dealt, valour)

def feel.Run.tick_feel.k5(+run: J.Val, +works: J.Val, +kits: J.Val) -> J.Val:
  +run = {J.set(run, "works", J.set(works, "kits", kits)) : J.Val}
  feel.Run.fly_coins(run)

def feel.Run.tick_feel.if7(_c: Bool, +run: J.Val, +valour: J.Val, +works: J.Val, +kits: J.Val, +_t6: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +gain: J.Val) -> J.Val:
  match _c:
    case True{}:
      +kit = {core.or_else(J.get(kits, k), skills.Kit.default()) : J.Val}
      +kits = {J.set(kits, k, core.set_u(kit, "valour", U32.min(core.uadd(core.u(kit, "valour"), J.u32(gain)), (feel.PIPS() * feel.VALOUR_PIP() : U32)))) : J.Val}
      feel.Run.tick_feel.loop6(_t6, run, valour, works, kits)
    case False{}:
      feel.Run.tick_feel.loop6(_t6, run, valour, works, kits)

def feel.Run.tick_feel.loop6(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +valour: J.Val, +works: J.Val, +kits: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.tick_feel.k5(run, works, kits)
    case Con{+_h6, +_t6}:
      (+k, +gain) = _h6
      feel.Run.tick_feel.if7(J.has(J.get(run, "players"), k), run, valour, works, kits, _t6, k, gain)

def feel.Run.tick_feel.k4(+run: J.Val, +valour: J.Val, +works: J.Val, +kits: J.Val) -> J.Val:
  feel.Run.tick_feel.loop6(J.int_fields(valour), run, valour, works, kits)

def feel.Run.tick_feel.loop8(+_xs: List<&2, J.Val>, +run: J.Val, +valour: J.Val, +works: J.Val, +kits: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.tick_feel.k4(run, valour, works, kits)
    case Con{+g, +_t8}:
      +valour = {feel.add_to(valour, J.u32(g), feel.GRAZE_VALOUR()) : J.Val}
      feel.Run.tick_feel.loop8(_t8, run, valour, works, kits)

def feel.Run.tick_feel.k3(+run: J.Val, +grazes: J.Val, +valour: J.Val, +works: J.Val, +kits: J.Val) -> J.Val:
  feel.Run.tick_feel.loop8(J.items(grazes), run, valour, works, kits)

def feel.Run.tick_feel.loop9(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +grazes: J.Val, +valour: J.Val, +works: J.Val, +kits: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.tick_feel.k3(run, grazes, valour, works, kits)
    case Con{+_h9, +_t9}:
      (+k, +kit) = _h9
      +kits = {J.set(kits, k, core.set_u(kit, "burning", core.usub(core.u(kit, "burning"), 1))) : J.Val}
      feel.Run.tick_feel.loop9(_t9, run, grazes, valour, works, kits)

def feel.Run.tick_feel.k2(+run: J.Val, +grazes: J.Val, +valour: J.Val) -> J.Val:
  +works = {J.get(run, "works") : J.Val}
  +kits = {J.get(works, "kits") : J.Val}
  feel.Run.tick_feel.loop9(J.fields(kits), run, grazes, valour, works, kits)

def feel.Run.tick_feel.k11(+run: J.Val, +grazes: J.Val, +valour: J.Val, +ledger: J.Val) -> J.Val:
  +run = {J.set(run, "feel", J.set(J.get(run, "feel"), "ledger", ledger)) : J.Val}
  feel.Run.tick_feel.k2(run, grazes, valour)

def feel.Run.tick_feel.k14(+run: J.Val, +grazes: J.Val, +dealt: J.Val, +valour: J.Val, +ledger: J.Val, +_t12: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +t: J.Val, +n: U32) -> J.Val:
  +t = {core.set_u(t, "grazes", core.uadd(core.u(t, "grazes"), n)) : J.Val}
  +ledger = {J.set(ledger, k, t) : J.Val}
  feel.Run.tick_feel.loop12(_t12, run, grazes, dealt, valour, ledger)

def feel.Run.tick_feel.if16(_c: Bool, +run: J.Val, +grazes: J.Val, +dealt: J.Val, +valour: J.Val, +ledger: J.Val, +_t12: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +t: J.Val, +n: U32, +_t15: List<&2, J.Val>) -> J.Val:
  match _c:
    case True{}:
      +n = {(n + 1 : U32) : U32}
      feel.Run.tick_feel.loop15(_t15, run, grazes, dealt, valour, ledger, _t12, k, t, n)
    case False{}:
      feel.Run.tick_feel.loop15(_t15, run, grazes, dealt, valour, ledger, _t12, k, t, n)

def feel.Run.tick_feel.loop15(+_xs: List<&2, J.Val>, +run: J.Val, +grazes: J.Val, +dealt: J.Val, +valour: J.Val, +ledger: J.Val, +_t12: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +t: J.Val, +n: U32) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.tick_feel.k14(run, grazes, dealt, valour, ledger, _t12, k, t, n)
    case Con{+g, +_t15}:
      feel.Run.tick_feel.if16(U32.is_eq(J.u32(g), rules.Run.step.id(k)), run, grazes, dealt, valour, ledger, _t12, k, t, n, _t15)

def feel.Run.tick_feel.k13(+run: J.Val, +grazes: J.Val, +dealt: J.Val, +valour: J.Val, +ledger: J.Val, +_t12: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +t: J.Val) -> J.Val:
  +n = {0 : U32}
  feel.Run.tick_feel.loop15(J.items(grazes), run, grazes, dealt, valour, ledger, _t12, k, t, n)

def feel.Run.tick_feel.if17(_c: Bool, +run: J.Val, +grazes: J.Val, +dealt: J.Val, +valour: J.Val, +ledger: J.Val, +_t12: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +t: J.Val) -> J.Val:
  match _c:
    case True{}:
      +t = {core.set_u(t, "damage", core.uadd(core.u(t, "damage"), core.u(dealt, k))) : J.Val}
      feel.Run.tick_feel.k13(run, grazes, dealt, valour, ledger, _t12, k, t)
    case False{}:
      +t = {core.set_u(t, "dead", core.uadd(core.u(t, "dead"), 1)) : J.Val}
      feel.Run.tick_feel.k13(run, grazes, dealt, valour, ledger, _t12, k, t)

def feel.Run.tick_feel.loop12(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +grazes: J.Val, +dealt: J.Val, +valour: J.Val, +ledger: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.tick_feel.k11(run, grazes, valour, ledger)
    case Con{+_h12, +_t12}:
      (+k, +h) = _h12
      +t = {core.or_else(J.get(ledger, k), feel.Tally.default()) : J.Val}
      feel.Run.tick_feel.if17(J.has(dealt, k), run, grazes, dealt, valour, ledger, _t12, k, t)

def feel.Run.tick_feel.if10(_c: Bool, +run: J.Val, +grazes: J.Val, +dealt: J.Val, +valour: J.Val) -> J.Val:
  match _c:
    case True{}:
      +ledger = {J.get(J.get(run, "feel"), "ledger") : J.Val}
      feel.Run.tick_feel.loop12(J.int_fields(J.get(run, "players")), run, grazes, dealt, valour, ledger)
    case False{}:
      feel.Run.tick_feel.k2(run, grazes, valour)

def feel.Run.tick_feel.k1(+run: J.Val, +grazes: J.Val, +dealt: J.Val, +valour: J.Val) -> J.Val:
  +run = {floor_stats.Run.tally_floor(run, dealt) : J.Val}
  feel.Run.tick_feel.if10(Bool.and(feel.ledger_on(run), core.phase_is(run, "fighting")), run, grazes, dealt, valour)

def feel.Run.tick_feel.if19(_c: Bool, +run: J.Val, +grazes: J.Val, +dealt: J.Val, +valour: J.Val, +_t18: List<&2, J.Val>, +id: U32) -> J.Val:
  match _c:
    case True{}:
      +valour = {feel.add_to(valour, id, feel.VALOUR_HIT()) : J.Val}
      feel.Run.tick_feel.loop18(_t18, run, grazes, dealt, valour)
    case False{}:
      feel.Run.tick_feel.loop18(_t18, run, grazes, dealt, valour)

def feel.Run.tick_feel.loop18(+_xs: List<&2, J.Val>, +run: J.Val, +grazes: J.Val, +dealt: J.Val, +valour: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.tick_feel.k1(run, grazes, dealt, valour)
    case Con{+c, +_t18}:
      +id = {J.u32(J.nth(c, 0)) : U32}
      +damage = {J.u32(J.nth(c, 1)) : U32}
      +dealt = {feel.add_to(dealt, id, damage) : J.Val}
      feel.Run.tick_feel.if19(U32.is_gt(damage, 0), run, grazes, dealt, valour, _t18, id)

def feel.Tally.default() -> J.Val:
  +t = {J.obj() : J.Val}
  feel.Tally.default.loop2(["shots", "hits", "kills", "damage", "dead", "skills", "grazes", "ttk"], t)

def feel.Tally.default.k1(+t: J.Val) -> J.Val:
  t

def feel.Tally.default.loop2(+_xs: List<&2, String>, +t: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Tally.default.k1(t)
    case Con{+k, +_t2}:
      +t = {core.set_u(t, k, 0) : J.Val}
      feel.Tally.default.loop2(_t2, t)

# Every hostile shot `near` catches turns to a coin (as many as there is room for).

def feel.Run.cancel_shots_where(+run: J.Val, +mask: List<&2, Bool>) -> J.Val:
  +f = {J.get(run, "feel") : J.Val}
  +coins = {feel.vec(f, "coins") : List<&2, J.Val>}
  +room = {core.usub(feel.COINS(), U32.from_nat(List.length(&2, J.Val, coins))) : U32}
  +made = {0 : U32}
  +ms = {mask : List<&2, Bool>}
  feel.Run.cancel_shots_where.loop4(J.items(J.get(run, "projectiles")), run, coins, room, made, ms)

def feel.Run.cancel_shots_where.k2(+run: J.Val, +coins: List<&2, J.Val>) -> J.Val:
  J.set(run, "feel", feel.put(J.get(run, "feel"), "coins", coins))

def feel.Run.cancel_shots_where.if3(_c: Bool, +run: J.Val, +coins: List<&2, J.Val>) -> J.Val:
  match _c:
    case True{}:
      +run = {core.push_sound(run, "spoil_pickup") : J.Val}
      feel.Run.cancel_shots_where.k2(run, coins)
    case False{}:
      feel.Run.cancel_shots_where.k2(run, coins)

def feel.Run.cancel_shots_where.k1(+run: J.Val, +coins: List<&2, J.Val>, +made: U32) -> J.Val:
  feel.Run.cancel_shots_where.if3(U32.is_ne(made, 0), run, coins)

def feel.Run.cancel_shots_where.if6(_c: Bool, +run: J.Val, +coins: List<&2, J.Val>, +room: U32, +made: U32, +ms: List<&2, Bool>, +_t4: List<&2, J.Val>, +p: J.Val) -> J.Val:
  match _c:
    case True{}:
      +coin = {J.obj() : J.Val}
      +coin = {core.set_f(coin, "x", core.f(p, "x")) : J.Val}
      +coin = {core.set_f(coin, "y", core.f(p, "y")) : J.Val}
      +coin = {core.set_u(coin, "age", 0) : J.Val}
      +coins = {List.append(&2, J.Val, coins, [coin]) : List<&2, J.Val>}
      +made = {(made + 1 : U32) : U32}
      feel.Run.cancel_shots_where.loop4(_t4, run, coins, room, made, ms)
    case False{}:
      feel.Run.cancel_shots_where.loop4(_t4, run, coins, room, made, ms)

def feel.Run.cancel_shots_where.k5(+run: J.Val, +coins: List<&2, J.Val>, +room: U32, +made: U32, +ms: List<&2, Bool>, +_t4: List<&2, J.Val>, +p: J.Val, +hit: Bool) -> J.Val:
  feel.Run.cancel_shots_where.if6(Bool.and(Bool.and(core.b(p, "hostile"), hit), U32.is_lt(made, room)), run, coins, room, made, ms, _t4, p)

def feel.Run.cancel_shots_where.m7(+s: List<&2, Bool>, +run: J.Val, +coins: List<&2, J.Val>, +room: U32, +made: U32, +ms: List<&2, Bool>, +_t4: List<&2, J.Val>, +p: J.Val, +hit: Bool) -> J.Val:
  match s:
    case Con{+m, +rest}:
      +hit = {m : Bool}
      +ms = {rest : List<&2, Bool>}
      feel.Run.cancel_shots_where.k5(run, coins, room, made, ms, _t4, p, hit)
    case Nil{}:
      +hit = {False{} : Bool}
      feel.Run.cancel_shots_where.k5(run, coins, room, made, ms, _t4, p, hit)

def feel.Run.cancel_shots_where.loop4(+_xs: List<&2, J.Val>, +run: J.Val, +coins: List<&2, J.Val>, +room: U32, +made: U32, +ms: List<&2, Bool>) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.cancel_shots_where.k1(run, coins, made)
    case Con{+p, +_t4}:
      +hit = {False{} : Bool}
      feel.Run.cancel_shots_where.m7(ms, run, coins, room, made, ms, _t4, p, hit)

def feel.Run.cancel_shots(+run: J.Val) -> J.Val:
  +mask = {[] : List<&2, Bool>}
  feel.Run.cancel_shots.loop2(J.items(J.get(run, "projectiles")), run, mask)

def feel.Run.cancel_shots.k1(+run: J.Val, +mask: List<&2, Bool>) -> J.Val:
  feel.Run.cancel_shots_where(run, mask)

def feel.Run.cancel_shots.loop2(+_xs: List<&2, J.Val>, +run: J.Val, +mask: List<&2, Bool>) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.cancel_shots.k1(run, mask)
    case Con{+p, +_t2}:
      +mask = {List.append(&2, Bool, mask, [True{}]) : List<&2, Bool>}
      feel.Run.cancel_shots.loop2(_t2, run, mask)

# Coins fly home to the nearest standing knight, and are caught.

def feel.Run.fly_coins(+run: J.Val) -> J.Val:
  +f = {J.get(run, "feel") : J.Val}
  +coins = {feel.vec(f, "coins") : List<&2, J.Val>}
  feel.Run.fly_coins.if16(U32.is_zero(U32.from_nat(List.length(&2, J.Val, coins))), run, f, coins)

def feel.Run.fly_coins.k4(+run: J.Val) -> J.Val:
  run

def feel.Run.fly_coins.if5(_c: Bool, +run: J.Val, +n: U32) -> J.Val:
  match _c:
    case True{}:
      +run = {core.set_u(run, "score", core.uadd(core.u(run, "score"), (n * feel.COIN_GOLD() : U32))) : J.Val}
      +run = {core.push_sound(run, "spoil_pickup") : J.Val}
      feel.Run.fly_coins.k4(run)
    case False{}:
      feel.Run.fly_coins.k4(run)

def feel.Run.fly_coins.k3(+run: J.Val, +caught: List<&2, U32>) -> J.Val:
  +n = {U32.from_nat(List.length(&2, U32, caught)) : U32}
  feel.Run.fly_coins.if5(U32.is_ne(n, 0), run, n)

def feel.Run.fly_coins.if7(_c: Bool, +run: J.Val, +caught: List<&2, U32>, +_t6: List<&2, U32>, +id: U32, +h: J.Val) -> J.Val:
  match _c:
    case True{}:
      +gold = {curios.Hero.curio_gold(h, feel.COIN_GOLD()) : U32}
      +h = {J.set(h, "carried", realm.Spoils.add(J.get(h, "carried"), "gold", gold)) : J.Val}
      +run = {core.set_hero(run, id, h) : J.Val}
      feel.Run.fly_coins.loop6(_t6, run, caught)
    case False{}:
      feel.Run.fly_coins.loop6(_t6, run, caught)

def feel.Run.fly_coins.loop6(+_xs: List<&2, U32>, +run: J.Val, +caught: List<&2, U32>) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.fly_coins.k3(run, caught)
    case Con{+id, +_t6}:
      +h = {core.hero(run, id) : J.Val}
      feel.Run.fly_coins.if7(Bool.not(J.is_null(h)), run, caught, _t6, id, h)

def feel.Run.fly_coins.k2(+run: J.Val, +f: J.Val, +coins: List<&2, J.Val>, +kept: List<&2, J.Val>, +caught: List<&2, U32>) -> J.Val:
  +run = {J.set(run, "feel", feel.put(f, "coins", kept)) : J.Val}
  feel.Run.fly_coins.loop6(caught, run, caught)

def feel.Run.fly_coins.k12(t: F32 & F32, +run: J.Val, +f: J.Val, +coins: List<&2, J.Val>, +kept: List<&2, J.Val>, +caught: List<&2, U32>, +_t8: List<&2, J.Val>, +coin: J.Val, +step: F32) -> J.Val:
  (+ux, +uy) = t
  +coin = {core.set_f(coin, "x", (core.f(coin, "x") + (ux * step : F32) : F32)) : J.Val}
  +lift = {Bool.pick(F32, U32.is_lt(core.u(coin, "age"), 6), 0.08, 0.0) : F32}
  +coin = {core.set_f(coin, "y", (core.f(coin, "y") + ((uy * step : F32) - lift : F32) : F32)) : J.Val}
  +kept = {List.append(&2, J.Val, kept, [coin]) : List<&2, J.Val>}
  feel.Run.fly_coins.loop8(_t8, run, f, coins, kept, caught)

def feel.Run.fly_coins.if11(_c: Bool, +run: J.Val, +f: J.Val, +coins: List<&2, J.Val>, +kept: List<&2, J.Val>, +caught: List<&2, U32>, +_t8: List<&2, J.Val>, +coin: J.Val, +best: U32, +best_d: F32, +bx: F32, +by: F32) -> J.Val:
  match _c:
    case True{}:
      +caught = {List.append(&2, U32, caught, [best]) : List<&2, U32>}
      feel.Run.fly_coins.loop8(_t8, run, f, coins, kept, caught)
    case False{}:
      +speed = {(feel.COIN_SPEED() * RS.f_min((RS.u_as_f32(core.u(coin, "age")) / 10.0 : F32), 1.0) : F32) : F32}
      +step = {RS.f_min((speed * rules.DT() : F32), best_d) : F32}
      feel.Run.fly_coins.k12(rules.unit((bx - core.f(coin, "x") : F32), (by - core.f(coin, "y") : F32)), run, f, coins, kept, caught, _t8, coin, step)

def feel.Run.fly_coins.if10(_c: Bool, +run: J.Val, +f: J.Val, +coins: List<&2, J.Val>, +kept: List<&2, J.Val>, +caught: List<&2, U32>, +_t8: List<&2, J.Val>, +coin: J.Val, +best: U32, +best_d: F32, +bx: F32, +by: F32) -> J.Val:
  match _c:
    case True{}:
      +kept = {List.append(&2, J.Val, kept, [coin]) : List<&2, J.Val>}
      feel.Run.fly_coins.loop8(_t8, run, f, coins, kept, caught)
    case False{}:
      feel.Run.fly_coins.if11(F32.is_lt(best_d, feel.COIN_CATCH()), run, f, coins, kept, caught, _t8, coin, best, best_d, bx, by)

def feel.Run.fly_coins.k9(+run: J.Val, +f: J.Val, +coins: List<&2, J.Val>, +kept: List<&2, J.Val>, +caught: List<&2, U32>, +_t8: List<&2, J.Val>, +coin: J.Val, +best: U32, +best_d: F32, +found: Bool, +bx: F32, +by: F32) -> J.Val:
  feel.Run.fly_coins.if10(Bool.not(found), run, f, coins, kept, caught, _t8, coin, best, best_d, bx, by)

def feel.Run.fly_coins.if15(_c: Bool, +run: J.Val, +f: J.Val, +coins: List<&2, J.Val>, +kept: List<&2, J.Val>, +caught: List<&2, U32>, +_t8: List<&2, J.Val>, +coin: J.Val, +best: U32, +best_d: F32, +found: Bool, +bx: F32, +by: F32, +_t13: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +h: J.Val, +d: F32) -> J.Val:
  match _c:
    case True{}:
      +best = {rules.Run.step.id(k) : U32}
      +best_d = {d : F32}
      +bx = {core.f(h, "x") : F32}
      +by = {core.f(h, "y") : F32}
      +found = {True{} : Bool}
      feel.Run.fly_coins.loop13(_t13, run, f, coins, kept, caught, _t8, coin, best, best_d, found, bx, by)
    case False{}:
      feel.Run.fly_coins.loop13(_t13, run, f, coins, kept, caught, _t8, coin, best, best_d, found, bx, by)

def feel.Run.fly_coins.if14(_c: Bool, +run: J.Val, +f: J.Val, +coins: List<&2, J.Val>, +kept: List<&2, J.Val>, +caught: List<&2, U32>, +_t8: List<&2, J.Val>, +coin: J.Val, +best: U32, +best_d: F32, +found: Bool, +bx: F32, +by: F32, +_t13: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +h: J.Val) -> J.Val:
  match _c:
    case True{}:
      +d = {RS.f_hypot((core.f(h, "x") - core.f(coin, "x") : F32), (core.f(h, "y") - core.f(coin, "y") : F32)) : F32}
      feel.Run.fly_coins.if15(Bool.or(Bool.not(found), F32.is_lt(d, best_d)), run, f, coins, kept, caught, _t8, coin, best, best_d, found, bx, by, _t13, k, h, d)
    case False{}:
      feel.Run.fly_coins.loop13(_t13, run, f, coins, kept, caught, _t8, coin, best, best_d, found, bx, by)

def feel.Run.fly_coins.loop13(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +f: J.Val, +coins: List<&2, J.Val>, +kept: List<&2, J.Val>, +caught: List<&2, U32>, +_t8: List<&2, J.Val>, +coin: J.Val, +best: U32, +best_d: F32, +found: Bool, +bx: F32, +by: F32) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.fly_coins.k9(run, f, coins, kept, caught, _t8, coin, best, best_d, found, bx, by)
    case Con{+_h13, +_t13}:
      (+k, +h) = _h13
      feel.Run.fly_coins.if14(Bool.and(U32.is_ne(core.u(h, "hp"), 0), Bool.not(core.b(h, "stone"))), run, f, coins, kept, caught, _t8, coin, best, best_d, found, bx, by, _t13, k, h)

def feel.Run.fly_coins.loop8(+_xs: List<&2, J.Val>, +run: J.Val, +f: J.Val, +coins: List<&2, J.Val>, +kept: List<&2, J.Val>, +caught: List<&2, U32>) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.fly_coins.k2(run, f, coins, kept, caught)
    case Con{+coin, +_t8}:
      +coin = {core.set_u(coin, "age", core.uadd(core.u(coin, "age"), 1)) : J.Val}
      +best = {0 : U32}
      +best_d = {0.0 : F32}
      +found = {False{} : Bool}
      +bx = {0.0 : F32}
      +by = {0.0 : F32}
      feel.Run.fly_coins.loop13(J.int_fields(J.get(run, "players")), run, f, coins, kept, caught, _t8, coin, best, best_d, found, bx, by)

def feel.Run.fly_coins.k1(+run: J.Val, +f: J.Val, +coins: List<&2, J.Val>) -> J.Val:
  +kept = {[] : List<&2, J.Val>}
  +caught = {[] : List<&2, U32>}
  feel.Run.fly_coins.loop8(coins, run, f, coins, kept, caught)

def feel.Run.fly_coins.if16(_c: Bool, +run: J.Val, +f: J.Val, +coins: List<&2, J.Val>) -> J.Val:
  match _c:
    case True{}:
      run
    case False{}:
      feel.Run.fly_coins.k1(run, f, coins)

# The room ends: coins left lie in the nearest standing knight's purse.

def feel.Run.bank_coins(+run: J.Val) -> J.Val:
  +coins = {feel.vec(J.get(run, "feel"), "coins") : List<&2, J.Val>}
  +run = {J.set(run, "feel", feel.put(J.get(run, "feel"), "coins", [])) : J.Val}
  feel.Run.bank_coins.loop2(coins, run)

def feel.Run.bank_coins.k1(+run: J.Val) -> J.Val:
  run

def feel.Run.bank_coins.if4(_c: Bool, +run: J.Val, +_t2: List<&2, J.Val>, +best: U32) -> J.Val:
  match _c:
    case True{}:
      +h = {core.hero(run, best) : J.Val}
      +gold = {curios.Hero.curio_gold(h, feel.COIN_GOLD()) : U32}
      +h = {J.set(h, "carried", realm.Spoils.add(J.get(h, "carried"), "gold", gold)) : J.Val}
      +run = {core.set_hero(run, best, h) : J.Val}
      +run = {core.set_u(run, "score", core.uadd(core.u(run, "score"), feel.COIN_GOLD())) : J.Val}
      feel.Run.bank_coins.loop2(_t2, run)
    case False{}:
      feel.Run.bank_coins.loop2(_t2, run)

def feel.Run.bank_coins.k3(+run: J.Val, +_t2: List<&2, J.Val>, +best: U32, +found: Bool) -> J.Val:
  feel.Run.bank_coins.if4(found, run, _t2, best)

def feel.Run.bank_coins.if7(_c: Bool, +run: J.Val, +_t2: List<&2, J.Val>, +coin: J.Val, +best: U32, +best_d: F32, +found: Bool, +_t5: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +d: F32) -> J.Val:
  match _c:
    case True{}:
      +best = {rules.Run.step.id(k) : U32}
      +best_d = {d : F32}
      +found = {True{} : Bool}
      feel.Run.bank_coins.loop5(_t5, run, _t2, coin, best, best_d, found)
    case False{}:
      feel.Run.bank_coins.loop5(_t5, run, _t2, coin, best, best_d, found)

def feel.Run.bank_coins.if6(_c: Bool, +run: J.Val, +_t2: List<&2, J.Val>, +coin: J.Val, +best: U32, +best_d: F32, +found: Bool, +_t5: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +h: J.Val) -> J.Val:
  match _c:
    case True{}:
      +d = {RS.f_hypot((core.f(h, "x") - core.f(coin, "x") : F32), (core.f(h, "y") - core.f(coin, "y") : F32)) : F32}
      feel.Run.bank_coins.if7(Bool.or(Bool.not(found), F32.is_lt(d, best_d)), run, _t2, coin, best, best_d, found, _t5, k, d)
    case False{}:
      feel.Run.bank_coins.loop5(_t5, run, _t2, coin, best, best_d, found)

def feel.Run.bank_coins.loop5(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +_t2: List<&2, J.Val>, +coin: J.Val, +best: U32, +best_d: F32, +found: Bool) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.bank_coins.k3(run, _t2, best, found)
    case Con{+_h5, +_t5}:
      (+k, +h) = _h5
      feel.Run.bank_coins.if6(Bool.and(U32.is_ne(core.u(h, "hp"), 0), Bool.not(core.b(h, "stone"))), run, _t2, coin, best, best_d, found, _t5, k, h)

def feel.Run.bank_coins.loop2(+_xs: List<&2, J.Val>, +run: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.bank_coins.k1(run)
    case Con{+coin, +_t2}:
      +best = {0 : U32}
      +best_d = {0.0 : F32}
      +found = {False{} : Bool}
      feel.Run.bank_coins.loop5(J.int_fields(J.get(run, "players")), run, _t2, coin, best, best_d, found)

def feel.Run.pips(+run: J.Val, +id: U32) -> U32:
  +k = {J.get(J.get(J.get(run, "works"), "kits"), U32.show(id)) : J.Val}
  U32.div(core.u(k, "valour"), feel.VALOUR_PIP())

def feel.Run.synergy(+run: J.Val, +id: U32, +name: String, +word: String) -> J.Val:
  +run = {J.set(run, "found", J.JA{[run_tick(run), J.JU{id}, J.JS{String.append(name, "!")}]}) : J.Val}
  core.push_cue(run, String.append("synergy:", word))

def run_tick(+run: J.Val) -> J.Val:
  J.get(run, "tick")

def feel.Run.ledger_skill(+run: J.Val, +id: U32) -> J.Val:
  feel.Run.ledger_skill.if2(Bool.not(feel.ledger_on(run)), run, id)

def feel.Run.ledger_skill.k1(+run: J.Val, +id: U32) -> J.Val:
  +ledger = {J.get(J.get(run, "feel"), "ledger") : J.Val}
  +t = {core.or_else(J.get(ledger, U32.show(id)), feel.Tally.default()) : J.Val}
  +t = {core.set_u(t, "skills", core.uadd(core.u(t, "skills"), 1)) : J.Val}
  J.set(run, "feel", J.set(J.get(run, "feel"), "ledger", J.set(ledger, U32.show(id), t)))

def feel.Run.ledger_skill.if2(_c: Bool, +run: J.Val, +id: U32) -> J.Val:
  match _c:
    case True{}:
      run
    case False{}:
      feel.Run.ledger_skill.k1(run, id)

def feel.Run.skill_synergy(+run: J.Val, +id: U32, +which: U32) -> J.Val:
  +h = {core.hero(run, id) : J.Val}
  +bow = {Bool.and(J.is_null(J.get(h, "forged")), String.eq(core.s(h, "weapon"), "bow")) : Bool}
  feel.Run.skill_synergy.if2(Bool.and(U32.is_eq(which, skills.FIRE()), bow), run, id)

def feel.Run.skill_synergy.k1(+run: J.Val) -> J.Val:
  run

def feel.Run.skill_synergy.k3(+run: J.Val, +id: U32) -> J.Val:
  +run = {feel.Run.synergy(run, id, "Fire Arrows", "fire_arrows") : J.Val}
  feel.Run.skill_synergy.k1(run)

def feel.Run.skill_synergy.if4(_c: Bool, +run: J.Val, +id: U32, +works: J.Val, +kits: J.Val) -> J.Val:
  match _c:
    case True{}:
      +kit = {core.set_u(J.get(kits, U32.show(id)), "burning", feel.FIRE_ARROWS()) : J.Val}
      +run = {J.set(run, "works", J.set(works, "kits", J.set(kits, U32.show(id), kit))) : J.Val}
      feel.Run.skill_synergy.k3(run, id)
    case False{}:
      feel.Run.skill_synergy.k3(run, id)

def feel.Run.skill_synergy.if2(_c: Bool, +run: J.Val, +id: U32) -> J.Val:
  match _c:
    case True{}:
      +works = {J.get(run, "works") : J.Val}
      +kits = {J.get(works, "kits") : J.Val}
      feel.Run.skill_synergy.if4(J.has(kits, U32.show(id)), run, id, works, kits)
    case False{}:
      feel.Run.skill_synergy.k1(run)

# Burns, ricochets and powder kegs the shots set off.

def feel.Run.land_synergies(+run: J.Val, +burns: J.Val, +turned: J.Val, +kegs: J.Val) -> J.Val:
  feel.Run.land_synergies.loop7(J.items(burns), run, turned, kegs)

def feel.Run.land_synergies.k3(+run: J.Val) -> J.Val:
  run

def feel.Run.land_synergies.if5(_c: Bool, +run: J.Val, +_t4: List<&2, J.Val>, +k: J.Val, +i: U32, +clouds: J.Val) -> J.Val:
  match _c:
    case True{}:
      +cloud = {J.nth(clouds, i) : J.Val}
      +run = {J.set(run, "works", J.set(J.get(run, "works"), "clouds", feel.remove_nth(clouds, i))) : J.Val}
      +run = {skills.Run.flash(run, cloud) : J.Val}
      +run = {feel.Run.synergy(run, J.u32(J.nth(k, 1)), "Powder Keg", "powder_keg") : J.Val}
      feel.Run.land_synergies.loop4(_t4, run)
    case False{}:
      feel.Run.land_synergies.loop4(_t4, run)

def feel.Run.land_synergies.loop4(+_xs: List<&2, J.Val>, +run: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.land_synergies.k3(run)
    case Con{+k, +_t4}:
      +i = {J.u32(J.nth(k, 0)) : U32}
      +clouds = {J.get(J.get(run, "works"), "clouds") : J.Val}
      feel.Run.land_synergies.if5(U32.is_lt(i, core.count(clouds)), run, _t4, k, i, clouds)

def feel.Run.land_synergies.k2(+run: J.Val, +kegs: J.Val) -> J.Val:
  +order = {feel.sort_desc(J.items(kegs)) : List<&2, J.Val>}
  feel.Run.land_synergies.loop4(order, run)

def feel.Run.land_synergies.loop6(+_xs: List<&2, J.Val>, +run: J.Val, +kegs: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.land_synergies.k2(run, kegs)
    case Con{+owner, +_t6}:
      +run = {feel.Run.synergy(run, J.u32(owner), "Ricochet", "ricochet") : J.Val}
      feel.Run.land_synergies.loop6(_t6, run, kegs)

def feel.Run.land_synergies.k1(+run: J.Val, +turned: J.Val, +kegs: J.Val) -> J.Val:
  feel.Run.land_synergies.loop6(J.items(turned), run, kegs)

def feel.Run.land_synergies.loop7(+_xs: List<&2, J.Val>, +run: J.Val, +turned: J.Val, +kegs: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      feel.Run.land_synergies.k1(run, turned, kegs)
    case Con{+b, +_t7}:
      +owner = {J.u32(J.nth(b, 1)) : U32}
      +base = {skills.BURN_BASE() : U32}
      +h = {core.hero(run, owner) : J.Val}
      +power = {Bool.pick(U32, J.is_null(h), base, hero.Hero.scaled(h, base)) : U32}
      +power = {(power * RS.u_clamp(J.u32(J.nth(b, 2)), 1, 3) : U32) : U32}
      +run = {J.set(run, "works", J.set(J.get(run, "works"), "banes", skills.afflict(J.get(J.get(run, "works"), "banes"), J.u32(J.nth(b, 0)), "burn", power, owner))) : J.Val}
      feel.Run.land_synergies.loop7(_t7, run, turned, kegs)

# [idx, owner] pairs sorted by idx, largest first (stable).

def feel.sort_desc(+xs: List<&2, J.Val>) -> List<&2, J.Val>:
  +out = {[] : List<&2, J.Val>}
  feel.sort_desc.loop2(xs, out)

def feel.sort_desc.k1(+out: List<&2, J.Val>) -> List<&2, J.Val>:
  out

def feel.sort_desc.k4(+out: List<&2, J.Val>, +_t2: List<&2, J.Val>, +next: List<&2, J.Val>) -> List<&2, J.Val>:
  +out = {next : List<&2, J.Val>}
  feel.sort_desc.loop2(_t2, out)

def feel.sort_desc.if5(_c: Bool, +out: List<&2, J.Val>, +_t2: List<&2, J.Val>, +x: J.Val, +next: List<&2, J.Val>) -> List<&2, J.Val>:
  match _c:
    case True{}:
      +next = {List.append(&2, J.Val, next, [x]) : List<&2, J.Val>}
      feel.sort_desc.k4(out, _t2, next)
    case False{}:
      feel.sort_desc.k4(out, _t2, next)

def feel.sort_desc.k3(+out: List<&2, J.Val>, +_t2: List<&2, J.Val>, +x: J.Val, +placed: Bool, +next: List<&2, J.Val>) -> List<&2, J.Val>:
  feel.sort_desc.if5(Bool.not(placed), out, _t2, x, next)

def feel.sort_desc.k7(+out: List<&2, J.Val>, +_t2: List<&2, J.Val>, +x: J.Val, +placed: Bool, +next: List<&2, J.Val>, +_t6: List<&2, J.Val>, +y: J.Val) -> List<&2, J.Val>:
  +next = {List.append(&2, J.Val, next, [y]) : List<&2, J.Val>}
  feel.sort_desc.loop6(_t6, out, _t2, x, placed, next)

def feel.sort_desc.if8(_c: Bool, +out: List<&2, J.Val>, +_t2: List<&2, J.Val>, +x: J.Val, +placed: Bool, +next: List<&2, J.Val>, +_t6: List<&2, J.Val>, +y: J.Val) -> List<&2, J.Val>:
  match _c:
    case True{}:
      +next = {List.append(&2, J.Val, next, [x]) : List<&2, J.Val>}
      +placed = {True{} : Bool}
      feel.sort_desc.k7(out, _t2, x, placed, next, _t6, y)
    case False{}:
      feel.sort_desc.k7(out, _t2, x, placed, next, _t6, y)

def feel.sort_desc.loop6(+_xs: List<&2, J.Val>, +out: List<&2, J.Val>, +_t2: List<&2, J.Val>, +x: J.Val, +placed: Bool, +next: List<&2, J.Val>) -> List<&2, J.Val>:
  match _xs:
    case Nil{}:
      feel.sort_desc.k3(out, _t2, x, placed, next)
    case Con{+y, +_t6}:
      feel.sort_desc.if8(Bool.and(Bool.not(placed), U32.is_gt(J.u32(J.nth(x, 0)), J.u32(J.nth(y, 0)))), out, _t2, x, placed, next, _t6, y)

def feel.sort_desc.loop2(+_xs: List<&2, J.Val>, +out: List<&2, J.Val>) -> List<&2, J.Val>:
  match _xs:
    case Nil{}:
      feel.sort_desc.k1(out)
    case Con{+x, +_t2}:
      +placed = {False{} : Bool}
      +next = {[] : List<&2, J.Val>}
      feel.sort_desc.loop6(out, out, _t2, x, placed, next)

def feel.remove_nth(+a: J.Val, +i: U32) -> J.Val:
  +out = {[] : List<&2, J.Val>}
  +n = {0 : U32}
  feel.remove_nth.loop2(J.items(a), i, out, n)

def feel.remove_nth.k1(+out: List<&2, J.Val>) -> J.Val:
  J.JA{out}

def feel.remove_nth.k3(+i: U32, +out: List<&2, J.Val>, +n: U32, +_t2: List<&2, J.Val>) -> J.Val:
  +n = {(n + 1 : U32) : U32}
  feel.remove_nth.loop2(_t2, i, out, n)

def feel.remove_nth.if4(_c: Bool, +i: U32, +out: List<&2, J.Val>, +n: U32, +_t2: List<&2, J.Val>, +x: J.Val) -> J.Val:
  match _c:
    case True{}:
      +out = {List.append(&2, J.Val, out, [x]) : List<&2, J.Val>}
      feel.remove_nth.k3(i, out, n, _t2)
    case False{}:
      feel.remove_nth.k3(i, out, n, _t2)

def feel.remove_nth.loop2(+_xs: List<&2, J.Val>, +i: U32, +out: List<&2, J.Val>, +n: U32) -> J.Val:
  match _xs:
    case Nil{}:
      feel.remove_nth.k1(out)
    case Con{+x, +_t2}:
      feel.remove_nth.if4(Bool.not(U32.is_eq(n, i)), i, out, n, _t2, x)

# A knight's shot by its kind: how far a hit pushes a monster.

def feel.knock(+kind: String) -> F32:
  feel.knock.if8(String.eq(kind, "arrow"), kind)

def feel.knock.k4() -> F32:
  0.0

def feel.knock.if5(_c: Bool) -> F32:
  match _c:
    case True{}:
      0.6
    case False{}:
      feel.knock.k4()

def feel.knock.k3(+kind: String) -> F32:
  feel.knock.if5(String.eq(kind, "sacred"))

def feel.knock.if6(_c: Bool, +kind: String) -> F32:
  match _c:
    case True{}:
      0.9
    case False{}:
      feel.knock.k3(kind)

def feel.knock.k2(+kind: String) -> F32:
  feel.knock.if6(String.eq(kind, "ball"), kind)

def feel.knock.if7(_c: Bool, +kind: String) -> F32:
  match _c:
    case True{}:
      0.5
    case False{}:
      feel.knock.k2(kind)

def feel.knock.k1(+kind: String) -> F32:
  feel.knock.if7(String.eq(kind, "bolt"), kind)

def feel.knock.if8(_c: Bool, +kind: String) -> F32:
  match _c:
    case True{}:
      0.1
    case False{}:
      feel.knock.k1(kind)
