# crates/delve/src/rules/feel.rs — how the arms feel: sparks, stuck shafts, smoke, deaths, a room's

# end in coins. `Run::feel` is its object; the ten visual vectors are left out of it while empty

# (`skip_serializing_if = "Vec::is_empty"`), the ledger fields are always written.

# The host's `feel_ledger` setting (it rides on the run as `$settings`).

def feel.ledger_on(+run: J.Val) -> Bool:
  core.b(J.get(run, "$settings"), "feel_ledger")

# A visual vector of the feel, empty when absent.

def feel.vec(+f: J.Val, +key: String) -> List<&2, J.Val>:
  J.items(J.get(f, key))

# The vector back in the feel: left out when empty.

def feel.put(+f: J.Val, +key: String, +xs: List<&2, J.Val>) -> J.Val:
  feel.put.if2(U32.is_zero(U32.from_nat(List.length(&2, J.Val, xs))), f, key, xs)

def feel.put.k1(+f: J.Val, +key: String, +xs: List<&2, J.Val>) -> J.Val:
  J.set(f, key, J.JA{xs})

def feel.put.if2(_c: Bool, +f: J.Val, +key: String, +xs: List<&2, J.Val>) -> J.Val:
  match _c:
    case True{}:
      J.del(f, key)
    case False{}:
      feel.put.k1(f, key, xs)

# Push onto a capped vector, the oldest dropping off the front at the cap.

def feel.push_front_cap(+f: J.Val, +key: String, +cap: U32, +item: J.Val) -> J.Val:
  +xs = {feel.vec(f, key) : List<&2, J.Val>}
  feel.push_front_cap.if2(U32.is_ge(U32.from_nat(List.length(&2, J.Val, xs)), cap), f, key, item, xs)

def feel.push_front_cap.k1(+f: J.Val, +key: String, +item: J.Val, +xs: List<&2, J.Val>) -> J.Val:
  feel.put(f, key, List.append(&2, J.Val, xs, [item]))

def feel.push_front_cap.if2(_c: Bool, +f: J.Val, +key: String, +item: J.Val, +xs: List<&2, J.Val>) -> J.Val:
  match _c:
    case True{}:
      +xs = {List.drop(&2, J.Val, xs, 1n) : List<&2, J.Val>}
      feel.push_front_cap.k1(f, key, item, xs)
    case False{}:
      feel.push_front_cap.k1(f, key, item, xs)

# `credit`: owned damage noted; the monster's first wound noted when the ledger is kept.

def feel.Feel.credit(+f: J.Val, +ledger: Bool, +owner: U32, +foe: U32, +damage: U32, +tick: W.W) -> J.Val:
  feel.Feel.credit.if5(Bool.or(U32.is_zero(owner), U32.is_zero(damage)), f, ledger, owner, foe, damage, tick)

def feel.Feel.credit.k2(+f: J.Val) -> J.Val:
  f

def feel.Feel.credit.if4(_c: Bool, +f: J.Val, +foe: U32, +tick: W.W, +w: J.Val) -> J.Val:
  match _c:
    case True{}:
      +f = {J.set(f, "wounded", J.set(w, U32.show(foe), W.to_j(tick))) : J.Val}
      feel.Feel.credit.k2(f)
    case False{}:
      feel.Feel.credit.k2(f)

def feel.Feel.credit.if3(_c: Bool, +f: J.Val, +foe: U32, +tick: W.W) -> J.Val:
  match _c:
    case True{}:
      +w = {J.get(f, "wounded") : J.Val}
      feel.Feel.credit.if4(Bool.not(J.has(w, U32.show(foe))), f, foe, tick, w)
    case False{}:
      feel.Feel.credit.k2(f)

def feel.Feel.credit.k1(+f: J.Val, +ledger: Bool, +owner: U32, +foe: U32, +damage: U32, +tick: W.W) -> J.Val:
  +f = {J.set(f, "credits", J.push(J.get(f, "credits"), J.JA{[J.JU{owner}, J.JU{damage}]})) : J.Val}
  feel.Feel.credit.if3(ledger, f, foe, tick)

def feel.Feel.credit.if5(_c: Bool, +f: J.Val, +ledger: Bool, +owner: U32, +foe: U32, +damage: U32, +tick: W.W) -> J.Val:
  match _c:
    case True{}:
      f
    case False{}:
      feel.Feel.credit.k1(f, ledger, owner, foe, damage, tick)

def feel.Run.credit(+run: J.Val, +owner: U32, +foe: U32, +damage: U32) -> J.Val:
  J.set(run, "feel", feel.Feel.credit(J.get(run, "feel"), feel.ledger_on(run), owner, foe, damage, W.of_j(J.get(run, "tick"))))

