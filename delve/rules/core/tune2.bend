# crates/delve/src/rules/tune.rs — what the knobs do to the step (`foe_step`, `more_foes`, `tune_knights`).

# A monster's step this tick longer or shorter by the pace knob: from where it stood to

# where its own move put it, scaled. A move farther than `LONGEST_STEP` in a tick stays.

def tune.foe_step(+enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +room: J.Val, +barred: Bool) -> J.Val:
  +dx = {(core.f(enemy, "x") - fx : F32) : F32}
  +dy = {(core.f(enemy, "y") - fy : F32) : F32}
  +d = {RS.f_hypot(dx, dy) : F32}
  tune.foe_step.if5(Bool.or(F32.is_eq(d, 0.0), F32.is_gt(d, 1.0)), enemy, fx, fy, pace, room, barred, dx, dy)

def tune.foe_step.k2(+enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +dx: F32, +dy: F32) -> J.Val:
  core.set_f(core.set_f(enemy, "x", (fx + (dx * pace : F32) : F32)), "y", (fy + (dy * pace : F32) : F32))

def tune.foe_step.k4(t: F32 & F32, +enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +dx: F32, +dy: F32) -> J.Val:
  (+nx, +ny) = t
  core.set_f(core.set_f(enemy, "x", nx), "y", ny)

def tune.foe_step.if3(_c: Bool, +enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +room: J.Val, +barred: Bool, +dx: F32, +dy: F32) -> J.Val:
  match _c:
    case True{}:
      +mover = {Bool.pick(U32, monsters.EnemyKind.flies(J.get(enemy, "kind")), 2, 1) : U32}
      tune.foe_step.k4(rules.Grid.slide(room, barred, (core.f(enemy, "x"), core.f(enemy, "y")), ((dx * (pace - 1.0 : F32) : F32), (dy * (pace - 1.0 : F32) : F32)), monsters.Enemy.radius(enemy), mover), enemy, fx, fy, pace, dx, dy)
    case False{}:
      tune.foe_step.k2(enemy, fx, fy, pace, dx, dy)

def tune.foe_step.k1(+enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +room: J.Val, +barred: Bool, +dx: F32, +dy: F32) -> J.Val:
  tune.foe_step.if3(F32.is_gt(pace, 1.0), enemy, fx, fy, pace, room, barred, dx, dy)

def tune.foe_step.if5(_c: Bool, +enemy: J.Val, +fx: F32, +fy: F32, +pace: F32, +room: J.Val, +barred: Bool, +dx: F32, +dy: F32) -> J.Val:
  match _c:
    case True{}:
      enemy
    case False{}:
      tune.foe_step.k1(enemy, fx, fy, pace, room, barred, dx, dy)

# After the knights' step: the attack-rate knob on each cooldown a knight set this tick

# (`cooled` held them before it), and the shot-speed knob on the knights' shots.

def tune.tune_knights(+run: J.Val, +cooled: J.Val, +shots: J.Val) -> J.Val & J.Val:
  +tn = {J.get(run, "tune") : J.Val}
  tune.tune_knights.loop8(J.items(cooled), run, shots, tn)

def tune.tune_knights.k2(+run: J.Val, +shots: J.Val) -> J.Val & J.Val:
  (run, shots)

def tune.tune_knights.k4(+run: J.Val, +shots: J.Val, +out: List<&2, J.Val>) -> J.Val & J.Val:
  +shots = {J.JA{out} : J.Val}
  tune.tune_knights.k2(run, shots)

def tune.tune_knights.k6(+run: J.Val, +shots: J.Val, +speed: F32, +out: List<&2, J.Val>, +_t5: List<&2, J.Val>, +s: J.Val) -> J.Val & J.Val:
  +out = {List.append(&2, J.Val, out, [s]) : List<&2, J.Val>}
  tune.tune_knights.loop5(_t5, run, shots, speed, out)

def tune.tune_knights.if7(_c: Bool, +run: J.Val, +shots: J.Val, +speed: F32, +out: List<&2, J.Val>, +_t5: List<&2, J.Val>, +s: J.Val) -> J.Val & J.Val:
  match _c:
    case True{}:
      +s = {core.set_f(core.set_f(s, "vx", (core.f(s, "vx") * speed : F32)), "vy", (core.f(s, "vy") * speed : F32)) : J.Val}
      tune.tune_knights.k6(run, shots, speed, out, _t5, s)
    case False{}:
      tune.tune_knights.k6(run, shots, speed, out, _t5, s)

def tune.tune_knights.loop5(+_xs: List<&2, J.Val>, +run: J.Val, +shots: J.Val, +speed: F32, +out: List<&2, J.Val>) -> J.Val & J.Val:
  match _xs:
    case Nil{}:
      tune.tune_knights.k4(run, shots, out)
    case Con{+s, +_t5}:
      tune.tune_knights.if7(Bool.not(core.b(s, "hostile")), run, shots, speed, out, _t5, s)

def tune.tune_knights.if3(_c: Bool, +run: J.Val, +shots: J.Val, +speed: F32) -> J.Val & J.Val:
  match _c:
    case True{}:
      +out = {[] : List<&2, J.Val>}
      tune.tune_knights.loop5(J.items(shots), run, shots, speed, out)
