      tune.tune_knights.if10(Bool.and(U32.is_ne(now, before), U32.is_gt(now, core.usub(before, 1))), run, shots, tn, _t8, id, h, now)
    case False{}:
      tune.tune_knights.loop8(_t8, run, shots, tn)

def tune.tune_knights.loop8(+_xs: List<&2, J.Val>, +run: J.Val, +shots: J.Val, +tn: J.Val) -> J.Val & J.Val:
