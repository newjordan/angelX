def tune.tune_knights.k1(+run: J.Val, +shots: J.Val, +tn: J.Val) -> J.Val & J.Val:
  +speed = {tune.Tune.shot_speed(tn) : F32}
  tune.tune_knights.if3(F32.is_ne(speed, 1.0), run, shots, speed)

def tune.tune_knights.if10(_c: Bool, +run: J.Val, +shots: J.Val, +tn: J.Val, +_t8: List<&2, J.Val>, +id: U32, +h: J.Val, +now: U32) -> J.Val & J.Val:
