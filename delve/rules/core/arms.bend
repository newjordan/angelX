def arms.turn_one.if52(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +guarded: J.Val, +ax: F32, +ay: F32, +rolled_before: U32, +room: J.Val, +barred: Bool, +dx: F32, +dy: F32, +speed: F32, +glide: J.Val) -> J.Val & J.Val:
  match _c:
    case True{}:
      +gx = {J.f32(J.nth(glide, 0)) : F32}
      +gy = {J.f32(J.nth(glide, 1)) : F32}
      +movx = {(gx - core.f(h, "x") : F32) : F32}
      +movy = {(gy - core.f(h, "y") : F32) : F32}
      +h = {core.set_f(core.set_f(h, "x", gx), "y", gy) : J.Val}
      arms.turn_one.if53(Bool.and(Bool.and(F32.is_eq(ax, 0.0), F32.is_eq(ay, 0.0)), F32.is_gt(RS.f_max(F32.abs(movx), F32.abs(movy)), 0.0001)), run, sortie, id, ctx, h, input, side, guarded, ax, ay, rolled_before, movx, movy)
    case False{}:
      arms.turn_one.k55(rules.Grid.slide(room, barred, (core.f(h, "x"), core.f(h, "y")), (((dx * speed : F32) * rules.DT() : F32), ((dy * speed : F32) * rules.DT() : F32)), rules.HERO_RADIUS(), 0), run, sortie, id, ctx, h, input, side, guarded, ax, ay, rolled_before)

def arms.turn_one.if48(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +mx: F32, +my: F32, +guarded: J.Val, +ax: F32, +ay: F32, +rolled_before: U32, +room: J.Val, +barred: Bool, +dx: F32, +dy: F32, +speed: F32) -> J.Val & J.Val:
  match _c:
    case True{}:
      +rolling = {U32.is_gt(core.u(h, "dash_ticks"), 0) : Bool}
      arms.turn_one.k49(ledge.walk(h, input, room, barred, ((dx * speed : F32) * rules.DT() : F32), rolling), run, sortie, id, ctx, h, input, side, guarded, ax, ay, rolled_before, rolling)
    case False{}:
      +glide = {folly.Run.glide_for(run, id, h, mx, my, dx, dy, speed) : J.Val}
      arms.turn_one.if52(Bool.not(J.is_null(glide)), run, sortie, id, ctx, h, input, side, guarded, ax, ay, rolled_before, room, barred, dx, dy, speed, glide)

