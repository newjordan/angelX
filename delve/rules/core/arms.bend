      +ax = {core.f(reader, "x") : F32}
      +ay = {core.f(reader, "y") : F32}
      arms.Run.bombs_burst.k19(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual, ax, ay)
