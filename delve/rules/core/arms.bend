# `mix`: a 64-bit finalizer (rules.rs): h ^= h >> 33, h *= c1, h ^= h >> 33, h *= c2, h ^ (h >> 33).

def rules.mix(+h: W.W) -> W.W:
  +h = {W.xor(h, W.shr(h, 33)) : W.W}
  +h = {W.mul(h, W.W{4283543511, 3981806797}) : W.W}
  +h = {W.xor(h, W.shr(h, 33)) : W.W}
  +h = {W.mul(h, W.W{3301882366, 444984403}) : W.W}
  W.xor(h, W.shr(h, 33))

# The tick's dice for a knight: `mix(seed ^ tick * 0x9e37 ^ id << 48)` (Rust: `^` binds weaker than `<<` and `*`).

def arms.salt(+run: J.Val, +id: U32, +shift: U32) -> W.W:
  +a = {W.of_j(J.get(run, "seed")) : W.W}
  +b = {W.mul(W.of_j(J.get(run, "tick")), W.of_u32(40503)) : W.W}
  +c = {W.shl(W.of_u32(id), shift) : W.W}
  rules.mix(W.xor(W.xor(a, b), c))

# The unarmed punch.

def arms.punch(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  +h = {core.set_u(h, "fire_cooldown", 9) : J.Val}
  +h = {core.set_u(h, "swing", 5) : J.Val}
  +h = {core.set_b(h, "sword", False{}) : J.Val}
  +run = {core.push_sound(run, "swing") : J.Val}
  +hx = {core.f(h, "x") : F32}
  +hy = {core.f(h, "y") : F32}
  +angle = {F32.atan2(core.f(h, "aim_y"), core.f(h, "aim_x")) : F32}
  +room = {rules.Run.room(run) : J.Val}
  +enemies = {J.get(run, "enemies") : J.Val}
  arms.punch.k1(aoe.strike(enemies, hx, hy, hero.Hero.scaled(h, 6), arms.cone_mask(enemies, hx, hy, angle, 1.25, 0.7, room, core.b(ctx, "barred"), True{})), run, sortie, id, h, ctx, side, hx, hy, angle, room, enemies)

