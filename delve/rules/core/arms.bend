def arms.cone_mask.if4(_c: Bool, +hx: F32, +hy: F32, +angle: F32, +reach: F32, +half: F32, +room: J.Val, +barred: Bool, +check_open: Bool, +mask: List<&2, Bool>, +_t2: List<&2, J.Val>, +e: J.Val, +hit: Bool) -> List<&2, Bool>:
  match _c:
    case True{}:
      +hit = {rules.Grid.open(room, barred, ((hx + core.f(e, "x") : F32) / 2.0 : F32), ((hy + core.f(e, "y") : F32) / 2.0 : F32), 0) : Bool}
      arms.cone_mask.k3(hx, hy, angle, reach, half, room, barred, check_open, mask, _t2, hit)
