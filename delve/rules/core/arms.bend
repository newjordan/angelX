def arms.Run.bombs_burst.if18(_c: Bool, +run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +actual: U32) -> J.Val:
