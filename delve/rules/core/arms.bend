def arms.turn_one.k7(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  +h = {core.set_b_skip(h, "cycle_key", core.b(input, "cycle")) : J.Val}
  +pressed = {Bool.and(core.b(input, "ult"), Bool.not(core.b(h, "ult_key"))) : Bool}
  +h = {core.set_b(h, "ult_key", core.b(input, "ult")) : J.Val}
  arms.turn_one.if64(Bool.and(pressed, Bool.and(U32.is_ge(core.u(h, "ult_charge"), ults.ULT_FULL()), Bool.and(U32.is_zero(core.u(h, "slashes")), Bool.and(J.is_null(J.get(h, "aiming")), U32.is_zero(core.u(h, "flee_ticks")))))), run, sortie, id, ctx, h, input, side)

def arms.turn_one.k69(t: J.Val & Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  (+hc, +moved) = t
  +h = {hc : J.Val}
  arms.turn_one.k7(run, sortie, id, ctx, h, input, side)

def arms.turn_one.if68(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  match _c:
    case True{}:
      arms.turn_one.k69(hero.Hero.cycle_hand(h), run, sortie, id, ctx, h, input, side)
    case False{}:
      arms.turn_one.k7(run, sortie, id, ctx, h, input, side)

def arms.turn_one.k6(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  +taking = {Bool.or(core.b(input, "interact"), core.b(input, "take")) : Bool}
  +h = {core.set_b(h, "taking", Bool.and(taking, Bool.not(core.b(h, "take_key")))) : J.Val}
  +h = {core.set_b(h, "take_key", taking) : J.Val}
  arms.turn_one.if68(Bool.and(core.b(input, "cycle"), Bool.not(core.b(h, "cycle_key"))), run, sortie, id, ctx, h, input, side)

def arms.turn_one.if70(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  match _c:
    case True{}:
      (core.set_hero(run, id, h), sortie)
    case False{}:
      arms.turn_one.k6(run, sortie, id, ctx, h, input, side)

def arms.turn_one.k5(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  arms.turn_one.if70(Bool.not(J.is_null(J.get(J.get(h, "pit"), "result"))), run, sortie, id, ctx, h, input, side)

def arms.turn_one.k73(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +h2: J.Val) -> J.Val & J.Val:
  (core.set_hero(run, id, h2), sortie)

def arms.turn_one.loop74(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +h2: J.Val) -> J.Val & J.Val:
  match _xs:
    case Nil{}:
      arms.turn_one.k73(run, sortie, id, ctx, h, input, side, h2)
    case Con{+ev, +_t74}:
      +sortie = {arms.sortie_push(sortie, "pit_events", J.JA{[J.JU{id}, ev]}) : J.Val}
      arms.turn_one.loop74(_t74, run, sortie, id, ctx, h, input, side, h2)

def arms.turn_one.k72(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  (+h2, +events) = t
  arms.turn_one.loop74(J.items(events), run, sortie, id, ctx, h, input, side, h2)

def arms.turn_one.if71(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  match _c:
    case True{}:
      arms.turn_one.k72(pitstop.step(h, input, core.has_ju(J.items(J.get(ctx, "admitted")), id), run), run, sortie, id, ctx, h, input, side)
    case False{}:
      arms.turn_one.k5(run, sortie, id, ctx, h, input, side)

def arms.turn_one.k4(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  arms.turn_one.if71(Bool.or(U32.is_gt(core.u(h, "privy"), 0), Bool.not(J.is_null(J.get(J.get(h, "pit"), "stop")))), run, sortie, id, ctx, h, input, side)

def arms.turn_one.if76(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  match _c:
    case True{}:
      +input = {J.set(J.set(rules.Input.default(), "move_x", J.get(input, "move_x")), "move_y", J.get(input, "move_y")) : J.Val}
      arms.turn_one.k4(run, sortie, id, ctx, h, input, side)
    case False{}:
      arms.turn_one.k4(run, sortie, id, ctx, h, input, side)

def arms.turn_one.if75(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  match _c:
    case True{}:
      +input = {rules.Input.default() : J.Val}
      arms.turn_one.k4(run, sortie, id, ctx, h, input, side)
    case False{}:
      arms.turn_one.if76(hexer.Hero.frog(h), run, sortie, id, ctx, h, input, side)

def arms.turn_one.k3(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  arms.turn_one.if75(U32.is_gt(core.u(h, "tossed"), 0), run, sortie, id, ctx, h, input, side)

def arms.turn_one.if77(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  match _c:
    case True{}:
      (core.set_hero(run, id, h), sortie)
    case False{}:
      arms.turn_one.k3(run, sortie, id, ctx, h, input, side)

def arms.turn_one.k2(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  +h = {core.set_b(h, "vigil_key", core.b(input, "vigil")) : J.Val}
  arms.turn_one.if77(Bool.or(U32.is_zero(core.u(h, "hp")), core.b(h, "stone")), run, sortie, id, ctx, h, input, side)

def arms.turn_one.if78(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  match _c:
    case True{}:
      +run = {core.set_hero(run, id, h) : J.Val}
      +run = {minions.Run.order_key(run, id) : J.Val}
      +h = {core.hero(run, id) : J.Val}
      arms.turn_one.k2(run, sortie, id, ctx, h, input, side)
    case False{}:
      arms.turn_one.k2(run, sortie, id, ctx, h, input, side)

def arms.turn_one.k1(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +fighting: Bool) -> J.Val & J.Val:
  arms.turn_one.if78(Bool.and(Bool.and(core.b(input, "vigil"), Bool.not(core.b(h, "vigil_key"))), Bool.and(Bool.not(core.b(h, "vigil")), Bool.and(U32.is_ne(core.u(h, "hp"), 0), fighting))), run, sortie, id, ctx, h, input, side)

def arms.turn_one.if79(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +fighting: Bool) -> J.Val & J.Val:
  match _c:
    case True{}:
      +v = {Bool.not(core.b(h, "vigil")) : Bool}
      +h = {core.set_b(h, "vigil", v) : J.Val}
      +h = {core.set_b(h, "stone", v) : J.Val}
      +h = {core.set_u(h, "vigil_rearm", Bool.pick(U32, v, rules.VIGIL_SETTLE(), rules.VIGIL_REARM())) : J.Val}
      +h = {core.set_b(core.set_b(core.set_u(h, "dash_ticks", 0), "shielding", False{}), "walling", False{}) : J.Val}
      +run = {core.push_sound(run, "wall_up") : J.Val}
      arms.turn_one.k1(run, sortie, id, ctx, h, input, side, fighting)
    case False{}:
      arms.turn_one.k1(run, sortie, id, ctx, h, input, side, fighting)

# The knights' turn: each knight's keys and arms, in seat order. (run, sortie)

def arms.Run.knights_turn(+run: J.Val, +inputs: J.Val) -> J.Val & J.Val:
  +run = {foes.Run.tick_oathbound(run) : J.Val}
  +side = {ledge.Run.side_on(run) : Bool}
  +arcade = {Bool.and(home.Run.at_home_now(run), pastimes.Run.round_in_room(run)) : Bool}
  +barred = {rules.Run.barred(run) : Bool}
  +depth = {core.u(J.get(run, "dungeon"), "depth") : U32}
  +stood = {J.obj() : J.Val}
  arms.Run.knights_turn.loop14(J.int_fields(J.get(run, "players")), run, inputs, side, arcade, barred, depth, stood)

def arms.Run.knights_turn.k6(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val) -> J.Val & J.Val:
  (+run3, +shots) = t
  +run = {run3 : J.Val}
  +sortie = {J.set(sortie, "shots", wishcraft.shape(shots)) : J.Val}
  (run, sortie)

def arms.Run.knights_turn.k5(+run: J.Val, +cooled: List<&2, J.Val>, +sortie: J.Val) -> J.Val & J.Val:
  arms.Run.knights_turn.k6(tune.tune_knights(run, J.JA{cooled}, J.get(sortie, "shots")), run, sortie)

def arms.Run.knights_turn.k8(t: J.Val & J.Val, +run: J.Val, +inputs: J.Val, +cooled: List<&2, J.Val>, +sortie: J.Val, +ctx: J.Val, +_t7: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> J.Val & J.Val:
  (+run2, +sortie2) = t
  +run = {run2 : J.Val}
  +sortie = {sortie2 : J.Val}
  arms.Run.knights_turn.loop7(_t7, run, inputs, cooled, sortie, ctx)

def arms.Run.knights_turn.loop7(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +inputs: J.Val, +cooled: List<&2, J.Val>, +sortie: J.Val, +ctx: J.Val) -> J.Val & J.Val:
  match _xs:
    case Nil{}:
      arms.Run.knights_turn.k5(run, cooled, sortie)
    case Con{+_h7, +_t7}:
      (+k, +h) = _h7
      +id = {rules.Run.step.id(k) : U32}
      arms.Run.knights_turn.k8(arms.turn_one(run, sortie, id, arms.input_of(inputs, id), ctx), run, inputs, cooled, sortie, ctx, _t7)

def arms.Run.knights_turn.k4(+run: J.Val, +inputs: J.Val, +side: Bool, +arcade: Bool, +barred: Bool, +depth: U32, +stood: J.Val, +fighting: Bool, +admitted: J.Val, +cooled: List<&2, J.Val>, +sortie: J.Val) -> J.Val & J.Val:
  +sortie = {J.set(sortie, "stood", stood) : J.Val}
  +ctx = {J.obj() : J.Val}
  +ctx = {core.set_b(ctx, "side", side) : J.Val}
  +ctx = {core.set_b(ctx, "barred", barred) : J.Val}
  +ctx = {core.set_b(ctx, "arcade", arcade) : J.Val}
  +ctx = {core.set_b(ctx, "fighting", fighting) : J.Val}
  +ctx = {J.set(ctx, "admitted", admitted) : J.Val}
  +ctx = {core.set_u(ctx, "depth", depth) : J.Val}
  arms.Run.knights_turn.loop7(J.int_fields(J.get(run, "players")), run, inputs, cooled, sortie, ctx)

def arms.Run.knights_turn.loop9(+_xs: List<&2, String>, +run: J.Val, +inputs: J.Val, +side: Bool, +arcade: Bool, +barred: Bool, +depth: U32, +stood: J.Val, +fighting: Bool, +admitted: J.Val, +cooled: List<&2, J.Val>, +sortie: J.Val) -> J.Val & J.Val:
  match _xs:
    case Nil{}:
      arms.Run.knights_turn.k4(run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled, sortie)
    case Con{+k, +_t9}:
      +sortie = {J.set(sortie, k, J.JA{Nil{}}) : J.Val}
      arms.Run.knights_turn.loop9(_t9, run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled, sortie)

def arms.Run.knights_turn.k3(+run: J.Val, +inputs: J.Val, +side: Bool, +arcade: Bool, +barred: Bool, +depth: U32, +stood: J.Val, +fighting: Bool, +admitted: J.Val, +cooled: List<&2, J.Val>, +crows: List<&2, J.Val>) -> J.Val & J.Val:
  +run = {J.set(run, "scarecrows", J.JA{crows}) : J.Val}
  +sortie = {J.obj() : J.Val}
  +sortie = {core.set_b(sortie, "side", side) : J.Val}
  +sortie = {core.set_b(sortie, "barred", barred) : J.Val}
  +sortie = {core.set_u(sortie, "depth", depth) : J.Val}
  +sortie = {J.set(sortie, "shots", J.JA{Nil{}}) : J.Val}
  +sortie = {core.set_u(sortie, "bombs", 0) : J.Val}
  +sortie = {core.set_u(sortie, "nova", 0) : J.Val}
  +sortie = {core.set_u(sortie, "blast_owner", 0) : J.Val}
  arms.Run.knights_turn.loop9(["booms", "draughts", "credits", "casts", "summons", "pit_events", "grazes", "feats"], run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled, sortie)

def arms.Run.knights_turn.if11(_c: Bool, +run: J.Val, +inputs: J.Val, +side: Bool, +arcade: Bool, +barred: Bool, +depth: U32, +stood: J.Val, +fighting: Bool, +admitted: J.Val, +cooled: List<&2, J.Val>, +now: W.W, +crows: List<&2, J.Val>, +_t10: List<&2, J.Val>, +d: J.Val) -> J.Val & J.Val:
  match _c:
    case True{}:
      +crows = {List.append(&2, J.Val, crows, [d]) : List<&2, J.Val>}
      arms.Run.knights_turn.loop10(_t10, run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled, now, crows)
    case False{}:
      arms.Run.knights_turn.loop10(_t10, run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled, now, crows)

def arms.Run.knights_turn.loop10(+_xs: List<&2, J.Val>, +run: J.Val, +inputs: J.Val, +side: Bool, +arcade: Bool, +barred: Bool, +depth: U32, +stood: J.Val, +fighting: Bool, +admitted: J.Val, +cooled: List<&2, J.Val>, +now: W.W, +crows: List<&2, J.Val>) -> J.Val & J.Val:
  match _xs:
    case Nil{}:
      arms.Run.knights_turn.k3(run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled, crows)
    case Con{+d, +_t10}:
      arms.Run.knights_turn.if11(W.lt(now, W.of_j(J.get(d, "collapse_until"))), run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled, now, crows, _t10, d)

def arms.Run.knights_turn.k2(+run: J.Val, +inputs: J.Val, +side: Bool, +arcade: Bool, +barred: Bool, +depth: U32, +stood: J.Val, +fighting: Bool, +admitted: J.Val, +cooled: List<&2, J.Val>) -> J.Val & J.Val:
  +now = {W.of_j(J.get(run, "tick")) : W.W}
  +crows = {[] : List<&2, J.Val>}
  arms.Run.knights_turn.loop10(J.items(J.get(run, "scarecrows")), run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled, now, crows)

def arms.Run.knights_turn.loop13(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +inputs: J.Val, +side: Bool, +arcade: Bool, +barred: Bool, +depth: U32, +stood: J.Val, +fighting: Bool, +admitted: J.Val, +cooled: List<&2, J.Val>) -> J.Val & J.Val:
  match _xs:
    case Nil{}:
      arms.Run.knights_turn.k2(run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled)
    case Con{+_h13, +_t13}:
      (+k, +h) = _h13
      +cooled = {List.append(&2, J.Val, cooled, [J.JA{[J.JU{rules.Run.step.id(k)}, J.JU{core.u(h, "fire_cooldown")}]}]) : List<&2, J.Val>}
      arms.Run.knights_turn.loop13(_t13, run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled)

def arms.Run.knights_turn.if12(_c: Bool, +run: J.Val, +inputs: J.Val, +side: Bool, +arcade: Bool, +barred: Bool, +depth: U32, +stood: J.Val, +fighting: Bool, +admitted: J.Val, +cooled: List<&2, J.Val>) -> J.Val & J.Val:
  match _c:
    case True{}:
      arms.Run.knights_turn.loop13(J.int_fields(J.get(run, "players")), run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled)
    case False{}:
      arms.Run.knights_turn.k2(run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled)

def arms.Run.knights_turn.k1(+run: J.Val, +inputs: J.Val, +side: Bool, +arcade: Bool, +barred: Bool, +depth: U32, +stood: J.Val) -> J.Val & J.Val:
  +fighting = {depths.Run.fighting(run) : Bool}
  +admitted = {pitstop.Run.pit_admissions(run) : J.Val}
  +cooled = {[] : List<&2, J.Val>}
  arms.Run.knights_turn.if12(Bool.not(U32.is_eq(tune.Tune.fire_rate(J.get(run, "tune")), 100)), run, inputs, side, arcade, barred, depth, stood, fighting, admitted, cooled)

def arms.Run.knights_turn.loop14(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +inputs: J.Val, +side: Bool, +arcade: Bool, +barred: Bool, +depth: U32, +stood: J.Val) -> J.Val & J.Val:
  match _xs:
    case Nil{}:
      arms.Run.knights_turn.k1(run, inputs, side, arcade, barred, depth, stood)
    case Con{+_h14, +_t14}:
      (+k, +h) = _h14
      +stood = {J.set(stood, k, core.pair_f(core.f(h, "x"), core.f(h, "y"))) : J.Val}
      arms.Run.knights_turn.loop14(_t14, run, inputs, side, arcade, barred, depth, stood)

# The knights' bombs and Thunder Scrolls go off: the monsters' shots round each bomb pop, and

# the blast strikes the room (on an open map, what is round it).

def arms.Run.bombs_burst(+run: J.Val, +sortie: J.Val) -> J.Val:
  +bombs = {core.u(sortie, "bombs") : U32}
  +booms = {J.get(sortie, "booms") : J.Val}
  arms.Run.bombs_burst.if29(U32.is_gt(bombs, 0), run, sortie, bombs, booms)

def arms.Run.bombs_burst.k5(+run: J.Val) -> J.Val:
  run

def arms.Run.bombs_burst.if7(_c: Bool, +run: J.Val) -> J.Val:
  match _c:
    case True{}:
      +run = {core.push_sound(run, "hit_blast") : J.Val}
      arms.Run.bombs_burst.k5(run)
    case False{}:
      arms.Run.bombs_burst.k5(run)

def arms.Run.bombs_burst.if6(_c: Bool, +run: J.Val, +struck: Bool) -> J.Val:
  match _c:
    case True{}:
      +run = {core.push_sound(run, "hit_magic") : J.Val}
      arms.Run.bombs_burst.if7(struck, run)
    case False{}:
      arms.Run.bombs_burst.k5(run)

def arms.Run.bombs_burst.k4(+run: J.Val, +lightning: Bool, +struck: Bool) -> J.Val:
  arms.Run.bombs_burst.if6(lightning, run, struck)

def arms.Run.bombs_burst.k9(+run: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>) -> J.Val:
  +run = {J.set(run, "enemies", J.JA{enemies}) : J.Val}
  arms.Run.bombs_burst.k4(run, lightning, struck)

def arms.Run.bombs_burst.k12(+run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val) -> J.Val:
  +enemies = {List.append(&2, J.Val, enemies, [e]) : List<&2, J.Val>}
  arms.Run.bombs_burst.loop10(_t10, run, blast, open_map, owner, centres, reader, lightning, struck, enemies)

def arms.Run.bombs_burst.k17(+run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +actual: U32) -> J.Val:
  +run = {feel.Run.credit(run, owner, core.u(e, "id"), actual) : J.Val}
  arms.Run.bombs_burst.k12(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e)

def arms.Run.bombs_burst.k19(+run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +actual: U32, +ax: F32, +ay: F32) -> J.Val:
  +run = {J.set(run, "feel", feel.Feel.blow(J.get(run, "feel"), core.u(e, "id"), owner, gore.Blow.blast(ax, ay))) : J.Val}
  arms.Run.bombs_burst.k17(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual)

