def arms.turn_one.k24(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +guarded: J.Val, +ax: F32, +ay: F32, +rolled_before: U32) -> J.Val & J.Val:
  +feet_y = {(core.f(h, "y") + Bool.pick(F32, side, ledge.FOOT(), 0.0) : F32) : F32}
  arms.turn_one.k25(hero.Hero.roll_dir(h), run, sortie, id, ctx, h, input, side, guarded, ax, ay, rolled_before, feet_y)

def arms.turn_one.k50(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +guarded: J.Val, +ax: F32, +ay: F32, +rolled_before: U32, +rolling: Bool) -> J.Val & J.Val:
  +duck = {Bool.and(Bool.and(U32.is_eq(RS.i_signum(core.u(input, "move_y")), 1), core.b(h, "grounded")), Bool.and(U32.is_zero(core.u(h, "dropping")), Bool.not(rolling))) : Bool}
  +run = {works.Run.set_duck(run, id, duck) : J.Val}
  arms.turn_one.k24(run, sortie, id, ctx, h, input, side, guarded, ax, ay, rolled_before)

