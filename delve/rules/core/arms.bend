  arms.turn_one.if48(side, run, sortie, id, ctx, h, input, side, mx, my, guarded, ax, ay, rolled_before, room, barred, dx, dy, speed)

def arms.turn_one.if56(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +mx: F32, +my: F32, +guarded: J.Val, +ax: F32, +ay: F32, +rolled_before: U32, +room: J.Val, +barred: Bool, +dx: F32, +dy: F32, +speed: F32) -> J.Val & J.Val:
