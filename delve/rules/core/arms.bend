      +dy = {(core.f(e, "y") - hy : F32) : F32}
      +hit = {Bool.and(F32.is_le(RS.f_hypot(dx, dy), (reach + monsters.Enemy.radius(e) : F32)), F32.is_le(arms.delta(dx, dy, angle), half)) : Bool}
      arms.cone_mask.if4(Bool.and(hit, check_open), hx, hy, angle, reach, half, room, barred, check_open, mask, _t2, e, hit)

# The sword's swing at `angle`.

def arms.sword(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val) -> J.Val & (J.Val & J.Val):
  +h = {core.set_u(h, "sword_cooldown", hero.Hero.cooldown(h, rules.SWORD_REARM())) : J.Val}
  +h = {core.set_u(h, "swing", 8) : J.Val}
  +h = {core.set_b(h, "sword", True{}) : J.Val}
  +run = {core.push_sound(run, "swing") : J.Val}
  +angle = {F32.atan2(core.f(h, "aim_y"), core.f(h, "aim_x")) : F32}
  +half = {(RS.f_to_radians(rules.SWORD_ARC()) / 2.0 : F32) : F32}
  +damage = {hero.Hero.scaled(h, rules.SWORD_DAMAGE()) : U32}
  +hx = {core.f(h, "x") : F32}
  +hy = {core.f(h, "y") : F32}
  +room = {rules.Run.room(run) : J.Val}
  +enemies = {J.get(run, "enemies") : J.Val}
  arms.sword.k1(aoe.strike(enemies, hx, hy, damage, arms.cone_mask(enemies, hx, hy, angle, rules.SWORD_REACH(), half, room, core.b(ctx, "barred"), False{})), run, sortie, id, h, angle, half, hx, hy, enemies)

