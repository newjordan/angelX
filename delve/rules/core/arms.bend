  match _c:
    case True{}:
      +run = {feel.Run.ledger_shots(run, id, count) : J.Val}
      arms.forged.k7(run, sortie, h)
    case False{}:
      arms.forged.k7(run, sortie, h)

def arms.forged.if8(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +loosed: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {core.push_sound(run, "shot_bolt") : J.Val}
      +count = {J.u32(J.get(loosed, "Bolts")) : U32}
      +run = {J.set(run, "floor_tally", floor_stats.Tally.bump(J.get(run, "floor_tally"), id, "shots", count)) : J.Val}
      arms.forged.if9(feel.ledger_on(run), run, sortie, id, h, count)
    case False{}:
      arms.forged.k7(run, sortie, h)

def arms.forged.k6(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +loosed: J.Val) -> J.Val & (J.Val & J.Val):
  arms.forged.if8(J.has(loosed, "Bolts"), run, sortie, id, h, loosed)

def arms.forged.if10(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +loosed: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {core.push_sound(run, "swing") : J.Val}
      arms.forged.k6(run, sortie, id, h, loosed)
    case False{}:
      arms.forged.k6(run, sortie, id, h, loosed)

def arms.forged.k5(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +h2: J.Val) -> J.Val & (J.Val & J.Val):
  (+shots2, +loosed) = t
  +sortie = {J.set(sortie, "shots", shots2) : J.Val}
  +h = {h2 : J.Val}
  arms.forged.if10(J.has(loosed, "Throw"), run, sortie, id, h, loosed)

def arms.forged.k4(t: J.Val & (J.Val & J.Val), +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val) -> J.Val & (J.Val & J.Val):
  (+h2, lr) = t
  arms.forged.k5(lr, run, sortie, id, h, h2)

def arms.forged.k3(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val) -> J.Val & (J.Val & J.Val):
  +rng = {arms.salt(run, id, 48) : W.W}
  +flying = {rules.in_flight(J.get(run, "projectiles"), id) : U32}
  arms.forged.k4(hero.Hero.loose(h, id, J.get(run, "book"), False{}, rng, flying, J.get(sortie, "shots")), run, sortie, id, h)

def arms.forged.k16(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +shots: List<&2, J.Val>) -> J.Val & (J.Val & J.Val):
  +run = {J.set(run, "projectiles", J.JA{shots}) : J.Val}
  (h, (run, sortie))

def arms.forged.k18(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +hx: F32, +hy: F32, +melee: J.Val, +angle: F32, +half: F32, +shots: List<&2, J.Val>, +_t17: List<&2, J.Val>, +s: J.Val) -> J.Val & (J.Val & J.Val):
  +shots = {List.append(&2, J.Val, shots, [s]) : List<&2, J.Val>}
  arms.forged.loop17(_t17, run, sortie, id, h, hx, hy, melee, angle, half, shots)

def arms.forged.if20(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +hx: F32, +hy: F32, +melee: J.Val, +angle: F32, +half: F32, +shots: List<&2, J.Val>, +_t17: List<&2, J.Val>, +s: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +s = {core.set_u(s, "ttl", 0) : J.Val}
      arms.forged.k18(run, sortie, id, h, hx, hy, melee, angle, half, shots, _t17, s)
    case False{}:
      arms.forged.k18(run, sortie, id, h, hx, hy, melee, angle, half, shots, _t17, s)

def arms.forged.if19(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +hx: F32, +hy: F32, +melee: J.Val, +angle: F32, +half: F32, +shots: List<&2, J.Val>, +_t17: List<&2, J.Val>, +s: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +dx = {(core.f(s, "x") - hx : F32) : F32}
      +dy = {(core.f(s, "y") - hy : F32) : F32}
      arms.forged.if20(Bool.and(F32.is_le(RS.f_hypot(dx, dy), (core.f(melee, "reach") + 0.6 : F32)), F32.is_le(arms.delta(dx, dy, angle), half)), run, sortie, id, h, hx, hy, melee, angle, half, shots, _t17, s)
    case False{}:
      arms.forged.k18(run, sortie, id, h, hx, hy, melee, angle, half, shots, _t17, s)

def arms.forged.loop17(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +hx: F32, +hy: F32, +melee: J.Val, +angle: F32, +half: F32, +shots: List<&2, J.Val>) -> J.Val & (J.Val & J.Val):
  match _xs:
    case Nil{}:
      arms.forged.k16(run, sortie, id, h, shots)
    case Con{+s, +_t17}:
      arms.forged.if19(core.b(s, "hostile"), run, sortie, id, h, hx, hy, melee, angle, half, shots, _t17, s)

def arms.forged.k15(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +hx: F32, +hy: F32, +melee: J.Val, +angle: F32, +half: F32) -> J.Val & (J.Val & J.Val):
  +shots = {[] : List<&2, J.Val>}
  arms.forged.loop17(J.items(J.get(run, "projectiles")), run, sortie, id, h, hx, hy, melee, angle, half, shots)

def arms.forged.if21(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +hx: F32, +hy: F32, +melee: J.Val, +angle: F32, +half: F32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {core.push_shake(run, 4) : J.Val}
      +run = {core.push_sound(run, "hit_blast") : J.Val}
      arms.forged.k15(run, sortie, id, h, hx, hy, melee, angle, half)
    case False{}:
      arms.forged.k15(run, sortie, id, h, hx, hy, melee, angle, half)

def arms.forged.k14(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +hx: F32, +hy: F32, +melee: J.Val, +angle: F32, +half: F32, +landed: Bool) -> J.Val & (J.Val & J.Val):
  arms.forged.if21(Bool.and(landed, champions.Hero.is_hammerer(h)), run, sortie, id, h, hx, hy, melee, angle, half)

def arms.forged.if23(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +hx: F32, +hy: F32, +melee: J.Val, +angle: F32, +half: F32, +enemies: J.Val, +landed: Bool, +_t22: List<&2, J.Val>, +e: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {J.set(run, "feel", feel.Feel.blow(J.get(run, "feel"), core.u(e, "id"), id, gore.Blow.swing(F32.cos(angle), F32.sin(angle), True{}, False{}))) : J.Val}
      arms.forged.loop22(_t22, run, sortie, id, h, hx, hy, melee, angle, half, enemies, landed)
    case False{}:
      arms.forged.loop22(_t22, run, sortie, id, h, hx, hy, melee, angle, half, enemies, landed)

def arms.forged.loop22(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +hx: F32, +hy: F32, +melee: J.Val, +angle: F32, +half: F32, +enemies: J.Val, +landed: Bool) -> J.Val & (J.Val & J.Val):
  match _xs:
    case Nil{}:
      arms.forged.k14(run, sortie, id, h, hx, hy, melee, angle, half, landed)
    case Con{+st, +_t22}:
      +landed = {True{} : Bool}
      +i = {J.u32(J.nth(st, 0)) : U32}
      +dealt = {J.u32(J.nth(st, 1)) : U32}
      +e = {J.nth(J.get(run, "enemies"), i) : J.Val}
      +bonus = {U32.min(signatures.rear_bonus(e, J.get(run, "bosses"), hx, hy, dealt), core.u(e, "hp")) : U32}
      +e = {core.set_u(e, "hp", (core.u(e, "hp") - bonus : U32)) : J.Val}
      +e = {J.set(e, "wits", core.set_u(J.get(e, "wits"), "foe", id)) : J.Val}
      +run = {J.set(run, "enemies", J.set_nth(J.get(run, "enemies"), i, e)) : J.Val}
      +sortie = {arms.credit(sortie, id, (dealt + bonus : U32)) : J.Val}
      arms.forged.if23(U32.is_zero(core.u(e, "hp")), run, sortie, id, h, hx, hy, melee, angle, half, enemies, landed, _t22, e)

def arms.forged.k13(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +hx: F32, +hy: F32, +melee: J.Val, +angle: F32, +half: F32, +enemies: J.Val) -> J.Val & (J.Val & J.Val):
  (+enemies2, +struck) = t
  +run = {J.set(run, "enemies", enemies2) : J.Val}
  +landed = {False{} : Bool}
  arms.forged.loop22(J.items(struck), run, sortie, id, h, hx, hy, melee, angle, half, enemies, landed)

def arms.forged.k12(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +hx: F32, +hy: F32, +melee: J.Val) -> J.Val & (J.Val & J.Val):
  +fury = {U32.is_gt(core.u(J.get(h, "champ"), "fury"), 0) : Bool}
  +every = {core.u(melee, "every") : U32}
  +h = {core.set_u(h, "fire_cooldown", hero.Hero.cooldown(h, Bool.pick(U32, fury, U32.div(every, 2), every))) : J.Val}
  +base = {core.u(melee, "damage") : U32}
  +dm = {hero.Hero.scaled(h, Bool.pick(U32, fury, spells.Run.spell_power_of(run, "brute-force", base), base)) : U32}
  +damage = {U32.div((dm * Bool.pick(U32, fury, 3, 2) : U32), 2) : U32}
  +h = {core.set_u(h, "swing", 6) : J.Val}
  +h = {core.set_b(h, "sword", False{}) : J.Val}
  +run = {core.push_sound(run, "swing") : J.Val}
  +angle = {F32.atan2(core.f(h, "aim_y"), core.f(h, "aim_x")) : F32}
  +half = {(RS.f_to_radians(core.f(melee, "arc")) / 2.0 : F32) : F32}
  +room = {rules.Run.room(run) : J.Val}
  +enemies = {J.get(run, "enemies") : J.Val}
  arms.forged.k13(aoe.strike(enemies, hx, hy, damage, arms.cone_mask(enemies, hx, hy, angle, core.f(melee, "reach"), half, room, core.b(ctx, "barred"), True{})), run, sortie, id, h, hx, hy, melee, angle, half, enemies)

def arms.forged.k25(t: F32 & F32, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +hx: F32, +hy: F32, +melee: J.Val) -> J.Val & (J.Val & J.Val):
  (+ux, +uy) = t
  +h = {core.set_f(core.set_f(h, "aim_x", ux), "aim_y", uy) : J.Val}
  arms.forged.k12(run, sortie, id, h, ctx, hx, hy, melee)

def arms.forged.if24(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +hx: F32, +hy: F32, +target: J.Val, +melee: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      arms.forged.k25(rules.unit((core.f(target, "x") - hx : F32), (core.f(target, "y") - hy : F32)), run, sortie, id, h, ctx, hx, hy, melee)
    case False{}:
      arms.forged.k12(run, sortie, id, h, ctx, hx, hy, melee)

def arms.forged.if11(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +hx: F32, +hy: F32, +target: J.Val, +best_d: F32, +melee: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      arms.forged.if24(Bool.and(Bool.not(J.is_null(target)), F32.is_le(best_d, (core.f(melee, "reach") + monsters.Enemy.radius(target) : F32))), run, sortie, id, h, ctx, hx, hy, target, melee)
    case False{}:
      arms.forged.k3(run, sortie, id, h)

def arms.forged.k2(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +hx: F32, +hy: F32, +target: J.Val, +best_d: F32, +melee: J.Val, +use_melee: Bool) -> J.Val & (J.Val & J.Val):
  arms.forged.if11(use_melee, run, sortie, id, h, ctx, hx, hy, target, best_d, melee)

def arms.forged.k27(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +hx: F32, +hy: F32, +target: J.Val, +best_d: F32, +melee: J.Val, +use_melee: Bool, +sole: Bool, +near: Bool) -> J.Val & (J.Val & J.Val):
  +use_melee = {Bool.or(sole, near) : Bool}
  arms.forged.k2(run, sortie, id, h, ctx, hx, hy, target, best_d, melee, use_melee)

def arms.forged.if28(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +hx: F32, +hy: F32, +target: J.Val, +best_d: F32, +melee: J.Val, +use_melee: Bool, +sole: Bool, +near: Bool) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +near = {F32.is_le(best_d, (core.f(melee, "reach") + monsters.Enemy.radius(target) : F32)) : Bool}
      arms.forged.k27(run, sortie, id, h, ctx, hx, hy, target, best_d, melee, use_melee, sole, near)
    case False{}:
      arms.forged.k27(run, sortie, id, h, ctx, hx, hy, target, best_d, melee, use_melee, sole, near)

def arms.forged.if26(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +weapon: J.Val, +hx: F32, +hy: F32, +target: J.Val, +best_d: F32, +melee: J.Val, +use_melee: Bool) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +sole = {Bool.and(J.is_null(J.get(weapon, "bolt")), J.is_null(J.get(weapon, "throw"))) : Bool}
      +near = {False{} : Bool}
      arms.forged.if28(Bool.not(J.is_null(target)), run, sortie, id, h, ctx, hx, hy, target, best_d, melee, use_melee, sole, near)
    case False{}:
      arms.forged.k2(run, sortie, id, h, ctx, hx, hy, target, best_d, melee, use_melee)

def arms.forged.k1(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +weapon: J.Val, +hx: F32, +hy: F32, +target: J.Val, +best_d: F32) -> J.Val & (J.Val & J.Val):
  +melee = {J.get(weapon, "melee") : J.Val}
  +use_melee = {False{} : Bool}
  arms.forged.if26(Bool.not(J.is_null(melee)), run, sortie, id, h, ctx, weapon, hx, hy, target, best_d, melee, use_melee)

def arms.forged.if31(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +weapon: J.Val, +hx: F32, +hy: F32, +target: J.Val, +best_d: F32, +_t29: List<&2, J.Val>, +e: J.Val, +d: F32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +target = {e : J.Val}
      +best_d = {d : F32}
      arms.forged.loop29(_t29, run, sortie, id, h, ctx, weapon, hx, hy, target, best_d)
    case False{}:
      arms.forged.loop29(_t29, run, sortie, id, h, ctx, weapon, hx, hy, target, best_d)

def arms.forged.if30(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +weapon: J.Val, +hx: F32, +hy: F32, +target: J.Val, +best_d: F32, +_t29: List<&2, J.Val>, +e: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +d = {RS.f_hypot((core.f(e, "x") - hx : F32), (core.f(e, "y") - hy : F32)) : F32}
      arms.forged.if31(Bool.or(J.is_null(target), F32.is_lt(d, best_d)), run, sortie, id, h, ctx, weapon, hx, hy, target, best_d, _t29, e, d)
    case False{}:
      arms.forged.loop29(_t29, run, sortie, id, h, ctx, weapon, hx, hy, target, best_d)

def arms.forged.loop29(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +weapon: J.Val, +hx: F32, +hy: F32, +target: J.Val, +best_d: F32) -> J.Val & (J.Val & J.Val):
  match _xs:
    case Nil{}:
      arms.forged.k1(run, sortie, id, h, ctx, weapon, hx, hy, target, best_d)
    case Con{+e, +_t29}:
      arms.forged.if30(U32.is_ne(core.u(e, "hp"), 0), run, sortie, id, h, ctx, weapon, hx, hy, target, best_d, _t29, e)

# A plain arm's shots.

def arms.plain(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  +weapon = {core.s(h, "weapon") : String}
  +snd = {"shot_bow" : String}
  arms.plain.if14(String.eq(weapon, "crossbow"), run, sortie, id, h, ctx, side, weapon, snd)

def arms.plain.k7(+run: J.Val, +sortie: J.Val, +h: J.Val) -> J.Val & (J.Val & J.Val):
  (h, (run, sortie))

def arms.plain.k10(t: F32 & F32, +run: J.Val, +sortie: J.Val, +h: J.Val) -> J.Val & (J.Val & J.Val):
  (+nx, +ny) = t
  +h = {core.set_f(core.set_f(h, "x", nx), "y", ny) : J.Val}
  arms.plain.k7(run, sortie, h)

def arms.plain.if9(_c: Bool, +run: J.Val, +sortie: J.Val, +h: J.Val, +ctx: J.Val, +side: Bool, +ax: F32, +ay: F32, +mx: F32, +my: F32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {J.set(run, "feel", feel.Feel.puff(J.get(run, "feel"), mx, my, ax, ay, False{})) : J.Val}
      +run = {J.set(run, "feel", feel.Feel.puff(J.get(run, "feel"), mx, my, ax, ay, True{})) : J.Val}
      +run = {core.push_shake(run, feel.SHAKE_SHOT()) : J.Val}
      +up = {Bool.pick(F32, side, 0.0, (F32.neg(ay) * feel.RECOIL() : F32)) : F32}
      arms.plain.k10(rules.Grid.slide(rules.Run.room(run), core.b(ctx, "barred"), (core.f(h, "x"), core.f(h, "y")), ((F32.neg(ax) * feel.RECOIL() : F32), up), rules.HERO_RADIUS(), 0), run, sortie, h)
    case False{}:
      arms.plain.k7(run, sortie, h)

def arms.plain.if8(_c: Bool, +run: J.Val, +sortie: J.Val, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +ax: F32, +ay: F32, +mx: F32, +my: F32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {J.set(run, "feel", feel.Feel.puff(J.get(run, "feel"), mx, my, ax, ay, False{})) : J.Val}
      arms.plain.k7(run, sortie, h)
    case False{}:
      arms.plain.if9(String.eq(weapon, "handgonne"), run, sortie, h, ctx, side, ax, ay, mx, my)

def arms.plain.k6(+run: J.Val, +sortie: J.Val, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +ax: F32, +ay: F32) -> J.Val & (J.Val & J.Val):
  +mx = {(core.f(h, "x") + (ax * 0.9 : F32) : F32) : F32}
  +my = {(core.f(h, "y") + (ay * 0.9 : F32) : F32) : F32}
  arms.plain.if8(String.eq(weapon, "crossbow"), run, sortie, h, ctx, side, weapon, ax, ay, mx, my)

def arms.plain.if11(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +count: U32, +ax: F32, +ay: F32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {feel.Run.ledger_shots(run, id, count) : J.Val}
      arms.plain.k6(run, sortie, h, ctx, side, weapon, ax, ay)
    case False{}:
      arms.plain.k6(run, sortie, h, ctx, side, weapon, ax, ay)

def arms.plain.k5(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +h2: J.Val) -> J.Val & (J.Val & J.Val):
  (+shots2, +loosed) = t
  +sortie = {J.set(sortie, "shots", shots2) : J.Val}
  +h = {h2 : J.Val}
  +arm = {J.get(loosed, "Arm") : J.Val}
  +count = {J.u32(J.nth(arm, 0)) : U32}
  +ax = {J.f32(J.nth(J.nth(arm, 1), 0)) : F32}
  +ay = {J.f32(J.nth(J.nth(arm, 1), 1)) : F32}
  +run = {J.set(run, "floor_tally", floor_stats.Tally.bump(J.get(run, "floor_tally"), id, "shots", count)) : J.Val}
  arms.plain.if11(feel.ledger_on(run), run, sortie, id, h, ctx, side, weapon, count, ax, ay)

def arms.plain.k4(t: J.Val & (J.Val & J.Val), +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String) -> J.Val & (J.Val & J.Val):
  (+h2, lr) = t
  arms.plain.k5(lr, run, sortie, id, h, ctx, side, weapon, h2)

def arms.plain.k3(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +burning: Bool) -> J.Val & (J.Val & J.Val):
  +rng = {arms.salt(run, id, 48) : W.W}
  +flying = {rules.in_flight(J.get(run, "projectiles"), id) : U32}
  arms.plain.k4(hero.Hero.loose(h, id, J.get(run, "book"), burning, rng, flying, J.get(sortie, "shots")), run, sortie, id, h, ctx, side, weapon)

def arms.plain.if12(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +burning: Bool) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +burning = {U32.is_gt(core.u(J.get(J.get(J.get(run, "works"), "kits"), U32.show(id)), "burning"), 0) : Bool}
      arms.plain.k3(run, sortie, id, h, ctx, side, weapon, burning)
    case False{}:
      arms.plain.k3(run, sortie, id, h, ctx, side, weapon, burning)

def arms.plain.k2(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +snd: String) -> J.Val & (J.Val & J.Val):
  +run = {core.push_sound(run, snd) : J.Val}
  +burning = {False{} : Bool}
  arms.plain.if12(String.eq(weapon, "bow"), run, sortie, id, h, ctx, side, weapon, burning)

def arms.plain.m13(+s: Maybe<&2, String>, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +snd: String) -> J.Val & (J.Val & J.Val):
  match s:
    case Some{+own}:
      +snd = {own : String}
      arms.plain.k2(run, sortie, id, h, ctx, side, weapon, snd)
    case None{}:
      +snd = {snd : String}
      arms.plain.k2(run, sortie, id, h, ctx, side, weapon, snd)

def arms.plain.k1(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +snd: String) -> J.Val & (J.Val & J.Val):
  arms.plain.m13(classes.shot_sound(h), run, sortie, id, h, ctx, side, weapon, snd)

def arms.plain.if16(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +snd: String) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +snd = {"shot_spark" : String}
      arms.plain.k1(run, sortie, id, h, ctx, side, weapon, snd)
    case False{}:
      arms.plain.k1(run, sortie, id, h, ctx, side, weapon, snd)

def arms.plain.if15(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +snd: String) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +snd = {"shot_handgonne" : String}
      arms.plain.k1(run, sortie, id, h, ctx, side, weapon, snd)
    case False{}:
      arms.plain.if16(Bool.or(String.eq(weapon, "notes"), String.eq(weapon, "stones")), run, sortie, id, h, ctx, side, weapon, snd)

def arms.plain.if14(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +weapon: String, +snd: String) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +snd = {"shot_crossbow" : String}
      arms.plain.k1(run, sortie, id, h, ctx, side, weapon, snd)
    case False{}:
      arms.plain.if15(String.eq(weapon, "handgonne"), run, sortie, id, h, ctx, side, weapon, snd)

# `feel.ledger.entry(id).shots += n` (when the ledger is kept).

def feel.Run.ledger_shots(+run: J.Val, +id: U32, +n: U32) -> J.Val:
  +ledger = {J.get(J.get(run, "feel"), "ledger") : J.Val}
  +t = {core.or_else(J.get(ledger, U32.show(id)), feel.Tally.default()) : J.Val}
  +t = {core.set_u(t, "shots", core.uadd(core.u(t, "shots"), n)) : J.Val}
  J.set(run, "feel", J.set(J.get(run, "feel"), "ledger", J.set(ledger, U32.show(id), t)))

# The fire key: the arm of the knight's choice looses.

def arms.fire(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  arms.fire.if8(Bool.not(J.is_null(J.get(h, "possessed"))), run, sortie, id, h, ctx, side)

def arms.fire.k4(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  arms.plain(run, sortie, id, h, ctx, side)

def arms.fire.if5(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      arms.forged(run, sortie, id, h, ctx, side)
    case False{}:
      arms.fire.k4(run, sortie, id, h, ctx, side)

def arms.fire.k3(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  arms.fire.if5(Bool.not(J.is_null(J.get(h, "forged"))), run, sortie, id, h, ctx, side)

def arms.fire.if6(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      arms.punch(run, sortie, id, h, ctx, side)
    case False{}:
      arms.fire.k3(run, sortie, id, h, ctx, side)

def arms.fire.k2(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  arms.fire.if6(gear.Hero.unarmed(h), run, sortie, id, h, ctx, side)

def arms.fire.if7(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +h = {core.set_u(h, "fire_cooldown", hero.Hero.cooldown(h, champions.FLASK_REARM())) : J.Val}
      (h, (run, arms.sortie_push(sortie, "feats", J.JA{[J.JU{id}, J.JS{"flask"}]})))
    case False{}:
      arms.fire.k2(run, sortie, id, h, ctx, side)

def arms.fire.k1(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  arms.fire.if7(champions.Hero.is_alchemist(h), run, sortie, id, h, ctx, side)

def arms.fire.k13(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  (h, (run, sortie))

def arms.fire.if15(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {core.push_sound(run, "shot_spark") : J.Val}
      arms.fire.k13(run, sortie, id, h, ctx, side)
    case False{}:
      arms.fire.k13(run, sortie, id, h, ctx, side)

def arms.fire.if14(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +loosed: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      arms.fire.if15(U32.is_gt(J.u32(J.get(loosed, "Volley")), 0), run, sortie, id, h, ctx, side)
    case False{}:
      arms.fire.k13(run, sortie, id, h, ctx, side)

def arms.fire.k12(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +loosed: J.Val) -> J.Val & (J.Val & J.Val):
  arms.fire.if14(J.has(loosed, "Volley"), run, sortie, id, h, ctx, side, loosed)

def arms.fire.loop17(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +enemies: J.Val, +loosed: J.Val) -> J.Val & (J.Val & J.Val):
  match _xs:
    case Nil{}:
      arms.fire.k12(run, sortie, id, h, ctx, side, loosed)
    case Con{+st, +_t17}:
      +e = {J.nth(J.get(run, "enemies"), J.u32(J.nth(st, 0))) : J.Val}
      +sortie = {arms.credit(sortie, id, J.u32(J.nth(st, 1))) : J.Val}
      +run = {J.set(run, "feel", feel.Feel.impact(J.get(run, "feel"), core.f(e, "x"), core.f(e, "y"), "sacred", (core.f(e, "x") - core.f(h, "x") : F32), (core.f(e, "y") - core.f(h, "y") : F32))) : J.Val}
      +run = {core.push_sound(run, "hit") : J.Val}
      arms.fire.loop17(_t17, run, sortie, id, h, ctx, side, enemies, loosed)

def arms.fire.if16(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +enemies: J.Val, +loosed: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {core.push_sound(run, "swing") : J.Val}
      arms.fire.loop17(J.items(J.get(loosed, "Bite")), run, sortie, id, h, ctx, side, enemies, loosed)
    case False{}:
      arms.fire.k12(run, sortie, id, h, ctx, side, loosed)

def arms.fire.k11(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +h2: J.Val, +enemies: J.Val) -> J.Val & (J.Val & J.Val):
  (+shots, +loosed) = t
  +h = {h2 : J.Val}
  +run = {J.set(run, "enemies", enemies) : J.Val}
  +sortie = {J.set(sortie, "shots", shots) : J.Val}
  arms.fire.if16(J.has(loosed, "Bite"), run, sortie, id, h, ctx, side, enemies, loosed)

def arms.fire.k10(t: J.Val & (J.Val & J.Val), +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool, +h2: J.Val) -> J.Val & (J.Val & J.Val):
  (+enemies, tail) = t
  arms.fire.k11(tail, run, sortie, id, h, ctx, side, h2, enemies)

def arms.fire.k9(t: J.Val & (J.Val & (J.Val & J.Val)), +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  (+h2, rest) = t
  arms.fire.k10(rest, run, sortie, id, h, ctx, side, h2)

def arms.fire.if8(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +side: Bool) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      arms.fire.k9(bodies.loose(h, id, core.s(J.get(run, "dungeon"), "pack"), rules.Run.room(run), core.b(ctx, "barred"), J.get(run, "enemies"), arms.salt(run, id, 48), J.get(sortie, "shots")), run, sortie, id, h, ctx, side)
    case False{}:
      arms.fire.k1(run, sortie, id, h, ctx, side)

# A spell cast from a card in the slot: the effects, the creatures, the flourish.

def arms.cast_card(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +slot: U32, +card: J.Val, +ctx: J.Val) -> J.Val & (J.Val & J.Val):
  +h = {J.set(h, "spell_cooldowns", J.set_nth(J.get(h, "spell_cooldowns"), slot, J.JU{spell_upgrades.Run.spell_wait(run, card)})) : J.Val}
  +before = {core.u(sortie, "nova") : U32}
  arms.cast_card.k1(hero.Hero.spend(h, card, core.u(run, "score"), core.u(sortie, "nova")), run, sortie, id, h, card, before)

def arms.cast_card.k6(+run: J.Val, +sortie: J.Val, +h: J.Val) -> J.Val & (J.Val & J.Val):
  (h, (run, sortie))

def arms.cast_card.if7(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +sortie = {arms.sortie_push(sortie, "feats", J.JA{[J.JU{id}, J.get(card, "id")]}) : J.Val}
      arms.cast_card.k6(run, sortie, h)
    case False{}:
      arms.cast_card.k6(run, sortie, h)

def arms.cast_card.k5(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val) -> J.Val & (J.Val & J.Val):
  +run = {arms.found(run, id, String.append("cast ", core.s(card, "name"))) : J.Val}
  +run = {core.push_sound(run, "spell_cast") : J.Val}
  arms.cast_card.if7(champions.is_spell(core.s(card, "id")), run, sortie, id, h, card)

def arms.cast_card.if8(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +sortie = {arms.sortie_push(sortie, "summons", J.JA{[J.JU{id}, J.get(card, "id")]}) : J.Val}
      arms.cast_card.k5(run, sortie, id, h, card)
    case False{}:
      arms.cast_card.k5(run, sortie, id, h, card)

def arms.cast_card.k4(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val) -> J.Val & (J.Val & J.Val):
  arms.cast_card.if8(Bool.or(cards.Card.has_imps(card), Bool.or(cards.Card.has_minion(card), cards.Card.has_rip(card))), run, sortie, id, h, card)

def arms.cast_card.if13(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32, +_t9: List<&2, J.Val>) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {spells.Run.hedge_maze(run, h, core.s(card, "id"), id, w, hh) : J.Val}
      arms.cast_card.loop9(_t9, run, sortie, id, h, card, w, hh)
    case False{}:
      arms.cast_card.loop9(_t9, run, sortie, id, h, card, w, hh)

def arms.cast_card.k12(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32, +_t9: List<&2, J.Val>, +e: J.Val) -> J.Val & (J.Val & J.Val):
  arms.cast_card.if13(J.has(e, "hedge"), run, sortie, id, h, card, w, hh, _t9)

def arms.cast_card.if14(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32, +_t9: List<&2, J.Val>, +e: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {spells.Run.call_imposture(run, h, core.s(card, "id"), id) : J.Val}
      arms.cast_card.k12(run, sortie, id, h, card, w, hh, _t9, e)
    case False{}:
      arms.cast_card.k12(run, sortie, id, h, card, w, hh, _t9, e)

def arms.cast_card.k11(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32, +_t9: List<&2, J.Val>, +e: J.Val) -> J.Val & (J.Val & J.Val):
  arms.cast_card.if14(J.has(e, "imposture"), run, sortie, id, h, card, w, hh, _t9, e)

def arms.cast_card.if15(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32, +_t9: List<&2, J.Val>, +e: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {spells.Run.cabbage_storm(run, h, core.s(card, "id"), J.u32(J.get(e, "cabbages")), w, hh, id) : J.Val}
      arms.cast_card.k11(run, sortie, id, h, card, w, hh, _t9, e)
    case False{}:
      arms.cast_card.k11(run, sortie, id, h, card, w, hh, _t9, e)

def arms.cast_card.k10(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32, +_t9: List<&2, J.Val>, +e: J.Val) -> J.Val & (J.Val & J.Val):
  arms.cast_card.if15(J.has(e, "cabbages"), run, sortie, id, h, card, w, hh, _t9, e)

def arms.cast_card.k18(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32, +_t9: List<&2, J.Val>, +e: J.Val, +shots: J.Val) -> J.Val & (J.Val & J.Val):
  +sortie = {J.set(sortie, "shots", shots) : J.Val}
  arms.cast_card.k10(run, sortie, id, h, card, w, hh, _t9, e)

def arms.cast_card.if19(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32, +_t9: List<&2, J.Val>, +e: J.Val, +look: J.Val, +start: U32, +shots: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +shots = {arms.dress_from(shots, start, look) : J.Val}
      arms.cast_card.k18(run, sortie, id, h, card, w, hh, _t9, e, shots)
    case False{}:
      arms.cast_card.k18(run, sortie, id, h, card, w, hh, _t9, e, shots)

def arms.cast_card.k17(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32, +_t9: List<&2, J.Val>, +e: J.Val, +look: J.Val) -> J.Val & (J.Val & J.Val):
  +start = {core.count(J.get(sortie, "shots")) : U32}
  +shots = {spells.Hero.spell_shots(h, J.str(J.get(e, "cast")), core.s(card, "id"), id, J.get(sortie, "shots")) : J.Val}
  arms.cast_card.if19(Bool.not(J.is_null(look)), run, sortie, id, h, card, w, hh, _t9, e, look, start, shots)

def arms.cast_card.if20(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32, +_t9: List<&2, J.Val>, +e: J.Val, +look: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +look = {looks.Hero.shot_look(h, J.get(run, "book")) : J.Val}
      arms.cast_card.k17(run, sortie, id, h, card, w, hh, _t9, e, look)
    case False{}:
      arms.cast_card.k17(run, sortie, id, h, card, w, hh, _t9, e, look)

def arms.cast_card.if16(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32, +_t9: List<&2, J.Val>, +e: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +look = {looks.Projectile.look_of(card) : J.Val}
      arms.cast_card.if20(J.is_null(look), run, sortie, id, h, card, w, hh, _t9, e, look)
    case False{}:
      arms.cast_card.k10(run, sortie, id, h, card, w, hh, _t9, e)

def arms.cast_card.loop9(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +w: F32, +hh: F32) -> J.Val & (J.Val & J.Val):
  match _xs:
    case Nil{}:
      arms.cast_card.k4(run, sortie, id, h, card)
    case Con{+e, +_t9}:
      arms.cast_card.if16(J.has(e, "cast"), run, sortie, id, h, card, w, hh, _t9, e)

def arms.cast_card.k3(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val) -> J.Val & (J.Val & J.Val):
  +room = {rules.Run.room(run) : J.Val}
  +w = {layout.Room.width(room) : F32}
  +hh = {layout.Room.height(room) : F32}
  arms.cast_card.loop9(J.items(J.get(card, "effects")), run, sortie, id, h, card, w, hh)

def arms.cast_card.if21(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +sortie = {core.set_u(sortie, "blast_owner", id) : J.Val}
      arms.cast_card.k3(run, sortie, id, h, card)
    case False{}:
      arms.cast_card.k3(run, sortie, id, h, card)

def arms.cast_card.k2(t: U32 & U32, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +before: U32, +h2: J.Val) -> J.Val & (J.Val & J.Val):
  (+score, +nova) = t
  +h = {h2 : J.Val}
  +run = {core.set_u(run, "score", score) : J.Val}
  +sortie = {core.set_u(sortie, "nova", nova) : J.Val}
  arms.cast_card.if21(U32.is_gt(nova, before), run, sortie, id, h, card)

def arms.cast_card.k1(t: J.Val & (U32 & U32), +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +before: U32) -> J.Val & (J.Val & J.Val):
  (+h2, st) = t
  arms.cast_card.k2(st, run, sortie, id, h, card, before, h2)

# Every shot from `start` on wears `look`.

def arms.dress_from(+shots: J.Val, +start: U32, +look: J.Val) -> J.Val:
  +out = {[] : List<&2, J.Val>}
  +i = {0 : U32}
  arms.dress_from.loop2(J.items(shots), start, look, out, i)

def arms.dress_from.k1(+out: List<&2, J.Val>) -> J.Val:
  J.JA{out}

def arms.dress_from.k3(+start: U32, +look: J.Val, +out: List<&2, J.Val>, +i: U32, +_t2: List<&2, J.Val>, +s: J.Val) -> J.Val:
  +out = {List.append(&2, J.Val, out, [s]) : List<&2, J.Val>}
  +i = {(i + 1 : U32) : U32}
  arms.dress_from.loop2(_t2, start, look, out, i)

def arms.dress_from.if4(_c: Bool, +start: U32, +look: J.Val, +out: List<&2, J.Val>, +i: U32, +_t2: List<&2, J.Val>, +s: J.Val) -> J.Val:
  match _c:
    case True{}:
      +s = {J.set(s, "look", look) : J.Val}
      arms.dress_from.k3(start, look, out, i, _t2, s)
    case False{}:
      arms.dress_from.k3(start, look, out, i, _t2, s)

def arms.dress_from.loop2(+_xs: List<&2, J.Val>, +start: U32, +look: J.Val, +out: List<&2, J.Val>, +i: U32) -> J.Val:
  match _xs:
    case Nil{}:
      arms.dress_from.k1(out)
    case Con{+s, +_t2}:
      arms.dress_from.if4(U32.is_ge(i, start), start, look, out, i, _t2, s)

# The spell keys: a borrowed body's cast, a module's ability, or a card spell.

def arms.cast(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +input: J.Val, +ctx: J.Val) -> J.Val & (J.Val & J.Val):
  +cast = {core.u(input, "cast") : U32}
  +slot = {core.usub(cast, 1) : U32}
  +in_range = {Bool.and(U32.is_ge(cast, 1), U32.is_le(cast, cards.SPELL_SLOTS())) : Bool}
  arms.cast.if12(Bool.not(J.is_null(J.get(h, "possessed"))), run, sortie, id, h, ctx, cast, slot, in_range)

def arms.cast.k4(+run: J.Val, +sortie: J.Val, +h: J.Val) -> J.Val & (J.Val & J.Val):
  (h, (run, sortie))

def arms.cast.if7(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32, +card: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      arms.cast_card(run, sortie, id, h, slot, card, ctx)
    case False{}:
      arms.cast.k4(run, sortie, h)

def arms.cast.if6(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32, +sp: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +card = {cards.Book.get(J.get(run, "book"), J.str(sp)) : J.Val}
      arms.cast.if7(Bool.and(Bool.not(J.is_null(card)), String.eq(core.s(card, "kind"), "spell")), run, sortie, id, h, ctx, slot, card)
    case False{}:
      arms.cast.k4(run, sortie, h)

def arms.cast.if5(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +sp = {J.nth(J.get(h, "spells"), slot) : J.Val}
      arms.cast.if6(Bool.not(J.is_null(sp)), run, sortie, id, h, ctx, slot, sp)
    case False{}:
      arms.cast.k4(run, sortie, h)

def arms.cast.k3(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32) -> J.Val & (J.Val & J.Val):
  arms.cast.if5(U32.is_zero(J.u32(J.nth(J.get(h, "spell_cooldowns"), slot))), run, sortie, id, h, ctx, slot)

def arms.cast.k9(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32) -> J.Val & (J.Val & J.Val):
  (h, (run, sortie))

def arms.cast.if10(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32, +binding: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +req = {J.obj() : J.Val}
      +req = {core.set_u(req, "player", id) : J.Val}
      +req = {core.set_u(req, "slot", slot) : J.Val}
      +req = {J.set(req, "module", J.get(binding, "module")) : J.Val}
      +req = {J.set(req, "generation", J.get(binding, "generation")) : J.Val}
      +req = {J.set(req, "ability", J.get(binding, "ability")) : J.Val}
      +req = {J.set(req, "tick", J.get(run, "tick")) : J.Val}
      +run = {J.set(run, "module_casts", J.push(J.get(run, "module_casts"), req)) : J.Val}
      +h = {J.set(h, "spell_cooldowns", J.set_nth(J.get(h, "spell_cooldowns"), slot, J.JU{1})) : J.Val}
      arms.cast.k9(run, sortie, id, h, ctx, slot)
    case False{}:
      arms.cast.k9(run, sortie, id, h, ctx, slot)

def arms.cast.if8(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32, +binding: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +cool = {J.u32(J.nth(J.get(h, "spell_cooldowns"), slot)) : U32}
      arms.cast.if10(Bool.and(U32.is_zero(cool), Bool.and(F32.is_ge(core.f(h, "mana"), core.f(binding, "mana")), U32.is_lt(core.count(J.get(run, "module_casts")), 16))), run, sortie, id, h, ctx, slot, binding)
    case False{}:
      arms.cast.k3(run, sortie, id, h, ctx, slot)

def arms.cast.k2(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32) -> J.Val & (J.Val & J.Val):
  +binding = {J.nth(J.get(h, "module_spells"), slot) : J.Val}
  arms.cast.if8(Bool.not(J.is_null(binding)), run, sortie, id, h, ctx, slot, binding)

def arms.cast.if11(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      (h, (run, sortie))
    case False{}:
      arms.cast.k2(run, sortie, id, h, ctx, slot)

def arms.cast.k1(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32, +in_range: Bool) -> J.Val & (J.Val & J.Val):
  arms.cast.if11(Bool.not(in_range), run, sortie, id, h, ctx, slot)

def arms.cast.k13(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32, +in_range: Bool) -> J.Val & (J.Val & J.Val):
  (h, (run, sortie))

def arms.cast.if18(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +cast: U32, +slot: U32, +in_range: Bool, +named: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {arms.found(run, id, String.append("cast ", J.str(named))) : J.Val}
      +run = {core.push_sound(run, "spell_cast") : J.Val}
      arms.cast.k13(run, sortie, id, h, ctx, slot, in_range)
    case False{}:
      arms.cast.k13(run, sortie, id, h, ctx, slot, in_range)

def arms.cast.k17(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +cast: U32, +slot: U32, +in_range: Bool, +named: J.Val) -> J.Val & (J.Val & J.Val):
  (+shots, +enemies) = t
  +sortie = {J.set(sortie, "shots", shots) : J.Val}
  arms.cast.if18(Bool.not(J.is_null(named)), run, sortie, id, h, ctx, cast, slot, in_range, named)

def arms.cast.k16(t: J.Val & (J.Val & J.Val), +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +cast: U32, +slot: U32, +in_range: Bool) -> J.Val & (J.Val & J.Val):
  (+named, tail) = t
  arms.cast.k17(tail, run, sortie, id, h, ctx, cast, slot, in_range, named)

def arms.cast.k15(t: J.Val & (J.Val & (J.Val & J.Val)), +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +cast: U32, +slot: U32, +in_range: Bool) -> J.Val & (J.Val & J.Val):
  (+h2, rest) = t
  +h = {h2 : J.Val}
  arms.cast.k16(rest, run, sortie, id, h, ctx, cast, slot, in_range)

def arms.cast.if14(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +cast: U32, +slot: U32, +in_range: Bool) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      arms.cast.k15(bodies.cast(h, id, rules.Run.room(run), core.b(ctx, "barred"), J.get(run, "enemies"), arms.salt_cast(run, id), J.get(sortie, "shots")), run, sortie, id, h, ctx, cast, slot, in_range)
    case False{}:
      arms.cast.k13(run, sortie, id, h, ctx, slot, in_range)

def arms.cast.if12(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +cast: U32, +slot: U32, +in_range: Bool) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      arms.cast.if14(in_range, run, sortie, id, h, ctx, cast, slot, in_range)
    case False{}:
      arms.cast.k1(run, sortie, id, h, ctx, slot, in_range)

# A borrowed body's cast gets its own dice.

def arms.salt_cast(+run: J.Val, +id: U32) -> W.W:
  arms.salt(run, id, 40)

# The play key: one card from the hand.

def arms.play_card(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +input: J.Val, +ctx: J.Val) -> J.Val & (J.Val & J.Val):
  +h = {core.set_u(h, "play_cooldown", core.usub(core.u(h, "play_cooldown"), 1)) : J.Val}
  +slot = {core.u(input, "play") : U32}
  arms.play_card.if22(Bool.or(U32.is_lt(slot, 1), Bool.or(U32.is_gt(slot, core.count(J.get(h, "hand"))), U32.is_ne(core.u(h, "play_cooldown"), 0))), run, sortie, id, h, ctx, slot)

def arms.play_card.k10(+run: J.Val, +sortie: J.Val, +h: J.Val) -> J.Val & (J.Val & J.Val):
  (h, (run, sortie))

def arms.play_card.if13(_c: Bool, +run: J.Val, +sortie: J.Val, +h: J.Val, +_t11: List<&2, J.Val>) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {core.push_cue(run, "sceptre") : J.Val}
      arms.play_card.loop11(_t11, run, sortie, h)
    case False{}:
      arms.play_card.loop11(_t11, run, sortie, h)

def arms.play_card.k12(+run: J.Val, +sortie: J.Val, +h: J.Val, +_t11: List<&2, J.Val>, +e: J.Val) -> J.Val & (J.Val & J.Val):
  arms.play_card.if13(J.has(e, "immune"), run, sortie, h, _t11)

def arms.play_card.if14(_c: Bool, +run: J.Val, +sortie: J.Val, +h: J.Val, +_t11: List<&2, J.Val>, +e: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {core.push_cue(run, "blink") : J.Val}
      arms.play_card.k12(run, sortie, h, _t11, e)
    case False{}:
      arms.play_card.k12(run, sortie, h, _t11, e)

def arms.play_card.loop11(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +h: J.Val) -> J.Val & (J.Val & J.Val):
  match _xs:
    case Nil{}:
      arms.play_card.k10(run, sortie, h)
    case Con{+e, +_t11}:
      arms.play_card.if14(J.has(e, "blink"), run, sortie, h, _t11, e)

def arms.play_card.k9(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val) -> J.Val & (J.Val & J.Val):
  +run = {arms.found(run, id, String.append("played ", core.s(card, "name"))) : J.Val}
  +run = {core.push_sound(run, "play_card") : J.Val}
  arms.play_card.loop11(J.items(J.get(card, "effects")), run, sortie, h)

def arms.play_card.if16(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val, +_t15: List<&2, J.Val>) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +sortie = {arms.sortie_push(sortie, "draughts", core.pair_f(core.f(h, "x"), core.f(h, "y"))) : J.Val}
      arms.play_card.loop15(_t15, run, sortie, id, h, card)
    case False{}:
      arms.play_card.loop15(_t15, run, sortie, id, h, card)

def arms.play_card.loop15(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val) -> J.Val & (J.Val & J.Val):
  match _xs:
    case Nil{}:
      arms.play_card.k9(run, sortie, id, h, card)
    case Con{+e, +_t15}:
      arms.play_card.if16(J.has(e, "heal"), run, sortie, id, h, card, _t15)

def arms.play_card.k8(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +card: J.Val) -> J.Val & (J.Val & J.Val):
  arms.play_card.loop15(J.items(J.get(card, "effects")), run, sortie, id, h, card)

def arms.play_card.if17(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +card: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {hireling.Run.take_minion(run, card, h, id, core.u(ctx, "depth"), rules.Run.room(run), core.b(ctx, "barred")) : J.Val}
      arms.play_card.k8(run, sortie, id, h, card)
    case False{}:
      arms.play_card.k8(run, sortie, id, h, card)

def arms.play_card.k7(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +summon: Bool, +own: Bool, +card: J.Val) -> J.Val & (J.Val & J.Val):
  arms.play_card.if17(Bool.and(summon, Bool.not(own)), run, sortie, id, h, ctx, card)

def arms.play_card.if18(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +summon: Bool, +own: Bool, +card: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +sortie = {arms.sortie_push(sortie, "summons", J.JA{[J.JU{id}, J.get(card, "id")]}) : J.Val}
      arms.play_card.k7(run, sortie, id, h, ctx, summon, own, card)
    case False{}:
      arms.play_card.k7(run, sortie, id, h, ctx, summon, own, card)

def arms.play_card.k6(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +summon: Bool, +own: Bool, +card: J.Val) -> J.Val & (J.Val & J.Val):
  arms.play_card.if18(Bool.or(cards.Card.has_imps(card), Bool.and(own, summon)), run, sortie, id, h, ctx, summon, own, card)

def arms.play_card.if19(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +summon: Bool, +own: Bool, +card: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +sortie = {core.set_u(sortie, "blast_owner", id) : J.Val}
      arms.play_card.k6(run, sortie, id, h, ctx, summon, own, card)
    case False{}:
      arms.play_card.k6(run, sortie, id, h, ctx, summon, own, card)

def arms.play_card.k5(t: U32 & U32, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +summon: Bool, +own: Bool, +card: J.Val, +before: U32, +h2: J.Val) -> J.Val & (J.Val & J.Val):
  (+score, +nova) = t
  +h = {h2 : J.Val}
  +run = {core.set_u(run, "score", score) : J.Val}
  +sortie = {core.set_u(sortie, "nova", nova) : J.Val}
  arms.play_card.if19(U32.is_gt(nova, before), run, sortie, id, h, ctx, summon, own, card)

def arms.play_card.k4(t: J.Val & (U32 & U32), +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +summon: Bool, +own: Bool, +card: J.Val, +before: U32) -> J.Val & (J.Val & J.Val):
  (+h2, st) = t
  arms.play_card.k5(st, run, sortie, id, h, ctx, summon, own, card, before, h2)

def arms.play_card.k3(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +summon: Bool, +own: Bool, +card: J.Val) -> J.Val & (J.Val & J.Val):
  +before = {core.u(sortie, "nova") : U32}
  arms.play_card.k4(hero.Hero.spend(h, card, core.u(run, "score"), core.u(sortie, "nova")), run, sortie, id, h, ctx, summon, own, card, before)

def arms.play_card.if20(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +summon: Bool, +own: Bool, +card: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      (h, (run, sortie))
    case False{}:
      arms.play_card.k3(run, sortie, id, h, ctx, summon, own, card)

def arms.play_card.k2(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32, +id_card: J.Val, +summon: Bool, +own: Bool) -> J.Val & (J.Val & J.Val):
  +h = {J.set(h, "hand", cards.vec_remove(J.get(h, "hand"), (slot - 1 : U32))) : J.Val}
  +card = {cards.Book.get(J.get(run, "book"), J.str(id_card)) : J.Val}
  arms.play_card.if20(J.is_null(card), run, sortie, id, h, ctx, summon, own, card)

def arms.play_card.if21(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32, +id_card: J.Val, +summon: Bool, +own: Bool) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +run = {arms.found(run, id, "Beaumains will not share the road with it") : J.Val}
      (h, (run, sortie))
    case False{}:
      arms.play_card.k2(run, sortie, id, h, ctx, slot, id_card, summon, own)

def arms.play_card.k1(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32) -> J.Val & (J.Val & J.Val):
  +h = {core.set_u(h, "play_cooldown", U32.div(rules.HZ(), 2)) : J.Val}
  +id_card = {J.nth(J.get(h, "hand"), (slot - 1 : U32)) : J.Val}
  +held = {cards.Book.get(J.get(run, "book"), J.str(id_card)) : J.Val}
  +summon = {Bool.and(Bool.not(J.is_null(held)), cards.Card.has_summon(held)) : Bool}
  +beaumains = {hireling.Run.is_beaumains(run) : Bool}
  +own = {minions.Hero.summoner(h) : Bool}
  arms.play_card.if21(Bool.and(summon, Bool.and(beaumains, Bool.not(own))), run, sortie, id, h, ctx, slot, id_card, summon, own)

def arms.play_card.if22(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +ctx: J.Val, +slot: U32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      (h, (run, sortie))
    case False{}:
      arms.play_card.k1(run, sortie, id, h, ctx, slot)

# A bomb: thrown at the knight's feet.

def arms.bomb(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +input: J.Val) -> J.Val & (J.Val & J.Val):
  arms.bomb.if2(Bool.and(core.b(input, "bomb"), Bool.and(U32.is_gt(core.u(h, "bombs"), 0), U32.is_zero(core.u(h, "bomb_cooldown")))), run, sortie, id, h)

def arms.bomb.k1(+run: J.Val, +sortie: J.Val, +h: J.Val) -> J.Val & (J.Val & J.Val):
  (h, (run, sortie))

def arms.bomb.if2(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +h = {core.set_u(h, "bombs", (core.u(h, "bombs") - 1 : U32)) : J.Val}
      +h = {core.set_u(h, "bomb_cooldown", rules.BOMB_REARM()) : J.Val}
      +h = {core.set_u(h, "invulnerable", U32.max(core.u(h, "invulnerable"), U32.div(rules.HZ(), 2))) : J.Val}
      +sortie = {core.set_u(sortie, "bombs", (core.u(sortie, "bombs") + 1 : U32)) : J.Val}
      +sortie = {core.set_u(sortie, "blast_owner", id) : J.Val}
      +sortie = {arms.sortie_push(sortie, "booms", core.pair_f(core.f(h, "x"), core.f(h, "y"))) : J.Val}
      +run = {core.push_shake(run, 8) : J.Val}
      +run = {core.push_sound(run, "bomb") : J.Val}
      arms.bomb.k1(run, sortie, h)
    case False{}:
      arms.bomb.k1(run, sortie, h)

# The spin's sweep: both axes round, cutting what is near and the shots in reach.

def arms.spin_sweep(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val) -> J.Val & J.Val:
  +heavy = {False{} : Bool}
  arms.spin_sweep.if13(U32.is_gt(core.u(h, "whirl"), 0), run, sortie, id, h, heavy)

def arms.spin_sweep.k6(+run: J.Val, +sortie: J.Val) -> J.Val & J.Val:
  (run, sortie)

def arms.spin_sweep.if7(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +dealt: U32) -> J.Val & J.Val:
  match _c:
    case True{}:
      +sortie = {arms.credit(sortie, id, dealt) : J.Val}
      arms.spin_sweep.k6(run, sortie)
    case False{}:
      arms.spin_sweep.k6(run, sortie)

def arms.spin_sweep.k5(+run: J.Val, +sortie: J.Val, +id: U32, +dealt: U32) -> J.Val & J.Val:
  arms.spin_sweep.if7(U32.is_gt(dealt, 0), run, sortie, id, dealt)

def arms.spin_sweep.if8(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +dealt: U32) -> J.Val & J.Val:
  match _c:
    case True{}:
      +run = {hitstop.State.put(run, hitstop.State.request(J.get(run, "hitstop"), J.get(run, "tune"), HitHeavy{})) : J.Val}
      arms.spin_sweep.k5(run, sortie, id, dealt)
    case False{}:
      arms.spin_sweep.k5(run, sortie, id, dealt)

def arms.spin_sweep.k4(+run: J.Val, +sortie: J.Val, +id: U32, +heavy: Bool, +dealt: U32, +shots: List<&2, J.Val>) -> J.Val & J.Val:
  +run = {J.set(run, "projectiles", J.JA{shots}) : J.Val}
  arms.spin_sweep.if8(Bool.and(heavy, U32.is_gt(dealt, 0)), run, sortie, id, dealt)

def arms.spin_sweep.k10(+run: J.Val, +sortie: J.Val, +id: U32, +heavy: Bool, +hx: F32, +hy: F32, +dealt: U32, +shots: List<&2, J.Val>, +_t9: List<&2, J.Val>, +s: J.Val) -> J.Val & J.Val:
  +shots = {List.append(&2, J.Val, shots, [s]) : List<&2, J.Val>}
  arms.spin_sweep.loop9(_t9, run, sortie, id, heavy, hx, hy, dealt, shots)

def arms.spin_sweep.if11(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +heavy: Bool, +hx: F32, +hy: F32, +dealt: U32, +shots: List<&2, J.Val>, +_t9: List<&2, J.Val>, +s: J.Val) -> J.Val & J.Val:
  match _c:
    case True{}:
      +s = {core.set_u(s, "ttl", 0) : J.Val}
      arms.spin_sweep.k10(run, sortie, id, heavy, hx, hy, dealt, shots, _t9, s)
    case False{}:
      arms.spin_sweep.k10(run, sortie, id, heavy, hx, hy, dealt, shots, _t9, s)

def arms.spin_sweep.loop9(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +id: U32, +heavy: Bool, +hx: F32, +hy: F32, +dealt: U32, +shots: List<&2, J.Val>) -> J.Val & J.Val:
  match _xs:
    case Nil{}:
      arms.spin_sweep.k4(run, sortie, id, heavy, dealt, shots)
    case Con{+s, +_t9}:
      arms.spin_sweep.if11(Bool.and(core.b(s, "hostile"), F32.is_le(RS.f_hypot((core.f(s, "x") - hx : F32), (core.f(s, "y") - hy : F32)), (spin.REACH() + 0.6 : F32))), run, sortie, id, heavy, hx, hy, dealt, shots, _t9, s)

def arms.spin_sweep.k3(+run: J.Val, +sortie: J.Val, +id: U32, +heavy: Bool, +hx: F32, +hy: F32, +dealt: U32) -> J.Val & J.Val:
  +shots = {[] : List<&2, J.Val>}
  arms.spin_sweep.loop9(J.items(J.get(run, "projectiles")), run, sortie, id, heavy, hx, hy, dealt, shots)

def arms.spin_sweep.loop12(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +id: U32, +heavy: Bool, +hx: F32, +hy: F32, +enemies: J.Val, +dealt: U32) -> J.Val & J.Val:
  match _xs:
    case Nil{}:
      arms.spin_sweep.k3(run, sortie, id, heavy, hx, hy, dealt)
    case Con{+st, +_t12}:
      +i = {J.u32(J.nth(st, 0)) : U32}
      +took = {J.u32(J.nth(st, 1)) : U32}
      +e = {J.nth(J.get(run, "enemies"), i) : J.Val}
      +run = {J.set(run, "enemies", J.set_nth(J.get(run, "enemies"), i, J.set(e, "wits", core.set_u(J.get(e, "wits"), "foe", id)))) : J.Val}
      +dealt = {(dealt + took : U32) : U32}
      +run = {core.push_sound(run, "hit") : J.Val}
      arms.spin_sweep.loop12(_t12, run, sortie, id, heavy, hx, hy, enemies, dealt)

def arms.spin_sweep.k2(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +heavy: Bool, +hx: F32, +hy: F32, +enemies: J.Val) -> J.Val & J.Val:
  (+enemies2, +struck) = t
  +run = {J.set(run, "enemies", enemies2) : J.Val}
  +dealt = {0 : U32}
  arms.spin_sweep.loop12(J.items(struck), run, sortie, id, heavy, hx, hy, enemies, dealt)

def arms.spin_sweep.k1(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +heavy: Bool) -> J.Val & J.Val:
  +hx = {core.f(h, "x") : F32}
  +hy = {core.f(h, "y") : F32}
  +damage = {hero.Hero.scaled(h, spin.DAMAGE()) : U32}
  +enemies = {J.get(run, "enemies") : J.Val}
  arms.spin_sweep.k2(aoe.strike(enemies, hx, hy, damage, aoe.mask_circle(enemies, hx, hy, spin.REACH(), 1.0, 4294967295)), run, sortie, id, heavy, hx, hy, enemies)

def arms.spin_sweep.if15(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +heavy: Bool, +_t14: List<&2, J.Val>) -> J.Val & J.Val:
  match _c:
    case True{}:
      +heavy = {True{} : Bool}
      arms.spin_sweep.loop14(_t14, run, sortie, id, h, heavy)
    case False{}:
      arms.spin_sweep.loop14(_t14, run, sortie, id, h, heavy)

def arms.spin_sweep.loop14(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +heavy: Bool) -> J.Val & J.Val:
  match _xs:
    case Nil{}:
      arms.spin_sweep.k1(run, sortie, id, h, heavy)
    case Con{+e, +_t14}:
      arms.spin_sweep.if15(Bool.and(Bool.and(U32.is_ne(core.u(e, "hp"), 0), desperate.Enemy.is_boss(e)), F32.is_le(RS.f_hypot((core.f(e, "x") - core.f(h, "x") : F32), (core.f(e, "y") - core.f(h, "y") : F32)), (spin.REACH() + monsters.Enemy.radius(e) : F32))), run, sortie, id, h, heavy, _t14)

def arms.spin_sweep.if13(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val, +heavy: Bool) -> J.Val & J.Val:
  match _c:
    case True{}:
      arms.spin_sweep.loop14(J.items(J.get(run, "enemies")), run, sortie, id, h, heavy)
    case False{}:
      arms.spin_sweep.k1(run, sortie, id, h, heavy)

# One knight's turn. (run, sortie); the knight is written back to the run on every path.

def arms.turn_one(+run: J.Val, +sortie: J.Val, +id: U32, +in0: J.Val, +ctx: J.Val) -> J.Val & J.Val:
  +h = {core.hero(run, id) : J.Val}
  +input = {in0 : J.Val}
  +side = {core.b(ctx, "side") : Bool}
  +fighting = {core.b(ctx, "fighting") : Bool}
  +h = {presence.wake_on_first_move(h, input) : J.Val}
  +h = {core.set_u(h, "vigil_rearm", core.usub(core.u(h, "vigil_rearm"), 1)) : J.Val}
  arms.turn_one.if79(Bool.and(Bool.and(core.b(input, "vigil"), Bool.not(core.b(h, "vigil_key"))), Bool.and(U32.is_zero(core.u(h, "vigil_rearm")), Bool.and(U32.is_ne(core.u(h, "hp"), 0), Bool.or(core.b(h, "vigil"), Bool.not(fighting))))), run, sortie, id, ctx, h, input, side, fighting)

def arms.turn_one.k36(+run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val) -> J.Val & J.Val:
  (core.set_hero(run, id, h), sortie)

def arms.turn_one.k39(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val) -> J.Val & J.Val:
  (+run17, +sortie17) = t
  +run = {run17 : J.Val}
  +sortie = {sortie17 : J.Val}
  arms.turn_one.k36(run, sortie, id, h)

def arms.turn_one.k38(t: J.Val & (J.Val & J.Val), +run: J.Val, +sortie: J.Val, +id: U32, +h: J.Val) -> J.Val & J.Val:
  (+h16, fr) = t
  +h = {h16 : J.Val}
  arms.turn_one.k39(fr, run, sortie, id, h)

def arms.turn_one.if37(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +side: Bool) -> J.Val & J.Val:
  match _c:
    case True{}:
      arms.turn_one.k38(arms.fire(run, sortie, id, h, ctx, side), run, sortie, id, h)
    case False{}:
      arms.turn_one.k36(run, sortie, id, h)

def arms.turn_one.k35(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  +guarded_now = {Bool.or(Bool.or(U32.is_gt(core.u(h, "flee_ticks"), 0), U32.is_gt(core.u(h, "dash_ticks"), 0)), Bool.or(Bool.or(core.b(h, "shielding"), core.b(h, "walling")), Bool.or(U32.is_gt(core.u(h, "spin"), 0), champions.Hero.busy(h)))) : Bool}
  +pulling = {Bool.or(core.b(input, "fire"), Bool.or(F32.is_ne(ax, 0.0), F32.is_ne(ay, 0.0))) : Bool}
  arms.turn_one.if37(Bool.and(Bool.and(Bool.not(core.b(ctx, "arcade")), pulling), Bool.and(U32.is_zero(core.u(h, "fire_cooldown")), Bool.not(guarded_now))), run, sortie, id, ctx, h, side)

def arms.turn_one.k42(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  (+run15, +sortie15) = t
  +run = {run15 : J.Val}
  +sortie = {sortie15 : J.Val}
  arms.turn_one.k35(run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.k41(t: J.Val & (J.Val & J.Val), +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  (+h14, sr) = t
  +h = {h14 : J.Val}
  arms.turn_one.k42(sr, run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.if40(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  match _c:
    case True{}:
      arms.turn_one.k41(arms.sword(run, sortie, id, h, ctx), run, sortie, id, ctx, h, input, side, ax, ay)
    case False{}:
      arms.turn_one.k35(run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.k34(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  (+run13, +sortie13) = t
  +run = {run13 : J.Val}
  +sortie = {sortie13 : J.Val}
  +h = {core.set_u(h, "sword_cooldown", core.usub(core.u(h, "sword_cooldown"), 1)) : J.Val}
  arms.turn_one.if40(Bool.and(Bool.and(core.b(input, "swing"), Bool.not(gear.Hero.unarmed(h))), Bool.and(J.is_null(J.get(h, "possessed")), Bool.and(U32.is_zero(core.u(h, "sword_cooldown")), U32.is_zero(core.u(h, "dash_ticks"))))), run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.k33(t: J.Val & (J.Val & J.Val), +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  (+h12, br) = t
  +h = {h12 : J.Val}
  arms.turn_one.k34(br, run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.k32(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  (+run11, +sortie11) = t
  +run = {run11 : J.Val}
  +sortie = {sortie11 : J.Val}
  arms.turn_one.k33(arms.bomb(run, sortie, id, h, input), run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.k31(t: J.Val & (J.Val & J.Val), +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  (+h10, pr) = t
  +h = {h10 : J.Val}
  arms.turn_one.k32(pr, run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.k30(t: J.Val & J.Val, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  (+run9, +sortie9) = t
  +run = {run9 : J.Val}
  +sortie = {sortie9 : J.Val}
  arms.turn_one.k31(arms.play_card(run, sortie, id, h, input, ctx), run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.k29(t: J.Val & (J.Val & J.Val), +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  (+h8, cr) = t
  +h = {h8 : J.Val}
  arms.turn_one.k30(cr, run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.k28(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32, +cds: List<&2, J.Val>) -> J.Val & J.Val:
  +h = {J.set(h, "spell_cooldowns", J.JA{cds}) : J.Val}
  +h = {core.set_u_skip(h, "body_rearm", core.usub(core.u(h, "body_rearm"), 1)) : J.Val}
  arms.turn_one.k29(arms.cast(run, sortie, id, h, input, ctx), run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.loop43(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32, +cds: List<&2, J.Val>) -> J.Val & J.Val:
  match _xs:
    case Nil{}:
      arms.turn_one.k28(run, sortie, id, ctx, h, input, side, ax, ay, cds)
    case Con{+c0, +_t43}:
      +cds = {List.append(&2, J.Val, cds, [J.JU{core.usub(J.u32(c0), 1)}]) : List<&2, J.Val>}
      arms.turn_one.loop43(_t43, run, sortie, id, ctx, h, input, side, ax, ay, cds)

def arms.turn_one.k27(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  +cds = {[] : List<&2, J.Val>}
  arms.turn_one.loop43(J.items(J.get(h, "spell_cooldowns")), run, sortie, id, ctx, h, input, side, ax, ay, cds)

def arms.turn_one.if44(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  match _c:
    case True{}:
      +input = {rules.Input.default() : J.Val}
      arms.turn_one.k27(run, sortie, id, ctx, h, input, side, ax, ay)
    case False{}:
      arms.turn_one.k27(run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.k26(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32) -> J.Val & J.Val:
  arms.turn_one.if44(U32.is_gt(core.u(h, "flee_ticks"), 0), run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.if47(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32, +feet_y: F32, +rdx: F32, +rdy: F32) -> J.Val & J.Val:
  match _c:
    case True{}:
      +run = {J.set(run, "feel", feel.Feel.dust(J.get(run, "feel"), core.f(h, "x"), feet_y, rdx, rdy, feel.TRAIL())) : J.Val}
      arms.turn_one.k26(run, sortie, id, ctx, h, input, side, ax, ay)
    case False{}:
      arms.turn_one.k26(run, sortie, id, ctx, h, input, side, ax, ay)

def arms.turn_one.if46(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32, +feet_y: F32, +rdx: F32, +rdy: F32) -> J.Val & J.Val:
  match _c:
    case True{}:
      +run = {J.set(run, "feel", feel.Feel.dust(J.get(run, "feel"), core.f(h, "x"), feet_y, rdx, rdy, feel.LAND())) : J.Val}
      arms.turn_one.k26(run, sortie, id, ctx, h, input, side, ax, ay)
    case False{}:
      arms.turn_one.if47(Bool.and(U32.is_gt(core.u(h, "dash_ticks"), 0), U32.is_zero(U32.mod(core.u(h, "dash_ticks"), 3))), run, sortie, id, ctx, h, input, side, ax, ay, feet_y, rdx, rdy)

def arms.turn_one.if45(_c: Bool, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +ax: F32, +ay: F32, +rolled_before: U32, +feet_y: F32, +rdx: F32, +rdy: F32) -> J.Val & J.Val:
  match _c:
    case True{}:
      +run = {J.set(run, "feel", feel.Feel.dust(J.get(run, "feel"), core.f(h, "x"), feet_y, rdx, rdy, feel.KICK())) : J.Val}
      arms.turn_one.k26(run, sortie, id, ctx, h, input, side, ax, ay)
    case False{}:
      arms.turn_one.if46(Bool.and(U32.is_eq(rolled_before, 1), U32.is_zero(core.u(h, "dash_ticks"))), run, sortie, id, ctx, h, input, side, ax, ay, feet_y, rdx, rdy)

def arms.turn_one.k25(t: F32 & F32, +run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool, +guarded: J.Val, +ax: F32, +ay: F32, +rolled_before: U32, +feet_y: F32) -> J.Val & J.Val:
