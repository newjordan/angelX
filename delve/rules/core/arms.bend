# crates/delve/src/rules/arms.rs — the knights' turn on a tick (`Run::play`): each knight's keys and arms,

# from the vigil and the walk to the sword and the fire key, and the bombs they threw going off.

# The `ctx` is what the turn found once before the knights: {side, barred, arcade, fighting, roads,

# admitted: [ids], depth} (the room is the party's room).

# `inputs.get(id).copied().filter(valid).unwrap_or_default()`

def arms.input_of(+inputs: J.Val, +id: U32) -> J.Val:
  +i = {J.get(inputs, U32.show(id)) : J.Val}
  arms.input_of.if2(Bool.and(Bool.not(J.is_null(i)), rules.Input.valid(i)), i)

def arms.input_of.k1() -> J.Val:
  rules.Input.default()

def arms.input_of.if2(_c: Bool, +i: J.Val) -> J.Val:
  match _c:
    case True{}:
      i
    case False{}:
      arms.input_of.k1()

def arms.sortie_push(+sortie: J.Val, +key: String, +item: J.Val) -> J.Val:
  J.set(sortie, key, J.push(J.get(sortie, key), item))

# The credit for the damage a knight dealt this tick.

def arms.credit(+sortie: J.Val, +id: U32, +dealt: U32) -> J.Val:
  arms.sortie_push(sortie, "credits", J.JA{[J.JU{id}, J.JU{dealt}]})

# `hero.found = Some((tick, id, line))`

def arms.found(+run: J.Val, +id: U32, +line: String) -> J.Val:
  J.set(run, "found", J.JA{[J.get(run, "tick"), J.JU{id}, J.JS{line}]})

# The angle between a direction and an aim, absolute and wrapped.

def arms.delta(+dx: F32, +dy: F32, +angle: F32) -> F32:
  +a = {(F32.atan2(dy, dx) - angle : F32) : F32}
  F32.abs(F32.atan2(F32.sin(a), F32.cos(a)))

# The mask of monsters in a cone: within `reach + radius` and `half` of the aim.

def arms.cone_mask(+enemies: J.Val, +hx: F32, +hy: F32, +angle: F32, +reach: F32, +half: F32, +room: J.Val, +barred: Bool, +check_open: Bool) -> List<&2, Bool>:
  +mask = {[] : List<&2, Bool>}
  arms.cone_mask.loop2(J.items(enemies), hx, hy, angle, reach, half, room, barred, check_open, mask)

