  mask

def arms.cone_mask.k3(+hx: F32, +hy: F32, +angle: F32, +reach: F32, +half: F32, +room: J.Val, +barred: Bool, +check_open: Bool, +mask: List<&2, Bool>, +_t2: List<&2, J.Val>, +hit: Bool) -> List<&2, Bool>:
  +mask = {List.append(&2, Bool, mask, [hit]) : List<&2, Bool>}
