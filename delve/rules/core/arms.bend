def arms.turn_one.k9(+run: J.Val, +sortie: J.Val, +id: U32, +ctx: J.Val, +h: J.Val, +input: J.Val, +side: Bool) -> J.Val & J.Val:
  +h = {core.set_u(h, "invulnerable", core.usub(core.u(h, "invulnerable"), 1)) : J.Val}
  +h = {core.set_u(h, "bomb_cooldown", core.usub(core.u(h, "bomb_cooldown"), 1)) : J.Val}
  +h = {core.set_u(h, "fire_cooldown", core.usub(core.u(h, "fire_cooldown"), 1)) : J.Val}
  +h = {core.set_u(h, "swing", core.usub(core.u(h, "swing"), 1)) : J.Val}
  +shield_free = {Bool.not(works.Run.shield_out(run, id)) : Bool}
  arms.turn_one.k10(hero.Hero.own_keys(h, input, side, shield_free), run, sortie, id, ctx, h, input, side)

