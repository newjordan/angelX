def arms.cone_mask.loop2(+_xs: List<&2, J.Val>, +hx: F32, +hy: F32, +angle: F32, +reach: F32, +half: F32, +room: J.Val, +barred: Bool, +check_open: Bool, +mask: List<&2, Bool>) -> List<&2, Bool>:
