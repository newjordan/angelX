      +ay = {core.f(e, "y") : F32}
      arms.Run.bombs_burst.if20(Bool.not(J.is_null(reader)), run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual, ax, ay)
    case False{}:
      arms.Run.bombs_burst.k17(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual)

def arms.Run.bombs_burst.if16(_c: Bool, +run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +actual: U32) -> J.Val:
  match _c:
    case True{}:
      +e = {J.set(e, "wits", core.set_u(J.get(e, "wits"), "foe", owner)) : J.Val}
      arms.Run.bombs_burst.if18(U32.is_zero(core.u(e, "hp")), run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual)
    case False{}:
      arms.Run.bombs_burst.k12(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e)

def arms.Run.bombs_burst.k15(+run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +actual: U32) -> J.Val:
  arms.Run.bombs_burst.if16(Bool.and(U32.is_gt(owner, 0), U32.is_gt(actual, 0)), run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual)

def arms.Run.bombs_burst.if21(_c: Bool, +run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +actual: U32) -> J.Val:
  match _c:
    case True{}:
      +run = {hitstop.State.put(run, hitstop.State.request(J.get(run, "hitstop"), J.get(run, "tune"), HitHeavy{})) : J.Val}
      arms.Run.bombs_burst.k15(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual)
    case False{}:
      arms.Run.bombs_burst.k15(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual)

def arms.Run.bombs_burst.k14(+run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +actual: U32) -> J.Val:
  arms.Run.bombs_burst.if21(Bool.and(U32.is_gt(actual, 0), desperate.Enemy.is_boss(e)), run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual)

def arms.Run.bombs_burst.if22(_c: Bool, +run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +actual: U32) -> J.Val:
  match _c:
    case True{}:
      +run = {J.set(run, "feel", feel.Feel.bolt(J.get(run, "feel"), core.f(e, "x"), core.f(e, "y"), False{})) : J.Val}
      +struck = {True{} : Bool}
      arms.Run.bombs_burst.k14(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual)
    case False{}:
      arms.Run.bombs_burst.k14(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual)

def arms.Run.bombs_burst.if13(_c: Bool, +run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val) -> J.Val:
  match _c:
    case True{}:
      +actual = {U32.min(blast, core.u(e, "hp")) : U32}
      +e = {core.set_u(e, "hp", core.usub(core.u(e, "hp"), blast)) : J.Val}
      arms.Run.bombs_burst.if22(Bool.and(lightning, U32.is_gt(actual, 0)), run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, actual)
    case False{}:
      arms.Run.bombs_burst.k12(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e)

def arms.Run.bombs_burst.k11(+run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +skip: Bool) -> J.Val:
  arms.Run.bombs_burst.if13(Bool.not(skip), run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e)

def arms.Run.bombs_burst.k24(+run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +skip: Bool, +reachable: Bool) -> J.Val:
  +skip = {Bool.not(reachable) : Bool}
  arms.Run.bombs_burst.k11(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, skip)

def arms.Run.bombs_burst.if26(_c: Bool, +run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +skip: Bool, +reachable: Bool, +_t25: List<&2, J.Val>) -> J.Val:
  match _c:
    case True{}:
      +reachable = {True{} : Bool}
      arms.Run.bombs_burst.loop25(_t25, run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, skip, reachable)
    case False{}:
      arms.Run.bombs_burst.loop25(_t25, run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, skip, reachable)

def arms.Run.bombs_burst.loop25(+_xs: List<&2, J.Val>, +run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +skip: Bool, +reachable: Bool) -> J.Val:
  match _xs:
    case Nil{}:
      arms.Run.bombs_burst.k24(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, skip, reachable)
    case Con{+c, +_t25}:
      arms.Run.bombs_burst.if26(F32.is_le(RS.f_hypot((core.f(e, "x") - J.f32(J.nth(c, 0)) : F32), (core.f(e, "y") - J.f32(J.nth(c, 1)) : F32)), depths.OPEN_BLAST()), run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, skip, reachable, _t25)

def arms.Run.bombs_burst.if23(_c: Bool, +run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>, +_t10: List<&2, J.Val>, +e: J.Val, +skip: Bool) -> J.Val:
  match _c:
    case True{}:
      +reachable = {False{} : Bool}
      arms.Run.bombs_burst.loop25(centres, run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, skip, reachable)
    case False{}:
      arms.Run.bombs_burst.k11(run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, skip)

def arms.Run.bombs_burst.loop10(+_xs: List<&2, J.Val>, +run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool, +enemies: List<&2, J.Val>) -> J.Val:
  match _xs:
    case Nil{}:
      arms.Run.bombs_burst.k9(run, lightning, struck, enemies)
    case Con{+e, +_t10}:
      +skip = {False{} : Bool}
      arms.Run.bombs_burst.if23(open_map, run, blast, open_map, owner, centres, reader, lightning, struck, enemies, _t10, e, skip)

def arms.Run.bombs_burst.if8(_c: Bool, +run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool) -> J.Val:
  match _c:
    case True{}:
      +enemies = {[] : List<&2, J.Val>}
      arms.Run.bombs_burst.loop10(J.items(J.get(run, "enemies")), run, blast, open_map, owner, centres, reader, lightning, struck, enemies)
    case False{}:
      arms.Run.bombs_burst.k4(run, lightning, struck)

def arms.Run.bombs_burst.k3(+run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool) -> J.Val:
  arms.Run.bombs_burst.if8(U32.is_gt(blast, 0), run, blast, open_map, owner, centres, reader, lightning, struck)

def arms.Run.bombs_burst.if27(_c: Bool, +run: J.Val, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val, +lightning: Bool, +struck: Bool) -> J.Val:
  match _c:
    case True{}:
      +run = {J.set(run, "feel", feel.Feel.bolt(J.get(run, "feel"), core.f(reader, "x"), core.f(reader, "y"), True{})) : J.Val}
      arms.Run.bombs_burst.k3(run, blast, open_map, owner, centres, reader, lightning, struck)
    case False{}:
      arms.Run.bombs_burst.k3(run, blast, open_map, owner, centres, reader, lightning, struck)

def arms.Run.bombs_burst.k2(+run: J.Val, +nova: U32, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val) -> J.Val:
  +lightning = {U32.is_gt(nova, 0) : Bool}
  +struck = {False{} : Bool}
  arms.Run.bombs_burst.if27(Bool.and(lightning, Bool.not(J.is_null(reader))), run, blast, open_map, owner, centres, reader, lightning, struck)

def arms.Run.bombs_burst.if28(_c: Bool, +run: J.Val, +nova: U32, +blast: U32, +open_map: Bool, +owner: U32, +centres: List<&2, J.Val>, +reader: J.Val) -> J.Val:
  match _c:
    case True{}:
      +centres = {List.append(&2, J.Val, centres, [core.pair_f(core.f(reader, "x"), core.f(reader, "y"))]) : List<&2, J.Val>}
      arms.Run.bombs_burst.k2(run, nova, blast, open_map, owner, centres, reader)
    case False{}:
      arms.Run.bombs_burst.k2(run, nova, blast, open_map, owner, centres, reader)

def arms.Run.bombs_burst.k1(+run: J.Val, +sortie: J.Val, +bombs: U32, +booms: J.Val) -> J.Val:
  +nova = {core.u(sortie, "nova") : U32}
  +blast = {(rules.BOMB_DAMAGE() * bombs + nova : U32) : U32}
  +open_map = {depths.Run.open_map(run) : Bool}
  +owner = {core.u(sortie, "blast_owner") : U32}
  +centres = {J.items(booms) : List<&2, J.Val>}
  +reader = {core.hero(run, owner) : J.Val}
  arms.Run.bombs_burst.if28(Bool.and(U32.is_gt(nova, 0), Bool.not(J.is_null(reader))), run, nova, blast, open_map, owner, centres, reader)

def arms.Run.bombs_burst.k30(+run: J.Val, +sortie: J.Val, +bombs: U32, +booms: J.Val, +kept: List<&2, J.Val>) -> J.Val:
  +run = {J.set(run, "projectiles", J.JA{kept}) : J.Val}
  arms.Run.bombs_burst.k1(run, sortie, bombs, booms)

def arms.Run.bombs_burst.if33(_c: Bool, +run: J.Val, +sortie: J.Val, +bombs: U32, +booms: J.Val, +kept: List<&2, J.Val>, +_t31: List<&2, J.Val>, +p: J.Val) -> J.Val:
  match _c:
    case True{}:
      +kept = {List.append(&2, J.Val, kept, [p]) : List<&2, J.Val>}
      arms.Run.bombs_burst.loop31(_t31, run, sortie, bombs, booms, kept)
    case False{}:
      +run = {J.set(run, "feel", feel.Feel.impact(J.get(run, "feel"), core.f(p, "x"), core.f(p, "y"), core.s(p, "kind"), 0.0, 0.0)) : J.Val}
      arms.Run.bombs_burst.loop31(_t31, run, sortie, bombs, booms, kept)

def arms.Run.bombs_burst.k32(+run: J.Val, +sortie: J.Val, +bombs: U32, +booms: J.Val, +kept: List<&2, J.Val>, +_t31: List<&2, J.Val>, +p: J.Val, +keep: Bool) -> J.Val:
  arms.Run.bombs_burst.if33(keep, run, sortie, bombs, booms, kept, _t31, p)

def arms.Run.bombs_burst.if36(_c: Bool, +run: J.Val, +sortie: J.Val, +bombs: U32, +booms: J.Val, +kept: List<&2, J.Val>, +_t31: List<&2, J.Val>, +p: J.Val, +keep: Bool, +_t35: List<&2, J.Val>) -> J.Val:
  match _c:
    case True{}:
      +keep = {False{} : Bool}
      arms.Run.bombs_burst.loop35(_t35, run, sortie, bombs, booms, kept, _t31, p, keep)
    case False{}:
      arms.Run.bombs_burst.loop35(_t35, run, sortie, bombs, booms, kept, _t31, p, keep)

def arms.Run.bombs_burst.loop35(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +bombs: U32, +booms: J.Val, +kept: List<&2, J.Val>, +_t31: List<&2, J.Val>, +p: J.Val, +keep: Bool) -> J.Val:
  match _xs:
    case Nil{}:
      arms.Run.bombs_burst.k32(run, sortie, bombs, booms, kept, _t31, p, keep)
    case Con{+b, +_t35}:
      arms.Run.bombs_burst.if36(F32.is_le(RS.f_hypot((core.f(p, "x") - J.f32(J.nth(b, 0)) : F32), (core.f(p, "y") - J.f32(J.nth(b, 1)) : F32)), rules.BOMB_CLEAR()), run, sortie, bombs, booms, kept, _t31, p, keep, _t35)

def arms.Run.bombs_burst.if34(_c: Bool, +run: J.Val, +sortie: J.Val, +bombs: U32, +booms: J.Val, +kept: List<&2, J.Val>, +_t31: List<&2, J.Val>, +p: J.Val, +keep: Bool) -> J.Val:
  match _c:
    case True{}:
      +keep = {True{} : Bool}
      arms.Run.bombs_burst.loop35(J.items(booms), run, sortie, bombs, booms, kept, _t31, p, keep)
    case False{}:
      arms.Run.bombs_burst.k32(run, sortie, bombs, booms, kept, _t31, p, keep)

def arms.Run.bombs_burst.loop31(+_xs: List<&2, J.Val>, +run: J.Val, +sortie: J.Val, +bombs: U32, +booms: J.Val, +kept: List<&2, J.Val>) -> J.Val:
  match _xs:
    case Nil{}:
      arms.Run.bombs_burst.k30(run, sortie, bombs, booms, kept)
    case Con{+p, +_t31}:
      +keep = {Bool.not(core.b(p, "hostile")) : Bool}
      arms.Run.bombs_burst.if34(Bool.not(keep), run, sortie, bombs, booms, kept, _t31, p, keep)

def arms.Run.bombs_burst.if29(_c: Bool, +run: J.Val, +sortie: J.Val, +bombs: U32, +booms: J.Val) -> J.Val:
  match _c:
    case True{}:
      +kept = {[] : List<&2, J.Val>}
      arms.Run.bombs_burst.loop31(J.items(J.get(run, "projectiles")), run, sortie, bombs, booms, kept)
    case False{}:
      arms.Run.bombs_burst.k1(run, sortie, bombs, booms)
