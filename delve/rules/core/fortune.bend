def fortune.Mode.collapse_secs(+depth: U32) -> U32:
  (120 + 30 * depth : U32)

# The wedges a level of Fortune's ladder opens.

def fortune.open_wedges(+level: U32) -> List<&2, U32>:
  +out = {[] : List<&2, U32>}
  +i = {0 : U32}
  fortune.open_wedges.loop2(level, out, i)

def fortune.open_wedges.k1(+out: List<&2, U32>) -> List<&2, U32>:
  out

def fortune.open_wedges.k4(+level: U32, +out: List<&2, U32>, +i: U32) -> List<&2, U32>:
  +i = {(i + 1 : U32) : U32}
  fortune.open_wedges.loop2(level, out, i)

def fortune.open_wedges.if5(_c: Bool, +level: U32, +out: List<&2, U32>, +i: U32) -> List<&2, U32>:
  match _c:
    case True{}:
      +out = {List.append(&2, U32, out, [i]) : List<&2, U32>}
      fortune.open_wedges.k4(level, out, i)
    case False{}:
      fortune.open_wedges.k4(level, out, i)

def fortune.open_wedges.if3(_c: Bool, +level: U32, +out: List<&2, U32>, +i: U32) -> List<&2, U32>:
  match _c:
    case True{}:
      fortune.open_wedges.if5(U32.is_le(fortune.Mode.rung(fortune.Mode.wheel(i)), level), level, out, i)
    case False{}:
      fortune.open_wedges.k1(out)

def fortune.open_wedges.loop2(+level: U32, +out: List<&2, U32>, +i: U32) -> List<&2, U32>:
  fortune.open_wedges.if3(U32.is_lt(i, 14), level, out, i)

# Turbo: down in the delve, one tick in four comes free, so every three steps

# of play run four ticks of the delve.

def fortune.Run.turbo(+run: J.Val) -> Bool:
  Bool.and(fortune.Run.turbo_on(run), U32.is_eq(W.rem_u32(W.of_j(J.get(run, "tick")), 4), 3))

def fortune.Run.turbo_on(+run: J.Val) -> Bool:
  Bool.and(String.eq(core.s(run, "mode"), "turbo"), U32.is_ne(rules.Run.floor(run), 0))

# Glass Jaw: the knights hit and are hit twice as hard.

def fortune.Run.harden(+run: J.Val) -> J.Val:
  +glass = {String.eq(core.s(run, "mode"), "glass_jaw") : Bool}
  +players = {J.get(run, "players") : J.Val}
  fortune.Run.harden.loop2(J.fields(players), run, glass, players)

def fortune.Run.harden.k1(+run: J.Val, +players: J.Val) -> J.Val:
  J.set(run, "players", players)

def fortune.Run.harden.loop2(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +glass: Bool, +players: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      fortune.Run.harden.k1(run, players)
    case Con{+_h2, +_t2}:
      (+k, +h) = _h2
      +players = {J.set(players, k, core.set_b(h, "glass", glass)) : J.Val}
      fortune.Run.harden.loop2(_t2, run, glass, players)

# No second winds at all (the Pit's Talisman aside).

def fortune.Run.iron(+run: J.Val) -> J.Val:
  fortune.Run.iron.if4(Bool.not(String.eq(core.s(run, "mode"), "ironman")), run)

def fortune.Run.iron.k2(+run: J.Val, +players: J.Val) -> J.Val:
  J.set(run, "players", players)

def fortune.Run.iron.loop3(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +players: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      fortune.Run.iron.k2(run, players)
    case Con{+_h3, +_t3}:
      (+k, +h) = _h3
      +players = {J.set(players, k, core.set_u(h, "winds", 0)) : J.Val}
      fortune.Run.iron.loop3(_t3, run, players)

def fortune.Run.iron.k1(+run: J.Val) -> J.Val:
  +players = {J.get(run, "players") : J.Val}
  fortune.Run.iron.loop3(J.fields(players), run, players)

def fortune.Run.iron.if4(_c: Bool, +run: J.Val) -> J.Val:
  match _c:
    case True{}:
      run
    case False{}:
      fortune.Run.iron.k1(run)

# All Random: every knight's ultimate comes half charged.

def fortune.Run.half_charge(+run: J.Val) -> J.Val:
  fortune.Run.half_charge.if4(Bool.not(String.eq(core.s(run, "mode"), "all_random")), run)

def fortune.Run.half_charge.k2(+run: J.Val, +players: J.Val) -> J.Val:
  J.set(run, "players", players)

def fortune.Run.half_charge.loop3(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +players: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      fortune.Run.half_charge.k2(run, players)
    case Con{+_h3, +_t3}:
      (+k, +h) = _h3
      +players = {J.set(players, k, core.set_u(h, "ult_charge", U32.max(core.u(h, "ult_charge"), U32.div(ults.ULT_FULL(), 2)))) : J.Val}
      fortune.Run.half_charge.loop3(_t3, run, players)

def fortune.Run.half_charge.k1(+run: J.Val) -> J.Val:
  +players = {J.get(run, "players") : J.Val}
  fortune.Run.half_charge.loop3(J.fields(players), run, players)

def fortune.Run.half_charge.if4(_c: Bool, +run: J.Val) -> J.Val:
  match _c:
    case True{}:
      run
    case False{}:
      fortune.Run.half_charge.k1(run)

# `ticks` ticks from now, a Fx::Shake event pushed.

def core.push_shake(+run: J.Val, +ticks: U32) -> J.Val:
  J.set(run, "fx", J.push(J.get(run, "fx"), J.set(J.obj(), "Shake", J.JU{ticks})))

def core.push_cue(+run: J.Val, +cue: String) -> J.Val:
  J.set(run, "cues", J.push(J.get(run, "cues"), J.JS{cue}))

def core.push_sound(+run: J.Val, +sound: String) -> J.Val:
  J.set(run, "sounds", J.push(J.get(run, "sounds"), J.JS{sound}))

# The Collapse: the tick this floor falls in; rocks come down on the living.

def fortune.Run.tick_collapse(+run: J.Val) -> J.Val:
  fortune.Run.tick_collapse.if18(Bool.or(Bool.not(String.eq(core.s(run, "mode"), "collapse")), home.Run.at_home_now(run)), run)

def fortune.Run.tick_collapse.k10(t: W.W & U32, +run: J.Val, +spot: J.Val, +jx: U32) -> J.Val:
  (+rng3, +jy) = t
  +w = {layout.Room.width(rules.Run.room(run)) : F32}
  +h = {layout.Room.height(rules.Run.room(run)) : F32}
  +x = {RS.f_clamp((core.nf(spot, 0) + ((RS.u_as_f32(jx) / 10.0 : F32) - 4.0 : F32) : F32), 3.0, (w - 3.0 : F32)) : F32}
  +y = {RS.f_clamp((core.nf(spot, 1) + ((RS.u_as_f32(jy) / 10.0 : F32) - 4.0 : F32) : F32), 3.0, (h - 3.0 : F32)) : F32}
  +rock = {J.obj() : J.Val}
  +rock = {core.set_f(rock, "x", x) : J.Val}
  +rock = {core.set_f(rock, "y", y) : J.Val}
  +rock = {core.set_u(rock, "fall", hazards.ROCK_FALL()) : J.Val}
  +rock = {core.set_u(rock, "dust", 0) : J.Val}
  +rock = {core.set_b(rock, "ember", False{}) : J.Val}
  +run = {J.set(run, "rng", W.to_j(rng3)) : J.Val}
  J.set(run, "rocks", J.push(J.get(run, "rocks"), rock))

def fortune.Run.tick_collapse.k9(t: W.W & U32, +run: J.Val, +spot: J.Val) -> J.Val:
  (+rng2, +jx) = t
  fortune.Run.tick_collapse.k10(loot.Rng.below(rng2, 81), run, spot, jx)

def fortune.Run.tick_collapse.k8(t: W.W & U32, +run: J.Val, +living: List<&2, J.Val>) -> J.Val:
  (+rng1, +pick) = t
  +spot = {core.or_else(J.nth(J.JA{living}, pick), J.JNull{}) : J.Val}
  fortune.Run.tick_collapse.k9(loot.Rng.below(rng1, 81), run, spot)

def fortune.Run.tick_collapse.k7(+run: J.Val, +living: List<&2, J.Val>) -> J.Val:
  +n = {U32.from_nat(List.length(&2, J.Val, living)) : U32}
  fortune.Run.tick_collapse.k8(loot.Rng.below(W.of_j(J.get(run, "rng")), n), run, living)

def fortune.Run.tick_collapse.if11(_c: Bool, +run: J.Val, +living: List<&2, J.Val>) -> J.Val:
  match _c:
    case True{}:
      run
    case False{}:
      fortune.Run.tick_collapse.k7(run, living)

def fortune.Run.tick_collapse.k6(+run: J.Val, +at: W.W, +tick: W.W, +living: List<&2, J.Val>) -> J.Val:
  +past = {W.div_u32(W.sub(tick, at), rules.HZ()) : W.W}
  +every = {U32.max(core.usub(24, W.lo32(past)), 8) : U32}
  fortune.Run.tick_collapse.if11(Bool.or(U32.is_zero(U32.from_nat(List.length(&2, J.Val, living))), Bool.or(U32.is_ne(W.rem_u32(tick, every), 0), U32.is_ge(core.count(J.get(run, "rocks")), 10))), run, living)

def fortune.Run.tick_collapse.if13(_c: Bool, +run: J.Val, +at: W.W, +tick: W.W, +living: List<&2, J.Val>, +_t12: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +h: J.Val) -> J.Val:
  match _c:
    case True{}:
      +living = {List.append(&2, J.Val, living, [core.pair_f(core.f(h, "x"), core.f(h, "y"))]) : List<&2, J.Val>}
      fortune.Run.tick_collapse.loop12(_t12, run, at, tick, living)
    case False{}:
      fortune.Run.tick_collapse.loop12(_t12, run, at, tick, living)

def fortune.Run.tick_collapse.loop12(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +at: W.W, +tick: W.W, +living: List<&2, J.Val>) -> J.Val:
  match _xs:
    case Nil{}:
      fortune.Run.tick_collapse.k6(run, at, tick, living)
    case Con{+_h12, +_t12}:
      (+k, +h) = _h12
      fortune.Run.tick_collapse.if13(Bool.and(U32.is_ne(core.u(h, "hp"), 0), Bool.not(core.b(h, "stone"))), run, at, tick, living, _t12, h)

def fortune.Run.tick_collapse.k5(+run: J.Val, +at: W.W, +tick: W.W) -> J.Val:
  +living = {[] : List<&2, J.Val>}
  fortune.Run.tick_collapse.loop12(J.int_fields(J.get(run, "players")), run, at, tick, living)

def fortune.Run.tick_collapse.if14(_c: Bool, +run: J.Val, +at: W.W, +tick: W.W) -> J.Val:
  match _c:
    case True{}:
      +run = {core.push_cue(run, "collapse") : J.Val}
      +run = {core.push_shake(run, 20) : J.Val}
      fortune.Run.tick_collapse.k5(run, at, tick)
    case False{}:
      fortune.Run.tick_collapse.k5(run, at, tick)

def fortune.Run.tick_collapse.k4(+run: J.Val, +at: W.W, +tick: W.W) -> J.Val:
  fortune.Run.tick_collapse.if14(W.eq(tick, at), run, at, tick)

def fortune.Run.tick_collapse.if15(_c: Bool, +run: J.Val, +at: W.W, +tick: W.W) -> J.Val:
  match _c:
    case True{}:
      run
    case False{}:
      fortune.Run.tick_collapse.k4(run, at, tick)

def fortune.Run.tick_collapse.k3(+run: J.Val, +at: W.W, +tick: W.W) -> J.Val:
  fortune.Run.tick_collapse.if15(Bool.or(W.lt(tick, at), Bool.not(rules.Run.active(run))), run, at, tick)

def fortune.Run.tick_collapse.if16(_c: Bool, +run: J.Val, +at: W.W, +tick: W.W) -> J.Val:
  match _c:
    case True{}:
      +run = {core.push_cue(run, "collapse_warn") : J.Val}
      fortune.Run.tick_collapse.k3(run, at, tick)
    case False{}:
      fortune.Run.tick_collapse.k3(run, at, tick)

def fortune.Run.tick_collapse.k2(+run: J.Val) -> J.Val:
  +at = {W.of_j(J.get(run, "collapse_at")) : W.W}
  +tick = {W.of_j(J.get(run, "tick")) : W.W}
  +warn = {W.sat_sub(at, W.of_u32((30 * rules.HZ() : U32))) : W.W}
  fortune.Run.tick_collapse.if16(W.eq(tick, warn), run, at, tick)

def fortune.Run.tick_collapse.if17(_c: Bool, +run: J.Val) -> J.Val:
  match _c:
    case True{}:
      run
    case False{}:
      fortune.Run.tick_collapse.k2(run)

def fortune.Run.tick_collapse.k1(+run: J.Val) -> J.Val:
  fortune.Run.tick_collapse.if17(J.is_null(J.get(run, "collapse_at")), run)

def fortune.Run.tick_collapse.if18(_c: Bool, +run: J.Val) -> J.Val:
  match _c:
    case True{}:
      run
    case False{}:
      fortune.Run.tick_collapse.k1(run)

# Whether the Collapse is coming, and in how many seconds.

def fortune.Run.collapse_in(+run: J.Val) -> Maybe<&2, U32>:
  fortune.Run.collapse_in.if4(Bool.or(J.is_null(J.get(run, "collapse_at")), Bool.not(String.eq(core.s(run, "mode"), "collapse"))), run)

def fortune.Run.collapse_in.k2(+run: J.Val) -> Maybe<&2, U32>:
  Some{W.lo32(W.div_u32(W.sat_sub(W.of_j(J.get(run, "collapse_at")), W.of_j(J.get(run, "tick"))), rules.HZ()))}

def fortune.Run.collapse_in.if3(_c: Bool, +run: J.Val) -> Maybe<&2, U32>:
  match _c:
    case True{}:
      None{}
    case False{}:
      fortune.Run.collapse_in.k2(run)

def fortune.Run.collapse_in.k1(+run: J.Val) -> Maybe<&2, U32>:
  fortune.Run.collapse_in.if3(home.Run.at_home_now(run), run)

def fortune.Run.collapse_in.if4(_c: Bool, +run: J.Val) -> Maybe<&2, U32>:
  match _c:
    case True{}:
      None{}
    case False{}:
      fortune.Run.collapse_in.k1(run)
