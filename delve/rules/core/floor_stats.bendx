# crates/delve/src/rules/floor_stats.rs — a floor's results: what each knight did on it,
# the honours it earned, and the wish that did the most. A `Tally` is its J object
# {began, knights: {id: Line}, wishes: [Wished], pace: {id: [dealt, fought]}, purse: {id: gold}}.
# u128 sums are done in u64 words: exact while damage x ticks x 100 stays under 2^64.

def floor_stats.Line.default() -> J.Val:
    l: J.Val = J.obj()
    l = core.set_u(l, "kills", 0)
    l = core.set_u(l, "damage", 0)
    l = core.set_u(l, "taken", 0)
    l = core.set_u(l, "shots", 0)
    l = core.set_u(l, "hits", 0)
    l = core.set_u(l, "falls", 0)
    l = core.set_u(l, "raised", 0)
    l = core.set_u(l, "gold", 0)
    return core.set_u(l, "fought", 0)

# The aim in percent, if any shots were loosed.
def floor_stats.Line.aim(l: J.Val) -> U32?:
    shots: U32 = core.u(l, "shots")
    if U32.is_zero(shots):
        return None{}
    return Some{U32.min(U32.div((U32.min(core.u(l, "hits"), shots) * 100 : U32), shots), 100)}

# `tally.knights[id]`, or an empty line.
def floor_stats.Tally.line(tally: J.Val, id: U32) -> J.Val:
    l: J.Val = J.get(J.get(tally, "knights"), U32.show(id))
    if J.is_null(l):
        return floor_stats.Line.default()
    return l

def floor_stats.Tally.set_line(tally: J.Val, id: U32, l: J.Val) -> J.Val:
    return J.set(tally, "knights", J.set(J.get(tally, "knights"), U32.show(id), l))

# `line.<key> += n`, saturating.
def floor_stats.Tally.bump(tally: J.Val, id: U32, key: String, n: U32) -> J.Val:
    l: J.Val = floor_stats.Tally.line(tally, id)
    return floor_stats.Tally.set_line(tally, id, core.set_u(l, key, core.uadd(core.u(l, key), n)))

# `pace` of a knight: (damage, fought ticks).
def floor_stats.Tally.pace_of(tally: J.Val, id: U32) -> (W.W, W.W):
    p: J.Val = J.get(J.get(tally, "pace"), U32.show(id))
    return (W.of_j(J.nth(p, 0)), W.of_j(J.nth(p, 1)))

# One knight's dealt damage counted, and whether they stood in a fight.
def floor_stats.Tally.count(tally: J.Val, id: U32, dealt: U32, fighting: Bool) -> J.Val:
    fought: U32 = Bool.to_u32(fighting)
    l: J.Val = floor_stats.Tally.line(tally, id)
    l = core.set_u(l, "damage", core.uadd(core.u(l, "damage"), dealt))
    l = core.set_u(l, "fought", core.uadd(core.u(l, "fought"), fought))
    tally = floor_stats.Tally.set_line(tally, id, l)
    (pd: W.W, pt: W.W) = floor_stats.Tally.pace_of(tally, id)
    pace: J.Val = J.JA{[W.to_j(W.add_u32(pd, dealt)), W.to_j(W.add_u32(pt, fought))]}
    tally = J.set(tally, "pace", J.set(J.get(tally, "pace"), U32.show(id), pace))
    # The latest wish this knight made takes the damage from here on.
    ws: [J.Val] = J.items(J.get(tally, "wishes"))
    n: U32 = U32.from_nat(List.length(&2, J.Val, ws))
    i: U32 = n
    while U32.is_gt(i, 0):
        i = (i - 1 : U32)
        w: J.Val = core.or_else(J.nth(J.JA{ws}, i), J.JNull{})
        if U32.is_eq(core.u(w, "knight"), id):
            a: J.Val = J.get(w, "after")
            w = J.set(w, "after", J.JA{[W.to_j(W.add_u32(W.of_j(J.nth(a, 0)), dealt)), W.to_j(W.add_u32(W.of_j(J.nth(a, 1)), fought))]})
            tally = J.set(tally, "wishes", J.set_nth(J.get(tally, "wishes"), i, w))
            break
    return tally

# A wish named for a knight: joins the last one if it is still settling.
def floor_stats.Tally.wished(tally: J.Val, id: U32, name: String) -> J.Val:
    pace: J.Val = J.get(J.get(tally, "pace"), U32.show(id))
    pace = core.or_else(pace, J.JA{[J.JU{0}, J.JU{0}]})
    full: Bool = U32.is_ge(core.count(J.get(tally, "wishes")), floor_stats.WISHES())
    ws: [J.Val] = J.items(J.get(tally, "wishes"))
    i: U32 = U32.from_nat(List.length(&2, J.Val, ws))
    while U32.is_gt(i, 0):
        i = (i - 1 : U32)
        w: J.Val = core.or_else(J.nth(J.JA{ws}, i), J.JNull{})
        if U32.is_eq(core.u(w, "knight"), id):
            if W.lt(W.of_j(J.nth(J.get(w, "after"), 1)), floor_stats.SETTLE()):
                if U32.is_lt(core.count(J.get(w, "names")), 4):
                    w = J.set(w, "names", J.push(J.get(w, "names"), J.JS{name}))
                    return J.set(tally, "wishes", J.set_nth(J.get(tally, "wishes"), i, w))
                return tally
            break
    if full:
        return tally
    fresh: J.Val = J.obj()
    fresh = core.set_u(fresh, "knight", id)
    fresh = J.set(fresh, "names", J.JA{[J.JS{name}]})
    fresh = J.set(fresh, "before", pace)
    fresh = J.set(fresh, "after", J.JA{[J.JU{0}, J.JU{0}]})
    return J.set(tally, "wishes", J.push(J.get(tally, "wishes"), fresh))

def floor_stats.Tally.next_floor(tally: J.Val, tick: W.W) -> J.Val:
    tally = J.set(tally, "began", W.to_j(tick))
    tally = J.set(tally, "knights", J.obj())
    return J.set(tally, "wishes", J.JA{Nil{}})

def floor_stats.Tally.new_delve(tally: J.Val, tick: W.W) -> J.Val:
    t: J.Val = J.obj()
    t = J.set(t, "began", W.to_j(tick))
    t = J.set(t, "knights", J.obj())
    t = J.set(t, "wishes", J.JA{Nil{}})
    t = J.set(t, "pace", J.obj())
    return J.set(t, "purse", core.or_else(J.get(tally, "purse"), J.obj()))


# i64 as two's complement words: positive means above zero.
def core.i64_pos(x: W.W) -> Bool:
    return Bool.and(Bool.not(W.is_zero(x)), U32.is_lt(W.hi32(x), 2147483648))

# `Wished::impact`: (extra damage over the old pace, gain in percent), if measured.
def floor_stats.Wished.impact(w: J.Val) -> (W.W, W.W)?:
    bd: W.W = W.of_j(J.nth(J.get(w, "before"), 0))
    bt: W.W = W.of_j(J.nth(J.get(w, "before"), 1))
    ad: W.W = W.of_j(J.nth(J.get(w, "after"), 0))
    at: W.W = W.of_j(J.nth(J.get(w, "after"), 1))
    if Bool.or(W.lt(bt, floor_stats.SETTLE()), Bool.or(W.lt(at, floor_stats.SETTLE()), W.is_zero(bd))):
        return None{}
    expected: W.W = W.div(W.mul(bd, at), bt)
    gain: W.W = W.sub(W.div(W.mul(W.mul(ad, bt), W.of_u32(100)), W.mul(bd, at)), W.of_u32(100))
    return Some{(W.sub(ad, expected), gain)}

# The wish's name: its words joined.
def floor_stats.Wished.name(w: J.Val) -> String:
    names: [J.Val] = J.items(J.get(w, "names"))
    n: U32 = U32.from_nat(List.length(&2, J.Val, names))
    if U32.is_zero(n):
        return ""
    out: String = J.str(core.or_else(J.nth(J.JA{names}, 0), J.JNull{}))
    i: U32 = 1
    while U32.is_lt(i, n):
        sep: String = Bool.pick(String, U32.is_eq(i, (n - 1 : U32)), " and ", ", ")
        out = String.append(String.append(out, sep), J.str(J.nth(J.JA{names}, i)))
        i = (i + 1 : U32)
    return out

# `Hero::shown_name`: the player's name, or the knight's when it is a placeholder.
def knights.Hero.shown_name(h: J.Val) -> String:
    name: String = core.s(h, "name")
    if Bool.or(String.is_empty(String.trim(name)), knights.unnamed(String.trim(name))):
        match (knights.Hero.knight_name(h) : String?):
            case Some{k: String}:
                return k
            case None{}:
                return name
    return name

# "you", "host" (any case) and "Knight <n>" stand for no name at all.
def knights.unnamed(p: String) -> Bool:
    lower: String = String.to_lower(p)
    if Bool.or(String.eq(lower, "you"), String.eq(lower, "host")):
        return True{}
    if String.starts_with(p, "Knight "):
        match (U32.read(String.drop(p, 7n)) : U32?):
            case Some{n: U32}:
                return True{}
            case None{}:
                return False{}
    return False{}

# `Results::of`'s rows: one per knight that is here.
def floor_stats.rows(tally: J.Val, players: [(String, J.Val)]) -> [J.Val]:
    rows: [J.Val] = []
    for (k: String, h: J.Val) in players:
        if Bool.not(core.b(h, "absent")):
            r: J.Val = J.obj()
            r = core.set_u(r, "id", rules.Run.step.id(k))
            r = core.set_s(r, "name", knights.Hero.shown_name(h))
            r = J.set(r, "line", floor_stats.Tally.line(tally, rules.Run.step.id(k)))
            r = J.set(r, "honours", J.JA{Nil{}})
            rows = List.append(&2, J.Val, rows, [r])
    return rows

# The value an honour ranks on, for a row: None when the row cannot take it.
def floor_stats.honour_value(kind: String, l: J.Val) -> W.W?:
    if String.eq(kind, "most_kills"):
        return Some{W.of_u32(core.u(l, "kills"))}
    if String.eq(kind, "hardest_hitter"):
        return Some{W.of_u32(core.u(l, "damage"))}
    if String.eq(kind, "sharpshooter"):
        match (floor_stats.Line.aim(l) : U32?):
            case Some{a: U32}:
                if Bool.and(U32.is_ge(core.u(l, "shots"), floor_stats.AIMED()), U32.is_ge(a, floor_stats.TRUE_AIM())):
                    return Some{W.of_u32(a)}
                return None{}
            case None{}:
                return None{}
    if String.eq(kind, "untouched"):
        if Bool.and(U32.is_zero(core.u(l, "taken")), W.ge(W.of_u32(core.u(l, "fought")), floor_stats.SETTLE())):
            return Some{W.of_u32(1)}
        return None{}
    if String.eq(kind, "lifesaver"):
        return Some{W.of_u32(core.u(l, "raised"))}
    return Some{W.of_u32(core.u(l, "gold"))}

# The best value among rows (> 0), if any.
def floor_stats.best(kind: String, rows: [J.Val]) -> W.W?:
    best: W.W = W.zero()
    found: Bool = False{}
    for r: J.Val in rows:
        match (floor_stats.honour_value(kind, J.get(r, "line")) : W.W?):
            case Some{v: W.W}:
                if W.gt(v, best):
                    best = v
                    found = True{}
            case None{}:
                found = found
    if found:
        return Some{best}
    return None{}

# Each honour goes to whoever tops it, ties shared; the "most" honours only in a party.
def floor_stats.award(kind: String, rows: [J.Val], party: U32, alone: Bool) -> [J.Val]:
    if Bool.and(U32.is_lt(party, 2), Bool.not(alone)):
        return rows
    match (floor_stats.best(kind, rows) : W.W?):
        case Some{best: W.W}:
            out: [J.Val] = []
            for r: J.Val in rows:
                match (floor_stats.honour_value(kind, J.get(r, "line")) : W.W?):
                    case Some{v: W.W}:
                        if W.eq(v, best):
                            r = J.set(r, "honours", J.push(J.get(r, "honours"), J.JS{kind}))
                    case None{}:
                        r = r
                out = List.append(&2, J.Val, out, [r])
            return out
        case None{}:
            return rows

# `share`: part of a whole, in thousandths.
def floor_stats.share(part: U32, whole: W.W) -> W.W:
    if W.is_zero(whole):
        return W.zero()
    return W.div(W.mul(W.of_u32(part), W.of_u32(1000)), whole)

# The row of the knight with the biggest share of the floor, or None.
def floor_stats.mvp(rows: [J.Val]) -> U32?:
    kills: W.W = W.zero()
    damage: W.W = W.zero()
    raised: W.W = W.zero()
    for r: J.Val in rows:
        l: J.Val = J.get(r, "line")
        kills = W.add_u32(kills, core.u(l, "kills"))
        damage = W.add_u32(damage, core.u(l, "damage"))
        raised = W.add_u32(raised, core.u(l, "raised"))
    best_score: W.W = W.zero()
    best_damage: U32 = 0
    best_id: U32 = 0
    found: Bool = False{}
    for r: J.Val in rows:
        l: J.Val = J.get(r, "line")
        score: W.W = W.add(W.add(floor_stats.share(core.u(l, "kills"), kills), floor_stats.share(core.u(l, "damage"), damage)), W.div_u32(floor_stats.share(core.u(l, "raised"), raised), 2))
        id: U32 = core.u(r, "id")
        d: U32 = core.u(l, "damage")
        # (score, damage, Reverse(id)): the biggest score, then damage, then the lowest id.
        better: Bool = False{}
        if W.gt(score, best_score):
            better = True{}
        elif W.eq(score, best_score):
            if U32.is_gt(d, best_damage):
                better = True{}
            elif U32.is_eq(d, best_damage):
                better = Bool.and(found, U32.is_lt(id, best_id))
        if Bool.and(Bool.not(W.is_zero(score)), Bool.or(better, Bool.not(found))):
            best_score = score
            best_damage = d
            best_id = id
            found = True{}
    if found:
        return Some{best_id}
    return None{}

# `impact(tally, players)`: the wish that did the most, as an Impact object, or null.
def floor_stats.impact(tally: J.Val, players: J.Val) -> J.Val:
    best_extra: W.W = W.zero()
    best_gain: W.W = W.zero()
    best: J.Val = J.JNull{}
    held: J.Val = J.JNull{}
    held_dmg: W.W = W.zero()
    for w: J.Val in J.items(J.get(tally, "wishes")):
        who: J.Val = J.get(players, U32.show(core.u(w, "knight")))
        if Bool.and(Bool.not(J.is_null(who)), Bool.not(core.b(who, "absent"))):
            match (floor_stats.Wished.impact(w) : (W.W, W.W)?):
                case Some{pair: (W.W, W.W)}:
                    (extra: W.W, gain: W.W) = pair
                    if Bool.and(core.i64_pos(extra), core.i64_pos(gain)):
                        # max_by_key keeps the last of equal keys
                        if Bool.or(J.is_null(best), W.ge(extra, best_extra)):
                            best = w
                            best_extra = extra
                            best_gain = gain
                case None{}:
                    best = best
            ad: W.W = W.of_j(J.nth(J.get(w, "after"), 0))
            if Bool.and(Bool.not(W.is_zero(ad)), Bool.or(J.is_null(held), W.ge(ad, held_dmg))):
                held = w
                held_dmg = ad
    if Bool.not(J.is_null(best)):
        return floor_stats.impact_of(best, players, W.to_j(W.min(best_extra, W.of_u32(4294967295))), W.to_j(W.min(best_gain, W.of_u32(4294967295))))
    if J.is_null(held):
        return J.JNull{}
    return floor_stats.impact_of(held, players, W.to_j(W.min(held_dmg, W.of_u32(4294967295))), J.JNull{})

def floor_stats.impact_of(w: J.Val, players: J.Val, damage: J.Val, gain: J.Val) -> J.Val:
    who: J.Val = J.get(players, U32.show(core.u(w, "knight")))
    name: String = ""
    if Bool.not(J.is_null(who)):
        name = knights.Hero.shown_name(who)
    i: J.Val = J.obj()
    i = core.set_u(i, "knight", core.u(w, "knight"))
    i = core.set_s(i, "name", name)
    i = core.set_s(i, "wish", floor_stats.Wished.name(w))
    i = J.set(i, "damage", damage)
    return J.set(i, "gain", gain)

# `Results::of`: the tally closed.
def floor_stats.Results.of(tally: J.Val, players: J.Val, depth: U32, end: String, tick: W.W) -> J.Val:
    rows: [J.Val] = floor_stats.rows(tally, J.int_fields(players))
    party: U32 = U32.from_nat(List.length(&2, J.Val, rows))
    rows = floor_stats.award("most_kills", rows, party, False{})
    rows = floor_stats.award("hardest_hitter", rows, party, False{})
    rows = floor_stats.award("sharpshooter", rows, party, True{})
    rows = floor_stats.award("untouched", rows, party, True{})
    rows = floor_stats.award("lifesaver", rows, party, True{})
    rows = floor_stats.award("deep_pockets", rows, party, False{})
    mvp: J.Val = J.JNull{}
    if U32.is_ge(party, 2):
        match (floor_stats.mvp(rows) : U32?):
            case Some{id: U32}:
                mvp = J.JU{id}
            case None{}:
                mvp = J.JNull{}
    r: J.Val = J.obj()
    r = core.set_u(r, "depth", depth)
    r = core.set_s(r, "end", end)
    r = J.set(r, "ticks", W.to_j(W.sat_sub(tick, W.of_j(J.get(tally, "began")))))
    r = J.set(r, "rows", J.JA{rows})
    r = J.set(r, "mvp", mvp)
    r = J.set(r, "wish", floor_stats.impact(tally, players))
    r = J.set(r, "at", W.to_j(tick))
    return core.set_u(r, "stood", 0)

# Count what each knight dealt this tick (`dealt`: {id: damage}) and the gold they picked up.
def floor_stats.Run.tally_floor(run: J.Val, dealt: J.Val) -> J.Val:
    if Bool.or(U32.is_zero(rules.Run.floor(run)), Bool.not(rules.Run.active(run))):
        return run
    fighting: Bool = depths.Run.fight_on(run)
    tally: J.Val = J.get(run, "floor_tally")
    for (k: String, h: J.Val) in J.int_fields(J.get(run, "players")):
        if Bool.not(core.b(h, "absent")):
            id: U32 = rules.Run.step.id(k)
            standing: Bool = Bool.and(U32.is_ne(core.u(h, "hp"), 0), Bool.not(core.b(h, "away")))
            tally = floor_stats.Tally.count(tally, id, core.u(dealt, k), Bool.and(fighting, standing))
            gold: U32 = realm.Spoils.get(J.get(h, "carried"), "gold")
            purse: J.Val = J.get(tally, "purse")
            was: U32 = gold
            if J.has(purse, k):
                was = core.u(purse, k)
            tally = J.set(tally, "purse", core.set_u(purse, k, gold))
            if U32.is_gt(gold, was):
                tally = floor_stats.Tally.bump(tally, id, "gold", (gold - was : U32))
    return J.set(run, "floor_tally", tally)

def floor_stats.Run.close_floor(run: J.Val, end: String) -> J.Val:
    return J.set(run, "floor_results", floor_stats.Results.of(J.get(run, "floor_tally"), J.get(run, "players"), rules.Run.floor(run), end, W.of_j(J.get(run, "tick"))))

def floor_stats.Run.close_run(run: J.Val) -> J.Val:
    if Bool.or(Bool.not(again.Run.over(run)), U32.is_zero(rules.Run.floor(run))):
        return run
    run = floor_stats.Run.close_floor(run, Bool.pick(String, core.phase_is(run, "won"), "won", "fallen"))
    return J.set(run, "floor_results", J.set(J.get(run, "floor_results"), "deeds", J.get(run, "deeds")))

def floor_stats.Run.stand_verdict(run: J.Val) -> J.Val:
    results: J.Val = J.get(run, "floor_results")
    if Bool.and(again.Run.over(run), Bool.and(Bool.not(J.is_null(results)), Bool.not(String.eq(core.s(results, "end"), "cleared")))):
        return J.set(run, "floor_results", core.set_u(results, "stood", core.uadd(core.u(results, "stood"), 1)))
    return run

def floor_stats.Run.verdict_hold(run: J.Val) -> U32:
    results: J.Val = J.get(run, "floor_results")
    deeds: U32 = 0
    if Bool.and(Bool.not(J.is_null(results)), Bool.not(String.eq(core.s(results, "end"), "cleared"))):
        deeds = core.count(J.get(results, "deeds"))
    return (again.VERDICT_HOLD() + Bool.pick(U32, U32.is_ne(deeds, 0), floor_stats.DEEDS_HOLD(), 0) : U32)
