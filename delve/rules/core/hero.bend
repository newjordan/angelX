  hero.Hero.loose_all.if22(Bool.and(String.eq(wp, "crossbow"), U32.is_ge(temper, 3)), h, shots, bonus, arms, temper, wp, dressed, fan, base, angle, ax, ay, pull, count, _t17, lane, traits)

def hero.Hero.loose_all.if23(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +count: U32, +_t17: List<&2, F32>, +lane: F32, +traits: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
