  match _c:
    case True{}:
      +h = {core.set_u(h, "spin", spin.TICKS()) : J.Val}
      hero.Hero.own_keys.k10(h, guarded, mx, my)
    case False{}:
      hero.Hero.own_keys.k10(h, guarded, mx, my)

def hero.Hero.own_keys.if16(_c: Bool, +h: J.Val, +guarded: J.Val, +mx: F32, +my: F32) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +h = {core.set_u(h, "whirl", (core.u(h, "whirl") - 1 : U32)) : J.Val}
      hero.Hero.own_keys.if17(U32.is_zero(core.u(h, "spin")), h, guarded, mx, my)
    case False{}:
      hero.Hero.own_keys.k10(h, guarded, mx, my)

def hero.Hero.own_keys.k9(+h: J.Val, +guarded: J.Val, +mx: F32, +my: F32) -> J.Val & (F32 & (F32 & J.Val)):
  hero.Hero.own_keys.if16(U32.is_gt(core.u(h, "whirl"), 0), h, guarded, mx, my)

def hero.Hero.own_keys.k20(+h: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +rx: F32, +ry: F32) -> J.Val & (F32 & (F32 & J.Val)):
  +h = {core.set_u(h, "dash_ticks", rules.ROLL_TICKS()) : J.Val}
  +h = {core.set_f(core.set_f(h, "dash_x", rx), "dash_y", ry) : J.Val}
  +h = {core.set_u(h, "invulnerable", U32.max(core.u(h, "invulnerable"), (rules.ROLL_TICKS() + 1 : U32))) : J.Val}
  +h = {core.set_u(h, "dash_cooldown", rules.ROLL_REARM()) : J.Val}
  +guarded = {core.set_b(guarded, "rolled", True{}) : J.Val}
  hero.Hero.own_keys.k9(h, guarded, mx, my)

def hero.Hero.own_keys.if22(_c: Bool, +h: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +rx: F32, +ry: F32) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +rx = {mx : F32}
      +ry = {my : F32}
      hero.Hero.own_keys.k20(h, guarded, mx, my, rx, ry)
    case False{}:
      hero.Hero.own_keys.k20(h, guarded, mx, my, rx, ry)

def hero.Hero.own_keys.if21(_c: Bool, +h: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +rx: F32, +ry: F32) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +along = {Bool.pick(F32, F32.is_ne(mx, 0.0), mx, core.f(h, "aim_x")) : F32}
      +rx = {Bool.pick(F32, F32.is_lt(along, 0.0), F32.neg(1.0), 1.0) : F32}
      +ry = {0.0 : F32}
      hero.Hero.own_keys.k20(h, guarded, mx, my, rx, ry)
    case False{}:
      hero.Hero.own_keys.if22(Bool.or(F32.is_ne(mx, 0.0), F32.is_ne(my, 0.0)), h, guarded, mx, my, rx, ry)

def hero.Hero.own_keys.if19(_c: Bool, +h: J.Val, +side: Bool, +guarded: J.Val, +mx: F32, +my: F32) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +rx = {core.f(h, "aim_x") : F32}
      +ry = {core.f(h, "aim_y") : F32}
      hero.Hero.own_keys.if21(side, h, guarded, mx, my, rx, ry)
    case False{}:
      hero.Hero.own_keys.k9(h, guarded, mx, my)

def hero.Hero.own_keys.if25(_c: Bool, +h: J.Val, +guarded: J.Val, +mx: F32, +my: F32) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +h = {core.set_u(h, "spin", spin.TICKS()) : J.Val}
      +h = {core.set_u(h, "dash_cooldown", spin.REARM()) : J.Val}
      +guarded = {core.set_b(guarded, "spun", True{}) : J.Val}
      hero.Hero.own_keys.k9(h, guarded, mx, my)
    case False{}:
      hero.Hero.own_keys.k9(h, guarded, mx, my)

def hero.Hero.own_keys.k27(+h: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +up: Bool) -> J.Val & (F32 & (F32 & J.Val)):
  +h = {core.set_b(h, "walling", Bool.and(up, F32.is_gt(core.f(h, "mana"), 0.0))) : J.Val}
  hero.Hero.own_keys.k9(h, guarded, mx, my)

def hero.Hero.own_keys.if29(_c: Bool, +h: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +up: Bool) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +h = {core.set_b(h, "wall_spent", True{}) : J.Val}
      +guarded = {core.set_b(guarded, "mana_out", True{}) : J.Val}
      hero.Hero.own_keys.k27(h, guarded, mx, my, up)
    case False{}:
      hero.Hero.own_keys.k27(h, guarded, mx, my, up)

def hero.Hero.own_keys.if28(_c: Bool, +h: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +wall: J.Val, +up: Bool) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +guarded = {core.set_b(guarded, "wall_raised", Bool.not(core.b(h, "walling"))) : J.Val}
      +h = {core.set_f(h, "mana", RS.f_max((core.f(h, "mana") - (RS.u_as_f32(core.u(wall, "drain")) * rules.DT() : F32) : F32), 0.0)) : J.Val}
      +h = {core.set_u(h, "mana_rest", 0) : J.Val}
      hero.Hero.own_keys.if29(F32.is_le(core.f(h, "mana"), 0.0), h, guarded, mx, my, up)
    case False{}:
      hero.Hero.own_keys.k27(h, guarded, mx, my, up)

def hero.Hero.own_keys.k26(+h: J.Val, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +wall: J.Val) -> J.Val & (F32 & (F32 & J.Val)):
  +up = {Bool.and(core.b(input, "dash"), Bool.and(Bool.not(core.b(h, "wall_spent")), F32.is_gt(core.f(h, "mana"), 0.0))) : Bool}
  hero.Hero.own_keys.if28(up, h, guarded, mx, my, wall, up)

def hero.Hero.own_keys.if30(_c: Bool, +h: J.Val, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +wall: J.Val) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +h = {core.set_b(h, "wall_spent", False{}) : J.Val}
      hero.Hero.own_keys.k26(h, input, guarded, mx, my, wall)
    case False{}:
      hero.Hero.own_keys.k26(h, input, guarded, mx, my, wall)

def hero.Hero.own_keys.if24(_c: Bool, +h: J.Val, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +guard: J.Val) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      hero.Hero.own_keys.if25(Bool.and(core.b(input, "dash"), Bool.and(U32.is_zero(core.u(h, "dash_cooldown")), U32.is_zero(core.u(h, "spin")))), h, guarded, mx, my)
    case False{}:
      +wall = {J.get(guard, "Wall") : J.Val}
      hero.Hero.own_keys.if30(Bool.not(core.b(input, "dash")), h, input, guarded, mx, my, wall)

def hero.Hero.own_keys.if23(_c: Bool, +h: J.Val, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +guard: J.Val) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +h = {core.set_b(h, "shielding", Bool.and(core.b(input, "dash"), Bool.and(shield_free, U32.is_zero(core.u(J.get(h, "shield_wear"), "down"))))) : J.Val}
      hero.Hero.own_keys.k9(h, guarded, mx, my)
    case False{}:
      hero.Hero.own_keys.if24(gear.guard_is(guard, "spin"), h, input, guarded, mx, my, guard)

def hero.Hero.own_keys.if18(_c: Bool, +h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +guard: J.Val) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      hero.Hero.own_keys.if19(Bool.and(core.b(input, "dash"), Bool.and(U32.is_zero(core.u(h, "dash_cooldown")), U32.is_zero(core.u(h, "dash_ticks")))), h, side, guarded, mx, my)
    case False{}:
      hero.Hero.own_keys.if23(gear.guard_is(guard, "shield"), h, shield_free, input, guarded, mx, my, guard)

def hero.Hero.own_keys.k8(+h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32) -> J.Val & (F32 & (F32 & J.Val)):
  +h = {core.set_b(h, "shielding", False{}) : J.Val}
  +h = {J.set(h, "shield_wear", shield.Wear.rest(J.get(h, "shield_wear"), core.u(h, "max_hp"))) : J.Val}
  +guard = {J.get(h, "guard") : J.Val}
  hero.Hero.own_keys.if18(gear.guard_is(guard, "roll"), h, side, shield_free, input, guarded, mx, my, guard)

def hero.Hero.own_keys.if33(_c: Bool, +h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +h = {core.set_f(core.set_f(h, "aim_x", mx), "aim_y", my) : J.Val}
      hero.Hero.own_keys.k8(h, side, shield_free, input, guarded, mx, my)
    case False{}:
      hero.Hero.own_keys.k8(h, side, shield_free, input, guarded, mx, my)

def hero.Hero.own_keys.if32(_c: Bool, +h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +h = {core.set_f(core.set_f(h, "aim_x", RS.f_signum(mx)), "aim_y", 0.0) : J.Val}
      hero.Hero.own_keys.k8(h, side, shield_free, input, guarded, mx, my)
    case False{}:
      hero.Hero.own_keys.if33(U32.is_ge(core.u(h, "walk_ticks"), rules.TURN_TO_WALK()), h, side, shield_free, input, guarded, mx, my)

def hero.Hero.own_keys.if31(_c: Bool, +h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +ax: F32, +ay: F32) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +h = {core.set_f(core.set_f(h, "aim_x", ax), "aim_y", ay) : J.Val}
      hero.Hero.own_keys.k8(h, side, shield_free, input, guarded, mx, my)
    case False{}:
      hero.Hero.own_keys.if32(Bool.and(side, F32.is_ne(mx, 0.0)), h, side, shield_free, input, guarded, mx, my)

def hero.Hero.own_keys.k7(+h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +ax: F32, +ay: F32, +aiming: Bool) -> J.Val & (F32 & (F32 & J.Val)):
  hero.Hero.own_keys.if31(aiming, h, side, shield_free, input, guarded, mx, my, ax, ay)

def hero.Hero.own_keys.if34(_c: Bool, +h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +ax: F32, +ay: F32, +wx: U32, +wy: U32, +walk_dir: J.Val, +aiming: Bool) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +h = {J.set(h, "walk_dir", J.JA{[J.JU{0}, J.JU{0}]}) : J.Val}
      hero.Hero.own_keys.k7(h, side, shield_free, input, guarded, mx, my, ax, ay, aiming)
    case False{}:
      +h = {J.set(h, "walk_dir", J.JA{[J.of_i32(wx), J.of_i32(wy)]}) : J.Val}
      hero.Hero.own_keys.k7(h, side, shield_free, input, guarded, mx, my, ax, ay, aiming)

def hero.Hero.own_keys.k6(+h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +ax: F32, +ay: F32, +wx: U32, +wy: U32, +walk_dir: J.Val, +aiming: Bool) -> J.Val & (F32 & (F32 & J.Val)):
  hero.Hero.own_keys.if34(aiming, h, side, shield_free, input, guarded, mx, my, ax, ay, wx, wy, walk_dir, aiming)

def hero.Hero.own_keys.if35(_c: Bool, +h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +ax: F32, +ay: F32, +wx: U32, +wy: U32, +walk_dir: J.Val, +aiming: Bool) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +h = {core.set_u(h, "walk_ticks", 0) : J.Val}
      hero.Hero.own_keys.k6(h, side, shield_free, input, guarded, mx, my, ax, ay, wx, wy, walk_dir, aiming)
    case False{}:
      +h = {core.set_u(h, "walk_ticks", core.uadd(core.u(h, "walk_ticks"), 1)) : J.Val}
      hero.Hero.own_keys.k6(h, side, shield_free, input, guarded, mx, my, ax, ay, wx, wy, walk_dir, aiming)

def hero.Hero.own_keys.k5(+h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +ax: F32, +ay: F32, +wx: U32, +wy: U32) -> J.Val & (F32 & (F32 & J.Val)):
  +walk_dir = {J.get(h, "walk_dir") : J.Val}
  +same = {Bool.and(U32.is_eq(wx, core.nu(walk_dir, 0)), U32.is_eq(wy, core.nu(walk_dir, 1))) : Bool}
  +aiming = {Bool.or(F32.is_ne(ax, 0.0), F32.is_ne(ay, 0.0)) : Bool}
  +still = {Bool.and(U32.is_zero(wx), U32.is_zero(wy)) : Bool}
  hero.Hero.own_keys.if35(Bool.or(aiming, Bool.or(still, Bool.not(same))), h, side, shield_free, input, guarded, mx, my, ax, ay, wx, wy, walk_dir, aiming)

def hero.Hero.own_keys.if36(_c: Bool, +h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32, +ax: F32, +ay: F32, +wx: U32, +wy: U32) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +wx = {RS.i_signum(core.u(input, "move_x")) : U32}
      +wy = {RS.i_signum(core.u(input, "move_y")) : U32}
      hero.Hero.own_keys.k5(h, side, shield_free, input, guarded, mx, my, ax, ay, wx, wy)
    case False{}:
      hero.Hero.own_keys.k5(h, side, shield_free, input, guarded, mx, my, ax, ay, wx, wy)

def hero.Hero.own_keys.k4(t: F32 & F32, +h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32) -> J.Val & (F32 & (F32 & J.Val)):
  (+ax, +ay) = t
  +wx = {0 : U32}
  +wy = {0 : U32}
  hero.Hero.own_keys.if36(Bool.not(core.b(h, "stocked")), h, side, shield_free, input, guarded, mx, my, ax, ay, wx, wy)

def hero.Hero.own_keys.k3(+h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32) -> J.Val & (F32 & (F32 & J.Val)):
  hero.Hero.own_keys.k4(rules.unit(RS.i_as_f32(core.u(input, "aim_x")), RS.i_as_f32(core.u(input, "aim_y"))), h, side, shield_free, input, guarded, mx, my)

def hero.Hero.own_keys.k38(t: F32 & F32, +h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32) -> J.Val & (F32 & (F32 & J.Val)):
  (+ux, +uy) = t
  +mx = {ux : F32}
  +my = {uy : F32}
  hero.Hero.own_keys.k3(h, side, shield_free, input, guarded, mx, my)

def hero.Hero.own_keys.if37(_c: Bool, +h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val, +guarded: J.Val, +mx: F32, +my: F32) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      hero.Hero.own_keys.k38(rules.unit(RS.i_as_f32(core.u(input, "move_x")), RS.i_as_f32(core.u(input, "move_y"))), h, side, shield_free, input, guarded, mx, my)
    case False{}:
      hero.Hero.own_keys.k3(h, side, shield_free, input, guarded, mx, my)

def hero.Hero.own_keys.k2(+h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val) -> J.Val & (F32 & (F32 & J.Val)):
  +guarded = {hero.Guarded.default() : J.Val}
  +h = {core.set_u(h, "dash_cooldown", core.usub(core.u(h, "dash_cooldown"), 1)) : J.Val}
  +mx = {0.0 : F32}
  +my = {0.0 : F32}
  hero.Hero.own_keys.if37(Bool.not(core.b(h, "stocked")), h, side, shield_free, input, guarded, mx, my)

def hero.Hero.own_keys.if39(_c: Bool, +h: J.Val, +side: Bool, +shield_free: Bool, +input: J.Val) -> J.Val & (F32 & (F32 & J.Val)):
  match _c:
    case True{}:
      +input = {hero.walk_only(input) : J.Val}
      hero.Hero.own_keys.k2(h, side, shield_free, input)
    case False{}:
      hero.Hero.own_keys.k2(h, side, shield_free, input)

def hero.Hero.own_keys.k1(t: J.Val & J.Val, +h: J.Val, +side: Bool, +shield_free: Bool) -> J.Val & (F32 & (F32 & J.Val)):
  (+h1, +held) = t
  +h = {h1 : J.Val}
  +input = {held : J.Val}
  +h = {core.set_u(h, "flee_ticks", core.usub(core.u(h, "flee_ticks"), 1)) : J.Val}
  hero.Hero.own_keys.if39(U32.is_gt(core.u(h, "flee_ticks"), 0), h, side, shield_free, input)

# The second half: a Fae Dagger's blink lands, then the step this tick takes along

# `walk`, as (dx, dy, speed), and whether it blinked. `pace` is the ground pace

# the caller worked out for the knight (`fx::ground_pace`), `roll_speed` the tune's.

def hero.Hero.own_step(+h: J.Val, +mx: F32, +my: F32, +run: J.Val, +room: J.Val, +barred: Bool) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  +blinked = {U32.is_gt(core.u(h, "blink"), 0) : Bool}
  hero.Hero.own_step.if18(blinked, h, mx, my, run, room, barred, blinked)

def hero.Hero.own_step.k8(+h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  (h, (mx, (my, (pace, blinked))))

def hero.Hero.own_step.if9(_c: Bool, +h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  match _c:
    case True{}:
      (h, (mx, (my, ((pace * rules.WALL_PACE() : F32), blinked))))
    case False{}:
      hero.Hero.own_step.k8(h, mx, my, blinked, pace)

def hero.Hero.own_step.k7(+h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  hero.Hero.own_step.if9(core.b(h, "walling"), h, mx, my, blinked, pace)

def hero.Hero.own_step.if10(_c: Bool, +h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  match _c:
    case True{}:
      (h, (mx, (my, ((pace * rules.SHIELD_PACE() : F32), blinked))))
    case False{}:
      hero.Hero.own_step.k7(h, mx, my, blinked, pace)

def hero.Hero.own_step.k6(+h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  hero.Hero.own_step.if10(core.b(h, "shielding"), h, mx, my, blinked, pace)

def hero.Hero.own_step.if11(_c: Bool, +h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  match _c:
    case True{}:
      (h, (mx, (my, ((pace * spin.PACE() : F32), blinked))))
    case False{}:
      hero.Hero.own_step.k6(h, mx, my, blinked, pace)

def hero.Hero.own_step.k5(+h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  hero.Hero.own_step.if11(U32.is_gt(core.u(h, "spin"), 0), h, mx, my, blinked, pace)

def hero.Hero.own_step.if12(_c: Bool, +h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32, +roll_speed: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  match _c:
    case True{}:
      +h = {core.set_u(h, "dash_ticks", (core.u(h, "dash_ticks") - 1 : U32)) : J.Val}
      +ease = {(0.55 + ((0.45 * RS.u_as_f32(core.u(h, "dash_ticks")) : F32) / RS.u_as_f32(rules.ROLL_TICKS()) : F32) : F32) : F32}
      (h, (core.f(h, "dash_x"), (core.f(h, "dash_y"), ((roll_speed * ease : F32), blinked))))
    case False{}:
      hero.Hero.own_step.k5(h, mx, my, blinked, pace)

def hero.Hero.own_step.k4(+h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32, +roll_speed: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  hero.Hero.own_step.if12(U32.is_gt(core.u(h, "dash_ticks"), 0), h, mx, my, blinked, pace, roll_speed)

def hero.Hero.own_step.k14(+h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32, +roll_speed: F32, +dx: F32, +dy: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  (h, (dx, (dy, ((pace * peasant.SPRINT_PACE() : F32), blinked))))

def hero.Hero.own_step.if15(_c: Bool, +h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32, +roll_speed: F32, +dx: F32, +dy: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  match _c:
    case True{}:
      +dx = {core.f(h, "aim_x") : F32}
      +dy = {core.f(h, "aim_y") : F32}
      hero.Hero.own_step.k14(h, mx, my, blinked, pace, roll_speed, dx, dy)
    case False{}:
      hero.Hero.own_step.k14(h, mx, my, blinked, pace, roll_speed, dx, dy)

def hero.Hero.own_step.if13(_c: Bool, +h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32, +roll_speed: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  match _c:
    case True{}:
      +dx = {mx : F32}
      +dy = {my : F32}
      hero.Hero.own_step.if15(Bool.and(F32.is_eq(mx, 0.0), F32.is_eq(my, 0.0)), h, mx, my, blinked, pace, roll_speed, dx, dy)
    case False{}:
      hero.Hero.own_step.k4(h, mx, my, blinked, pace, roll_speed)

def hero.Hero.own_step.k3(+h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32, +roll_speed: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  hero.Hero.own_step.if13(U32.is_gt(core.u(h, "flee_ticks"), 0), h, mx, my, blinked, pace, roll_speed)

def hero.Hero.own_step.if16(_c: Bool, +h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32, +roll_speed: F32) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  match _c:
    case True{}:
      (h, (mx, (my, (0.0, blinked))))
    case False{}:
      hero.Hero.own_step.k3(h, mx, my, blinked, pace, roll_speed)

def hero.Hero.own_step.k2(+h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32, +roll_speed: F32, +champ: J.Val) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  hero.Hero.own_step.if16(U32.is_gt(core.u(champ, "windup"), 0), h, mx, my, blinked, pace, roll_speed)

def hero.Hero.own_step.if17(_c: Bool, +h: J.Val, +mx: F32, +my: F32, +blinked: Bool, +pace: F32, +roll_speed: F32, +champ: J.Val) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  match _c:
    case True{}:
      +h = {J.set(h, "champ", core.set_u(champ, "haul", (core.u(champ, "haul") - 1 : U32))) : J.Val}
      (h, (core.f(champ, "haul_x"), (core.f(champ, "haul_y"), (champions.HAUL_SPEED(), blinked))))
    case False{}:
      hero.Hero.own_step.k2(h, mx, my, blinked, pace, roll_speed, champ)

def hero.Hero.own_step.k1(+h: J.Val, +mx: F32, +my: F32, +run: J.Val, +blinked: Bool) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  +pace = {fx.ground_pace_of(run, h) : F32}
  +roll_speed = {tune.Tune.roll_speed(J.get(run, "tune")) : F32}
  +champ = {J.get(h, "champ") : J.Val}
  hero.Hero.own_step.if17(U32.is_gt(core.u(champ, "haul"), 0), h, mx, my, blinked, pace, roll_speed, champ)

def hero.Hero.own_step.if18(_c: Bool, +h: J.Val, +mx: F32, +my: F32, +run: J.Val, +room: J.Val, +barred: Bool, +blinked: Bool) -> J.Val & (F32 & (F32 & (F32 & Bool))):
  match _c:
    case True{}:
      +h = {items.blink(h, room, barred) : J.Val}
      hero.Hero.own_step.k1(h, mx, my, run, blinked)
    case False{}:
      hero.Hero.own_step.k1(h, mx, my, run, blinked)

# `Projectile::look_of(card)`: the look a shot takes from a card: its `draw shot`, or its style.

def looks.Projectile.look_of(+card: J.Val) -> J.Val:
  +looks = {J.get(card, "looks") : J.Val}
  looks.Projectile.look_of.if2(Bool.not(J.is_null(J.get(looks, "shot"))), card, looks)

def looks.Projectile.look_of.k1(+looks: J.Val) -> J.Val:
  core.or_else(J.get(looks, "style"), J.JNull{})

def looks.Projectile.look_of.if2(_c: Bool, +card: J.Val, +looks: J.Val) -> J.Val:
  match _c:
    case True{}:
      J.JA{[J.JS{looks.CARD_LOOK()}, J.get(card, "id")]}
    case False{}:
      looks.Projectile.look_of.k1(looks)

# The look the knight's shots take from what they hold: the newest held card that

# dresses shots, else the weapon's card.

def looks.Hero.shot_look(+h: J.Val, +book: J.Val) -> J.Val:
  +deck = {List.reverse(&2, J.Val, J.items(J.get(h, "deck"))) : List<&2, J.Val>}
  looks.Hero.shot_look.loop6(deck, h, book)

def looks.Hero.shot_look.k3() -> J.Val:
  J.JNull{}

def looks.Hero.shot_look.if4(_c: Bool, +cd: J.Val) -> J.Val:
  match _c:
    case True{}:
      looks.Projectile.look_of(cd)
    case False{}:
      looks.Hero.shot_look.k3()

def looks.Hero.shot_look.k2(+book: J.Val, +arm: J.Val) -> J.Val:
  +cd = {cards.Book.get(book, J.str(arm)) : J.Val}
  looks.Hero.shot_look.if4(Bool.and(Bool.not(J.is_null(cd)), cards.Looks.dresses_shots(J.get(cd, "looks"))), cd)

def looks.Hero.shot_look.if5(_c: Bool, +book: J.Val, +arm: J.Val) -> J.Val:
  match _c:
    case True{}:
      J.JNull{}
    case False{}:
      looks.Hero.shot_look.k2(book, arm)

def looks.Hero.shot_look.k1(+h: J.Val, +book: J.Val) -> J.Val:
  +arm = {J.get(h, "arm") : J.Val}
  looks.Hero.shot_look.if5(J.is_null(arm), book, arm)

def looks.Hero.shot_look.if8(_c: Bool, +h: J.Val, +book: J.Val, +_t6: List<&2, J.Val>, +cd: J.Val) -> J.Val:
  match _c:
    case True{}:
      looks.Projectile.look_of(cd)
    case False{}:
      looks.Hero.shot_look.loop6(_t6, h, book)

def looks.Hero.shot_look.if7(_c: Bool, +h: J.Val, +book: J.Val, +_t6: List<&2, J.Val>, +id: J.Val, +cd: J.Val) -> J.Val:
  match _c:
    case True{}:
      looks.Hero.shot_look.if8(Bool.and(String.eq(core.s(cd, "kind"), "hold"), Bool.and(cards.Looks.dresses_shots(J.get(cd, "looks")), Bool.not(dead_wishes.Hero.card_is_dead(h, J.str(id))))), h, book, _t6, cd)
    case False{}:
      looks.Hero.shot_look.loop6(_t6, h, book)

def looks.Hero.shot_look.loop6(+_xs: List<&2, J.Val>, +h: J.Val, +book: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      looks.Hero.shot_look.k1(h, book)
    case Con{+id, +_t6}:
      +cd = {cards.Book.get(book, J.str(id)) : J.Val}
      looks.Hero.shot_look.if7(Bool.not(J.is_null(cd)), h, book, _t6, id, cd)

# Shots of a knight's arm: bonus gifts a shot carries (`ShotTraits::of`).

def projectile.ShotTraits.of(+bonus: J.Val) -> J.Val:
  +t = {projectile.ShotTraits.default() : J.Val}
  +t = {core.set_u(t, "bounce", U32.min(core.u(bonus, "bounce"), 8)) : J.Val}
  +t = {core.set_u(t, "homing", U32.min(core.u(bonus, "homing"), 8)) : J.Val}
  +t = {core.set_u(t, "chain", U32.min(core.u(bonus, "chain"), 8)) : J.Val}
  +t = {core.set_u(t, "mend", U32.min(core.u(bonus, "mend"), 16)) : J.Val}
  +t = {core.set_u(t, "burst", U32.min(core.u(bonus, "burst"), 100)) : J.Val}
  +t = {core.set_u_skip(t, "fork", U32.min(core.u(bonus, "fork"), 3)) : J.Val}
  +t = {core.set_u_skip(t, "fart", U32.min(core.u(bonus, "fart"), 3)) : J.Val}
  +t = {core.set_u_skip(t, "size", U32.min(core.u(bonus, "size"), 3)) : J.Val}
  +t = {core.set_u(t, "knock", U32.min(core.u(bonus, "knock"), 3)) : J.Val}
  +t = {core.set_u(t, "burn", U32.min(core.u(bonus, "burn"), 3)) : J.Val}
  +t = {core.set_u(t, "chill", U32.min(core.u(bonus, "chill"), 3)) : J.Val}
  +t = {core.set_u(t, "poison", U32.min(core.u(bonus, "poison"), 3)) : J.Val}
  +t = {core.set_b_skip(t, "boomerang", U32.is_gt(core.u(bonus, "boomerang"), 0)) : J.Val}
  core.set_u_skip(t, "velocity", U32.min(core.u(bonus, "velocity"), 100))

# Of the shots loosed from `from` on, at most `room` fly: the volley's middle.

def rules.fit_volley(+shots: List<&2, J.Val>, +from: U32, +room: U32) -> List<&2, J.Val>:
  +n = {U32.from_nat(List.length(&2, J.Val, shots)) : U32}
  +loosed = {core.usub(n, from) : U32}
  rules.fit_volley.if2(U32.is_le(loosed, room), shots, from, room, n, loosed)

def rules.fit_volley.k1(+shots: List<&2, J.Val>, +from: U32, +room: U32, +n: U32, +loosed: U32) -> List<&2, J.Val>:
  +cut = {(loosed - room : U32) : U32}
  +keep = {List.take(&2, J.Val, shots, U32.to_nat(core.usub(n, (cut - U32.div(cut, 2) : U32)))) : List<&2, J.Val>}
  +head = {List.take(&2, J.Val, keep, U32.to_nat(from)) : List<&2, J.Val>}
  +tail = {List.drop(&2, J.Val, keep, U32.to_nat((from + U32.div(cut, 2) : U32))) : List<&2, J.Val>}
  List.append(&2, J.Val, head, tail)

def rules.fit_volley.if2(_c: Bool, +shots: List<&2, J.Val>, +from: U32, +room: U32, +n: U32, +loosed: U32) -> List<&2, J.Val>:
  match _c:
    case True{}:
      shots
    case False{}:
      rules.fit_volley.k1(shots, from, room, n, loosed)

# A knight's shot.

def hero.shot(+x: F32, +y: F32, +vx: F32, +vy: F32, +kind: String, +look: J.Val, +damage: U32, +pierce: U32, +ttl: U32, +traits: J.Val) -> J.Val:
  +p = {J.obj() : J.Val}
  +p = {core.set_f(p, "x", x) : J.Val}
  +p = {core.set_f(p, "y", y) : J.Val}
  +p = {core.set_f(p, "vx", vx) : J.Val}
  +p = {core.set_f(p, "vy", vy) : J.Val}
  +p = {core.set_b(p, "hostile", False{}) : J.Val}
  +p = {core.set_s(p, "kind", kind) : J.Val}
  +p = {J.set(p, "look", look) : J.Val}
  +p = {core.set_u(p, "damage", damage) : J.Val}
  +p = {core.set_u(p, "pierce", pierce) : J.Val}
  +p = {J.set(p, "last_hit", J.JNull{}) : J.Val}
  +p = {core.set_b(p, "empowered", False{}) : J.Val}
  +p = {core.set_u(p, "ttl", ttl) : J.Val}
  J.set(p, "traits", traits)

# Everything the arm loosed on a tick it fired: a forged weapon's thrown blade or bolts, else

# the plain arm's shots with every card, temper and volley it carries. The shots go onto

# `shots` and the cooldown is set. (hero, (shots, loosed)); `loosed` is {"Throw": 0},

# {"Bolts": n}, {"Arm": [n, [ax, ay]]}, or null for a forged weapon that neither throws nor shoots.

def hero.Hero.loose(+h: J.Val, +id: U32, +book: J.Val, +burning: Bool, +rng: W.W, +flying: U32, +shots: J.Val) -> J.Val & (J.Val & J.Val):
  +from = {core.count(shots) : U32}
  hero.Hero.loose.k1(hero.Hero.loose_all(h, id, book, burning, rng, shots), flying, from)

def hero.Hero.loose.k2(t: J.Val & J.Val, +flying: U32, +from: U32, +h2: J.Val) -> J.Val & (J.Val & J.Val):
  (+all, +loosed) = t
  +fitted = {rules.fit_volley(J.items(all), from, core.usub(rules.KNIGHT_SHOTS(), flying)) : List<&2, J.Val>}
  (h2, (J.JA{fitted}, loosed))

def hero.Hero.loose.k1(t: J.Val & (J.Val & J.Val), +flying: U32, +from: U32) -> J.Val & (J.Val & J.Val):
  (+h2, rest) = t
  hero.Hero.loose.k2(rest, flying, from, h2)

def hero.Hero.loose_all(+h: J.Val, +id: U32, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val) -> J.Val & (J.Val & J.Val):
  +bonus = {J.get(h, "bonus") : J.Val}
  +owner = {RS.as_u8(id) : U32}
  +weapon = {J.get(h, "forged") : J.Val}
  hero.Hero.loose_all.if30(Bool.not(J.is_null(weapon)), h, book, burning, rng, shots, bonus, owner, weapon)

def hero.Hero.loose_all.k6(+h: J.Val, +shots: J.Val, +ax: F32, +ay: F32, +n: U32) -> J.Val & (J.Val & J.Val):
  (h, (shots, J.set(J.obj(), "Arm", J.JA{[J.JU{n}, core.pair_f(ax, ay)]})))

def hero.Hero.loose_all.loop7(+_xs: List<&2, J.Val>, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +dressed: J.Val, +ax: F32, +ay: F32, +n: U32, +kind: String) -> J.Val & (J.Val & J.Val):
  match _xs:
    case Nil{}:
      hero.Hero.loose_all.k6(h, shots, ax, ay, n)
    case Con{+p, +_t7}:
      +theta = {core.f(p, "theta") : F32}
      +lane = {core.f(p, "lane") : F32}
      +ux = {F32.cos(theta) : F32}
      +uy = {F32.sin(theta) : F32}
      +shot = {hero.shot(((core.f(h, "x") + (ux * 0.6 : F32) : F32) - (ay * lane : F32) : F32), ((core.f(h, "y") + (uy * 0.6 : F32) : F32) + (ax * lane : F32) : F32), (ux * core.f(arms, "speed") : F32), (uy * core.f(arms, "speed") : F32), kind, dressed, hero.Hero.scaled(h, core.u(arms, "damage")), core.sat_add8(core.u(arms, "pierce"), RS.as_u8(core.u(bonus, "pierce"))), core.u(arms, "ttl"), J.get(p, "traits")) : J.Val}
      +shots = {J.push(shots, shot) : J.Val}
      hero.Hero.loose_all.loop7(_t7, h, shots, bonus, arms, dressed, ax, ay, n, kind)

def hero.Hero.loose_all.k5(+h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +dressed: J.Val, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +n: U32, +kind: String) -> J.Val & (J.Val & J.Val):
  hero.Hero.loose_all.loop7(pull, h, shots, bonus, arms, dressed, ax, ay, n, kind)

def hero.Hero.loose_all.if9(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +dressed: J.Val, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +n: U32, +kind: String) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +kind = {"ball" : String}
      hero.Hero.loose_all.k5(h, shots, bonus, arms, dressed, ax, ay, pull, n, kind)
    case False{}:
      hero.Hero.loose_all.k5(h, shots, bonus, arms, dressed, ax, ay, pull, n, kind)

def hero.Hero.loose_all.if8(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +wp: String, +dressed: J.Val, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +n: U32, +kind: String) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +kind = {"bolt" : String}
      hero.Hero.loose_all.k5(h, shots, bonus, arms, dressed, ax, ay, pull, n, kind)
    case False{}:
      hero.Hero.loose_all.if9(String.eq(wp, "handgonne"), h, shots, bonus, arms, dressed, ax, ay, pull, n, kind)

def hero.Hero.loose_all.k4(+h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +wp: String, +dressed: J.Val, +ax: F32, +ay: F32, +pull: List<&2, J.Val>) -> J.Val & (J.Val & J.Val):
  +n = {U32.from_nat(List.length(&2, J.Val, pull)) : U32}
  +kind = {"arrow" : String}
  hero.Hero.loose_all.if8(String.eq(wp, "crossbow"), h, shots, bonus, arms, wp, dressed, ax, ay, pull, n, kind)

def hero.Hero.loose_all.if12(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +wp: String, +dressed: J.Val, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +aarc: F32, +count: U32, +i: U32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +k = {((RS.u_as_f32(i) / RS.u_as_f32(U32.max(core.usub(count, 1), 1)) : F32) - 0.5 : F32) : F32}
      +pull = {List.append(&2, J.Val, pull, [hero.pull((angle + (aarc * k : F32) : F32), 0.0, base)]) : List<&2, J.Val>}
      +i = {(i + 1 : U32) : U32}
      hero.Hero.loose_all.loop11(h, shots, bonus, arms, wp, dressed, base, angle, ax, ay, pull, aarc, count, i)
    case False{}:
      hero.Hero.loose_all.k4(h, shots, bonus, arms, wp, dressed, ax, ay, pull)

def hero.Hero.loose_all.loop11(+h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +wp: String, +dressed: J.Val, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +aarc: F32, +count: U32, +i: U32) -> J.Val & (J.Val & J.Val):
  hero.Hero.loose_all.if12(U32.is_lt(i, count), h, shots, bonus, arms, wp, dressed, base, angle, ax, ay, pull, aarc, count, i)

def hero.Hero.loose_all.if15(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +wp: String, +dressed: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +balls: U32, +harc: F32, +traits: J.Val, +i: U32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +k = {((RS.u_as_f32(i) / RS.u_as_f32(U32.max(core.usub(balls, 1), 1)) : F32) - 0.5 : F32) : F32}
      +pull = {List.append(&2, J.Val, pull, [hero.pull((angle + (harc * k : F32) : F32), 0.0, traits)]) : List<&2, J.Val>}
      +i = {(i + 1 : U32) : U32}
      hero.Hero.loose_all.loop14(h, shots, bonus, arms, wp, dressed, angle, ax, ay, pull, balls, harc, traits, i)
    case False{}:
      hero.Hero.loose_all.k4(h, shots, bonus, arms, wp, dressed, ax, ay, pull)

def hero.Hero.loose_all.loop14(+h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +wp: String, +dressed: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +balls: U32, +harc: F32, +traits: J.Val, +i: U32) -> J.Val & (J.Val & J.Val):
  hero.Hero.loose_all.if15(U32.is_lt(i, balls), h, shots, bonus, arms, wp, dressed, angle, ax, ay, pull, balls, harc, traits, i)

def hero.Hero.loose_all.if21(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +count: U32, +_t17: List<&2, F32>, +lane: F32, +traits: J.Val, +i: U32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +theta = {(angle + (fan * (RS.u_as_f32(i) - (RS.u_as_f32(core.usub(count, 1)) / 2.0 : F32) : F32) : F32) : F32) : F32}
      +pull = {List.append(&2, J.Val, pull, [hero.pull(theta, lane, traits)]) : List<&2, J.Val>}
      +i = {(i + 1 : U32) : U32}
      hero.Hero.loose_all.loop20(h, shots, bonus, arms, temper, wp, dressed, fan, base, angle, ax, ay, pull, count, _t17, lane, traits, i)
    case False{}:
      hero.Hero.loose_all.loop17(_t17, h, shots, bonus, arms, temper, wp, dressed, fan, base, angle, ax, ay, pull, count)

def hero.Hero.loose_all.loop20(+h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +count: U32, +_t17: List<&2, F32>, +lane: F32, +traits: J.Val, +i: U32) -> J.Val & (J.Val & J.Val):
  hero.Hero.loose_all.if21(U32.is_lt(i, count), h, shots, bonus, arms, temper, wp, dressed, fan, base, angle, ax, ay, pull, count, _t17, lane, traits, i)

def hero.Hero.loose_all.k19(+h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +count: U32, +_t17: List<&2, F32>, +lane: F32, +traits: J.Val) -> J.Val & (J.Val & J.Val):
  +i = {0 : U32}
  hero.Hero.loose_all.loop20(h, shots, bonus, arms, temper, wp, dressed, fan, base, angle, ax, ay, pull, count, _t17, lane, traits, i)

def hero.Hero.loose_all.if22(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +count: U32, +_t17: List<&2, F32>, +lane: F32, +traits: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
