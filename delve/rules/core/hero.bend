# What a knight's guard key did on a tick, for the sim to sound out: a J object

# {rolled, spun, wall_raised, mana_out, spin_age: null | n}.

def hero.Guarded.default() -> J.Val:
  +g = {J.obj() : J.Val}
  +g = {core.set_b(g, "rolled", False{}) : J.Val}
  +g = {core.set_b(g, "spun", False{}) : J.Val}
  +g = {core.set_b(g, "wall_raised", False{}) : J.Val}
  +g = {core.set_b(g, "mana_out", False{}) : J.Val}
  J.set(g, "spin_age", J.JNull{})

# Only the walk and the aim keys, the rest of the input blank.

def hero.walk_only(+input: J.Val) -> J.Val:
  +i = {rules.Input.default() : J.Val}
  +i = {J.set(i, "move_x", J.get(input, "move_x")) : J.Val}
  +i = {J.set(i, "move_y", J.get(input, "move_y")) : J.Val}
  +i = {J.set(i, "aim_x", J.get(input, "aim_x")) : J.Val}
  J.set(i, "aim_y", J.get(input, "aim_y"))

