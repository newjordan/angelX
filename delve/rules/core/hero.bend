def hero.Hero.loose_all.loop17(+_xs: List<&2, F32>, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +count: U32) -> J.Val & (J.Val & J.Val):
  match _xs:
    case Nil{}:
      hero.Hero.loose_all.k4(h, shots, bonus, arms, wp, dressed, ax, ay, pull)
    case Con{+lane, +_t17}:
      +traits = {base : J.Val}
      hero.Hero.loose_all.if23(Bool.and(U32.is_ge(temper, 3), F32.is_ne(lane, 0.0)), h, shots, bonus, arms, temper, wp, dressed, fan, base, angle, ax, ay, pull, count, _t17, lane, traits)

def hero.Hero.loose_all.k16(+h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +extra: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +lanes: List<&2, F32>) -> J.Val & (J.Val & J.Val):
  +count = {(1 + extra : U32) : U32}
  hero.Hero.loose_all.loop17(lanes, h, shots, bonus, arms, temper, wp, dressed, fan, base, angle, ax, ay, pull, count)

def hero.Hero.loose_all.if26(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +extra: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +lanes: List<&2, F32>) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +lanes = {[F32.neg(0.55), 0.0, 0.55] : List<&2, F32>}
      hero.Hero.loose_all.k16(h, shots, bonus, arms, temper, extra, wp, dressed, fan, base, angle, ax, ay, pull, lanes)
    case False{}:
