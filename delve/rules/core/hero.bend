def hero.Hero.loose_all.if24(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +extra: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +lanes: List<&2, F32>) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      hero.Hero.loose_all.if25(U32.is_eq(temper, 1), h, shots, bonus, arms, temper, extra, wp, dressed, fan, base, angle, ax, ay, pull, lanes)
    case False{}:
      hero.Hero.loose_all.k16(h, shots, bonus, arms, temper, extra, wp, dressed, fan, base, angle, ax, ay, pull, lanes)

def hero.Hero.loose_all.if13(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +extra: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +ashots: U32, +aarc: F32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +balls = {((ashots + Bool.pick(U32, U32.is_ge(temper, 1), 2, 0) : U32) * (1 + extra : U32) : U32) : U32}
      +harc = {(aarc + (fan * RS.u_as_f32(extra) : F32) : F32) : F32}
      +traits = {core.set_u(base, "bounce", U32.max(core.u(base, "bounce"), Bool.to_u32(U32.is_ge(temper, 2)))) : J.Val}
      +i = {0 : U32}
      hero.Hero.loose_all.loop14(h, shots, bonus, arms, wp, dressed, angle, ax, ay, pull, balls, harc, traits, i)
    case False{}:
      +lanes = {[0.0] : List<&2, F32>}
      hero.Hero.loose_all.if24(String.eq(wp, "bow"), h, shots, bonus, arms, temper, extra, wp, dressed, fan, base, angle, ax, ay, pull, lanes)

def hero.Hero.loose_all.if10(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +extra: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +ashots: U32, +aarc: F32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +count = {(ashots + extra : U32) : U32}
      +i = {0 : U32}
      hero.Hero.loose_all.loop11(h, shots, bonus, arms, wp, dressed, base, angle, ax, ay, pull, aarc, count, i)
    case False{}:
      hero.Hero.loose_all.if13(String.eq(wp, "handgonne"), h, shots, bonus, arms, temper, extra, wp, dressed, fan, base, angle, ax, ay, pull, ashots, aarc)

def hero.Hero.loose_all.k3(+h: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +arms: J.Val, +temper: U32, +volley: Bool, +extra: U32, +wp: String, +dressed: J.Val) -> J.Val & (J.Val & J.Val):
  +fan = {Bool.pick(F32, volley, rules.VOLLEY_FAN(), rules.FAN()) : F32}
  +base = {projectile.ShotTraits.of(bonus) : J.Val}
  +base = {core.set_u(base, "owner", owner) : J.Val}
  +base = {core.set_u_skip(base, "beat", hero.Hero.beat(h)) : J.Val}
  +base = {core.set_u_skip(base, "temper", temper) : J.Val}
  +base = {core.set_b_skip(base, "fire", burning) : J.Val}
  +base = {core.set_b_skip(base, "arm", True{}) : J.Val}
  +base = {core.set_b_skip(base, "stone", String.eq(wp, "stones")) : J.Val}
  +wobble = {((RS.u_as_f32(W.rem_u32(rng, 2001)) / 1000.0 : F32) - 1.0 : F32) : F32}
  +loosed = {core.u(h, "loosed") : U32}
  +angle = {((F32.atan2(core.f(h, "aim_y"), core.f(h, "aim_x")) + (wobble * core.f(arms, "jitter") : F32) : F32) + curios.Hero.curio_veer(h, loosed) : F32) : F32}
  +ax = {F32.cos(angle) : F32}
  +ay = {F32.sin(angle) : F32}
  +pull = {[] : List<&2, J.Val>}
  +ashots = {core.u(arms, "shots") : U32}
  +aarc = {RS.f_to_radians(core.f(arms, "arc")) : F32}
  hero.Hero.loose_all.if10(Bool.or(String.eq(wp, "notes"), String.eq(wp, "stones")), h, shots, bonus, arms, temper, extra, wp, dressed, fan, base, angle, ax, ay, pull, ashots, aarc)

def hero.Hero.loose_all.if29(_c: Bool, +h: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +arms: J.Val, +temper: U32, +volley: Bool, +extra: U32, +wp: String, +dressed: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +dressed = {J.JA{[J.JS{"stone"}, J.JS{"stone"}]} : J.Val}
      hero.Hero.loose_all.k3(h, burning, rng, shots, bonus, owner, arms, temper, volley, extra, wp, dressed)
    case False{}:
      +dressed = {classes.shot_look_of(h) : J.Val}
      hero.Hero.loose_all.k3(h, burning, rng, shots, bonus, owner, arms, temper, volley, extra, wp, dressed)

def hero.Hero.loose_all.if28(_c: Bool, +h: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +arms: J.Val, +temper: U32, +volley: Bool, +extra: U32, +wp: String, +dressed: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +dressed = {J.JA{[J.JS{"gold"}, J.JS{"note"}]} : J.Val}
      hero.Hero.loose_all.k3(h, burning, rng, shots, bonus, owner, arms, temper, volley, extra, wp, dressed)
    case False{}:
      hero.Hero.loose_all.if29(String.eq(wp, "stones"), h, burning, rng, shots, bonus, owner, arms, temper, volley, extra, wp, dressed)

def hero.Hero.loose_all.if27(_c: Bool, +h: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +arms: J.Val, +temper: U32, +volley: Bool, +extra: U32, +wp: String, +dressed: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      hero.Hero.loose_all.if28(String.eq(wp, "notes"), h, burning, rng, shots, bonus, owner, arms, temper, volley, extra, wp, dressed)
    case False{}:
      hero.Hero.loose_all.k3(h, burning, rng, shots, bonus, owner, arms, temper, volley, extra, wp, dressed)

def hero.Hero.loose_all.k2(t: J.Val & Bool, +h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +arms: J.Val, +temper: U32) -> J.Val & (J.Val & J.Val):
  (+h3, +volley) = t
  +h = {h3 : J.Val}
  +extra = {(core.u(bonus, "shots") + Bool.pick(U32, volley, 2, 0) : U32) : U32}
  +wp = {core.s(h, "weapon") : String}
  +dressed = {looks.Hero.shot_look(h, book) : J.Val}
  hero.Hero.loose_all.if27(J.is_null(dressed), h, burning, rng, shots, bonus, owner, arms, temper, volley, extra, wp, dressed)

def hero.Hero.loose_all.k1(+h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val) -> J.Val & (J.Val & J.Val):
  +arms = {loot.Weapon.arms(core.s(h, "weapon")) : J.Val}
  +temper = {U32.min(core.u(h, "temper"), feel.TEMPER_MAX()) : U32}
  +h = {core.set_u(h, "fire_cooldown", hero.Hero.cooldown(h, core.u(arms, "cooldown"))) : J.Val}
  hero.Hero.loose_all.k2(hero.Hero.volley(h), h, book, burning, rng, shots, bonus, owner, weapon, arms, temper)

def hero.Hero.loose_all.k35(+h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +count: U32) -> J.Val & (J.Val & J.Val):
  (h, (shots, J.set(J.obj(), "Bolts", J.JU{count})))

def hero.Hero.loose_all.k38(+h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +bolt: J.Val, +count: U32, +traits: J.Val, +arc: F32, +angle: F32, +speed: F32, +look: J.Val, +i: U32, +theta: F32) -> J.Val & (J.Val & J.Val):
  +shot = {hero.shot((core.f(h, "x") + (F32.cos(theta) * 0.6 : F32) : F32), (core.f(h, "y") + (F32.sin(theta) * 0.6 : F32) : F32), (F32.cos(theta) * speed : F32), (F32.sin(theta) * speed : F32), "bolt", look, hero.Hero.scaled(h, core.u(bolt, "damage")), RS.as_u8(core.u(bonus, "pierce")), RS.f_as_u32(F32.ceil(((core.f(bolt, "range") / speed : F32) * RS.u_as_f32(rules.HZ()) : F32))), traits) : J.Val}
  +shots = {J.push(shots, shot) : J.Val}
  +i = {(i + 1 : U32) : U32}
  hero.Hero.loose_all.loop36(h, book, burning, rng, shots, bonus, owner, weapon, bolt, count, traits, arc, angle, speed, look, i)

def hero.Hero.loose_all.if39(_c: Bool, +h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +bolt: J.Val, +count: U32, +traits: J.Val, +arc: F32, +angle: F32, +speed: F32, +look: J.Val, +i: U32, +theta: F32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +theta = {(angle + (arc * ((RS.u_as_f32(i) / RS.u_as_f32((count - 1 : U32)) : F32) - 0.5 : F32) : F32) : F32) : F32}
      hero.Hero.loose_all.k38(h, book, burning, rng, shots, bonus, owner, weapon, bolt, count, traits, arc, angle, speed, look, i, theta)
    case False{}:
      hero.Hero.loose_all.k38(h, book, burning, rng, shots, bonus, owner, weapon, bolt, count, traits, arc, angle, speed, look, i, theta)

def hero.Hero.loose_all.if37(_c: Bool, +h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +bolt: J.Val, +count: U32, +traits: J.Val, +arc: F32, +angle: F32, +speed: F32, +look: J.Val, +i: U32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +theta = {angle : F32}
      hero.Hero.loose_all.if39(U32.is_gt(count, 1), h, book, burning, rng, shots, bonus, owner, weapon, bolt, count, traits, arc, angle, speed, look, i, theta)
    case False{}:
      hero.Hero.loose_all.k35(h, book, burning, rng, shots, bonus, owner, weapon, count)

def hero.Hero.loose_all.loop36(+h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +bolt: J.Val, +count: U32, +traits: J.Val, +arc: F32, +angle: F32, +speed: F32, +look: J.Val, +i: U32) -> J.Val & (J.Val & J.Val):
  hero.Hero.loose_all.if37(U32.is_lt(i, count), h, book, burning, rng, shots, bonus, owner, weapon, bolt, count, traits, arc, angle, speed, look, i)

def hero.Hero.loose_all.k34(+h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +bolt: J.Val, +count: U32, +traits: J.Val, +arc: F32, +angle: F32, +speed: F32, +look: J.Val) -> J.Val & (J.Val & J.Val):
  +i = {0 : U32}
  hero.Hero.loose_all.loop36(h, book, burning, rng, shots, bonus, owner, weapon, bolt, count, traits, arc, angle, speed, look, i)

def hero.Hero.loose_all.if40(_c: Bool, +h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +bolt: J.Val, +count: U32, +traits: J.Val, +arc: F32, +angle: F32, +speed: F32, +look: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +look = {J.JA{[J.get(weapon, "colour"), J.get(weapon, "shape")]} : J.Val}
      hero.Hero.loose_all.k34(h, book, burning, rng, shots, bonus, owner, weapon, bolt, count, traits, arc, angle, speed, look)
    case False{}:
      hero.Hero.loose_all.k34(h, book, burning, rng, shots, bonus, owner, weapon, bolt, count, traits, arc, angle, speed, look)

def hero.Hero.loose_all.k33(+h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +bolt: J.Val, +loosed: U32, +volley: Bool, +dressed: J.Val, +count: U32, +traits: J.Val, +arc0: F32) -> J.Val & (J.Val & J.Val):
  +fan = {Bool.pick(F32, volley, rules.VOLLEY_FAN(), rules.FAN()) : F32}
  +arc = {RS.f_max(arc0, (fan * RS.u_as_f32(core.usub(count, 1)) : F32)) : F32}
  +angle = {(F32.atan2(core.f(h, "aim_y"), core.f(h, "aim_x")) + curios.Hero.curio_veer(h, loosed) : F32) : F32}
  +speed = {RS.f_max(core.f(bolt, "speed"), cards.FORGED_SPEED()) : F32}
  +look = {dressed : J.Val}
  hero.Hero.loose_all.if40(J.is_null(dressed), h, book, burning, rng, shots, bonus, owner, weapon, bolt, count, traits, arc, angle, speed, look)

def hero.Hero.loose_all.if41(_c: Bool, +h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +bolt: J.Val, +loosed: U32, +volley: Bool, +dressed: J.Val, +count: U32, +traits: J.Val, +spread: J.Val, +arc0: F32) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +arc0 = {RS.f_to_radians(core.f(spread, "arc")) : F32}
      hero.Hero.loose_all.k33(h, book, burning, rng, shots, bonus, owner, weapon, bolt, loosed, volley, dressed, count, traits, arc0)
    case False{}:
      hero.Hero.loose_all.k33(h, book, burning, rng, shots, bonus, owner, weapon, bolt, loosed, volley, dressed, count, traits, arc0)

def hero.Hero.loose_all.k32(+h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +bolt: J.Val) -> J.Val & (J.Val & J.Val):
  +h = {core.set_u(h, "fire_cooldown", hero.Hero.cooldown(h, core.u(bolt, "every"))) : J.Val}
  +loosed = {(core.u(h, "loosed") + 1 : U32) : U32}
  +h = {core.set_u(h, "loosed", loosed) : J.Val}
  +vol = {core.u(bonus, "volley") : U32}
  +volley = {Bool.and(U32.is_gt(vol, 0), U32.is_zero(U32.mod(loosed, vol))) : Bool}
  +dressed = {looks.Hero.shot_look(h, book) : J.Val}
  +count = {(realm.forge.Weapon.shots(weapon) + core.u(bonus, "shots") + Bool.pick(U32, volley, 2, 0) : U32) : U32}
  +traits = {projectile.ShotTraits.of(bonus) : J.Val}
  +traits = {core.set_u(traits, "owner", owner) : J.Val}
  +traits = {core.set_u_skip(traits, "beat", hero.Hero.beat(h)) : J.Val}
  +spread = {J.get(weapon, "spread") : J.Val}
  +arc0 = {0.0 : F32}
  hero.Hero.loose_all.if41(Bool.not(J.is_null(spread)), h, book, burning, rng, shots, bonus, owner, weapon, bolt, loosed, volley, dressed, count, traits, spread, arc0)

def hero.Hero.loose_all.if42(_c: Bool, +h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +bolt: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      (h, (shots, J.JNull{}))
    case False{}:
      hero.Hero.loose_all.k32(h, book, burning, rng, shots, bonus, owner, weapon, bolt)

def hero.Hero.loose_all.k31(+h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val) -> J.Val & (J.Val & J.Val):
  +bolt = {J.get(weapon, "bolt") : J.Val}
  hero.Hero.loose_all.if42(J.is_null(bolt), h, book, burning, rng, shots, bonus, owner, weapon, bolt)

def hero.Hero.loose_all.if43(_c: Bool, +h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val, +throw: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +h = {core.set_u(h, "fire_cooldown", hero.Hero.cooldown(h, core.u(throw, "every"))) : J.Val}
      +h = {core.set_u(h, "swing", 6) : J.Val}
      +h = {core.set_b(h, "sword", False{}) : J.Val}
      +ux = {core.f(h, "aim_x") : F32}
      +uy = {core.f(h, "aim_y") : F32}
      +out = {RS.as_u16(RS.f_as_u32(F32.ceil(((core.f(throw, "range") / rules.BLADE_SPEED() : F32) * RS.u_as_f32(rules.HZ()) : F32)))) : U32}
      +traits = {projectile.ShotTraits.of(bonus) : J.Val}
      +traits = {core.set_u(traits, "back", 1) : J.Val}
      +traits = {core.set_u(traits, "owner", owner) : J.Val}
      +traits = {core.set_u_skip(traits, "beat", hero.Hero.beat(h)) : J.Val}
      +traits = {core.set_u(traits, "out", out) : J.Val}
      +shot = {hero.shot((core.f(h, "x") + (ux * 0.6 : F32) : F32), (core.f(h, "y") + (uy * 0.6 : F32) : F32), (ux * rules.BLADE_SPEED() : F32), (uy * rules.BLADE_SPEED() : F32), "blade", looks.Hero.shot_look(h, book), hero.Hero.scaled(h, core.u(throw, "damage")), 255, (out * 2 + 3 * rules.HZ() : U32), traits) : J.Val}
      (h, (J.push(shots, shot), J.set(J.obj(), "Throw", J.JU{0})))
    case False{}:
      hero.Hero.loose_all.k31(h, book, burning, rng, shots, bonus, owner, weapon)

def hero.Hero.loose_all.if30(_c: Bool, +h: J.Val, +book: J.Val, +burning: Bool, +rng: W.W, +shots: J.Val, +bonus: J.Val, +owner: U32, +weapon: J.Val) -> J.Val & (J.Val & J.Val):
  match _c:
    case True{}:
      +throw = {J.get(weapon, "throw") : J.Val}
      hero.Hero.loose_all.if43(Bool.not(J.is_null(throw)), h, book, burning, rng, shots, bonus, owner, weapon, throw)
    case False{}:
      hero.Hero.loose_all.k1(h, book, burning, rng, shots, bonus, owner, weapon)

def hero.pull(+theta: F32, +lane: F32, +traits: J.Val) -> J.Val:
  J.set(core.set_f(core.set_f(J.obj(), "theta", theta), "lane", lane), "traits", traits)

# Whether walking over `card` takes it.

def hero.Hero.takes(+h: J.Val, +card: J.Val) -> Bool:
  +id = {core.s(card, "id") : String}
  hero.Hero.takes.if22(String.eq(id, "iron-helm"), h, card, id)

def hero.Hero.takes.k7() -> Bool:
  False{}

def hero.Hero.takes.if10(_c: Bool, +h: J.Val, +_t8: List<&2, J.Val>) -> Bool:
  match _c:
    case True{}:
      True{}
    case False{}:
      hero.Hero.takes.loop8(_t8, h)

def hero.Hero.takes.if12(_c: Bool, +h: J.Val, +_t8: List<&2, J.Val>) -> Bool:
  match _c:
    case True{}:
      True{}
    case False{}:
      hero.Hero.takes.loop8(_t8, h)

def hero.Hero.takes.if11(_c: Bool, +h: J.Val, +_t8: List<&2, J.Val>) -> Bool:
  match _c:
    case True{}:
      hero.Hero.takes.if12(U32.is_lt(core.u(h, "bombs"), rules.MAX_BOMBS()), h, _t8)
    case False{}:
      True{}

def hero.Hero.takes.if9(_c: Bool, +h: J.Val, +_t8: List<&2, J.Val>, +e: J.Val) -> Bool:
  match _c:
    case True{}:
      hero.Hero.takes.if10(U32.is_lt(core.u(h, "hp"), core.u(h, "max_hp")), h, _t8)
    case False{}:
      hero.Hero.takes.if11(J.has(e, "bombs"), h, _t8)

def hero.Hero.takes.loop8(+_xs: List<&2, J.Val>, +h: J.Val) -> Bool:
  match _xs:
    case Nil{}:
      hero.Hero.takes.k7()
    case Con{+e, +_t8}:
      hero.Hero.takes.if9(J.has(e, "heal"), h, _t8, e)

def hero.Hero.takes.k6(+h: J.Val, +card: J.Val) -> Bool:
  hero.Hero.takes.loop8(J.items(J.get(card, "effects")), h)

def hero.Hero.takes.k14(+h: J.Val, +card: J.Val, +held: Bool, +free: Bool) -> Bool:
  Bool.and(Bool.not(held), free)

def hero.Hero.takes.if17(_c: Bool, +h: J.Val, +card: J.Val, +id: String, +held: Bool, +free: Bool, +_t15: List<&2, J.Val>) -> Bool:
  match _c:
    case True{}:
      +held = {True{} : Bool}
      hero.Hero.takes.loop15(_t15, h, card, id, held, free)
    case False{}:
      hero.Hero.takes.loop15(_t15, h, card, id, held, free)

def hero.Hero.takes.if16(_c: Bool, +h: J.Val, +card: J.Val, +id: String, +held: Bool, +free: Bool, +_t15: List<&2, J.Val>, +s: J.Val) -> Bool:
  match _c:
    case True{}:
      +free = {True{} : Bool}
      hero.Hero.takes.loop15(_t15, h, card, id, held, free)
    case False{}:
      hero.Hero.takes.if17(String.eq(J.str(s), id), h, card, id, held, free, _t15)

def hero.Hero.takes.loop15(+_xs: List<&2, J.Val>, +h: J.Val, +card: J.Val, +id: String, +held: Bool, +free: Bool) -> Bool:
  match _xs:
    case Nil{}:
      hero.Hero.takes.k14(h, card, held, free)
    case Con{+s, +_t15}:
      hero.Hero.takes.if16(J.is_null(s), h, card, id, held, free, _t15, s)

def hero.Hero.takes.if13(_c: Bool, +h: J.Val, +card: J.Val, +id: String) -> Bool:
  match _c:
    case True{}:
      +held = {False{} : Bool}
      +free = {False{} : Bool}
      hero.Hero.takes.loop15(J.items(J.get(h, "spells")), h, card, id, held, free)
    case False{}:
      hero.Hero.takes.k6(h, card)

def hero.Hero.takes.k5(+h: J.Val, +card: J.Val, +id: String, +kind: String) -> Bool:
  hero.Hero.takes.if13(String.eq(kind, "spell"), h, card, id)

def hero.Hero.takes.if18(_c: Bool, +h: J.Val, +card: J.Val, +id: String, +kind: String) -> Bool:
  match _c:
    case True{}:
      U32.is_lt(core.count(J.get(h, "hand")), cards.HAND())
    case False{}:
      hero.Hero.takes.k5(h, card, id, kind)

def hero.Hero.takes.k4(+h: J.Val, +card: J.Val, +id: String, +kind: String) -> Bool:
  hero.Hero.takes.if18(String.eq(kind, "play"), h, card, id, kind)

def hero.Hero.takes.if19(_c: Bool, +h: J.Val, +card: J.Val, +id: String, +kind: String) -> Bool:
  match _c:
    case True{}:
      Bool.not(String.eq(J.str(J.get(h, "guard_card")), id))
    case False{}:
      hero.Hero.takes.k4(h, card, id, kind)

def hero.Hero.takes.k3(+h: J.Val, +card: J.Val, +id: String, +kind: String) -> Bool:
  hero.Hero.takes.if19(String.eq(kind, "guard"), h, card, id, kind)

def hero.Hero.takes.if20(_c: Bool, +h: J.Val, +card: J.Val, +id: String, +kind: String) -> Bool:
  match _c:
    case True{}:
      True{}
    case False{}:
      hero.Hero.takes.k3(h, card, id, kind)

def hero.Hero.takes.k2(+h: J.Val, +card: J.Val, +id: String) -> Bool:
  +kind = {core.s(card, "kind") : String}
  hero.Hero.takes.if20(Bool.or(String.eq(kind, "hold"), String.eq(kind, "arm")), h, card, id, kind)

def hero.Hero.takes.if21(_c: Bool, +h: J.Val, +card: J.Val, +id: String) -> Bool:
  match _c:
    case True{}:
      Bool.not(core.b(J.get(h, "owned"), "body"))
    case False{}:
      hero.Hero.takes.k2(h, card, id)

def hero.Hero.takes.k1(+h: J.Val, +card: J.Val, +id: String) -> Bool:
  hero.Hero.takes.if21(String.eq(id, "body-armour"), h, card, id)

def hero.Hero.takes.if22(_c: Bool, +h: J.Val, +card: J.Val, +id: String) -> Bool:
  match _c:
    case True{}:
      Bool.not(core.b(J.get(h, "owned"), "helmet"))
    case False{}:
      hero.Hero.takes.k1(h, card, id)

# A take or play card's effects, now. Nova damage is summed into `nova`; `score` gains gold.

# (hero, (score, nova))

def hero.Hero.spend(+h: J.Val, +card: J.Val, +score: U32, +nova: U32) -> J.Val & (U32 & U32):
  +isspell = {String.eq(core.s(card, "kind"), "spell") : Bool}
  hero.Hero.spend.loop2(J.items(J.get(card, "effects")), h, card, score, nova, isspell)

def hero.Hero.spend.k1(+h: J.Val, +score: U32, +nova: U32) -> J.Val & (U32 & U32):
  (h, (score, nova))

def hero.Hero.spend.if13(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +n: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +h = {core.set_u(h, "censer", core.uadd(core.u(h, "censer"), n)) : J.Val}
      hero.Hero.spend.loop3(_t3, h, card, score, nova, isspell, _t2)
    case False{}:
      hero.Hero.spend.loop3(_t3, h, card, score, nova, isspell, _t2)

def hero.Hero.spend.k12(+h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  hero.Hero.spend.if13(String.eq(k, "censer"), h, card, score, nova, isspell, _t2, _t3, n)

def hero.Hero.spend.if14(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +h = {core.set_u(h, "immune", U32.max(core.u(h, "immune"), (n * rules.HZ() : U32))) : J.Val}
      hero.Hero.spend.k12(h, card, score, nova, isspell, _t2, _t3, k, n)
    case False{}:
      hero.Hero.spend.k12(h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.k11(+h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  hero.Hero.spend.if14(String.eq(k, "immune"), h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.if15(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +h = {core.set_u(h, "blink", n) : J.Val}
      hero.Hero.spend.k11(h, card, score, nova, isspell, _t2, _t3, k, n)
    case False{}:
      hero.Hero.spend.k11(h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.k10(+h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  hero.Hero.spend.if15(String.eq(k, "blink"), h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.k17(+h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32, +secs: U32) -> J.Val & (U32 & U32):
  +h = {core.set_u(h, "invulnerable", U32.max(core.u(h, "invulnerable"), (secs * rules.HZ() : U32))) : J.Val}
  +h = {core.set_u(h, "ward_rest", stakes.WARD_REST()) : J.Val}
  hero.Hero.spend.k10(h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.if18(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32, +v2: U32, +secs: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +secs = {core.div_ceil(v2, 3) : U32}
      hero.Hero.spend.k17(h, card, score, nova, isspell, _t2, _t3, k, n, secs)
    case False{}:
      hero.Hero.spend.k17(h, card, score, nova, isspell, _t2, _t3, k, n, secs)

def hero.Hero.spend.if16(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +v2 = {Bool.pick(U32, isspell, spell_upgrades.Hero.spell_power_of(h, core.s(card, "id"), n), n) : U32}
      +early = {String.eq(core.s(h, "stakes"), "early") : Bool}
      +secs = {v2 : U32}
      hero.Hero.spend.if18(Bool.and(U32.is_gt(core.u(h, "ward_rest"), 0), Bool.not(early)), h, card, score, nova, isspell, _t2, _t3, k, n, v2, secs)
    case False{}:
      hero.Hero.spend.k10(h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.k9(+h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  hero.Hero.spend.if16(String.eq(k, "ward"), h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.if19(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +nova = {(nova + Bool.pick(U32, isspell, spell_upgrades.Hero.spell_power_of(h, core.s(card, "id"), n), n) : U32) : U32}
      hero.Hero.spend.k9(h, card, score, nova, isspell, _t2, _t3, k, n)
    case False{}:
      hero.Hero.spend.k9(h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.k8(+h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  hero.Hero.spend.if19(String.eq(k, "nova"), h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.if20(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +h = {core.set_u(h, "max_hp", (core.u(h, "max_hp") + n : U32)) : J.Val}
      +h = {core.set_u(h, "hp", U32.min((core.u(h, "hp") + n : U32), core.u(h, "max_hp"))) : J.Val}
      hero.Hero.spend.k8(h, card, score, nova, isspell, _t2, _t3, k, n)
    case False{}:
      hero.Hero.spend.k8(h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.k7(+h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  hero.Hero.spend.if20(String.eq(k, "max_hp"), h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.if21(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +h = {core.set_u(h, "bombs", U32.min((core.u(h, "bombs") + n : U32), rules.MAX_BOMBS())) : J.Val}
      hero.Hero.spend.k7(h, card, score, nova, isspell, _t2, _t3, k, n)
    case False{}:
      hero.Hero.spend.k7(h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.k6(+h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +n: U32) -> J.Val & (U32 & U32):
  hero.Hero.spend.if21(String.eq(k, "bombs"), h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.if22(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +raw: U32, +n: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +score = {core.uadd(score, raw) : U32}
      hero.Hero.spend.k6(h, card, score, nova, isspell, _t2, _t3, k, n)
    case False{}:
      hero.Hero.spend.k6(h, card, score, nova, isspell, _t2, _t3, k, n)

def hero.Hero.spend.k5(+h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +raw: U32, +n: U32) -> J.Val & (U32 & U32):
  hero.Hero.spend.if22(String.eq(k, "gold"), h, card, score, nova, isspell, _t2, _t3, k, raw, n)

def hero.Hero.spend.k24(t: J.Val & U32, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +raw: U32, +n: U32) -> J.Val & (U32 & U32):
  (+h2, +gained) = t
  +h = {h2 : J.Val}
  hero.Hero.spend.k5(h, card, score, nova, isspell, _t2, _t3, k, raw, n)

def hero.Hero.spend.if23(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +raw: U32, +n: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +amt = {Bool.pick(U32, isspell, spell_upgrades.Hero.spell_power_of(h, core.s(card, "id"), n), n) : U32}
      hero.Hero.spend.k24(stakes.Hero.mend(h, amt, 1), h, card, score, nova, isspell, _t2, _t3, k, raw, n)
    case False{}:
      hero.Hero.spend.k5(h, card, score, nova, isspell, _t2, _t3, k, raw, n)

def hero.Hero.spend.k4(+h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +raw: U32, +n: U32) -> J.Val & (U32 & U32):
  hero.Hero.spend.if23(String.eq(k, "heal"), h, card, score, nova, isspell, _t2, _t3, k, raw, n)

def hero.Hero.spend.k26(+h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +raw: U32, +n: U32, +got: U32) -> J.Val & (U32 & U32):
  +h = {J.set(h, "carried", realm.Spoils.add(J.get(h, "carried"), k, got)) : J.Val}
  hero.Hero.spend.k4(h, card, score, nova, isspell, _t2, _t3, k, raw, n)

def hero.Hero.spend.if27(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +raw: U32, +n: U32, +got: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +got = {curios.Hero.curio_gold(h, raw) : U32}
      hero.Hero.spend.k26(h, card, score, nova, isspell, _t2, _t3, k, raw, n, got)
    case False{}:
      hero.Hero.spend.k26(h, card, score, nova, isspell, _t2, _t3, k, raw, n, got)

def hero.Hero.spend.if25(_c: Bool, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>, +_t3: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +raw: U32, +n: U32) -> J.Val & (U32 & U32):
  match _c:
    case True{}:
      +got = {raw : U32}
      hero.Hero.spend.if27(String.eq(k, "gold"), h, card, score, nova, isspell, _t2, _t3, k, raw, n, got)
    case False{}:
      hero.Hero.spend.k4(h, card, score, nova, isspell, _t2, _t3, k, raw, n)

def hero.Hero.spend.loop3(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool, +_t2: List<&2, J.Val>) -> J.Val & (U32 & U32):
  match _xs:
    case Nil{}:
      hero.Hero.spend.loop2(_t2, h, card, score, nova, isspell)
    case Con{+_h3, +_t3}:
      (+k, +v) = _h3
      +raw = {J.u32(v) : U32}
      +n = {raw : U32}
      hero.Hero.spend.if25(cards.Effect.is_spoil(k), h, card, score, nova, isspell, _t2, _t3, k, raw, n)

def hero.Hero.spend.loop2(+_xs: List<&2, J.Val>, +h: J.Val, +card: J.Val, +score: U32, +nova: U32, +isspell: Bool) -> J.Val & (U32 & U32):
  match _xs:
    case Nil{}:
      hero.Hero.spend.k1(h, score, nova)
    case Con{+e, +_t2}:
      hero.Hero.spend.loop3(J.fields(e), h, card, score, nova, isspell, _t2)
