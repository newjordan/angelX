def hero.Hero.loose_all.if25(_c: Bool, +h: J.Val, +shots: J.Val, +bonus: J.Val, +arms: J.Val, +temper: U32, +extra: U32, +wp: String, +dressed: J.Val, +fan: F32, +base: J.Val, +angle: F32, +ax: F32, +ay: F32, +pull: List<&2, J.Val>, +lanes: List<&2, F32>) -> J.Val & (J.Val & J.Val):
