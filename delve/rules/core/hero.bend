      +traits = {core.set_u(traits, "homing", U32.max(core.u(base, "homing"), 2)) : J.Val}
      hero.Hero.loose_all.k18(h, shots, bonus, arms, temper, wp, dressed, fan, base, angle, ax, ay, pull, count, _t17, lane, traits)
    case False{}:
