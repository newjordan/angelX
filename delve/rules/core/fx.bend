# The tick's start, after a ride has played: what it showed, then the shake eases.

def fx.Run.fade(+run: J.Val) -> J.Val:
  +run = {fx.Run.show_fx(run) : J.Val}
  core.set_u(run, "shake", core.usub(core.u(run, "shake"), 1))

