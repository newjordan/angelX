# Hexes wear off.

def hexer.Run.tick_hexes(+run: J.Val) -> J.Val:
  +players = {J.get(run, "players") : J.Val}
  hexer.Run.tick_hexes.loop2(J.fields(players), run, players)

def hexer.Run.tick_hexes.k1(+run: J.Val, +players: J.Val) -> J.Val:
  J.set(run, "players", players)

def hexer.Run.tick_hexes.loop2(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +players: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      hexer.Run.tick_hexes.k1(run, players)
    case Con{+_h2, +_t2}:
      (+k, +h) = _h2
      +players = {J.set(players, k, core.set_u(h, "hexed", core.usub(core.u(h, "hexed"), 1))) : J.Val}
      hexer.Run.tick_hexes.loop2(_t2, run, players)
