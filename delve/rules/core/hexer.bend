# A hex lands on a knight.

def hexer.Run.hex(+run: J.Val, +id: U32) -> J.Val:
  +h = {core.hero(run, id) : J.Val}
  hexer.Run.hex.if6(J.is_null(h), run, id, h)

def hexer.Run.hex.k3(+run: J.Val) -> J.Val:
  run

def hexer.Run.hex.if4(_c: Bool, +run: J.Val) -> J.Val:
  match _c:
    case True{}:
      +run = {feats.Run.notice(run, "ribbit") : J.Val}
      hexer.Run.hex.k3(run)
    case False{}:
      hexer.Run.hex.k3(run)

def hexer.Run.hex.k2(+run: J.Val, +id: U32, +h: J.Val) -> J.Val:
  +h = {core.set_u(h, "hexed", (hexer.HEX_TICKS() + hexer.HEX_IMMUNE() : U32)) : J.Val}
  +h = {core.set_b(core.set_b(core.set_u(h, "dash_ticks", 0), "shielding", False{}), "walling", False{}) : J.Val}
  +run = {core.set_hero(run, id, h) : J.Val}
  +run = {core.set_u(run, "hexes", core.uadd(core.u(run, "hexes"), 1)) : J.Val}
  +run = {core.push_cue(run, "hexed") : J.Val}
  +run = {core.push_sound(run, "mana_empty") : J.Val}
  +run = {J.set(run, "found", J.JA{[J.get(run, "tick"), J.JU{id}, J.JS{"Ribbit."}]}) : J.Val}
  hexer.Run.hex.if4(U32.is_ge(core.u(run, "hexes"), hexer.RIBBIT()), run)

def hexer.Run.hex.if5(_c: Bool, +run: J.Val, +id: U32, +h: J.Val) -> J.Val:
  match _c:
    case True{}:
      run
    case False{}:
      hexer.Run.hex.k2(run, id, h)

def hexer.Run.hex.k1(+run: J.Val, +id: U32, +h: J.Val) -> J.Val:
  hexer.Run.hex.if5(Bool.or(U32.is_gt(core.u(h, "hexed"), 0), U32.is_gt(core.u(h, "immune"), 0)), run, id, h)

def hexer.Run.hex.if6(_c: Bool, +run: J.Val, +id: U32, +h: J.Val) -> J.Val:
