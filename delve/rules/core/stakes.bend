  (+h2, +gain) = t
  (core.set_u(h2, "leeched", (core.u(h2, "leeched") + gain : U32)), gain)

# Fight, or a boss, or calm.

def stakes.Run.stakes(+run: J.Val) -> String:
  stakes.Run.stakes.if7(U32.is_le(rules.Run.floor(run), 2), run)

def stakes.Run.stakes.k3() -> String:
  "fight"

def stakes.Run.stakes.if5(_c: Bool, +_t4: List<&2, J.Val>) -> String:
  match _c:
    case True{}:
      "boss"
    case False{}:
      stakes.Run.stakes.loop4(_t4)

def stakes.Run.stakes.loop4(+_xs: List<&2, J.Val>) -> String:
  match _xs:
    case Nil{}:
      stakes.Run.stakes.k3()
    case Con{+e, +_t4}:
      stakes.Run.stakes.if5(Bool.and(U32.is_ne(core.u(e, "hp"), 0), desperate.Enemy.is_boss(e)), _t4)

def stakes.Run.stakes.k2(+run: J.Val) -> String:
  stakes.Run.stakes.loop4(J.items(J.get(run, "enemies")))

def stakes.Run.stakes.if6(_c: Bool, +run: J.Val) -> String:
  match _c:
    case True{}:
      "calm"
    case False{}:
      stakes.Run.stakes.k2(run)

def stakes.Run.stakes.k1(+run: J.Val) -> String:
  stakes.Run.stakes.if6(Bool.not(depths.Run.fighting(run)), run)

def stakes.Run.stakes.if7(_c: Bool, +run: J.Val) -> String:
  match _c:
    case True{}:
      "early"
    case False{}:
      stakes.Run.stakes.k1(run)

