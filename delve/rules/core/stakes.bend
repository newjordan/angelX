      +n = {(n + 1 : U32) : U32}
      stakes.Run.party_strength.loop4(_t4, sum, n)
    case False{}:
      stakes.Run.party_strength.loop4(_t4, sum, n)

def stakes.Run.party_strength.loop4(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +sum: F32, +n: U32) -> F32:
