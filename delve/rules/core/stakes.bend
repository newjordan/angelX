  +sum = {0.0 : F32}
  +n = {0 : U32}
  stakes.Run.party_strength.loop4(J.int_fields(J.get(run, "players")), sum, n)

def stakes.Run.party_strength.k2(+sum: F32, +n: U32) -> F32:
  (sum / RS.u_as_f32(n) : F32)

def stakes.Run.party_strength.if3(_c: Bool, +sum: F32, +n: U32) -> F32:
  match _c:
    case True{}:
      1.0
    case False{}:
      stakes.Run.party_strength.k2(sum, n)

def stakes.Run.party_strength.k1(+sum: F32, +n: U32) -> F32:
  stakes.Run.party_strength.if3(U32.is_zero(n), sum, n)

def stakes.Run.party_strength.if5(_c: Bool, +sum: F32, +n: U32, +_t4: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +h: J.Val) -> F32:
  match _c:
