      stakes.Run.party_strength.if5(Bool.and(U32.is_ne(core.u(h, "hp"), 0), Bool.not(core.b(h, "away"))), sum, n, _t4, h)

# Monsters' health from here on, in percent of their base (before the head count).

def stakes.Run.toughness(+run: J.Val) -> U32:
  +depth = {core.u(J.get(run, "dungeon"), "depth") : U32}
  +floor = {stakes.DEPTH_HEALTH((RS.u_clamp(depth, 1, 6) - 1 : U32)) : U32}
  +power = {0.0 : F32}
  stakes.Run.toughness.if2(U32.is_gt(depth, 2), run, floor, power)

def stakes.Run.toughness.k1(+run: J.Val, +floor: U32, +power: F32) -> U32:
  tune.Tune.percent((floor + RS.f_as_u32(power) : U32), tune.Tune.foe_health(J.get(run, "tune")))

def stakes.Run.toughness.if2(_c: Bool, +run: J.Val, +floor: U32, +power: F32) -> U32:
  match _c:
    case True{}:
      +power = {RS.f_clamp(((stakes.Run.party_strength(run) - 1.0 : F32) * stakes.POWER_HEALTH() : F32), 0.0, stakes.POWER_HEALTH_MAX()) : F32}
      stakes.Run.toughness.k1(run, floor, power)
    case False{}:
      stakes.Run.toughness.k1(run, floor, power)

# A guardian's health on top of the floor's, in percent.

def stakes.Run.boss_health(+run: J.Val) -> U32:
  stakes.BOSS_HEALTH((RS.u_clamp(core.u(J.get(run, "dungeon"), "depth"), 1, 6) - 1 : U32))

# What monsters deal, in percent: by floor, by the head count, and a little by the party's strength.

def stakes.Run.pressure(+run: J.Val) -> U32:
  +depth = {core.u(J.get(run, "dungeon"), "depth") : U32}
  +floor = {stakes.DEPTH_HIT((RS.u_clamp(depth, 1, 6) - 1 : U32)) : U32}
  +knights = {RS.u_clamp(rules.Run.party_len(run), 1, 6) : U32}
  +power = {0.0 : F32}
  stakes.Run.pressure.if4(U32.is_gt(depth, 2), run, depth, floor, knights, power)

def stakes.Run.pressure.k2(+run: J.Val, +hit: U32) -> U32:
  tune.Tune.percent(hit, tune.Tune.foe_hit(J.get(run, "tune")))

def stakes.Run.pressure.if3(_c: Bool, +run: J.Val, +floor: U32, +knights: U32, +power: F32, +hit: U32) -> U32:
  match _c:
    case True{}:
      +hit = {U32.div((floor * stakes.EARLY_PARTY_HIT((knights - 1 : U32)) : U32), 100) : U32}
      stakes.Run.pressure.k2(run, hit)
    case False{}:
      +hit = {U32.div(((floor + RS.f_as_u32(power) : U32) * stakes.PARTY_HIT((knights - 1 : U32)) : U32), 100) : U32}
      stakes.Run.pressure.k2(run, hit)

def stakes.Run.pressure.k1(+run: J.Val, +depth: U32, +floor: U32, +knights: U32, +power: F32) -> U32:
  +hit = {0 : U32}
  stakes.Run.pressure.if3(U32.is_le(depth, 2), run, floor, knights, power, hit)

def stakes.Run.pressure.if4(_c: Bool, +run: J.Val, +depth: U32, +floor: U32, +knights: U32, +power: F32) -> U32:
  match _c:
    case True{}:
      +power = {RS.f_clamp(((stakes.Run.party_strength(run) - 1.0 : F32) * stakes.POWER_HIT() : F32), 0.0, stakes.POWER_HIT_MAX()) : F32}
      stakes.Run.pressure.k1(run, depth, floor, knights, power)
    case False{}:
      stakes.Run.pressure.k1(run, depth, floor, knights, power)

# The ward after a hit, in ticks: `HIT_WARD` at its default.

def tune.Tune.hit_ward_ticks(+t: J.Val) -> U32:
  RS.f_as_u32(RS.f_max(RS.f_round((tune.Tune.hit_ward(t) * RS.u_as_f32(rules.HZ()) : F32)), 0.0))

# Once a tick, before anything acts: tell every knight what the moment is worth, and what a hit weighs now.

def stakes.Run.set_stakes(+run: J.Val) -> J.Val:
  +st = {stakes.Run.stakes(run) : String}
  +pressure = {U32.div((stakes.Run.pressure(run) * Bool.pick(U32, String.eq(st, "boss"), stakes.BOSS_HIT(), 100) : U32), 100) : U32}
  +new_second = {U32.is_zero(W.rem_u32(W.of_j(J.get(run, "tick")), rules.HZ())) : Bool}
  +ward = {tune.Tune.hit_ward_ticks(J.get(run, "tune")) : U32}
  +players = {J.get(run, "players") : J.Val}
  stakes.Run.set_stakes.loop2(J.fields(players), run, st, pressure, new_second, ward, players)

def stakes.Run.set_stakes.k1(+run: J.Val, +players: J.Val) -> J.Val:
  J.set(run, "players", players)

def stakes.Run.set_stakes.k3(+run: J.Val, +st: String, +pressure: U32, +new_second: Bool, +ward: U32, +players: J.Val, +_t2: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +h: J.Val) -> J.Val:
  +h = {core.set_u(h, "sipped", core.usub(core.u(h, "sipped"), 1)) : J.Val}
  +h = {core.set_u(h, "ward_rest", core.usub(core.u(h, "ward_rest"), 1)) : J.Val}
  +players = {J.set(players, k, stakes.Hero.fit_hp(h)) : J.Val}
  stakes.Run.set_stakes.loop2(_t2, run, st, pressure, new_second, ward, players)

def stakes.Run.set_stakes.if4(_c: Bool, +run: J.Val, +st: String, +pressure: U32, +new_second: Bool, +ward: U32, +players: J.Val, +_t2: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +h: J.Val) -> J.Val:
  match _c:
    case True{}:
      +h = {core.set_u(h, "passive", 0) : J.Val}
      +h = {core.set_u(h, "leeched", 0) : J.Val}
      stakes.Run.set_stakes.k3(run, st, pressure, new_second, ward, players, _t2, k, h)
    case False{}:
      stakes.Run.set_stakes.k3(run, st, pressure, new_second, ward, players, _t2, k, h)

def stakes.Run.set_stakes.loop2(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +st: String, +pressure: U32, +new_second: Bool, +ward: U32, +players: J.Val) -> J.Val:
  match _xs:
    case Nil{}:
      stakes.Run.set_stakes.k1(run, players)
    case Con{+_h2, +_t2}:
      (+k, +h) = _h2
      +h = {core.set_s(h, "stakes", st) : J.Val}
      +h = {core.set_u(h, "incoming", pressure) : J.Val}
      +h = {core.set_u(h, "hit_ward", ward) : J.Val}
      stakes.Run.set_stakes.if4(new_second, run, st, pressure, new_second, ward, players, _t2, k, h)

# A volley's shots from `from` on, each with `fury` more beside it, fanned a little to either side.

def stakes.fan_out(+fury: U32, +shots: List<&2, J.Val>, +from: U32) -> List<&2, J.Val>:
  +fired = {[] : List<&2, J.Val>}
  +i = {0 : U32}
  stakes.fan_out.loop6(shots, fury, shots, from, fired, i)

def stakes.fan_out.k2(+shots: List<&2, J.Val>) -> List<&2, J.Val>:
  shots

def stakes.fan_out.if5(_c: Bool, +fury: U32, +shots: List<&2, J.Val>, +_t3: List<&2, J.Val>, +s: J.Val, +k: U32) -> List<&2, J.Val>:
  match _c:
    case True{}:
      +turn = {(stakes.FAN_ANGLE() * RS.u_as_f32(k) : F32) : F32}
      +shots = {List.append(&2, J.Val, shots, [stakes.fan_copy(s, turn)]) : List<&2, J.Val>}
      +shots = {List.append(&2, J.Val, shots, [stakes.fan_copy(s, F32.neg(turn))]) : List<&2, J.Val>}
      +k = {(k + 1 : U32) : U32}
      stakes.fan_out.loop4(fury, shots, _t3, s, k)
    case False{}:
      stakes.fan_out.loop3(_t3, fury, shots)

def stakes.fan_out.loop4(+fury: U32, +shots: List<&2, J.Val>, +_t3: List<&2, J.Val>, +s: J.Val, +k: U32) -> List<&2, J.Val>:
  stakes.fan_out.if5(U32.is_le(k, fury), fury, shots, _t3, s, k)

def stakes.fan_out.loop3(+_xs: List<&2, J.Val>, +fury: U32, +shots: List<&2, J.Val>) -> List<&2, J.Val>:
  match _xs:
    case Nil{}:
      stakes.fan_out.k2(shots)
    case Con{+s, +_t3}:
      +k = {1 : U32}
      stakes.fan_out.loop4(fury, shots, _t3, s, k)

def stakes.fan_out.k1(+fury: U32, +shots: List<&2, J.Val>, +fired: List<&2, J.Val>) -> List<&2, J.Val>:
  stakes.fan_out.loop3(fired, fury, shots)

def stakes.fan_out.k7(+fury: U32, +shots: List<&2, J.Val>, +from: U32, +fired: List<&2, J.Val>, +i: U32, +_t6: List<&2, J.Val>) -> List<&2, J.Val>:
  +i = {(i + 1 : U32) : U32}
  stakes.fan_out.loop6(_t6, fury, shots, from, fired, i)

def stakes.fan_out.if8(_c: Bool, +fury: U32, +shots: List<&2, J.Val>, +from: U32, +fired: List<&2, J.Val>, +i: U32, +_t6: List<&2, J.Val>, +s: J.Val) -> List<&2, J.Val>:
  match _c:
    case True{}:
      +fired = {List.append(&2, J.Val, fired, [s]) : List<&2, J.Val>}
      stakes.fan_out.k7(fury, shots, from, fired, i, _t6)
    case False{}:
      stakes.fan_out.k7(fury, shots, from, fired, i, _t6)

def stakes.fan_out.loop6(+_xs: List<&2, J.Val>, +fury: U32, +shots: List<&2, J.Val>, +from: U32, +fired: List<&2, J.Val>, +i: U32) -> List<&2, J.Val>:
  match _xs:
    case Nil{}:
      stakes.fan_out.k1(fury, shots, fired)
    case Con{+s, +_t6}:
      stakes.fan_out.if8(Bool.and(U32.is_ge(i, from), Bool.and(J.is_null(J.get(J.get(J.get(s, "traits"), "path"), "beam")), U32.is_lt(U32.from_nat(List.length(&2, J.Val, fired)), stakes.FAN_SHOTS()))), fury, shots, from, fired, i, _t6, s)

# A copy of a shot turned `turn` radians.

def stakes.fan_copy(+s: J.Val, +turn: F32) -> J.Val:
  +c = {F32.cos(turn) : F32}
  +sn = {F32.sin(turn) : F32}
  +vx = {core.f(s, "vx") : F32}
  +vy = {core.f(s, "vy") : F32}
  +s = {core.set_f(s, "vx", ((vx * c : F32) - (vy * sn : F32) : F32)) : J.Val}
  core.set_f(s, "vy", ((vx * sn : F32) + (vy * c : F32) : F32))
