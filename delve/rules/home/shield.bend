# crates/delve/src/rules/shield.rs — a raised shield is a barrier at its face. Written in

# bendx (structured Bend, delve/rules/core/_tools/bendx.py); shield.bend is generated from it.

# A Hero is its J value; `shield_wear` is left out of it while the wear is fresh.

# `SHIELD_REACH`, `SHIELD_DOWN`, `SHIELD_CALM`, `SHIELD_MEND`, `critters::GUARD_BREAK`.

def shield.REACH() -> F32:
  0.9

def shield.DOWN() -> U32:
  30

def shield.CALM() -> U32:
  30

def shield.MEND() -> U32:
  60

def shield.GUARD_BREAK() -> U32:
  34

# `SHIELD_ARC.to_radians().cos()`: 65 degrees, `RADS_PER_DEG` = PI / 180 in f32.

def shield.cos_arc() -> F32:
  F32.cos(F32.mul(65.0, F32.div(3.1415927, 180.0)))

# Whether `h`'s raised shield faces what comes along (dx, dy) (the way it travels).

def shield.turns(+h: J.Val, +dx: F32, +dy: F32) -> Bool:
  +speed = {RS.f_hypot(dx, dy) : F32}
  shield.turns.if4(Bool.not(core.b(h, "shielding")), h, dx, dy, speed)

def shield.turns.k2(+h: J.Val, +dx: F32, +dy: F32, +speed: F32) -> Bool:
  +along = {F32.neg(F32.add(F32.mul(dx, core.f(h, "aim_x")), F32.mul(dy, core.f(h, "aim_y")))) : F32}
  F32.is_ge(F32.div(along, speed), shield.cos_arc())

def shield.turns.if3(c: Bool, +h: J.Val, +dx: F32, +dy: F32, +speed: F32) -> Bool:
  match c:
    case True{}:
      False{}
    case False{}:
      shield.turns.k2(h, dx, dy, speed)

def shield.turns.k1(+h: J.Val, +dx: F32, +dy: F32, +speed: F32) -> Bool:
  shield.turns.if3(Bool.not(F32.is_gt(speed, 0.0)), h, dx, dy, speed)

def shield.turns.if4(c: Bool, +h: J.Val, +dx: F32, +dy: F32, +speed: F32) -> Bool:
  match c:
    case True{}:
      False{}
    case False{}:
      shield.turns.k1(h, dx, dy, speed)

# The point on `h`'s shield face (round the centre) that looks toward a point; the face's

# middle when that is off the arc.

def shield.face(+h: J.Val, +cx: F32, +cy: F32, +tx: F32, +ty: F32) -> F32 & F32:
  shield.face.k1(rules.unit(F32.sub(tx, cx), F32.sub(ty, cy)), h, cx, cy)

def shield.face.k2(+cx: F32, +cy: F32, +ux: F32, +uy: F32) -> F32 & F32:
  (F32.add(cx, F32.mul(ux, shield.REACH())), F32.add(cy, F32.mul(uy, shield.REACH())))

def shield.face.if3(c: Bool, +h: J.Val, +cx: F32, +cy: F32, +ux: F32, +uy: F32) -> F32 & F32:
  match c:
    case True{}:
      +ux = {core.f(h, "aim_x") : F32}
      +uy = {core.f(h, "aim_y") : F32}
      shield.face.k2(cx, cy, ux, uy)
    case False{}:
      shield.face.k2(cx, cy, ux, uy)

def shield.face.k1(t: F32 & F32, +h: J.Val, +cx: F32, +cy: F32) -> F32 & F32:
  (+ux, +uy) = t
  shield.face.if3(F32.is_lt(F32.add(F32.mul(ux, core.f(h, "aim_x")), F32.mul(uy, core.f(h, "aim_y"))), shield.cos_arc()), h, cx, cy, ux, uy)

# Where a step from a to b first comes within `r` of c, as a share of the step.

def shield.entry(+ax: F32, +ay: F32, +bx: F32, +by: F32, +cx: F32, +cy: F32, +r: F32) -> Maybe<&2, F32>:
  +dx = {F32.sub(bx, ax) : F32}
  +dy = {F32.sub(by, ay) : F32}
  +fx = {F32.sub(ax, cx) : F32}
  +fy = {F32.sub(ay, cy) : F32}
  +start = {F32.sub(F32.add(F32.mul(fx, fx), F32.mul(fy, fy)), F32.mul(r, r)) : F32}
  shield.entry.if8(F32.is_le(start, 0.0), dx, dy, fx, fy, start)

def shield.entry.k4() -> Maybe<&2, F32>:
  None{}

def shield.entry.if5(c: Bool, +t: F32) -> Maybe<&2, F32>:
  match c:
    case True{}:
      Some{t}
    case False{}:
      shield.entry.k4()

def shield.entry.k3(+along: F32, +half: F32, +disc: F32) -> Maybe<&2, F32>:
  +t = {F32.div(F32.sub(F32.neg(half), F32.sqrt(disc)), along) : F32}
  shield.entry.if5(Bool.and(F32.is_ge(t, 0.0), F32.is_le(t, 1.0)), t)

def shield.entry.if6(c: Bool, +along: F32, +half: F32, +disc: F32) -> Maybe<&2, F32>:
  match c:
    case True{}:
      None{}
    case False{}:
      shield.entry.k3(along, half, disc)

def shield.entry.k2(+dx: F32, +dy: F32, +fx: F32, +fy: F32, +start: F32, +along: F32) -> Maybe<&2, F32>:
  +half = {F32.add(F32.mul(fx, dx), F32.mul(fy, dy)) : F32}
  +disc = {F32.sub(F32.mul(half, half), F32.mul(along, start)) : F32}
  shield.entry.if6(F32.is_lt(disc, 0.0), along, half, disc)

def shield.entry.if7(c: Bool, +dx: F32, +dy: F32, +fx: F32, +fy: F32, +start: F32, +along: F32) -> Maybe<&2, F32>:
  match c:
    case True{}:
      None{}
    case False{}:
      shield.entry.k2(dx, dy, fx, fy, start, along)

def shield.entry.k1(+dx: F32, +dy: F32, +fx: F32, +fy: F32, +start: F32) -> Maybe<&2, F32>:
  +along = {F32.add(F32.mul(dx, dx), F32.mul(dy, dy)) : F32}
  shield.entry.if7(F32.is_le(along, 0.0), dx, dy, fx, fy, start, along)

def shield.entry.if8(c: Bool, +dx: F32, +dy: F32, +fx: F32, +fy: F32, +start: F32) -> Maybe<&2, F32>:
  match c:
    case True{}:
      Some{0.0}
    case False{}:
      shield.entry.k1(dx, dy, fx, fy, start)

# What a hostile shot stepping from a to b meets at `h`, whose middle is at (cx, cy) and whose

# body a shot touches within `body`: the raised shield's face first, or the body. None if it

# passes them by. {t, shield, at: [x, y]}.

def shield.meets(+h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +body: F32) -> Maybe<&2, J.Val>:
  shield.meets.if9(core.b(h, "shielding"), h, cx, cy, ax, ay, bx, by, body)

def shield.meets.k4(+bx: F32, +by: F32, +tt: F32) -> Maybe<&2, J.Val>:
  Some{shield.meet_json(tt, False{}, bx, by)}

def shield.meets.k6(t: F32 & F32, +bx: F32, +by: F32, +tt: F32) -> Maybe<&2, J.Val>:
  (+fx, +fy) = t
  Some{shield.meet_json(tt, True{}, fx, fy)}

def shield.meets.if5(c: Bool, +h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +tt: F32) -> Maybe<&2, J.Val>:
  match c:
    case True{}:
      shield.meets.k6(shield.face(h, cx, cy, ax, ay), bx, by, tt)
    case False{}:
      shield.meets.k4(bx, by, tt)

def shield.meets.k3(+h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +tt: F32) -> Maybe<&2, J.Val>:
  shield.meets.if5(shield.turns(h, F32.sub(bx, ax), F32.sub(by, ay)), h, cx, cy, ax, ay, bx, by, tt)

def shield.meets.m7(+s: Maybe<&2, F32>, +h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +tt: F32) -> Maybe<&2, J.Val>:
  match s:
    case Some{+e}:
      +tt = {e : F32}
      shield.meets.k3(h, cx, cy, ax, ay, bx, by, tt)
    case None{}:
      +tt = {0.0 : F32}
      shield.meets.k3(h, cx, cy, ax, ay, bx, by, tt)

def shield.meets.k2(+h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +body: F32) -> Maybe<&2, J.Val>:
  +tt = {0.0 : F32}
  shield.meets.m7(shield.entry(ax, ay, bx, by, cx, cy, body), h, cx, cy, ax, ay, bx, by, tt)

def shield.meets.if8(c: Bool, +h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +body: F32) -> Maybe<&2, J.Val>:
  match c:
    case True{}:
      None{}
    case False{}:
      shield.meets.k2(h, cx, cy, ax, ay, bx, by, body)

def shield.meets.k1(+h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +body: F32) -> Maybe<&2, J.Val>:
  shield.meets.if8(Bool.not(rules.hit_segment(ax, ay, bx, by, cx, cy, body)), h, cx, cy, ax, ay, bx, by, body)

def shield.meets.if13(c: Bool, +h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +body: F32, +tt: F32, +px: F32, +py: F32) -> Maybe<&2, J.Val>:
  match c:
    case True{}:
      Some{shield.meet_json(tt, True{}, px, py)}
    case False{}:
      shield.meets.k1(h, cx, cy, ax, ay, bx, by, body)

def shield.meets.k12(t: F32 & F32, +h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +body: F32, +tt: F32, +px: F32, +py: F32) -> Maybe<&2, J.Val>:
  (+ux, +uy) = t
  shield.meets.if13(F32.is_ge(F32.add(F32.mul(ux, core.f(h, "aim_x")), F32.mul(uy, core.f(h, "aim_y"))), shield.cos_arc()), h, cx, cy, ax, ay, bx, by, body, tt, px, py)

def shield.meets.if11(c: Bool, +h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +body: F32, +tt: F32) -> Maybe<&2, J.Val>:
  match c:
    case True{}:
      +px = {F32.add(ax, F32.mul(F32.sub(bx, ax), tt)) : F32}
      +py = {F32.add(ay, F32.mul(F32.sub(by, ay), tt)) : F32}
      shield.meets.k12(rules.unit(F32.sub(px, cx), F32.sub(py, cy)), h, cx, cy, ax, ay, bx, by, body, tt, px, py)
    case False{}:
      shield.meets.k1(h, cx, cy, ax, ay, bx, by, body)

def shield.meets.m10(+s: Maybe<&2, F32>, +h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +body: F32) -> Maybe<&2, J.Val>:
  match s:
    case Some{+tt}:
      shield.meets.if11(F32.is_gt(tt, 0.0), h, cx, cy, ax, ay, bx, by, body, tt)
    case None{}:
      +tt0 = {0.0 : F32}
      shield.meets.k1(h, cx, cy, ax, ay, bx, by, body)

def shield.meets.if9(c: Bool, +h: J.Val, +cx: F32, +cy: F32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +body: F32) -> Maybe<&2, J.Val>:
  match c:
    case True{}:
      shield.meets.m10(shield.entry(ax, ay, bx, by, cx, cy, shield.REACH()), h, cx, cy, ax, ay, bx, by, body)
    case False{}:
      shield.meets.k1(h, cx, cy, ax, ay, bx, by, body)

def shield.meet_json(+t: F32, +shield: Bool, +x: F32, +y: F32) -> J.Val:
  J.set(J.set(J.set(J.obj(), "t", J.JF{t}), "shield", J.JBool{shield}), "at", J.JA{[J.JF{x}, J.JF{y}]})

# `Wear::most`: the most a knight of `max_hp` health's shield turns before it is knocked aside,

# in hundredths of a point.

def shield.Wear.most(+max_hp: U32) -> U32:
  (U32.max(max_hp, 1) * shield.GUARD_BREAK() : U32)

# `Wear::fresh`: unworn and in hand.

def shield.Wear.fresh(+w: J.Val) -> Bool:
  Bool.and(U32.is_zero(core.u(w, "worn")), Bool.and(U32.is_zero(core.u(w, "calm")), U32.is_zero(core.u(w, "down"))))

# `Wear::left`: how much more it can turn, 1 unworn to 0 knocked aside.

def shield.Wear.left(+w: J.Val, +max_hp: U32) -> F32:
  shield.Wear.left.if2(U32.is_gt(core.u(w, "down"), 0), w, max_hp)

def shield.Wear.left.k1(+w: J.Val, +max_hp: U32) -> F32:
  F32.sub(1.0, F32.min(F32.div(U32.to_f32(core.u(w, "worn")), U32.to_f32(shield.Wear.most(max_hp))), 1.0))

def shield.Wear.left.if2(c: Bool, +w: J.Val, +max_hp: U32) -> F32:
  match c:
    case True{}:
      0.0
    case False{}:
      shield.Wear.left.k1(w, max_hp)

# `Wear::back`: knocked aside, how far it has come back.

def shield.Wear.back(+w: J.Val) -> F32:
  F32.sub(1.0, F32.div(U32.to_f32(U32.min(core.u(w, "down"), shield.DOWN())), U32.to_f32(shield.DOWN())))

# `Wear::rest`: a tick: a shield knocked aside comes back to hand, and once calm the wear drains.

def shield.Wear.rest(+w: J.Val, +max_hp: U32) -> J.Val:
  shield.Wear.rest.if4(U32.is_gt(core.u(w, "down"), 0), w, max_hp)

def shield.Wear.rest.k2(+w: J.Val, +max_hp: U32) -> J.Val:
  core.set_u_skip(w, "worn", core.usub(core.u(w, "worn"), core.div_ceil(shield.Wear.most(max_hp), shield.MEND())))

def shield.Wear.rest.if3(c: Bool, +w: J.Val, +max_hp: U32) -> J.Val:
  match c:
    case True{}:
      core.set_u_skip(w, "calm", (core.u(w, "calm") - 1 : U32))
    case False{}:
      shield.Wear.rest.k2(w, max_hp)

def shield.Wear.rest.k1(+w: J.Val, +max_hp: U32) -> J.Val:
  shield.Wear.rest.if3(U32.is_gt(core.u(w, "calm"), 0), w, max_hp)

def shield.Wear.rest.if4(c: Bool, +w: J.Val, +max_hp: U32) -> J.Val:
  match c:
    case True{}:
      core.set_u_skip(w, "down", (core.u(w, "down") - 1 : U32))
    case False{}:
      shield.Wear.rest.k1(w, max_hp)

# `Wear::take`: it turned `damage`; the wear after, and whether that knocked it aside.

def shield.Wear.take(+w: J.Val, +damage: U32, +max_hp: U32) -> J.Val & Bool:
  +w = {core.set_u(w, "turned", core.uadd(core.u(w, "turned"), damage)) : J.Val}
  +w = {core.set_u_skip(w, "worn", core.uadd(core.u(w, "worn"), (U32.max(damage, 1) * 100 : U32))) : J.Val}
  +w = {core.set_u_skip(w, "calm", shield.CALM()) : J.Val}
  shield.Wear.take.if2(U32.is_lt(core.u(w, "worn"), shield.Wear.most(max_hp)), w)

def shield.Wear.take.k1(+w: J.Val) -> J.Val & Bool:
  +w = {core.set_u_skip(core.set_u_skip(core.set_u_skip(w, "worn", 0), "calm", 0), "down", shield.DOWN()) : J.Val}
  (w, True{})

def shield.Wear.take.if2(c: Bool, +w: J.Val) -> J.Val & Bool:
  match c:
    case True{}:
      (w, False{})
    case False{}:
      shield.Wear.take.k1(w)

# `Hero::shield_turned`: this knight's raised shield turned `damage`: it wears. The knight after,

# and whether that knocked it aside (then it drops).

def shield.Hero.shield_turned(+h: J.Val, +damage: U32) -> J.Val & Bool:
  +w = {J.get(h, "shield_wear") : J.Val}
  shield.Hero.shield_turned.if5(Bool.not(String.eq(core.s(h, "guard"), "shield")), h, damage, w)

def shield.Hero.shield_turned.k3(+h: J.Val, +knocked: Bool) -> J.Val & Bool:
  (h, knocked)

def shield.Hero.shield_turned.if4(c: Bool, +h: J.Val, +knocked: Bool) -> J.Val & Bool:
  match c:
    case True{}:
      +h = {core.set_b(h, "shielding", False{}) : J.Val}
      shield.Hero.shield_turned.k3(h, knocked)
    case False{}:
      shield.Hero.shield_turned.k3(h, knocked)

def shield.Hero.shield_turned.k2(t: J.Val & Bool, +h: J.Val) -> J.Val & Bool:
  (+w2, +knocked) = t
  +h = {shield.Hero.put_wear(h, w2) : J.Val}
  shield.Hero.shield_turned.if4(knocked, h, knocked)

def shield.Hero.shield_turned.k1(+h: J.Val, +damage: U32, +w: J.Val) -> J.Val & Bool:
  shield.Hero.shield_turned.k2(shield.Wear.take(w, damage, core.u(h, "max_hp")), h)

def shield.Hero.shield_turned.if5(c: Bool, +h: J.Val, +damage: U32, +w: J.Val) -> J.Val & Bool:
  match c:
    case True{}:
      +w = {core.set_u(w, "turned", core.uadd(core.u(w, "turned"), damage)) : J.Val}
      (shield.Hero.put_wear(h, w), False{})
    case False{}:
      shield.Hero.shield_turned.k1(h, damage, w)

# The hero with its wear written back (left out while fresh).

def shield.Hero.put_wear(+h: J.Val, +w: J.Val) -> J.Val:
  shield.Hero.put_wear.if2(shield.Wear.fresh(w), h, w)

def shield.Hero.put_wear.k1(+h: J.Val, +w: J.Val) -> J.Val:
  J.set(h, "shield_wear", w)

def shield.Hero.put_wear.if2(c: Bool, +h: J.Val, +w: J.Val) -> J.Val:
  match c:
    case True{}:
      J.del(h, "shield_wear")
    case False{}:
      shield.Hero.put_wear.k1(h, w)
