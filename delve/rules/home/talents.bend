# The lecterns (column, row, width, height in tiles): the left talent, and the right.

def talents.inside(+col: U32, +row: U32, +w: U32, +h: U32, +x: F32, +y: F32) -> Bool:
  +c = {F32.div(x, layout.TILE_UNITS()) : F32}
  +r = {F32.div(y, layout.TILE_UNITS()) : F32}
  Bool.and(Bool.and(F32.is_ge(c, U32.to_f32(col)), F32.is_lt(c, U32.to_f32((col + w : U32)))), Bool.and(F32.is_ge(r, U32.to_f32(row)), F32.is_lt(r, U32.to_f32((row + h : U32)))))

# The lectern a point stands on: 0 the left, 1 the right, 9 none.

def talents.lectern_at(+x: F32, +y: F32) -> U32:
  talents.lectern_at.if4(talents.inside(2, 11, 2, 1, x, y), x, y)

def talents.lectern_at.k2() -> U32:
  9

def talents.lectern_at.if3(c: Bool) -> U32:
