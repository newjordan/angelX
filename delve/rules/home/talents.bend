    case True{}:
      1
    case False{}:
      talents.lectern_at.k2()

def talents.lectern_at.k1(+x: F32, +y: F32) -> U32:
  talents.lectern_at.if3(talents.inside(6, 11, 2, 1, x, y))

def talents.lectern_at.if4(c: Bool, +x: F32, +y: F32) -> U32:
  match c:
    case True{}:
      0
    case False{}:
      talents.lectern_at.k1(x, y)

