# crates/delve/src/rules/overclass.rs — wishes, held by each knight (the pieces that do not need

# `grant`). Written in bendx (delve/rules/core/_tools/bendx.py). `wishes` and `great_wishes` are

# u8: saturating at 255; a knight holds at most MOST_WISHES (9) of either.

def overclass.START_WISHES() -> U32:
  3

def overclass.FLOOR_WISHES() -> U32:
  2

def overclass.MOST_WISHES() -> U32:
  9

# `clean_why`: trimmed of parentheses, full stops and white space at both ends.

def overclass.clean_why(+why: String) -> String:
  home.util.trim_set(why, [40, 41, 46])

# The line a knight sees on their own screen when a spent wish comes back.

def overclass.wish_returned(+why: String) -> String:
  +w = {overclass.clean_why(why) : String}
  overclass.wish_returned.if2(String.is_empty(w), w)

def overclass.wish_returned.k1(+w: String) -> String:
  "Your wish is given back: " ++ w ++ "."

def overclass.wish_returned.if2(c: Bool, +w: String) -> String:
  match c:
    case True{}:
      "Your wish is given back."
    case False{}:
      overclass.wish_returned.k1(w)

# The line a knight sees when a grant is refused before the wish is spent.

def overclass.wish_kept(+why: String) -> String:
  +w = {overclass.clean_why(why) : String}
  overclass.wish_kept.if2(String.is_empty(w), w)

def overclass.wish_kept.k1(+w: String) -> String:
  "Your wish stays with you: " ++ w ++ "."

def overclass.wish_kept.if2(c: Bool, +w: String) -> String:
  match c:
    case True{}:
      "Your wish stays with you."
    case False{}:
      overclass.wish_kept.k1(w)

# `give_wishes`: every knight here is given `plain` wishes and `great` super ones.

def overclass.Run.give_wishes(+run: J.Val, +plain: U32, +great: U32) -> J.Val:
  +players = {J.get(run, "players") : J.Val}
  overclass.Run.give_wishes.loop2(J.int_fields(players), run, plain, great, players)

def overclass.Run.give_wishes.k1(+run: J.Val, +plain: U32, +great: U32, +players: J.Val) -> J.Val:
  +run = {J.set(run, "players", players) : J.Val}
  +window = {J.set(J.set(J.set(J.set(J.obj(), "opened", J.get(run, "tick")), "wished", J.JA{[]}), "given", J.JU{plain}), "great", J.JBool{U32.is_gt(great, 0)}) : J.Val}
  +run = {J.set(run, "window", window) : J.Val}
  J.set(run, "cues", J.push(J.get(run, "cues"), J.JS{"window"}))

def overclass.Run.give_wishes.if3(c: Bool, +run: J.Val, +plain: U32, +great: U32, +players: J.Val, +_t2: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String, +h: J.Val) -> J.Val:
  match c:
    case True{}:
      +h = {core.set_u(h, "wishes", U32.min(core.uadd(core.u(h, "wishes"), plain), overclass.MOST_WISHES())) : J.Val}
      +h = {core.set_u(h, "great_wishes", U32.min(core.uadd(core.u(h, "great_wishes"), great), overclass.MOST_WISHES())) : J.Val}
      +players = {J.set(players, k, h) : J.Val}
      overclass.Run.give_wishes.loop2(_t2, run, plain, great, players)
    case False{}:
      overclass.Run.give_wishes.loop2(_t2, run, plain, great, players)

def overclass.Run.give_wishes.loop2(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +plain: U32, +great: U32, +players: J.Val) -> J.Val:
  match _xs:
