      overclass.Run.give_wishes.if3(Bool.not(core.b(h, "absent")), run, plain, great, players, _t2, k, h)

# Knight `id` may wish now: they stand and hold a wish.

def overclass.Run.can_wish(+run: J.Val, +id: U32) -> Bool:
  +h = {core.hero(run, id) : J.Val}
  overclass.Run.can_wish.if2(J.is_null(h), h)

def overclass.Run.can_wish.k1(+h: J.Val) -> Bool:
  Bool.and(U32.is_gt(core.u(h, "hp"), 0), U32.is_gt((core.u(h, "wishes") + core.u(h, "great_wishes") : U32), 0))

def overclass.Run.can_wish.if2(c: Bool, +h: J.Val) -> Bool:
  match c:
    case True{}:
      False{}
    case False{}:
      overclass.Run.can_wish.k1(h)

