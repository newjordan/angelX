# `refund_told`: a wish that did not go through is given back, and the knight hears why.

def overclass.Run.refund_told(+run: J.Val, +id: U32, +great: Bool, +why: String) -> J.Val:
  +h = {core.hero(run, id) : J.Val}
  overclass.Run.refund_told.if2(Bool.not(J.is_null(h)), run, id, great, why, h)

def overclass.Run.refund_told.k1(+run: J.Val, +id: U32, +why: String) -> J.Val:
  overclass.Run.tell(run, id, overclass.wish_returned(why))

def overclass.Run.refund_told.k3(+run: J.Val, +id: U32, +why: String, +h: J.Val) -> J.Val:
  +run = {core.set_hero(run, id, h) : J.Val}
  overclass.Run.refund_told.k1(run, id, why)

def overclass.Run.refund_told.if4(c: Bool, +run: J.Val, +id: U32, +why: String, +h: J.Val) -> J.Val:
  match c:
    case True{}:
      +h = {core.set_u(h, "great_wishes", U32.min(core.uadd(core.u(h, "great_wishes"), 1), 255)) : J.Val}
      overclass.Run.refund_told.k3(run, id, why, h)
    case False{}:
      +h = {core.set_u(h, "wishes", U32.min(core.uadd(core.u(h, "wishes"), 1), overclass.MOST_WISHES())) : J.Val}
      overclass.Run.refund_told.k3(run, id, why, h)

def overclass.Run.refund_told.if2(c: Bool, +run: J.Val, +id: U32, +great: Bool, +why: String, +h: J.Val) -> J.Val:
  match c:
    case True{}:
      overclass.Run.refund_told.if4(great, run, id, why, h)
    case False{}:
      overclass.Run.refund_told.k1(run, id, why)

def overclass.Run.refund_wish(+run: J.Val, +id: U32, +great: Bool) -> J.Val:
  overclass.Run.refund_told(run, id, great, "it did not go through")

# A knight who joins a delve under way holds a start's wishes.

def overclass.Run.wishes_for_newcomer(+run: J.Val, +id: U32) -> J.Val:
  +h = {core.hero(run, id) : J.Val}
  overclass.Run.wishes_for_newcomer.if2(Bool.and(U32.is_ge(core.u(J.get(run, "dungeon"), "depth"), 1), Bool.not(J.is_null(h))), run, id, h)

def overclass.Run.wishes_for_newcomer.k1(+run: J.Val) -> J.Val:
  run

def overclass.Run.wishes_for_newcomer.if3(c: Bool, +run: J.Val, +id: U32, +h: J.Val) -> J.Val:
  match c:
    case True{}:
      core.set_hero(run, id, core.set_u(h, "wishes", overclass.START_WISHES()))
    case False{}:
      overclass.Run.wishes_for_newcomer.k1(run)

def overclass.Run.wishes_for_newcomer.if2(c: Bool, +run: J.Val, +id: U32, +h: J.Val) -> J.Val:
  match c:
    case True{}:
      overclass.Run.wishes_for_newcomer.if3(U32.is_zero((core.u(h, "wishes") + core.u(h, "great_wishes") : U32)), run, id, h)
    case False{}:
      overclass.Run.wishes_for_newcomer.k1(run)

# Why knight `id` may not be granted a tier of a wish: none keeps a lock.

def overclass.Run.locked(+run: J.Val, +id: U32) -> J.Val:
  J.JNull{}

# Knight `id` made wish `wish` in their own words (`name`, or their knight's when empty).

def overclass.Run.made(+run: J.Val, +id: U32, +wish: String, +name: String) -> J.Val:
  +n = {home.util.trim(name) : String}
  overclass.Run.made.if4(String.is_empty(n), run, id, wish, name, n)

def overclass.Run.made.k2(+run: J.Val) -> J.Val:
  run

def overclass.Run.made.if3(c: Bool, +run: J.Val, +id: U32, +wish: String, +n: String) -> J.Val:
  match c:
    case True{}:
      +run = {J.set(run, "makers", J.set(J.get(run, "makers"), wish, J.JA{[J.JU{id}, J.JS{n}]})) : J.Val}
      overclass.Run.made.k2(run)
    case False{}:
      overclass.Run.made.k2(run)

def overclass.Run.made.k1(+run: J.Val, +id: U32, +wish: String, +n: String) -> J.Val:
  overclass.Run.made.if3(Bool.not(String.is_empty(n)), run, id, wish, n)

def overclass.Run.made.if4(c: Bool, +run: J.Val, +id: U32, +wish: String, +name: String, +n: String) -> J.Val:
  match c:
    case True{}:
      +n = {core.s(core.hero(run, id), "name") : String}
      overclass.Run.made.k1(run, id, wish, n)
    case False{}:
      overclass.Run.made.k1(run, id, wish, n)
