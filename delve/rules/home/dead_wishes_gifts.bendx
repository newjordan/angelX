def dead_wishes.Gifts.hit(g: J.Val, weight: U32) -> U32:
    return U32.div((weight * (100 + core.u(J.get(g, "bonus"), "damage")) : U32), 100)

def dead_wishes.Gifts.rest(g: J.Val, ticks: U32) -> U32:
    return U32.max(U32.div((ticks * 100 : U32), (100 + core.u(J.get(g, "bonus"), "rate") : U32)), 1)

def dead_wishes.Gifts.pace(g: J.Val) -> F32:
    return F32.div(U32.to_f32((100 + core.u(J.get(g, "bonus"), "speed") : U32)), 100.0)

def dead_wishes.Gifts.taken(g: J.Val, damage: U32) -> U32:
    turned: U32 = hero.armor_turns(core.u(J.get(g, "bonus"), "armor"))
    if U32.is_zero(damage):
        return 0
    return U32.max(U32.div((damage * (100 - turned) : U32), 100), 1)
