# A knight back from away is warded this long: a second.

def presence.WAKE_WARD() -> U32:
  30

# `Run::set_away`: whether knight `id`'s player is here. Away, the knight is stone; back,

# it is itself again (still stone if it keeps vigil) and warded a moment.

