  match c:
    case True{}:
      +h = {core.set_b(h, "away", False{}) : J.Val}
      +idle = {U32.is_gt(core.u(h, "hp"), 0) : Bool}
      +h = {core.set_b_skip(h, "idle", idle) : J.Val}
      +h = {core.set_b(h, "stone", Bool.or(idle, core.b(h, "vigil"))) : J.Val}
      +h = {core.set_u(h, "invulnerable", U32.max(core.u(h, "invulnerable"), presence.WAKE_WARD())) : J.Val}
      presence.Run.set_away.k2(run, id, h)
    case False{}:
      presence.Run.set_away.k2(run, id, h)

