  core.set_hero(run, id, h)

def presence.Run.set_away.k4(+run: J.Val, +id: U32, +h: J.Val) -> J.Val:
  +h = {core.set_b(h, "stone", True{}) : J.Val}
  presence.Run.set_away.k2(run, id, h)

def presence.Run.set_away.if5(c: Bool, +run: J.Val, +id: U32, +away: Bool, +h: J.Val) -> J.Val:
  match c:
    case True{}:
      +h = {core.set_b(h, "away", True{}) : J.Val}
      +h = {core.set_b(h, "shielding", False{}) : J.Val}
      +h = {core.set_b(h, "walling", False{}) : J.Val}
      +h = {core.set_u(h, "dash_ticks", 0) : J.Val}
