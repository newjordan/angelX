# `Hero::spell_power`

def spell_upgrades.Hero.spell_power(+h: J.Val, +id: String, +base: U32) -> U32:
  spell_upgrades.table(spell_upgrades.TIER_POWER(spell_upgrades.Hero.spell_tier(h, id)), base)

# `Hero::spell_damage`: the power, scaled by the knight's damage.

def spell_upgrades.Hero.spell_damage(+h: J.Val, +id: String, +base: U32) -> U32:
  hero.Hero.scaled(h, spell_upgrades.Hero.spell_power(h, id, base))

# `Hero::spell_wait`: the recharge in ticks of a spell card.

def spell_upgrades.Hero.spell_wait(+h: J.Val, +card: J.Val) -> U32:
  spell_upgrades.table(spell_upgrades.TIER_WAIT(spell_upgrades.Hero.spell_tier(h, core.s(card, "id"))), U32.clamp(core.u(card, "cooldown"), 1, 120))

# `Hero::spell_name`

def spell_upgrades.Hero.spell_name(+h: J.Val, +card: J.Val) -> String:
  spell_upgrades.Hero.spell_name.if6(String.starts_with(core.s(card, "id"), "wish-"), h, card)

def spell_upgrades.Hero.spell_name.k3(+card: J.Val) -> String:
  core.s(card, "name") ++ " III"

def spell_upgrades.Hero.spell_name.if4(c: Bool, +card: J.Val) -> String:
  match c:
    case True{}:
      core.s(card, "name") ++ " II"
    case False{}:
      spell_upgrades.Hero.spell_name.k3(card)

def spell_upgrades.Hero.spell_name.k2(+card: J.Val, +tier: U32) -> String:
  spell_upgrades.Hero.spell_name.if4(U32.is_eq(tier, 1), card)

def spell_upgrades.Hero.spell_name.if5(c: Bool, +card: J.Val, +tier: U32) -> String:
  match c:
    case True{}:
