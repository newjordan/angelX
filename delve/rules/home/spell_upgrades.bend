# `Hero::spell_tier`: a wish spell keeps its phrasebook ladder (tier I here).

def spell_upgrades.Hero.spell_tier(+h: J.Val, +id: String) -> U32:
  spell_upgrades.Hero.spell_tier.if2(String.starts_with(id, "wish-"), h, id)

def spell_upgrades.Hero.spell_tier.k1(+h: J.Val, +id: String) -> U32:
  U32.min(core.u(J.get(h, "spell_tiers"), id), 2)

def spell_upgrades.Hero.spell_tier.if2(c: Bool, +h: J.Val, +id: String) -> U32:
  match c:
    case True{}:
      0
    case False{}:
      spell_upgrades.Hero.spell_tier.k1(h, id)

# `Hero::spell_step`: the tier's other numbers (warden_hp, rip_reach, ..., imposture).

def spell_upgrades.Hero.spell_step(+h: J.Val, +id: String) -> J.Val:
  spell_upgrades.step(spell_upgrades.Hero.spell_tier(h, id))

# The tier's table entry for `base`, or `base` past the table.

def spell_upgrades.table(+table: List<&2, U32>, +base: U32) -> U32:
  spell_upgrades.table.m2(List.get(&2, U32, table, U32.to_nat(base)), base)

def spell_upgrades.table.k1(+base: U32) -> U32:
  base

def spell_upgrades.table.m2(+s: Maybe<&2, U32>, +base: U32) -> U32:
  match s:
    case Some{+v}:
