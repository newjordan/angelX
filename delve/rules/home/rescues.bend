  +found = {J.get(run, "found") : J.Val}
  +quiet = {J.is_null(found) : Bool}
  rescues.Run.tick_cage.if21(Bool.not(quiet), run, inputs, captive, players, cx, cy, trying, found, quiet)

def rescues.Run.tick_cage.if23(c: Bool, +run: J.Val, +inputs: J.Val, +captive: J.Val, +players: J.Val, +cx: F32, +cy: F32, +trying: U32, +_t22: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +k: String) -> J.Val:
  match c:
    case True{}:
      +trying = {combos.num(k) : U32}
      rescues.Run.tick_cage.loop22(_t22, run, inputs, captive, players, cx, cy, trying)
    case False{}:
      rescues.Run.tick_cage.loop22(_t22, run, inputs, captive, players, cx, cy, trying)

def rescues.Run.tick_cage.loop22(+_xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +inputs: J.Val, +captive: J.Val, +players: J.Val, +cx: F32, +cy: F32, +trying: U32) -> J.Val:
  match _xs:
    case Nil{}:
      rescues.Run.tick_cage.k15(run, inputs, captive, players, cx, cy, trying)
    case Con{+_h22, +_t22}:
      (+k, +h) = _h22
      +input = {J.get(inputs, k) : J.Val}
      rescues.Run.tick_cage.if23(Bool.and(U32.is_zero(trying), Bool.and(U32.is_gt(core.u(h, "hp"), 0), Bool.and(Bool.not(core.b(h, "stone")), Bool.and(F32.is_lt(RS.f_hypot(F32.sub(core.f(h, "x"), cx), F32.sub(core.f(h, "y"), cy)), rescues.CAGE_REACH()), Bool.and(Bool.not(J.is_null(input)), Bool.and(rules.Input.valid(input), core.b(input, "interact"))))))), run, inputs, captive, players, cx, cy, trying, _t22, k)

def rescues.Run.tick_cage.if14(c: Bool, +run: J.Val, +inputs: J.Val, +captive: J.Val, +players: J.Val, +cx: F32, +cy: F32) -> J.Val:
  match c:
    case True{}:
      +trying = {0 : U32}
      rescues.Run.tick_cage.loop22(J.int_fields(players), run, inputs, captive, players, cx, cy, trying)
    case False{}:
      rescues.Run.tick_cage.k4(run, inputs, captive, players, cx, cy)

def rescues.Run.tick_cage.k3(+run: J.Val, +inputs: J.Val, +captive: J.Val) -> J.Val:
  +players = {J.get(run, "players") : J.Val}
  +cx = {core.f(captive, "x") : F32}
  +cy = {core.f(captive, "y") : F32}
  +at_room = {J.nth(J.get(J.get(run, "dungeon"), "rooms"), core.u(run, "at")) : J.Val}
  rescues.Run.tick_cage.if14(Bool.and(String.eq(core.s(captive, "who"), swamp.HORSE()), Bool.not(core.b(at_room, "cleared"))), run, inputs, captive, players, cx, cy)

def rescues.Run.tick_cage.if24(c: Bool, +run: J.Val, +inputs: J.Val, +captive: J.Val) -> J.Val:
  match c:
    case True{}:
      run
    case False{}:
      rescues.Run.tick_cage.k3(run, inputs, captive)

def rescues.Run.tick_cage.k2(+run: J.Val, +inputs: J.Val, +captive: J.Val) -> J.Val:
  rescues.Run.tick_cage.if24(Bool.not(J.is_null(J.get(captive, "freed"))), run, inputs, captive)

def rescues.Run.tick_cage.if25(c: Bool, +run: J.Val, +inputs: J.Val, +captive: J.Val) -> J.Val:
  match c:
    case True{}:
      run
    case False{}:
      rescues.Run.tick_cage.k2(run, inputs, captive)

def rescues.Run.tick_cage.k1(+run: J.Val, +inputs: J.Val, +captive: J.Val) -> J.Val:
  rescues.Run.tick_cage.if25(Bool.not(U32.is_eq(core.u(captive, "room"), core.u(run, "at"))), run, inputs, captive)

def rescues.Run.tick_cage.if26(c: Bool, +run: J.Val, +inputs: J.Val, +captive: J.Val) -> J.Val:
  match c:
    case True{}:
      run
    case False{}:
      rescues.Run.tick_cage.k1(run, inputs, captive)
