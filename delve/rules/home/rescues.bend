      +run = {swamp.Run.horse_freed(run, by) : J.Val}
      rescues.Run.tick_cage.k6(run)
    case False{}:
      rescues.Run.tick_cage.k6(run)

def rescues.Run.tick_cage.if7(c: Bool, +run: J.Val, +captive: J.Val, +freed: Bool, +by: U32) -> J.Val:
  match c:
    case True{}:
      +who = {core.s(captive, "who") : String}
      +run = {J.set(run, "captive", J.set(captive, "freed", J.get(run, "tick"))) : J.Val}
      +marks = {J.get(run, "marks") : J.Val}
      +run = {J.set(run, "marks", J.set(marks, "rescue:" ++ who, J.JU{(core.u(marks, "rescue:" ++ who) + 1 : U32)})) : J.Val}
      +run = {J.set(run, "cues", J.push(J.get(run, "cues"), J.JS{"rescued:" ++ who})) : J.Val}
      +run = {J.set(run, "sounds", J.push(J.get(run, "sounds"), J.JS{"door_open"})) : J.Val}
      +run = {rules.Run.notice(run, "rescuer") : J.Val}
      rescues.Run.tick_cage.if8(String.eq(who, swamp.HORSE()), run, by)
    case False{}:
      rescues.Run.tick_cage.k6(run)

