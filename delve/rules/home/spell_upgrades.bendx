# crates/delve/src/rules/spell_upgrades.rs — a knight's own spell ladders, the Hero and minion
# sides (the tables are _spell_tiers.bend). Written in bendx (delve/rules/core/_tools/bendx.py).

# `Hero::spell_tier`: a wish spell keeps its phrasebook ladder (tier I here).
def spell_upgrades.Hero.spell_tier(h: J.Val, id: String) -> U32:
    if String.starts_with(id, "wish-"):
        return 0
    return U32.min(core.u(J.get(h, "spell_tiers"), id), 2)

# `Hero::spell_step`: the tier's other numbers (warden_hp, rip_reach, ..., imposture).
def spell_upgrades.Hero.spell_step(h: J.Val, id: String) -> J.Val:
    return spell_upgrades.step(spell_upgrades.Hero.spell_tier(h, id))

# The tier's table entry for `base`, or `base` past the table.
def spell_upgrades.table(table: [U32], base: U32) -> U32:
    match (List.get(&2, U32, table, U32.to_nat(base)) : U32?):
        case Some{v: U32}:
            return v
        case None{}:
            return base
    return base

# `Hero::spell_power`
def spell_upgrades.Hero.spell_power(h: J.Val, id: String, base: U32) -> U32:
    return spell_upgrades.table(spell_upgrades.TIER_POWER(spell_upgrades.Hero.spell_tier(h, id)), base)

# `Hero::spell_damage`: the power, scaled by the knight's damage.
def spell_upgrades.Hero.spell_damage(h: J.Val, id: String, base: U32) -> U32:
    return hero.Hero.scaled(h, spell_upgrades.Hero.spell_power(h, id, base))

# `Hero::spell_wait`: the recharge in ticks of a spell card.
def spell_upgrades.Hero.spell_wait(h: J.Val, card: J.Val) -> U32:
    return spell_upgrades.table(spell_upgrades.TIER_WAIT(spell_upgrades.Hero.spell_tier(h, core.s(card, "id"))), U32.clamp(core.u(card, "cooldown"), 1, 120))

# `Hero::spell_name`
def spell_upgrades.Hero.spell_name(h: J.Val, card: J.Val) -> String:
    if String.starts_with(core.s(card, "id"), "wish-"):
        return core.s(card, "name")
    tier: U32 = spell_upgrades.Hero.spell_tier(h, core.s(card, "id"))
    if U32.is_eq(tier, 0):
        return core.s(card, "name") ++ " I"
    if U32.is_eq(tier, 1):
        return core.s(card, "name") ++ " II"
    return core.s(card, "name") ++ " III"

# `Run::minion_spell_power`: a summoned minion's number, at its summoner's spell tier.
def spell_upgrades.Run.minion_spell_power(run: J.Val, hire: J.Val, base: U32) -> U32:
    spell: String = ""
    kind: String = core.s(hire, "kind")
    if String.eq(kind, "Ghoul"):
        spell = "raise-ghoul"
    elif String.eq(kind, "Warden"):
        spell = "barrow-warden"
    elif String.eq(kind, "Totem"):
        spell = "bone-totem"
    else:
        return base
    summoner: J.Val = core.hero(run, core.u(hire, "summoner"))
    if Bool.or(J.is_null(J.get(hire, "summoner")), J.is_null(summoner)):
        return base
    return spell_upgrades.Hero.spell_power(summoner, spell, base)

# `Run::minion_spell_health`
def spell_upgrades.Run.minion_spell_health(run: J.Val, hire: J.Val, base: U32) -> U32:
    if String.eq(core.s(hire, "kind"), "Warden"):
        summoner: J.Val = core.hero(run, core.u(hire, "summoner"))
        if Bool.or(J.is_null(J.get(hire, "summoner")), J.is_null(summoner)):
            return base
        return core.u(spell_upgrades.Hero.spell_step(summoner, "barrow-warden"), "warden_hp")
    return spell_upgrades.Run.minion_spell_power(run, hire, base)
