# generated by bx.py from grow.bx: edit the .bx, not this file
# crates/delve/src/rules/layout.rs and world/routing.rs — a floor's cells: how
# they grow, and what they become (`Plan`). Cells are LayCell (i32 as U32 two's
# complement: adding a direction is a plain U32 add). `usize::MAX` is
# 4294967295 here too, as the "no door leads" / "none" mark.

# North, east, south, west.
def layout.DX(+d: U32) -> U32:
  match d:
    case 1:
      1
    case 3:
      4294967295
    case _:
      0
def layout.DY(+d: U32) -> U32:
  match d:
    case 0:
      4294967295
    case 2:
      1
    case _:
      0
# The room grid a floor grows in.
def layout.GRID() -> U32:
  5
def layout.mix64.shift(+h: W.W, +n: U32) -> W.W:
  W.xor(h, W.shr(h, n))
# rules.rs `mix`: the finisher the floor shapes are hashed with.
def layout.mix(+h0: W.W) -> W.W:
  +h1 = W.mul(layout.mix64.shift(h0, 33), W.W{4283543511, 3981806797})
  +h2 = W.mul(layout.mix64.shift(h1, 33), W.W{3301882366, 444984403})
  layout.mix64.shift(h2, 33)
# An i32 widened to u64 (`as u64`): sign-extended.
def layout.sext(+v: U32) -> W.W:
  layout.sext.k1(U32.is_ge(v, 2147483648), v)

def layout.sext.k1(cv: Bool, +v: U32) -> W.W:
  match cv:
    case True{}:
      W.W{4294967295, v}
    case False{}:
      W.W{0, v}
def layout.cells.len(+cells: List<&2, LayCell>) -> U32:
  U32.from_nat(List.length(&2, LayCell, cells))
def layout.cells.nth(+cells: List<&2, LayCell>, +i: U32) -> LayCell:
  layout.cells.nth.k1(cells, cells, i)

def layout.cells.nth.k2(cv: Bool, +i: U32, +h: LayCell, +t: List<&2, LayCell>) -> LayCell:
  match cv:
    case True{}:
      h
    case False{}:
      layout.cells.nth(t, (i - 1 : U32))

def layout.cells.nth.k1(sv0: List<&2, LayCell>, +cells: List<&2, LayCell>, +i: U32) -> LayCell:
  match sv0:
    case Nil{}:
      LayCell{0, 0}
    case Con{+h, +t}:
      layout.cells.nth.k2(U32.is_eq(i, 0), i, h, t)
def layout.cells.has(+cells: List<&2, LayCell>, +x: U32, +y: U32) -> Bool:
  U32.is_ne(layout.cells.pos(cells, x, y), 4294967295)
# The index of the cell (x, y), or usize::MAX.
def layout.cells.pos(+cells: List<&2, LayCell>, +x: U32, +y: U32) -> U32:
  layout.cells.pos.go(cells, x, y, 0)
def layout.cells.pos.go(+cells: List<&2, LayCell>, +x: U32, +y: U32, +i: U32) -> U32:
  layout.cells.pos.go.k1(cells, cells, x, y, i)

def layout.cells.pos.go.k2(cv: Bool, +x: U32, +y: U32, +i: U32, +h: LayCell, +t: List<&2, LayCell>) -> U32:
  match cv:
    case True{}:
      i
    case False{}:
      layout.cells.pos.go(t, x, y, (i + 1 : U32))

def layout.cells.pos.go.k1(sv0: List<&2, LayCell>, +cells: List<&2, LayCell>, +x: U32, +y: U32, +i: U32) -> U32:
  match sv0:
    case Nil{}:
      4294967295
    case Con{+h, +t}:
      layout.cells.pos.go.k2(layout.cell.is(h, x, y), x, y, i, h, t)
def layout.cell.is(+c: LayCell, +x: U32, +y: U32) -> Bool:
  layout.cell.is.k1(c, c, x, y)

def layout.cell.is.k1(sv0: LayCell, +c: LayCell, +x: U32, +y: U32) -> Bool:
  match sv0:
    case LayCell{+cx, +cy}:
      Bool.and(U32.is_eq(cx, x), U32.is_eq(cy, y))
# How many of the four sides of (x, y) hold a cell of the list.
def layout.cells.links(+cells: List<&2, LayCell>, +x: U32, +y: U32) -> U32:
  layout.cells.links.go(cells, x, y, 0)
def layout.cells.links.go(+cells: List<&2, LayCell>, +x: U32, +y: U32, +d: U32) -> U32:
  layout.cells.links.go.k1(U32.is_ge(d, 4), cells, x, y, d)

def layout.cells.links.go.k1(cv: Bool, +cells: List<&2, LayCell>, +x: U32, +y: U32, +d: U32) -> U32:
  match cv:
    case True{}:
      0
    case False{}:
      (Bool.to_u32(layout.cells.has(cells, (x + layout.DX(d) : U32), (y + layout.DY(d) : U32))) + layout.cells.links.go(cells, x, y, (d + 1 : U32)) : U32)
# Approach floors
# ---------------

def layout.near_grid(+v: U32) -> Bool:
  U32.is_lt(v, 5)
# Keep the approach floors' established seed stream.
def layout.approach_cells(+requested: U32, +rng: W.W) -> List<&2, LayCell> & W.W:
  layout.approach.grow(Con{LayCell{2, 2}, Nil{}}, U32.min(requested, 25), rng, 4096)
def layout.approach.grow(+cells: List<&2, LayCell>, +want: U32, +rng: W.W, +left: U32) -> List<&2, LayCell> & W.W:
  layout.approach.grow.k1(U32.is_ge(layout.cells.len(cells), want), cells, want, rng, left)

def layout.approach.grow.k6(cv: Bool, +cells: List<&2, LayCell>, +want: U32, +left: U32, +rng2: W.W, +nx: U32, +ny: U32) -> List<&2, LayCell> & W.W:
  match cv:
    case True{}:
      layout.approach.grow(List.append(&2, LayCell, cells, [LayCell{nx, ny}]), want, rng2, (left - 1 : U32))
    case False{}:
      layout.approach.grow(cells, want, rng2, (left - 1 : U32))

def layout.approach.grow.k5(pr: W.W & U32, +cells: List<&2, LayCell>, +want: U32, +left: U32, +x: U32, +y: U32) -> List<&2, LayCell> & W.W:
  (+rng2, +d) = pr
  +nx = (x + layout.DX(d) : U32)
  +ny = (y + layout.DY(d) : U32)
  layout.approach.grow.k6(Bool.and(Bool.and(layout.near_grid(nx), layout.near_grid(ny)), Bool.not(layout.cells.has(cells, nx, ny))), cells, want, left, rng2, nx, ny)

def layout.approach.grow.k4(pr: LayCell, +cells: List<&2, LayCell>, +want: U32, +left: U32, +rng1: W.W) -> List<&2, LayCell> & W.W:
  match pr:
    case LayCell{+x, +y}:
      layout.approach.grow.k5(layout.rng.below(rng1, 4), cells, want, left, x, y)

def layout.approach.grow.k3(pr: W.W & U32, +cells: List<&2, LayCell>, +want: U32, +left: U32) -> List<&2, LayCell> & W.W:
  (+rng1, +i) = pr
  layout.approach.grow.k4(layout.cells.nth(cells, i), cells, want, left, rng1)

def layout.approach.grow.k2(cv: Bool, +cells: List<&2, LayCell>, +want: U32, +rng: W.W, +left: U32) -> List<&2, LayCell> & W.W:
  match cv:
    case True{}:
      (layout.approach.fill(cells, want), rng)
    case False{}:
      layout.approach.grow.k3(layout.rng.below(rng, layout.cells.len(cells)), cells, want, left)

def layout.approach.grow.k1(cv: Bool, +cells: List<&2, LayCell>, +want: U32, +rng: W.W, +left: U32) -> List<&2, LayCell> & W.W:
  match cv:
    case True{}:
      (cells, rng)
    case False{}:
      layout.approach.grow.k2(U32.is_eq(left, 0), cells, want, rng, left)
# The fallback: connected expansion, the first free cell beside the first cell
# that has one.
def layout.approach.fill(+cells: List<&2, LayCell>, +want: U32) -> List<&2, LayCell>:
  layout.approach.fill.k1(U32.is_ge(layout.cells.len(cells), want), cells, want)

def layout.approach.fill.k1(cv: Bool, +cells: List<&2, LayCell>, +want: U32) -> List<&2, LayCell>:
  match cv:
    case True{}:
      cells
    case False{}:
      +found = layout.approach.find(cells, cells)
      layout.approach.fill.push(found, cells, want)
def layout.approach.fill.push(+found: LayFind, +cells: List<&2, LayCell>, +want: U32) -> List<&2, LayCell>:
  layout.approach.fill.push.k1(found, found, cells, want)

def layout.approach.fill.push.k2(cv: Bool, +cells: List<&2, LayCell>, +want: U32, +ok: Bool, +a: U32, +b: U32) -> List<&2, LayCell>:
  match cv:
    case True{}:
      layout.approach.fill(List.append(&2, LayCell, cells, [LayCell{a, b}]), want)
    case False{}:
      cells

def layout.approach.fill.push.k1(sv0: LayFind, +found: LayFind, +cells: List<&2, LayCell>, +want: U32) -> List<&2, LayCell>:
  match sv0:
    case LayFind{+ok, +a, +b}:
      layout.approach.fill.push.k2(ok, cells, want, ok, a, b)
def layout.approach.find(+all: List<&2, LayCell>, +rest: List<&2, LayCell>) -> LayFind:
  layout.approach.find.k1(rest, all, rest)

def layout.approach.find.k1(sv0: List<&2, LayCell>, +all: List<&2, LayCell>, +rest: List<&2, LayCell>) -> LayFind:
  match sv0:
    case Nil{}:
      LayFind{False{}, 0, 0}
    case Con{+h, +t}:
      +f = layout.approach.find.dir(all, h, 0)
      layout.approach.find.next(f, all, t)
def layout.approach.find.next(+f: LayFind, +all: List<&2, LayCell>, +t: List<&2, LayCell>) -> LayFind:
  layout.approach.find.next.k1(f, f, all, t)

def layout.approach.find.next.k2(cv: Bool, +f: LayFind, +all: List<&2, LayCell>, +t: List<&2, LayCell>, +ok: Bool) -> LayFind:
  match cv:
    case True{}:
      f
    case False{}:
      layout.approach.find(all, t)

def layout.approach.find.next.k1(sv0: LayFind, +f: LayFind, +all: List<&2, LayCell>, +t: List<&2, LayCell>) -> LayFind:
  match sv0:
    case LayFind{+ok, +a, +b}:
      layout.approach.find.next.k2(ok, f, all, t, ok)
def layout.approach.find.dir(+all: List<&2, LayCell>, +h: LayCell, +d: U32) -> LayFind:
  layout.approach.find.dir.k1(U32.is_ge(d, 4), all, h, d)

def layout.approach.find.dir.k3(cv: Bool, +all: List<&2, LayCell>, +h: LayCell, +d: U32, +nx: U32, +ny: U32) -> LayFind:
  match cv:
    case True{}:
      LayFind{True{}, nx, ny}
    case False{}:
      layout.approach.find.dir(all, h, (d + 1 : U32))

def layout.approach.find.dir.k2(pr: LayCell, +all: List<&2, LayCell>, +h: LayCell, +d: U32) -> LayFind:
  match pr:
    case LayCell{+x, +y}:
      +nx = (x + layout.DX(d) : U32)
      +ny = (y + layout.DY(d) : U32)
      layout.approach.find.dir.k3(Bool.and(Bool.and(layout.near_grid(nx), layout.near_grid(ny)), Bool.not(layout.cells.has(all, nx, ny))), all, h, d, nx, ny)

def layout.approach.find.dir.k1(cv: Bool, +all: List<&2, LayCell>, +h: LayCell, +d: U32) -> LayFind:
  match cv:
    case True{}:
      LayFind{False{}, 0, 0}
    case False{}:
      layout.approach.find.dir.k2(h, all, h, d)
# Tunnels (world/routing.rs)
# --------------------------

# TunnelVariant::for_depth: 0 gallery, 1 warrens, 2 karst.
def layout.tunnel_variant(+depth: U32) -> U32:
  layout.tunnel_variant.mod(U32.sub(depth, 3), U32.is_lt(depth, 3))
def layout.tunnel_variant.mod(+d: U32, +under: Bool) -> U32:
  layout.tunnel_variant.mod.k1(under, d, under)

def layout.tunnel_variant.mod.k1(cv: Bool, +d: U32, +under: Bool) -> U32:
  match cv:
    case True{}:
      0
    case False{}:
      U32.mod(d, 3)
# A sorted, duplicate-free cell list (a BTreeSet<(i32, i32)> of non-negative cells).
def layout.set.insert(+set: List<&2, LayCell>, +x: U32, +y: U32) -> List<&2, LayCell>:
  layout.set.insert.k1(set, set, x, y)

def layout.set.insert.k4(cv: Bool, +set: List<&2, LayCell>, +x: U32, +y: U32, +h: LayCell, +t: List<&2, LayCell>, +hx: U32, +hy: U32) -> List<&2, LayCell>:
  match cv:
    case True{}:
      set
    case False{}:
      Con{h, layout.set.insert(t, x, y)}

def layout.set.insert.k3(cv: Bool, +set: List<&2, LayCell>, +x: U32, +y: U32, +h: LayCell, +t: List<&2, LayCell>, +hx: U32, +hy: U32) -> List<&2, LayCell>:
  match cv:
    case True{}:
      Con{LayCell{x, y}, set}
    case False{}:
      layout.set.insert.k4(Bool.and(U32.is_eq(x, hx), U32.is_eq(y, hy)), set, x, y, h, t, hx, hy)

def layout.set.insert.k2(pr: LayCell, +set: List<&2, LayCell>, +x: U32, +y: U32, +h: LayCell, +t: List<&2, LayCell>) -> List<&2, LayCell>:
  match pr:
    case LayCell{+hx, +hy}:
      layout.set.insert.k3(Bool.or(U32.is_lt(x, hx), Bool.and(U32.is_eq(x, hx), U32.is_lt(y, hy))), set, x, y, h, t, hx, hy)

def layout.set.insert.k1(sv0: List<&2, LayCell>, +set: List<&2, LayCell>, +x: U32, +y: U32) -> List<&2, LayCell>:
  match sv0:
    case Nil{}:
      [LayCell{x, y}]
    case Con{+h, +t}:
      layout.set.insert.k2(h, set, x, y, h, t)
# Every free cell beside the cells, in (x, y) order.
def layout.tunnel.frontier(+cells: List<&2, LayCell>, +all: List<&2, LayCell>, +width: U32, +acc: List<&2, LayCell>) -> List<&2, LayCell>:
  layout.tunnel.frontier.k1(cells, cells, all, width, acc)

def layout.tunnel.frontier.k2(pr: LayCell, +all: List<&2, LayCell>, +width: U32, +acc: List<&2, LayCell>, +t: List<&2, LayCell>) -> List<&2, LayCell>:
  match pr:
    case LayCell{+x, +y}:
      layout.tunnel.frontier(t, all, width, layout.tunnel.frontier.dirs(x, y, 0, all, width, acc))

def layout.tunnel.frontier.k1(sv0: List<&2, LayCell>, +cells: List<&2, LayCell>, +all: List<&2, LayCell>, +width: U32, +acc: List<&2, LayCell>) -> List<&2, LayCell>:
  match sv0:
    case Nil{}:
      acc
    case Con{+h, +t}:
      layout.tunnel.frontier.k2(h, all, width, acc, t)
def layout.tunnel.frontier.dirs(+x: U32, +y: U32, +d: U32, +all: List<&2, LayCell>, +width: U32, +acc: List<&2, LayCell>) -> List<&2, LayCell>:
  layout.tunnel.frontier.dirs.k1(U32.is_ge(d, 4), x, y, d, all, width, acc)

def layout.tunnel.frontier.dirs.k2(cv: Bool, +x: U32, +y: U32, +d: U32, +all: List<&2, LayCell>, +width: U32, +acc: List<&2, LayCell>, +nx: U32, +ny: U32) -> List<&2, LayCell>:
  match cv:
    case True{}:
      layout.tunnel.frontier.dirs(x, y, (d + 1 : U32), all, width, layout.set.insert(acc, nx, ny))
    case False{}:
      layout.tunnel.frontier.dirs(x, y, (d + 1 : U32), all, width, acc)

def layout.tunnel.frontier.dirs.k1(cv: Bool, +x: U32, +y: U32, +d: U32, +all: List<&2, LayCell>, +width: U32, +acc: List<&2, LayCell>) -> List<&2, LayCell>:
  match cv:
    case True{}:
      acc
    case False{}:
      +nx = (x + layout.DX(d) : U32)
      +ny = (y + layout.DY(d) : U32)
      layout.tunnel.frontier.dirs.k2(Bool.and(Bool.and(U32.is_lt(nx, width), U32.is_lt(ny, width)), Bool.not(layout.cells.has(all, nx, ny))), x, y, d, all, width, acc, nx, ny)
def layout.tunnel.degree(+c: LayCell, +all: List<&2, LayCell>) -> U32:
  layout.tunnel.degree.k1(c, c, all)

def layout.tunnel.degree.k1(sv0: LayCell, +c: LayCell, +all: List<&2, LayCell>) -> U32:
  match sv0:
    case LayCell{+x, +y}:
      layout.cells.links(all, x, y)
def layout.absdiff(+a: U32, +b: U32) -> U32:
  layout.absdiff.k1(U32.is_ge(a, b), a, b)

def layout.absdiff.k1(cv: Bool, +a: U32, +b: U32) -> U32:
  match cv:
    case True{}:
      (a - b : U32)
    case False{}:
      (b - a : U32)
# The Manhattan distance between two cells.
def layout.tunnel.manhattan(+c: LayCell, +l: LayCell) -> U32:
  layout.tunnel.manhattan.k1(c, l)

def layout.tunnel.manhattan.k2(pr: LayCell, +x: U32, +y: U32) -> U32:
  match pr:
    case LayCell{+lx, +ly}:
      (layout.absdiff(x, lx) + layout.absdiff(y, ly) : U32)

def layout.tunnel.manhattan.k1(pr: LayCell, +l: LayCell) -> U32:
  match pr:
    case LayCell{+x, +y}:
      layout.tunnel.manhattan.k2(l, x, y)
def layout.cell.y(+c: LayCell) -> U32:
  layout.cell.y.k1(c, c)

def layout.cell.y.k1(sv0: LayCell, +c: LayCell) -> U32:
  match sv0:
    case LayCell{+x, +y}:
      y
def layout.cells.last(+cells: List<&2, LayCell>) -> LayCell:
  layout.cells.last.k1(cells, cells)

def layout.cells.last.k2(cv: Bool, +h: LayCell, +t: List<&2, LayCell>) -> LayCell:
  match cv:
    case True{}:
      h
    case False{}:
      layout.cells.last(t)

def layout.cells.last.k1(sv0: List<&2, LayCell>, +cells: List<&2, LayCell>) -> LayCell:
  match sv0:
    case Nil{}:
      LayCell{0, 0}
    case Con{+h, +t}:
      layout.cells.last.k2(List.is_empty(&2, LayCell, t), h, t)
# (degree, distance to the last cell) as one comparable number.
def layout.tunnel.gallery_key(+c: LayCell, +all: List<&2, LayCell>, +last: LayCell) -> U32:
  (layout.tunnel.degree(c, all) * 65536 + layout.tunnel.manhattan(c, last) : U32)
def layout.tunnel.min_key(+fr: List<&2, LayCell>, +all: List<&2, LayCell>, +last: LayCell, +best: U32) -> U32:
  layout.tunnel.min_key.k1(fr, fr, all, last, best)

def layout.tunnel.min_key.k1(sv0: List<&2, LayCell>, +fr: List<&2, LayCell>, +all: List<&2, LayCell>, +last: LayCell, +best: U32) -> U32:
  match sv0:
    case Nil{}:
      best
    case Con{+h, +t}:
      layout.tunnel.min_key(t, all, last, U32.min(best, layout.tunnel.gallery_key(h, all, last)))
def layout.tunnel.keep_key(+fr: List<&2, LayCell>, +all: List<&2, LayCell>, +last: LayCell, +key: U32) -> List<&2, LayCell>:
  layout.tunnel.keep_key.k1(fr, fr, all, last, key)

def layout.tunnel.keep_key.k2(cv: Bool, +all: List<&2, LayCell>, +last: LayCell, +key: U32, +h: LayCell, +t: List<&2, LayCell>) -> List<&2, LayCell>:
  match cv:
    case True{}:
      Con{h, layout.tunnel.keep_key(t, all, last, key)}
    case False{}:
      layout.tunnel.keep_key(t, all, last, key)

def layout.tunnel.keep_key.k1(sv0: List<&2, LayCell>, +fr: List<&2, LayCell>, +all: List<&2, LayCell>, +last: LayCell, +key: U32) -> List<&2, LayCell>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      layout.tunnel.keep_key.k2(U32.is_eq(layout.tunnel.gallery_key(h, all, last), key), all, last, key, h, t)
def layout.tunnel.max_degree(+fr: List<&2, LayCell>, +all: List<&2, LayCell>, +best: U32) -> U32:
  layout.tunnel.max_degree.k1(fr, fr, all, best)

def layout.tunnel.max_degree.k1(sv0: List<&2, LayCell>, +fr: List<&2, LayCell>, +all: List<&2, LayCell>, +best: U32) -> U32:
  match sv0:
    case Nil{}:
      best
    case Con{+h, +t}:
      layout.tunnel.max_degree(t, all, U32.max(best, layout.tunnel.degree(h, all)))
def layout.tunnel.keep_degree(+fr: List<&2, LayCell>, +all: List<&2, LayCell>, +deg: U32) -> List<&2, LayCell>:
  layout.tunnel.keep_degree.k1(fr, fr, all, deg)

def layout.tunnel.keep_degree.k2(cv: Bool, +all: List<&2, LayCell>, +deg: U32, +h: LayCell, +t: List<&2, LayCell>) -> List<&2, LayCell>:
  match cv:
    case True{}:
      Con{h, layout.tunnel.keep_degree(t, all, deg)}
    case False{}:
      layout.tunnel.keep_degree(t, all, deg)

def layout.tunnel.keep_degree.k1(sv0: List<&2, LayCell>, +fr: List<&2, LayCell>, +all: List<&2, LayCell>, +deg: U32) -> List<&2, LayCell>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      layout.tunnel.keep_degree.k2(U32.is_eq(layout.tunnel.degree(h, all), deg), all, deg, h, t)
# A stable insertion by the cell's y.
def layout.tunnel.by_y(+fr: List<&2, LayCell>) -> List<&2, LayCell>:
  layout.tunnel.by_y.k1(fr, fr)

def layout.tunnel.by_y.k1(sv0: List<&2, LayCell>, +fr: List<&2, LayCell>) -> List<&2, LayCell>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      layout.tunnel.by_y.ins(h, layout.tunnel.by_y(t))
def layout.tunnel.by_y.ins(+c: LayCell, +sorted: List<&2, LayCell>) -> List<&2, LayCell>:
  layout.tunnel.by_y.ins.k1(sorted, c, sorted)

def layout.tunnel.by_y.ins.k2(cv: Bool, +c: LayCell, +sorted: List<&2, LayCell>, +h: LayCell, +t: List<&2, LayCell>) -> List<&2, LayCell>:
  match cv:
    case True{}:
      Con{c, sorted}
    case False{}:
      Con{h, layout.tunnel.by_y.ins(c, t)}

def layout.tunnel.by_y.ins.k1(sv0: List<&2, LayCell>, +c: LayCell, +sorted: List<&2, LayCell>) -> List<&2, LayCell>:
  match sv0:
    case Nil{}:
      [c]
    case Con{+h, +t}:
      layout.tunnel.by_y.ins.k2(U32.is_le(layout.cell.y(c), layout.cell.y(h)), c, sorted, h, t)
# The frontier narrowed the way the variant favours.
def layout.tunnel.narrow(+variant: U32, +fr: List<&2, LayCell>, +all: List<&2, LayCell>) -> List<&2, LayCell>:
  match variant:
    case 0:
      +last = layout.cells.last(all)
      +key = layout.tunnel.min_key(fr, all, last, 4294967295)
      layout.tunnel.by_y(layout.tunnel.keep_key(fr, all, last, key))
    case 1:
      fr
    case _:
      layout.tunnel.keep_degree(fr, all, layout.tunnel.max_degree(fr, all, 0))
# xorshift64 (the tunnel's own generator): one step.
def layout.tunnel.xorshift(+r0: W.W) -> W.W:
  +r1 = W.xor(r0, W.shl(r0, 13))
  +r2 = W.xor(r1, W.shr(r1, 7))
  W.xor(r2, W.shl(r2, 17))
def layout.tunnel.grow(+variant: U32, +cells: List<&2, LayCell>, +want: U32, +width: U32, +random: W.W) -> List<&2, LayCell>:
  layout.tunnel.grow.k1(U32.is_ge(layout.cells.len(cells), want), variant, cells, want, width, random)

def layout.tunnel.grow.k2(cv: Bool, +variant: U32, +cells: List<&2, LayCell>, +want: U32, +width: U32, +r: W.W, +narrowed: List<&2, LayCell>, +n: U32) -> List<&2, LayCell>:
  match cv:
    case True{}:
      cells
    case False{}:
      +pick = layout.cells.nth(narrowed, W.rem_u32(r, n))
      layout.tunnel.grow(variant, List.append(&2, LayCell, cells, [pick]), want, width, r)

def layout.tunnel.grow.k1(cv: Bool, +variant: U32, +cells: List<&2, LayCell>, +want: U32, +width: U32, +random: W.W) -> List<&2, LayCell>:
  match cv:
    case True{}:
      cells
    case False{}:
      +fr = layout.tunnel.frontier(cells, cells, width, Nil{})
      +r = layout.tunnel.xorshift(random)
      +narrowed = layout.tunnel.narrow(variant, fr, cells)
      +n = layout.cells.len(narrowed)
      layout.tunnel.grow.k2(U32.is_eq(n, 0), variant, cells, want, width, r, narrowed, n)
# `tunnel_cells(variant, seed, width, requested)`.
def layout.tunnel_cells(+variant: U32, +seed: W.W, +width: U32, +requested: U32) -> List<&2, LayCell>:
  layout.tunnel_cells.k1(Bool.or(Bool.or(U32.is_eq(width, 0), U32.is_gt(width, 16)), U32.is_eq(requested, 0)), variant, seed, width, requested)

def layout.tunnel_cells.k1(cv: Bool, +variant: U32, +seed: W.W, +width: U32, +requested: U32) -> List<&2, LayCell>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      layout.tunnel.grow(variant, [LayCell{layout.half(width), layout.half(width)}], U32.min(requested, (width * width : U32)), width, W.or(seed, W.W{0, 1}))
# Plan
# ----

def layout.list.u32_nth(+xs: List<&2, U32>, +i: U32) -> U32:
  layout.list.u32_nth.k1(xs, xs, i)

def layout.list.u32_nth.k2(cv: Bool, +i: U32, +h: U32, +t: List<&2, U32>) -> U32:
  match cv:
    case True{}:
      h
    case False{}:
      layout.list.u32_nth(t, (i - 1 : U32))

def layout.list.u32_nth.k1(sv0: List<&2, U32>, +xs: List<&2, U32>, +i: U32) -> U32:
  match sv0:
    case Nil{}:
      4294967295
    case Con{+h, +t}:
      layout.list.u32_nth.k2(U32.is_eq(i, 0), i, h, t)
def layout.list.u32_set(+xs: List<&2, U32>, +i: U32, +v: U32) -> List<&2, U32>:
  layout.list.u32_set.k1(xs, xs, i, v)

def layout.list.u32_set.k2(cv: Bool, +i: U32, +v: U32, +h: U32, +t: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      Con{v, t}
    case False{}:
      Con{h, layout.list.u32_set(t, (i - 1 : U32), v)}

def layout.list.u32_set.k1(sv0: List<&2, U32>, +xs: List<&2, U32>, +i: U32, +v: U32) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      layout.list.u32_set.k2(U32.is_eq(i, 0), i, v, h, t)
def layout.list.u32_has(+xs: List<&2, U32>, +v: U32) -> Bool:
  layout.list.u32_has.k1(xs, xs, v)

def layout.list.u32_has.k2(cv: Bool, +v: U32, +h: U32, +t: List<&2, U32>) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.list.u32_has(t, v)

def layout.list.u32_has.k1(sv0: List<&2, U32>, +xs: List<&2, U32>, +v: U32) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+h, +t}:
      layout.list.u32_has.k2(U32.is_eq(h, v), v, h, t)
def layout.list.u32_len(+xs: List<&2, U32>) -> U32:
  U32.from_nat(List.length(&2, U32, xs))
def layout.list.u32_fill(+n: U32, +v: U32) -> List<&2, U32>:
  layout.list.u32_fill.k1(U32.is_eq(n, 0), n, v)

def layout.list.u32_fill.k1(cv: Bool, +n: U32, +v: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      Con{v, layout.list.u32_fill((n - 1 : U32), v)}
# Breadth-first distances from the entrance (cell 0): level by level.
def layout.Plan.bfs(+cells: List<&2, LayCell>, +dist: List<&2, U32>, +frontier: List<&2, U32>, +d: U32) -> List<&2, U32>:
  layout.Plan.bfs.k1(frontier, cells, dist, frontier, d)

def layout.Plan.bfs.k2(pr: List<&2, U32> & List<&2, U32>, +cells: List<&2, LayCell>, +d: U32) -> List<&2, U32>:
  (+dist2, +next) = pr
  layout.Plan.bfs(cells, dist2, next, (d + 1 : U32))

def layout.Plan.bfs.k1(sv0: List<&2, U32>, +cells: List<&2, LayCell>, +dist: List<&2, U32>, +frontier: List<&2, U32>, +d: U32) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      dist
    case Con{+h, +t}:
      layout.Plan.bfs.k2(layout.Plan.bfs.level(cells, dist, frontier, d, Nil{}), cells, d)
# One level: every undiscovered neighbour of the frontier gets distance d + 1.
def layout.Plan.bfs.level(+cells: List<&2, LayCell>, +dist: List<&2, U32>, +frontier: List<&2, U32>, +d: U32, +next: List<&2, U32>) -> List<&2, U32> & List<&2, U32>:
  layout.Plan.bfs.level.k1(frontier, cells, dist, frontier, d, next)

def layout.Plan.bfs.level.k2(pr: LayCell, +cells: List<&2, LayCell>, +dist: List<&2, U32>, +d: U32, +next: List<&2, U32>, +t: List<&2, U32>) -> List<&2, U32> & List<&2, U32>:
  match pr:
    case LayCell{+x, +y}:
      layout.Plan.bfs.dirs(cells, dist, t, d, next, x, y, 0)

def layout.Plan.bfs.level.k1(sv0: List<&2, U32>, +cells: List<&2, LayCell>, +dist: List<&2, U32>, +frontier: List<&2, U32>, +d: U32, +next: List<&2, U32>) -> List<&2, U32> & List<&2, U32>:
  match sv0:
    case Nil{}:
      (dist, next)
    case Con{+h, +t}:
      layout.Plan.bfs.level.k2(layout.cells.nth(cells, h), cells, dist, d, next, t)
def layout.Plan.bfs.dirs(+cells: List<&2, LayCell>, +dist: List<&2, U32>, +rest: List<&2, U32>, +d: U32, +next: List<&2, U32>, +x: U32, +y: U32, +k: U32) -> List<&2, U32> & List<&2, U32>:
  layout.Plan.bfs.dirs.k1(U32.is_ge(k, 4), cells, dist, rest, d, next, x, y, k)

def layout.Plan.bfs.dirs.k2(cv: Bool, +cells: List<&2, LayCell>, +dist: List<&2, U32>, +rest: List<&2, U32>, +d: U32, +next: List<&2, U32>, +x: U32, +y: U32, +k: U32, +j: U32) -> List<&2, U32> & List<&2, U32>:
  match cv:
    case True{}:
      layout.Plan.bfs.dirs(cells, layout.list.u32_set(dist, j, (d + 1 : U32)), rest, d, List.append(&2, U32, next, [j]), x, y, (k + 1 : U32))
    case False{}:
      layout.Plan.bfs.dirs(cells, dist, rest, d, next, x, y, (k + 1 : U32))

def layout.Plan.bfs.dirs.k1(cv: Bool, +cells: List<&2, LayCell>, +dist: List<&2, U32>, +rest: List<&2, U32>, +d: U32, +next: List<&2, U32>, +x: U32, +y: U32, +k: U32) -> List<&2, U32> & List<&2, U32>:
  match cv:
    case True{}:
      layout.Plan.bfs.level(cells, dist, rest, d, next)
    case False{}:
      +j = layout.cells.pos(cells, (x + layout.DX(k) : U32), (y + layout.DY(k) : U32))
      layout.Plan.bfs.dirs.k2(Bool.and(U32.is_ne(j, 4294967295), U32.is_eq(layout.list.u32_nth(dist, j), 4294967295)), cells, dist, rest, d, next, x, y, k, j)
# The index of the last maximum of dist over 1..n.
def layout.Plan.far(+dist: List<&2, U32>, +i: U32, +n: U32, +best: U32) -> U32:
  layout.Plan.far.k1(U32.is_ge(i, n), dist, i, n, best)

def layout.Plan.far.k2(cv: Bool, +dist: List<&2, U32>, +i: U32, +n: U32, +best: U32) -> U32:
  match cv:
    case True{}:
      layout.Plan.far(dist, (i + 1 : U32), n, i)
    case False{}:
      layout.Plan.far(dist, (i + 1 : U32), n, best)

def layout.Plan.far.k1(cv: Bool, +dist: List<&2, U32>, +i: U32, +n: U32, +best: U32) -> U32:
  match cv:
    case True{}:
      best
    case False{}:
      layout.Plan.far.k2(Bool.or(U32.is_eq(best, 0), U32.is_ge(layout.list.u32_nth(dist, i), layout.list.u32_nth(dist, best))), dist, i, n, best)
# The last maximum of (dead end, dist, i) over 1..n but `far` (usize::MAX when none).
def layout.Plan.treasure(+cells: List<&2, LayCell>, +dist: List<&2, U32>, +far: U32, +i: U32, +n: U32, +best: U32) -> U32:
  layout.Plan.treasure.k1(U32.is_ge(i, n), cells, dist, far, i, n, best)

def layout.Plan.treasure.k3(cv: Bool, +cells: List<&2, LayCell>, +dist: List<&2, U32>, +far: U32, +i: U32, +n: U32, +best: U32) -> U32:
  match cv:
    case True{}:
      layout.Plan.treasure(cells, dist, far, (i + 1 : U32), n, i)
    case False{}:
      layout.Plan.treasure(cells, dist, far, (i + 1 : U32), n, best)

def layout.Plan.treasure.k2(cv: Bool, +cells: List<&2, LayCell>, +dist: List<&2, U32>, +far: U32, +i: U32, +n: U32, +best: U32) -> U32:
  match cv:
    case True{}:
      layout.Plan.treasure(cells, dist, far, (i + 1 : U32), n, best)
    case False{}:
      layout.Plan.treasure.k3(Bool.or(U32.is_eq(best, 4294967295), layout.Plan.treasure.ge(cells, dist, i, best)), cells, dist, far, i, n, best)

def layout.Plan.treasure.k1(cv: Bool, +cells: List<&2, LayCell>, +dist: List<&2, U32>, +far: U32, +i: U32, +n: U32, +best: U32) -> U32:
  match cv:
    case True{}:
      best
    case False{}:
      layout.Plan.treasure.k2(U32.is_eq(i, far), cells, dist, far, i, n, best)
def layout.Plan.dead_end(+cells: List<&2, LayCell>, +i: U32) -> Bool:
  layout.Plan.dead_end.k1(layout.cells.nth(cells, i), cells, i)

def layout.Plan.dead_end.k1(sv0: LayCell, +cells: List<&2, LayCell>, +i: U32) -> Bool:
  match sv0:
    case LayCell{+x, +y}:
      U32.is_eq(layout.cells.links(cells, x, y), 1)
def layout.Plan.treasure.ge(+cells: List<&2, LayCell>, +dist: List<&2, U32>, +i: U32, +best: U32) -> Bool:
  +ki = (Bool.to_u32(layout.Plan.dead_end(cells, i)) : U32)
  +kb = (Bool.to_u32(layout.Plan.dead_end(cells, best)) : U32)
  +di = layout.list.u32_nth(dist, i)
  +db = layout.list.u32_nth(dist, best)
  layout.Plan.treasure.ge.k1(U32.is_gt(ki, kb), ki, kb, di, db)

def layout.Plan.treasure.ge.k2(cv: Bool, +ki: U32, +kb: U32, +di: U32, +db: U32) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      U32.is_ge(di, db)

def layout.Plan.treasure.ge.k1(cv: Bool, +ki: U32, +kb: U32, +di: U32, +db: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.Plan.treasure.ge.k2(U32.is_lt(ki, kb), ki, kb, di, db)
def layout.Plan.through(+cells: List<&2, LayCell>, +i: U32) -> Bool:
  layout.Plan.through.k1(layout.cells.nth(cells, i), cells, i)

def layout.Plan.through.k1(sv0: LayCell, +cells: List<&2, LayCell>, +i: U32) -> Bool:
  match sv0:
    case LayCell{+x, +y}:
      U32.is_eq(layout.cells.links(cells, x, y), 2)
# The pass-through cells that may become halls: not far, not the treasure,
# through-cells, distance past one; ascending index.
def layout.Plan.hall_candidates(+cells: List<&2, LayCell>, +dist: List<&2, U32>, +far: U32, +treasure: U32, +i: U32, +n: U32) -> List<&2, U32>:
  layout.Plan.hall_candidates.k1(U32.is_ge(i, n), cells, dist, far, treasure, i, n)

def layout.Plan.hall_candidates.k2(cv: Bool, +cells: List<&2, LayCell>, +dist: List<&2, U32>, +far: U32, +treasure: U32, +i: U32, +n: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      Con{i, layout.Plan.hall_candidates(cells, dist, far, treasure, (i + 1 : U32), n)}
    case False{}:
      layout.Plan.hall_candidates(cells, dist, far, treasure, (i + 1 : U32), n)

def layout.Plan.hall_candidates.k1(cv: Bool, +cells: List<&2, LayCell>, +dist: List<&2, U32>, +far: U32, +treasure: U32, +i: U32, +n: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      layout.Plan.hall_candidates.k2(Bool.and(Bool.and(U32.is_ne(i, far), U32.is_ne(i, treasure)), Bool.and(layout.Plan.through(cells, i), U32.is_gt(layout.list.u32_nth(dist, i), 1))), cells, dist, far, treasure, i, n)
# The first candidate of greatest distance.
def layout.Plan.hall_best(+dist: List<&2, U32>, +xs: List<&2, U32>, +best: U32) -> U32:
  layout.Plan.hall_best.k1(xs, dist, xs, best)

def layout.Plan.hall_best.k2(cv: Bool, +dist: List<&2, U32>, +best: U32, +h: U32, +t: List<&2, U32>) -> U32:
  match cv:
    case True{}:
      layout.Plan.hall_best(dist, t, h)
    case False{}:
      layout.Plan.hall_best(dist, t, best)

def layout.Plan.hall_best.k1(sv0: List<&2, U32>, +dist: List<&2, U32>, +xs: List<&2, U32>, +best: U32) -> U32:
  match sv0:
    case Nil{}:
      best
    case Con{+h, +t}:
      layout.Plan.hall_best.k2(Bool.or(U32.is_eq(best, 4294967295), U32.is_gt(layout.list.u32_nth(dist, h), layout.list.u32_nth(dist, best))), dist, best, h, t)
def layout.list.u32_remove(+xs: List<&2, U32>, +v: U32) -> List<&2, U32>:
  layout.list.u32_remove.k1(xs, xs, v)

def layout.list.u32_remove.k2(cv: Bool, +v: U32, +h: U32, +t: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      t
    case False{}:
      Con{h, layout.list.u32_remove(t, v)}

def layout.list.u32_remove.k1(sv0: List<&2, U32>, +xs: List<&2, U32>, +v: U32) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      layout.list.u32_remove.k2(U32.is_eq(h, v), v, h, t)
# Sorted by (distance descending, index), the first `k`.
def layout.Plan.halls_top(+dist: List<&2, U32>, +xs: List<&2, U32>, +k: U32) -> List<&2, U32>:
  layout.Plan.halls_top.k1(U32.is_eq(k, 0), dist, xs, k)

def layout.Plan.halls_top.k2(cv: Bool, +dist: List<&2, U32>, +xs: List<&2, U32>, +k: U32, +best: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      Con{best, layout.Plan.halls_top(dist, layout.list.u32_remove(xs, best), (k - 1 : U32))}

def layout.Plan.halls_top.k1(cv: Bool, +dist: List<&2, U32>, +xs: List<&2, U32>, +k: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      +best = layout.Plan.hall_best(dist, xs, 4294967295)
      layout.Plan.halls_top.k2(U32.is_eq(best, 4294967295), dist, xs, k, best)
def layout.Plan.of(+cells: List<&2, LayCell>) -> LayPlan:
  +n = layout.cells.len(cells)
  +dist = layout.Plan.bfs(cells, layout.list.u32_set(layout.list.u32_fill(n, 4294967295), 0, 0), [0], 0)
  +far = layout.Plan.far(dist, 1, n, 0)
  +treasure = layout.Plan.treasure(cells, dist, far, 1, n, 4294967295)
  +halls = layout.Plan.halls_top(dist, layout.Plan.hall_candidates(cells, dist, far, treasure, 1, n), 3)
  LayPlan{dist, far, treasure, halls}
