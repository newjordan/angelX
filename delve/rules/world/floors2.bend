# What the new floor is given: the forge hall, the steward's hall, a nook, the
# boss books, the cage, the follies.
def floors.finish.build(+run: J.Val, +depth: U32, +pack: String, +from_home: Bool) -> J.Val:
  +creation = Bool.and(J.bool(J.get(run, "identity")), U32.is_eq(depth, 1))
  +r1 = J.set(J.set(run, "parked", J.JA{Nil{}}), "at", J.JU{0})
  +r1a = J.set(rules.Run.stock_gear_cache(r1), "kingdom", J.set(J.get(r1, "kingdom"), "return_to", J.JNull{}))
  +r2 = floors.finish.build.k1(creation, creation, r1a)
  +mode = J.str(J.get(r2, "mode"))
  +r3 = floors.finish.build.k2(Bool.or(Bool.or(String.eq(mode, "hold_the_stair"), String.eq(mode, "gauntlet")), creation), creation, r2, mode)
  +r4 = J.set(J.set(nooks.Run.ready_nook(r3), "holding_used", J.JU{0}), "holding_raid", J.JNull{})
  +r5 = boss_gates.Run.populate_boss_gates(r4)
  +r6 = Bool.pick(J.Val, identity.Run.simple_creation(r5), J.set(r5, "boss_gates", J.JNull{}), r5)
  +r7 = folly.Run.pick_folly(rescues.Run.cage_someone(r6))
  +r8 = race3d.Run.pick_race3d(gantry.Run.pick_gantry(r7))
  +r9 = floors.finish.build.k3(Bool.or(Bool.not(J.is_null(J.get(J.get(r8, "dungeon"), "open"))), creation), creation, r8)
  floors.finish.home(J.set(r9, "pots_broken", J.obj()), depth, pack, from_home)

