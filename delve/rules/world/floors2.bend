  match cv:
    case True{}:
      Con{id, floors.in_light(run, t, lx, ly)}
    case False{}:
      floors.in_light(run, t, lx, ly)

def floors.in_light.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>, +lx: F32, +ly: F32) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      +h = exits.hero(run, id)
      floors.in_light.k2(F32.is_lt(RS.f_hypot((J.f32(J.get(h, "x")) - lx : F32), (J.f32(J.get(h, "y")) - ly : F32)), 1.6), run, lx, ly, id, t, h)
def floors.fellowship_wait(+run: J.Val, +ids: List<&2, U32>, +way: U32) -> J.Val:
  fellowship.Fellowship.wait(run, ids, way)
# Through an open doorway into the next room, down the stairs, or into the
# light home.
def floors.Run.travel(+run: J.Val) -> J.Val:
  floors.Run.travel.k1(layout.Room.is_kind(rules.Run.room(run), "kingdom"), run)

def floors.Run.travel.k3(cv: Bool, +run1: J.Val, +gate: Bool) -> J.Val:
  match cv:
    case True{}:
      run1
    case False{}:
      floors.travel.light(run1)

def floors.Run.travel.k2(pr: J.Val & Bool) -> J.Val:
  (+run1, +gate) = pr
  floors.Run.travel.k3(gate, run1, gate)

def floors.Run.travel.k1(cv: Bool, +run: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      floors.Run.travel.k2(spectacle.Run.step_into_gate(run))
def floors.travel.light(+run: J.Val) -> J.Val:
  +light = J.get(run, "light")
  +counted_ids = floors.counted_ids(run, exits.ids_all(run))
  +in_light = Bool.pick(List<&2, U32>, J.is_null(light), Nil{}, floors.in_light(run, counted_ids, J.f32(J.nth(light, 0)), J.f32(J.nth(light, 1))))
  +counted = layout.list.u32_len(counted_ids)
  +n = layout.list.u32_len(in_light)
  +run1 = Bool.pick(J.Val, Bool.and(U32.is_ne(n, 0), U32.is_lt(n, counted)), floors.fellowship_wait(run, in_light, fellowship.LIGHT()), run)
  floors.travel.light.k1(Bool.and(U32.is_ne(n, 0), U32.is_ge(n, counted)), counted, n, run1)

def floors.travel.light.k3(cv: Bool, +run2: J.Val, +opened: Bool) -> J.Val:
  match cv:
    case True{}:
      run2
    case False{}:
      floors.travel.ways(run2)

def floors.travel.light.k2(pr: J.Val & Bool) -> J.Val:
  (+run2, +opened) = pr
  floors.travel.light.k3(opened, run2, opened)

def floors.travel.light.k1(cv: Bool, +counted: U32, +n: U32, +run1: J.Val) -> J.Val:
  match cv:
    case True{}:
      +r2 = floors.cue(exits.push_sound(J.set(run1, "phase", J.JS{"won"}), "descend"), "homeward")
      rules.Run.bank_all(r2, True{}, "home with the dragon's hoard")
    case False{}:
      floors.travel.light.k2(depths.Run.open_doors(run1))
# Scan the ways out and act on them.
def floors.travel.ways(+run: J.Val) -> J.Val:
  +room = rules.Run.room(run)
  +home = home.Run.at_home_now(run)
  +ids = floors.counted_ids(run, exits.ids_all(run))
  +s = floors.scan(run, ids, room, home, FScan{4294967295, 0, 0, False{}, None{}, 0, J.obj(), J.obj()})
  floors.travel.hold(run, room, home, s)
# A Colosseum arena's gate stays shut while its heat runs, and the streamlined
# first floor's while a knight is still wishing.
def floors.travel.hold(+run: J.Val, +room: J.Val, +home: Bool, +s: FScan) -> J.Val:
  floors.travel.hold.k1(s, run, room, s)

def floors.travel.hold.k2(cv: Bool, +run: J.Val, +room: J.Val, +s: FScan, +exit_seat: U32, +stairs_seat: U32, +counted: U32, +in_door: J.Val, +on_stairs: J.Val) -> J.Val:
  match cv:
    case True{}:
      floors.travel.hold.shut(run, room, FScan{4294967295, exit_seat, stairs_seat, False{}, None{}, counted, in_door, on_stairs})
    case False{}:
      floors.travel.hold.go(run, room, s)

def floors.travel.hold.k1(sv0: FScan, +run: J.Val, +room: J.Val, +s: FScan) -> J.Val:
  match sv0:
    case FScan{+exit, +exit_seat, +stairs_seat, +stairs, +entrance, +counted, +in_door, +on_stairs}:
      floors.travel.hold.k2(Bool.or(colosseum.Run.arena_heat_on(run), identity.Run.creation_holds_stairs(run)), run, room, s, exit_seat, stairs_seat, counted, in_door, on_stairs)
def floors.travel.hold.shut(+run: J.Val, +room: J.Val, +s: FScan) -> J.Val:
  floors.travel.hold.go(J.set(J.set(run, "stairs_held", J.JBool{False{}}), "descending", J.JU{0}), room, s)
def floors.travel.hold.go(+run: J.Val, +room: J.Val, +s: FScan) -> J.Val:
  floors.travel.hold.go.k1(s, run, room, s)

def floors.travel.hold.go.k1(sv0: FScan, +run: J.Val, +room: J.Val, +s: FScan) -> J.Val:
  match sv0:
    case FScan{+exit, +exit_seat, +stairs_seat, +stairs, +entrance, +counted, +in_door, +on_stairs}:
      +run1 = Bool.pick(J.Val, stairs, run, J.set(J.set(run, "stairs_held", J.JBool{False{}}), "descending", J.JU{0}))
      +held_for = floors.gate_id(entrance)
      +run2 = Bool.pick(J.Val, floors.descend_for_is(run1, held_for), run1, J.set(J.set(run1, "descend_for", Bool.pick(J.Val, Maybe.is_none(&2, WorldEntrance, entrance), J.JNull{}, J.JS{held_for})), "descending", J.JU{0}))
      +back = layout.Room.way_back(room)
      +exit1 = Bool.pick(U32, U32.is_eq(exit, 4294967295), exit, floors.back_or(back, exit))
      +at_stairs = U32.is_eq(floors.count_eq(J.fields(on_stairs), J.JS{held_for}), counted)
      +retreat = floors.retreat(run2, entrance)
      floors.travel.act(run2, room, s, exit1, held_for, Bool.or(at_stairs, retreat), retreat)
def floors.descend_for_is(+run: J.Val, +held_for: String) -> Bool:
  +v = J.get(run, "descend_for")
  floors.descend_for_is.k1(J.is_null(v), held_for, v)

def floors.descend_for_is.k1(cv: Bool, +held_for: String, +v: J.Val) -> Bool:
  match cv:
    case True{}:
      String.eq(held_for, "")
    case False{}:
      String.eq(J.str(v), held_for)
def floors.retreat(+run: J.Val, +entrance: Maybe<&2, WorldEntrance>) -> Bool:
  floors.retreat.k1(entrance, run, entrance)

def floors.retreat.k1(sv0: Maybe<&2, WorldEntrance>, +run: J.Val, +entrance: Maybe<&2, WorldEntrance>) -> Bool:
  match sv0:
    case None{}:
      False{}
    case Some{+e}:
      kingdom.Run.returns_to_kingdom(run, world.Entrance.id(e))
def floors.travel.act(+run: J.Val, +room: J.Val, +s: FScan, +exit: U32, +held_for: String, +ready: Bool, +retreat: Bool) -> J.Val:
  floors.travel.act.k1(s, run, room, s, exit, ready, retreat)

def floors.travel.act.k1(sv0: FScan, +run: J.Val, +room: J.Val, +s: FScan, +exit: U32, +ready: Bool, +retreat: Bool) -> J.Val:
  match sv0:
    case FScan{+exit0, +exit_seat, +stairs_seat, +stairs, +entrance, +counted, +in_door, +on_stairs}:
      +home = home.Run.at_home_now(run)
      +descending = J.u32(J.get(run, "descending"))
      +held = J.bool(J.get(run, "stairs_held"))
      +deliberate_ing = Bool.and(Bool.and(home, stairs), Bool.not(held))
      +descending1 = Bool.pick(U32, deliberate_ing, Bool.pick(U32, ready, (descending + 1 : U32), 0), descending)
      +deliberate = Bool.pick(Bool, deliberate_ing, U32.is_ge(descending1, 30), True{})
      +run1 = J.set(run, "descending", J.JU{descending1})
      +stairs1 = Bool.and(Bool.and(stairs, Bool.not(depths.Run.open_guarded(run1))), Bool.not(boss_gates.Run.guardian_locked(run1)))
      +run2 = Bool.pick(J.Val, Bool.and(Bool.and(stairs, Bool.not(depths.Run.open_guarded(run1))), boss_gates.Run.guardian_locked(run1)), floors.lock_notice(run1), run1)
      +run3 = Bool.pick(J.Val, Bool.and(Bool.and(stairs1, Bool.not(held)), Bool.not(ready)), floors.fellowship_stairs(run2, J.fields(on_stairs)), run2)
      floors.travel.go(run3, room, s, exit, ready, deliberate, stairs1, retreat)
# A locked guardian's notice, once a second.
def floors.lock_notice(+run: J.Val) -> J.Val:
  floors.lock_notice.k1(U32.is_eq(W.rem_u32(W.of_j(J.get(run, "tick")), 30), 0), run)

def floors.lock_notice.k1(cv: Bool, +run: J.Val) -> J.Val:
  match cv:
    case True{}:
      boss_gates.Run.show_boss_lock(run)
    case False{}:
      run
def floors.fellowship_stairs(+run: J.Val, +xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> J.Val:
  fellowship.Fellowship.wait(run, exits.ids.go(xs), fellowship.STAIRS())
def floors.travel.go(+run: J.Val, +room: J.Val, +s: FScan, +exit: U32, +ready: Bool, +deliberate: Bool, +stairs: Bool, +retreat: Bool) -> J.Val:
  floors.travel.go.k1(s, run, room, s, exit, ready, deliberate, stairs)

def floors.travel.go.k4(pr: J.Val & Bool) -> J.Val:
  (+r1, +ok) = pr
  r1

def floors.travel.go.k3(cv: Bool, +run: J.Val, +room: J.Val, +exit: U32, +exit_seat: U32, +counted: U32, +in_door: J.Val) -> J.Val:
  match cv:
    case True{}:
      floors.travel.go.k4(exits.Run.leave_activity(run, exit_seat))
    case False{}:
      floors.travel.door(run, room, exit, exit_seat, counted, in_door)

def floors.travel.go.k2(cv: Bool, +run: J.Val, +room: J.Val, +exit: U32, +ready: Bool, +deliberate: Bool, +stairs: Bool, +exit_seat: U32, +stairs_seat: U32, +entrance: Maybe<&2, WorldEntrance>, +counted: U32, +in_door: J.Val) -> J.Val:
  match cv:
    case True{}:
      floors.travel.take(J.set(run, "descending", J.JU{0}), entrance, stairs_seat)
    case False{}:
      floors.travel.go.k3(Bool.and(Bool.and(U32.is_ne(exit, 4294967295), Bool.not(J.is_null(J.get(J.get(run, "kingdom"), "return_to")))), world.RoomKind.in_world(J.str(J.get(room, "kind")))), run, room, exit, exit_seat, counted, in_door)

def floors.travel.go.k1(sv0: FScan, +run: J.Val, +room: J.Val, +s: FScan, +exit: U32, +ready: Bool, +deliberate: Bool, +stairs: Bool) -> J.Val:
  match sv0:
    case FScan{+exit0, +exit_seat, +stairs_seat, +stairs0, +entrance, +counted, +in_door, +on_stairs}:
      floors.travel.go.k2(Bool.and(Bool.and(stairs, Bool.not(J.bool(J.get(run, "stairs_held")))), Bool.and(deliberate, ready)), run, room, exit, ready, deliberate, stairs, exit_seat, stairs_seat, entrance, counted, in_door)
# The stairs: an entrance's own way, a retreat to the kingdom, or the Winding Stair down.
def floors.travel.take(+run: J.Val, +entrance: Maybe<&2, WorldEntrance>, +seat: U32) -> J.Val:
  floors.travel.take.k1(entrance, run, entrance, seat)

def floors.travel.take.k3(pr: J.Val & Bool) -> J.Val:
  (+r1, +ok) = pr
  r1

def floors.travel.take.k2(cv: Bool, +run: J.Val, +seat: U32, +e: WorldEntrance) -> J.Val:
  match cv:
    case True{}:
      floors.travel.take.k3(exits.Run.leave_activity(run, seat))
    case False{}:
      world.Run.take_entrance(run, e)

def floors.travel.take.k1(sv0: Maybe<&2, WorldEntrance>, +run: J.Val, +entrance: Maybe<&2, WorldEntrance>, +seat: U32) -> J.Val:
  match sv0:
    case None{}:
      floors.Run.descend(run)
    case Some{+e}:
      floors.travel.take.k2(kingdom.Run.returns_to_kingdom(run, world.Entrance.id(e)), run, seat, e)
# A doorway: the party goes through when every knight who counts stands in it.
def floors.travel.door(+run: J.Val, +room: J.Val, +exit: U32, +exit_seat: U32, +counted: U32, +in_door: J.Val) -> J.Val:
  floors.travel.door.k1(U32.is_eq(exit, 4294967295), run, room, exit, exit_seat, counted, in_door)

def floors.travel.door.k5(pr: J.Val & Bool) -> J.Val:
  (+r1, +ok) = pr
  r1

def floors.travel.door.k6(cv: Bool, +run: J.Val, +exit: U32, +counted: U32, +in_door: J.Val, +next: U32) -> J.Val:
  match cv:
    case True{}:
      floors.Run.enter(run, next, J.JU{U32.and((exit + 2 : U32), 3)})
    case False{}:
      floors.fellowship_doors(run, J.fields(in_door))

def floors.travel.door.k4(cv: Bool, +run: J.Val, +exit: U32, +exit_seat: U32, +counted: U32, +in_door: J.Val, +next: U32, +returning: Bool) -> J.Val:
  match cv:
    case True{}:
      floors.travel.door.k5(exits.Run.leave_activity(run, exit_seat))
    case False{}:
      floors.travel.door.k6(U32.is_eq(floors.count_eq(J.fields(in_door), J.JU{exit}), counted), run, exit, counted, in_door, next)

def floors.travel.door.k3(cv: Bool, +run: J.Val, +room: J.Val, +exit: U32, +exit_seat: U32, +counted: U32, +in_door: J.Val, +next: U32) -> J.Val:
  match cv:
    case True{}:
      J.set(run, "fellowship", fellowship.Fellowship.clear(J.get(run, "fellowship")))
    case False{}:
      +returning = Bool.and(Bool.and(exits.room(J.str(J.get(room, "kind"))), Bool.not(world.RoomKind.in_world(J.str(J.get(room, "kind"))))), exits.returns_to(run, next))
      floors.travel.door.k4(returning, run, exit, exit_seat, counted, in_door, next, returning)

def floors.travel.door.k2(cv: Bool, +run: J.Val, +room: J.Val, +exit: U32, +exit_seat: U32, +counted: U32, +in_door: J.Val, +next: U32) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      floors.travel.door.k3(boss_gates.Run.boss_door_holds(run, next, exit), run, room, exit, exit_seat, counted, in_door, next)

def floors.travel.door.k1(cv: Bool, +run: J.Val, +room: J.Val, +exit: U32, +exit_seat: U32, +counted: U32, +in_door: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +next = layout.Floor.neighbour_or_max(J.get(run, "dungeon"), J.u32(J.get(run, "at")), exit)
      floors.travel.door.k2(U32.is_eq(next, 4294967295), run, room, exit, exit_seat, counted, in_door, next)
# The activity return lands in room `next`.
def exits.returns_to(+run: J.Val, +next: U32) -> Bool:
  exits.returns_to.k1(exits.Run.activity_return(run), run, next)

def exits.returns_to.k1(sv0: Maybe<&2, J.Val>, +run: J.Val, +next: U32) -> Bool:
  match sv0:
    case None{}:
      False{}
    case Some{+back}:
      U32.is_eq(J.u32(J.get(back, "at")), next)
def floors.fellowship_doors(+run: J.Val, +xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> J.Val:
  fellowship.Fellowship.wait_each(run, xs)
# nooks.rs: the floor takes a nook (a lived-in dead end) where it has room.
def floors.add_nook(+run: J.Val) -> J.Val:
  floors.add_nook.k1(nooks.add_nook(J.get(run, "dungeon")), run)

def floors.add_nook.k1(pr: J.Val & Bool, +run: J.Val) -> J.Val:
  (+d, +ok) = pr
  J.set(run, "dungeon", d)
