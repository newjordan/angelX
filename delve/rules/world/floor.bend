# crates/delve/src/rules/layout.rs — a floor: its rooms and how they join
# (`impl Floor`), and how a floor is laid (`floor_party`, `build`, the side
# halls, the vault, the home floor). A Floor is its serde J object.

def layout.Floor.rooms(+floor: J.Val) -> J.Val:
  J.get(floor, "rooms")
def layout.Floor.room(+floor: J.Val, +i: U32) -> J.Val:
  J.nth(J.get(floor, "rooms"), i)
def layout.Floor.len(+floor: J.Val) -> U32:
  J.len(J.get(floor, "rooms"))
# A room's cell on the floor's grid.
def layout.Room.cell(+room: J.Val) -> LayCell:
  LayCell{J.u32(J.nth(J.get(room, "cell"), 0)), J.u32(J.nth(J.get(room, "cell"), 1))}
# The index of the room at (x, y), or usize::MAX.
def layout.Floor.position(+floor: J.Val, +x: U32, +y: U32) -> U32:
  layout.Floor.position.go(J.items(J.get(floor, "rooms")), x, y, 0)
def layout.Floor.position.go(+rooms: List<&2, J.Val>, +x: U32, +y: U32, +i: U32) -> U32:
  layout.Floor.position.go.k1(rooms, rooms, x, y, i)

def layout.Floor.position.go.k2(cv: Bool, +x: U32, +y: U32, +i: U32, +h: J.Val, +t: List<&2, J.Val>) -> U32:
  match cv:
    case True{}:
      i
    case False{}:
      layout.Floor.position.go(t, x, y, (i + 1 : U32))

def layout.Floor.position.go.k1(sv0: List<&2, J.Val>, +rooms: List<&2, J.Val>, +x: U32, +y: U32, +i: U32) -> U32:
  match sv0:
    case Nil{}:
      4294967295
    case Con{+h, +t}:
      layout.Floor.position.go.k2(layout.cell.is(layout.Room.cell(h), x, y), x, y, i, h, t)
def layout.Floor.taken(+floor: J.Val, +x: U32, +y: U32) -> Bool:
  U32.is_ne(layout.Floor.position(floor, x, y), 4294967295)
# The room through door `dir` of room `from`: none where that side has no
# doorway. (usize::MAX for none; `neighbour` is the Option.)
def layout.Floor.neighbour_or_max(+floor: J.Val, +from: U32, +dir: U32) -> U32:
  +room = layout.Floor.room(floor, from)
  layout.Floor.neighbour_or_max.k1(Bool.not(layout.Room.door(room, dir)), floor, from, dir, room)

def layout.Floor.neighbour_or_max.k4(cv: Bool, +floor: J.Val, +from: U32, +dir: U32, +room: J.Val, +open: J.Val) -> U32:
  match cv:
    case True{}:
      J.u32(J.get(open, "map"))
    case False{}:
      layout.Floor.step_to(floor, room, dir)

def layout.Floor.neighbour_or_max.k3(cv: Bool, +floor: J.Val, +from: U32, +dir: U32, +room: J.Val, +open: J.Val) -> U32:
  match cv:
    case True{}:
      4294967295
    case False{}:
      layout.Floor.neighbour_or_max.k4(layout.Floor.open_back(J.items(J.get(open, "doors")), from, dir), floor, from, dir, room, open)

def layout.Floor.neighbour_or_max.k2(cv: Bool, +floor: J.Val, +from: U32, +dir: U32, +room: J.Val, +open: J.Val) -> U32:
  match cv:
    case True{}:
      layout.Floor.step_to(floor, room, dir)
    case False{}:
      layout.Floor.neighbour_or_max.k3(U32.is_eq(from, J.u32(J.get(open, "map"))), floor, from, dir, room, open)

def layout.Floor.neighbour_or_max.k1(cv: Bool, +floor: J.Val, +from: U32, +dir: U32, +room: J.Val) -> U32:
  match cv:
    case True{}:
      4294967295
    case False{}:
      +open = J.get(floor, "open")
      layout.Floor.neighbour_or_max.k2(J.is_null(open), floor, from, dir, room, open)
def layout.Floor.step_to(+floor: J.Val, +room: J.Val, +dir: U32) -> U32:
  layout.Floor.step_to.k1(layout.Room.cell(room), floor, dir)

def layout.Floor.step_to.k1(pr: LayCell, +floor: J.Val, +dir: U32) -> U32:
  match pr:
    case LayCell{+x, +y}:
      layout.Floor.position(floor, (x + layout.DX(dir) : U32), (y + layout.DY(dir) : U32))
# A side door of the open map leads from `room` back through `dir`.
def layout.Floor.open_back(+doors: List<&2, J.Val>, +from: U32, +dir: U32) -> Bool:
  layout.Floor.open_back.k1(doors, doors, from, dir)

def layout.Floor.open_back.k2(cv: Bool, +from: U32, +dir: U32, +h: J.Val, +t: List<&2, J.Val>) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.Floor.open_back(t, from, dir)

def layout.Floor.open_back.k1(sv0: List<&2, J.Val>, +doors: List<&2, J.Val>, +from: U32, +dir: U32) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+h, +t}:
      layout.Floor.open_back.k2(Bool.and(U32.is_eq(J.u32(J.get(h, "room")), from), U32.is_eq(U32.mod((J.u32(J.get(h, "dir")) + 2 : U32), 4), dir)), from, dir, h, t)
def layout.Floor.neighbour(+floor: J.Val, +from: U32, +dir: U32) -> Maybe<&2, U32>:
  layout.Floor.some_or_none(layout.Floor.neighbour_or_max(floor, from, dir))
def layout.Floor.some_or_none(+i: U32) -> Maybe<&2, U32>:
  layout.Floor.some_or_none.k1(U32.is_eq(i, 4294967295), i)

def layout.Floor.some_or_none.k1(cv: Bool, +i: U32) -> Maybe<&2, U32>:
  match cv:
    case True{}:
      None{}
    case False{}:
      Some{i}
# Doors from the entrance to every room (usize::MAX where no door leads).
def layout.Floor.steps(+floor: J.Val) -> List<&2, U32>:
  +n = layout.Floor.len(floor)
  layout.Floor.steps.k1(U32.is_eq(n, 0), floor, n)

def layout.Floor.steps.k1(cv: Bool, +floor: J.Val, +n: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      layout.Floor.steps.bfs(floor, layout.list.u32_set(layout.list.u32_fill(n, 4294967295), 0, 0), [0], 0)
def layout.Floor.steps.bfs(+floor: J.Val, +dist: List<&2, U32>, +frontier: List<&2, U32>, +d: U32) -> List<&2, U32>:
  layout.Floor.steps.bfs.k1(frontier, floor, dist, frontier, d)

def layout.Floor.steps.bfs.k2(pr: List<&2, U32> & List<&2, U32>, +floor: J.Val, +d: U32) -> List<&2, U32>:
  (+dist2, +next) = pr
  layout.Floor.steps.bfs(floor, dist2, next, (d + 1 : U32))

def layout.Floor.steps.bfs.k1(sv0: List<&2, U32>, +floor: J.Val, +dist: List<&2, U32>, +frontier: List<&2, U32>, +d: U32) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      dist
    case Con{+h, +t}:
      layout.Floor.steps.bfs.k2(layout.Floor.steps.level(floor, dist, frontier, d, Nil{}), floor, d)
def layout.Floor.steps.level(+floor: J.Val, +dist: List<&2, U32>, +frontier: List<&2, U32>, +d: U32, +next: List<&2, U32>) -> List<&2, U32> & List<&2, U32>:
  layout.Floor.steps.level.k1(frontier, floor, dist, frontier, d, next)

def layout.Floor.steps.level.k1(sv0: List<&2, U32>, +floor: J.Val, +dist: List<&2, U32>, +frontier: List<&2, U32>, +d: U32, +next: List<&2, U32>) -> List<&2, U32> & List<&2, U32>:
  match sv0:
    case Nil{}:
