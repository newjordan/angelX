def layout.Floor.steps.dirs(+floor: J.Val, +dist: List<&2, U32>, +rest: List<&2, U32>, +d: U32, +next: List<&2, U32>, +at: U32, +k: U32) -> List<&2, U32> & List<&2, U32>:
  layout.Floor.steps.dirs.k1(U32.is_ge(k, 4), floor, dist, rest, d, next, at, k)

def layout.Floor.steps.dirs.k2(cv: Bool, +floor: J.Val, +dist: List<&2, U32>, +rest: List<&2, U32>, +d: U32, +next: List<&2, U32>, +at: U32, +k: U32, +j: U32) -> List<&2, U32> & List<&2, U32>:
  match cv:
    case True{}:
      layout.Floor.steps.dirs(floor, layout.list.u32_set(dist, j, (d + 1 : U32)), rest, d, List.append(&2, U32, next, [j]), at, (k + 1 : U32))
    case False{}:
      layout.Floor.steps.dirs(floor, dist, rest, d, next, at, (k + 1 : U32))

def layout.Floor.steps.dirs.k1(cv: Bool, +floor: J.Val, +dist: List<&2, U32>, +rest: List<&2, U32>, +d: U32, +next: List<&2, U32>, +at: U32, +k: U32) -> List<&2, U32> & List<&2, U32>:
  match cv:
    case True{}:
      layout.Floor.steps.level(floor, dist, rest, d, next)
    case False{}:
      +j = layout.Floor.neighbour_or_max(floor, at, k)
      layout.Floor.steps.dirs.k2(Bool.and(U32.is_ne(j, 4294967295), U32.is_eq(layout.list.u32_nth(dist, j), 4294967295)), floor, dist, rest, d, next, at, k, j)
# The room the floor's guardian holds: its stairs, lair or threshold (usize::MAX for none).
def layout.Floor.guardian_or_max(+floor: J.Val) -> U32:
  layout.Floor.first_kind(J.items(J.get(floor, "rooms")), 0, ["stairs", "lair", "threshold"])
def layout.Floor.first_kind(+rooms: List<&2, J.Val>, +i: U32, +kinds: List<&2, String>) -> U32:
  layout.Floor.first_kind.k1(rooms, rooms, i, kinds)

def layout.Floor.first_kind.k2(cv: Bool, +i: U32, +kinds: List<&2, String>, +h: J.Val, +t: List<&2, J.Val>) -> U32:
  match cv:
    case True{}:
      i
    case False{}:
      layout.Floor.first_kind(t, (i + 1 : U32), kinds)

def layout.Floor.first_kind.k1(sv0: List<&2, J.Val>, +rooms: List<&2, J.Val>, +i: U32, +kinds: List<&2, String>) -> U32:
  match sv0:
    case Nil{}:
      4294967295
    case Con{+h, +t}:
      layout.Floor.first_kind.k2(layout.is_kind_in(J.str(J.get(h, "kind")), kinds), i, kinds, h, t)
def layout.Floor.guardian(+floor: J.Val) -> Maybe<&2, U32>:
  layout.Floor.some_or_none(layout.Floor.guardian_or_max(floor))
# Doors from the entrance to the guardian's room.
def layout.Floor.stairs_doors(+floor: J.Val) -> U32:
  +g = layout.Floor.guardian_or_max(floor)
  layout.Floor.stairs_doors.k1(U32.is_eq(g, 4294967295), floor, g)

def layout.Floor.stairs_doors.k1(cv: Bool, +floor: J.Val, +g: U32) -> U32:
  match cv:
    case True{}:
      0
    case False{}:
      +d = layout.list.u32_nth(layout.Floor.steps(floor), g)
      Bool.pick(U32, U32.is_eq(d, 4294967295), 0, d)
def layout.Floor.beside(+floor: J.Val, +room: U32, +showdown: Bool, +guardian: U32, +dir: U32) -> Bool:
  layout.Floor.beside.k1(U32.is_ge(dir, 4), floor, room, showdown, guardian, dir)

def layout.Floor.beside.k2(cv: Bool, +floor: J.Val, +room: U32, +showdown: Bool, +guardian: U32, +dir: U32, +n: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.Floor.beside(floor, room, showdown, guardian, (dir + 1 : U32))

def layout.Floor.beside.k1(cv: Bool, +floor: J.Val, +room: U32, +showdown: Bool, +guardian: U32, +dir: U32) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      +n = layout.Floor.neighbour_or_max(floor, room, dir)
      layout.Floor.beside.k2(Bool.and(U32.is_ne(n, 4294967295), layout.Floor.beside.hit(floor, n, showdown, guardian)), floor, room, showdown, guardian, dir, n)
def layout.Floor.beside.hit(+floor: J.Val, +n: U32, +showdown: Bool, +guardian: U32) -> Bool:
  layout.Floor.beside.hit.k1(showdown, floor, n, showdown, guardian)

def layout.Floor.beside.hit.k1(cv: Bool, +floor: J.Val, +n: U32, +showdown: Bool, +guardian: U32) -> Bool:
  match cv:
    case True{}:
      layout.is_kind_in(J.str(J.get(layout.Floor.room(floor, n), "kind")), ["wanted", "pit"])
    case False{}:
      U32.is_eq(n, guardian)
# Whether fight room `room` may hold the floor's chief, and how well: lower is
# better (`chief_rank`).
def layout.Floor.chief_rank(+floor: J.Val, +room: U32, +steps: List<&2, U32>) -> LayChief:
  +g = layout.Floor.guardian_or_max(floor)
  +at = layout.list.u32_nth(steps, room)
  +deep = Bool.pick(U32, U32.is_eq(g, 4294967295), 0, layout.list.u32_nth(steps, g))
  +doubled = Bool.pick(U32, U32.is_ge(at, 2147483648), 4294967295, (at * 2 : U32))
  LayChief{layout.Floor.beside(floor, room, False{}, g, 0), layout.Floor.beside(floor, room, True{}, g, 0), U32.is_lt(at, 2), layout.absdiff(doubled, deep)}
# Whether the floor can ramp (`pacing`): its stairs lie far enough in, and a
# fight room lies mid-floor for its chief.
def layout.Floor.ramps(+floor: J.Val) -> Bool:
  +steps = layout.Floor.steps(floor)
  +late = layout.Floor.showdowns_late(floor, steps, 0, layout.Floor.len(floor))
  layout.Floor.ramps.k1(Bool.and(U32.is_ge(layout.Floor.stairs_doors(floor), 4), late), floor, steps, late)

def layout.Floor.ramps.k1(cv: Bool, +floor: J.Val, +steps: List<&2, U32>, +late: Bool) -> Bool:
  match cv:
    case True{}:
      layout.Floor.ramps.chief(floor, steps, 0, layout.Floor.len(floor))
    case False{}:
      False{}
def layout.Floor.showdowns_late(+floor: J.Val, +steps: List<&2, U32>, +i: U32, +n: U32) -> Bool:
  layout.Floor.showdowns_late.k1(U32.is_ge(i, n), floor, steps, i, n)

def layout.Floor.showdowns_late.k2(cv: Bool, +floor: J.Val, +steps: List<&2, U32>, +i: U32, +n: U32) -> Bool:
  match cv:
    case True{}:
      +s = layout.list.u32_nth(steps, i)
      Bool.and(Bool.and(U32.is_ne(s, 4294967295), U32.is_gt(s, 2)), layout.Floor.showdowns_late(floor, steps, (i + 1 : U32), n))
    case False{}:
      layout.Floor.showdowns_late(floor, steps, (i + 1 : U32), n)

def layout.Floor.showdowns_late.k1(cv: Bool, +floor: J.Val, +steps: List<&2, U32>, +i: U32, +n: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.Floor.showdowns_late.k2(layout.is_kind_in(J.str(J.get(layout.Floor.room(floor, i), "kind")), ["wanted", "pit"]), floor, steps, i, n)
def layout.Floor.ramps.chief(+floor: J.Val, +steps: List<&2, U32>, +i: U32, +n: U32) -> Bool:
  layout.Floor.ramps.chief.k1(U32.is_ge(i, n), floor, steps, i, n)

def layout.Floor.ramps.chief.k3(cv: Bool, +floor: J.Val, +steps: List<&2, U32>, +i: U32, +n: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.Floor.ramps.chief(floor, steps, (i + 1 : U32), n)

def layout.Floor.ramps.chief.k2(cv: Bool, +floor: J.Val, +steps: List<&2, U32>, +i: U32, +n: U32) -> Bool:
  match cv:
    case True{}:
      layout.Floor.ramps.chief.k3(layout.Floor.ramps.none(layout.Floor.chief_rank(floor, i, steps)), floor, steps, i, n)
    case False{}:
      layout.Floor.ramps.chief(floor, steps, (i + 1 : U32), n)

def layout.Floor.ramps.chief.k1(cv: Bool, +floor: J.Val, +steps: List<&2, U32>, +i: U32, +n: U32) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      layout.Floor.ramps.chief.k2(Bool.and(String.eq(J.str(J.get(layout.Floor.room(floor, i), "kind")), "fight"), U32.is_ne(layout.list.u32_nth(steps, i), 4294967295)), floor, steps, i, n)
def layout.Floor.ramps.none(+c: LayChief) -> Bool:
  layout.Floor.ramps.none.k1(c, c)

def layout.Floor.ramps.none.k1(sv0: LayChief, +c: LayChief) -> Bool:
  match sv0:
    case LayChief{+guard, +show, +early, +mid}:
      Bool.and(Bool.and(Bool.not(guard), Bool.not(show)), Bool.not(early))
# Rooms
# -----

# A blank room: walls round open floor, the one given doors left shut.
def layout.room_blank(+cell: LayCell, +kind: String, +cols: U32, +rows: U32, +visited: Bool, +cleared: Bool, +roster: List<&2, String>) -> J.Val:
  layout.room_json(cell, kind, J.JA{[J.JBool{False{}}, J.JBool{False{}}, J.JBool{False{}}, J.JBool{False{}}]}, cols, rows, layout.grid.rle(layout.grid.walled(cols, rows)), visited, cleared, layout.roster_json(roster), J.JNull{})
def layout.doors_one(+door: U32) -> J.Val:
  J.JA{[J.JBool{U32.is_eq(door, 0)}, J.JBool{U32.is_eq(door, 1)}, J.JBool{U32.is_eq(door, 2)}, J.JBool{U32.is_eq(door, 3)}]}
# Lay `rows` of art into a grid as ledge halls read them.
def layout.hall.tile(+c: Char) -> LayTile:
  match c:
    case '#':
      TileBlock{}
    case '=':
      TileLedge{}
    case '~':
      TileHazard{}
    case 'D':
      TileDoor{}
    case _:
      TileFloor{}
def layout.hall.row(+s: String) -> List<&2, LayTile>:
  layout.hall.row.k1(s, s)

def layout.hall.row.k1(sv0: String, +s: String) -> List<&2, LayTile>:
  match sv0:
    case SNil{}:
      Nil{}
    case SCon{+c, +t}:
      Con{layout.hall.tile(c), layout.hall.row(t)}
def layout.hall.rows(+rows: List<&2, String>) -> List<&2, List<&2, LayTile>>:
  layout.hall.rows.k1(rows, rows)

def layout.hall.rows.k1(sv0: List<&2, String>, +rows: List<&2, String>) -> List<&2, List<&2, LayTile>>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      Con{layout.hall.row(h), layout.hall.rows(t)}
# The side-on hall at `cell`, its one doorway leading back through `door`.
def layout.ledge(+cell: LayCell, +door: U32) -> J.Val:
  +art = layout.LEDGE()
  +cols = layout.quad.width(art)
  +g = {LayGrid{cols, 14, layout.hall.rows(art)} : LayGrid}
  layout.room_json(cell, "ledge", layout.doors_one(door), cols, 14, layout.grid.rle(g), False{}, False{}, layout.roster_json(["skeleton", "bat", "skeleton", "bat", "bat"]), J.JNull{})
# The Wanted hall at `cell`: the stage in `outlaw::STAGE`, nobody in it yet.
def layout.wanted(+cell: LayCell, +door: U32) -> J.Val:
  +art = layout.OUTLAW_STAGE()
  +cols = layout.quad.width(art)
  +g = {LayGrid{cols, 14, layout.hall.rows(art)} : LayGrid}
  layout.room_json(cell, "wanted", layout.doors_one(door), cols, 14, layout.grid.rle(g), False{}, False{}, layout.roster_json(Nil{}), J.JNull{})
def layout.fill_rects(+g: LayGrid, +rects: List<&2, LayRect>, +t: LayTile) -> LayGrid:
  layout.fill_rects.k1(rects, g, rects, t)

def layout.fill_rects.k2(pr: LayRect, +g: LayGrid, +t: LayTile, +rest: List<&2, LayRect>) -> LayGrid:
  match pr:
    case LayRect{+c, +r, +w, +hh}:
      layout.fill_rects(layout.grid.fill_rect(g, c, r, (c + w : U32), (r + hh : U32), t), rest, t)

def layout.fill_rects.k1(sv0: List<&2, LayRect>, +g: LayGrid, +rects: List<&2, LayRect>, +t: LayTile) -> LayGrid:
  match sv0:
    case Nil{}:
      g
    case Con{+h, +rest}:
      layout.fill_rects.k2(h, g, t, rest)
def layout.set_all(+g: LayGrid, +cells: List<&2, LayCell>, +t: LayTile) -> LayGrid:
  layout.set_all.k1(cells, g, cells, t)

def layout.set_all.k2(pr: LayCell, +g: LayGrid, +t: LayTile, +rest: List<&2, LayCell>) -> LayGrid:
  match pr:
    case LayCell{+x, +y}:
      layout.set_all(layout.grid.set(g, x, y, t), rest, t)

def layout.set_all.k1(sv0: List<&2, LayCell>, +g: LayGrid, +cells: List<&2, LayCell>, +t: LayTile) -> LayGrid:
  match sv0:
    case Nil{}:
      g
    case Con{+h, +rest}:
      layout.set_all.k2(h, g, t, rest)
# The Pit at `cell`: a plain chamber, bones at its four corners, the Pit Tyrant.
def layout.pit(+cell: LayCell, +door: U32) -> J.Val:
  +g = layout.set_all(layout.grid.walled(24, 14), [LayCell{3, 2}, LayCell{20, 2}, LayCell{3, 11}, LayCell{20, 11}], TileBlock{})
  +room = layout.room_json(cell, "pit", layout.doors_one(4), 24, 14, layout.grid.rle(g), False{}, False{}, layout.roster_json(["pit_tyrant"]), J.JNull{})
  layout.Room.open_door(room, door)
# The vault at `cell`, its one doorway on `door`: a small treasure room,
# pillars at its corners, and a chest in its middle with gold heaped round it,
# or (`snibbet`) only Snibbet, sitting on his sack.
def layout.vault(+cell: LayCell, +door: U32, +snibbet: Bool) -> J.Val:
  +g = layout.set_all(layout.grid.walled(24, 14), [LayCell{4, 3}, LayCell{19, 3}, LayCell{4, 10}, LayCell{19, 10}], TileBlock{})
  +room = layout.room_json(cell, "secret", layout.doors_one(4), 24, 14, layout.grid.rle(g), False{}, True{}, layout.roster_json(Nil{}), J.JNull{})
  +opened = layout.Room.open_door(room, door)
  layout.vault.k1(snibbet, snibbet, opened)

def layout.vault.k1(cv: Bool, +snibbet: Bool, +opened: J.Val) -> J.Val:
  match cv:
    case True{}:
      opened
    case False{}:
      layout.vault.furnished(opened)
def layout.vault.furnished(+room: J.Val) -> J.Val:
  +cx = {24.0 : F32}
  +cy = {14.0 : F32}
  +chest = J.set(J.set(J.set(J.obj(), "x", J.JF{cx}), "y", J.JF{cy}), "open", J.JBool{False{}})
  J.set(J.set(room, "chest", chest), "items", J.JA{layout.vault.gold(0, cx, cy)})
# Eight gold pieces ringed round (cx, cy).
def layout.vault.gold(+k: U32, +cx: F32, +cy: F32) -> List<&2, J.Val>:
  layout.vault.gold.k1(U32.is_ge(k, 8), k, cx, cy)

def layout.vault.gold.k1(cv: Bool, +k: U32, +cx: F32, +cy: F32) -> List<&2, J.Val>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      +a = (((U32.to_f32(k) / 8.0 : F32) * 6.2831855 : F32))
      +x = (cx + (F32.cos(a) * 6.0 : F32) : F32)
      +y = (cy + (F32.sin(a) * 4.0 : F32) : F32)
      +item = J.set(J.set(J.set(J.set(J.obj(), "card", J.JS{"gold"}), "x", J.JF{x}), "y", J.JF{y}), "held_off", J.JNull{})
      Con{item, layout.vault.gold((k + 1 : U32), cx, cy)}
# Whether the Wanted hall and the Ledge hall are laid. In play they are off
# unless the host's environment asks (`ANGEL_DELVE_WANTED=1`, `ANGEL_DELVE_LEDGE=1`);
# the Rust tests keep both on. The case harness flips these two.
def layout.wanted_on() -> Bool:
  False{}
def layout.ledge_on() -> Bool:
  False{}
# Whether a room of `kind` may be walked into.
def layout.hall_open(+kind: String) -> Bool:
  layout.hall_open.k1(String.eq(kind, "ledge"), kind)

def layout.hall_open.k2(cv: Bool, +kind: String) -> Bool:
  match cv:
    case True{}:
      layout.wanted_on()
    case False{}:
      True{}

def layout.hall_open.k1(cv: Bool, +kind: String) -> Bool:
  match cv:
    case True{}:
      layout.ledge_on()
    case False{}:
      layout.hall_open.k2(String.eq(kind, "wanted"), kind)
# Hanging a room off a floor
# --------------------------

def layout.near(+v: U32) -> Bool:
  U32.is_lt((v + 1 : U32), 7)
def layout.hang_room(+which: U32, +cell: LayCell, +door: U32) -> J.Val:
  match which:
    case 0:
      layout.ledge(cell, door)
    case 1:
      layout.wanted(cell, door)
    case _:
      layout.pit(cell, door)
def layout.floor_with_rooms(+floor: J.Val, +rooms: List<&2, J.Val>) -> J.Val:
  J.set(floor, "rooms", J.JA{rooms})
# The fight rooms (not the far room, the treasure or a hall) in index order.
def layout.hang.fights(+floor: J.Val, +far: U32, +treasure: U32, +halls: List<&2, U32>, +i: U32, +n: U32) -> List<&2, U32>:
  layout.hang.fights.k1(U32.is_ge(i, n), floor, far, treasure, halls, i, n)

def layout.hang.fights.k2(cv: Bool, +floor: J.Val, +far: U32, +treasure: U32, +halls: List<&2, U32>, +i: U32, +n: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      Con{i, layout.hang.fights(floor, far, treasure, halls, (i + 1 : U32), n)}
    case False{}:
      layout.hang.fights(floor, far, treasure, halls, (i + 1 : U32), n)

def layout.hang.fights.k1(cv: Bool, +floor: J.Val, +far: U32, +treasure: U32, +halls: List<&2, U32>, +i: U32, +n: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      layout.hang.fights.k2(Bool.and(Bool.and(U32.is_ne(i, far), U32.is_ne(i, treasure)), Bool.and(Bool.not(layout.list.u32_has(halls, i)), String.eq(J.str(J.get(layout.Floor.room(floor, i), "kind")), "fight"))), floor, far, treasure, halls, i, n)
# Spots a room could hang at: key = rank * 8 + (touches more than one) * 4 + side.
def layout.hang.spots(+floor: J.Val, +parents: List<&2, U32>, +rank: U32, +acc: List<&2, U32>) -> List<&2, U32>:
  layout.hang.spots.k1(parents, floor, parents, rank, acc)

def layout.hang.spots.k1(sv0: List<&2, U32>, +floor: J.Val, +parents: List<&2, U32>, +rank: U32, +acc: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      acc
    case Con{+h, +t}:
      layout.hang.spots(floor, t, (rank + 1 : U32), layout.hang.spots.dirs(floor, layout.Room.cell(layout.Floor.room(floor, h)), rank, 0, acc))
def layout.hang.spots.dirs(+floor: J.Val, +cell: LayCell, +rank: U32, +d: U32, +acc: List<&2, U32>) -> List<&2, U32>:
  layout.hang.spots.dirs.k1(U32.is_ge(d, 4), floor, cell, rank, d, acc)

def layout.hang.spots.dirs.k3(cv: Bool, +floor: J.Val, +cell: LayCell, +rank: U32, +d: U32, +acc: List<&2, U32>, +nx: U32, +ny: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      layout.hang.spots.dirs(floor, cell, rank, (d + 1 : U32), acc)
    case False{}:
      +touching = layout.hang.touching(floor, nx, ny, 0)
      +key = (rank * 8 + Bool.to_u32(U32.is_gt(touching, 1)) * 4 + d : U32)
      layout.hang.spots.dirs(floor, cell, rank, (d + 1 : U32), layout.u32_insert(key, acc))

def layout.hang.spots.dirs.k2(pr: LayCell, +floor: J.Val, +cell: LayCell, +rank: U32, +d: U32, +acc: List<&2, U32>) -> List<&2, U32>:
  match pr:
    case LayCell{+x, +y}:
      +nx = (x + layout.DX(d) : U32)
      +ny = (y + layout.DY(d) : U32)
      layout.hang.spots.dirs.k3(Bool.or(Bool.or(Bool.not(layout.near(nx)), Bool.not(layout.near(ny))), layout.Floor.taken(floor, nx, ny)), floor, cell, rank, d, acc, nx, ny)

def layout.hang.spots.dirs.k1(cv: Bool, +floor: J.Val, +cell: LayCell, +rank: U32, +d: U32, +acc: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      acc
    case False{}:
      layout.hang.spots.dirs.k2(cell, floor, cell, rank, d, acc)
# How many of the four cells beside (x, y) hold a room.
def layout.hang.touching(+floor: J.Val, +x: U32, +y: U32, +e: U32) -> U32:
  layout.hang.touching.k1(U32.is_ge(e, 4), floor, x, y, e)

def layout.hang.touching.k1(cv: Bool, +floor: J.Val, +x: U32, +y: U32, +e: U32) -> U32:
  match cv:
    case True{}:
      0
    case False{}:
      (Bool.to_u32(layout.Floor.taken(floor, (x + layout.DX(e) : U32), (y + layout.DY(e) : U32))) + layout.hang.touching(floor, x, y, (e + 1 : U32)) : U32)
# Insert into an ascending list.
def layout.u32_insert(+v: U32, +xs: List<&2, U32>) -> List<&2, U32>:
  layout.u32_insert.k1(xs, v, xs)

def layout.u32_insert.k2(cv: Bool, +v: U32, +xs: List<&2, U32>, +h: U32, +t: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      Con{v, xs}
    case False{}:
      Con{h, layout.u32_insert(v, t)}

def layout.u32_insert.k1(sv0: List<&2, U32>, +v: U32, +xs: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      [v]
    case Con{+h, +t}:
      layout.u32_insert.k2(U32.is_le(v, h), v, xs, h, t)
def layout.u32_nth_of(+xs: List<&2, U32>, +i: U32) -> U32:
  layout.list.u32_nth(xs, i)
# Try each spot in order: open the parent's door; if it stays connected, hang
# the room and stop.
def layout.hang.try(+floor: J.Val, +parents: List<&2, U32>, +spots: List<&2, U32>, +which: U32) -> J.Val:
  layout.hang.try.k1(spots, floor, parents, spots, which)

def layout.hang.try.k3(pr: LayCell, +floor: J.Val, +which: U32, +i: U32, +d: U32, +parent: J.Val) -> J.Val:
  match pr:
    case LayCell{+x, +y}:
      +rooms0 = J.set_nth(layout.Floor.rooms(floor), i, parent)
      layout.floor_with_rooms(floor, List.append(&2, J.Val, J.items(rooms0), [layout.hang_room(which, LayCell{(x + layout.DX(d) : U32), (y + layout.DY(d) : U32)}, U32.and((d + 2 : U32), 3))]))

def layout.hang.try.k2(cv: Bool, +floor: J.Val, +parents: List<&2, U32>, +which: U32, +rest: List<&2, U32>, +i: U32, +d: U32, +parent: J.Val) -> J.Val:
  match cv:
    case True{}:
      layout.hang.try.k3(layout.Room.cell(parent), floor, which, i, d, parent)
    case False{}:
      layout.hang.try(floor, parents, rest, which)

def layout.hang.try.k1(sv0: List<&2, U32>, +floor: J.Val, +parents: List<&2, U32>, +spots: List<&2, U32>, +which: U32) -> J.Val:
  match sv0:
    case Nil{}:
      floor
    case Con{+key, +rest}:
      +i = layout.list.u32_nth(parents, U32.shrn(key, 3n))
      +d = U32.and(key, 3)
      +parent = layout.Room.open_door(layout.Floor.room(floor, i), d)
      layout.hang.try.k2(layout.connected(parent), floor, parents, which, rest, i, d, parent)
# Hang a room off the deepest fight room with a free cell beside it.
def layout.hang(+floor: J.Val, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>, +which: U32) -> J.Val:
  +fights = layout.hang.fights(floor, far, treasure, halls, 1, layout.Floor.len(floor))
  +parents = layout.Plan.halls_top(dist, fights, layout.list.u32_len(fights))
  layout.hang.try(floor, parents, layout.hang.spots(floor, parents, 0, Nil{}), which)
# The Pit: on floors two to five, about half of them.
def layout.add_pit(+floor: J.Val, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> J.Val:
  +shape = layout.pit_shape(J.items(layout.Floor.rooms(floor)), W.of_u32(J.u32(J.get(floor, "depth"))))
  layout.add_pit.k1(U32.is_eq(W.rem_u32(layout.mix(shape), 2), 0), floor, dist, far, treasure, halls, shape)

def layout.add_pit.k1(cv: Bool, +floor: J.Val, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>, +shape: W.W) -> J.Val:
  match cv:
    case True{}:
      layout.hang(floor, dist, far, treasure, halls, 2)
    case False{}:
      floor
def layout.pit_shape(+rooms: List<&2, J.Val>, +h: W.W) -> W.W:
  layout.pit_shape.k1(rooms, rooms, h)

def layout.pit_shape.k2(pr: LayCell, +h: W.W, +t: List<&2, J.Val>) -> W.W:
  match pr:
    case LayCell{+x, +y}:
      layout.pit_shape(t, W.add(W.mul(h, W.of_u32(31)), layout.sext((x * 17 + y : U32))))

def layout.pit_shape.k1(sv0: List<&2, J.Val>, +rooms: List<&2, J.Val>, +h: W.W) -> W.W:
  match sv0:
    case Nil{}:
      h
    case Con{+r, +t}:
      layout.pit_shape.k2(layout.Room.cell(r), h, t)
# The secret vault
# ----------------

def layout.secret_shape(+rooms: List<&2, J.Val>, +h: W.W) -> W.W:
  layout.secret_shape.k1(rooms, rooms, h)

def layout.secret_shape.k2(pr: LayCell, +h: W.W, +t: List<&2, J.Val>) -> W.W:
  match pr:
    case LayCell{+x, +y}:
      layout.secret_shape(t, W.add(W.mul(h, W.of_u32(37)), layout.sext((x * 19 + y : U32))))

def layout.secret_shape.k1(sv0: List<&2, J.Val>, +rooms: List<&2, J.Val>, +h: W.W) -> W.W:
  match sv0:
    case Nil{}:
      h
    case Con{+r, +t}:
      layout.secret_shape.k2(layout.Room.cell(r), h, t)
def layout.Floor.secret_shape(+floor: J.Val) -> W.W:
  layout.secret_shape(J.items(layout.Floor.rooms(floor)), W.xor(W.of_u32(J.u32(J.get(floor, "depth"))), W.of_u32(6210279)))
# Whether the shape makes a vault with a Snibbet in it.
def layout.snibbet(+shape: W.W) -> Bool:
  U32.is_eq(W.rem_u32(layout.mix(W.xor(shape, W.of_u32(94485479))), 3), 0)
# Hang a vault behind a wall of the first of `hosts` with a free side the room
# can open without cutting itself off.
def layout.hang_vault(+floor: J.Val, +hosts: List<&2, U32>, +shape: W.W) -> J.Val:
  layout.hang_vault.k1(hosts, floor, hosts, shape)

def layout.hang_vault.k1(sv0: List<&2, U32>, +floor: J.Val, +hosts: List<&2, U32>, +shape: W.W) -> J.Val:
  match sv0:
    case Nil{}:
      floor
    case Con{+i, +rest}:
      +f = layout.hang_vault.sides(floor, i, 0, shape)
      layout.hang_vault.next(f, floor, rest, shape)
def layout.hang_vault.next(+f: J.Val, +floor: J.Val, +rest: List<&2, U32>, +shape: W.W) -> J.Val:
  layout.hang_vault.next.k1(J.is_null(f), f, floor, rest, shape)

def layout.hang_vault.next.k1(cv: Bool, +f: J.Val, +floor: J.Val, +rest: List<&2, U32>, +shape: W.W) -> J.Val:
  match cv:
    case True{}:
      layout.hang_vault(floor, rest, shape)
    case False{}:
      f
# Null if no side of room `i` takes a vault.
def layout.hang_vault.sides(+floor: J.Val, +i: U32, +side: U32, +shape: W.W) -> J.Val:
  layout.hang_vault.sides.k1(U32.is_ge(side, 4), floor, i, side, shape)

def layout.hang_vault.sides.k4(cv: Bool, +floor: J.Val, +i: U32, +side: U32, +shape: W.W, +room: J.Val, +nx: U32, +ny: U32) -> J.Val:
  match cv:
    case True{}:
      +sn = layout.snibbet(shape)
      +rooms = List.append(&2, J.Val, J.items(layout.Floor.rooms(floor)), [layout.vault(LayCell{nx, ny}, U32.and((side + 2 : U32), 3), sn)])
      +s0 = J.set(J.set(J.set(J.obj(), "host", J.JU{i}), "side", J.JU{side}), "vault", J.JU{(U32.from_nat(List.length(&2, J.Val, rooms)) - 1 : U32)})
      +secret = J.set(J.set(J.set(s0, "found", J.JBool{False{}}), "snibbet", J.JBool{sn}), "paid", J.JBool{False{}})
      J.set(layout.floor_with_rooms(floor, rooms), "secret", secret)
    case False{}:
      layout.hang_vault.sides(floor, i, (side + 1 : U32), shape)

def layout.hang_vault.sides.k3(cv: Bool, +floor: J.Val, +i: U32, +side: U32, +shape: W.W, +room: J.Val, +nx: U32, +ny: U32) -> J.Val:
  match cv:
    case True{}:
      layout.hang_vault.sides(floor, i, (side + 1 : U32), shape)
    case False{}:
      layout.hang_vault.sides.k4(layout.connected(layout.Room.open_door(room, side)), floor, i, side, shape, room, nx, ny)

def layout.hang_vault.sides.k2(pr: LayCell, +floor: J.Val, +i: U32, +side: U32, +shape: W.W, +room: J.Val) -> J.Val:
  match pr:
    case LayCell{+x, +y}:
      +nx = (x + layout.DX(side) : U32)
      +ny = (y + layout.DY(side) : U32)
      layout.hang_vault.sides.k3(Bool.or(Bool.or(layout.Room.door(room, side), Bool.not(layout.near(nx))), Bool.or(Bool.not(layout.near(ny)), layout.Floor.taken(floor, nx, ny))), floor, i, side, shape, room, nx, ny)

def layout.hang_vault.sides.k1(cv: Bool, +floor: J.Val, +i: U32, +side: U32, +shape: W.W) -> J.Val:
  match cv:
    case True{}:
      J.JNull{}
    case False{}:
      +room = layout.Floor.room(floor, i)
      layout.hang_vault.sides.k2(layout.Room.cell(room), floor, i, side, shape, room)
# The first host of the least distance.
def layout.hosts.sorted(+dist: List<&2, U32>, +xs: List<&2, U32>) -> List<&2, U32>:
  layout.hosts.sorted.k1(xs, dist, xs)

def layout.hosts.sorted.k1(sv0: List<&2, U32>, +dist: List<&2, U32>, +xs: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      layout.hosts.insert(dist, h, layout.hosts.sorted(dist, t))
def layout.hosts.insert(+dist: List<&2, U32>, +c: U32, +sorted: List<&2, U32>) -> List<&2, U32>:
  layout.hosts.insert.k1(sorted, dist, c, sorted)

def layout.hosts.insert.k2(cv: Bool, +dist: List<&2, U32>, +c: U32, +sorted: List<&2, U32>, +h: U32, +t: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      Con{c, sorted}
    case False{}:
      Con{h, layout.hosts.insert(dist, c, t)}

def layout.hosts.insert.k1(sv0: List<&2, U32>, +dist: List<&2, U32>, +c: U32, +sorted: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      [c]
    case Con{+h, +t}:
      layout.hosts.insert.k2(U32.is_le(layout.list.u32_nth(dist, c), layout.list.u32_nth(dist, h)), dist, c, sorted, h, t)
# Now and then, a vault behind a cracked wall: whether a floor has one is down
# to the floor's shape.
def layout.add_secret(+floor: J.Val, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> J.Val:
  +shape = layout.Floor.secret_shape(floor)
  layout.add_secret.k1(U32.is_ge(W.rem_u32(layout.mix(shape), 100), 45), floor, dist, far, treasure, halls, shape)

def layout.add_secret.k1(cv: Bool, +floor: J.Val, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>, +shape: W.W) -> J.Val:
  match cv:
    case True{}:
      floor
    case False{}:
      +hosts = layout.hang.fights(floor, far, treasure, halls, 1, layout.Floor.len(floor))
      layout.hang_vault(floor, layout.hosts.sorted(dist, hosts), shape)
# Hollow Walls: a vault on this floor, whatever its shape says.
def layout.force_secret(+floor: J.Val) -> J.Val:
  layout.force_secret.k1(Bool.or(Bool.not(J.is_null(J.get(floor, "secret"))), U32.is_ge(J.u32(J.get(floor, "depth")), 6)), floor)

def layout.force_secret.k1(cv: Bool, +floor: J.Val) -> J.Val:
  match cv:
    case True{}:
      floor
    case False{}:
      layout.hang_vault(floor, layout.kinds_from(floor, 1, "fight"), layout.Floor.secret_shape(floor))
# Indices from `i` of rooms of `kind`.
def layout.kinds_from(+floor: J.Val, +i: U32, +kind: String) -> List<&2, U32>:
  layout.kinds_from.k1(U32.is_ge(i, layout.Floor.len(floor)), floor, i, kind)

def layout.kinds_from.k2(cv: Bool, +floor: J.Val, +i: U32, +kind: String) -> List<&2, U32>:
  match cv:
    case True{}:
      Con{i, layout.kinds_from(floor, (i + 1 : U32), kind)}
    case False{}:
      layout.kinds_from(floor, (i + 1 : U32), kind)

def layout.kinds_from.k1(cv: Bool, +floor: J.Val, +i: U32, +kind: String) -> List<&2, U32>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      layout.kinds_from.k2(String.eq(J.str(J.get(layout.Floor.room(floor, i), "kind")), kind), floor, i, kind)
# Laying a floor
# --------------

def layout.floor_new(+depth: U32, +pack: String, +rooms: List<&2, J.Val>) -> J.Val:
  +f0 = J.set(J.obj(), "depth", J.JU{depth})
  +f1 = J.set(J.set(J.set(f0, "world_revision", J.JU{0}), "pack", J.JS{pack}), "rooms", J.JA{rooms})
  J.set(f1, "secret", J.JNull{})
# The kind of cell `i`.
def layout.build.kind(+i: U32, +depth: U32, +pack: String, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> String:
  layout.build.kind.k1(Bool.and(U32.is_eq(i, 0), U32.is_ge(depth, 2)), i, depth, pack, far, treasure, halls)

def layout.build.kind.k5(cv: Bool, +depth: U32, +pack: String) -> String:
  match cv:
    case True{}:
      "lair"
    case False{}:
      "stairs"

def layout.build.kind.k4(cv: Bool, +depth: U32, +pack: String) -> String:
  match cv:
    case True{}:
      "threshold"
    case False{}:
      layout.build.kind.k5(Bool.and(U32.is_eq(depth, 3), Bool.not(String.eq(pack, "swamp"))), depth, pack)

def layout.build.kind.k7(cv: Bool, +i: U32, +halls: List<&2, U32>) -> String:
  match cv:
    case True{}:
      "hall"
    case False{}:
      "fight"

def layout.build.kind.k6(cv: Bool, +i: U32, +treasure: U32, +halls: List<&2, U32>) -> String:
  match cv:
    case True{}:
      "treasure"
    case False{}:
      layout.build.kind.k7(layout.list.u32_has(halls, i), i, halls)

def layout.build.kind.k3(cv: Bool, +i: U32, +depth: U32, +pack: String, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> String:
  match cv:
    case True{}:
      layout.build.kind.k4(U32.is_ge(depth, 6), depth, pack)
    case False{}:
      layout.build.kind.k6(U32.is_eq(i, treasure), i, treasure, halls)

def layout.build.kind.k2(cv: Bool, +i: U32, +depth: U32, +pack: String, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> String:
  match cv:
    case True{}:
      "start"
    case False{}:
      layout.build.kind.k3(U32.is_eq(i, far), i, depth, pack, far, treasure, halls)

def layout.build.kind.k1(cv: Bool, +i: U32, +depth: U32, +pack: String, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> String:
  match cv:
    case True{}:
      "sanctuary"
    case False{}:
      layout.build.kind.k2(U32.is_eq(i, 0), i, depth, pack, far, treasure, halls)
# The doors of a cell: a neighbouring cell on that side.
def layout.cell_doors(+cells: List<&2, LayCell>, +x: U32, +y: U32) -> J.Val:
  J.JA{[J.JBool{layout.cells.has(cells, x, (y + layout.DY(0) : U32))}, J.JBool{layout.cells.has(cells, (x + layout.DX(1) : U32), y)}, J.JBool{layout.cells.has(cells, x, (y + layout.DY(2) : U32))}, J.JBool{layout.cells.has(cells, (x + layout.DX(3) : U32), y)}]}
# Every cell's room, in cell order.
def layout.build.rooms(+all: List<&2, LayCell>, +rest: List<&2, LayCell>, +i: U32, +depth: U32, +pack: String, +party: U32, +far: U32, +treasure: U32, +halls: List<&2, U32>, +rng: W.W) -> List<&2, J.Val> & W.W:
  layout.build.rooms.k1(rest, all, rest, i, depth, pack, party, far, treasure, halls, rng)

def layout.build.rooms.k4(pr: List<&2, J.Val> & W.W, +room: J.Val) -> List<&2, J.Val> & W.W:
  (+rooms, +rng2) = pr
  (Con{room, rooms}, rng2)

def layout.build.rooms.k3(pr: J.Val & W.W, +all: List<&2, LayCell>, +i: U32, +depth: U32, +pack: String, +party: U32, +far: U32, +treasure: U32, +halls: List<&2, U32>, +t: List<&2, LayCell>) -> List<&2, J.Val> & W.W:
  (+room, +rng1) = pr
  layout.build.rooms.k4(layout.build.rooms(all, t, (i + 1 : U32), depth, pack, party, far, treasure, halls, rng1), room)

def layout.build.rooms.k2(pr: LayCell, +all: List<&2, LayCell>, +i: U32, +depth: U32, +pack: String, +party: U32, +far: U32, +treasure: U32, +halls: List<&2, U32>, +rng: W.W, +cell: LayCell, +t: List<&2, LayCell>) -> List<&2, J.Val> & W.W:
  match pr:
    case LayCell{+x, +y}:
      layout.build.rooms.k3(layout.room(cell, layout.build.kind(i, depth, pack, far, treasure, halls), layout.cell_doors(all, x, y), depth, pack, party, rng), all, i, depth, pack, party, far, treasure, halls, t)

def layout.build.rooms.k1(sv0: List<&2, LayCell>, +all: List<&2, LayCell>, +rest: List<&2, LayCell>, +i: U32, +depth: U32, +pack: String, +party: U32, +far: U32, +treasure: U32, +halls: List<&2, U32>, +rng: W.W) -> List<&2, J.Val> & W.W:
  match sv0:
    case Nil{}:
      (Nil{}, rng)
    case Con{+cell, +t}:
      layout.build.rooms.k2(cell, all, i, depth, pack, party, far, treasure, halls, rng, cell, t)
# Floor `depth` of `pack` for a party of `party` on the given cells, the
# entrance first.
def layout.build(+depth: U32, +pack: String, +party: U32, +rng: W.W, +cells: List<&2, LayCell>) -> J.Val & W.W:
  +plan = layout.Plan.of(cells)
  layout.build.k1(plan, depth, pack, party, rng, cells)

def layout.build.k2(pr: List<&2, J.Val> & W.W, +depth: U32, +pack: String, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> J.Val & W.W:
  (+rooms, +rng1) = pr
  +floor0 = layout.floor_new(depth, pack, rooms)
  +floor1 = layout.build.hang(floor0, depth, dist, far, treasure, halls)
  (floor1, rng1)

def layout.build.k1(pr: LayPlan, +depth: U32, +pack: String, +party: U32, +rng: W.W, +cells: List<&2, LayCell>) -> J.Val & W.W:
  match pr:
    case LayPlan{+dist, +far, +treasure, +halls}:
      layout.build.k2(layout.build.rooms(cells, cells, 0, depth, pack, party, far, treasure, halls, rng), depth, pack, dist, far, treasure, halls)
def layout.build.hang(+floor: J.Val, +depth: U32, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> J.Val:
  +f1 = layout.build.side(floor, depth, dist, far, treasure, halls)
  +f2 = layout.build.hang.k1(layout.wanted_on(), dist, far, treasure, halls, f1)
  layout.build.hang.k2(U32.is_lt(depth, 6), depth, dist, far, treasure, halls, f2)

def layout.build.hang.k1(cv: Bool, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>, +f1: J.Val) -> J.Val:
  match cv:
    case True{}:
      layout.hang(f1, dist, far, treasure, halls, 1)
    case False{}:
      f1

def layout.build.hang.k2(cv: Bool, +depth: U32, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>, +f2: J.Val) -> J.Val:
  match cv:
    case True{}:
      layout.add_secret(f2, dist, far, treasure, halls)
    case False{}:
      f2
# Floor one's ledge hall (when on), the Pit below it.
def layout.build.side(+floor: J.Val, +depth: U32, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> J.Val:
  layout.build.side.k1(U32.is_eq(depth, 1), floor, depth, dist, far, treasure, halls)

def layout.build.side.k2(cv: Bool, +floor: J.Val, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> J.Val:
  match cv:
    case True{}:
      layout.hang(floor, dist, far, treasure, halls, 0)
    case False{}:
      floor

def layout.build.side.k3(cv: Bool, +floor: J.Val, +depth: U32, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> J.Val:
  match cv:
    case True{}:
      layout.add_pit(floor, dist, far, treasure, halls)
    case False{}:
      floor

def layout.build.side.k1(cv: Bool, +floor: J.Val, +depth: U32, +dist: List<&2, U32>, +far: U32, +treasure: U32, +halls: List<&2, U32>) -> J.Val:
  match cv:
    case True{}:
      layout.build.side.k2(layout.ledge_on(), floor, dist, far, treasure, halls)
    case False{}:
      layout.build.side.k3(U32.is_lt(depth, 6), floor, depth, dist, far, treasure, halls)
# A floor's cells: tunnels from the third floor, the approach floors' stream above.
def layout.grow_cells(+depth: U32, +rng: W.W) -> List<&2, LayCell> & W.W:
  +want = (8 + depth : U32)
  layout.grow_cells.k1(U32.is_ge(depth, 3), depth, rng, want)

def layout.grow_cells.k2(pr: W.W & W.W, +depth: U32, +want: U32) -> List<&2, LayCell> & W.W:
  (+rng1, +seed) = pr
  (layout.tunnel_cells(layout.tunnel_variant(depth), seed, 5, want), rng1)

def layout.grow_cells.k1(cv: Bool, +depth: U32, +rng: W.W, +want: U32) -> List<&2, LayCell> & W.W:
  match cv:
    case True{}:
      layout.grow_cells.k2(layout.rng.next(rng), depth, want)
    case False{}:
      layout.approach_cells(want, rng)
# Lay out floor `depth` of the given pack for a party of `party` knights: its
# fight rooms and stairs rooms at least `party_room` in size. A floor that
# cannot ramp is grown again; the first that ramps stands, else the deepest of
# the tries.
def layout.floor_party(+depth: U32, +pack: String, +party: U32, +rng: W.W) -> J.Val & W.W:
  layout.floor_party.k1(layout.grow_cells(depth, rng), depth, pack, party)

def layout.floor_party.k2(pr: J.Val & W.W, +depth: U32, +pack: String, +party: U32) -> J.Val & W.W:
  (+best, +rng2) = pr
  layout.floor_party.tries(depth, pack, party, best, rng2, 48)

def layout.floor_party.k1(pr: List<&2, LayCell> & W.W, +depth: U32, +pack: String, +party: U32) -> J.Val & W.W:
  (+cells, +rng1) = pr
  layout.floor_party.k2(layout.build(depth, pack, party, rng1, cells), depth, pack, party)
def layout.floor_party.tries(+depth: U32, +pack: String, +party: U32, +best: J.Val, +rng: W.W, +left: U32) -> J.Val & W.W:
  layout.floor_party.tries.k1(U32.is_eq(left, 0), depth, pack, party, best, rng, left)

def layout.floor_party.tries.k4(pr: J.Val & W.W, +depth: U32, +pack: String, +party: U32, +best: J.Val, +left: U32) -> J.Val & W.W:
  (+again, +rng2) = pr
  +take = layout.floor_party.take(again, best)
  layout.floor_party.tries(depth, pack, party, Bool.pick(J.Val, take, again, best), rng2, (left - 1 : U32))

def layout.floor_party.tries.k3(pr: List<&2, LayCell> & W.W, +depth: U32, +pack: String, +party: U32, +best: J.Val, +left: U32) -> J.Val & W.W:
  (+cells, +rng1) = pr
  layout.floor_party.tries.k4(layout.build(depth, pack, party, rng1, cells), depth, pack, party, best, left)

def layout.floor_party.tries.k2(cv: Bool, +depth: U32, +pack: String, +party: U32, +best: J.Val, +rng: W.W, +left: U32) -> J.Val & W.W:
  match cv:
    case True{}:
      (best, rng)
    case False{}:
      layout.floor_party.tries.k3(layout.grow_cells(depth, rng), depth, pack, party, best, left)

def layout.floor_party.tries.k1(cv: Bool, +depth: U32, +pack: String, +party: U32, +best: J.Val, +rng: W.W, +left: U32) -> J.Val & W.W:
  match cv:
    case True{}:
      (best, rng)
    case False{}:
      layout.floor_party.tries.k2(layout.Floor.ramps(best), depth, pack, party, best, rng, left)
def layout.floor_party.take(+again: J.Val, +best: J.Val) -> Bool:
  layout.floor_party.take.k1(layout.Floor.ramps(again), again, best)

def layout.floor_party.take.k1(cv: Bool, +again: J.Val, +best: J.Val) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      U32.is_gt(layout.Floor.stairs_doors(again), layout.Floor.stairs_doors(best))
def layout.floor(+depth: U32, +pack: String, +rng: W.W) -> J.Val & W.W:
  layout.floor_party(depth, pack, 1, rng)
