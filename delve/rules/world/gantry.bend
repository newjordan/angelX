  gantry.Run.tick_gantry.k1(J.is_null(g0), run, g0)

def gantry.Run.tick_gantry.k3(cv: Bool, +run: J.Val, +g1: J.Val) -> J.Val:
  match cv:
    case True{}:
      gantry.with(run, g1)
