    case True{}:
      run
    case False{}:
      +g1 = J.set(g0, "t", J.JU{(J.u32(J.get(g0, "t")) + 1 : U32)})
      gantry.Run.tick_gantry.k3(U32.is_lt(J.u32(J.get(g1, "t")), 60), run, g1)

def gantry.Run.tick_gantry.k1(cv: Bool, +run: J.Val, +g0: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      gantry.Run.tick_gantry.k2(Bool.or(U32.is_ne(J.u32(J.get(g0, "room")), J.u32(J.get(run, "at"))), J.bool(J.get(g0, "done"))), run, g0)
def gantry.climb(+run: J.Val, +g: J.Val) -> J.Val:
  +rolled = Bool.and(U32.is_eq(U32.mod((J.u32(J.get(g, "t")) - 60 : U32), 45), 0), U32.is_lt(J.len(J.get(g, "kegs")), 8))
  +keg = J.set(J.set(J.set(J.set(J.set(J.obj(), "x", J.JU{96}), "y", J.JU{48}), "dir", J.JU{1}), "drop", J.JU{0}), "cleared", J.JA{Nil{}})
  +g1 = Bool.pick(J.Val, rolled, J.set(g, "kegs", J.push(J.get(g, "kegs"), keg)), g)
  +run1 = Bool.pick(J.Val, rolled, exits.push_sound(run, "rock_land"), run)
  +room = rules.Run.room(run1)
  +step = RS.f_as_i32(((9.0 * 0.03333333507180214 : F32) * 16.0 : F32))
  +g2 = J.set(g1, "kegs", J.JA{gantry.kegs_step(room, J.items(J.get(g1, "kegs")), step, layout.Room.cols(room))})
  +s = gantry.knights(WS{run1, g2, 4294967295}, exits.ids_all(run1))
  gantry.finish(s)
