# Into the gantry: the scaffold goes up, the antes go in.
def gantry.Run.start_gantry(+run: J.Val, +index: U32) -> J.Val:
  +dungeon = J.get(run, "dungeon")
  +room = gantry.scaffold(layout.Floor.room(dungeon, index))
  +d1 = J.set(layout.floor_with_rooms(dungeon, J.items(J.set_nth(layout.Floor.rooms(dungeon), index, room))), "world_revision", J.JU{(J.u32(J.get(dungeon, "world_revision")) + 1 : U32)})
  +taken = folly.take_antes(J.get(run, "players"))
  +scores = J.get(taken, "scores")
  +g0 = J.set(J.set(J.set(J.obj(), "room", J.JU{index}), "t", J.JU{0}), "kegs", J.JA{Nil{}})
  +g1 = J.set(J.set(g0, "jumped", gantry.zeros(J.fields(scores), J.obj())), "height", gantry.zeros(J.fields(scores), J.obj()))
  +g = J.set(J.set(g1, "ante", J.get(taken, "ante")), "done", J.JBool{False{}})
  +r1 = J.set(J.set(run, "dungeon", d1), "players", J.get(taken, "players"))
  +r2 = J.set(r1, "gantry", g)
  floors.cue(exits.push_sound(r2, "door_seal"), "folly")
