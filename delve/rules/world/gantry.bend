def gantry.knight.keg.k4(cv: Bool, +s: WS, +id: U32, +run: J.Val, +g: J.Val, +mark: U32, +h: J.Val, +k: J.Val) -> WS:
  match cv:
    case True{}:
      +h1 = J.set(J.set(J.set(J.set(h, "x", J.JF{3.3}), "y", J.JF{(21.0 - 1.0 : F32)}), "vy", J.JF{0.0}), "invulnerable", J.JU{30})
      WS{exits.push_sound(exits.set_hero(run, id, h1), "hero_hurt"), g, mark}
    case False{}:
      s

def gantry.knight.keg.k5(cv: Bool, +s: WS, +id: U32, +i: U32, +run: J.Val, +g: J.Val, +mark: U32, +h: J.Val, +k: J.Val, +above: F32) -> WS:
  match cv:
    case True{}:
      +k1 = J.set(k, "cleared", J.push(J.get(k, "cleared"), J.JU{id}))
      +g1 = J.set(J.set(g, "kegs", J.set_nth(J.get(g, "kegs"), i, k1)), "jumped", J.set(J.get(g, "jumped"), U32.show(id), J.JU{(J.u32(J.get(J.get(g, "jumped"), U32.show(id))) + 1 : U32)}))
      WS{exits.push_sound(run, "spoil_pickup"), g1, mark}
    case False{}:
      s

def gantry.knight.keg.k3(cv: Bool, +s: WS, +id: U32, +i: U32, +run: J.Val, +g: J.Val, +mark: U32, +h: J.Val, +k: J.Val, +above: F32, +hit: Bool) -> WS:
  match cv:
    case True{}:
      gantry.knight.keg.k4(Bool.and(U32.is_eq(J.u32(J.get(h, "invulnerable")), 0), Bool.not(gantry.cleared_has(k, id))), s, id, run, g, mark, h, k)
    case False{}:
      gantry.knight.keg.k5(Bool.and(Bool.and(Bool.and(F32.is_ge(above, 0.9), F32.is_lt(above, 2.4)), Bool.not(J.bool(J.get(h, "grounded")))), Bool.not(gantry.cleared_has(k, id))), s, id, i, run, g, mark, h, k, above)

def gantry.knight.keg.k2(cv: Bool, +s: WS, +id: U32, +i: U32, +run: J.Val, +g: J.Val, +mark: U32, +h: J.Val, +k: J.Val, +hx: F32, +hy: F32, +kx: F32, +ky: F32, +above: F32) -> WS:
  match cv:
    case True{}:
      s
    case False{}:
      +hit = Bool.or(Bool.and(F32.is_ge(above, 0.0), F32.is_lt(above, 0.9)), F32.is_lt(RS.f_abs((hy - ky : F32)), 0.6))
      gantry.knight.keg.k3(hit, s, id, i, run, g, mark, h, k, above, hit)

def gantry.knight.keg.k1(sv0: WS, +s: WS, +id: U32, +i: U32) -> WS:
  match sv0:
    case WS{+run, +g, +mark}:
      +h = exits.hero(run, id)
      +k = J.nth(J.get(g, "kegs"), i)
      +hx = J.f32(J.get(h, "x"))
      +hy = J.f32(J.get(h, "y"))
      +kx = gantry.keg_pos_x(k)
      +ky = gantry.keg_pos_y(k)
      +above = (ky - hy : F32)
      gantry.knight.keg.k2(F32.is_gt(RS.f_abs((hx - kx : F32)), 0.9), s, id, i, run, g, mark, h, k, hx, hy, kx, ky, above)
# The highest girder this knight has reached; the first to stand grounded on the summit.
def gantry.knight.height(+s: WS, +id: U32) -> WS:
  gantry.knight.height.k1(s, s, id)

def gantry.knight.height.k1(sv0: WS, +s: WS, +id: U32) -> WS:
  match sv0:
    case WS{+run, +g, +mark}:
      +h = exits.hero(run, id)
      +at = gantry.girder((J.f32(J.get(h, "y")) + 1.0 - 0.1 : F32))
      +best = U32.max(J.u32(J.get(J.get(g, "height"), U32.show(id))), at)
      +g1 = J.set(g, "height", J.set(J.get(g, "height"), U32.show(id), J.JU{best}))
      +summit = Bool.pick(U32, Bool.and(Bool.and(U32.is_eq(at, 3), J.bool(J.get(h, "grounded"))), U32.is_eq(mark, 4294967295)), id, mark)
      WS{run, g1, summit}
# The summit, or the candle burnt down, ends it: the pot and the crown.
def gantry.finish(+s: WS) -> J.Val:
  gantry.finish.k1(s, s)

def gantry.finish.k2(cv: Bool, +run: J.Val, +g: J.Val, +mark: U32) -> J.Val:
  match cv:
    case True{}:
      gantry.award(run, J.set(J.set(g, "done", J.JBool{True{}}), "kegs", J.JA{Nil{}}), mark)
    case False{}:
      gantry.with(run, g)

def gantry.finish.k1(sv0: WS, +s: WS) -> J.Val:
  match sv0:
    case WS{+run, +g, +mark}:
      gantry.finish.k2(Bool.or(U32.is_ne(mark, 4294967295), U32.is_ge(J.u32(J.get(g, "t")), (60 + 1800 : U32))), run, g, mark)
# The knight with the greatest (height, jumps), the least id on a tie, else none.
def gantry.best_by(+hs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +g: J.Val, +best: U32, +bh: U32, +bj: U32) -> U32:
  gantry.best_by.k1(hs, hs, g, best, bh, bj)

def gantry.best_by.k2(cv: Bool, +g: J.Val, +best: U32, +bh: U32, +bj: U32, +t: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +id: U32, +h: U32, +j: U32) -> U32:
  match cv:
    case True{}:
      gantry.best_by(t, g, id, h, j)
    case False{}:
      gantry.best_by(t, g, best, bh, bj)

def gantry.best_by.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +hs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +g: J.Val, +best: U32, +bh: U32, +bj: U32) -> U32:
  match sv0:
    case Nil{}:
      best
    case Con{+p, +t}:
      +id = world.key_id(p)
      +h = J.u32(world.key_val(p))
      +j = J.u32(J.get(J.get(g, "jumped"), U32.show(id)))
      gantry.best_by.k2(Bool.or(U32.is_eq(best, 4294967295), Bool.or(U32.is_gt(h, bh), Bool.or(Bool.and(U32.is_eq(h, bh), U32.is_gt(j, bj)), Bool.and(Bool.and(U32.is_eq(h, bh), U32.is_eq(j, bj)), U32.is_lt(id, best))))), g, best, bh, bj, t, id, h, j)
def gantry.pot(+xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> U32:
  gantry.pot.k1(xs, xs)

def gantry.pot.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+p, +t}:
      (J.u32(world.key_val(p)) + gantry.pot(t) : U32)
# Pay each jumper (and the best the pot), crown the best, close the room.
def gantry.award(+run: J.Val, +g: J.Val, +summit: U32) -> J.Val:
  +best = Bool.pick(U32, U32.is_ne(summit, 4294967295), summit, gantry.best_by(J.int_fields(J.get(g, "height")), g, 4294967295, 0, 0))
  +pot = gantry.pot(J.fields(J.get(g, "ante")))
  +rivals = U32.is_gt(world.obj_len(J.get(g, "height")), 1)
  +r1 = gantry.pay(run, J.int_fields(J.get(g, "jumped")), best, pot, rivals)
  +room = J.u32(J.get(g, "room"))
  +dungeon = J.get(r1, "dungeon")
  +r2 = Bool.pick(J.Val, U32.is_lt(room, layout.Floor.len(dungeon)), J.set(r1, "dungeon", layout.floor_with_rooms(dungeon, J.items(J.set_nth(layout.Floor.rooms(dungeon), room, J.set(layout.Floor.room(dungeon, room), "cleared", J.JBool{True{}}))))), r1)
  +name = Bool.pick(String, Bool.and(U32.is_ne(best, 4294967295), exits.has_hero(r2, best)), String.to_upper(J.str(J.get(exits.hero(r2, best), "name"))), "NOBODY")
  +r3 = J.set(r2, "found", J.JA{[J.get(r2, "tick"), J.JU{0}, J.JS{String.append(name, " TOPPED THE GANTRY!")}]})
  floors.cue(exits.push_sound(gantry.with(r3, g), "play_card"), "pastime_won")
def gantry.pay(+run: J.Val, +xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +best: U32, +pot: U32, +rivals: Bool) -> J.Val:
  gantry.pay.k1(xs, run, xs, best, pot, rivals)

def gantry.pay.k2(cv: Bool, +run: J.Val, +best: U32, +pot: U32, +rivals: Bool, +t: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +id: U32, +n: U32) -> J.Val:
  match cv:
    case True{}:
      +h = exits.hero(run, id)
      +h1 = J.set(h, "carried", realm.Spoils.add(J.get(h, "carried"), "gold", U32.shrn(n, 1n)))
      +h2 = Bool.pick(J.Val, rivals, J.set(h1, "laurel", J.JBool{U32.is_eq(id, best)}), h1)
      +h3 = Bool.pick(J.Val, U32.is_eq(id, best), J.set(h2, "carried", realm.Spoils.add(J.get(h2, "carried"), "gold", pot)), h2)
      gantry.pay(exits.set_hero(run, id, h3), t, best, pot, rivals)
    case False{}:
      gantry.pay(run, t, best, pot, rivals)

def gantry.pay.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +best: U32, +pot: U32, +rivals: Bool) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+p, +t}:
      +id = world.key_id(p)
      +n = J.u32(world.key_val(p))
      gantry.pay.k2(exits.has_hero(run, id), run, best, pot, rivals, t, id, n)
