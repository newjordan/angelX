# generated by bx.py from exits.bx: edit the .bx, not this file
# crates/delve/src/rules/exits.rs — a retreat is a seat's decision. The last
# departure tears down the room; earlier departures wait safely at the
# entrance while friends play on.
#
# `run.exits` is {entry: null | {at, party: {id: [x, y]}}, holding?: {id: ticks},
# outside: {id: {at, party}}}. A seat's id is the decimal key. Views a host
# draws for a seat (`view_for_seat`, `outside_view`) are not ported.

def exits.LEAVE_TICKS() -> U32:
  15
# The kinds of room a retreat leaves (`exits::room`).
def exits.room(+kind: String) -> Bool:
  exits.room.k1(Bool.and(world.RoomKind.in_world(kind), Bool.not(String.eq(kind, "kingdom"))), kind)

def exits.room.k1(cv: Bool, +kind: String) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.is_kind_in(kind, ["fortune", "yard", "trophies", "tavern", "pit", "wanted", "ledge", "forge", "holding", "kitchen", "reading", "bellows", "ossuary", "still", "loft", "secret", "lair", "muster", "workshop", "stockpile", "quarters"])
def world.obj_len(+o: J.Val) -> U32:
  U32.from_nat(List.length(&2, Sigma<&2, &2, String, _ => J.Val>, J.fields(o)))
def exits.state(+run: J.Val) -> J.Val:
  J.get(run, "exits")
def exits.set_state(+run: J.Val, +state: J.Val) -> J.Val:
  J.set(run, "exits", state)
def exits.State.default() -> J.Val:
  J.set(J.set(J.obj(), "entry", J.JNull{}), "outside", J.obj())
def exits.hero(+run: J.Val, +id: U32) -> J.Val:
  J.get(J.get(run, "players"), U32.show(id))
def exits.set_hero(+run: J.Val, +id: U32, +h: J.Val) -> J.Val:
  J.set(run, "players", J.set(J.get(run, "players"), U32.show(id), h))
def exits.has_hero(+run: J.Val, +id: U32) -> Bool:
  J.has(J.get(run, "players"), U32.show(id))
def exits.is_outside(+run: J.Val, +id: U32) -> Bool:
  J.has(J.get(exits.state(run), "outside"), U32.show(id))
def exits.Run.leave_progress(+run: J.Val, +id: U32) -> U32:
  J.u32(J.get(J.get(exits.state(run), "holding"), U32.show(id)))
# A state with its holding map set; serde leaves it out when empty.
def exits.holding_put(+st: J.Val, +holding: J.Val) -> J.Val:
  exits.holding_put.k1(U32.is_eq(world.obj_len(holding), 0), st, holding)

def exits.holding_put.k1(cv: Bool, +st: J.Val, +holding: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.del(st, "holding")
    case False{}:
      J.set(st, "holding", holding)
def exits.holding_remove(+run: J.Val, +id: U32) -> J.Val:
  +st = exits.state(run)
  exits.set_state(run, exits.holding_put(st, J.del(J.get(st, "holding"), U32.show(id))))
def exits.holding_set(+run: J.Val, +id: U32, +ticks: U32) -> J.Val:
  +st = exits.state(run)
  exits.set_state(run, J.set(st, "holding", J.set(J.get(st, "holding"), U32.show(id), J.JU{ticks})))
def exits.holding_clear(+run: J.Val) -> J.Val:
  exits.set_state(run, J.del(exits.state(run), "holding"))
# Whether the stage kept in `key` (a mini-game's state) belongs to this room.
def exits.stage_here(+run: J.Val, +key: String) -> Bool:
  +s = J.get(run, key)
  Bool.and(Bool.not(J.is_null(s)), U32.is_eq(J.u32(J.get(s, "room")), J.u32(J.get(run, "at"))))
def exits.is_some(+run: J.Val, +key: String) -> Bool:
  Bool.not(J.is_null(J.get(run, key)))
# A game with its own stage or rules, including its result board.
def exits.Run.minigame_showing(+run: J.Val) -> Bool:
  +a = Bool.or(Bool.or(forest_road.Run.forest_road_showing(run), roundtable.Run.roundtable_showing(run)), Bool.or(cinder.Run.cinder_showing(run), latch.Run.latch_showing(run)))
  +b = Bool.or(Bool.or(mossbell.Run.mossbell_showing(run), brasswake.Run.brasswake_showing(run)), Bool.or(rafterwake.Run.rafterwake_showing(run), pennon.Run.pennon_showing(run)))
  +c = Bool.or(Bool.or(exits.is_some(run, "joust"), exits.is_some(run, "chariot")), Bool.or(race3d.Run.race3d_showing(run), exits.pastimes_going(run)))
  +d = Bool.or(Bool.or(exits.stage_here(run, "folly"), exits.stage_here(run, "bats")), Bool.or(exits.stage_here(run, "gantry"), exits.stage_here(run, "powder")))
  Bool.or(Bool.or(a, b), Bool.or(Bool.or(c, d), Bool.or(exits.stage_here(run, "hop"), exits.stage_here(run, "nook"))))
def exits.pastimes_going(+run: J.Val) -> Bool:
  +p = J.get(run, "pastimes")
  Bool.or(Bool.not(J.is_null(J.get(p, "round"))), U32.is_ne(world.obj_len(J.get(p, "heats")), 0))
def exits.Run.at_privy(+run: J.Val, +id: U32) -> Bool:
  exits.Run.at_privy.k1(exits.has_hero(run, id), run, id)

def exits.Run.at_privy.k2(cv: Bool, +run: J.Val, +h: J.Val) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      exits.at_privy.spot(layout.Room.privy(rules.Run.room(run)), J.f32(J.get(h, "x")), J.f32(J.get(h, "y")))

def exits.Run.at_privy.k1(cv: Bool, +run: J.Val, +id: U32) -> Bool:
  match cv:
    case True{}:
      +h = exits.hero(run, id)
      exits.Run.at_privy.k2(Bool.or(Bool.not(J.is_null(J.get(J.get(h, "pit"), "stop"))), U32.is_gt(J.u32(J.get(h, "privy")), 0)), run, h)
    case False{}:
      False{}
def exits.at_privy.spot(+spot: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +hx: F32, +hy: F32) -> Bool:
  exits.at_privy.spot.k1(spot, spot, hx, hy)

def exits.at_privy.spot.k1(sv0: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +spot: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +hx: F32, +hy: F32) -> Bool:
  match sv0:
    case None{}:
      False{}
    case Some{+p}:
      exits.at_privy.near(p, hx, hy)
def exits.at_privy.near(+p: Sigma<&2, &2, F32, _ => F32>, +hx: F32, +hy: F32) -> Bool:
  exits.at_privy.near.k1(p, p, hx, hy)

def exits.at_privy.near.k1(sv0: Sigma<&2, &2, F32, _ => F32>, +p: Sigma<&2, &2, F32, _ => F32>, +hx: F32, +hy: F32) -> Bool:
  match sv0:
    case (+x, +y):
      F32.is_lt(RS.f_hypot((hx - x : F32), (hy - y : F32)), (1.2 + 2.0 : F32))
def exits.Run.can_leave_activity(+run: J.Val, +id: U32) -> Bool:
  exits.Run.can_leave_activity.k1(Bool.and(Bool.and(rules.Run.active(run), J.is_null(J.get(run, "crossroads"))), exits.has_hero(run, id)), run, id)

def exits.Run.can_leave_activity.k2(cv: Bool, +run: J.Val, +id: U32) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      Bool.or(Bool.or(exits.room(J.str(J.get(rules.Run.room(run), "kind"))), exits.Run.minigame_showing(run)), exits.Run.at_privy(run, id))

def exits.Run.can_leave_activity.k1(cv: Bool, +run: J.Val, +id: U32) -> Bool:
  match cv:
    case True{}:
      exits.Run.can_leave_activity.k2(exits.is_outside(run, id), run, id)
    case False{}:
      False{}
def exits.Run.can_hold_leave(+run: J.Val, +id: U32) -> Bool:
  exits.Run.can_hold_leave.k1(exits.Run.can_leave_activity(run, id), run, id)

def exits.Run.can_hold_leave.k1(cv: Bool, +run: J.Val, +id: U32) -> Bool:
  match cv:
    case True{}:
      Bool.or(exits.Run.minigame_showing(run), exits.Run.at_privy(run, id))
    case False{}:
      False{}
# The seats' ids in order, the first six.
def exits.ids(+run: J.Val) -> List<&2, U32>:
  List.take(&2, U32, exits.ids.go(J.int_fields(J.get(run, "players"))), 6n)
def exits.ids.go(+xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> List<&2, U32>:
  exits.ids.go.k1(xs, xs)

def exits.ids.go.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      Con{world.key_id(h), exits.ids.go(t)}
def world.key_id(+p: Sigma<&2, &2, String, _ => J.Val>) -> U32:
  world.key_id.k1(p, p)

def world.key_id.k1(sv0: Sigma<&2, &2, String, _ => J.Val>, +p: Sigma<&2, &2, String, _ => J.Val>) -> U32:
  match sv0:
    case (+k, +v):
      world.parse_id(k)
def world.parse_id(+k: String) -> U32:
  world.parse_id.go(U32.read(k))
def world.parse_id.go(+m: Maybe<&2, U32>) -> U32:
  world.parse_id.go.k1(m, m)

def world.parse_id.go.k1(sv0: Maybe<&2, U32>, +m: Maybe<&2, U32>) -> U32:
  match sv0:
    case None{}:
      0
    case Some{+v}:
      v
# Drop the holds of seats that are gone.
def exits.holding_retain(+run: J.Val, +ids: List<&2, U32>) -> J.Val:
  +st = exits.state(run)
  exits.set_state(run, exits.holding_put(st, exits.holding_keep(J.fields(J.get(st, "holding")), ids, J.obj())))
def exits.holding_keep(+xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +ids: List<&2, U32>, +acc: J.Val) -> J.Val:
  exits.holding_keep.k1(xs, xs, ids, acc)

def exits.holding_keep.k2(cv: Bool, +ids: List<&2, U32>, +acc: J.Val, +h: Sigma<&2, &2, String, _ => J.Val>, +t: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> J.Val:
  match cv:
    case True{}:
      exits.holding_keep(t, ids, J.set(acc, world.key_str(h), world.key_val(h)))
    case False{}:
      exits.holding_keep(t, ids, acc)

def exits.holding_keep.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +ids: List<&2, U32>, +acc: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      acc
    case Con{+h, +t}:
      exits.holding_keep.k2(layout.list.u32_has(ids, world.key_id(h)), ids, acc, h, t)
def world.key_str(+p: Sigma<&2, &2, String, _ => J.Val>) -> String:
  world.key_str.k1(p, p)

def world.key_str.k1(sv0: Sigma<&2, &2, String, _ => J.Val>, +p: Sigma<&2, &2, String, _ => J.Val>) -> String:
  match sv0:
    case (+k, +v):
      k
def world.key_val(+p: Sigma<&2, &2, String, _ => J.Val>) -> J.Val:
  world.key_val.k1(p, p)

def world.key_val.k1(sv0: Sigma<&2, &2, String, _ => J.Val>, +p: Sigma<&2, &2, String, _ => J.Val>) -> J.Val:
  match sv0:
    case (+k, +v):
      v
# Each seat's leave hold: held long enough, the seat leaves its activity and
# its keys are blanked this tick (the first six of them).
def exits.Run.tick_leave_hold(+run: J.Val, +inputs: J.Val) -> J.Val & List<&2, Maybe<&2, U32>>:
  +ids = exits.ids(run)
  exits.Run.tick_leave_hold.k1(exits.tick_leave_hold.go(exits.holding_retain(run, ids), ids, inputs, Nil{}))

def exits.Run.tick_leave_hold.k1(pr: J.Val & List<&2, U32>) -> J.Val & List<&2, Maybe<&2, U32>>:
  (+run2, +blanks) = pr
  (run2, exits.blank_slots(blanks, 6))
# The blanked ids first, then none up to `n` slots.
def exits.blank_slots(+blanks: List<&2, U32>, +n: U32) -> List<&2, Maybe<&2, U32>>:
  exits.blank_slots.k1(U32.is_eq(n, 0), blanks, n)

def exits.blank_slots.k2(sv0: List<&2, U32>, +blanks: List<&2, U32>, +n: U32) -> List<&2, Maybe<&2, U32>>:
  match sv0:
    case Nil{}:
      Con{None{}, exits.blank_slots(Nil{}, (n - 1 : U32))}
    case Con{+h, +t}:
      Con{Some{h}, exits.blank_slots(t, (n - 1 : U32))}

def exits.blank_slots.k1(cv: Bool, +blanks: List<&2, U32>, +n: U32) -> List<&2, Maybe<&2, U32>>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      exits.blank_slots.k2(blanks, blanks, n)
def exits.tick_leave_hold.go(+run: J.Val, +ids: List<&2, U32>, +inputs: J.Val, +blanks: List<&2, U32>) -> J.Val & List<&2, U32>:
  exits.tick_leave_hold.go.k1(ids, run, ids, inputs, blanks)

def exits.tick_leave_hold.go.k4(pr: J.Val & Bool, +inputs: J.Val, +blanks: List<&2, U32>, +id: U32, +rest: List<&2, U32>) -> J.Val & List<&2, U32>:
  (+run2, +left) = pr
  exits.tick_leave_hold.go(run2, rest, inputs, Bool.pick(List<&2, U32>, left, List.append(&2, U32, blanks, [id]), blanks))

def exits.tick_leave_hold.go.k3(cv: Bool, +run: J.Val, +inputs: J.Val, +blanks: List<&2, U32>, +id: U32, +rest: List<&2, U32>, +ticks: U32) -> J.Val & List<&2, U32>:
  match cv:
    case True{}:
      exits.tick_leave_hold.go.k4(exits.Run.leave_activity(exits.holding_remove(run, id), id), inputs, blanks, id, rest)
    case False{}:
      exits.tick_leave_hold.go(exits.holding_set(run, id, ticks), rest, inputs, blanks)

def exits.tick_leave_hold.go.k2(cv: Bool, +run: J.Val, +inputs: J.Val, +blanks: List<&2, U32>, +id: U32, +rest: List<&2, U32>) -> J.Val & List<&2, U32>:
  match cv:
    case True{}:
      exits.tick_leave_hold.go(exits.holding_remove(run, id), rest, inputs, blanks)
    case False{}:
      +ticks = (exits.Run.leave_progress(run, id) + 1 : U32)
      exits.tick_leave_hold.go.k3(U32.is_ge(ticks, 15), run, inputs, blanks, id, rest, ticks)

def exits.tick_leave_hold.go.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>, +inputs: J.Val, +blanks: List<&2, U32>) -> J.Val & List<&2, U32>:
  match sv0:
    case Nil{}:
      (run, blanks)
    case Con{+id, +rest}:
      exits.tick_leave_hold.go.k2(Bool.or(Bool.not(exits.Run.can_hold_leave(run, id)), Bool.not(world.leave_held(inputs, id))), run, inputs, blanks, id, rest)
# `inputs.get(&id).is_some_and(|i| i.valid() && i.leave_held)`.
def world.leave_held(+inputs: J.Val, +id: U32) -> Bool:
  +i = J.get(inputs, U32.show(id))
  Bool.and(Bool.not(J.is_null(i)), Bool.and(rules.Input.valid(i), J.bool(J.get(i, "leave_held"))))
# Where each knight stood in the room left, kept inside it.
def exits.inside(+x: F32, +top: F32) -> F32:
  exits.inside.k1(RS.f_is_finite(x), x, top)

def exits.inside.k1(cv: Bool, +x: F32, +top: F32) -> F32:
  match cv:
    case True{}:
      RS.f_clamp(x, 0.0, top)
    case False{}:
      (top / 2.0 : F32)
def exits.entry_party(+players: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +w: F32, +h: F32, +acc: J.Val) -> J.Val:
  exits.entry_party.k1(players, players, w, h, acc)

def exits.entry_party.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +players: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +w: F32, +h: F32, +acc: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      acc
    case Con{+p, +t}:
      +k = world.key_val(p)
      exits.entry_party(t, w, h, J.set(acc, world.key_str(p), J.JA{[J.JF{exits.inside(J.f32(J.get(k, "x")), w)}, J.JF{exits.inside(J.f32(J.get(k, "y")), h)}]}))
# `remember_activity_entry`: keep where the party stood in the room they leave.
def exits.Run.remember_activity_entry(+run: J.Val, +index: U32) -> J.Val:
  exits.Run.remember_activity_entry.k1(U32.is_eq(index, J.u32(J.get(run, "at"))), run, index)

def exits.Run.remember_activity_entry.k2(cv: Bool, +run: J.Val, +index: U32, +run1: J.Val) -> J.Val:
  match cv:
    case True{}:
      exits.set_state(run1, J.set(exits.state(run1), "entry", J.JNull{}))
    case False{}:
      +r = rules.Run.room(run)
      +entry = J.set(J.set(J.obj(), "at", J.get(run, "at")), "party", exits.entry_party(J.fields(J.get(run, "players")), layout.Room.width(r), layout.Room.height(r), J.obj()))
      exits.set_state(run1, J.set(exits.state(run1), "entry", entry))

def exits.Run.remember_activity_entry.k1(cv: Bool, +run: J.Val, +index: U32) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +run1 = exits.holding_clear(run)
      exits.Run.remember_activity_entry.k2(Bool.and(Bool.not(exits.room(J.str(J.get(layout.Floor.room(J.get(run, "dungeon"), index), "kind")))), Bool.not(exits.stage_room(run, index))), run, index, run1)
# `[folly_room, gantry_room, race3d_room].contains(&Some(index))`.
def exits.stage_room(+run: J.Val, +index: U32) -> Bool:
  Bool.or(Bool.or(exits.opt_is(run, "folly_room", index), exits.opt_is(run, "gantry_room", index)), exits.opt_is(run, "race3d_room", index))
def exits.opt_is(+run: J.Val, +key: String, +index: U32) -> Bool:
  +v = J.get(run, key)
  Bool.and(Bool.not(J.is_null(v)), U32.is_eq(J.u32(v), index))
# The entry a leaving party goes back to (`activity_return`), or none.
def exits.Run.activity_return(+run: J.Val) -> Maybe<&2, J.Val>:
  exits.Run.activity_return.k1(colosseum.Run.arena_return(run), run)

def exits.Run.activity_return.k1(sv0: Maybe<&2, J.Val>, +run: J.Val) -> Maybe<&2, J.Val>:
  match sv0:
    case Some{+hall}:
      Some{hall}
    case None{}:
      exits.activity_return.kingdom(run)
def exits.activity_return.kingdom(+run: J.Val) -> Maybe<&2, J.Val>:
  +back = J.get(J.get(run, "kingdom"), "return_to")
  +at = world.room_of(J.get(run, "dungeon"), "kingdom")
  exits.activity_return.kingdom.k1(Bool.and(Bool.and(Bool.not(J.is_null(back)), Bool.or(U32.is_ne(world.obj_len(J.get(back, "party")), 0), J.is_null(J.get(exits.state(run), "entry")))), U32.is_ne(at, 4294967295)), run, back, at)

def exits.activity_return.kingdom.k1(cv: Bool, +run: J.Val, +back: J.Val, +at: U32) -> Maybe<&2, J.Val>:
  match cv:
    case True{}:
      Some{J.set(J.set(J.obj(), "at", J.JU{at}), "party", exits.back_party(J.fields(J.get(run, "players")), back, J.obj()))}
    case False{}:
      exits.activity_return.entry(run)
# Each knight's spot from the kingdom return (its own, else the party's x, y).
def exits.back_party(+players: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +back: J.Val, +acc: J.Val) -> J.Val:
  exits.back_party.k1(players, players, back, acc)

def exits.back_party.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +players: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +back: J.Val, +acc: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      acc
    case Con{+p, +t}:
      +k = world.key_str(p)
      +own = J.get(J.get(back, "party"), k)
      +spot = Bool.pick(J.Val, J.is_null(own), J.JA{[J.get(back, "x"), J.get(back, "y")]}, own)
      exits.back_party(t, back, J.set(acc, k, spot))
def exits.activity_return.entry(+run: J.Val) -> Maybe<&2, J.Val>:
  +entry = J.get(exits.state(run), "entry")
  exits.activity_return.entry.k1(J.is_null(entry), run, entry)

def exits.activity_return.entry.k1(cv: Bool, +run: J.Val, +entry: J.Val) -> Maybe<&2, J.Val>:
  match cv:
    case True{}:
      exits.activity_return.old(run)
    case False{}:
      Some{entry}
# Old saves predate the entry journal: an optional delve hall has one return
# door, surface rooms return to the Undercroft.
def exits.activity_return.old(+run: J.Val) -> Maybe<&2, J.Val>:
  +dungeon = J.get(run, "dungeon")
  +d = exits.first_neighbour(dungeon, J.u32(J.get(run, "at")), 0)
  +at = Bool.pick(U32, U32.is_ne(d, 4294967295), d, world.room_of(dungeon, "home"))
  exits.activity_return.old.k1(U32.is_eq(at, 4294967295), run, dungeon, at)

def exits.activity_return.old.k1(cv: Bool, +run: J.Val, +dungeon: J.Val, +at: U32) -> Maybe<&2, J.Val>:
  match cv:
    case True{}:
      None{}
    case False{}:
      +r = layout.Floor.room(dungeon, at)
      +spot = {J.JA{[J.JF{(layout.Room.width(r) / 2.0 : F32)}, J.JF{(layout.Room.height(r) - 4.5 : F32)}]} : J.Val}
      Some{J.set(J.set(J.obj(), "at", J.JU{at}), "party", exits.all_at(J.fields(J.get(run, "players")), spot, J.obj()))}
def exits.all_at(+players: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +spot: J.Val, +acc: J.Val) -> J.Val:
  exits.all_at.k1(players, players, spot, acc)

def exits.all_at.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +players: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +spot: J.Val, +acc: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      acc
    case Con{+p, +t}:
      exits.all_at(t, spot, J.set(acc, world.key_str(p), spot))
# The first room beside room `at` through any door (usize::MAX for none).
def exits.first_neighbour(+dungeon: J.Val, +at: U32, +d: U32) -> U32:
  exits.first_neighbour.k1(U32.is_ge(d, 4), dungeon, at, d)

def exits.first_neighbour.k1(cv: Bool, +dungeon: J.Val, +at: U32, +d: U32) -> U32:
  match cv:
    case True{}:
      4294967295
    case False{}:
      +n = layout.Floor.neighbour_or_max(dungeon, at, d)
      Bool.pick(U32, U32.is_ne(n, 4294967295), n, exits.first_neighbour(dungeon, at, (d + 1 : U32)))
# A knight let out of whatever held them: stones, vigils, shields, spells.
def exits.release_activity_controls(+h: J.Val) -> J.Val:
  +h1 = hero.Hero.dress(J.set(J.set(J.set(J.set(J.set(J.set(h, "stone", J.JBool{False{}}), "vigil", J.JBool{False{}}), "vigil_key", J.JBool{False{}}), "vigil_rearm", J.JU{0}), "privy", J.JU{0}), "pit", exits.pit_cleared(J.get(h, "pit"))))
  +h2 = J.set(J.set(J.set(J.set(h1, "gear_was", J.get(h1, "gear")), "dash_ticks", J.JU{0}), "vy", J.JF{0.0}), "jump_held", J.JBool{False{}})
  +h3 = J.set(J.set(J.set(J.set(J.set(h2, "dropping", J.JU{0}), "footing", J.JNull{}), "shielding", J.JBool{False{}}), "walling", J.JBool{False{}}), "buying", J.JU{0})
  +h4 = J.set(J.set(J.set(J.set(h3, "buy_spent", J.JBool{False{}}), "invulnerable", J.JU{U32.max(J.u32(J.get(h3, "invulnerable")), 30)}), "hp", J.JU{U32.max(J.u32(J.get(h3, "hp")), 1)}), "aiming", J.JNull{})
  J.set(J.set(J.set(J.set(J.set(J.set(h4, "spin", J.JU{0}), "whirl", J.JU{0}), "ult", J.JNull{}), "hexed", J.JU{0}), "chilled", J.JU{0}), "mired", J.JU{0})
def exits.pit_cleared(+pit: J.Val) -> J.Val:
  J.set(J.set(pit, "stop", J.JNull{}), "result", J.JNull{})
# `Run::leave_activity`: knight `id` leaves; the last one out closes the place.
def exits.Run.leave_activity(+run: J.Val, +id: U32) -> J.Val & Bool:
  exits.Run.leave_activity.k1(Bool.not(exits.Run.can_leave_activity(run, id)), run, id)

def exits.Run.leave_activity.k2(cv: Bool, +id: U32, +run2: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      (exits.leave_privy(run2, id), True{})
    case False{}:
      exits.leave_activity.out(run2, id, exits.Run.activity_return(run2))

def exits.Run.leave_activity.k1(cv: Bool, +run: J.Val, +id: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      (run, False{})
    case False{}:
      +run1 = exits.holding_remove(run, id)
      +run2 = J.set(run1, "hitstop", J.set(J.get(run1, "hitstop"), "buffered", J.del(J.get(J.get(run1, "hitstop"), "buffered"), U32.show(id))))
      exits.Run.leave_activity.k2(exits.Run.at_privy(run2, id), id, run2)
def exits.leave_privy(+run: J.Val, +id: U32) -> J.Val:
  +h = exits.hero(run, id)
  +stop = J.get(J.get(h, "pit"), "stop")
  +at = Bool.pick(J.Val, J.is_null(stop), exits.pit_box(rules.Run.room(run)), J.get(stop, "from"))
  +h1 = exits.release_activity_controls(h)
  +h2 = Bool.pick(J.Val, J.is_null(at), h1, J.set(J.set(h1, "x", J.nth(at, 0)), "y", J.nth(at, 1)))
  exits.set_hero(run, id, h2)
# `Room::pit_box`: where a pit stop's box stands, or null (home's games).
def exits.pit_box(+room: J.Val) -> J.Val:
  pitstop.Room.pit_box(room)
def exits.leave_activity.out(+run: J.Val, +id: U32, +back: Maybe<&2, J.Val>) -> J.Val & Bool:
  exits.leave_activity.out.k1(back, run, id, back)

def exits.leave_activity.out.k1(sv0: Maybe<&2, J.Val>, +run: J.Val, +id: U32, +back: Maybe<&2, J.Val>) -> J.Val & Bool:
  match sv0:
    case None{}:
      (run, False{})
    case Some{+b}:
      (exits.leave_activity.go(run, id, b), True{})
def exits.leave_activity.go(+run: J.Val, +id: U32, +back: J.Val) -> J.Val:
  +behind = layout.Room.way_back(rules.Run.room(run))
  +h0 = exits.release_activity_controls(exits.hero(run, id))
  +h1 = exits.leave_activity.behind(h0, behind)
  +spot = J.get(J.get(back, "party"), U32.show(id))
  +h2 = Bool.pick(J.Val, J.is_null(spot), h1, J.set(J.set(h1, "x", J.nth(spot, 0)), "y", J.nth(spot, 1)))
  +run1 = exits.set_hero(run, id, h2)
  +st = exits.state(run1)
  +run2 = exits.set_state(run1, J.set(st, "outside", J.set(J.get(st, "outside"), U32.show(id), back)))
  +run3 = exits.Run.safe_activity_return(run2, id, J.u32(J.get(back, "at")))
  +remaining = exits.remaining(run3, exits.ids_all(run3))
  +run3a = exits.forfeit_stage(exits.chariot_depart(rules.Run.depart_lists(run3, id), id), id)
  +run4 = J.set(run3a, "pastimes", pastimes.Pastimes.depart(J.get(run3a, "pastimes"), id, remaining))
  +run5 = Bool.pick(J.Val, exits.opt_is_u32(J.get(J.get(run4, "college"), "owner"), id), J.set(run4, "college", college.Dialogue.default()), run4)
  exits.leave_activity.go.k1(exits.all_out_or_away(run5, exits.ids_all(run5)), back, run5)

def exits.leave_activity.go.k1(cv: Bool, +back: J.Val, +run5: J.Val) -> J.Val:
  match cv:
    case True{}:
      exits.Run.finish_activity_return(exits.push_sound(run5, "door_open"), back)
    case False{}:
      exits.push_sound(run5, "door_open")
def exits.chariot_depart(+run: J.Val, +id: U32) -> J.Val:
  +c = J.get(run, "chariot")
  exits.chariot_depart.k1(J.is_null(c), run, id, c)

def exits.chariot_depart.k1(cv: Bool, +run: J.Val, +id: U32, +c: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      J.set(run, "chariot", chariot.Chariot.depart(c, id))
def exits.opt_is_u32(+v: J.Val, +id: U32) -> Bool:
  Bool.and(Bool.not(J.is_null(v)), U32.is_eq(J.u32(v), id))
def exits.push_sound(+run: J.Val, +s: String) -> J.Val:
  J.set(run, "sounds", J.push(J.get(run, "sounds"), J.JS{s}))
def exits.leave_activity.behind(+h: J.Val, +behind: Maybe<&2, U32>) -> J.Val:
  exits.leave_activity.behind.k1(behind, h, behind)

def exits.leave_activity.behind.k1(sv0: Maybe<&2, U32>, +h: J.Val, +behind: Maybe<&2, U32>) -> J.Val:
  match sv0:
    case None{}:
      J.set(h, "door_behind", J.JNull{})
    case Some{+side}:
      J.set(h, "door_behind", J.JU{U32.and((side + 2 : U32), 3)})
def exits.ids_all(+run: J.Val) -> List<&2, U32>:
  exits.ids.go(J.int_fields(J.get(run, "players")))
# The knights not waiting outside.
def exits.remaining(+run: J.Val, +ids: List<&2, U32>) -> List<&2, U32>:
  exits.remaining.k1(ids, run, ids)

def exits.remaining.k2(cv: Bool, +run: J.Val, +h: U32, +t: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      exits.remaining(run, t)
    case False{}:
      Con{h, exits.remaining(run, t)}

def exits.remaining.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      exits.remaining.k2(exits.is_outside(run, h), run, h, t)
# Everyone is outside or away.
def exits.all_out_or_away(+run: J.Val, +ids: List<&2, U32>) -> Bool:
  exits.all_out_or_away.k1(ids, run, ids)

def exits.all_out_or_away.k2(cv: Bool, +run: J.Val, +h: U32, +t: List<&2, U32>) -> Bool:
  match cv:
    case True{}:
      exits.all_out_or_away(run, t)
    case False{}:
      False{}

def exits.all_out_or_away.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>) -> Bool:
  match sv0:
    case Nil{}:
      True{}
    case Con{+h, +t}:
      exits.all_out_or_away.k2(Bool.or(exits.is_outside(run, h), rules.Run.away(run, h)), run, h, t)
# A leaver's scores in the game stages come off.
def exits.forfeit_stage(+run: J.Val, +id: U32) -> J.Val:
  +k = U32.show(id)
  +r1 = exits.drop_in(run, "folly", "eaten", k)
  +r2 = exits.drop_in(r1, "bats", "scores", k)
  +r3 = exits.drop_in(exits.drop_in(r2, "gantry", "jumped", k), "gantry", "height", k)
  +r4 = exits.drop_in(r3, "powder", "broken", k)
  +r5 = exits.drop_in(r4, "hop", "crossings", k)
  +r6 = exits.drop_in(exits.drop_in(exits.drop_in(r5, "nook", "score", k), "nook", "jars", k), "nook", "brews", k)
  exits.drop_in(r6, "race3d", "riders", k)
# Remove entry `k` of the map `field` in the stage kept in `key`, if there is one.
def exits.drop_in(+run: J.Val, +key: String, +field: String, +k: String) -> J.Val:
  +s = J.get(run, key)
  exits.drop_in.k1(J.is_null(s), run, key, field, k, s)

def exits.drop_in.k1(cv: Bool, +run: J.Val, +key: String, +field: String, +k: String, +s: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      J.set(run, key, J.set(s, field, J.del(J.get(s, field), k)))
# A knight waits outside while friends play on inside. Once everyone still
# inside is away, the place closes and the party is whole again.
def exits.Run.close_behind_the_away(+run: J.Val) -> J.Val:
  exits.Run.close_behind_the_away.k1(U32.is_eq(world.obj_len(J.get(exits.state(run), "outside")), 0), run)

def exits.Run.close_behind_the_away.k2(cv: Bool, +run: J.Val, +outside: List<&2, U32>, +waiting: Bool, +inside_away: Bool) -> J.Val:
  match cv:
    case True{}:
      exits.close_first(run)
    case False{}:
      exits.rejoin_away(run, outside)

def exits.Run.close_behind_the_away.k1(cv: Bool, +run: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +outside = exits.outside_ids(run)
      +waiting = exits.any_not_away(run, outside)
      +inside_away = exits.inside_all_away(run, exits.ids_all(run))
      exits.Run.close_behind_the_away.k2(Bool.and(waiting, inside_away), run, outside, waiting, inside_away)
def exits.outside_ids(+run: J.Val) -> List<&2, U32>:
  exits.ids.go(J.int_fields(J.get(exits.state(run), "outside")))
def exits.any_not_away(+run: J.Val, +ids: List<&2, U32>) -> Bool:
  exits.any_not_away.k1(ids, run, ids)

def exits.any_not_away.k2(cv: Bool, +run: J.Val, +h: U32, +t: List<&2, U32>) -> Bool:
  match cv:
    case True{}:
      exits.any_not_away(run, t)
    case False{}:
      True{}

def exits.any_not_away.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+h, +t}:
      exits.any_not_away.k2(rules.Run.away(run, h), run, h, t)
def exits.inside_all_away(+run: J.Val, +ids: List<&2, U32>) -> Bool:
  exits.inside_all_away.k1(ids, run, ids)

def exits.inside_all_away.k2(cv: Bool, +run: J.Val, +h: U32, +t: List<&2, U32>) -> Bool:
  match cv:
    case True{}:
      exits.inside_all_away(run, t)
    case False{}:
      False{}

def exits.inside_all_away.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>) -> Bool:
  match sv0:
    case Nil{}:
      True{}
    case Con{+h, +t}:
      exits.inside_all_away.k2(Bool.or(exits.is_outside(run, h), rules.Run.away(run, h)), run, h, t)
# The first seat's entry in the outside map.
def exits.close_first(+run: J.Val) -> J.Val:
  exits.close_first.k1(J.int_fields(J.get(exits.state(run), "outside")), run)

def exits.close_first.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+p, +t}:
      exits.Run.finish_activity_return(run, world.key_val(p))
def exits.rejoin_away(+run: J.Val, +ids: List<&2, U32>) -> J.Val:
  exits.rejoin_away.k1(ids, run, ids)

def exits.rejoin_away.k2(cv: Bool, +run: J.Val, +h: U32, +t: List<&2, U32>) -> J.Val:
  match cv:
    case True{}:
      exits.rejoin_away(exits.Run.rejoin(run, h), t)
    case False{}:
      exits.rejoin_away(run, t)

def exits.rejoin_away.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+h, +t}:
      exits.rejoin_away.k2(rules.Run.away(run, h), run, h, t)
# Knight `id`, waiting outside, back in with the party.
def exits.Run.rejoin(+run: J.Val, +id: U32) -> J.Val:
  +st = exits.state(run)
  +run1 = exits.set_state(run, J.set(st, "outside", J.del(J.get(st, "outside"), U32.show(id))))
  +r = rules.Run.room(run1)
  exits.Run.rejoin.k1(exits.has_hero(run1, id), id, run1, r)

def exits.Run.rejoin.k1(cv: Bool, +id: U32, +run1: J.Val, +r: J.Val) -> J.Val:
  match cv:
    case True{}:
      +h = exits.hero(run1, id)
      +h1 = J.set(J.set(h, "x", J.JF{(layout.Room.width(r) / 2.0 : F32)}), "y", J.JF{(layout.Room.height(r) - 4.5 : F32)})
      exits.set_hero(run1, id, J.set(J.set(h1, "camera", J.JNull{}), "invulnerable", J.JU{30}))
    case False{}:
      run1
# Everyone back to where they walked to (or went in), the place cleared.
def exits.Run.finish_activity_return(+run: J.Val, +back: J.Val) -> J.Val:
  +positions = exits.positions(run, back, J.fields(J.get(run, "players")), J.obj())
  +run1 = exits.set_state(run, exits.State.default())
  +kingdom1 = Bool.pick(J.Val, exits.hall_is(run, J.u32(J.get(back, "at"))), J.get(run1, "kingdom"), J.set(J.get(run1, "kingdom"), "return_to", J.JNull{}))
  +run2 = exits.Run.clear_game_stages(J.set(run1, "kingdom", kingdom1), J.JU{J.u32(J.get(run1, "at"))})
  +run3 = floors.Run.enter(run2, J.u32(J.get(back, "at")), J.JNull{})
  +run4 = exits.put_back(run3, positions, J.fields(J.get(run3, "players")))
  +run5 = J.set(run4, "kingdom", J.set(J.get(run4, "kingdom"), "door_held", J.JBool{True{}}))
  exits.set_state(J.set(run5, "stairs_held", J.JBool{True{}}), J.set(exits.state(run5), "entry", J.JNull{}))
def exits.hall_is(+run: J.Val, +at: U32) -> Bool:
  String.eq(J.str(J.get(layout.Floor.room(J.get(run, "dungeon"), at), "kind")), "colosseum_hall")
def exits.positions(+run: J.Val, +back: J.Val, +players: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +acc: J.Val) -> J.Val:
  exits.positions.k1(players, run, back, players, acc)

def exits.positions.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +back: J.Val, +players: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +acc: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      acc
    case Con{+p, +t}:
      +k = world.key_str(p)
      +h = world.key_val(p)
      +own = J.get(J.get(back, "party"), k)
      +here = {J.JA{[J.get(h, "x"), J.get(h, "y")]} : J.Val}
      +spot = Bool.pick(J.Val, J.has(J.get(J.get(run, "exits"), "outside"), k), here, Bool.pick(J.Val, J.is_null(own), here, own))
      exits.positions(run, back, t, J.set(acc, k, spot))
def exits.put_back(+run: J.Val, +positions: J.Val, +players: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> J.Val:
  exits.put_back.k1(players, run, positions, players)

def exits.put_back.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +positions: J.Val, +players: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+p, +t}:
      +k = world.key_str(p)
      +spot = J.get(positions, k)
      +h = world.key_val(p)
      +h1 = Bool.pick(J.Val, J.is_null(spot), h, J.set(J.set(h, "x", J.nth(spot, 0)), "y", J.nth(spot, 1)))
      exits.put_back(J.set(run, "players", J.set(J.get(run, "players"), k, exits.release_activity_controls(h1))), positions, t)
# `clear_game_stages(room)`: end the stage kept for this room (null: every one).
def exits.Run.clear_game_stages(+run: J.Val, +room: J.Val) -> J.Val:
  +keys = {["folly", "bats", "gantry", "powder", "hop", "nook", "race3d"] : List<&2, String>}
  exits.clear_stages(run, room, keys)
def exits.clear_stages(+run: J.Val, +room: J.Val, +keys: List<&2, String>) -> J.Val:
  exits.clear_stages.k1(keys, run, room, keys)

def exits.clear_stages.k2(cv: Bool, +run: J.Val, +room: J.Val, +k: String, +t: List<&2, String>, +s: J.Val) -> J.Val:
  match cv:
    case True{}:
      exits.clear_stages(J.set(run, k, J.JNull{}), room, t)
    case False{}:
      exits.clear_stages(run, room, t)

def exits.clear_stages.k1(sv0: List<&2, String>, +run: J.Val, +room: J.Val, +keys: List<&2, String>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+k, +t}:
      +s = J.get(run, k)
      exits.clear_stages.k2(Bool.and(Bool.not(J.is_null(s)), Bool.or(J.is_null(room), U32.is_eq(J.u32(J.get(s, "room")), J.u32(room)))), run, room, k, t, s)
# Standing inside the doorway just recorded, or the nearest clear tile.
def exits.Run.safe_activity_return(+run: J.Val, +id: U32, +at: U32) -> J.Val:
  +room = layout.Floor.room(J.get(run, "dungeon"), at)
  exits.Run.safe_activity_return.k1(exits.has_hero(run, id), run, id, at, room)

def exits.Run.safe_activity_return.k1(cv: Bool, +run: J.Val, +id: U32, +at: U32, +room: J.Val) -> J.Val:
  match cv:
    case True{}:
      +h = exits.hero(run, id)
      +x0 = RS.f_clamp(J.f32(J.get(h, "x")), 1.6, (layout.Room.width(room) - 1.6 : F32))
      +y0 = RS.f_clamp(J.f32(J.get(h, "y")), 1.6, (layout.Room.height(room) - 1.6 : F32))
      +h1 = J.set(J.set(h, "x", J.JF{x0}), "y", J.JF{y0})
      +h2 = exits.safe_return.open_door(run, room, at, h1)
      +h3 = exits.safe_return.clear(room, h2)
      +camera = Bool.pick(J.Val, layout.Room.is_kind(room, "kingdom"), J.JA{[J.get(h3, "x"), J.JF{(J.f32(J.get(h3, "y")) - 1.0 : F32)}]}, J.JNull{})
      exits.set_hero(run, id, J.set(h3, "camera", camera))
    case False{}:
      run
# On an open floor's map the threshold crossed is a door tile in a chamber's wall:
# the knight comes out at its landing.
def exits.safe_return.open_door(+run: J.Val, +room: J.Val, +at: U32, +h: J.Val) -> J.Val:
  +open = J.get(J.get(run, "dungeon"), "open")
  exits.safe_return.open_door.k1(Bool.and(Bool.not(J.is_null(open)), U32.is_eq(J.u32(J.get(open, "map")), at)), at, h, open)

def exits.safe_return.open_door.k2(cv: Bool, +h: J.Val, +door: J.Val) -> J.Val:
  match cv:
    case True{}:
      h
    case False{}:
      exits.set_xy(h, open.SideDoor.landing(door))

def exits.safe_return.open_door.k1(cv: Bool, +at: U32, +h: J.Val, +open: J.Val) -> J.Val:
  match cv:
    case True{}:
      +door = open.Open.door_on(open, RS.f_as_i32(F32.floor((J.f32(J.get(h, "x")) / 2.0 : F32))), RS.f_as_i32(F32.floor((J.f32(J.get(h, "y")) / 2.0 : F32))))
      exits.safe_return.open_door.k2(J.is_null(door), h, door)
    case False{}:
      h
def exits.set_xy(+h: J.Val, +p: Sigma<&2, &2, F32, _ => F32>) -> J.Val:
  exits.set_xy.k1(p, h, p)

def exits.set_xy.k1(sv0: Sigma<&2, &2, F32, _ => F32>, +h: J.Val, +p: Sigma<&2, &2, F32, _ => F32>) -> J.Val:
  match sv0:
    case (+x, +y):
      J.set(J.set(h, "x", J.JF{x}), "y", J.JF{y})
# Not in stone: else the nearest clear tile's middle.
def exits.safe_return.clear(+room: J.Val, +h: J.Val) -> J.Val:
  exits.safe_return.clear.k1(rules.Grid.clear(room, False{}, J.f32(J.get(h, "x")), J.f32(J.get(h, "y")), 0.42, 0), room, h)

def exits.safe_return.clear.k1(cv: Bool, +room: J.Val, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      h
    case False{}:
      exits.safe_return.nearest(room, h)
def exits.safe_return.nearest(+room: J.Val, +h: J.Val) -> J.Val:
  +best = exits.nearest.rows(room, 1, layout.Room.rows(room), layout.Room.cols(room), J.f32(J.get(h, "x")), J.f32(J.get(h, "y")), LayFind{False{}, 0, 0}, 3.4028235e38)
  exits.nearest.out(best, h)
def exits.nearest.out(+best: LayFind, +h: J.Val) -> J.Val:
  exits.nearest.out.k1(best, best, h)

def exits.nearest.out.k2(cv: Bool, +h: J.Val, +ok: Bool, +a: U32, +b: U32) -> J.Val:
  match cv:
    case True{}:
      J.set(J.set(h, "x", J.JF{((U32.to_f32(a) + 0.5 : F32) * 2.0 : F32)}), "y", J.JF{((U32.to_f32(b) + 0.5 : F32) * 2.0 : F32)})
    case False{}:
      h

def exits.nearest.out.k1(sv0: LayFind, +best: LayFind, +h: J.Val) -> J.Val:
  match sv0:
    case LayFind{+ok, +a, +b}:
      exits.nearest.out.k2(ok, h, ok, a, b)
def exits.nearest.rows(+room: J.Val, +y: U32, +rows: U32, +cols: U32, +hx: F32, +hy: F32, +best: LayFind, +bd: F32) -> LayFind:
  exits.nearest.rows.k1(U32.is_ge(y, (rows - 1 : U32)), room, y, rows, cols, hx, hy, best, bd)

def exits.nearest.rows.k1(cv: Bool, +room: J.Val, +y: U32, +rows: U32, +cols: U32, +hx: F32, +hy: F32, +best: LayFind, +bd: F32) -> LayFind:
  match cv:
    case True{}:
      best
    case False{}:
      exits.nearest.cols(room, y, 1, rows, cols, hx, hy, best, bd)
def exits.nearest.cols(+room: J.Val, +y: U32, +x: U32, +rows: U32, +cols: U32, +hx: F32, +hy: F32, +best: LayFind, +bd: F32) -> LayFind:
  exits.nearest.cols.k1(U32.is_ge(x, (cols - 1 : U32)), room, y, x, rows, cols, hx, hy, best, bd)

def exits.nearest.cols.k3(cv: Bool, +room: J.Val, +y: U32, +x: U32, +rows: U32, +cols: U32, +hx: F32, +hy: F32, +best: LayFind, +bd: F32, +d: F32) -> LayFind:
  match cv:
    case True{}:
      exits.nearest.cols(room, y, (x + 1 : U32), rows, cols, hx, hy, LayFind{True{}, x, y}, d)
    case False{}:
      exits.nearest.cols(room, y, (x + 1 : U32), rows, cols, hx, hy, best, bd)

def exits.nearest.cols.k2(cv: Bool, +room: J.Val, +y: U32, +x: U32, +rows: U32, +cols: U32, +hx: F32, +hy: F32, +best: LayFind, +bd: F32, +cx: F32, +cy: F32) -> LayFind:
  match cv:
    case True{}:
      +d = RS.f_hypot((cx - hx : F32), (cy - hy : F32))
      exits.nearest.cols.k3(F32.is_lt(d, bd), room, y, x, rows, cols, hx, hy, best, bd, d)
    case False{}:
      exits.nearest.cols(room, y, (x + 1 : U32), rows, cols, hx, hy, best, bd)

def exits.nearest.cols.k1(cv: Bool, +room: J.Val, +y: U32, +x: U32, +rows: U32, +cols: U32, +hx: F32, +hy: F32, +best: LayFind, +bd: F32) -> LayFind:
  match cv:
    case True{}:
      exits.nearest.rows(room, (y + 1 : U32), rows, cols, hx, hy, best, bd)
    case False{}:
      +cx = ((U32.to_f32(x) + 0.5 : F32) * 2.0 : F32)
      +cy = ((U32.to_f32(y) + 0.5 : F32) * 2.0 : F32)
      exits.nearest.cols.k2(rules.Grid.clear(room, False{}, cx, cy, 0.42, 0), room, y, x, rows, cols, hx, hy, best, bd, cx, cy)
# Seats outside the room walk freely and can rejoin at their entry point.
# Their bodies leave the activity's working set: the detached heroes.
def exits.Run.detached_seats(+run: J.Val, +inputs: J.Val) -> J.Val & J.Val:
  +run1 = exits.walk_outside(run, exits.outside_ids(run), inputs)
  +ids = exits.detach_ids(run1, exits.ids_all(run1), inputs)
  exits.detach(run1, ids, J.obj())
def exits.detach_ids(+run: J.Val, +ids: List<&2, U32>, +inputs: J.Val) -> List<&2, U32>:
  exits.detach_ids.k1(ids, run, ids, inputs)

def exits.detach_ids.k2(cv: Bool, +run: J.Val, +inputs: J.Val, +id: U32, +t: List<&2, U32>, +menu: Bool) -> List<&2, U32>:
  match cv:
    case True{}:
      Con{id, exits.detach_ids(run, t, inputs)}
    case False{}:
      exits.detach_ids(run, t, inputs)

def exits.detach_ids.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>, +inputs: J.Val) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      +i = J.get(inputs, U32.show(id))
      +menu = Bool.and(Bool.and(Bool.not(J.is_null(i)), rules.Input.valid(i)), Bool.and(J.bool(J.get(i, "activity_menu")), exits.Run.can_leave_activity(run, id)))
      exits.detach_ids.k2(Bool.or(exits.is_outside(run, id), menu), run, inputs, id, t, menu)
def exits.detach(+run: J.Val, +ids: List<&2, U32>, +out: J.Val) -> J.Val & J.Val:
  exits.detach.k1(ids, run, ids, out)

def exits.detach.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>, +out: J.Val) -> J.Val & J.Val:
  match sv0:
    case Nil{}:
      (run, out)
    case Con{+id, +t}:
      +k = U32.show(id)
      exits.detach(J.set(run, "players", J.del(J.get(run, "players"), k)), t, J.set(out, k, exits.hero(run, id)))
# Each waiting seat walks the room it waits in, or comes back in at its entry.
def exits.walk_outside(+run: J.Val, +ids: List<&2, U32>, +inputs: J.Val) -> J.Val:
  exits.walk_outside.k1(ids, run, ids, inputs)

def exits.walk_outside.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>, +inputs: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      exits.walk_outside(exits.walk_one(run, id, inputs), t, inputs)
def exits.walk_one(+run: J.Val, +id: U32, +inputs: J.Val) -> J.Val:
  exits.walk_one.k1(exits.has_hero(run, id), run, id, inputs)

def exits.walk_one.k3(cv: Bool, +run: J.Val, +id: U32, +back: J.Val, +h1: J.Val, +input1: J.Val, +entry: J.Val) -> J.Val:
  match cv:
    case True{}:
      exits.Run.rejoin(exits.set_hero(run, id, h1), id)
    case False{}:
      exits.walk_free(exits.set_hero(run, id, h1), id, input1, back)

def exits.walk_one.k2(pr: J.Val & J.Val, +run: J.Val, +id: U32, +back: J.Val) -> J.Val:
  (+h1, +input1) = pr
  +entry = Bool.pick(J.Val, J.is_null(J.get(J.get(back, "party"), U32.show(id))), J.JA{[J.get(h1, "x"), J.get(h1, "y")]}, J.get(J.get(back, "party"), U32.show(id)))
  exits.walk_one.k3(Bool.and(J.bool(J.get(input1, "interact")), F32.is_lt(RS.f_hypot((J.f32(J.get(h1, "x")) - J.f32(J.nth(entry, 0)) : F32), (J.f32(J.get(h1, "y")) - J.f32(J.nth(entry, 1)) : F32)), 2.5)), run, id, back, h1, input1, entry)

def exits.walk_one.k1(cv: Bool, +run: J.Val, +id: U32, +inputs: J.Val) -> J.Val:
  match cv:
    case True{}:
      +back = J.get(J.get(exits.state(run), "outside"), U32.show(id))
      +i0 = J.get(inputs, U32.show(id))
      +input = Bool.pick(J.Val, Bool.and(Bool.not(J.is_null(i0)), rules.Input.valid(i0)), i0, rules.Input.default())
      exits.walk_one.k2(hero.Hero.held_off(exits.hero(run, id), input), run, id, back)
    case False{}:
      run
def exits.walk_free(+run: J.Val, +id: U32, +input: J.Val, +back: J.Val) -> J.Val:
  +room = layout.Floor.room(J.get(run, "dungeon"), J.u32(J.get(back, "at")))
  +h = exits.hero(run, id)
  exits.walk_free.k1(rules.unit(J.f32(J.get(input, "move_x")), J.f32(J.get(input, "move_y"))), run, id, input, room, h)

def exits.walk_free.k3(pr: F32 & F32, +run: J.Val, +id: U32, +room: J.Val, +h2: J.Val) -> J.Val:
  (+nx, +ny) = pr
  +h3 = J.set(J.set(h2, "x", J.JF{nx}), "y", J.JF{ny})
  +camera = Bool.pick(J.Val, layout.Room.is_kind(room, "kingdom"), J.JA{[J.JF{nx}, J.JF{(ny - 1.0 : F32)}]}, J.JNull{})
  exits.set_hero(run, id, J.set(h3, "camera", camera))

def exits.walk_free.k2(pr: F32 & F32, +run: J.Val, +id: U32, +room: J.Val, +h: J.Val, +dx: F32, +dy: F32) -> J.Val:
  (+ax, +ay) = pr
  +h1 = Bool.pick(J.Val, Bool.or(F32.is_ne(ax, 0.0), F32.is_ne(ay, 0.0)), J.set(J.set(h, "aim_x", J.JF{ax}), "aim_y", J.JF{ay}), h)
  +h2 = hero.Pit.tick_hero(h1)
  +pace = fx.ground_pace(h2, J.get(run, "tune"), J.JA{Nil{}}, J.JNull{}, Bool.and(layout.Room.is_kind(room, "kingdom"), kingdom.on_road(run, J.f32(J.get(h2, "x")), J.f32(J.get(h2, "y")))))
  exits.walk_free.k3(rules.Grid.slide(room, False{}, (J.f32(J.get(h2, "x")), J.f32(J.get(h2, "y"))), ((dx * pace * 0.03333333507180214 : F32), (dy * pace * 0.03333333507180214 : F32)), 0.42, 0), run, id, room, h2)

def exits.walk_free.k1(pr: F32 & F32, +run: J.Val, +id: U32, +input: J.Val, +room: J.Val, +h: J.Val) -> J.Val:
  (+dx, +dy) = pr
  exits.walk_free.k2(rules.unit(J.f32(J.get(input, "aim_x")), J.f32(J.get(input, "aim_y"))), run, id, room, h, dx, dy)
# `clear_activity`: the rides end with the room, the working sets empty.
def exits.Run.clear_activity(+run: J.Val) -> J.Val:
  +r1 = exits.Run.clear_game_stages(rules.Run.end_outside_activities(run), J.JNull{})
  +r1a = J.set(J.set(J.set(r1, "forest", forest.Forest.leave(J.get(r1, "forest"))), "college", college.Dialogue.default()), "pastimes", pastimes.Pastimes.leave(J.get(r1, "pastimes")))
  +r2 = J.set(J.set(r1a, "waves", hazards.Waves.default()), "traps", J.JA{Nil{}})
  +r3 = exits.empty_lists(r2, ["rocks", "enemies", "projectiles", "imps", "strikes", "spheres", "phantoms", "kegs", "lobs", "flings", "wells", "hooks", "webs", "slams", "ravages", "holes", "critters"])
  +r3a = J.set(r3, "works", works.Works.leave_room(J.get(r3, "works")))
  +r3b = exits.empty_lists(r3a, ["sparks", "blasts", "boons"])
  +r4 = J.set(J.set(J.set(J.set(J.set(r3b, "light", J.JNull{}), "window", J.JNull{}), "rune", J.JNull{}), "build_hold", J.JNull{}), "descending", J.JU{0})
  J.set(r4, "descend_for", J.JNull{})
def exits.empty_lists(+run: J.Val, +keys: List<&2, String>) -> J.Val:
  exits.empty_lists.k1(keys, run, keys)

def exits.empty_lists.k1(sv0: List<&2, String>, +run: J.Val, +keys: List<&2, String>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+k, +t}:
      exits.empty_lists(J.set(run, k, J.JA{Nil{}}), t)
