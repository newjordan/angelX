def world.walled(+cell: LayCell, +kind: String) -> J.Val:
  layout.cellar.walled(cell, kind)
def world.fill(+room: J.Val, +rects: List<&2, LayRect>, +t: LayTile) -> J.Val:
  layout.grid.put(room, layout.fill_rects(layout.grid.of_room(room), rects, t))
