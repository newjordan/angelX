# Add the world to a home floor that lacks it: its rooms, and the Undercroft's
# stair up. True if anything was added.
def world.raise_world(+floor: J.Val) -> J.Val & Bool:
  +cellar = layout.kinds_first(floor, "home")
  world.raise_world.k1(Bool.or(U32.is_ne(J.u32(J.get(floor, "depth")), 0), U32.is_eq(cellar, 4294967295)), floor, cellar)

def world.raise_world.k6(cv: Bool, +f4: J.Val, +changed: Bool) -> J.Val & Bool:
  match cv:
    case True{}:
      (J.set(f4, "world_revision", J.JU{(J.u32(J.get(f4, "world_revision")) + 1 : U32)}), True{})
    case False{}:
      (f4, False{})

def world.raise_world.k5(pr: J.Val & Bool, +c1: Bool, +c2: Bool, +c3: Bool) -> J.Val & Bool:
  (+f4, +c4) = pr
  +changed = Bool.or(Bool.or(c1, c2), Bool.or(c3, c4))
  world.raise_world.k6(changed, f4, changed)

def world.raise_world.k4(pr: J.Val & Bool, +c1: Bool, +c2: Bool) -> J.Val & Bool:
  (+f3, +c3) = pr
  world.raise_world.k5(world.raise.trails(f3, world.TRAILS()), c1, c2, c3)

def world.raise_world.k3(pr: J.Val & Bool, +c1: Bool) -> J.Val & Bool:
  (+f2, +c2) = pr
  world.raise_world.k4(world.raise.plates(f2, world.ENTRANCES()), c1, c2)

def world.raise_world.k2(pr: J.Val & Bool) -> J.Val & Bool:
  (+f1, +c1) = pr
  world.raise_world.k3(world.raise.rooms(f1, world.ROOMS()), c1)

def world.raise_world.k1(cv: Bool, +floor: J.Val, +cellar: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      (floor, False{})
    case False{}:
      world.raise_world.k2(world.raise.stair(floor, cellar))
# Stairs tiles of the rect in room `i`; whether any changed.
def world.stairs_rect(+floor: J.Val, +i: U32, +c: U32, +r: U32, +w: U32, +h: U32) -> J.Val & Bool:
  +room = layout.Floor.room(floor, i)
  +g = layout.grid.of_room(room)
  +changed = world.rect_not(g, c, r, w, h, TileStairs{})
  +g2 = layout.fill_rects(g, world.rect(c, r, w, h), TileStairs{})
  (J.set(floor, "rooms", J.set_nth(layout.Floor.rooms(floor), i, layout.grid.put(room, g2))), changed)
# Whether any tile of the rect is not \`t\`.
def world.rect_not(+g: LayGrid, +c: U32, +r: U32, +w: U32, +h: U32, +t: LayTile) -> Bool:
  world.rect_not.rows(g, c, r, w, r, (r + h : U32), t)
def world.rect_not.rows(+g: LayGrid, +c: U32, +r: U32, +w: U32, +y: U32, +y2: U32, +t: LayTile) -> Bool:
  world.rect_not.rows.k1(U32.is_ge(y, y2), g, c, r, w, y, y2, t)

def world.rect_not.rows.k2(cv: Bool, +g: LayGrid, +c: U32, +r: U32, +w: U32, +y: U32, +y2: U32, +t: LayTile) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      world.rect_not.rows(g, c, r, w, (y + 1 : U32), y2, t)

def world.rect_not.rows.k1(cv: Bool, +g: LayGrid, +c: U32, +r: U32, +w: U32, +y: U32, +y2: U32, +t: LayTile) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      world.rect_not.rows.k2(world.rect_not.cols(g, c, c, (c + w : U32), y, t), g, c, r, w, y, y2, t)
def world.rect_not.cols(+g: LayGrid, +c: U32, +x: U32, +x2: U32, +y: U32, +t: LayTile) -> Bool:
  world.rect_not.cols.k1(U32.is_ge(x, x2), g, c, x, x2, y, t)

def world.rect_not.cols.k2(cv: Bool, +g: LayGrid, +c: U32, +x: U32, +x2: U32, +y: U32, +t: LayTile) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      world.rect_not.cols(g, c, (x + 1 : U32), x2, y, t)

def world.rect_not.cols.k1(cv: Bool, +g: LayGrid, +c: U32, +x: U32, +x2: U32, +y: U32, +t: LayTile) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      world.rect_not.cols.k2(Bool.not(layout.Tile.eq(layout.grid.get(g, x, y), t)), g, c, x, x2, y, t)
def world.raise.stair(+floor: J.Val, +cellar: U32) -> J.Val & Bool:
  world.stairs_rect(floor, cellar, 13, 1, 2, 1)
# Every authored room whose cell is free, up to the limit.
def world.raise.rooms(+floor: J.Val, +rooms: List<&2, WorldRoom>) -> J.Val & Bool:
  world.raise.rooms.k1(rooms, floor, rooms)

def world.raise.rooms.k4(pr: J.Val & Bool) -> J.Val & Bool:
  (+f2, +c) = pr
  (f2, True{})

def world.raise.rooms.k3(cv: Bool, +floor: J.Val, +t: List<&2, WorldRoom>, +kind: String, +x: U32, +y: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      world.raise.rooms(floor, t)
    case False{}:
      +f1 = layout.floor_with_rooms(floor, List.append(&2, J.Val, J.items(layout.Floor.rooms(floor)), [world.world_room(kind, LayCell{x, y})]))
      world.raise.rooms.k4(world.raise.rooms(f1, t))

def world.raise.rooms.k2(pr: WorldRoom, +floor: J.Val, +t: List<&2, WorldRoom>) -> J.Val & Bool:
  match pr:
    case WorldRoom{+kind, +x, +y}:
      world.raise.rooms.k3(Bool.or(U32.is_ge(layout.Floor.len(floor), 128), layout.Floor.taken(floor, x, y)), floor, t, kind, x, y)

def world.raise.rooms.k1(sv0: List<&2, WorldRoom>, +floor: J.Val, +rooms: List<&2, WorldRoom>) -> J.Val & Bool:
  match sv0:
    case Nil{}:
      (floor, False{})
    case Con{+wr, +t}:
      world.raise.rooms.k2(wr, floor, t)
# New travel plates migrate into existing authored surface rooms.
def world.raise.plates(+floor: J.Val, +es: List<&2, WorldEntrance>) -> J.Val & Bool:
  world.raise.plates.k1(es, floor, es)

def world.raise.plates.k6(pr: J.Val & Bool, +c1: Bool) -> J.Val & Bool:
  (+f2, +c2) = pr
  (f2, Bool.or(c1, c2))

def world.raise.plates.k5(pr: J.Val & Bool, +t: List<&2, WorldEntrance>) -> J.Val & Bool:
  (+f1, +c1) = pr
  world.raise.plates.k6(world.raise.plates(f1, t), c1)

def world.raise.plates.k4(cv: Bool, +floor: J.Val, +t: List<&2, WorldEntrance>, +c: U32, +r: U32, +w: U32, +h: U32, +i: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      world.raise.plates(floor, t)
    case False{}:
      world.raise.plates.k5(world.stairs_rect(floor, i, c, r, w, h), t)

def world.raise.plates.k3(cv: Bool, +floor: J.Val, +t: List<&2, WorldEntrance>, +room: String, +c: U32, +r: U32, +w: U32, +h: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      +cell = world.reserved(room)
      +i = world.room_at_kind(floor, room, cell)
      world.raise.plates.k4(U32.is_eq(i, 4294967295), floor, t, c, r, w, h, i)
    case False{}:
      world.raise.plates(floor, t)

def world.raise.plates.k2(pr: WorldEntrance, +floor: J.Val, +t: List<&2, WorldEntrance>) -> J.Val & Bool:
  match pr:
    case WorldEntrance{+id, +room, +c, +r, +w, +h, +to_room, +to_x, +to_y, +delve, +label, +needs}:
      world.raise.plates.k3(world.RoomKind.in_world(room), floor, t, room, c, r, w, h)

def world.raise.plates.k1(sv0: List<&2, WorldEntrance>, +floor: J.Val, +es: List<&2, WorldEntrance>) -> J.Val & Bool:
  match sv0:
    case Nil{}:
      (floor, False{})
    case Con{+e, +t}:
      world.raise.plates.k2(e, floor, t)
# The cell the authored table reserves for a kind.
def world.reserved(+kind: String) -> LayCell:
  world.reserved.go(world.ROOMS(), kind)
def world.reserved.go(+rooms: List<&2, WorldRoom>, +kind: String) -> LayCell:
  world.reserved.go.k1(rooms, rooms, kind)

def world.reserved.go.k3(cv: Bool, +kind: String, +t: List<&2, WorldRoom>, +k: String, +x: U32, +y: U32) -> LayCell:
  match cv:
    case True{}:
      LayCell{x, y}
    case False{}:
      world.reserved.go(t, kind)

def world.reserved.go.k2(pr: WorldRoom, +kind: String, +t: List<&2, WorldRoom>) -> LayCell:
  match pr:
    case WorldRoom{+k, +x, +y}:
      world.reserved.go.k3(String.eq(k, kind), kind, t, k, x, y)

def world.reserved.go.k1(sv0: List<&2, WorldRoom>, +rooms: List<&2, WorldRoom>, +kind: String) -> LayCell:
  match sv0:
    case Nil{}:
      LayCell{0, 0}
    case Con{+wr, +t}:
      world.reserved.go.k2(wr, kind, t)
# The index of the room of \`kind\` standing at \`cell\` (usize::MAX for none).
def world.room_at_kind(+floor: J.Val, +kind: String, +cell: LayCell) -> U32:
  world.room_at_kind.go(J.items(layout.Floor.rooms(floor)), kind, cell, 0)
def world.room_at_kind.go(+rooms: List<&2, J.Val>, +kind: String, +cell: LayCell, +i: U32) -> U32:
  world.room_at_kind.go.k1(rooms, rooms, kind, cell, i)

def world.room_at_kind.go.k3(cv: Bool, +kind: String, +cell: LayCell, +i: U32, +r: J.Val, +t: List<&2, J.Val>, +x: U32, +y: U32) -> U32:
  match cv:
    case True{}:
      i
    case False{}:
      world.room_at_kind.go(t, kind, cell, (i + 1 : U32))

def world.room_at_kind.go.k2(pr: LayCell, +kind: String, +cell: LayCell, +i: U32, +r: J.Val, +t: List<&2, J.Val>) -> U32:
  match pr:
    case LayCell{+x, +y}:
      world.room_at_kind.go.k3(Bool.and(layout.Room.is_kind(r, kind), layout.cell.is(layout.Room.cell(r), x, y)), kind, cell, i, r, t, x, y)

def world.room_at_kind.go.k1(sv0: List<&2, J.Val>, +rooms: List<&2, J.Val>, +kind: String, +cell: LayCell, +i: U32) -> U32:
  match sv0:
    case Nil{}:
      4294967295
    case Con{+r, +t}:
      world.room_at_kind.go.k2(cell, kind, cell, i, r, t)
# Join the authored roads: both rooms are the reserved ones and lie side by side.
def world.raise.trails(+floor: J.Val, +ts: List<&2, Sigma<&2, &2, String, _ => String>>) -> J.Val & Bool:
  world.raise.trails.k1(ts, floor, ts)

def world.raise.trails.k1(sv0: List<&2, Sigma<&2, &2, String, _ => String>>, +floor: J.Val, +ts: List<&2, Sigma<&2, &2, String, _ => String>>) -> J.Val & Bool:
  match sv0:
    case Nil{}:
      (floor, False{})
    case Con{+p, +t}:
      world.raise.trails.pair(floor, p, t)
def world.raise.trails.pair(+floor: J.Val, +p: Sigma<&2, &2, String, _ => String>, +t: List<&2, Sigma<&2, &2, String, _ => String>>) -> J.Val & Bool:
  world.raise.trails.pair.k1(p, floor, p, t)

def world.raise.trails.pair.k3(pr: J.Val & Bool, +c1: Bool) -> J.Val & Bool:
  (+f2, +c2) = pr
  (f2, Bool.or(c1, c2))

def world.raise.trails.pair.k2(pr: J.Val & Bool, +t: List<&2, Sigma<&2, &2, String, _ => String>>) -> J.Val & Bool:
  (+f1, +c1) = pr
  world.raise.trails.pair.k3(world.raise.trails(f1, t), c1)

def world.raise.trails.pair.k1(sv0: Sigma<&2, &2, String, _ => String>, +floor: J.Val, +p: Sigma<&2, &2, String, _ => String>, +t: List<&2, Sigma<&2, &2, String, _ => String>>) -> J.Val & Bool:
  match sv0:
    case (+a, +b):
      world.raise.trails.pair.k2(world.raise.trail(floor, a, b), t)
def world.raise.trail(+floor: J.Val, +a: String, +b: String) -> J.Val & Bool:
  +ai = world.room_at_kind(floor, a, world.reserved(a))
  +bi = world.room_at_kind(floor, b, world.reserved(b))
  world.raise.trail.k1(Bool.or(U32.is_eq(ai, 4294967295), U32.is_eq(bi, 4294967295)), floor, ai, bi)

def world.raise.trail.k6(pr: J.Val & Bool, +c1: Bool) -> J.Val & Bool:
  (+f2, +c2) = pr
  (f2, Bool.or(c1, c2))

def world.raise.trail.k5(pr: J.Val & Bool, +bi: U32, +dir: U32) -> J.Val & Bool:
  (+f1, +c1) = pr
  world.raise.trail.k6(world.raise.side(f1, bi, U32.and((dir + 2 : U32), 3)), c1)

def world.raise.trail.k4(cv: Bool, +floor: J.Val, +ai: U32, +bi: U32, +dir: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      (floor, False{})
    case False{}:
      world.raise.trail.k5(world.raise.side(floor, ai, dir), bi, dir)

def world.raise.trail.k3(pr: LayCell, +floor: J.Val, +ai: U32, +bi: U32, +ax: U32, +ay: U32) -> J.Val & Bool:
  match pr:
    case LayCell{+bx, +by}:
      +dir = world.dir_toward(ax, ay, bx, by, 0)
      world.raise.trail.k4(U32.is_eq(dir, 4294967295), floor, ai, bi, dir)

def world.raise.trail.k2(pr: LayCell, +floor: J.Val, +ai: U32, +bi: U32) -> J.Val & Bool:
  match pr:
    case LayCell{+ax, +ay}:
      world.raise.trail.k3(layout.Room.cell(layout.Floor.room(floor, bi)), floor, ai, bi, ax, ay)

def world.raise.trail.k1(cv: Bool, +floor: J.Val, +ai: U32, +bi: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      (floor, False{})
    case False{}:
      world.raise.trail.k2(layout.Room.cell(layout.Floor.room(floor, ai)), floor, ai, bi)
def world.dir_toward(+ax: U32, +ay: U32, +bx: U32, +by: U32, +d: U32) -> U32:
  world.dir_toward.k1(U32.is_ge(d, 4), ax, ay, bx, by, d)

def world.dir_toward.k2(cv: Bool, +ax: U32, +ay: U32, +bx: U32, +by: U32, +d: U32) -> U32:
  match cv:
    case True{}:
      d
    case False{}:
      world.dir_toward(ax, ay, bx, by, (d + 1 : U32))

def world.dir_toward.k1(cv: Bool, +ax: U32, +ay: U32, +bx: U32, +by: U32, +d: U32) -> U32:
  match cv:
    case True{}:
      4294967295
    case False{}:
      world.dir_toward.k2(Bool.and(U32.is_eq((ax + layout.DX(d) : U32), bx), U32.is_eq((ay + layout.DY(d) : U32), by)), ax, ay, bx, by, d)
# Open a side of room \`i\`, and clear the arrival fan a north road needs.
def world.raise.side(+floor: J.Val, +i: U32, +side: U32) -> J.Val & Bool:
  +room = layout.Floor.room(floor, i)
  +opened = Bool.not(layout.Room.door(room, side))
  +room1 = Bool.pick(J.Val, opened, layout.Room.open_door(room, side), room)
  world.raise.side.k1(world.raise.fan(room1, side), floor, i, opened)

def world.raise.side.k1(pr: J.Val & Bool, +floor: J.Val, +i: U32, +opened: Bool) -> J.Val & Bool:
  (+room2, +cleared) = pr
  (J.set(floor, "rooms", J.set_nth(layout.Floor.rooms(floor), i, room2)), Bool.or(opened, cleared))
# A north road must clear all four arriving knights\' width of the room it enters.
def world.raise.fan(+room: J.Val, +side: U32) -> J.Val & Bool:
  world.raise.fan.k1(U32.is_eq(side, 0), room, side)

def world.raise.fan.k5(cv: Bool, +room: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      world.clear_blocks(room, 9, 1, 15, 5)
    case False{}:
      (room, False{})

def world.raise.fan.k4(cv: Bool, +room: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      world.clear_blocks(room, 9, 1, 15, 4)
    case False{}:
      world.raise.fan.k5(layout.Room.is_kind(room, "stables"), room)

def world.raise.fan.k3(cv: Bool, +room: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      world.clear_blocks(room, 9, 1, 11, 4)
    case False{}:
      world.raise.fan.k4(layout.Room.is_kind(room, "mine_head"), room)

def world.raise.fan.k2(cv: Bool, +room: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      world.clear_blocks(room, 9, 1, 15, 3)
    case False{}:
      world.raise.fan.k3(layout.Room.is_kind(room, "cliffs"), room)

def world.raise.fan.k1(cv: Bool, +room: J.Val, +side: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      world.raise.fan.k2(layout.Room.is_kind(room, "lists"), room)
    case False{}:
      (room, False{})
# Block tiles in [x0, x1) x [y0, y1) become floor; whether any did.
def world.clear_blocks(+room: J.Val, +x0: U32, +y0: U32, +x1: U32, +y1: U32) -> J.Val & Bool:
  +g = layout.grid.of_room(room)
  +any = world.rect_any_block(g, x0, y0, x1, y1)
  (layout.grid.put(room, world.unblock(g, x0, y0, x1, y1)), any)
def world.rect_any_block(+g: LayGrid, +x0: U32, +y0: U32, +x1: U32, +y1: U32) -> Bool:
  world.rect_any_block.k1(U32.is_ge(y0, y1), g, x0, y0, x1, y1)

def world.rect_any_block.k2(cv: Bool, +g: LayGrid, +x0: U32, +y0: U32, +x1: U32, +y1: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      world.rect_any_block(g, x0, (y0 + 1 : U32), x1, y1)

def world.rect_any_block.k1(cv: Bool, +g: LayGrid, +x0: U32, +y0: U32, +x1: U32, +y1: U32) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      world.rect_any_block.k2(world.row_any_block(g, x0, y0, x1), g, x0, y0, x1, y1)
def world.row_any_block(+g: LayGrid, +x: U32, +y: U32, +x1: U32) -> Bool:
  world.row_any_block.k1(U32.is_ge(x, x1), g, x, y, x1)

def world.row_any_block.k2(cv: Bool, +g: LayGrid, +x: U32, +y: U32, +x1: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      world.row_any_block(g, (x + 1 : U32), y, x1)

def world.row_any_block.k1(cv: Bool, +g: LayGrid, +x: U32, +y: U32, +x1: U32) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      world.row_any_block.k2(layout.tile_is_block(layout.grid.get(g, x, y)), g, x, y, x1)
# Walk the party into room \`index\` and stand them around \`at\` (tiles), side by side.
def world.Run.arrive(+run: J.Val, +index: U32, +at_x: F32, +at_y: F32) -> J.Val:
  +run1 = floors.Run.enter(run, index, J.JNull{})
  +ids = exits.ids_all(run1)
  +count = U32.to_f32(layout.list.u32_len(ids))
  +run2 = world.arrive.stand(run1, ids, 0, count, at_x, at_y)
  +run3 = hireling.Run.hireling_follows(cat.Run.tallow_follows(run2))
  kingdom.Run.record_kingdom_visit(J.set(run3, "stairs_held", J.JBool{True{}}))
def world.stand_apart(+count: F32) -> F32:
  world.stand_apart.k1(F32.is_gt(count, 4.0), count)

def world.stand_apart.k1(cv: Bool, +count: F32) -> F32:
  match cv:
    case True{}:
      (((3.0 * 2.4 : F32) / (count - 1.0 : F32)) : F32)
    case False{}:
      2.4
def world.arrive.stand(+run: J.Val, +ids: List<&2, U32>, +slot: U32, +count: F32, +at_x: F32, +at_y: F32) -> J.Val:
  world.arrive.stand.k1(ids, run, ids, slot, count, at_x, at_y)

def world.arrive.stand.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>, +slot: U32, +count: F32, +at_x: F32, +at_y: F32) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      +offset = ((U32.to_f32(slot) - ((count - 1.0 : F32) / 2.0 : F32) : F32) * world.stand_apart(count) : F32)
      +h = J.set(J.set(exits.hero(run, id), "x", J.JF{((at_x * 2.0 : F32) + offset : F32)}), "y", J.JF{(at_y * 2.0 : F32)})
      world.arrive.stand(exits.set_hero(run, id, h), t, (slot + 1 : U32), count, at_x, at_y)
# Through an entrance: to another room, or down into a delve.
def world.Run.take_entrance(+run: J.Val, +e: WorldEntrance) -> J.Val:
  world.Run.take_entrance.k1(kingdom.Run.returns_to_kingdom(run, world.Entrance.id(e)), run, e)

def world.Run.take_entrance.k1(cv: Bool, +run: J.Val, +e: WorldEntrance) -> J.Val:
  match cv:
    case True{}:
      kingdom.Run.leave_kingdom_place(run)
    case False{}:
      world.take_entrance.dest(run, e)
def world.take_entrance.dest(+run: J.Val, +e: WorldEntrance) -> J.Val:
  world.take_entrance.dest.k1(e, run, e)

def world.take_entrance.dest.k3(cv: Bool, +run: J.Val, +id: String, +to_room: String, +to_x: F32, +to_y: F32, +index: U32) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +from_surface = world.RoomKind.in_world(J.str(J.get(rules.Run.room(run), "kind")))
      +run1 = world.Run.arrive(run, index, to_x, to_y)
      +run2 = Bool.pick(J.Val, Bool.and(String.eq(to_room, "home"), from_surface), floor_plates.Run.begin_floor_plate(run1, "gate"), run1)
      +run3 = exits.push_sound(run2, "door_open")
      J.set(run3, "cues", J.push(J.get(run3, "cues"), J.JS{Bool.pick(String, String.eq(to_room, "home"), "home", String.append("entrance:", id))}))

def world.take_entrance.dest.k2(cv: Bool, +run: J.Val, +id: String, +to_room: String, +to_x: F32, +to_y: F32, +delve: String) -> J.Val:
  match cv:
    case True{}:
      world.take_entrance.delve(run, id, delve)
    case False{}:
      +index = world.room_of(J.get(run, "dungeon"), to_room)
      world.take_entrance.dest.k3(U32.is_eq(index, 4294967295), run, id, to_room, to_x, to_y, index)

def world.take_entrance.dest.k1(sv0: WorldEntrance, +run: J.Val, +e: WorldEntrance) -> J.Val:
  match sv0:
    case WorldEntrance{+id, +room, +c, +r, +w, +h, +to_room, +to_x, +to_y, +delve, +label, +needs}:
      world.take_entrance.dest.k2(String.eq(to_room, ""), run, id, to_room, to_x, to_y, delve)
# The shaft goes to the first floor of its delve, whatever landing Wren has
# drawn on the Winding Stair.
def world.take_entrance.delve(+run: J.Val, +id: String, +pack: String) -> J.Val:
  +landing = J.get(J.get(run, "home"), "landing")
  +run1 = J.set(run, "home", J.set(J.get(run, "home"), "landing", J.JU{1}))
  +run2 = J.set(run1, "dungeon", J.set(J.get(run1, "dungeon"), "pack", J.JS{pack}))
  +run3 = J.set(run2, "cues", J.push(J.get(run2, "cues"), J.JS{String.append("entrance:", id)}))
  +run4 = floors.Run.descend(run3)
  J.set(run4, "home", J.set(J.get(run4, "home"), "landing", landing))
# One tick in a room of the world: the kingdom, its rooms' games and the
# pastimes, from the registry (activity::WORLD).
def world.Run.tick_world(+run: J.Val, +inputs: J.Val) -> J.Val:
  activity.Run.tick_world_games(run, inputs)
# Block tiles in [x0, x1) x [y0, y1) become floor.
def world.unblock(+g: LayGrid, +x0: U32, +y0: U32, +x1: U32, +y1: U32) -> LayGrid:
  world.unblock.k1(U32.is_ge(y0, y1), g, x0, y0, x1, y1)

def world.unblock.k1(cv: Bool, +g: LayGrid, +x0: U32, +y0: U32, +x1: U32, +y1: U32) -> LayGrid:
  match cv:
    case True{}:
      g
    case False{}:
      world.unblock(world.unblock.row(g, x0, y0, x1), x0, (y0 + 1 : U32), x1, y1)
def world.unblock.row(+g: LayGrid, +x: U32, +y: U32, +x1: U32) -> LayGrid:
  world.unblock.row.k1(U32.is_ge(x, x1), g, x, y, x1)

def world.unblock.row.k2(cv: Bool, +g: LayGrid, +x: U32, +y: U32, +x1: U32) -> LayGrid:
  match cv:
    case True{}:
      world.unblock.row(layout.grid.set(g, x, y, TileFloor{}), (x + 1 : U32), y, x1)
    case False{}:
      world.unblock.row(g, (x + 1 : U32), y, x1)

def world.unblock.row.k1(cv: Bool, +g: LayGrid, +x: U32, +y: U32, +x1: U32) -> LayGrid:
  match cv:
    case True{}:
      g
    case False{}:
      world.unblock.row.k2(layout.tile_is_block(layout.grid.get(g, x, y)), g, x, y, x1)
