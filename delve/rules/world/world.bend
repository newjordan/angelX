# The Delve's gate courtyard: the gate's arch over its stair in the north west,
# a well, the road in from the realm to the south, and doors to the mine-head
# (north), the stables (west) and the lists (east).
def world.gate_room(+cell: LayCell) -> J.Val:
  +r0 = world.walled(cell, "gate")
  +g = layout.grid.of_room(r0)
  +g1 = layout.fill_rects(g, world.rect(4, 1, 5, 4), TileBlock{})
  +g2 = layout.fill_rects(g1, world.rect(5, 4, 2, 1), TileStairs{})
  +g3 = layout.fill_rects(layout.fill_rects(layout.fill_rects(g2, world.rect(15, 3, 2, 2), TileBlock{}), world.rect(18, 1, 5, 3), TileBlock{}), world.rect(15, 10, 1, 1), TileBlock{})
  +g4 = layout.fill_rects(g3, world.rect(19, 10, 2, 1), TileStairs{})
  world.doors_open(layout.grid.put(r0, g4), [0, 1, 3])
def world.stables_room(+cell: LayCell) -> J.Val:
  +r0 = world.walled(cell, "stables")
  +g = layout.fill_rects(layout.fill_rects(layout.fill_rects(layout.grid.of_room(r0), world.rect(2, 1, 20, 3), TileBlock{}), world.rect(3, 6, 2, 1), TileBlock{}), world.rect(4, 10, 16, 1), TileBlock{})
  world.doors_open(layout.grid.put(r0, g), [1])
def world.lists_room(+cell: LayCell) -> J.Val:
  +r0 = world.walled(cell, "lists")
  +g = layout.fill_rects(layout.fill_rects(layout.fill_rects(layout.fill_rects(layout.grid.of_room(r0), world.rect(3, 7, 18, 1), TileBlock{}), world.rect(3, 1, 18, 2), TileBlock{}), world.rect(1, 10, 2, 2), TileBlock{}), world.rect(21, 1, 2, 2), TileBlock{})
  world.doors_open(layout.grid.put(r0, g), [3])
# The fallen gate-hall of Caer Dwfn at the mine-head, west of the adit.
def world.mine_head_room(+cell: LayCell) -> J.Val:
  +r0 = world.walled(cell, "mine_head")
  +g1 = layout.fill_rects(layout.fill_rects(layout.grid.of_room(r0), world.rect(10, 1, 4, 3), TileBlock{}), world.rect(11, 3, 2, 1), TileStairs{})
  +g2 = layout.fill_rects(layout.fill_rects(layout.fill_rects(g1, world.rect(2, 2, 8, 5), TileBlock{}), world.rect(5, 6, 2, 1), TileStairs{}), world.rect(17, 2, 4, 2), TileBlock{})
  +g3 = layout.fill_rects(g2, world.rect(11, 1, 3, 3), TileFloor{})
  world.doors_open(layout.grid.put(r0, g3), [2])
# The forest's trees (forest.rs TREES).
def world.forest_room(+cell: LayCell) -> J.Val:
  +r0 = world.walled(cell, "forest")
  +g = layout.set_all(layout.grid.of_room(r0), world.TREES(), TileBlock{})
  world.doors_open(layout.grid.put(r0, g), [0])
def world.TREES() -> List<&2, LayCell>:
  [LayCell{2, 2}, LayCell{8, 2}, LayCell{10, 5}, LayCell{2, 8}, LayCell{9, 11}, LayCell{14, 2}, LayCell{22, 3}, LayCell{22, 10}]
