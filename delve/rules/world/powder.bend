# generated by bx.py from powder.bx: edit the .bx, not this file
# crates/delve/src/rules/powder.rs — the Powder Room, a folly and a nod to
# Bomberman: pillars in a grid, crates between them, a bomb key that drops a
# keg that blows in a cross. Most crates broken when the minute is up wins.
#
# `run.powder` is {room, t, crates: [u16, ascending], kegs: [{at: [x, y],
# owner, fuse}], fire: [[[x, y], ticks]], broken: {id: n}, ante: {id: gold},
# corners: {id: [x, y]}, held: [ids], done}.

# The pillars: every second tile in both directions, inside the walls.
def powder.pillar(+x: U32, +y: U32) -> Bool:
  Bool.and(U32.is_eq(U32.and(x, 1), 0), U32.is_eq(U32.and(y, 1), 0))
def powder.corners(+cols: U32, +rows: U32) -> List<&2, LayCell>:
  [LayCell{1, 1}, LayCell{(cols - 2 : U32), (rows - 2 : U32)}, LayCell{(cols - 2 : U32), 1}, LayCell{1, (rows - 2 : U32)}]
# |a - b|.
def powder.near(+x: U32, +y: U32, +c: LayCell, +reach: U32) -> Bool:
  powder.near.k1(c, x, y, reach)

def powder.near.k1(pr: LayCell, +x: U32, +y: U32, +reach: U32) -> Bool:
  match pr:
    case LayCell{+cx, +cy}:
      U32.is_le((layout.absdiff(cx, x) + layout.absdiff(cy, y) : U32), reach)
def powder.any_near(+x: U32, +y: U32, +cs: List<&2, LayCell>, +reach: U32) -> Bool:
  powder.any_near.k1(cs, x, y, cs, reach)

def powder.any_near.k2(cv: Bool, +x: U32, +y: U32, +reach: U32, +c: LayCell, +t: List<&2, LayCell>) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      powder.any_near(x, y, t, reach)

def powder.any_near.k1(sv0: List<&2, LayCell>, +x: U32, +y: U32, +cs: List<&2, LayCell>, +reach: U32) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+c, +t}:
      powder.any_near.k2(powder.near(x, y, c, reach), x, y, reach, c, t)
# The door tiles of the room.
def powder.doors(+g: LayGrid, +row: U32, +col: U32, +cols: U32, +rows: U32) -> List<&2, LayCell>:
  powder.doors.k1(U32.is_ge(row, rows), g, row, col, cols, rows)

def powder.doors.k3(cv: Bool, +g: LayGrid, +row: U32, +col: U32, +cols: U32, +rows: U32) -> List<&2, LayCell>:
  match cv:
    case True{}:
      Con{LayCell{col, row}, powder.doors(g, row, (col + 1 : U32), cols, rows)}
    case False{}:
      powder.doors(g, row, (col + 1 : U32), cols, rows)

def powder.doors.k2(cv: Bool, +g: LayGrid, +row: U32, +col: U32, +cols: U32, +rows: U32) -> List<&2, LayCell>:
  match cv:
    case True{}:
      powder.doors(g, (row + 1 : U32), 0, cols, rows)
    case False{}:
      powder.doors.k3(layout.tile_is_door(layout.grid.get(g, col, row)), g, row, col, cols, rows)

def powder.doors.k1(cv: Bool, +g: LayGrid, +row: U32, +col: U32, +cols: U32, +rows: U32) -> List<&2, LayCell>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      powder.doors.k2(U32.is_ge(col, cols), g, row, col, cols, rows)
# Lay the store: pillars, crates (seeded by the tile), a clear mouth at each
# door and corner. Returns the grid and the crate indexes (ascending).
def powder.lay(+g: LayGrid, +seed: W.W, +cols: U32, +rows: U32, +corners: List<&2, LayCell>, +doors: List<&2, LayCell>, +y: U32, +x: U32, +crates: List<&2, J.Val>) -> LayGrid & List<&2, J.Val>:
  powder.lay.k1(U32.is_ge(y, (rows - 1 : U32)), g, seed, cols, rows, corners, doors, y, x, crates)

def powder.lay.k4(cv: Bool, +g: LayGrid, +seed: W.W, +cols: U32, +rows: U32, +corners: List<&2, LayCell>, +doors: List<&2, LayCell>, +y: U32, +x: U32, +crates: List<&2, J.Val>, +idx: U32, +crate: Bool) -> LayGrid & List<&2, J.Val>:
  match cv:
    case True{}:
      powder.lay(layout.grid.set(g, x, y, TileBlock{}), seed, cols, rows, corners, doors, y, (x + 1 : U32), List.append(&2, J.Val, crates, [J.JU{idx}]))
    case False{}:
      powder.lay(layout.grid.set(g, x, y, TileFloor{}), seed, cols, rows, corners, doors, y, (x + 1 : U32), crates)

def powder.lay.k3(cv: Bool, +g: LayGrid, +seed: W.W, +cols: U32, +rows: U32, +corners: List<&2, LayCell>, +doors: List<&2, LayCell>, +y: U32, +x: U32, +crates: List<&2, J.Val>) -> LayGrid & List<&2, J.Val>:
  match cv:
    case True{}:
      powder.lay(layout.grid.set(g, x, y, TileBlock{}), seed, cols, rows, corners, doors, y, (x + 1 : U32), crates)
    case False{}:
      +idx = (y * cols + x : U32)
      +clear = Bool.or(powder.any_near(x, y, corners, 1), powder.any_near(x, y, doors, 2))
      +crate = Bool.and(Bool.not(clear), U32.is_lt(W.rem_u32(layout.mix(W.xor(seed, W.shl(W.of_u32(idx), 3))), 10), 7))
      powder.lay.k4(crate, g, seed, cols, rows, corners, doors, y, x, crates, idx, crate)

def powder.lay.k2(cv: Bool, +g: LayGrid, +seed: W.W, +cols: U32, +rows: U32, +corners: List<&2, LayCell>, +doors: List<&2, LayCell>, +y: U32, +x: U32, +crates: List<&2, J.Val>) -> LayGrid & List<&2, J.Val>:
  match cv:
    case True{}:
      powder.lay(g, seed, cols, rows, corners, doors, (y + 1 : U32), 1, crates)
    case False{}:
      powder.lay.k3(powder.pillar(x, y), g, seed, cols, rows, corners, doors, y, x, crates)

def powder.lay.k1(cv: Bool, +g: LayGrid, +seed: W.W, +cols: U32, +rows: U32, +corners: List<&2, LayCell>, +doors: List<&2, LayCell>, +y: U32, +x: U32, +crates: List<&2, J.Val>) -> LayGrid & List<&2, J.Val>:
  match cv:
    case True{}:
      (g, crates)
    case False{}:
      powder.lay.k2(U32.is_ge(x, (cols - 1 : U32)), g, seed, cols, rows, corners, doors, y, x, crates)
# Into the powder store: pillars, crates, a corner each, and the antes.
def powder.Run.start_powder(+run: J.Val, +index: U32) -> J.Val:
  +dungeon = J.get(run, "dungeon")
  +room = layout.Floor.room(dungeon, index)
  +cols = layout.Room.cols(room)
  +rows = layout.Room.rows(room)
  +g0 = layout.grid.of_room(room)
  +corners = powder.corners(cols, rows)
  powder.Run.start_powder.k1(powder.lay(g0, W.of_j(J.get(run, "seed")), cols, rows, corners, powder.doors(g0, 0, 0, cols, rows), 1, 1, Nil{}), run, index, dungeon, room, corners)

def powder.Run.start_powder.k2(pr: J.Val & J.Val, +index: U32, +crates: List<&2, J.Val>, +taken: J.Val, +scores: J.Val) -> J.Val:
  (+r2, +corner_of) = pr
  +p0 = J.set(J.set(J.set(J.obj(), "room", J.JU{index}), "t", J.JU{0}), "crates", J.JA{crates})
  +p1 = J.set(J.set(J.set(p0, "kegs", J.JA{Nil{}}), "fire", J.JA{Nil{}}), "broken", gantry.zeros(J.fields(scores), J.obj()))
  +p = J.set(J.set(J.set(J.set(p1, "ante", J.get(taken, "ante")), "corners", corner_of), "held", J.JA{Nil{}}), "done", J.JBool{False{}})
  floors.cue(exits.push_sound(J.set(r2, "powder", p), "door_seal"), "folly")

def powder.Run.start_powder.k1(pr: LayGrid & List<&2, J.Val>, +run: J.Val, +index: U32, +dungeon: J.Val, +room: J.Val, +corners: List<&2, LayCell>) -> J.Val:
  (+g1, +crates) = pr
  +d1 = J.set(layout.floor_with_rooms(dungeon, J.items(J.set_nth(layout.Floor.rooms(dungeon), index, layout.grid.put(room, g1)))), "world_revision", J.JU{(J.u32(J.get(dungeon, "world_revision")) + 1 : U32)})
  +taken = folly.take_antes(J.get(run, "players"))
  +scores = J.get(taken, "scores")
  +r1 = J.set(J.set(run, "dungeon", d1), "players", J.get(taken, "players"))
  powder.Run.start_powder.k2(powder.assign(r1, J.int_fields(J.get(r1, "players")), scores, corners, 0, J.obj()), index, crates, taken, scores)
# Each scoring knight goes to the next corner (round and round).
def powder.assign(+run: J.Val, +ps: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +scores: J.Val, +corners: List<&2, LayCell>, +k: U32, +acc: J.Val) -> J.Val & J.Val:
  powder.assign.k1(ps, run, ps, scores, corners, k, acc)

def powder.assign.k3(pr: LayCell, +run: J.Val, +scores: J.Val, +corners: List<&2, LayCell>, +k: U32, +acc: J.Val, +p: Sigma<&2, &2, String, _ => J.Val>, +t: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +id: U32) -> J.Val & J.Val:
  match pr:
    case LayCell{+cx, +cy}:
      +h = J.set(J.set(world.key_val(p), "x", J.JF{((RS.i_as_f32(cx) + 0.5 : F32) * 2.0 : F32)}), "y", J.JF{((RS.i_as_f32(cy) + 0.5 : F32) * 2.0 : F32)})
      powder.assign(exits.set_hero(run, id, h), t, scores, corners, (k + 1 : U32), J.set(acc, U32.show(id), J.JA{[J.of_i32(cx), J.of_i32(cy)]}))

def powder.assign.k2(cv: Bool, +run: J.Val, +scores: J.Val, +corners: List<&2, LayCell>, +k: U32, +acc: J.Val, +p: Sigma<&2, &2, String, _ => J.Val>, +t: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +id: U32) -> J.Val & J.Val:
  match cv:
    case True{}:
      powder.assign.k3(layout.cells.nth(corners, U32.mod(k, 4)), run, scores, corners, k, acc, p, t, id)
    case False{}:
      powder.assign(run, t, scores, corners, k, acc)

def powder.assign.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +ps: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +scores: J.Val, +corners: List<&2, LayCell>, +k: U32, +acc: J.Val) -> J.Val & J.Val:
  match sv0:
    case Nil{}:
      (run, acc)
    case Con{+p, +t}:
      +id = world.key_id(p)
      powder.assign.k2(J.has(scores, U32.show(id)), run, scores, corners, k, acc, p, t, id)
def powder.tile_of(+h: J.Val) -> LayCell:
  LayCell{RS.f_as_i32((J.f32(J.get(h, "x")) / 2.0 : F32)), RS.f_as_i32((J.f32(J.get(h, "y")) / 2.0 : F32))}
def powder.at_of(+k: J.Val) -> LayCell:
  LayCell{J.u32(J.nth(J.get(k, "at"), 0)), J.u32(J.nth(J.get(k, "at"), 1))}
def powder.keg_at(+ks: List<&2, J.Val>, +c: LayCell) -> Bool:
  powder.keg_at.k1(ks, ks, c)

def powder.keg_at.k3(cv: Bool, +c: LayCell, +k: J.Val, +t: List<&2, J.Val>, +x: U32, +y: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      powder.keg_at(t, c)

def powder.keg_at.k2(pr: LayCell, +c: LayCell, +k: J.Val, +t: List<&2, J.Val>) -> Bool:
  match pr:
    case LayCell{+x, +y}:
      powder.keg_at.k3(layout.cell.is(powder.at_of(k), x, y), c, k, t, x, y)

def powder.keg_at.k1(sv0: List<&2, J.Val>, +ks: List<&2, J.Val>, +c: LayCell) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+k, +t}:
      powder.keg_at.k2(c, c, k, t)
def powder.owned(+ks: List<&2, J.Val>, +id: U32) -> U32:
  powder.owned.k1(ks, ks, id)

def powder.owned.k1(sv0: List<&2, J.Val>, +ks: List<&2, J.Val>, +id: U32) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+k, +t}:
      (Bool.to_u32(U32.is_eq(J.u32(J.get(k, "owner")), id)) + powder.owned(t, id) : U32)
def powder.id_in(+xs: List<&2, J.Val>, +id: U32) -> Bool:
  gantry.u32_in(xs, id)
# The bomb key lights kegs here; the ordinary throw waits.
def powder.cooldowns(+run: J.Val, +ids: List<&2, U32>) -> J.Val:
  powder.cooldowns.k1(ids, run, ids)

def powder.cooldowns.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      +h = exits.hero(run, id)
      powder.cooldowns(exits.set_hero(run, id, J.set(h, "bomb_cooldown", J.JU{U32.max(J.u32(J.get(h, "bomb_cooldown")), 2)})), t)
# The kegs dropped this tick: a knight with the bomb key newly down and a keg to spare.
def powder.drop(+s: WS, +ids: List<&2, U32>, +inputs: J.Val) -> WS:
  powder.drop.k1(ids, s, ids, inputs)

def powder.drop.k1(sv0: List<&2, U32>, +s: WS, +ids: List<&2, U32>, +inputs: J.Val) -> WS:
  match sv0:
    case Nil{}:
      s
    case Con{+id, +t}:
      powder.drop(powder.drop.one(s, id, inputs), t, inputs)
def powder.drop.one(+s: WS, +id: U32, +inputs: J.Val) -> WS:
  powder.drop.one.k1(s, s, id, inputs)

def powder.drop.one.k5(pr: LayCell, +id: U32, +run: J.Val, +mark: U32, +g1: J.Val) -> WS:
  match pr:
    case LayCell{+ax, +ay}:
      +keg = J.set(J.set(J.set(J.obj(), "at", J.JA{[J.of_i32(ax), J.of_i32(ay)]}), "owner", J.JU{id}), "fuse", J.JU{60})
      WS{exits.push_sound(run, "bomb_toss"), J.set(g1, "kegs", J.push(J.get(g1, "kegs"), keg)), mark}

def powder.drop.one.k4(cv: Bool, +id: U32, +run: J.Val, +mark: U32, +g1: J.Val, +at: LayCell, +ks: List<&2, J.Val>) -> WS:
  match cv:
    case True{}:
      powder.drop.one.k5(at, id, run, mark, g1)
    case False{}:
      WS{run, g1, mark}

def powder.drop.one.k3(cv: Bool, +id: U32, +run: J.Val, +g: J.Val, +mark: U32, +h: J.Val, +g1: J.Val) -> WS:
  match cv:
    case True{}:
      WS{run, g1, mark}
    case False{}:
      +at = powder.tile_of(h)
      +ks = J.items(J.get(g1, "kegs"))
      powder.drop.one.k4(Bool.and(U32.is_lt(powder.owned(ks, id), 2), Bool.not(powder.keg_at(ks, at))), id, run, mark, g1, at, ks)

def powder.drop.one.k2(cv: Bool, +s: WS, +id: U32, +run: J.Val, +g: J.Val, +mark: U32, +h: J.Val, +down: Bool) -> WS:
  match cv:
    case True{}:
      s
    case False{}:
      +g1 = J.set(g, "held_new", J.push(J.get(g, "held_new"), J.JU{id}))
      powder.drop.one.k3(Bool.or(powder.id_in(J.items(J.get(g, "held")), id), Bool.not(J.has(J.get(g, "broken"), U32.show(id)))), id, run, g, mark, h, g1)

def powder.drop.one.k1(sv0: WS, +s: WS, +id: U32, +inputs: J.Val) -> WS:
  match sv0:
    case WS{+run, +g, +mark}:
      +h = exits.hero(run, id)
      +i = J.get(inputs, U32.show(id))
      +alive = Bool.and(U32.is_gt(J.u32(J.get(h, "hp")), 0), Bool.not(J.bool(J.get(h, "stone"))))
      +down = Bool.and(alive, Bool.and(Bool.not(J.is_null(i)), Bool.and(rules.Input.valid(i), J.bool(J.get(i, "bomb")))))
      powder.drop.one.k2(Bool.not(down), s, id, run, g, mark, h, down)
def powder.fuses(+ks: List<&2, J.Val>) -> List<&2, J.Val>:
  powder.fuses.k1(ks, ks)

def powder.fuses.k1(sv0: List<&2, J.Val>, +ks: List<&2, J.Val>) -> List<&2, J.Val>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+k, +t}:
      Con{J.set(k, "fuse", J.JU{RS.u_sat_sub(J.u32(J.get(k, "fuse")), 1)}), powder.fuses(t)}
# The first keg whose fuse is out (index), or usize::MAX.
def powder.first_out(+ks: List<&2, J.Val>, +i: U32) -> U32:
  powder.first_out.k1(ks, ks, i)

def powder.first_out.k2(cv: Bool, +i: U32, +k: J.Val, +t: List<&2, J.Val>) -> U32:
  match cv:
    case True{}:
      i
    case False{}:
      powder.first_out(t, (i + 1 : U32))

def powder.first_out.k1(sv0: List<&2, J.Val>, +ks: List<&2, J.Val>, +i: U32) -> U32:
  match sv0:
    case Nil{}:
      4294967295
    case Con{+k, +t}:
      powder.first_out.k2(U32.is_eq(J.u32(J.get(k, "fuse")), 0), i, k, t)
def powder.remove_nth(+xs: List<&2, J.Val>, +i: U32) -> List<&2, J.Val>:
  powder.remove_nth.k1(xs, xs, i)

def powder.remove_nth.k2(cv: Bool, +i: U32, +h: J.Val, +t: List<&2, J.Val>) -> List<&2, J.Val>:
  match cv:
    case True{}:
      t
    case False{}:
      Con{h, powder.remove_nth(t, (i - 1 : U32))}

def powder.remove_nth.k1(sv0: List<&2, J.Val>, +xs: List<&2, J.Val>, +i: U32) -> List<&2, J.Val>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      powder.remove_nth.k2(U32.is_eq(i, 0), i, h, t)
# Whether the sorted crate list holds index `v`, and the list without it.
def powder.crate_has(+xs: List<&2, J.Val>, +v: U32) -> Bool:
  powder.crate_has.k1(xs, xs, v)

def powder.crate_has.k2(cv: Bool, +v: U32, +h: J.Val, +t: List<&2, J.Val>) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      powder.crate_has(t, v)

def powder.crate_has.k1(sv0: List<&2, J.Val>, +xs: List<&2, J.Val>, +v: U32) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+h, +t}:
      powder.crate_has.k2(U32.is_eq(J.u32(h), v), v, h, t)
def powder.crate_del(+xs: List<&2, J.Val>, +v: U32) -> List<&2, J.Val>:
  powder.crate_del.k1(xs, xs, v)

def powder.crate_del.k2(cv: Bool, +v: U32, +h: J.Val, +t: List<&2, J.Val>) -> List<&2, J.Val>:
  match cv:
    case True{}:
      t
    case False{}:
      Con{h, powder.crate_del(t, v)}

def powder.crate_del.k1(sv0: List<&2, J.Val>, +xs: List<&2, J.Val>, +v: U32) -> List<&2, J.Val>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      powder.crate_del.k2(U32.is_eq(J.u32(h), v), v, h, t)
# The fire set by the kegs gone off: a cross each, stopped by pillars and the
# first crate in each direction. State: the run (tiles), the powder, the blasts.
def powder.blow(+s: PowderS) -> PowderS:
  powder.blow.k1(s, s)

def powder.blow.k3(sv0: PowderS, +s1: PowderS) -> PowderS:
  match sv0:
    case PowderS{+run2, +p2, +blasts2}:
      powder.blow(PowderS{floors.fx_shake(exits.push_sound(run2, "bomb"), 3), p2, blasts2})

def powder.blow.k2(cv: Bool, +s: PowderS, +run: J.Val, +p: J.Val, +blasts: List<&2, LayCell>, +i: U32) -> PowderS:
  match cv:
    case True{}:
      s
    case False{}:
      +k = J.nth(J.get(p, "kegs"), i)
      +p1 = J.set(p, "kegs", J.JA{powder.remove_nth(J.items(J.get(p, "kegs")), i)})
      +at = powder.at_of(k)
      +s1 = powder.arm(PowderS{run, p1, List.append(&2, LayCell, blasts, [at])}, k, at, 0)
      powder.blow.k3(s1, s1)

def powder.blow.k1(sv0: PowderS, +s: PowderS) -> PowderS:
  match sv0:
    case PowderS{+run, +p, +blasts}:
      +i = powder.first_out(J.items(J.get(p, "kegs")), 0)
      powder.blow.k2(U32.is_eq(i, 4294967295), s, run, p, blasts, i)
def powder.DX(+d: U32) -> U32:
  match d:
    case 0:
      1
    case 1:
      4294967295
    case _:
      0
def powder.DY(+d: U32) -> U32:
  match d:
    case 2:
      1
    case 3:
      4294967295
    case _:
      0
def powder.arm(+s: PowderS, +k: J.Val, +at: LayCell, +d: U32) -> PowderS:
  powder.arm.k1(U32.is_ge(d, 4), s, k, at, d)

def powder.arm.k1(cv: Bool, +s: PowderS, +k: J.Val, +at: LayCell, +d: U32) -> PowderS:
  match cv:
    case True{}:
      s
    case False{}:
      powder.arm(powder.reach(s, k, at, d, 1), k, at, (d + 1 : U32))
def powder.reach(+s: PowderS, +k: J.Val, +at: LayCell, +d: U32, +r: U32) -> PowderS:
  powder.reach.k1(s, s, k, at, d, r)

def powder.reach.k5(cv: Bool, +s: PowderS, +k: J.Val, +at: LayCell, +d: U32, +r: U32, +run: J.Val, +p: J.Val, +blasts: List<&2, LayCell>, +x: U32, +y: U32) -> PowderS:
  match cv:
    case True{}:
      s
    case False{}:
      +p1 = powder.fuse_out(p, LayCell{x, y})
      powder.reach(PowderS{run, p1, List.append(&2, LayCell, blasts, [LayCell{x, y}])}, k, at, d, (r + 1 : U32))

def powder.reach.k4(cv: Bool, +s: PowderS, +k: J.Val, +at: LayCell, +d: U32, +r: U32, +run: J.Val, +p: J.Val, +blasts: List<&2, LayCell>, +x: U32, +y: U32, +idx: U32, +crates: List<&2, J.Val>) -> PowderS:
  match cv:
    case True{}:
      +owner = U32.show(J.u32(J.get(k, "owner")))
      +scored = Bool.pick(J.Val, J.has(J.get(p, "broken"), owner), J.set(J.get(p, "broken"), owner, J.JU{(J.u32(J.get(J.get(p, "broken"), owner)) + 1 : U32)}), J.get(p, "broken"))
      +p1 = J.set(J.set(p, "crates", J.JA{powder.crate_del(crates, idx)}), "broken", scored)
      +at_i = J.u32(J.get(run, "at"))
      +dungeon = J.get(run, "dungeon")
      +room = layout.Room.set_t(layout.Floor.room(dungeon, at_i), x, y, TileFloor{})
      +run1 = J.set(run, "dungeon", layout.floor_with_rooms(dungeon, J.items(J.set_nth(layout.Floor.rooms(dungeon), at_i, room))))
      PowderS{run1, p1, List.append(&2, LayCell, blasts, [LayCell{x, y}])}
    case False{}:
      powder.reach.k5(Bool.not(layout.tile_is_floor(layout.Room.tile_t(rules.Run.room(run), x, y))), s, k, at, d, r, run, p, blasts, x, y)

def powder.reach.k3(pr: LayCell, +s: PowderS, +k: J.Val, +at: LayCell, +d: U32, +r: U32, +run: J.Val, +p: J.Val, +blasts: List<&2, LayCell>) -> PowderS:
  match pr:
    case LayCell{+ax, +ay}:
      +x = (ax + RS.i_mul(powder.DX(d), r) : U32)
      +y = (ay + RS.i_mul(powder.DY(d), r) : U32)
      +cols = layout.Room.cols(rules.Run.room(run))
      +idx = (y * cols + x : U32)
      +crates = J.items(J.get(p, "crates"))
      powder.reach.k4(powder.crate_has(crates, idx), s, k, at, d, r, run, p, blasts, x, y, idx, crates)

def powder.reach.k2(cv: Bool, +s: PowderS, +k: J.Val, +at: LayCell, +d: U32, +r: U32, +run: J.Val, +p: J.Val, +blasts: List<&2, LayCell>) -> PowderS:
  match cv:
    case True{}:
      s
    case False{}:
      powder.reach.k3(at, s, k, at, d, r, run, p, blasts)

def powder.reach.k1(sv0: PowderS, +s: PowderS, +k: J.Val, +at: LayCell, +d: U32, +r: U32) -> PowderS:
  match sv0:
    case PowderS{+run, +p, +blasts}:
      powder.reach.k2(U32.is_gt(r, 2), s, k, at, d, r, run, p, blasts)
# The next keg in the cross goes at once.
def powder.fuse_out(+p: J.Val, +c: LayCell) -> J.Val:
  J.set(p, "kegs", J.JA{powder.fuse_out.go(J.items(J.get(p, "kegs")), c)})
def powder.fuse_out.go(+ks: List<&2, J.Val>, +c: LayCell) -> List<&2, J.Val>:
  powder.fuse_out.go.k1(ks, ks, c)

def powder.fuse_out.go.k3(cv: Bool, +k: J.Val, +t: List<&2, J.Val>, +x: U32, +y: U32) -> List<&2, J.Val>:
  match cv:
    case True{}:
      Con{J.set(k, "fuse", J.JU{0}), t}
    case False{}:
      Con{k, t}

def powder.fuse_out.go.k2(pr: LayCell, +k: J.Val, +t: List<&2, J.Val>) -> List<&2, J.Val>:
  match pr:
    case LayCell{+x, +y}:
      powder.fuse_out.go.k3(layout.cell.is(powder.at_of(k), x, y), k, t, x, y)

def powder.fuse_out.go.k1(sv0: List<&2, J.Val>, +ks: List<&2, J.Val>, +c: LayCell) -> List<&2, J.Val>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+k, +t}:
      powder.fuse_out.go.k2(c, k, t)
def floors.fx_shake(+run: J.Val, +n: U32) -> J.Val:
  J.set(run, "fx", J.push(J.get(run, "fx"), J.set(J.obj(), "Shake", J.JU{n})))
def powder.fire_add(+fire: List<&2, J.Val>, +blasts: List<&2, LayCell>) -> List<&2, J.Val>:
  powder.fire_add.k1(blasts, fire, blasts)

def powder.fire_add.k2(pr: LayCell, +fire: List<&2, J.Val>, +t: List<&2, LayCell>) -> List<&2, J.Val>:
  match pr:
    case LayCell{+x, +y}:
      powder.fire_add(List.append(&2, J.Val, fire, [J.JA{[J.JA{[J.of_i32(x), J.of_i32(y)]}, J.JU{10}]}]), t)

def powder.fire_add.k1(sv0: List<&2, LayCell>, +fire: List<&2, J.Val>, +blasts: List<&2, LayCell>) -> List<&2, J.Val>:
  match sv0:
    case Nil{}:
      fire
    case Con{+c, +t}:
      powder.fire_add.k2(c, fire, t)
# Fires burn down a tick; the spent ones go.
def powder.fire_age(+fire: List<&2, J.Val>) -> List<&2, J.Val>:
  powder.fire_age.k1(fire, fire)

def powder.fire_age.k2(cv: Bool, +f: J.Val, +t: List<&2, J.Val>, +n: U32) -> List<&2, J.Val>:
  match cv:
    case True{}:
      powder.fire_age(t)
    case False{}:
      Con{J.JA{[J.nth(f, 0), J.JU{n}]}, powder.fire_age(t)}

def powder.fire_age.k1(sv0: List<&2, J.Val>, +fire: List<&2, J.Val>) -> List<&2, J.Val>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+f, +t}:
      +n = RS.u_sat_sub(J.u32(J.nth(f, 1)), 1)
      powder.fire_age.k2(U32.is_eq(n, 0), f, t, n)
def powder.burning(+fire: List<&2, J.Val>, +c: LayCell) -> Bool:
  powder.burning.k1(fire, fire, c)

def powder.burning.k3(cv: Bool, +c: LayCell, +f: J.Val, +t: List<&2, J.Val>, +x: U32, +y: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      powder.burning(t, c)

def powder.burning.k2(pr: LayCell, +c: LayCell, +f: J.Val, +t: List<&2, J.Val>) -> Bool:
  match pr:
    case LayCell{+x, +y}:
      powder.burning.k3(layout.cell.is(LayCell{J.u32(J.nth(J.nth(f, 0), 0)), J.u32(J.nth(J.nth(f, 0), 1))}, x, y), c, f, t, x, y)

def powder.burning.k1(sv0: List<&2, J.Val>, +fire: List<&2, J.Val>, +c: LayCell) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+f, +t}:
      powder.burning.k2(c, c, f, t)
# Sooted: back to the corner, three crates the poorer.
def powder.soot(+run: J.Val, +p: J.Val, +ids: List<&2, U32>) -> J.Val & J.Val:
  powder.soot.k1(ids, run, p, ids)

def powder.soot.k2(cv: Bool, +run: J.Val, +p: J.Val, +id: U32, +t: List<&2, U32>, +h: J.Val, +alive: Bool) -> J.Val & J.Val:
  match cv:
    case True{}:
      powder.soot(run, p, t)
    case False{}:
      +c = J.get(J.get(p, "corners"), U32.show(id))
      +h1 = Bool.pick(J.Val, J.is_null(c), h, J.set(J.set(h, "x", J.JF{((RS.i_as_f32(J.u32(J.nth(c, 0))) + 0.5 : F32) * 2.0 : F32)}), "y", J.JF{((RS.i_as_f32(J.u32(J.nth(c, 1))) + 0.5 : F32) * 2.0 : F32)}))
      +h2 = J.set(h1, "invulnerable", J.JU{45})
      +broken = J.get(p, "broken")
      +k = U32.show(id)
      +p1 = J.set(p, "broken", J.set(broken, k, J.JU{RS.u_sat_sub(J.u32(J.get(broken, k)), 3)}))
      powder.soot(exits.push_sound(exits.set_hero(run, id, h2), "hero_hurt"), p1, t)

def powder.soot.k1(sv0: List<&2, U32>, +run: J.Val, +p: J.Val, +ids: List<&2, U32>) -> J.Val & J.Val:
  match sv0:
    case Nil{}:
      (run, p)
    case Con{+id, +t}:
      +h = exits.hero(run, id)
      +alive = Bool.and(U32.is_gt(J.u32(J.get(h, "hp")), 0), Bool.not(J.bool(J.get(h, "stone"))))
      powder.soot.k2(Bool.or(Bool.not(alive), Bool.or(U32.is_gt(J.u32(J.get(h, "invulnerable")), 0), Bool.not(powder.burning(J.items(J.get(p, "fire")), powder.tile_of(h))))), run, p, id, t, h, alive)
# The store's tick: kegs dropped and blown, crates broken, knights sooted, and the end.
def powder.Run.tick_powder(+run: J.Val, +inputs: J.Val) -> J.Val:
  +p0 = J.get(run, "powder")
  powder.Run.tick_powder.k1(J.is_null(p0), run, inputs, p0)

def powder.Run.tick_powder.k3(cv: Bool, +inputs: J.Val, +p1: J.Val, +run1: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.set(run1, "powder", p1)
    case False{}:
      powder.play(run1, p1, inputs)

def powder.Run.tick_powder.k2(cv: Bool, +run: J.Val, +inputs: J.Val, +p0: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +p1 = J.set(p0, "t", J.JU{(J.u32(J.get(p0, "t")) + 1 : U32)})
      +run1 = powder.cooldowns(run, exits.ids_all(run))
      powder.Run.tick_powder.k3(U32.is_lt(J.u32(J.get(p1, "t")), 60), inputs, p1, run1)

def powder.Run.tick_powder.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +p0: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      powder.Run.tick_powder.k2(Bool.or(U32.is_ne(J.u32(J.get(p0, "room")), J.u32(J.get(run, "at"))), J.bool(J.get(p0, "done"))), run, inputs, p0)
def powder.play(+run: J.Val, +p: J.Val, +inputs: J.Val) -> J.Val:
  +s = powder.drop(WS{run, J.set(p, "held_new", J.JA{Nil{}}), 4294967295}, exits.ids_all(run), inputs)
  powder.play.fuses(s)
def powder.play.fuses(+s: WS) -> J.Val:
  powder.play.fuses.k1(s, s)

def powder.play.fuses.k1(sv0: WS, +s: WS) -> J.Val:
  match sv0:
    case WS{+run, +g, +mark}:
      +p1 = J.del(J.set(g, "held", J.get(g, "held_new")), "held_new")
      +p2 = J.set(p1, "kegs", J.JA{powder.fuses(J.items(J.get(p1, "kegs")))})
      powder.play.blow(powder.blow(PowderS{run, p2, Nil{}}))
def powder.play.blow(+s: PowderS) -> J.Val:
  powder.play.blow.k1(s, s)

def powder.play.blow.k1(sv0: PowderS, +s: PowderS) -> J.Val:
  match sv0:
    case PowderS{+run, +p, +blasts}:
      powder.after(run, p, blasts)
def powder.after(+run: J.Val, +p: J.Val, +blasts: List<&2, LayCell>) -> J.Val:
  +burst = Bool.not(List.is_empty(&2, LayCell, blasts))
  +run1 = Bool.pick(J.Val, burst, powder.bump(run), run)
  +p1 = J.set(p, "fire", J.JA{powder.fire_age(powder.fire_add(J.items(J.get(p, "fire")), blasts))})
  powder.after.k1(powder.soot(run1, p1, exits.ids_all(run1)))

def powder.after.k2(cv: Bool, +run2: J.Val, +p2: J.Val) -> J.Val:
  match cv:
    case True{}:
      powder.finish(run2, J.set(J.set(J.set(p2, "done", J.JBool{True{}}), "kegs", J.JA{Nil{}}), "fire", J.JA{Nil{}}))
    case False{}:
      J.set(run2, "powder", p2)

def powder.after.k1(pr: J.Val & J.Val) -> J.Val:
  (+run2, +p2) = pr
  powder.after.k2(Bool.or(U32.is_eq(J.len(J.get(p2, "crates")), 0), U32.is_ge(J.u32(J.get(p2, "t")), 1860)), run2, p2)
def powder.bump(+run: J.Val) -> J.Val:
  +d = J.get(run, "dungeon")
  J.set(run, "dungeon", J.set(d, "world_revision", J.JU{(J.u32(J.get(d, "world_revision")) + 1 : U32)}))
# The pot and the crown: a gold per four crates broken.
def powder.finish(+run: J.Val, +p: J.Val) -> J.Val:
  +best = gantry.best_by_broken(J.int_fields(J.get(p, "broken")), 4294967295, 0)
  +pot = gantry.pot(J.fields(J.get(p, "ante")))
  +rivals = U32.is_gt(world.obj_len(J.get(p, "broken")), 1)
  +r1 = powder.pay(run, J.int_fields(J.get(p, "broken")), best, pot, rivals)
  +room = J.u32(J.get(p, "room"))
  +dungeon = J.get(r1, "dungeon")
  +r2 = Bool.pick(J.Val, U32.is_lt(room, layout.Floor.len(dungeon)), J.set(r1, "dungeon", layout.floor_with_rooms(dungeon, J.items(J.set_nth(layout.Floor.rooms(dungeon), room, J.set(layout.Floor.room(dungeon, room), "cleared", J.JBool{True{}}))))), r1)
  +name = Bool.pick(String, Bool.and(U32.is_ne(best, 4294967295), exits.has_hero(r2, best)), String.to_upper(J.str(J.get(exits.hero(r2, best), "name"))), "NOBODY")
  +r3 = J.set(J.set(r2, "powder", p), "found", J.JA{[J.get(r2, "tick"), J.JU{0}, J.JS{String.append(name, " BROKE THE MOST CRATES!")}]})
  floors.cue(exits.push_sound(r3, "play_card"), "pastime_won")
# The most crates, the least id on a tie.
def gantry.best_by_broken(+hs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +best: U32, +bn: U32) -> U32:
  gantry.best_by_broken.k1(hs, hs, best, bn)

def gantry.best_by_broken.k2(cv: Bool, +best: U32, +bn: U32, +t: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +id: U32, +n: U32) -> U32:
  match cv:
    case True{}:
      gantry.best_by_broken(t, id, n)
    case False{}:
      gantry.best_by_broken(t, best, bn)

def gantry.best_by_broken.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +hs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +best: U32, +bn: U32) -> U32:
  match sv0:
    case Nil{}:
      best
    case Con{+p, +t}:
      +id = world.key_id(p)
      +n = J.u32(world.key_val(p))
      gantry.best_by_broken.k2(Bool.or(U32.is_eq(best, 4294967295), U32.is_gt(n, bn)), best, bn, t, id, n)
def powder.pay(+run: J.Val, +xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +best: U32, +pot: U32, +rivals: Bool) -> J.Val:
  powder.pay.k1(xs, run, xs, best, pot, rivals)

def powder.pay.k2(cv: Bool, +run: J.Val, +best: U32, +pot: U32, +rivals: Bool, +t: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +id: U32, +n: U32) -> J.Val:
  match cv:
    case True{}:
      +h = exits.hero(run, id)
      +h1 = J.set(J.set(h, "carried", realm.Spoils.add(J.get(h, "carried"), "gold", U32.shrn(n, 2n))), "bomb_cooldown", J.JU{0})
      +h2 = Bool.pick(J.Val, rivals, J.set(h1, "laurel", J.JBool{U32.is_eq(id, best)}), h1)
      +h3 = Bool.pick(J.Val, U32.is_eq(id, best), J.set(h2, "carried", realm.Spoils.add(J.get(h2, "carried"), "gold", pot)), h2)
      powder.pay(exits.set_hero(run, id, h3), t, best, pot, rivals)
    case False{}:
      powder.pay(run, t, best, pot, rivals)

def powder.pay.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +best: U32, +pot: U32, +rivals: Bool) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+p, +t}:
      +id = world.key_id(p)
      +n = J.u32(world.key_val(p))
      powder.pay.k2(exits.has_hero(run, id), run, best, pot, rivals, t, id, n)
