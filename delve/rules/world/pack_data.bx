  [("bat", 4), ("imp", 3), ("skeleton", 2), ("sapper", 1), ("biter", 2), ("mole", 1)]

def layout.roster.cavern_late() -> List<&2, Sigma<&2, &2, String, _ => U32>>:
  [("bat", 3), ("imp", 2), ("skeleton", 2), ("sapper", 2), ("hob", 2), ("warboar", 1), ("mole", 2), ("geode", 1), ("whirlgrave", 1), ("leech", 1), ("biter", 1), ("spitter", 1)]

def layout.roster.hellforge() -> List<&2, Sigma<&2, &2, String, _ => U32>>:
  [("imp", 3), ("demon", 2), ("wraith", 2), ("warboar", 2), ("shaman", 1), ("hob", 1), ("hound", 2), ("pavise", 1), ("spitter", 1), ("marksman", 1)]

def layout.roster.archive() -> List<&2, Sigma<&2, &2, String, _ => U32>>:
  [("wraith", 3), ("skeleton", 2), ("slime", 2), ("bat", 2), ("sapper", 1), ("necromancer", 1), ("silkmother", 1), ("lich", 1), ("mirrorling", 2), ("ringer", 1), ("marksman", 1), ("leech", 1), ("biter", 1)]

def layout.roster.fungal() -> List<&2, Sigma<&2, &2, String, _ => U32>>:
  [("slime", 3), ("bat", 3), ("hob", 1), ("warboar", 2), ("imp", 1), ("shaman", 1), ("silkmother", 1), ("flesher", 1), ("broodmarrow", 1), ("whirlgrave", 1), ("hexer", 1), ("leech", 2), ("spitter", 1), ("mole", 1), ("geode", 1), ("biter", 1)]

def layout.roster.swamp_early() -> List<&2, Sigma<&2, &2, String, _ => U32>>:
  [("leech", 4), ("bog_hand", 3), ("wraith", 2), ("wisp", 1), ("slime", 1)]

def layout.roster.swamp_mid() -> List<&2, Sigma<&2, &2, String, _ => U32>>:
  [("leech", 3), ("bog_hand", 3), ("wraith", 2), ("wisp", 2), ("slime", 1), ("spitter", 1), ("drowned", 1), ("hexer", 1)]

def layout.roster.swamp_late() -> List<&2, Sigma<&2, &2, String, _ => U32>>:
  [("leech", 2), ("bog_hand", 3), ("wraith", 2), ("wisp", 2), ("drowned", 2), ("slime", 1), ("spitter", 1), ("hexer", 1), ("whirlgrave", 1)]

def layout.roster.unknown() -> List<&2, Sigma<&2, &2, String, _ => U32>>:
  [("wraith", 2), ("imp", 2), ("demon", 2), ("slime", 2), ("warboar", 1), ("necromancer", 1), ("shaman", 1), ("flesher", 1), ("broodmarrow", 1), ("oathbound", 2), ("whirlgrave", 1), ("hexer", 1), ("lich", 1), ("hollow", 1), ("mirrorling", 1), ("marksman", 1), ("hound", 1), ("pavise", 1), ("geode", 1)]

# Who lives on a floor of this pack (`roster_at`).
def layout.Pack.roster_at(+pack: String, +depth: U32) -> List<&2, Sigma<&2, &2, String, _ => U32>>:
  if String.eq(pack, "crypt"):
    if U32.is_lt(depth, 2):
      layout.roster.crypt_early()
    else:
      layout.roster.crypt_late()
  else:
    if String.eq(pack, "cavern"):
      if U32.is_lt(depth, 2):
        layout.roster.cavern_early()
      else:
        layout.roster.cavern_late()
    else:
      if String.eq(pack, "hellforge"):
        layout.roster.hellforge()
      else:
        if String.eq(pack, "archive"):
          layout.roster.archive()
        else:
          if String.eq(pack, "fungal"):
            layout.roster.fungal()
          else:
            if String.eq(pack, "swamp"):
              if U32.is_lt(depth, 2):
                layout.roster.swamp_early()
              else:
                if U32.is_eq(depth, 2):
                  layout.roster.swamp_mid()
                else:
                  layout.roster.swamp_late()
            else:
              layout.roster.unknown()

def layout.template.EMPTY() -> List<&2, String>:
  ["...........", "...........", "...........", "...........", "...........", "..........."]

def layout.template.PILLARS() -> List<&2, String>:
  ["...........", "..#....#...", "...........", "...........", "..#....#...", "..........."]

def layout.template.TOMBS() -> List<&2, String>:
  ["...........", ".##..##....", "...........", ".##..##....", "...........", "..........."]

def layout.template.COLONNADE() -> List<&2, String>:
  ["...........", "...........", "..#.#.#.#..", "...........", "...........", "..........."]

def layout.template.CROSS() -> List<&2, String>:
  ["...........", "...........", "...........", "......#....", "......#....", "...####...."]

def layout.template.POOLS() -> List<&2, String>:
  ["...........", "...........", "..~~~......", "..~~~......", "...........", "..........."]

def layout.template.LAVA_RIVER() -> List<&2, String>:
  ["...........", "..~~.......", "...~~......", "....~~.....", "...........", "..........."]

def layout.template.STACKS() -> List<&2, String>:
  ["...........", ".####.####.", "...........", ".####.####.", "...........", "..........."]

def layout.template.REEDBEDS() -> List<&2, String>:
  ["...........", "..#........", "......#....", "..~~.......", "..~~....#..", "..........."]

def layout.template.SHRINE() -> List<&2, String>:
  ["...........", "...........", "...........", "........#..", "...........", "..........."]

def layout.template.LAIR() -> List<&2, String>:
  ["...........", ".#.........", "...~~......", "...~~......", "...........", "..........."]

# Each pack's own templates, in Rust's order.
def layout.Pack.templates(+pack: String) -> List<&2, List<&2, String>>:
  if String.eq(pack, "crypt"):
    [layout.template.PILLARS(), layout.template.TOMBS(), layout.template.COLONNADE(), layout.template.CROSS(), layout.template.POOLS()]
  else:
    if String.eq(pack, "cavern"):
      [layout.template.EMPTY(), layout.template.PILLARS(), layout.template.POOLS(), layout.template.CROSS(), layout.template.COLONNADE()]
    else:
      if String.eq(pack, "hellforge"):
        [layout.template.LAVA_RIVER(), layout.template.PILLARS(), layout.template.POOLS(), layout.template.CROSS(), layout.template.TOMBS()]
      else:
        if String.eq(pack, "archive"):
          [layout.template.STACKS(), layout.template.COLONNADE(), layout.template.POOLS(), layout.template.STACKS(), layout.template.CROSS()]
        else:
          if String.eq(pack, "fungal"):
            [layout.template.EMPTY(), layout.template.POOLS(), layout.template.PILLARS(), layout.template.LAVA_RIVER(), layout.template.COLONNADE()]
          else:
            if String.eq(pack, "unknown"):
              [layout.template.EMPTY(), layout.template.PILLARS(), layout.template.CROSS(), layout.template.POOLS(), layout.template.LAVA_RIVER()]
            else:
              [layout.template.REEDBEDS(), layout.template.POOLS(), layout.template.LAVA_RIVER(), layout.template.REEDBEDS(), layout.template.PILLARS()]
