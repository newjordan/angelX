# generated by _gen/pack_data.py from rules/layout.rs: the packs' rosters and templates.
# Enemy kinds are their serde names; a roster is (kind, weight) in Rust's order.

def layout.roster.crypt_early() -> List<&2, Sigma<&2, &2, String, _ => U32>>:
  [("skeleton", 4), ("wraith", 3), ("bat", 2), ("slime", 1), ("biter", 2)]

def layout.roster.crypt_late() -> List<&2, Sigma<&2, &2, String, _ => U32>>:
  [("skeleton", 4), ("wraith", 3), ("bat", 2), ("slime", 2), ("necromancer", 1), ("hexer", 1), ("biter", 1), ("pavise", 2), ("marksman", 1), ("mirrorling", 1), ("ringer", 1)]

