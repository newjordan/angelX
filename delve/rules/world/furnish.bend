# generated by bx.py from furnish.bx: edit the .bx, not this file
# crates/delve/src/rules/layout.rs — one room: the quadrant it is drawn from,
# its mirroring, its fixtures and its company (`room`, `furnish`).
#
# A room is built as a LayGrid, then written as its serde J object. `doors` is
# a J array of four bools. Randomness is the run's `loot::Rng` (a W.W) threaded
# through, drawn in Rust's order.

def layout.is_kind_in(+kind: String, +kinds: List<&2, String>) -> Bool:
  layout.is_kind_in.k1(kinds, kind, kinds)

def layout.is_kind_in.k2(cv: Bool, +kind: String, +h: String, +t: List<&2, String>) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.is_kind_in(kind, t)

def layout.is_kind_in.k1(sv0: List<&2, String>, +kind: String, +kinds: List<&2, String>) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+h, +t}:
      layout.is_kind_in.k2(String.eq(h, kind), kind, h, t)
def layout.fight_or_stairs(+kind: String) -> Bool:
  Bool.or(String.eq(kind, "fight"), String.eq(kind, "stairs"))
# Template rows (`.` floor, `#` block, `~` hazard, `,` bog) as a grid.
def layout.quad.tile(+c: Char) -> LayTile:
  match c:
    case '#':
      TileBlock{}
    case '~':
      TileHazard{}
    case ',':
      TileBog{}
    case _:
      TileFloor{}
def layout.quad.row(+s: String) -> List<&2, LayTile>:
  layout.quad.row.k1(s, s)

def layout.quad.row.k1(sv0: String, +s: String) -> List<&2, LayTile>:
  match sv0:
    case SNil{}:
      Nil{}
    case SCon{+c, +t}:
      Con{layout.quad.tile(c), layout.quad.row(t)}
def layout.quad.rows(+rows: List<&2, String>) -> List<&2, List<&2, LayTile>>:
  layout.quad.rows.k1(rows, rows)

def layout.quad.rows.k1(sv0: List<&2, String>, +rows: List<&2, String>) -> List<&2, List<&2, LayTile>>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      Con{layout.quad.row(h), layout.quad.rows(t)}
def layout.quad.of_rows(+rows: List<&2, String>) -> LayGrid:
  +w = layout.quad.width(rows)
  LayGrid{w, U32.from_nat(List.length(&2, String, rows)), layout.quad.rows(rows)}
def layout.quad.width(+rows: List<&2, String>) -> U32:
  layout.quad.width.k1(rows, rows)

def layout.quad.width.k1(sv0: List<&2, String>, +rows: List<&2, String>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+h, +t}:
      U32.from_nat(String.length(h))
# The nth of a list of row-lists.
def layout.quads.nth(+qs: List<&2, List<&2, String>>, +i: U32) -> List<&2, String>:
  layout.quads.nth.k1(qs, qs, i)

def layout.quads.nth.k2(cv: Bool, +i: U32, +h: List<&2, String>, +t: List<&2, List<&2, String>>) -> List<&2, String>:
  match cv:
    case True{}:
      h
    case False{}:
      layout.quads.nth(t, (i - 1 : U32))

def layout.quads.nth.k1(sv0: List<&2, List<&2, String>>, +qs: List<&2, List<&2, String>>, +i: U32) -> List<&2, String>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      layout.quads.nth.k2(U32.is_eq(i, 0), i, h, t)
def layout.quads.len(+qs: List<&2, List<&2, String>>) -> U32:
  U32.from_nat(List.length(&2, List<&2, String>, qs))
# The pack's index in the rooms module's arms.
def layout.pack_index(+pack: String) -> U32:
  layout.pack_index.k1(String.eq(pack, "crypt"), pack)

def layout.pack_index.k6(cv: Bool, +pack: String) -> U32:
  match cv:
    case True{}:
      5
    case False{}:
      6

def layout.pack_index.k5(cv: Bool, +pack: String) -> U32:
  match cv:
    case True{}:
      4
    case False{}:
      layout.pack_index.k6(String.eq(pack, "unknown"), pack)

def layout.pack_index.k4(cv: Bool, +pack: String) -> U32:
  match cv:
    case True{}:
      3
    case False{}:
      layout.pack_index.k5(String.eq(pack, "fungal"), pack)

def layout.pack_index.k3(cv: Bool, +pack: String) -> U32:
  match cv:
    case True{}:
      2
    case False{}:
      layout.pack_index.k4(String.eq(pack, "archive"), pack)

def layout.pack_index.k2(cv: Bool, +pack: String) -> U32:
  match cv:
    case True{}:
      1
    case False{}:
      layout.pack_index.k3(String.eq(pack, "hellforge"), pack)

def layout.pack_index.k1(cv: Bool, +pack: String) -> U32:
  match cv:
    case True{}:
      0
    case False{}:
      layout.pack_index.k2(String.eq(pack, "cavern"), pack)
# The quadrant a room of `kind` is drawn from: the pack's own and the dungeon
# masters' for a fight, a fixed one for every other kind.
def layout.template_for(+kind: String, +pack: String, +rng: W.W) -> W.W & LayGrid:
  layout.template_for.k1(layout.fight_or_stairs(kind), kind, pack, rng)

def layout.template_for.k3(cv: Bool, +templates: List<&2, List<&2, String>>, +authored: List<&2, List<&2, String>>, +nt: U32, +rng1: W.W, +i: U32) -> W.W & LayGrid:
  match cv:
    case True{}:
      (rng1, layout.quad.of_rows(layout.quads.nth(templates, i)))
    case False{}:
      (rng1, layout.quad.of_rows(layout.quads.nth(authored, (i - nt : U32))))

def layout.template_for.k2(pr: W.W & U32, +templates: List<&2, List<&2, String>>, +authored: List<&2, List<&2, String>>, +nt: U32) -> W.W & LayGrid:
  (+rng1, +i) = pr
  layout.template_for.k3(U32.is_lt(i, nt), templates, authored, nt, rng1, i)

def layout.template_for.k5(cv: Bool, +kind: String, +rng: W.W) -> W.W & LayGrid:
  match cv:
    case True{}:
      (rng, layout.quad.of_rows(layout.template.LAIR()))
    case False{}:
      (rng, layout.quad.of_rows(layout.template.EMPTY()))

def layout.template_for.k4(cv: Bool, +kind: String, +rng: W.W) -> W.W & LayGrid:
  match cv:
    case True{}:
      (rng, layout.quad.of_rows(layout.template.SHRINE()))
    case False{}:
      layout.template_for.k5(String.eq(kind, "lair"), kind, rng)

def layout.template_for.k1(cv: Bool, +kind: String, +pack: String, +rng: W.W) -> W.W & LayGrid:
  match cv:
    case True{}:
      +templates = layout.Pack.templates(pack)
      +authored = layout.rooms.small(layout.pack_index(pack))
      +nt = layout.quads.len(templates)
      layout.template_for.k2(layout.rng.below(rng, (nt + layout.quads.len(authored) : U32)), templates, authored, nt)
    case False{}:
      layout.template_for.k4(String.eq(kind, "treasure"), kind, rng)
# The least a fight room measures for a party this many knights.
def layout.party_room(+party: U32) -> LayDims:
  match party:
    case 0:
      LayDims{24, 14}
    case 1:
      LayDims{24, 14}
    case 2:
      LayDims{34, 20}
    case 3:
      LayDims{42, 24}
    case _:
      LayDims{48, 28}
# The size its kind lays a room at (draws for a fight).
def layout.room.size(+kind: String, +depth: U32, +rng: W.W) -> W.W & LayDims:
  layout.room.size.k1(String.eq(kind, "stairs"), kind, depth, rng)

def layout.room.size.k4(cv: Bool, +kind: String, +depth: U32, +rng: W.W) -> W.W & LayDims:
  match cv:
    case True{}:
      layout.room.size.fight(depth, rng)
    case False{}:
      (rng, LayDims{24, 14})

def layout.room.size.k3(cv: Bool, +kind: String, +depth: U32, +rng: W.W) -> W.W & LayDims:
  match cv:
    case True{}:
      (rng, LayDims{48, 28})
    case False{}:
      layout.room.size.k4(String.eq(kind, "fight"), kind, depth, rng)

def layout.room.size.k2(cv: Bool, +kind: String, +depth: U32, +rng: W.W) -> W.W & LayDims:
  match cv:
    case True{}:
      (rng, LayDims{40, 24})
    case False{}:
      layout.room.size.k3(String.eq(kind, "threshold"), kind, depth, rng)

def layout.room.size.k1(cv: Bool, +kind: String, +depth: U32, +rng: W.W) -> W.W & LayDims:
  match cv:
    case True{}:
      (rng, LayDims{36, 20})
    case False{}:
      layout.room.size.k2(String.eq(kind, "lair"), kind, depth, rng)
def layout.room.size.fight(+depth: U32, +rng: W.W) -> W.W & LayDims:
  layout.room.size.fight.k1(U32.is_ge(depth, 2), depth, rng)

def layout.room.size.fight.k2(pr: W.W & Bool) -> W.W & LayDims:
  (+rng1, +big) = pr
  layout.room.size.fight.big(big, rng1)

def layout.room.size.fight.k1(cv: Bool, +depth: U32, +rng: W.W) -> W.W & LayDims:
  match cv:
    case True{}:
      layout.room.size.fight.k2(layout.rng.chance(rng, 12))
    case False{}:
      layout.room.size.fight.mid(rng)
def layout.room.size.fight.big(+big: Bool, +rng: W.W) -> W.W & LayDims:
  layout.room.size.fight.big.k1(big, big, rng)

def layout.room.size.fight.big.k1(cv: Bool, +big: Bool, +rng: W.W) -> W.W & LayDims:
  match cv:
    case True{}:
      (rng, LayDims{48, 28})
    case False{}:
      layout.room.size.fight.mid(rng)
def layout.room.size.fight.mid(+rng: W.W) -> W.W & LayDims:
  layout.room.size.fight.mid.k1(layout.rng.chance(rng, 30))

def layout.room.size.fight.mid.k2(cv: Bool, +rng1: W.W, +mid: Bool) -> W.W & LayDims:
  match cv:
    case True{}:
      (rng1, LayDims{32, 20})
    case False{}:
      (rng1, LayDims{24, 14})

def layout.room.size.fight.mid.k1(pr: W.W & Bool) -> W.W & LayDims:
  (+rng1, +mid) = pr
  layout.room.size.fight.mid.k2(mid, rng1, mid)
def layout.room(+cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +party: U32, +rng: W.W) -> J.Val & W.W:
  layout.room.k1(layout.template_for(kind, pack, rng), cell, kind, doors, depth, pack, party)

def layout.room.k4(pr: LayDims, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +template: LayGrid, +rng2: W.W, +cols0: U32, +rows0: U32, +company: U32) -> J.Val & W.W:
  match pr:
    case LayDims{+lc, +lr}:
      +cols = Bool.pick(U32, layout.fight_or_stairs(kind), U32.max(cols0, lc), cols0)
      +rows = Bool.pick(U32, layout.fight_or_stairs(kind), U32.max(rows0, lr), rows0)
      layout.furnish(cell, kind, doors, depth, pack, template, cols, rows, cols0, rows0, company, rng2)

def layout.room.k3(pr: LayDims, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +party: U32, +template: LayGrid, +rng2: W.W) -> J.Val & W.W:
  match pr:
    case LayDims{+cols0, +rows0}:
      +company = U32.div((cols0 * rows0 : U32), 672)
      +least = layout.party_room(party)
      layout.room.k4(least, cell, kind, doors, depth, pack, template, rng2, cols0, rows0, company)

def layout.room.k2(pr: W.W & LayDims, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +party: U32, +template: LayGrid) -> J.Val & W.W:
  (+rng2, +d) = pr
  layout.room.k3(d, cell, kind, doors, depth, pack, party, template, rng2)

def layout.room.k1(pr: W.W & LayGrid, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +party: U32) -> J.Val & W.W:
  (+rng1, +template) = pr
  layout.room.k2(layout.room.size(kind, depth, rng1), cell, kind, doors, depth, pack, party, template)
# Lay `quadrant` into a grid `cols` by `rows`, mirrored both ways, walls round
# it and doorways where `doors` says.
def layout.mirror.tile(+row: U32, +col: U32, +cols: U32, +rows: U32, +doors: J.Val, +quad: LayGrid) -> LayTile:
  layout.mirror.tile.k1(Bool.or(Bool.or(U32.is_eq(row, 0), U32.is_eq(col, 0)), Bool.or(U32.is_eq(row, (rows - 1 : U32)), U32.is_eq(col, (cols - 1 : U32)))), row, col, cols, rows, doors, quad)

def layout.mirror.tile.k2(cv: Bool, +door: Bool) -> LayTile:
  match cv:
    case True{}:
      TileDoor{}
    case False{}:
      TileWall{}

def layout.mirror.tile.k1(cv: Bool, +row: U32, +col: U32, +cols: U32, +rows: U32, +doors: J.Val, +quad: LayGrid) -> LayTile:
  match cv:
    case True{}:
      +lane_x = Bool.or(U32.is_eq(col, (layout.half(cols) - 1 : U32)), U32.is_eq(col, layout.half(cols)))
      +lane_y = Bool.or(U32.is_eq(row, (layout.half(rows) - 1 : U32)), U32.is_eq(row, layout.half(rows)))
      +door = Bool.or(Bool.or(Bool.and(Bool.and(U32.is_eq(row, 0), lane_x), J.bool(J.nth(doors, 0))), Bool.and(Bool.and(U32.is_eq(col, (cols - 1 : U32)), lane_y), J.bool(J.nth(doors, 1)))), Bool.or(Bool.and(Bool.and(U32.is_eq(row, (rows - 1 : U32)), lane_x), J.bool(J.nth(doors, 2))), Bool.and(Bool.and(U32.is_eq(col, 0), lane_y), J.bool(J.nth(doors, 3)))))
      layout.mirror.tile.k2(door, door)
    case False{}:
      +qw = (layout.half(cols) - 1 : U32)
      +qh = (layout.half(rows) - 1 : U32)
      +qx = Bool.pick(U32, U32.is_le(col, qw), (col - 1 : U32), (cols - 2 - col : U32))
      +qy = Bool.pick(U32, U32.is_le(row, qh), (row - 1 : U32), (rows - 2 - row : U32))
      layout.mirror.mark(layout.grid.get(quad, qx, qy))
def layout.mirror.mark(+t: LayTile) -> LayTile:
  match t:
    case TileBlock{}:
      TileBlock{}
    case TileHazard{}:
      TileHazard{}
    case TileBog{}:
      TileBog{}
    case _:
      TileFloor{}
def layout.mirror.row(+row: U32, +col: U32, +cols: U32, +rows: U32, +doors: J.Val, +quad: LayGrid) -> List<&2, LayTile>:
  layout.mirror.row.k1(U32.is_ge(col, cols), row, col, cols, rows, doors, quad)

def layout.mirror.row.k1(cv: Bool, +row: U32, +col: U32, +cols: U32, +rows: U32, +doors: J.Val, +quad: LayGrid) -> List<&2, LayTile>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      Con{layout.mirror.tile(row, col, cols, rows, doors, quad), layout.mirror.row(row, (col + 1 : U32), cols, rows, doors, quad)}
def layout.mirror.rows(+row: U32, +cols: U32, +rows: U32, +doors: J.Val, +quad: LayGrid) -> List<&2, List<&2, LayTile>>:
  layout.mirror.rows.k1(U32.is_ge(row, rows), row, cols, rows, doors, quad)

def layout.mirror.rows.k1(cv: Bool, +row: U32, +cols: U32, +rows: U32, +doors: J.Val, +quad: LayGrid) -> List<&2, List<&2, LayTile>>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      Con{layout.mirror.row(row, 0, cols, rows, doors, quad), layout.mirror.rows((row + 1 : U32), cols, rows, doors, quad)}
def layout.mirror(+cols: U32, +rows: U32, +doors: J.Val, +quad: LayGrid) -> LayGrid:
  LayGrid{cols, rows, layout.mirror.rows(0, cols, rows, doors, quad)}
# Every doorway and the centre reachable on foot.
def layout.walkable(+t: LayTile) -> Bool:
  match t:
    case TileFloor{}:
      True{}
    case TileDoor{}:
      True{}
    case TileStairs{}:
      True{}
    case TileBog{}:
      True{}
    case _:
      False{}
def layout.connected_grid(+g: LayGrid) -> Bool:
  layout.connected_grid.k1(g, g)

def layout.connected_grid.k1(sv0: LayGrid, +g: LayGrid) -> Bool:
  match sv0:
    case LayGrid{+cols, +rows, +tiles}:
      +c0 = layout.half(cols)
      +r0 = layout.half(rows)
      +seen = layout.grid.set(layout.grid.new(cols, rows, TileWall{}), c0, r0, TileFloor{})
      +seen2 = layout.connected_grid.flood(g, seen, [LayCell{c0, r0}])
      layout.connected_grid.doors(g, seen2, 0, 0, cols, rows)
# Depth-first over the walkable tiles; `seen` marks reached cells (floor).
def layout.connected_grid.flood(+g: LayGrid, +seen: LayGrid, +stack: List<&2, LayCell>) -> LayGrid:
  layout.connected_grid.flood.k1(stack, g, seen, stack)

def layout.connected_grid.flood.k3(pr: LayGrid & List<&2, LayCell>, +g: LayGrid) -> LayGrid:
  (+seen2, +stack2) = pr
  layout.connected_grid.flood(g, seen2, stack2)

def layout.connected_grid.flood.k2(pr: LayCell, +g: LayGrid, +seen: LayGrid, +t: List<&2, LayCell>) -> LayGrid:
  match pr:
    case LayCell{+c, +r}:
      layout.connected_grid.flood.k3(layout.connected_grid.step(g, seen, t, c, r, 0), g)

def layout.connected_grid.flood.k1(sv0: List<&2, LayCell>, +g: LayGrid, +seen: LayGrid, +stack: List<&2, LayCell>) -> LayGrid:
  match sv0:
    case Nil{}:
      seen
    case Con{+h, +t}:
      layout.connected_grid.flood.k2(h, g, seen, t)
def layout.connected_grid.step(+g: LayGrid, +seen: LayGrid, +stack: List<&2, LayCell>, +c: U32, +r: U32, +d: U32) -> LayGrid & List<&2, LayCell>:
  layout.connected_grid.step.k1(U32.is_ge(d, 4), g, seen, stack, c, r, d)

def layout.connected_grid.step.k2(cv: Bool, +g: LayGrid, +seen: LayGrid, +stack: List<&2, LayCell>, +c: U32, +r: U32, +d: U32, +nc: U32, +nr: U32) -> LayGrid & List<&2, LayCell>:
  match cv:
    case True{}:
      layout.connected_grid.step(g, layout.grid.set(seen, nc, nr, TileFloor{}), Con{LayCell{nc, nr}, stack}, c, r, (d + 1 : U32))
    case False{}:
      layout.connected_grid.step(g, seen, stack, c, r, (d + 1 : U32))

def layout.connected_grid.step.k1(cv: Bool, +g: LayGrid, +seen: LayGrid, +stack: List<&2, LayCell>, +c: U32, +r: U32, +d: U32) -> LayGrid & List<&2, LayCell>:
  match cv:
    case True{}:
      (seen, stack)
    case False{}:
      +nc = (c + layout.DX(d) : U32)
      +nr = (r + layout.DY(d) : U32)
      layout.connected_grid.step.k2(Bool.and(layout.walkable(layout.grid.get(g, nc, nr)), Bool.not(layout.tile_is_floor(layout.grid.get(seen, nc, nr)))), g, seen, stack, c, r, d, nc, nr)
def layout.tile_is_door(+t: LayTile) -> Bool:
  match t:
    case TileDoor{}:
      True{}
    case _:
      False{}
# Every door tile was reached.
def layout.connected_grid.doors(+g: LayGrid, +seen: LayGrid, +r: U32, +c: U32, +cols: U32, +rows: U32) -> Bool:
  layout.connected_grid.doors.k1(U32.is_ge(r, rows), g, seen, r, c, cols, rows)

def layout.connected_grid.doors.k3(cv: Bool, +g: LayGrid, +seen: LayGrid, +r: U32, +c: U32, +cols: U32, +rows: U32) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      layout.connected_grid.doors(g, seen, r, (c + 1 : U32), cols, rows)

def layout.connected_grid.doors.k2(cv: Bool, +g: LayGrid, +seen: LayGrid, +r: U32, +c: U32, +cols: U32, +rows: U32) -> Bool:
  match cv:
    case True{}:
      layout.connected_grid.doors(g, seen, (r + 1 : U32), 0, cols, rows)
    case False{}:
      layout.connected_grid.doors.k3(Bool.and(layout.tile_is_door(layout.grid.get(g, c, r)), Bool.not(layout.tile_is_floor(layout.grid.get(seen, c, r)))), g, seen, r, c, cols, rows)

def layout.connected_grid.doors.k1(cv: Bool, +g: LayGrid, +seen: LayGrid, +r: U32, +c: U32, +cols: U32, +rows: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.connected_grid.doors.k2(U32.is_ge(c, cols), g, seen, r, c, cols, rows)
# `connected` over a room's J object.
def layout.connected(+room: J.Val) -> Bool:
  layout.connected_grid(layout.grid.of_room(room))
# A great hall's quadrant
# -----------------------

def layout.gq.pillars(+g: LayGrid, +y: U32, +yend: U32, +sy: U32, +sx: U32, +w: U32, +rng: W.W) -> LayGrid & W.W:
  layout.gq.pillars.k1(U32.is_ge(y, yend), g, y, yend, sy, sx, w, rng)

def layout.gq.pillars.k2(pr: LayGrid & W.W, +y: U32, +yend: U32, +sy: U32, +sx: U32, +w: U32) -> LayGrid & W.W:
  (+g2, +rng2) = pr
  layout.gq.pillars(g2, (y + sy : U32), yend, sy, sx, w, rng2)

def layout.gq.pillars.k1(cv: Bool, +g: LayGrid, +y: U32, +yend: U32, +sy: U32, +sx: U32, +w: U32, +rng: W.W) -> LayGrid & W.W:
  match cv:
    case True{}:
      (g, rng)
    case False{}:
      layout.gq.pillars.k2(layout.gq.row(g, y, 2, (w - 2 : U32), sx, w, rng), y, yend, sy, sx, w)
def layout.gq.row(+g: LayGrid, +y: U32, +x: U32, +xend: U32, +sx: U32, +w: U32, +rng: W.W) -> LayGrid & W.W:
  layout.gq.row.k1(U32.is_ge(x, xend), g, y, x, xend, sx, w, rng)

def layout.gq.row.k4(pr: W.W & Bool, +g: LayGrid, +y: U32, +x: U32, +xend: U32, +sx: U32, +w: U32) -> LayGrid & W.W:
  (+rng2, +twin) = pr
  +g1 = layout.grid.set(g, x, y, TileBlock{})
  +g2 = Bool.pick(LayGrid, Bool.and(twin, U32.is_lt((x + 1 : U32), (w - 2 : U32))), layout.grid.set(g1, (x + 1 : U32), y, TileBlock{}), g1)
  layout.gq.row(g2, y, (x + sx : U32), xend, sx, w, rng2)

def layout.gq.row.k3(cv: Bool, +g: LayGrid, +y: U32, +x: U32, +xend: U32, +sx: U32, +w: U32, +rng1: W.W, +hit: Bool) -> LayGrid & W.W:
  match cv:
    case True{}:
      layout.gq.row.k4(layout.rng.chance(rng1, 35), g, y, x, xend, sx, w)
    case False{}:
      layout.gq.row(g, y, (x + sx : U32), xend, sx, w, rng1)

def layout.gq.row.k2(pr: W.W & Bool, +g: LayGrid, +y: U32, +x: U32, +xend: U32, +sx: U32, +w: U32) -> LayGrid & W.W:
  (+rng1, +hit) = pr
  layout.gq.row.k3(hit, g, y, x, xend, sx, w, rng1, hit)

def layout.gq.row.k1(cv: Bool, +g: LayGrid, +y: U32, +x: U32, +xend: U32, +sx: U32, +w: U32, +rng: W.W) -> LayGrid & W.W:
  match cv:
    case True{}:
      (g, rng)
    case False{}:
      layout.gq.row.k2(layout.rng.chance(rng, 80), g, y, x, xend, sx, w)
# Fill the cells [px, px2) x [py, py2) with `t`.
def layout.grid.fill_rect(+g: LayGrid, +px: U32, +py: U32, +px2: U32, +py2: U32, +t: LayTile) -> LayGrid:
  layout.grid.fill_rect.rows(g, py, px, px2, py2, t)
def layout.grid.fill_rect.rows(+g: LayGrid, +y: U32, +px: U32, +px2: U32, +py2: U32, +t: LayTile) -> LayGrid:
  layout.grid.fill_rect.rows.k1(U32.is_ge(y, py2), g, y, px, px2, py2, t)

def layout.grid.fill_rect.rows.k1(cv: Bool, +g: LayGrid, +y: U32, +px: U32, +px2: U32, +py2: U32, +t: LayTile) -> LayGrid:
  match cv:
    case True{}:
      g
    case False{}:
      layout.grid.fill_rect.rows(layout.grid.fill_rect.cols(g, y, px, px2, t), (y + 1 : U32), px, px2, py2, t)
def layout.grid.fill_rect.cols(+g: LayGrid, +y: U32, +x: U32, +x2: U32, +t: LayTile) -> LayGrid:
  layout.grid.fill_rect.cols.k1(U32.is_ge(x, x2), g, y, x, x2, t)

def layout.grid.fill_rect.cols.k1(cv: Bool, +g: LayGrid, +y: U32, +x: U32, +x2: U32, +t: LayTile) -> LayGrid:
  match cv:
    case True{}:
      g
    case False{}:
      layout.grid.fill_rect.cols(layout.grid.set(g, x, y, t), y, (x + 1 : U32), x2, t)
def layout.gq.pools(+g: LayGrid, +n: U32, +w: U32, +h: U32, +rng: W.W) -> LayGrid & W.W:
  layout.gq.pools.k1(U32.is_eq(n, 0), g, n, w, h, rng)

def layout.gq.pools.k3(pr: W.W & U32, +g: LayGrid, +n: U32, +w: U32, +h: U32, +a: U32) -> LayGrid & W.W:
  (+rng2, +b) = pr
  +px = (2 + a : U32)
  +py = (2 + b : U32)
  layout.gq.pools(layout.grid.fill_rect(g, px, py, U32.min((px + 3 : U32), (w - 2 : U32)), U32.min((py + 2 : U32), (h - 2 : U32)), TileHazard{}), (n - 1 : U32), w, h, rng2)

def layout.gq.pools.k2(pr: W.W & U32, +g: LayGrid, +n: U32, +w: U32, +h: U32) -> LayGrid & W.W:
  (+rng1, +a) = pr
  layout.gq.pools.k3(layout.rng.below(rng1, U32.max(Bool.pick(U32, U32.is_ge(h, 6), (h - 6 : U32), 0), 1)), g, n, w, h, a)

def layout.gq.pools.k1(cv: Bool, +g: LayGrid, +n: U32, +w: U32, +h: U32, +rng: W.W) -> LayGrid & W.W:
  match cv:
    case True{}:
      (g, rng)
    case False{}:
      layout.gq.pools.k2(layout.rng.below(rng, U32.max(Bool.pick(U32, U32.is_ge(w, 7), (w - 7 : U32), 0), 1)), g, n, w, h)
def layout.gq.clear(+g: LayGrid, +w: U32, +h: U32) -> LayGrid:
  +g1 = layout.grid.fill_rect(g, (w - 2 : U32), 0, w, h, TileFloor{})
  layout.grid.fill_rect(g1, 0, (h - 2 : U32), w, h, TileFloor{})
# A great hall's quadrant (`w` by `h`, mirrored into the whole room): rows of
# pillars with gaps, a pool or two, the lanes to the middle and the doorways
# kept open.
def layout.great_quadrant(+w: U32, +h: U32, +kind: String, +rng: W.W) -> LayGrid & W.W:
  layout.great_quadrant.k1(layout.rng.below(rng, 2), w, h, kind)

def layout.great_quadrant.k4(pr: LayGrid & W.W, +w: U32, +h: U32) -> LayGrid & W.W:
  (+g2, +rng4) = pr
  (layout.gq.clear(g2, w, h), rng4)

def layout.great_quadrant.k3(pr: LayGrid & W.W, +w: U32, +h: U32, +kind: String) -> LayGrid & W.W:
  (+g1, +rng3) = pr
  layout.great_quadrant.k4(layout.gq.pools_for(g1, kind, w, h, rng3), w, h)

def layout.great_quadrant.k2(pr: W.W & U32, +w: U32, +h: U32, +kind: String, +ax: U32) -> LayGrid & W.W:
  (+rng2, +ay) = pr
  layout.great_quadrant.k3(layout.gq.pillars(layout.grid.new(w, h, TileFloor{}), 2, (h - 2 : U32), (3 + ay : U32), (4 + ax : U32), w, rng2), w, h, kind)

def layout.great_quadrant.k1(pr: W.W & U32, +w: U32, +h: U32, +kind: String) -> LayGrid & W.W:
  (+rng1, +ax) = pr
  layout.great_quadrant.k2(layout.rng.below(rng1, 2), w, h, kind, ax)
def layout.gq.pools_for(+g: LayGrid, +kind: String, +w: U32, +h: U32, +rng: W.W) -> LayGrid & W.W:
  layout.gq.pools_for.k1(String.eq(kind, "lair"), g, kind, w, h, rng)

def layout.gq.pools_for.k2(pr: W.W & U32, +g: LayGrid, +w: U32, +h: U32) -> LayGrid & W.W:
  (+rng1, +n) = pr
  layout.gq.pools(g, n, w, h, rng1)

def layout.gq.pools_for.k1(cv: Bool, +g: LayGrid, +kind: String, +w: U32, +h: U32, +rng: W.W) -> LayGrid & W.W:
  match cv:
    case True{}:
      layout.gq.pools(g, 2, w, h, rng)
    case False{}:
      layout.gq.pools_for.k2(layout.rng.below(rng, 2), g, w, h)
# The swamp's mire over one quadrant (swamp.rs `mire`)
# ---------------------------------------------------

def layout.swamp.tier(+depth: U32) -> U32:
  (U32.clamp(depth, 1, 3) - 1 : U32)
def layout.swamp.share(+depth: U32) -> U32:
  layout.swamp.share.k1(layout.swamp.tier(depth), depth)

def layout.swamp.share.k1(sv0: U32, +depth: U32) -> U32:
  match sv0:
    case 0:
      35
    case 1:
      45
    case _:
      50
# swamp.rs `salt(cell, depth)`.
def layout.swamp.salt(+cell: LayCell, +depth: U32) -> W.W:
  layout.swamp.salt.k1(cell, depth)

def layout.swamp.salt.k1(pr: LayCell, +depth: U32) -> W.W:
  match pr:
    case LayCell{+cx, +cy}:
      +a = W.mul(W.of_u32(depth), W.of_u32(2654435769))
      +b = W.mul(layout.sext(cx), W.of_u32(5340353))
      +c = W.mul(layout.sext(cy), W.of_u32(625341585))
      layout.mix(W.xor(W.xor(W.xor(a, b), c), W.of_u32(23099)))
# One corner of the smooth noise, 0..1 from 16 bits of the mix.
def layout.swamp.corner(+gx: U32, +gy: U32, +salt: W.W) -> F32:
  +m = layout.mix(W.xor(W.xor(salt, W.shl(W.of_u32(gx), 20)), W.shl(W.of_u32(gy), 40)))
  (U32.to_f32(W.lo32(W.and(m, W.of_u32(65535)))) / 65535.0 : F32)
def layout.swamp.wet(+x: U32, +y: U32, +salt: W.W) -> F32:
  +fx = (U32.to_f32(x) / 3.0 : F32)
  +fy = (U32.to_f32(y) / 3.0 : F32)
  +gx = F32.to_u32(F32.floor(fx))
  +gy = F32.to_u32(F32.floor(fy))
  +tx = (fx - U32.to_f32(gx) : F32)
  +ty = (fy - U32.to_f32(gy) : F32)
  +top = (layout.swamp.corner(gx, gy, salt) * (1.0 - tx : F32) + layout.swamp.corner((gx + 1 : U32), gy, salt) * tx : F32)
  +bottom = (layout.swamp.corner(gx, (gy + 1 : U32), salt) * (1.0 - tx : F32) + layout.swamp.corner((gx + 1 : U32), (gy + 1 : U32), salt) * tx : F32)
  (top * (1.0 - ty : F32) + bottom * ty : F32)
# Whether any reed block lies in the 3x3 round (x, y) of the quadrant.
def layout.swamp.reeds(+g: LayGrid, +x: U32, +y: U32, +w: U32, +h: U32) -> Bool:
  +y0 = Bool.pick(U32, U32.is_eq(y, 0), 0, (y - 1 : U32))
  +x0 = Bool.pick(U32, U32.is_eq(x, 0), 0, (x - 1 : U32))
  layout.swamp.reeds.rows(g, y0, U32.min((y + 1 : U32), (h - 1 : U32)), x0, U32.min((x + 1 : U32), (w - 1 : U32)))
def layout.swamp.reeds.rows(+g: LayGrid, +yy: U32, +y1: U32, +x0: U32, +x1: U32) -> Bool:
  layout.swamp.reeds.rows.k1(U32.is_gt(yy, y1), g, yy, y1, x0, x1)

def layout.swamp.reeds.rows.k2(cv: Bool, +g: LayGrid, +yy: U32, +y1: U32, +x0: U32, +x1: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.swamp.reeds.rows(g, (yy + 1 : U32), y1, x0, x1)

def layout.swamp.reeds.rows.k1(cv: Bool, +g: LayGrid, +yy: U32, +y1: U32, +x0: U32, +x1: U32) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      layout.swamp.reeds.rows.k2(layout.swamp.reeds.cols(g, yy, x0, x1), g, yy, y1, x0, x1)
def layout.swamp.reeds.cols(+g: LayGrid, +yy: U32, +xx: U32, +x1: U32) -> Bool:
  layout.swamp.reeds.cols.k1(U32.is_gt(xx, x1), g, yy, xx, x1)

def layout.swamp.reeds.cols.k2(cv: Bool, +g: LayGrid, +yy: U32, +xx: U32, +x1: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.swamp.reeds.cols(g, yy, (xx + 1 : U32), x1)

def layout.swamp.reeds.cols.k1(cv: Bool, +g: LayGrid, +yy: U32, +xx: U32, +x1: U32) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      layout.swamp.reeds.cols.k2(layout.tile_is_block(layout.grid.get(g, xx, yy)), g, yy, xx, x1)
def layout.tile_is_block(+t: LayTile) -> Bool:
  match t:
    case TileBlock{}:
      True{}
    case _:
      False{}
def layout.swamp.open(+g: LayGrid, +x: U32, +y: U32, +w: U32, +h: U32, +salt: W.W) -> List<&2, LayWet>:
  layout.swamp.open.k1(U32.is_ge(y, (h - 2 : U32)), g, x, y, w, h, salt)

def layout.swamp.open.k3(cv: Bool, +g: LayGrid, +x: U32, +y: U32, +w: U32, +h: U32, +salt: W.W) -> List<&2, LayWet>:
  match cv:
    case True{}:
      Con{LayWet{layout.swamp.wet(x, y, salt), x, y}, layout.swamp.open(g, (x + 1 : U32), y, w, h, salt)}
    case False{}:
      layout.swamp.open(g, (x + 1 : U32), y, w, h, salt)

def layout.swamp.open.k2(cv: Bool, +g: LayGrid, +x: U32, +y: U32, +w: U32, +h: U32, +salt: W.W) -> List<&2, LayWet>:
  match cv:
    case True{}:
      layout.swamp.open(g, 0, (y + 1 : U32), w, h, salt)
    case False{}:
      layout.swamp.open.k3(Bool.and(layout.tile_is_floor(layout.grid.get(g, x, y)), Bool.not(layout.swamp.reeds(g, x, y, w, h))), g, x, y, w, h, salt)

def layout.swamp.open.k1(cv: Bool, +g: LayGrid, +x: U32, +y: U32, +w: U32, +h: U32, +salt: W.W) -> List<&2, LayWet>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      layout.swamp.open.k2(U32.is_ge(x, (w - 2 : U32)), g, x, y, w, h, salt)
# Count the floor cells of the quadrant.
def layout.swamp.count_floor(+g: LayGrid) -> U32:
  layout.swamp.count_floor.k1(g, g)

def layout.swamp.count_floor.k1(sv0: LayGrid, +g: LayGrid) -> U32:
  match sv0:
    case LayGrid{+cols, +rows, +tiles}:
      layout.swamp.count_rows(tiles)
def layout.swamp.count_rows(+rows: List<&2, List<&2, LayTile>>) -> U32:
  layout.swamp.count_rows.k1(rows, rows)

def layout.swamp.count_rows.k1(sv0: List<&2, List<&2, LayTile>>, +rows: List<&2, List<&2, LayTile>>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+h, +t}:
      (layout.swamp.count_row(h) + layout.swamp.count_rows(t) : U32)
def layout.swamp.count_row(+row: List<&2, LayTile>) -> U32:
  layout.swamp.count_row.k1(row, row)

def layout.swamp.count_row.k1(sv0: List<&2, LayTile>, +row: List<&2, LayTile>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+h, +t}:
      (Bool.to_u32(layout.tile_is_floor(h)) + layout.swamp.count_row(t) : U32)
# Wetter first; ties by (x, y). `b` before `a` when b is wetter.
def layout.swamp.before(+a: LayWet, +b: LayWet) -> Bool:
  layout.swamp.before.k1(a, b)

def layout.swamp.before.k4(cv: Bool, +wa: F32, +ax: U32, +ay: U32, +wb: F32, +bx: U32, +by: U32) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      Bool.or(U32.is_lt(ax, bx), Bool.and(U32.is_eq(ax, bx), U32.is_lt(ay, by)))

def layout.swamp.before.k3(cv: Bool, +wa: F32, +ax: U32, +ay: U32, +wb: F32, +bx: U32, +by: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      layout.swamp.before.k4(F32.is_lt(wa, wb), wa, ax, ay, wb, bx, by)

def layout.swamp.before.k2(pr: LayWet, +wa: F32, +ax: U32, +ay: U32) -> Bool:
  match pr:
    case LayWet{+wb, +bx, +by}:
      layout.swamp.before.k3(F32.is_gt(wa, wb), wa, ax, ay, wb, bx, by)

def layout.swamp.before.k1(pr: LayWet, +b: LayWet) -> Bool:
  match pr:
    case LayWet{+wa, +ax, +ay}:
      layout.swamp.before.k2(b, wa, ax, ay)
def layout.swamp.sorted(+xs: List<&2, LayWet>) -> List<&2, LayWet>:
  layout.swamp.sorted.k1(xs, xs)

def layout.swamp.sorted.k1(sv0: List<&2, LayWet>, +xs: List<&2, LayWet>) -> List<&2, LayWet>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      layout.swamp.insert(h, layout.swamp.sorted(t))
def layout.swamp.insert(+c: LayWet, +sorted: List<&2, LayWet>) -> List<&2, LayWet>:
  layout.swamp.insert.k1(sorted, c, sorted)

def layout.swamp.insert.k2(cv: Bool, +c: LayWet, +sorted: List<&2, LayWet>, +h: LayWet, +t: List<&2, LayWet>) -> List<&2, LayWet>:
  match cv:
    case True{}:
      Con{c, sorted}
    case False{}:
      Con{h, layout.swamp.insert(c, t)}

def layout.swamp.insert.k1(sv0: List<&2, LayWet>, +c: LayWet, +sorted: List<&2, LayWet>) -> List<&2, LayWet>:
  match sv0:
    case Nil{}:
      [c]
    case Con{+h, +t}:
      layout.swamp.insert.k2(layout.swamp.before(c, h), c, sorted, h, t)
def layout.swamp.bog(+g: LayGrid, +xs: List<&2, LayWet>, +n: U32) -> LayGrid:
  layout.swamp.bog.k1(U32.is_eq(n, 0), g, xs, n)

def layout.swamp.bog.k3(pr: LayWet, +g: LayGrid, +n: U32, +t: List<&2, LayWet>) -> LayGrid:
  match pr:
    case LayWet{+wt, +x, +y}:
      layout.swamp.bog(layout.grid.set(g, x, y, TileBog{}), t, (n - 1 : U32))

def layout.swamp.bog.k2(sv0: List<&2, LayWet>, +g: LayGrid, +xs: List<&2, LayWet>, +n: U32) -> LayGrid:
  match sv0:
    case Nil{}:
      g
    case Con{+h, +t}:
      layout.swamp.bog.k3(h, g, n, t)

def layout.swamp.bog.k1(cv: Bool, +g: LayGrid, +xs: List<&2, LayWet>, +n: U32) -> LayGrid:
  match cv:
    case True{}:
      g
    case False{}:
      layout.swamp.bog.k2(xs, g, xs, n)
# `mire(quadrant, depth, salt)`: the wettest share of the open ground goes to bog.
def layout.swamp.mire(+g: LayGrid, +depth: U32, +salt: W.W) -> LayGrid:
  layout.swamp.mire.k1(g, g, depth, salt)

def layout.swamp.mire.k1(sv0: LayGrid, +g: LayGrid, +depth: U32, +salt: W.W) -> LayGrid:
  match sv0:
    case LayGrid{+w, +h, +tiles}:
      +open = layout.swamp.open(g, 0, 0, w, h, salt)
      +all = layout.swamp.count_floor(g)
      +want = U32.min(U32.div((all * layout.swamp.share(depth) : U32), 100), U32.from_nat(List.length(&2, LayWet, open)))
      layout.swamp.bog(g, layout.swamp.sorted(open), want)
# Furnishing
# ----------

# The enemy kinds that are one of a room's dangerous ones (monsters.rs `elite`).
def layout.elite(+kind: String) -> Bool:
  layout.is_kind_in(kind, ["necromancer", "shaman", "warboar", "slime", "flesher", "silkmother", "hexer", "lich", "hollow", "marksman", "spitter", "ringer", "hound", "broodmarrow", "whirlgrave", "drowned"])
# The third company (critters.rs `critter`).
def layout.critter(+kind: String) -> Bool:
  layout.is_kind_in(kind, ["biter", "shard", "mole", "pavise", "leech", "marksman", "mirrorling", "spitter", "ringer", "geode", "hound"])
def layout.Pack.dangers_at(+depth: U32) -> U32:
  Bool.pick(U32, U32.is_gt(depth, 3), 3, 2)
def layout.roster.names(+xs: List<&2, Sigma<&2, &2, String, _ => U32>>) -> List<&2, String>:
  layout.roster.names.k1(xs, xs)

def layout.roster.names.k1(sv0: List<&2, Sigma<&2, &2, String, _ => U32>>, +xs: List<&2, Sigma<&2, &2, String, _ => U32>>) -> List<&2, String>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      Con{layout.roster.name(h), layout.roster.names(t)}
def layout.roster.name(+p: Sigma<&2, &2, String, _ => U32>) -> String:
  layout.roster.name.k1(p, p)

def layout.roster.name.k1(sv0: Sigma<&2, &2, String, _ => U32>, +p: Sigma<&2, &2, String, _ => U32>) -> String:
  match sv0:
    case (+n, +w):
      n
def layout.roster.weights(+xs: List<&2, Sigma<&2, &2, String, _ => U32>>) -> List<&2, U32>:
  layout.roster.weights.k1(xs, xs)

def layout.roster.weights.k1(sv0: List<&2, Sigma<&2, &2, String, _ => U32>>, +xs: List<&2, Sigma<&2, &2, String, _ => U32>>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      Con{layout.roster.weight(h), layout.roster.weights(t)}
def layout.roster.weight(+p: Sigma<&2, &2, String, _ => U32>) -> U32:
  layout.roster.weight.k1(p, p)

def layout.roster.weight.k1(sv0: Sigma<&2, &2, String, _ => U32>, +p: Sigma<&2, &2, String, _ => U32>) -> U32:
  match sv0:
    case (+n, +w):
      w
def layout.strings.nth(+xs: List<&2, String>, +i: U32) -> String:
  layout.strings.nth.k1(xs, xs, i)

def layout.strings.nth.k2(cv: Bool, +i: U32, +h: String, +t: List<&2, String>) -> String:
  match cv:
    case True{}:
      h
    case False{}:
      layout.strings.nth(t, (i - 1 : U32))

def layout.strings.nth.k1(sv0: List<&2, String>, +xs: List<&2, String>, +i: U32) -> String:
  match sv0:
    case Nil{}:
      ""
    case Con{+h, +t}:
      layout.strings.nth.k2(U32.is_eq(i, 0), i, h, t)
def layout.strings.len(+xs: List<&2, String>) -> U32:
  U32.from_nat(List.length(&2, String, xs))
def layout.strings.has(+xs: List<&2, String>, +v: String) -> Bool:
  layout.is_kind_in(v, xs)
# What a room or a wave brings instead of a second of a dangerous kind: the
# floor's first plain monster.
def layout.Pack.plain_at(+pack: String, +depth: U32) -> String:
  layout.Pack.plain_first(layout.roster.names(layout.Pack.roster_at(pack, depth)))
def layout.Pack.plain_first(+names: List<&2, String>) -> String:
  layout.Pack.plain_first.k1(names, names)

def layout.Pack.plain_first.k2(cv: Bool, +h: String, +t: List<&2, String>) -> String:
  match cv:
    case True{}:
      layout.Pack.plain_first(t)
    case False{}:
      h

def layout.Pack.plain_first.k1(sv0: List<&2, String>, +names: List<&2, String>) -> String:
  match sv0:
    case Nil{}:
      "bat"
    case Con{+h, +t}:
      layout.Pack.plain_first.k2(layout.elite(h), h, t)
# `n` picks from the pack's roster, as J strings.
def layout.roster.picks(+n: U32, +names: List<&2, String>, +weights: List<&2, U32>, +rng: W.W) -> List<&2, String> & W.W:
  layout.roster.picks.k1(U32.is_eq(n, 0), n, names, weights, rng)

def layout.roster.picks.k3(pr: List<&2, String> & W.W, +names: List<&2, String>, +i: U32) -> List<&2, String> & W.W:
  (+rest, +rng2) = pr
  (Con{layout.strings.nth(names, i), rest}, rng2)

def layout.roster.picks.k2(pr: W.W & U32, +n: U32, +names: List<&2, String>, +weights: List<&2, U32>) -> List<&2, String> & W.W:
  (+rng1, +i) = pr
  layout.roster.picks.k3(layout.roster.picks((n - 1 : U32), names, weights, rng1), names, i)

def layout.roster.picks.k1(cv: Bool, +n: U32, +names: List<&2, String>, +weights: List<&2, U32>, +rng: W.W) -> List<&2, String> & W.W:
  match cv:
    case True{}:
      (Nil{}, rng)
    case False{}:
      layout.roster.picks.k2(layout.rng.pick(rng, weights), n, names, weights)
def layout.strings.repeat(+n: U32, +s: String) -> List<&2, String>:
  layout.strings.repeat.k1(U32.is_eq(n, 0), n, s)

def layout.strings.repeat.k1(cv: Bool, +n: U32, +s: String) -> List<&2, String>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      Con{s, layout.strings.repeat((n - 1 : U32), s)}
# The roster a kind of room starts with (before the dedupe), drawing as Rust does.
def layout.furnish.roster(+kind: String, +pack: String, +depth: U32, +foes: U32, +company: U32, +rng: W.W) -> List<&2, String> & W.W:
  layout.furnish.roster.k1(String.eq(kind, "start"), kind, pack, depth, foes, company, rng)

def layout.furnish.roster.k4(pr: W.W & U32) -> List<&2, String> & W.W:
  (+rng1, +n) = pr
  (layout.strings.repeat(n, "bat"), rng1)

def layout.furnish.roster.k8(cv: Bool, +kind: String, +pack: String, +depth: U32, +foes: U32, +rng: W.W) -> List<&2, String> & W.W:
  match cv:
    case True{}:
      +ros = layout.Pack.roster_at(pack, depth)
      layout.roster.picks((foes + 1 : U32), layout.roster.names(ros), layout.roster.weights(ros), rng)
    case False{}:
      (Nil{}, rng)

def layout.furnish.roster.k7(cv: Bool, +kind: String, +pack: String, +depth: U32, +foes: U32, +company: U32, +rng: W.W) -> List<&2, String> & W.W:
  match cv:
    case True{}:
      +ros = layout.Pack.roster_at(pack, depth)
      layout.roster.picks((foes + company : U32), layout.roster.names(ros), layout.roster.weights(ros), rng)
    case False{}:
      layout.furnish.roster.k8(String.eq(kind, "stairs"), kind, pack, depth, foes, rng)

def layout.furnish.roster.k6(cv: Bool, +kind: String, +pack: String, +depth: U32, +foes: U32, +company: U32, +rng: W.W) -> List<&2, String> & W.W:
  match cv:
    case True{}:
      (["wraith", "wraith", "slime"], rng)
    case False{}:
      layout.furnish.roster.k7(String.eq(kind, "fight"), kind, pack, depth, foes, company, rng)

def layout.furnish.roster.k5(cv: Bool, +kind: String, +pack: String, +depth: U32, +foes: U32, +company: U32, +rng: W.W) -> List<&2, String> & W.W:
  match cv:
    case True{}:
      (["dragon", "imp", "imp"], rng)
    case False{}:
      layout.furnish.roster.k6(String.eq(kind, "threshold"), kind, pack, depth, foes, company, rng)

def layout.furnish.roster.k3(cv: Bool, +kind: String, +pack: String, +depth: U32, +foes: U32, +company: U32, +rng: W.W) -> List<&2, String> & W.W:
  match cv:
    case True{}:
      layout.furnish.roster.k4(layout.rng.below(rng, 3))
    case False{}:
      layout.furnish.roster.k5(String.eq(kind, "lair"), kind, pack, depth, foes, company, rng)

def layout.furnish.roster.k2(cv: Bool, +kind: String, +pack: String, +depth: U32, +foes: U32, +company: U32, +rng: W.W) -> List<&2, String> & W.W:
  match cv:
    case True{}:
      (["pit_tyrant"], rng)
    case False{}:
      layout.furnish.roster.k3(String.eq(kind, "hall"), kind, pack, depth, foes, company, rng)

def layout.furnish.roster.k1(cv: Bool, +kind: String, +pack: String, +depth: U32, +foes: U32, +company: U32, +rng: W.W) -> List<&2, String> & W.W:
  match cv:
    case True{}:
      (Bool.pick(List<&2, String>, String.eq(pack, "swamp"), ["leech", "leech"], ["skeleton", "skeleton"]), rng)
    case False{}:
      layout.furnish.roster.k2(String.eq(kind, "pit"), kind, pack, depth, foes, company, rng)
# One of each dangerous kind a room, and only so many kinds.
def layout.furnish.dedupe(+roster: List<&2, String>, +plain: String, +seen: List<&2, String>, +limit: U32) -> List<&2, String>:
  layout.furnish.dedupe.k1(roster, roster, plain, seen, limit)

def layout.furnish.dedupe.k3(cv: Bool, +plain: String, +seen: List<&2, String>, +limit: U32, +h: String, +t: List<&2, String>) -> List<&2, String>:
  match cv:
    case True{}:
      Con{plain, layout.furnish.dedupe(t, plain, seen, limit)}
    case False{}:
      Con{h, layout.furnish.dedupe(t, plain, List.append(&2, String, seen, [h]), limit)}

def layout.furnish.dedupe.k2(cv: Bool, +plain: String, +seen: List<&2, String>, +limit: U32, +h: String, +t: List<&2, String>) -> List<&2, String>:
  match cv:
    case True{}:
      layout.furnish.dedupe.k3(Bool.or(layout.strings.has(seen, h), U32.is_ge(layout.strings.len(seen), limit)), plain, seen, limit, h, t)
    case False{}:
      Con{h, layout.furnish.dedupe(t, plain, seen, limit)}

def layout.furnish.dedupe.k1(sv0: List<&2, String>, +roster: List<&2, String>, +plain: String, +seen: List<&2, String>, +limit: U32) -> List<&2, String>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      layout.furnish.dedupe.k2(layout.elite(h), plain, seen, limit, h, t)
# The roster's critters that are not elite.
def layout.furnish.plains(+ros: List<&2, String>) -> List<&2, String>:
  layout.furnish.plains.k1(ros, ros)

def layout.furnish.plains.k2(cv: Bool, +h: String, +t: List<&2, String>) -> List<&2, String>:
  match cv:
    case True{}:
      Con{h, layout.furnish.plains(t)}
    case False{}:
      layout.furnish.plains(t)

def layout.furnish.plains.k1(sv0: List<&2, String>, +ros: List<&2, String>) -> List<&2, String>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      layout.furnish.plains.k2(Bool.and(layout.critter(h), Bool.not(layout.elite(h))), h, t)
def layout.furnish.extra(+roster: List<&2, String>, +kind: String, +pack: String, +depth: U32, +cell: LayCell) -> List<&2, String>:
  layout.furnish.extra.k1(String.eq(kind, "fight"), roster, kind, pack, depth, cell)

def layout.furnish.extra.k3(pr: LayCell, +roster: List<&2, String>, +depth: U32, +plain: List<&2, String>) -> List<&2, String>:
  match pr:
    case LayCell{+cx, +cy}:
      +h = layout.mix(W.add(W.add(W.add(W.mul(W.of_u32(depth), W.of_u32(131)), W.mul(layout.sext(cx), W.of_u32(17))), W.mul(layout.sext(cy), W.of_u32(5))), W.of_u32(7)))
      List.append(&2, String, roster, [layout.strings.nth(plain, W.rem_u32(h, layout.strings.len(plain)))])

def layout.furnish.extra.k2(cv: Bool, +roster: List<&2, String>, +depth: U32, +cell: LayCell, +plain: List<&2, String>) -> List<&2, String>:
  match cv:
    case True{}:
      roster
    case False{}:
      layout.furnish.extra.k3(cell, roster, depth, plain)

def layout.furnish.extra.k1(cv: Bool, +roster: List<&2, String>, +kind: String, +pack: String, +depth: U32, +cell: LayCell) -> List<&2, String>:
  match cv:
    case True{}:
      +plain = layout.furnish.plains(layout.roster.names(layout.Pack.roster_at(pack, depth)))
      layout.furnish.extra.k2(U32.is_eq(layout.strings.len(plain), 0), roster, depth, cell, plain)
    case False{}:
      roster
def layout.roster_json(+xs: List<&2, String>) -> J.Val:
  J.JA{layout.roster_json.go(xs)}
def layout.roster_json.go(+xs: List<&2, String>) -> List<&2, J.Val>:
  layout.roster_json.go.k1(xs, xs)

def layout.roster_json.go.k1(sv0: List<&2, String>, +xs: List<&2, String>) -> List<&2, J.Val>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      Con{J.JS{h}, layout.roster_json.go(t)}
# A room as its serde object.
def layout.room_json(+cell: LayCell, +kind: String, +doors: J.Val, +cols: U32, +rows: U32, +tiles: String, +visited: Bool, +cleared: Bool, +roster: J.Val, +laid: J.Val) -> J.Val:
  layout.room_json.k1(cell, kind, doors, cols, rows, tiles, visited, cleared, roster, laid)

def layout.room_json.k1(pr: LayCell, +kind: String, +doors: J.Val, +cols: U32, +rows: U32, +tiles: String, +visited: Bool, +cleared: Bool, +roster: J.Val, +laid: J.Val) -> J.Val:
  match pr:
    case LayCell{+cx, +cy}:
      +r0 = J.set(J.obj(), "cell", J.JA{[J.of_i32(cx), J.of_i32(cy)]})
      +r1 = J.set(J.set(J.set(r0, "kind", J.JS{kind}), "doors", doors), "cols", J.JU{cols})
      +r2 = J.set(J.set(J.set(r1, "rows", J.JU{rows}), "tiles", J.JS{tiles}), "visited", J.JBool{visited})
      +r3 = J.set(J.set(J.set(r2, "cleared", J.JBool{cleared}), "roster", roster), "items", J.JA{Nil{}})
      +r4 = J.set(r3, "chest", J.JNull{})
      Bool.pick(J.Val, J.is_null(laid), r4, J.set(r4, "laid", laid))
# Whether a room of the doors J array has door `i`.
def layout.doors_at(+doors: J.Val, +i: U32) -> Bool:
  J.bool(J.nth(doors, i))
# The room of `kind` at its size (cols, rows) (laid at `laid`, holding
# `company` more for a great hall): stone from `template` (or a great
# quadrant), fixtures and company.
def layout.furnish(+cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +template: LayGrid, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +company: U32, +rng: W.W) -> J.Val & W.W:
  layout.furnish.k1(layout.furnish.quadrant(cell, kind, depth, pack, template, cols, rows, rng), cell, kind, doors, depth, pack, cols, rows, lcols, lrows, company)

def layout.furnish.k1(pr: LayGrid & W.W, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +company: U32) -> J.Val & W.W:
  (+quad0, +rng1) = pr
  layout.furnish.build(cell, kind, doors, depth, pack, quad0, cols, rows, lcols, lrows, company, rng1)
# The room's quadrant: the template at a screen's size, else a dungeon
# master's hall most of the time, else the pillared grid; scattered boulders
# and the swamp's mire on top.
def layout.furnish.quadrant(+cell: LayCell, +kind: String, +depth: U32, +pack: String, +template: LayGrid, +cols: U32, +rows: U32, +rng: W.W) -> LayGrid & W.W:
  layout.furnish.quadrant.k1(layout.furnish.base(kind, pack, template, cols, rows, rng), cell, kind, depth, pack, cols)

def layout.furnish.quadrant.k2(pr: LayGrid & W.W, +cell: LayCell, +kind: String, +depth: U32, +pack: String) -> LayGrid & W.W:
  (+q2, +rng2) = pr
  (Bool.pick(LayGrid, Bool.and(String.eq(pack, "swamp"), layout.fight_or_stairs(kind)), layout.swamp.mire(q2, depth, layout.swamp.salt(cell, depth)), q2), rng2)

def layout.furnish.quadrant.k1(pr: LayGrid & W.W, +cell: LayCell, +kind: String, +depth: U32, +pack: String, +cols: U32) -> LayGrid & W.W:
  (+q, +rng1) = pr
  layout.furnish.quadrant.k2(layout.furnish.scatter(q, kind, pack, cols, rng1), cell, kind, depth, pack)
def layout.furnish.base(+kind: String, +pack: String, +template: LayGrid, +cols: U32, +rows: U32, +rng: W.W) -> LayGrid & W.W:
  layout.furnish.base.k1(Bool.and(U32.is_eq(cols, 24), U32.is_eq(rows, 14)), kind, pack, template, cols, rows, rng)

def layout.furnish.base.k1(cv: Bool, +kind: String, +pack: String, +template: LayGrid, +cols: U32, +rows: U32, +rng: W.W) -> LayGrid & W.W:
  match cv:
    case True{}:
      (template, rng)
    case False{}:
      +w = (layout.half(cols) - 1 : U32)
      +h = (layout.half(rows) - 1 : U32)
      +authored = Bool.pick(List<&2, List<&2, String>>, layout.fight_or_stairs(kind), layout.rooms.great(layout.pack_index(pack), w, h), Nil{})
      layout.furnish.base.authored(authored, kind, w, h, rng)
def layout.furnish.base.authored(+authored: List<&2, List<&2, String>>, +kind: String, +w: U32, +h: U32, +rng: W.W) -> LayGrid & W.W:
  layout.furnish.base.authored.k1(U32.is_eq(layout.quads.len(authored), 0), authored, kind, w, h, rng)

def layout.furnish.base.authored.k4(pr: W.W & U32, +authored: List<&2, List<&2, String>>) -> LayGrid & W.W:
  (+rng2, +i) = pr
  (layout.quad.of_rows(layout.quads.nth(authored, i)), rng2)

def layout.furnish.base.authored.k3(cv: Bool, +authored: List<&2, List<&2, String>>, +kind: String, +w: U32, +h: U32, +rng1: W.W, +hit: Bool) -> LayGrid & W.W:
  match cv:
    case True{}:
      layout.furnish.base.authored.k4(layout.rng.below(rng1, layout.quads.len(authored)), authored)
    case False{}:
      layout.great_quadrant(w, h, kind, rng1)

def layout.furnish.base.authored.k2(pr: W.W & Bool, +authored: List<&2, List<&2, String>>, +kind: String, +w: U32, +h: U32) -> LayGrid & W.W:
  (+rng1, +hit) = pr
  layout.furnish.base.authored.k3(hit, authored, kind, w, h, rng1, hit)

def layout.furnish.base.authored.k1(cv: Bool, +authored: List<&2, List<&2, String>>, +kind: String, +w: U32, +h: U32, +rng: W.W) -> LayGrid & W.W:
  match cv:
    case True{}:
      layout.great_quadrant(w, h, kind, rng)
    case False{}:
      layout.furnish.base.authored.k2(layout.rng.chance(rng, layout.rooms.authored_share()), authored, kind, w, h)
# `pack.scatter()` loose boulders at a screen's size.
def layout.Pack.scatter(+pack: String) -> U32:
  layout.Pack.scatter.k1(Bool.or(String.eq(pack, "cavern"), String.eq(pack, "fungal")), pack)

def layout.Pack.scatter.k1(cv: Bool, +pack: String) -> U32:
  match cv:
    case True{}:
      4
    case False{}:
      Bool.pick(U32, String.eq(pack, "swamp"), 2, 0)
def layout.furnish.scatter(+q: LayGrid, +kind: String, +pack: String, +cols: U32, +rng: W.W) -> LayGrid & W.W:
  layout.furnish.scatter.k1(Bool.and(layout.fight_or_stairs(kind), U32.is_eq(cols, 24)), q, kind, pack, cols, rng)

def layout.furnish.scatter.k1(cv: Bool, +q: LayGrid, +kind: String, +pack: String, +cols: U32, +rng: W.W) -> LayGrid & W.W:
  match cv:
    case True{}:
      layout.furnish.scatter.go(q, layout.Pack.scatter(pack), rng)
    case False{}:
      (q, rng)
def layout.furnish.scatter.go(+q: LayGrid, +n: U32, +rng: W.W) -> LayGrid & W.W:
  layout.furnish.scatter.go.k1(U32.is_eq(n, 0), q, n, rng)

def layout.furnish.scatter.go.k3(pr: W.W & U32, +q: LayGrid, +n: U32, +a: U32) -> LayGrid & W.W:
  (+rng2, +b) = pr
  layout.furnish.scatter.go(layout.grid.set(q, (1 + a : U32), (1 + b : U32), TileBlock{}), (n - 1 : U32), rng2)

def layout.furnish.scatter.go.k2(pr: W.W & U32, +q: LayGrid, +n: U32) -> LayGrid & W.W:
  (+rng1, +a) = pr
  layout.furnish.scatter.go.k3(layout.rng.below(rng1, 4), q, n, a)

def layout.furnish.scatter.go.k1(cv: Bool, +q: LayGrid, +n: U32, +rng: W.W) -> LayGrid & W.W:
  match cv:
    case True{}:
      (q, rng)
    case False{}:
      layout.furnish.scatter.go.k2(layout.rng.below(rng, 8), q, n)
# Mirror the quadrant, rebuild open if a doorway is cut off, set the fixtures,
# the company and the dedupe.
def layout.furnish.build(+cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +quad: LayGrid, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +company: U32, +rng: W.W) -> J.Val & W.W:
  +g0 = layout.mirror(cols, rows, doors, quad)
  +open = layout.grid.new((layout.half(cols) - 1 : U32), (layout.half(rows) - 1 : U32), TileFloor{})
  +g1 = Bool.pick(LayGrid, layout.connected_grid(g0), g0, layout.mirror(cols, rows, doors, open))
  layout.furnish.fixtures(cell, kind, doors, depth, pack, g1, cols, rows, lcols, lrows, company, rng)
def layout.furnish.fixtures(+cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +g: LayGrid, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +company: U32, +rng: W.W) -> J.Val & W.W:
  layout.furnish.fixtures.k1(String.eq(kind, "stairs"), cell, kind, doors, depth, pack, g, cols, rows, lcols, lrows, company, rng)

def layout.furnish.fixtures.k3(pr: W.W & Bool, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +g: LayGrid, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +company: U32) -> J.Val & W.W:
  (+rng1, +narrow) = pr
  layout.furnish.company(cell, kind, doors, depth, pack, layout.furnish.hall(g, doors, Bool.pick(U32, narrow, 2, 3), cols, rows), cols, rows, lcols, lrows, company, rng1, J.JNull{})

def layout.furnish.fixtures.k5(cv: Bool, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +g: LayGrid, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +company: U32, +rng: W.W) -> J.Val & W.W:
  match cv:
    case True{}:
      layout.furnish.company(cell, kind, doors, depth, pack, g, cols, rows, lcols, lrows, company, rng, layout.chest_json(cols, rows))
    case False{}:
      layout.furnish.company(cell, kind, doors, depth, pack, g, cols, rows, lcols, lrows, company, rng, J.JNull{})

def layout.furnish.fixtures.k4(cv: Bool, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +g: LayGrid, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +company: U32, +rng: W.W) -> J.Val & W.W:
  match cv:
    case True{}:
      layout.furnish.company(cell, kind, doors, depth, pack, layout.furnish.threshold(g, doors, cols), cols, rows, lcols, lrows, company, rng, J.JNull{})
    case False{}:
      layout.furnish.fixtures.k5(String.eq(kind, "treasure"), cell, kind, doors, depth, pack, g, cols, rows, lcols, lrows, company, rng)

def layout.furnish.fixtures.k2(cv: Bool, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +g: LayGrid, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +company: U32, +rng: W.W) -> J.Val & W.W:
  match cv:
    case True{}:
      layout.furnish.fixtures.k3(layout.rng.chance(rng, 50), cell, kind, doors, depth, pack, g, cols, rows, lcols, lrows, company)
    case False{}:
      layout.furnish.fixtures.k4(String.eq(kind, "threshold"), cell, kind, doors, depth, pack, g, cols, rows, lcols, lrows, company, rng)

def layout.furnish.fixtures.k1(cv: Bool, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +g: LayGrid, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +company: U32, +rng: W.W) -> J.Val & W.W:
  match cv:
    case True{}:
      layout.furnish.company(cell, kind, doors, depth, pack, layout.furnish.stairs(g, pack, depth, cols, rows), cols, rows, lcols, lrows, company, rng, J.JNull{})
    case False{}:
      layout.furnish.fixtures.k2(String.eq(kind, "hall"), cell, kind, doors, depth, pack, g, cols, rows, lcols, lrows, company, rng)
# The chest in the middle of a treasure room.
def layout.chest_json(+cols: U32, +rows: U32) -> J.Val:
  +c0 = J.set(J.obj(), "x", J.JF{(layout.width_of(cols) / 2.0 : F32)})
  +c1 = J.set(c0, "y", J.JF{(layout.width_of(rows) / 2.0 : F32)})
  J.set(c1, "open", J.JBool{False{}})
# A size in tiles as arena units.
def layout.width_of(+n: U32) -> F32:
  (U32.to_f32(n) * 2.0 : F32)
# The stairs room's four stairs tiles (none on the swamp's last floor).
def layout.furnish.stairs(+g: LayGrid, +pack: String, +depth: U32, +cols: U32, +rows: U32) -> LayGrid:
  layout.furnish.stairs.k1(Bool.and(String.eq(pack, "swamp"), U32.is_ge(depth, 3)), g, pack, depth, cols, rows)

def layout.furnish.stairs.k1(cv: Bool, +g: LayGrid, +pack: String, +depth: U32, +cols: U32, +rows: U32) -> LayGrid:
  match cv:
    case True{}:
      g
    case False{}:
      +c = (layout.half(cols) - 1 : U32)
      +r = (layout.half(rows) - 1 : U32)
      +g1 = layout.grid.set(g, c, r, TileStairs{})
      +g2 = layout.grid.set(g1, (c + 1 : U32), r, TileStairs{})
      +g3 = layout.grid.set(g2, c, (r + 1 : U32), TileStairs{})
      layout.grid.set(g3, (c + 1 : U32), (r + 1 : U32), TileStairs{})
# A hall: stone everywhere but the passages from each doorway to a hub.
def layout.furnish.hall(+g: LayGrid, +doors: J.Val, +wide: U32, +cols: U32, +rows: U32) -> LayGrid:
  layout.furnish.hall.rows(g, doors, wide, cols, rows, layout.half(cols), layout.half(rows), 1, 1)
def layout.furnish.hall.rows(+g: LayGrid, +doors: J.Val, +wide: U32, +cols: U32, +rows: U32, +mc: U32, +mr: U32, +row: U32, +col: U32) -> LayGrid:
  layout.furnish.hall.rows.k1(U32.is_ge(row, (rows - 1 : U32)), g, doors, wide, cols, rows, mc, mr, row, col)

def layout.furnish.hall.rows.k2(cv: Bool, +g: LayGrid, +doors: J.Val, +wide: U32, +cols: U32, +rows: U32, +mc: U32, +mr: U32, +row: U32, +col: U32) -> LayGrid:
  match cv:
    case True{}:
      layout.furnish.hall.rows(g, doors, wide, cols, rows, mc, mr, (row + 1 : U32), 1)
    case False{}:
      layout.furnish.hall.rows(layout.furnish.hall.cell(g, doors, wide, mc, mr, row, col), doors, wide, cols, rows, mc, mr, row, (col + 1 : U32))

def layout.furnish.hall.rows.k1(cv: Bool, +g: LayGrid, +doors: J.Val, +wide: U32, +cols: U32, +rows: U32, +mc: U32, +mr: U32, +row: U32, +col: U32) -> LayGrid:
  match cv:
    case True{}:
      g
    case False{}:
      layout.furnish.hall.rows.k2(U32.is_ge(col, (cols - 1 : U32)), g, doors, wide, cols, rows, mc, mr, row, col)
def layout.furnish.hall.cell(+g: LayGrid, +doors: J.Val, +wide: U32, +mc: U32, +mr: U32, +row: U32, +col: U32) -> LayGrid:
  +dc = layout.absdiff(col, mc)
  +dr = layout.absdiff(row, mr)
  +hub = Bool.and(U32.is_le(dc, (wide + 1 : U32)), U32.is_le(dr, wide))
  +across = Bool.or(U32.is_lt(dc, wide), U32.is_eq(col, (mc - wide : U32)))
  +along = Bool.or(U32.is_lt(dr, wide), U32.is_eq(row, (mr - wide : U32)))
  +lane = Bool.or(Bool.or(Bool.and(Bool.and(layout.doors_at(doors, 0), across), U32.is_le(row, mr)), Bool.and(Bool.and(layout.doors_at(doors, 2), across), U32.is_ge(row, mr))), Bool.or(Bool.and(Bool.and(layout.doors_at(doors, 1), along), U32.is_ge(col, mc)), Bool.and(Bool.and(layout.doors_at(doors, 3), along), U32.is_le(col, mc))))
  Bool.pick(LayGrid, Bool.or(hub, lane), g, layout.grid.set(g, col, row, TileWall{}))
# The Shoggoth fills the north of its hall: stone to feet and shots alike,
# but for a doorway's lane.
def layout.furnish.threshold(+g: LayGrid, +doors: J.Val, +cols: U32) -> LayGrid:
  layout.furnish.threshold.rows(g, doors, cols, 1)
def layout.furnish.threshold.rows(+g: LayGrid, +doors: J.Val, +cols: U32, +row: U32) -> LayGrid:
  layout.furnish.threshold.rows.k1(U32.is_gt(row, 3), g, doors, cols, row)

def layout.furnish.threshold.rows.k1(cv: Bool, +g: LayGrid, +doors: J.Val, +cols: U32, +row: U32) -> LayGrid:
  match cv:
    case True{}:
      g
    case False{}:
      layout.furnish.threshold.rows(layout.furnish.threshold.cols(g, doors, cols, row, 1), doors, cols, (row + 1 : U32))
def layout.furnish.threshold.cols(+g: LayGrid, +doors: J.Val, +cols: U32, +row: U32, +col: U32) -> LayGrid:
  layout.furnish.threshold.cols.k1(U32.is_ge(col, (cols - 1 : U32)), g, doors, cols, row, col)

def layout.furnish.threshold.cols.k1(cv: Bool, +g: LayGrid, +doors: J.Val, +cols: U32, +row: U32, +col: U32) -> LayGrid:
  match cv:
    case True{}:
      g
    case False{}:
      +lane = Bool.and(layout.doors_at(doors, 0), Bool.or(U32.is_eq(col, (layout.half(cols) - 1 : U32)), U32.is_eq(col, layout.half(cols))))
      layout.furnish.threshold.cols(Bool.pick(LayGrid, lane, g, layout.grid.set(g, col, row, TileBlock{})), doors, cols, row, (col + 1 : U32))
# The foes a room holds, deduped and with its extra plain one, and the room.
def layout.furnish.company(+cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +g: LayGrid, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +company: U32, +rng: W.W, +chest: J.Val) -> J.Val & W.W:
  layout.furnish.company.k1(layout.rng.below(rng, 2), cell, kind, doors, depth, pack, g, cols, rows, lcols, lrows, company, chest)

def layout.furnish.company.k2(pr: List<&2, String> & W.W, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +g: LayGrid, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +chest: J.Val) -> J.Val & W.W:
  (+roster0, +rng2) = pr
  +plain = layout.Pack.plain_at(pack, depth)
  +roster1 = layout.furnish.dedupe(roster0, plain, Nil{}, layout.Pack.dangers_at(depth))
  +roster2 = layout.furnish.extra(roster1, kind, pack, depth, cell)
  +laid = Bool.pick(J.Val, Bool.and(U32.is_eq(cols, lcols), U32.is_eq(rows, lrows)), J.JNull{}, J.JA{[J.JU{lcols}, J.JU{lrows}]})
  +room = layout.room_json(cell, kind, doors, cols, rows, layout.grid.rle(g), False{}, Bool.or(String.eq(kind, "treasure"), String.eq(kind, "sanctuary")), layout.roster_json(roster2), laid)
  (J.set(room, "chest", chest), rng2)

def layout.furnish.company.k1(pr: W.W & U32, +cell: LayCell, +kind: String, +doors: J.Val, +depth: U32, +pack: String, +g: LayGrid, +cols: U32, +rows: U32, +lcols: U32, +lrows: U32, +company: U32, +chest: J.Val) -> J.Val & W.W:
  (+rng1, +extra) = pr
  +foes = U32.min((2 + U32.min(depth, 3) + extra : U32), 6)
  layout.furnish.company.k2(layout.furnish.roster(kind, pack, depth, foes, company, rng1), cell, kind, doors, depth, pack, g, cols, rows, lcols, lrows, chest)
