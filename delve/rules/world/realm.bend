def case.realm.Spoil.info(+input: J.Val) -> J.Val:
  +s = J.str(J.get(input, "spoil"))
  +o1 = J.set(J.obj(), "source", J.JS{realm.Spoil.source(s)})
  J.set(o1, "worth", J.JU{realm.Spoil.worth(s)})
