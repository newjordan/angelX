def realm.j.maybe_str(+m: Maybe<&2, String>) -> J.Val:
  realm.j.maybe_str.k1(m, m)

def realm.j.maybe_str.k1(sv0: Maybe<&2, String>, +m: Maybe<&2, String>) -> J.Val:
