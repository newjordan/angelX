# generated by bx.py from race3d.bx: edit the .bx, not this file
# crates/delve/src/rules/race3d.rs and race3d/drift.rs — the 3D races: the Shaft Run (a rolling ball), the Ore Cart,
# the Griffin Run (flight over the gorge) and the Torchlight Touge (drifting). Course is "Shaft" | "Cart" | "Griffin" |
# "Touge" (no rename); Wreck is "None" | "Fall" | "Bonk" | "Buffer" | "Gap" | "Timber" | "Tumble" | "SpinOut".

def race3d.TITLE() -> U32:
  (3 * rules.HZ() : U32)
def race3d.RACE_TIME() -> U32:
  (90 * rules.HZ() : U32)
def race3d.PODIUM() -> U32:
  (6 * rules.HZ() : U32)
def race3d.CRASH() -> U32:
  45
def race3d.HAUL_GOLD() -> U32:
  2
def race3d.LANES(+i: U32) -> F32:
  gc.nth_f([F32.neg(1.7), 0.0, 1.7], i)
def race3d.BOLT_PACE() -> F32:
  32.0
def race3d.BOLT_LIFE() -> U32:
  24
def race3d.BOLT_REST() -> U32:
  10
def race3d.BURST() -> U32:
  45
def race3d.ROLL() -> U32:
  18
def race3d.ROLL_REST() -> U32:
  45
def race3d.ROT() -> U32:
  (1 * rules.HZ() : U32)
def race3d.DRIFT_LAPS() -> U32:
  3
def race3d.DRIFT_RACE_TIME() -> U32:
  (300 * rules.HZ() : U32)
def race3d.SEAM_FUNNEL() -> F32:
  5.0
