# fn knight_racers_showing(&self)
def knight_racers.Run.knight_racers_showing(+run: J.Val) -> Bool:
  Bool.and(String.eq(J.str(J.get(rules.Run.room(run), "kind")), "forest"), Bool.not(J.is_null(J.get(run, "knight_racers"))))
# pub fn start_knight_racers(&mut self)
def knight_racers.Run.start_knight_racers(+run: J.Val) -> J.Val:
  knight_racers.Run.start_knight_racers.k1(String.eq(J.str(J.get(rules.Run.room(run), "kind")), "forest"), run)

def knight_racers.Run.start_knight_racers.k1(cv: Bool, +run: J.Val) -> J.Val:
  match cv:
    case True{}:
      +r1 = J.set(run, "forest", forest.Forest.leave(J.get(run, "forest")))
      +r2 = J.set(r1, "knight_racers", knight_racers.Session.new(J.get(r1, "players")))
      gc.found(r2, 0, "Knight Racer: arrows/WASD drive, Space boosts. Hold Esc to leave; E after the flag to race again.")
    case False{}:
      run
# fn tick_knight_racers(&mut self, inputs)
def knight_racers.Run.tick_knight_racers(+run: J.Val, +inputs: J.Val) -> J.Val:
  knight_racers.Run.tick_knight_racers.k1(J.is_null(J.get(run, "knight_racers")), run, inputs)

def knight_racers.Run.tick_knight_racers.k1(cv: Bool, +run: J.Val, +inputs: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +ids = gc.ids_outside(J.get(run, "players"), J.get(J.get(run, "exits"), "outside"))
      +s1 = knight_racers.Session.join_ids(J.get(run, "knight_racers"), ids)
      J.set(run, "knight_racers", knight_racers.Session.step(s1, inputs))
