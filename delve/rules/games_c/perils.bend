def perils.any_weight(+ws: List<&2, U32>) -> Bool:
  perils.any_weight.k1(ws, ws)

def perils.any_weight.k1(sv0: List<&2, U32>, +ws: List<&2, U32>) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+h, +t}:
      Bool.or(U32.is_gt(h, 0), perils.any_weight(t))
# fn arm_perils(&mut self)
def perils.Run.arm_perils(+run: J.Val) -> J.Val:
  +r1 = J.set(run, "works", J.set(J.get(run, "works"), "perils", J.JA{Nil{}}))
  +depth = gc.u(J.get(r1, "dungeon"), "depth")
  +room = rules.Run.room(r1)
  +kind = J.str(J.get(room, "kind"))
  +roomy = Bool.or(String.eq(kind, "fight"), Bool.or(String.eq(kind, "hall"), Bool.or(String.eq(kind, "stairs"), String.eq(kind, "lair"))))
  perils.Run.arm_perils.k1(Bool.or(U32.is_zero(depth), Bool.or(ledge.Run.side_on(r1), Bool.or(Bool.not(roomy), Bool.or(String.eq(gc.s(r1, "mode"), "gauntlet"), identity.Run.simple_creation(r1))))), r1, depth, room, kind, roomy)

def perils.Run.arm_perils.k1(cv: Bool, +r1: J.Val, +depth: U32, +room: J.Val, +kind: String, +roomy: Bool) -> J.Val:
  match cv:
    case True{}:
      r1
    case False{}:
      perils.arm.go(r1, room, kind, depth, gc.ssub(gc.umin(depth, 3), 1))
def perils.arm.go(+run: J.Val, +room: J.Val, +kind: String, +depth: U32, +tier: U32) -> J.Val:
  +seed = W.xor(W.xor(W.xor(W.xor(W.of_j(J.get(run, "seed")), W.rotl(W.of_j(J.get(run, "raid_id")), 13)), W.shl(W.of_u32(depth), 40)), W.shl(W.of_u32(gc.u(run, "at")), 24)), W.of_u32(40337))
  +rng = loot.Rng.new(rules.mix(seed))
  +odds = gc.pu(Bool.and(Bool.or(String.eq(kind, "stairs"), String.eq(kind, "lair")), U32.is_lt(depth, 3)), 0, gc.pu(String.eq(kind, "hall"), U32.div(perils.ODDS(tier), 2), perils.ODDS(tier)))
  +c1 = loot.Rng.chance(rng, odds)
  perils.arm.go.k1(c1, run, room, depth, tier)

def perils.arm.go.k2(cv: Bool, +run: J.Val, +room: J.Val, +depth: U32, +tier: U32, +rng1: W.W, +hit: Bool) -> J.Val:
  match cv:
    case True{}:
      perils.arm.count(run, room, depth, tier, rng1)
    case False{}:
      run

def perils.arm.go.k1(pr: W.W & Bool, +run: J.Val, +room: J.Val, +depth: U32, +tier: U32) -> J.Val:
  (+rng1, +hit) = pr
  perils.arm.go.k2(hit, run, room, depth, tier, rng1, hit)
# count = 1 + (MOST > 1 && chance(40)) + (depth >= 5 && chance(35))
def perils.arm.count(+run: J.Val, +room: J.Val, +depth: U32, +tier: U32, +rng: W.W) -> J.Val:
  perils.arm.count.k1(U32.is_gt(perils.MOST(tier), 1), run, room, depth, tier, rng)

def perils.arm.count.k2(pr: W.W & Bool, +run: J.Val, +room: J.Val, +depth: U32) -> J.Val:
  (+rng1, +hit) = pr
  perils.arm.count2(run, room, depth, rng1, gc.pu(hit, 2, 1))

def perils.arm.count.k1(cv: Bool, +run: J.Val, +room: J.Val, +depth: U32, +tier: U32, +rng: W.W) -> J.Val:
  match cv:
    case True{}:
      +c = loot.Rng.chance(rng, 40)
      perils.arm.count.k2(c, run, room, depth)
    case False{}:
      perils.arm.count2(run, room, depth, rng, 1)
def perils.arm.count2(+run: J.Val, +room: J.Val, +depth: U32, +rng: W.W, +n: U32) -> J.Val:
  perils.arm.count2.k1(U32.is_ge(depth, 5), run, room, depth, rng, n)

def perils.arm.count2.k2(pr: W.W & Bool, +run: J.Val, +room: J.Val, +depth: U32, +n: U32) -> J.Val:
  (+rng1, +hit) = pr
  perils.arm.lay(run, room, depth, rng1, gc.pu(hit, (n + 1 : U32), n))

def perils.arm.count2.k1(cv: Bool, +run: J.Val, +room: J.Val, +depth: U32, +rng: W.W, +n: U32) -> J.Val:
  match cv:
    case True{}:
      +c = loot.Rng.chance(rng, 35)
      perils.arm.count2.k2(c, run, room, depth, n)
    case False{}:
      perils.arm.lay(run, room, depth, rng, n)
def perils.arm.lay(+run: J.Val, +room: J.Val, +depth: U32, +rng: W.W, +count: U32) -> J.Val:
  +pack = gc.s(J.get(run, "dungeon"), "pack")
  +ws = perils.menu.weights(pack, depth)
  perils.arm.lay.k1(Bool.not(perils.any_weight(ws)), run, room, rng, count, pack, ws)

def perils.arm.lay.k1(cv: Bool, +run: J.Val, +room: J.Val, +rng: W.W, +count: U32, +pack: String, +ws: List<&2, U32>) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +doors = perils.doors(room, 0)
      +laid = perils.lay.each(gc.umin(count, 3), room, doors, perils.menu.kinds(pack), ws, rng, J.JA{Nil{}})
      J.set(run, "works", J.set(J.get(run, "works"), "perils", laid))
# the doorway points of the room's open doors, sides 0..4
def perils.pt(+p: F32 & F32) -> GcPt:
  perils.pt.k1(p)

def perils.pt.k1(pr: F32 & F32) -> GcPt:
  (+x, +y) = pr
  GcPt{x, y}
def perils.doors(+room: J.Val, +d: U32) -> List<&2, GcPt>:
  perils.doors.k1(U32.is_ge(d, 4), room, d)

def perils.doors.k2(cv: Bool, +room: J.Val, +d: U32) -> List<&2, GcPt>:
  match cv:
    case True{}:
      perils.pt(hazards.doorway.at(room, d)) <> perils.doors(room, (d + 1 : U32))
    case False{}:
      perils.doors(room, (d + 1 : U32))

def perils.doors.k1(cv: Bool, +room: J.Val, +d: U32) -> List<&2, GcPt>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      perils.doors.k2(J.bool(J.nth(J.get(room, "doors"), d)), room, d)
# for _ in 0..count: pick a kind, then up to 40 tries to lay it.
def perils.lay.each(+n: U32, +room: J.Val, +doors: List<&2, GcPt>, +kinds: List<&2, U32>, +ws: List<&2, U32>, +rng: W.W, +laid: J.Val) -> J.Val:
  perils.lay.each.k1(U32.is_zero(n), n, room, doors, kinds, ws, rng, laid)

def perils.lay.each.k3(pr: W.W & J.Val, +n: U32, +room: J.Val, +doors: List<&2, GcPt>, +kinds: List<&2, U32>, +ws: List<&2, U32>) -> J.Val:
  (+rng2, +laid2) = pr
  perils.lay.each((n - 1 : U32), room, doors, kinds, ws, rng2, laid2)

def perils.lay.each.k2(pr: W.W & U32, +n: U32, +room: J.Val, +doors: List<&2, GcPt>, +kinds: List<&2, U32>, +ws: List<&2, U32>, +laid: J.Val) -> J.Val:
  (+rng1, +idx) = pr
  +r = perils.lay.try(40, room, doors, gc.nth_u(kinds, idx), rng1, laid)
  perils.lay.each.k3(r, n, room, doors, kinds, ws)

def perils.lay.each.k1(cv: Bool, +n: U32, +room: J.Val, +doors: List<&2, GcPt>, +kinds: List<&2, U32>, +ws: List<&2, U32>, +rng: W.W, +laid: J.Val) -> J.Val:
  match cv:
    case True{}:
      laid
    case False{}:
      +p = loot.Rng.pick(rng, ws)
      perils.lay.each.k2(p, n, room, doors, kinds, ws, laid)
def perils.period_kind(+kind: U32) -> U32:
  gc.nth_u([150, 210, 240, 300], kind)
def perils.lay.try(+tries: U32, +room: J.Val, +doors: List<&2, GcPt>, +kind: U32, +rng: W.W, +laid: J.Val) -> W.W & J.Val:
  perils.lay.try.k1(U32.is_zero(tries), tries, room, doors, kind, rng, laid)

def perils.lay.try.k4(pr: W.W & Bool, +tries: U32, +room: J.Val, +doors: List<&2, GcPt>, +kind: U32, +laid: J.Val, +dc: U32, +dr: U32) -> W.W & J.Val:
  (+rng3, +across) = pr
  perils.lay.cell(tries, room, doors, kind, rng3, laid, (4 + dc : U32), (4 + dr : U32), across)

def perils.lay.try.k3(pr: W.W & U32, +tries: U32, +room: J.Val, +doors: List<&2, GcPt>, +kind: U32, +laid: J.Val, +dc: U32) -> W.W & J.Val:
  (+rng2, +dr) = pr
  +a = loot.Rng.chance(rng2, 50)
  perils.lay.try.k4(a, tries, room, doors, kind, laid, dc, dr)

def perils.lay.try.k2(pr: W.W & U32, +tries: U32, +room: J.Val, +doors: List<&2, GcPt>, +kind: U32, +laid: J.Val) -> W.W & J.Val:
  (+rng1, +dc) = pr
  +r = loot.Rng.below(rng1, gc.umax(gc.ssub(J.u32(J.get(room, "rows")), 8), 1))
  perils.lay.try.k3(r, tries, room, doors, kind, laid, dc)

def perils.lay.try.k1(cv: Bool, +tries: U32, +room: J.Val, +doors: List<&2, GcPt>, +kind: U32, +rng: W.W, +laid: J.Val) -> W.W & J.Val:
  match cv:
    case True{}:
      (rng, laid)
    case False{}:
      +c = loot.Rng.below(rng, gc.umax(gc.ssub(J.u32(J.get(room, "cols")), 8), 1))
      perils.lay.try.k2(c, tries, room, doors, kind, laid)
# The floor tiles a peril needs are all ground.
def perils.ground_all(+room: J.Val, +kind: U32, +col: U32, +row: U32, +across: Bool) -> Bool:
  perils.ground_all.k1(Bool.or(U32.is_eq(kind, 0), U32.is_eq(kind, 1)), room, kind, col, row, across)

def perils.ground_all.k3(cv: Bool, +room: J.Val, +col: U32, +row: U32, +across: Bool) -> Bool:
  match cv:
    case True{}:
      perils.ground_box(room, (col - 2 : U32), row, 5, 1)
    case False{}:
      perils.ground_box(room, col, (row - 2 : U32), 1, 5)

def perils.ground_all.k2(cv: Bool, +room: J.Val, +kind: U32, +col: U32, +row: U32, +across: Bool) -> Bool:
  match cv:
    case True{}:
      perils.ground_all.k3(across, room, col, row, across)
    case False{}:
      perils.ground_box(room, (col - 1 : U32), (row - 1 : U32), 2, 2)

def perils.ground_all.k1(cv: Bool, +room: J.Val, +kind: U32, +col: U32, +row: U32, +across: Bool) -> Bool:
  match cv:
    case True{}:
      perils.ground_box(room, (col - 1 : U32), (row - 1 : U32), 3, 3)
    case False{}:
      perils.ground_all.k2(U32.is_eq(kind, 2), room, kind, col, row, across)
def perils.ground_box(+room: J.Val, +c0: U32, +r0: U32, +w: U32, +h: U32) -> Bool:
  perils.ground_rows(room, c0, r0, w, (r0 + h : U32))
def perils.ground_rows(+room: J.Val, +c0: U32, +r: U32, +w: U32, +end: U32) -> Bool:
  perils.ground_rows.k1(U32.is_ge(r, end), room, c0, r, w, end)

def perils.ground_rows.k1(cv: Bool, +room: J.Val, +c0: U32, +r: U32, +w: U32, +end: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      Bool.and(perils.ground_cols(room, c0, r, w), perils.ground_rows(room, c0, (r + 1 : U32), w, end))
def perils.ground_cols(+room: J.Val, +c: U32, +r: U32, +w: U32) -> Bool:
  perils.ground_cols.k1(U32.is_zero(w), room, c, r, w)

def perils.ground_cols.k1(cv: Bool, +room: J.Val, +c: U32, +r: U32, +w: U32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      Bool.and(layout.Tile.ground(layout.Room.tile(room, c, r)), perils.ground_cols(room, (c + 1 : U32), r, (w - 1 : U32)))
def perils.lay.cell(+tries: U32, +room: J.Val, +doors: List<&2, GcPt>, +kind: U32, +rng: W.W, +laid: J.Val, +col: U32, +row: U32, +across: Bool) -> W.W & J.Val:
  +ux = ((RS.i_as_f32(col) + 0.5 : F32) * layout.TILE_UNITS() : F32)
  +uy = ((RS.i_as_f32(row) + 0.5 : F32) * layout.TILE_UNITS() : F32)
  +x = gc.pf(U32.is_eq(kind, 3), (RS.i_as_f32(col) * layout.TILE_UNITS() : F32), ux)
  +y = gc.pf(U32.is_eq(kind, 3), (RS.i_as_f32(row) * layout.TILE_UNITS() : F32), uy)
  +clear = perils.ground_all(room, kind, col, row, across)
  +far = Bool.and(perils.far_doors(doors, x, y), perils.far_laid(J.items(laid), x, y))
  perils.lay.cell.k1(Bool.and(clear, far), tries, room, doors, kind, rng, laid, across, x, y, clear, far)

def perils.lay.cell.k2(pr: W.W & U32, +kind: U32, +laid: J.Val, +across: Bool, +x: F32, +y: F32) -> W.W & J.Val:
  (+rng1, +phase) = pr
  (rng1, J.push(laid, perils.Peril.new(kind, x, y, phase, across)))

def perils.lay.cell.k1(cv: Bool, +tries: U32, +room: J.Val, +doors: List<&2, GcPt>, +kind: U32, +rng: W.W, +laid: J.Val, +across: Bool, +x: F32, +y: F32, +clear: Bool, +far: Bool) -> W.W & J.Val:
  match cv:
    case True{}:
      +p = loot.Rng.below(rng, perils.period_kind(kind))
      perils.lay.cell.k2(p, kind, laid, across, x, y)
    case False{}:
      perils.lay.try((tries - 1 : U32), room, doors, kind, rng, laid)
def perils.far_doors(+doors: List<&2, GcPt>, +x: F32, +y: F32) -> Bool:
  perils.far_doors.k1(doors, doors, x, y)

def perils.far_doors.k2(sv0: GcPt, +x: F32, +y: F32, +d: GcPt, +t: List<&2, GcPt>) -> Bool:
  match sv0:
    case GcPt{+dx, +dy}:
      Bool.and(F32.is_gt(RS.f_hypot((dx - x : F32), (dy - y : F32)), perils.DOOR_CLEAR()), perils.far_doors(t, x, y))

def perils.far_doors.k1(sv0: List<&2, GcPt>, +doors: List<&2, GcPt>, +x: F32, +y: F32) -> Bool:
  match sv0:
    case Nil{}:
      True{}
    case Con{+d, +t}:
      perils.far_doors.k2(d, x, y, d, t)
def perils.far_laid(+ps: List<&2, J.Val>, +x: F32, +y: F32) -> Bool:
  perils.far_laid.k1(ps, ps, x, y)

def perils.far_laid.k2(pr: F32 & F32, +x: F32, +y: F32, +t: List<&2, J.Val>) -> Bool:
  (+px, +py) = pr
  Bool.and(F32.is_gt(RS.f_hypot((px - x : F32), (py - y : F32)), 6.0), perils.far_laid(t, x, y))

def perils.far_laid.k1(sv0: List<&2, J.Val>, +ps: List<&2, J.Val>, +x: F32, +y: F32) -> Bool:
  match sv0:
    case Nil{}:
      True{}
    case Con{+p, +t}:
      +at = perils.Peril.at(p)
      perils.far_laid.k2(at, x, y, t)
def perils.Peril.new(+kind: U32, +x: F32, +y: F32, +phase: U32, +across: Bool) -> J.Val:
  +body = gc.su(gc.sf(gc.sf(J.obj(), "x", x), "y", y), "phase", phase)
  perils.Peril.new.k1(U32.is_eq(kind, 2), kind, across, body)

def perils.Peril.new.k1(cv: Bool, +kind: U32, +across: Bool, +body: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.set(J.obj(), "crack", gc.sb(body, "across", across))
    case False{}:
      J.set(J.obj(), gc.nth_s(["jet", "seep", "crack", "crumble"], kind), body)
# fn tick_perils(&mut self)
def perils.Run.tick_perils(+run: J.Val) -> J.Val:
  perils.tick.each(run, gc.tick(run), 0, gc.len(J.items(J.get(J.get(run, "works"), "perils"))))
def perils.tick.each(+run: J.Val, +tick: W.W, +i: U32, +n: U32) -> J.Val:
  perils.tick.each.k1(U32.is_ge(i, n), run, tick, i, n)

def perils.tick.each.k1(cv: Bool, +run: J.Val, +tick: W.W, +i: U32, +n: U32) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      perils.tick.each(perils.tick.one(run, tick, J.nth(J.get(J.get(run, "works"), "perils"), i)), tick, (i + 1 : U32), n)
def perils.tick.one(+run: J.Val, +tick: W.W, +p: J.Val) -> J.Val:
  +beat = perils.Peril.beat(p, tick)
  +k = perils.Peril.kind(p)
  perils.tick.one.k1(String.eq(k, "seep"), run, tick, p, beat, k)

def perils.tick.one.k2(cv: Bool, +run: J.Val, +tick: W.W, +p: J.Val, +beat: U32, +k: String, +beats: Bool, +every: U32) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      perils.tick.strike(run, p, k, beat)

def perils.tick.one.k1(cv: Bool, +run: J.Val, +tick: W.W, +p: J.Val, +beat: U32, +k: String) -> J.Val:
  match cv:
    case True{}:
      perils.tick.seep(run, p, beat)
    case False{}:
      +striking = perils.is_some(perils.Peril.striking(p, tick))
      +beats = gc.pb(String.eq(k, "crumble"), U32.is_eq(beat, perils.CRUMBLE_FALL()), striking)
      +every = gc.pu(String.eq(k, "jet"), 5, gc.pu(String.eq(k, "crack"), 6, 1))
      perils.tick.one.k2(Bool.or(Bool.not(beats), U32.is_ne(W.rem_u32(tick, every), 0)), run, tick, p, beat, k, beats, every)
def perils.hostile_clouds(+cs: List<&2, J.Val>) -> U32:
  perils.hostile_clouds.k1(cs, cs)

def perils.hostile_clouds.k1(sv0: List<&2, J.Val>, +cs: List<&2, J.Val>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+h, +t}:
      (gc.pu(U32.is_zero(gc.u(h, "owner")), 1, 0) + perils.hostile_clouds(t) : U32)
# A seep puffs a cloud at beat SEEP_PUFF while fewer than three hostile clouds drift.
def perils.tick.seep(+run: J.Val, +p: J.Val, +beat: U32) -> J.Val:
  +hostile = perils.hostile_clouds(J.items(J.get(J.get(run, "works"), "clouds")))
  perils.tick.seep.k1(Bool.and(U32.is_eq(beat, perils.SEEP_PUFF()), U32.is_lt(hostile, 3)), run, p, beat, hostile)

def perils.tick.seep.k2(pr: F32 & F32, +run: J.Val) -> J.Val:
  (+x, +y) = pr
  +cloud = perils.cloud(x, y)
  gc.sound(J.set(run, "works", J.set(J.get(run, "works"), "clouds", J.push(J.get(J.get(run, "works"), "clouds"), cloud))), "vent_fire")

def perils.tick.seep.k1(cv: Bool, +run: J.Val, +p: J.Val, +beat: U32, +hostile: U32) -> J.Val:
  match cv:
    case True{}:
      +at = perils.Peril.at(p)
      perils.tick.seep.k2(at, run)
    case False{}:
      run
# Cloud { x, y, vx: 0, vy: -0.3, age: GAS_LIFE - SEEP_LIFE, owner: 0, power: 4, tint: 1 }
def perils.cloud(+x: F32, +y: F32) -> J.Val:
  +c0 = gc.sf(gc.sf(gc.sf(gc.sf(J.obj(), "x", x), "y", y), "vx", 0.0), "vy", F32.neg(0.3))
  gc.su(gc.su(gc.su(gc.su(c0, "age", (skills.GAS_LIFE() - perils.SEEP_LIFE() : U32)), "owner", 0), "power", 4), "tint", 1)
def perils.tick.strike(+run: J.Val, +p: J.Val, +k: String, +beat: U32) -> J.Val:
  +r1 = gc.ifj(Bool.or(Bool.and(U32.is_eq(beat, perils.JET_LIVE()), String.eq(k, "jet")), U32.is_eq(beat, perils.CRACK_LIVE())), _ => gc.sound(run, "vent_fire"), _ => run)
  +at = perils.Peril.at(p)
  perils.tick.strike.k1(at, p, k, beat, r1)

def perils.tick.strike.k1(pr: F32 & F32, +p: J.Val, +k: String, +beat: U32, +r1: J.Val) -> J.Val:
  (+px, +py) = pr
  +r2 = perils.tick.boom(r1, k, beat, px, py)
  +knight = gc.pu(String.eq(k, "crumble"), 18, perils.FIRE_HARM())
  +foe = gc.pu(String.eq(k, "jet"), 16, gc.pu(String.eq(k, "crack"), 20, 40))
  +r3 = perils.hurt_knights(r2, p, knight, gc.ids(J.get(r2, "players")))
  perils.hurt_foes(r3, p, foe, String.eq(k, "crumble"))
def perils.tick.boom(+run: J.Val, +k: String, +beat: U32, +px: F32, +py: F32) -> J.Val:
  perils.tick.boom.k1(String.eq(k, "crumble"), run, k, beat, px, py)

def perils.tick.boom.k2(cv: Bool, +run: J.Val, +k: String, +beat: U32, +px: F32, +py: F32) -> J.Val:
  match cv:
    case True{}:
      skills.Run.boom(run, px, py, "burst", perils.JET_REACH())
    case False{}:
      run

def perils.tick.boom.k1(cv: Bool, +run: J.Val, +k: String, +beat: U32, +px: F32, +py: F32) -> J.Val:
  match cv:
    case True{}:
      +r1 = gc.sound(run, "rock_land")
      +r2 = gc.push(r1, "fx", J.set(J.obj(), "Shake", J.JU{5}))
      skills.Run.boom(r2, px, py, "dust", perils.CRUMBLE_HALF())
    case False{}:
      perils.tick.boom.k2(Bool.and(String.eq(k, "jet"), U32.is_eq(beat, perils.JET_LIVE())), run, k, beat, px, py)
def perils.hurt_knights(+run: J.Val, +p: J.Val, +dmg: U32, +ids: List<&2, U32>) -> J.Val:
  perils.hurt_knights.k1(ids, run, p, dmg, ids)

def perils.hurt_knights.k2(cv: Bool, +run: J.Val, +p: J.Val, +dmg: U32, +id: U32, +t: List<&2, U32>, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      perils.hurt_knights(J.set(run, "players", gc.put_seat(J.get(run, "players"), id, hero.Hero.hurt(h, dmg))), p, dmg, t)
    case False{}:
      perils.hurt_knights(run, p, dmg, t)

def perils.hurt_knights.k1(sv0: List<&2, U32>, +run: J.Val, +p: J.Val, +dmg: U32, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      +h = gc.seat(J.get(run, "players"), id)
      perils.hurt_knights.k2(Bool.and(U32.is_gt(gc.u(h, "hp"), 0), Bool.and(Bool.not(gc.b(h, "stone")), Bool.and(U32.is_zero(gc.u(h, "privy")), perils.Peril.strikes(p, gc.f(h, "x"), gc.f(h, "y"), rules.HERO_RADIUS())))), run, p, dmg, id, t, h)
def perils.hurt_foes(+run: J.Val, +p: J.Val, +foe: U32, +ground: Bool) -> J.Val:
  J.set(run, "enemies", J.JA{perils.foes(J.items(J.get(run, "enemies")), p, foe, ground)})
def perils.foes(+es: List<&2, J.Val>, +p: J.Val, +foe: U32, +ground: Bool) -> List<&2, J.Val>:
  perils.foes.k1(es, es, p, foe, ground)

def perils.foes.k1(sv0: List<&2, J.Val>, +es: List<&2, J.Val>, +p: J.Val, +foe: U32, +ground: Bool) -> List<&2, J.Val>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+e, +t}:
      +kind = gc.s(e, "kind")
      +live = Bool.and(U32.is_gt(gc.u(e, "hp"), 0), Bool.and(Bool.not(String.eq(kind, "dummy")), Bool.not(Bool.and(ground, monsters.EnemyKind.flies(kind)))))
      +hit = Bool.and(live, perils.Peril.strikes(p, gc.f(e, "x"), gc.f(e, "y"), (monsters.Enemy.radius(e) * 0.5 : F32)))
      +e2 = gc.ifj(hit, _ => gc.su(e, "hp", gc.ssub(gc.u(e, "hp"), foe)), _ => e)
      e2 <> perils.foes(t, p, foe, ground)
