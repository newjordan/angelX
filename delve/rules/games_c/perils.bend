# crates/delve/src/rules/perils.rs — the rooms' own dangers: fire jets, gas seeps,
# ember cracks and crumbling floors. A Peril is {"jet"|"seep"|"crack"|"crumble": {x, y, phase[, across]}}.

def perils.ODDS(+tier: U32) -> U32:
  gc.nth_u([35, 55, 75], tier)
def perils.MOST(+tier: U32) -> U32:
  gc.nth_u([1, 1, 2], tier)
def perils.DOOR_CLEAR() -> F32:
  6.0
def perils.JET_PERIOD() -> U32:
  150
def perils.JET_WARN() -> U32:
  90
def perils.JET_LIVE() -> U32:
  120
def perils.JET_END() -> U32:
  146
def perils.JET_REACH() -> F32:
  1.5
def perils.SEEP_PERIOD() -> U32:
  210
def perils.SEEP_WARN() -> U32:
  150
def perils.SEEP_PUFF() -> U32:
  180
def perils.SEEP_LIFE() -> U32:
  (5 * rules.HZ() : U32)
def perils.CRACK_PERIOD() -> U32:
  240
def perils.CRACK_WARN() -> U32:
  150
def perils.CRACK_LIVE() -> U32:
  200
def perils.CRACK_END() -> U32:
  224
def perils.CRACK_LONG() -> F32:
  3.2
def perils.CRACK_WIDE() -> F32:
  1.0
def perils.CRUMBLE_PERIOD() -> U32:
  300
def perils.CRUMBLE_WARN() -> U32:
  190
def perils.CRUMBLE_FALL() -> U32:
  250
def perils.CRUMBLE_RUBBLE() -> U32:
  275
def perils.CRUMBLE_HALF() -> F32:
  2.0
def perils.GAS_HARM() -> U32:
  5
def perils.FIRE_HARM() -> U32:
  14
# The variant name of a peril: its one object key.
def perils.Peril.kind(+p: J.Val) -> String:
  perils.kind.go(J.fields(p))
def perils.kind.go(+fs: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> String:
  perils.kind.go.k1(fs, fs)

def perils.kind.go.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +fs: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> String:
  match sv0:
    case Nil{}:
      ""
    case Con{(+k, +v), +t}:
      k
# The variant's body {x, y, phase[, across]}.
def perils.Peril.body(+p: J.Val) -> J.Val:
  J.get(p, perils.Peril.kind(p))
# pub fn at(&self) -> (x, y)
def perils.Peril.at(+p: J.Val) -> F32 & F32:
  (gc.f(perils.Peril.body(p), "x"), gc.f(perils.Peril.body(p), "y"))
def perils.Peril.phase(+p: J.Val) -> U32:
  gc.u(perils.Peril.body(p), "phase")
def perils.Peril.period(+p: J.Val) -> U32:
  perils.period_of(perils.Peril.kind(p))
def perils.period_of(+k: String) -> U32:
  perils.period_of.k1(String.eq(k, "jet"), k)

def perils.period_of.k2(cv: Bool, +k: String) -> U32:
  match cv:
    case True{}:
      perils.SEEP_PERIOD()
    case False{}:
      gc.pu(String.eq(k, "crack"), perils.CRACK_PERIOD(), perils.CRUMBLE_PERIOD())

def perils.period_of.k1(cv: Bool, +k: String) -> U32:
  match cv:
    case True{}:
      perils.JET_PERIOD()
    case False{}:
      perils.period_of.k2(String.eq(k, "seep"), k)
# pub fn beat(&self, tick) -> u32: (tick as u32).wrapping_add(phase) % period
def perils.Peril.beat(+p: J.Val, +tick: W.W) -> U32:
  U32.mod((W.lo32(tick) + perils.Peril.phase(p) : U32), perils.Peril.period(p))
# (from, to) of the warning window and of the striking window.
def perils.warn_from(+k: String) -> U32:
  perils.warn_from.k1(String.eq(k, "jet"), k)

def perils.warn_from.k2(cv: Bool, +k: String) -> U32:
  match cv:
    case True{}:
      perils.SEEP_WARN()
    case False{}:
      gc.pu(String.eq(k, "crack"), perils.CRACK_WARN(), perils.CRUMBLE_WARN())

def perils.warn_from.k1(cv: Bool, +k: String) -> U32:
  match cv:
    case True{}:
      perils.JET_WARN()
    case False{}:
      perils.warn_from.k2(String.eq(k, "seep"), k)
def perils.warn_to(+k: String) -> U32:
  perils.warn_to.k1(String.eq(k, "jet"), k)

def perils.warn_to.k2(cv: Bool, +k: String) -> U32:
  match cv:
    case True{}:
      perils.SEEP_PUFF()
    case False{}:
      gc.pu(String.eq(k, "crack"), perils.CRACK_LIVE(), perils.CRUMBLE_FALL())

def perils.warn_to.k1(cv: Bool, +k: String) -> U32:
  match cv:
    case True{}:
      perils.JET_LIVE()
    case False{}:
      perils.warn_to.k2(String.eq(k, "seep"), k)
def perils.strike_from(+k: String) -> U32:
  perils.warn_to(k)
def perils.strike_to(+k: String) -> U32:
  perils.strike_to.k1(String.eq(k, "jet"), k)

def perils.strike_to.k2(cv: Bool, +k: String) -> U32:
  match cv:
    case True{}:
      (perils.SEEP_PUFF() + 30 : U32)
    case False{}:
      gc.pu(String.eq(k, "crack"), perils.CRACK_END(), perils.CRUMBLE_RUBBLE())

def perils.strike_to.k1(cv: Bool, +k: String) -> U32:
  match cv:
    case True{}:
      perils.JET_END()
    case False{}:
      perils.strike_to.k2(String.eq(k, "seep"), k)
# warning(tick) -> Option<f32>: a value in 0..1, or -1.0 for none.
def perils.Peril.warning(+p: J.Val, +tick: W.W) -> Maybe<&2, F32>:
  perils.window(perils.Peril.beat(p, tick), perils.warn_from(perils.Peril.kind(p)), perils.warn_to(perils.Peril.kind(p)))
def perils.Peril.striking(+p: J.Val, +tick: W.W) -> Maybe<&2, F32>:
  perils.window(perils.Peril.beat(p, tick), perils.strike_from(perils.Peril.kind(p)), perils.strike_to(perils.Peril.kind(p)))
def perils.window(+beat: U32, +from: U32, +to: U32) -> Maybe<&2, F32>:
  perils.window.k1(Bool.and(U32.is_ge(beat, from), U32.is_lt(beat, to)), beat, from, to)

def perils.window.k1(cv: Bool, +beat: U32, +from: U32, +to: U32) -> Maybe<&2, F32>:
  match cv:
    case True{}:
      Some{((RS.u_as_f32((beat - from : U32)) / RS.u_as_f32((to - from : U32)) : F32))}
    case False{}:
      None{}
def perils.is_some(+m: Maybe<&2, F32>) -> Bool:
  perils.is_some.k1(m, m)

def perils.is_some.k1(sv0: Maybe<&2, F32>, +m: Maybe<&2, F32>) -> Bool:
  match sv0:
    case None{}:
      False{}
    case Some{+v}:
      True{}
# fn strikes(&self, px, py, slack) -> bool
def perils.Peril.strikes(+p: J.Val, +px: F32, +py: F32, +slack: F32) -> Bool:
  +at = perils.Peril.at(p)
  perils.Peril.strikes.k1(at, p, px, py, slack)

def perils.Peril.strikes.k4(cv: Bool, +p: J.Val, +px: F32, +py: F32, +slack: F32, +x: F32, +y: F32, +k: String) -> Bool:
  match cv:
    case True{}:
      +across = gc.b(perils.Peril.body(p), "across")
      +along = gc.pf(across, RS.f_abs((px - x : F32)), RS.f_abs((py - y : F32)))
      +over = gc.pf(across, RS.f_abs((py - y : F32)), RS.f_abs((px - x : F32)))
      Bool.and(F32.is_le(along, (perils.CRACK_LONG() + slack : F32)), F32.is_le(over, (perils.CRACK_WIDE() + slack : F32)))
    case False{}:
      Bool.and(F32.is_le(RS.f_abs((px - x : F32)), (perils.CRUMBLE_HALF() + slack : F32)), F32.is_le(RS.f_abs((py - y : F32)), (perils.CRUMBLE_HALF() + slack : F32)))

def perils.Peril.strikes.k3(cv: Bool, +p: J.Val, +px: F32, +py: F32, +slack: F32, +x: F32, +y: F32, +k: String) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      perils.Peril.strikes.k4(String.eq(k, "crack"), p, px, py, slack, x, y, k)

def perils.Peril.strikes.k2(cv: Bool, +p: J.Val, +px: F32, +py: F32, +slack: F32, +x: F32, +y: F32, +k: String) -> Bool:
  match cv:
    case True{}:
      F32.is_le(RS.f_hypot((px - x : F32), (py - y : F32)), (perils.JET_REACH() + slack : F32))
    case False{}:
      perils.Peril.strikes.k3(String.eq(k, "seep"), p, px, py, slack, x, y, k)

def perils.Peril.strikes.k1(pr: F32 & F32, +p: J.Val, +px: F32, +py: F32, +slack: F32) -> Bool:
  (+x, +y) = pr
  +k = perils.Peril.kind(p)
  perils.Peril.strikes.k2(String.eq(k, "jet"), p, px, py, slack, x, y, k)
# fn menu(pack, depth) -> [(kind, weight)]: 0 jet, 1 seep, 2 crack, 3 crumble. Two parallel lists in menu
# order; a zero weight is never picked, as the caller's filter would have dropped it.
def perils.menu.kinds(+pack: String) -> List<&2, U32>:
  perils.menu.kinds.k1(String.eq(pack, "crypt"), pack)

def perils.menu.kinds.k6(cv: Bool, +pack: String) -> List<&2, U32>:
  match cv:
    case True{}:
      [2, 1, 3, 0]
    case False{}:
      [1, 3]

def perils.menu.kinds.k5(cv: Bool, +pack: String) -> List<&2, U32>:
  match cv:
    case True{}:
      [1, 3, 2]
    case False{}:
      perils.menu.kinds.k6(String.eq(pack, "unknown"), pack)

def perils.menu.kinds.k4(cv: Bool, +pack: String) -> List<&2, U32>:
  match cv:
    case True{}:
      [1, 3, 0]
    case False{}:
      perils.menu.kinds.k5(String.eq(pack, "fungal"), pack)

def perils.menu.kinds.k3(cv: Bool, +pack: String) -> List<&2, U32>:
  match cv:
    case True{}:
      [0, 2, 1]
    case False{}:
      perils.menu.kinds.k4(String.eq(pack, "archive"), pack)

def perils.menu.kinds.k2(cv: Bool, +pack: String) -> List<&2, U32>:
  match cv:
    case True{}:
      [1, 3, 0]
    case False{}:
      perils.menu.kinds.k3(String.eq(pack, "hellforge"), pack)

def perils.menu.kinds.k1(cv: Bool, +pack: String) -> List<&2, U32>:
  match cv:
    case True{}:
      [3, 1, 0]
    case False{}:
      perils.menu.kinds.k2(String.eq(pack, "cavern"), pack)
def perils.menu.weights(+pack: String, +depth: U32) -> List<&2, U32>:
  perils.menu.weights.k1(String.eq(pack, "crypt"), pack, depth)

def perils.menu.weights.k6(cv: Bool, +pack: String, +depth: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      [3, 2, 2, 2]
    case False{}:
      [5, gc.pu(U32.is_ge(depth, 2), 2, 0)]

def perils.menu.weights.k5(cv: Bool, +pack: String, +depth: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      [5, 3, gc.pu(U32.is_ge(depth, 5), 1, 0)]
    case False{}:
      perils.menu.weights.k6(String.eq(pack, "unknown"), pack, depth)

def perils.menu.weights.k4(cv: Bool, +pack: String, +depth: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      [4, 3, gc.pu(U32.is_ge(depth, 5), 1, 0)]
    case False{}:
      perils.menu.weights.k5(String.eq(pack, "fungal"), pack, depth)

def perils.menu.weights.k3(cv: Bool, +pack: String, +depth: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      [4, 3, 2]
    case False{}:
      perils.menu.weights.k4(String.eq(pack, "archive"), pack, depth)

def perils.menu.weights.k2(cv: Bool, +pack: String, +depth: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      [4, gc.pu(U32.is_ge(depth, 2), 3, 0), gc.pu(U32.is_ge(depth, 3), 2, 0)]
    case False{}:
      perils.menu.weights.k3(String.eq(pack, "hellforge"), pack, depth)

def perils.menu.weights.k1(cv: Bool, +pack: String, +depth: U32) -> List<&2, U32>:
  match cv:
    case True{}:
      [4, 3, gc.pu(U32.is_ge(depth, 2), 2, 0)]
    case False{}:
