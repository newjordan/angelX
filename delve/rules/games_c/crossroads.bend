def crossroads.State.voting(+c: J.Val) -> Bool:
  String.eq(gc.s(c, "stage"), "voting")
# Run::crossroads_voting()
def crossroads.Run.crossroads_voting(+run: J.Val) -> Bool:
  crossroads.Run.crossroads_voting.k1(J.is_null(J.get(run, "crossroads")), run)

def crossroads.Run.crossroads_voting.k1(cv: Bool, +run: J.Val) -> Bool:
