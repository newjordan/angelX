# crates/delve/src/rules/crossroads.rs — three cards between every third floor and the next.
# Game is its snake_case name; Stage is "voting" | "playing" | "results".

def crossroads.VOTE_TIME() -> U32:
  (20 * rules.HZ() : U32)
def crossroads.RESULTS_TIME() -> U32:
  (5 * rules.HZ() : U32)
def crossroads.DEATHMATCH_TIME() -> U32:
  (180 * rules.HZ() : U32)
