# State::counts(): how many votes each of the three cards has.
def crossroads.State.count(+c: J.Val, +i: U32) -> U32:
  crossroads.count_votes(gc.vals_any(J.get(c, "votes")), i)
def crossroads.count_votes(+vs: List<&2, J.Val>, +i: U32) -> U32:
  crossroads.count_votes.k1(vs, vs, i)

def crossroads.count_votes.k1(sv0: List<&2, J.Val>, +vs: List<&2, J.Val>, +i: U32) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+h, +t}:
      (gc.pu(U32.is_eq(J.u32(h), i), 1, 0) + crossroads.count_votes(t, i) : U32)
# State::winner(): most votes wins; equal counts keep the earlier card, even at zero.
def crossroads.State.winner(+c: J.Val) -> U32:
  crossroads.winner.go(crossroads.State.count(c, 0), crossroads.State.count(c, 1), crossroads.State.count(c, 2))
def crossroads.winner.go(+n0: U32, +n1: U32, +n2: U32) -> U32:
  crossroads.winner.go.k1(Bool.and(U32.is_ge(n0, n1), U32.is_ge(n0, n2)), n0, n1, n2)

def crossroads.winner.go.k1(cv: Bool, +n0: U32, +n1: U32, +n2: U32) -> U32:
  match cv:
    case True{}:
      0
    case False{}:
      gc.pu(U32.is_ge(n1, n2), 1, 2)
# The seated ids: every player who is not absent.
def crossroads.seats(+players: J.Val, +ids: List<&2, U32>) -> List<&2, U32>:
  crossroads.seats.k1(ids, players, ids)

def crossroads.seats.k1(sv0: List<&2, U32>, +players: J.Val, +ids: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      gc.ifx_us(Bool.not(gc.b(gc.seat(players, id), "absent")), id, crossroads.seats(players, t))
# The cards dealt: Game::ALL (minus the deathmatch with fewer than two seats), shuffled from the back.
def crossroads.pool(+deathmatch: Bool) -> List<&2, String>:
  crossroads.pool.k1(deathmatch, deathmatch)

def crossroads.pool.k1(cv: Bool, +deathmatch: Bool) -> List<&2, String>:
  match cv:
    case True{}:
      ["powder", "gander", "shaft", "griffin", "touge", "deathmatch"]
    case False{}:
      ["powder", "gander", "shaft", "griffin", "touge"]
def crossroads.swap(+xs: List<&2, String>, +i: U32, +j: U32) -> List<&2, String>:
  +a = gc.nth_s(xs, i)
  +b = gc.nth_s(xs, j)
  crossroads.set_at(crossroads.set_at(xs, i, b), j, a)
def crossroads.set_at(+xs: List<&2, String>, +i: U32, +v: String) -> List<&2, String>:
  crossroads.set_at.k1(xs, xs, i, v)

def crossroads.set_at.k2(cv: Bool, +i: U32, +v: String, +h: String, +t: List<&2, String>) -> List<&2, String>:
  match cv:
    case True{}:
      v <> t
    case False{}:
      h <> crossroads.set_at(t, (i - 1 : U32), v)

def crossroads.set_at.k1(sv0: List<&2, String>, +xs: List<&2, String>, +i: U32, +v: String) -> List<&2, String>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      crossroads.set_at.k2(U32.is_zero(i), i, v, h, t)
# for i in (1..len).rev() { j = rng.next() % (i + 1); pool.swap(i, j) }
def crossroads.shuffle(+xs: List<&2, String>, +rng: W.W, +i: U32) -> List<&2, String>:
  crossroads.shuffle.k1(U32.is_zero(i), xs, rng, i)

def crossroads.shuffle.k2(pr: W.W & W.W, +xs: List<&2, String>, +i: U32) -> List<&2, String>:
  (+rng2, +out) = pr
  crossroads.shuffle(crossroads.swap(xs, i, W.rem_u32(out, (i + 1 : U32))), rng2, (i - 1 : U32))

def crossroads.shuffle.k1(cv: Bool, +xs: List<&2, String>, +rng: W.W, +i: U32) -> List<&2, String>:
  match cv:
    case True{}:
      xs
    case False{}:
      +r = loot.Rng.next(rng)
      crossroads.shuffle.k2(r, xs, i)
# fn begin_crossroads(&mut self, depth, pack)
def crossroads.Run.begin_crossroads(+run: J.Val, +depth: U32, +pack: J.Val) -> J.Val:
  +seats = crossroads.seats(J.get(run, "players"), gc.ids(J.get(run, "players")))
  +rng = loot.Rng.new(rules.mix(W.xor(W.xor(W.of_j(J.get(run, "seed")), W.rotl(W.of_j(J.get(run, "raid_id")), 17)), W.of_u32(gc.u(J.get(run, "dungeon"), "depth")))))
  +n = gc.pu(U32.is_ge(gc.len_u(seats), 2), 6, 5)
  +pool = crossroads.shuffle(crossroads.pool(U32.is_ge(gc.len_u(seats), 2)), rng, (n - 1 : U32))
  +r1 = crossroads.arrive_all(run, gc.ids(J.get(run, "players")))
  +r2 = J.set(r1, "floor_plates", J.obj())
  +r3 = hitstop.State.put(r2, J.obj())
  +r4 = fellowship.State.clear(r3)
  +c = crossroads.State.new(depth, pack, pool, seats)
  gc.sound(J.set(r4, "crossroads", c), "card_pickup")
def crossroads.State.new(+depth: U32, +pack: J.Val, +pool: List<&2, String>, +seats: List<&2, U32>) -> J.Val:
  +c0 = gc.su(J.set(J.obj(), "pack", pack), "depth", depth)
  +c1 = J.set(c0, "choices", J.JA{[J.JS{gc.nth_s(pool, 0)}, J.JS{gc.nth_s(pool, 1)}, J.JS{gc.nth_s(pool, 2)}]})
  +c2 = J.set(c1, "seats", gc.of_us(seats))
  +c3 = gc.ss(J.set(c2, "votes", J.obj()), "stage", "voting")
  +c4 = gc.snull(gc.su(c3, "left", crossroads.VOTE_TIME()), "chosen")
  J.set(c4, "order", J.JA{Nil{}})
# playtest.arrive for every player, then the seat's menu shut.
def crossroads.arrive_all(+run: J.Val, +ids: List<&2, U32>) -> J.Val:
  crossroads.arrive_all.k1(ids, run, ids)

def crossroads.arrive_all.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      crossroads.arrive_all(crossroads.arrive_one(run, id), t)
def crossroads.arrive_one(+run: J.Val, +id: U32) -> J.Val:
  +pt = votes.State.arrive(J.get(run, "playtest"), id, gc.s(gc.seat(J.get(run, "players"), id), "name"))
  +seat = gc.sb(gc.su(gc.su(gc.seat(J.get(pt, "seats"), id), "selected", 0), "hint", 0), "open", False{})
  J.set(run, "playtest", J.set(pt, "seats", gc.put_seat(J.get(pt, "seats"), id, seat)))
# fn crossroads_command(&mut self, id, command)
def crossroads.Run.crossroads_command(+run: J.Val, +id: U32, +cmd: J.Val) -> J.Val:
  +c = J.get(run, "crossroads")
  crossroads.Run.crossroads_command.k1(Bool.or(Bool.not(votes.Command.valid(cmd)), Bool.not(Bool.and(Bool.and(Bool.not(J.is_null(c)), crossroads.State.voting(c)), gc.has_u(id, gc.us(J.get(c, "seats")))))), run, id, cmd, c)

def crossroads.Run.crossroads_command.k2(cv: Bool, +run: J.Val, +id: U32, +cmd: J.Val, +hero: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      crossroads.command.seat(crossroads.arrive_name(run, id, gc.s(hero, "name")), id, cmd)

def crossroads.Run.crossroads_command.k1(cv: Bool, +run: J.Val, +id: U32, +cmd: J.Val, +c: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +hero = gc.seat(J.get(run, "players"), id)
      crossroads.Run.crossroads_command.k2(Bool.or(J.is_null(hero), Bool.or(gc.b(hero, "absent"), rules.Run.away(run, id))), run, id, cmd, hero)
# playtest.arrive(id, name) only.
def crossroads.arrive_name(+run: J.Val, +id: U32, +name: String) -> J.Val:
  J.set(run, "playtest", votes.State.arrive(J.get(run, "playtest"), id, name))
def crossroads.command.seat(+run: J.Val, +id: U32, +cmd: J.Val) -> J.Val:
  +seat = gc.seat(J.get(J.get(run, "playtest"), "seats"), id)
  crossroads.command.seat.k1(W.le(W.of_j(J.get(cmd, "serial")), W.of_j(J.get(seat, "serial"))), run, id, cmd, seat)

def crossroads.command.seat.k1(cv: Bool, +run: J.Val, +id: U32, +cmd: J.Val, +seat: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +sel = gc.umin(gc.u(seat, "selected"), 2)
      +act = votes.Action.name(J.get(cmd, "action"))
      crossroads.command.act(run, id, J.get(cmd, "serial"), sel, act, votes.Action.rate(J.get(cmd, "action")))
def crossroads.command.act(+run: J.Val, +id: U32, +serial: J.Val, +sel: U32, +act: String, +n: U32) -> J.Val:
  crossroads.command.act.k1(Bool.and(String.eq(act, "rate"), Bool.and(U32.is_ge(n, 1), U32.is_le(n, 3))), run, id, serial, sel, act, n)

def crossroads.command.act.k4(cv: Bool, +run: J.Val, +id: U32, +serial: J.Val, +sel: U32, +act: String) -> J.Val:
  match cv:
    case True{}:
      crossroads.command.put(J.set(run, "crossroads", J.set(J.get(run, "crossroads"), "votes", J.del(J.get(J.get(run, "crossroads"), "votes"), gc.key(id)))), id, serial, sel)
    case False{}:
      crossroads.command.put(run, id, serial, sel)

def crossroads.command.act.k3(cv: Bool, +run: J.Val, +id: U32, +serial: J.Val, +sel: U32, +act: String) -> J.Val:
  match cv:
    case True{}:
      crossroads.command.put(run, id, serial, U32.mod((sel + 1 : U32), 3))
    case False{}:
      crossroads.command.act.k4(String.eq(act, "clear"), run, id, serial, sel, act)

def crossroads.command.act.k2(cv: Bool, +run: J.Val, +id: U32, +serial: J.Val, +sel: U32, +act: String) -> J.Val:
  match cv:
    case True{}:
      crossroads.command.put(run, id, serial, U32.mod((sel + 2 : U32), 3))
    case False{}:
      crossroads.command.act.k3(Bool.or(String.eq(act, "right"), String.eq(act, "down")), run, id, serial, sel, act)

def crossroads.command.act.k1(cv: Bool, +run: J.Val, +id: U32, +serial: J.Val, +sel: U32, +act: String, +n: U32) -> J.Val:
  match cv:
    case True{}:
      crossroads.command.put(crossroads.command.vote(run, id, J.JU{(n - 1 : U32)}), id, serial, (n - 1 : U32))
    case False{}:
      crossroads.command.act.k2(Bool.or(String.eq(act, "left"), String.eq(act, "up")), run, id, serial, sel, act)
def crossroads.command.vote(+run: J.Val, +id: U32, +v: J.Val) -> J.Val:
  J.set(run, "crossroads", J.set(J.get(run, "crossroads"), "votes", J.set(J.get(J.get(run, "crossroads"), "votes"), gc.key(id), v)))
# seat.serial = command.serial; seat.selected = sel
def crossroads.command.put(+run: J.Val, +id: U32, +serial: J.Val, +sel: U32) -> J.Val:
  J.set(run, "playtest", votes.State.put(votes.State.put(J.get(run, "playtest"), id, "serial", serial), id, "selected", J.JU{sel}))
# fn tick_crossroads(&mut self, inputs)
def crossroads.Run.tick_crossroads(+run: J.Val, +inputs: J.Val) -> J.Val:
  +r1 = J.set(run, "tick", W.to_j(W.add_u32(gc.tick(run), 1)))
  +r2 = hitstop.State.put(r1, J.obj())
  +stage = gc.s(J.get(r2, "crossroads"), "stage")
  crossroads.Run.tick_crossroads.k1(String.eq(stage, "voting"), inputs, r2, stage)

def crossroads.Run.tick_crossroads.k2(cv: Bool, +inputs: J.Val, +r2: J.Val, +stage: String) -> J.Val:
  match cv:
    case True{}:
      crossroads.tick.playing(r2, inputs)
    case False{}:
      crossroads.tick.results(r2)

def crossroads.Run.tick_crossroads.k1(cv: Bool, +inputs: J.Val, +r2: J.Val, +stage: String) -> J.Val:
  match cv:
    case True{}:
      crossroads.tick.voting(r2, inputs)
    case False{}:
      crossroads.Run.tick_crossroads.k2(String.eq(stage, "playing"), inputs, r2, stage)
def crossroads.tick.voting(+run: J.Val, +inputs: J.Val) -> J.Val:
  +seats = crossroads.seats(J.get(run, "players"), gc.ids(J.get(run, "players")))
  +c = J.get(run, "crossroads")
  +c1 = J.set(J.set(c, "seats", gc.of_us(seats)), "votes", gc.retain_seats(J.get(c, "votes"), crossroads.set_of(seats)))
  +r1 = J.set(run, "crossroads", c1)
  +r2 = crossroads.tick.votes(r1, inputs, gc.ids(inputs))
  +c2 = J.get(r2, "crossroads")
  +pending = crossroads.pending(r2, gc.us(J.get(c2, "seats")))
  +left = gc.ssub(gc.u(c2, "left"), 1)
  +r3 = J.set(r2, "crossroads", gc.su(c2, "left", left))
  crossroads.tick.voting.k1(Bool.or(Bool.not(pending), U32.is_zero(left)), pending, left, r3)

def crossroads.tick.voting.k1(cv: Bool, +pending: Bool, +left: U32, +r3: J.Val) -> J.Val:
  match cv:
    case True{}:
      crossroads.Run.launch_crossroads(r3)
    case False{}:
      r3
# An object keyed by id whose keys are `seats`.
def crossroads.set_of(+ids: List<&2, U32>) -> J.Val:
  crossroads.set_of.k1(ids, ids)

def crossroads.set_of.k1(sv0: List<&2, U32>, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      J.obj()
    case Con{+id, +t}:
      J.set(crossroads.set_of(t), gc.key(id), J.JBool{True{}})
# for (id, input) in inputs.filter(valid) { if let Some(command) = input.vote { vote_command } }
def crossroads.tick.votes(+run: J.Val, +inputs: J.Val, +ids: List<&2, U32>) -> J.Val:
  crossroads.tick.votes.k1(ids, run, inputs, ids)

def crossroads.tick.votes.k2(cv: Bool, +run: J.Val, +inputs: J.Val, +id: U32, +t: List<&2, U32>, +i: J.Val) -> J.Val:
  match cv:
    case True{}:
      crossroads.tick.votes(votes.Run.vote_command(run, id, J.get(i, "vote")), inputs, t)
    case False{}:
      crossroads.tick.votes(run, inputs, t)

def crossroads.tick.votes.k1(sv0: List<&2, U32>, +run: J.Val, +inputs: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      +i = gc.seat(inputs, id)
      crossroads.tick.votes.k2(Bool.and(rules.Input.valid(i), Bool.not(J.is_null(J.get(i, "vote")))), run, inputs, id, t, i)
# any seat present, not absent, not away, with no vote cast
def crossroads.pending(+run: J.Val, +seats: List<&2, U32>) -> Bool:
  crossroads.pending.k1(seats, run, seats)

def crossroads.pending.k1(sv0: List<&2, U32>, +run: J.Val, +seats: List<&2, U32>) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+id, +t}:
      +here = Bool.and(gc.has_seat(J.get(run, "players"), id), Bool.not(gc.b(gc.seat(J.get(run, "players"), id), "absent")))
      Bool.or(Bool.and(here, Bool.and(Bool.not(rules.Run.away(run, id)), Bool.not(gc.has_seat(J.get(J.get(run, "crossroads"), "votes"), id)))), crossroads.pending(run, t))
def crossroads.tick.playing(+run: J.Val, +inputs: J.Val) -> J.Val:
  +c = J.get(run, "crossroads")
  +game = J.str(J.nth(J.get(c, "choices"), gc.u(c, "chosen")))
  crossroads.tick.playing.k1(String.eq(game, "deathmatch"), run, inputs, game)

def crossroads.tick.playing.k3(cv: Bool, +r1: J.Val, +r: J.Val) -> J.Val:
  match cv:
    case True{}:
      crossroads.Run.finish_crossroads(r1, race3d.Race3d.order(r))
    case False{}:
      r1

def crossroads.tick.playing.k4(cv: Bool, +r1: J.Val) -> J.Val:
  match cv:
    case True{}:
      crossroads.Run.finish_crossroads(r1, Nil{})
    case False{}:
      r1

def crossroads.tick.playing.k2(cv: Bool, +run: J.Val, +inputs: J.Val, +game: String) -> J.Val:
  match cv:
    case True{}:
      +r1 = race3d.Run.tick_race3d(run, inputs)
      +r = J.get(r1, "race3d")
      crossroads.tick.playing.k3(Bool.and(Bool.not(J.is_null(r)), gc.b(r, "done")), r1, r)
    case False{}:
      +r1 = pastimes.Run.tick_pastimes(run, inputs)
      crossroads.tick.playing.k4(Bool.and(String.eq(gc.s(J.get(r1, "crossroads"), "stage"), "playing"), J.is_null(J.get(J.get(r1, "pastimes"), "heat"))), r1)

def crossroads.tick.playing.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +game: String) -> J.Val:
  match cv:
    case True{}:
      crossroads.tick.deathmatch(deathmatch.Run.tick_deathmatch(run, inputs))
    case False{}:
      crossroads.tick.playing.k2(Bool.not(String.is_empty(crossroads.Game.course(game))), run, inputs, game)
def crossroads.tick.deathmatch(+run: J.Val) -> J.Val:
  +c = J.get(run, "crossroads")
  +left = gc.ssub(gc.u(c, "left"), 1)
  +r1 = J.set(run, "crossroads", gc.su(c, "left", left))
  +s = J.get(r1, "deathmatch")
  crossroads.tick.deathmatch.k1(J.is_null(s), left, r1, s)

def crossroads.tick.deathmatch.k2(cv: Bool, +left: U32, +r1: J.Val, +s: J.Val) -> J.Val:
  match cv:
    case True{}:
      crossroads.Run.finish_crossroads(r1, deathmatch.Session.order(s))
    case False{}:
      r1

def crossroads.tick.deathmatch.k1(cv: Bool, +left: U32, +r1: J.Val, +s: J.Val) -> J.Val:
  match cv:
    case True{}:
      crossroads.Run.finish_crossroads(r1, Nil{})
    case False{}:
      crossroads.tick.deathmatch.k2(Bool.or(Bool.not(J.is_null(J.get(s, "winner"))), U32.is_zero(left)), left, r1, s)
def crossroads.tick.results(+run: J.Val) -> J.Val:
  +c = J.get(run, "crossroads")
  +left = gc.ssub(gc.u(c, "left"), 1)
  crossroads.tick.results.k1(U32.is_zero(left), run, c, left)

def crossroads.tick.results.k1(cv: Bool, +run: J.Val, +c: J.Val, +left: U32) -> J.Val:
  match cv:
    case True{}:
      +r1 = J.set(J.set(run, "crossroads", J.JNull{}), "pastimes", pastimes.State.leave(J.get(run, "pastimes")))
      floors.Run.finish_descent(J.set(r1, "race3d", J.JNull{}), gc.u(c, "depth"), J.get(c, "pack"), False{})
    case False{}:
      J.set(run, "crossroads", gc.su(c, "left", left))
# fn launch_crossroads(&mut self)
def crossroads.Run.launch_crossroads(+run: J.Val) -> J.Val:
  +c = J.get(run, "crossroads")
  +seats = crossroads.present(J.get(run, "players"), gc.us(J.get(c, "seats")))
  +w = crossroads.State.winner(c)
  +chosen = crossroads.chosen(J.get(c, "choices"), w, gc.len_u(seats))
  +game = J.str(J.nth(J.get(c, "choices"), chosen))
  +c1 = gc.su(gc.ss(gc.su(J.set(c, "seats", gc.of_us(seats)), "chosen", chosen), "stage", "playing"), "left", gc.pu(String.eq(game, "deathmatch"), crossroads.DEATHMATCH_TIME(), 0))
  +r1 = crossroads.clear_arenas(J.set(run, "crossroads", c1))
  +r2 = crossroads.start_game(r1, game, seats)
  crossroads.Run.launch_crossroads.k1(J.is_null(J.get(r2, "crossroads")), r2)

def crossroads.Run.launch_crossroads.k2(cv: Bool, +r2: J.Val) -> J.Val:
  match cv:
    case True{}:
      crossroads.Run.finish_crossroads(r2, Nil{})
    case False{}:
      r2

def crossroads.Run.launch_crossroads.k1(cv: Bool, +r2: J.Val) -> J.Val:
  match cv:
    case True{}:
      r2
    case False{}:
      crossroads.Run.launch_crossroads.k2(U32.is_zero(gc.len(J.items(J.get(J.get(r2, "crossroads"), "seats")))), r2)
# c.seats.retain(|id| players has id && !absent)
def crossroads.present(+players: J.Val, +seats: List<&2, U32>) -> List<&2, U32>:
  crossroads.present.k1(seats, players, seats)

def crossroads.present.k1(sv0: List<&2, U32>, +players: J.Val, +seats: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      gc.ifx_us(Bool.and(gc.has_seat(players, id), Bool.not(gc.b(gc.seat(players, id), "absent"))), id, crossroads.present(players, t))
# The winner, but the deathmatch with fewer than two seats gives way to the leftmost playable card.
def crossroads.chosen(+choices: J.Val, +w: U32, +n: U32) -> U32:
  crossroads.chosen.k1(Bool.and(String.eq(J.str(J.nth(choices, w)), "deathmatch"), U32.is_lt(n, 2)), choices, w, n)

def crossroads.chosen.k1(cv: Bool, +choices: J.Val, +w: U32, +n: U32) -> U32:
  match cv:
    case True{}:
      gc.pu(Bool.not(String.eq(J.str(J.nth(choices, 0)), "deathmatch")), 0, gc.pu(Bool.not(String.eq(J.str(J.nth(choices, 1)), "deathmatch")), 1, 2))
    case False{}:
      w
def crossroads.clear_arenas(+run: J.Val) -> J.Val:
  +r0 = J.set(run, "pastimes", pastimes.State.leave(J.get(run, "pastimes")))
  +r1 = J.set(J.set(J.set(J.set(r0, "race3d", J.JNull{}), "deathmatch", J.JNull{}), "folly", J.JNull{}), "bats", J.JNull{})
  +r2 = J.set(J.set(J.set(J.set(r1, "powder", J.JNull{}), "hop", J.JNull{}), "gantry", J.JNull{}), "joust", J.JNull{})
  +r3 = J.set(J.set(J.set(J.set(r2, "chariot", J.JNull{}), "window", J.JNull{}), "light", J.JNull{}), "rune", J.JNull{})
  +r4 = J.set(J.set(J.set(J.set(r3, "enemies", J.JA{Nil{}}), "projectiles", J.JA{Nil{}}), "traps", J.JA{Nil{}}), "rocks", J.JA{Nil{}})
  J.set(J.set(r4, "gore", J.JA{Nil{}}), "spectacle", J.set(J.get(r4, "spectacle"), "corpses", J.JA{Nil{}}))
def crossroads.start_game(+run: J.Val, +game: String, +seats: List<&2, U32>) -> J.Val:
  crossroads.start_game.k1(String.eq(game, "deathmatch"), run, game, seats)

def crossroads.start_game.k2(cv: Bool, +run: J.Val, +game: String) -> J.Val:
  match cv:
    case True{}:
      race3d.Run.start_race3d_course(run, gc.u(run, "at"), game)
    case False{}:
      crossroads.start_pastime(run, gc.nth_s(["powder", "gander"], gc.pu(String.eq(game, "powder"), 0, 1)))

def crossroads.start_game.k1(cv: Bool, +run: J.Val, +game: String, +seats: List<&2, U32>) -> J.Val:
  match cv:
    case True{}:
      J.set(run, "deathmatch", deathmatch.Session.new(crossroads.pick_players(J.get(run, "players"), seats), J.get(run, "book")))
    case False{}:
      crossroads.start_game.k2(Bool.not(String.is_empty(crossroads.Game.course(game))), run, game)
# players.filter(|id| seats.contains(id))
def crossroads.pick_players(+players: J.Val, +seats: List<&2, U32>) -> J.Val:
  crossroads.pick_players.k1(seats, players, seats)

def crossroads.pick_players.k1(sv0: List<&2, U32>, +players: J.Val, +seats: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      J.obj()
    case Con{+id, +t}:
      J.set(crossroads.pick_players(players, t), gc.key(id), gc.seat(players, id))
def crossroads.start_pastime(+run: J.Val, +game: String) -> J.Val:
  +room = rules.Run.room(run)
  +cell = J.get(room, "cell")
  +at = gc.u(run, "at")
  +made = colosseum.room(colosseum.arena(game), gc.nu(cell, 0), gc.nu(cell, 1))
  +rooms = J.set_nth(J.get(J.get(run, "dungeon"), "rooms"), at, J.set(made, "cleared", J.JBool{True{}}))
  pastimes.Run.start_crossroads_pastime(J.set(run, "dungeon", J.set(J.get(run, "dungeon"), "rooms", rooms)), game)
# pub(super) fn finish_crossroads(&mut self, order)
def crossroads.Run.finish_crossroads(+run: J.Val, +order0: List<&2, U32>) -> J.Val:
  +c = J.get(run, "crossroads")
  crossroads.Run.finish_crossroads.k1(Bool.or(J.is_null(c), Bool.not(String.eq(gc.s(c, "stage"), "playing"))), run, order0, c)

def crossroads.Run.finish_crossroads.k1(cv: Bool, +run: J.Val, +order0: List<&2, U32>, +c: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +seats = gc.us(J.get(c, "seats"))
      +order = crossroads.keep_order(order0, seats, J.get(run, "players"))
      +c1 = gc.su(gc.ss(J.set(c, "order", gc.of_us(order)), "stage", "results"), "left", crossroads.RESULTS_TIME())
      +r1 = J.set(J.set(run, "crossroads", c1), "deathmatch", J.JNull{})
      gc.sound(crossroads.pay(r1, order, 0), "gold")
def crossroads.keep_order(+order: List<&2, U32>, +seats: List<&2, U32>, +players: J.Val) -> List<&2, U32>:
  crossroads.keep_order.k1(order, order, seats, players)

def crossroads.keep_order.k1(sv0: List<&2, U32>, +order: List<&2, U32>, +seats: List<&2, U32>, +players: J.Val) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      gc.ifx_us(Bool.and(gc.has_u(id, seats), gc.has_seat(players, id)), id, crossroads.keep_order(t, seats, players))
# for (place, id) in order: a bank haul of crossroads gold; the winner wears the laurel and gains a wish.
def crossroads.pay(+run: J.Val, +order: List<&2, U32>, +place: U32) -> J.Val:
  crossroads.pay.k1(order, run, order, place)

def crossroads.pay.k1(sv0: List<&2, U32>, +run: J.Val, +order: List<&2, U32>, +place: U32) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      +haul = J.set(J.set(J.set(J.obj(), "hero", J.JU{id}), "spoils", gc.su(J.obj(), "gold", crossroads.gold(place))), "why", J.JS{"crossroads prize"})
      +r1 = gc.push(run, "bank", haul)
      crossroads.pay(crossroads.pay.hero(r1, id, place), t, (place + 1 : U32))
def crossroads.pay.hero(+run: J.Val, +id: U32, +place: U32) -> J.Val:
  crossroads.pay.hero.k1(gc.has_seat(J.get(run, "players"), id), run, id, place)

def crossroads.pay.hero.k1(cv: Bool, +run: J.Val, +id: U32, +place: U32) -> J.Val:
  match cv:
    case True{}:
      +h = gc.sb(gc.seat(J.get(run, "players"), id), "laurel", U32.is_zero(place))
      +h1 = gc.ifj(U32.is_zero(place), _ => gc.su(h, "wishes", gc.umin(gc.sadd(gc.u(h, "wishes"), 1), overclass.MOST_WISHES())), _ => h)
      J.set(run, "players", gc.put_seat(J.get(run, "players"), id, h1))
    case False{}:
      run
