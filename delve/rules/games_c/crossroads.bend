# Game::course(): the race3d course for the race games, "" for the rest.
def crossroads.Game.course(+g: String) -> String:
  crossroads.Game.course.k1(Bool.or(String.eq(g, "shaft"), Bool.or(String.eq(g, "griffin"), String.eq(g, "touge"))), g)

def crossroads.Game.course.k1(cv: Bool, +g: String) -> String:
