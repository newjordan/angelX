# generated by bx.py from latch.bx: edit the .bx, not this file
# crates/delve/src/rules/latch.rs — Latch Duel: read the hook, catch the closing beat, buckle the bellows.
# Beat is "Rest" | "Tell" | "Clean" | "Miss" | "Defeat" (no rename). height and guard are i8 (-1 or 1).

def latch.TELL() -> U32:
  36
def latch.WINDOW() -> U32:
  7
def latch.REST() -> U32:
  24
def latch.RECOVER() -> U32:
  18
def latch.STOP() -> U32:
  4
def latch.LENGTH() -> U32:
  (45 * rules.HZ() : U32)
def latch.GOLD_PER_SEAT() -> U32:
  10
# BAY = (31.0, 18.0), raw arena units
def latch.BAY.x() -> F32:
  31.0
def latch.BAY.y() -> F32:
  18.0
# pub fn timing(ticks) -> "+{}MS": (ticks * 1000 + HZ / 2) / HZ
def latch.timing(+ticks: U32) -> String:
  "+" ++ U32.show(U32.div((ticks * 1000 + U32.div(rules.HZ(), 2) : U32), rules.HZ())) ++ "MS"
# Duel::new(seed)
def latch.Duel.new(+seed: J.Val) -> J.Val:
  +d0 = J.set(gc.si(gc.si(J.obj(), "height", RS.i_neg(1)), "guard", RS.i_neg(1)), "seed", seed)
  +d1 = gc.su(gc.su(gc.ss(gc.su(d0, "attack", 0), "beat", "Rest"), "ticks", latch.REST()), "windup", latch.TELL())
  +d2 = gc.su(gc.su(gc.su(gc.su(gc.su(d1, "freeze", 0), "counters", 0), "misses", 0), "error", 0), "chain", 0)
  gc.su(gc.sb(gc.sb(d2, "fire_key", False{}), "attempted", False{}), "miss_chain", 0)
# fn next_height(&self) -> i8: each two-attack phrase has both heights, its order seeded.
def latch.Duel.next_height(+d: J.Val) -> U32:
  +phrase = W.of_u32(U32.div(gc.u(d, "attack"), 2))
  +bit = U32.and(W.lo32(W.xor(W.rotl(W.of_j(J.get(d, "seed")), W.rem_u32(phrase, 64)), phrase)), 1)
  gc.pu(U32.is_zero(U32.xor(U32.mod(gc.u(d, "attack"), 2), bit)), RS.i_neg(1), 1)
# fn fail(&mut self, tune) -> Some("hit")
def latch.Duel.fail(+d: J.Val, +tune: J.Val) -> J.Val & String:
  +d1 = gc.su(d, "misses", (gc.u(d, "misses") + 1 : U32))
  +d2 = gc.su(gc.su(d1, "miss_chain", gc.u(d1, "chain")), "chain", 0)
  (gc.su(gc.ss(d2, "beat", "Miss"), "ticks", gc.u(tune, "latch_recover")), "hit")
# fn clean(&mut self, remaining, tune) -> Some("clang")
def latch.Duel.clean(+d: J.Val, +remaining: U32, +tune: J.Val) -> J.Val & String:
  +d1 = gc.su(gc.sb(d, "attempted", True{}), "counters", (gc.u(d, "counters") + 1 : U32))
  +d2 = gc.su(gc.su(d1, "chain", (gc.u(d1, "chain") + 1 : U32)), "error", (gc.u(d1, "error") + (remaining - 1 : U32) : U32))
  (gc.su(gc.su(gc.ss(d2, "beat", "Clean"), "ticks", gc.u(tune, "latch_recover")), "freeze", gc.u(tune, "latch_stop")), "clang")
# pub fn step(&mut self, input, tune)
def latch.Duel.step(+d: J.Val, +input: J.Val, +tune: J.Val) -> J.Val & String:
  latch.Duel.step_at(d, input, tune, None{}, W.zero())
# pub fn step_at(&mut self, input, tune, now: Option<u64>, allowance: u64) -> Option<&'static str> ("" for none)
def latch.Duel.step_at(+d: J.Val, +input0: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>, +allowance: W.W) -> J.Val & String:
  +input = gc.ifj(rules.Input.valid(input0), _ => input0, _ => rules.Input.default())
  +counter = Bool.and(gc.b(input, "fire"), Bool.not(gc.b(d, "fire_key")))
  +d1 = gc.sb(d, "fire_key", gc.b(input, "fire"))
  +d2 = gc.ifj(U32.is_ne(gc.u(input, "move_y"), 0), _ => J.set(d1, "guard", J.of_i32(gc.u(input, "move_y"))), _ => d1)
  latch.Duel.step_at.k1(Bool.and(counter, Bool.not(J.is_null(J.get(input, "latch_tick")))), tune, now, allowance, input, counter, d2)

def latch.Duel.step_at.k1(cv: Bool, +tune: J.Val, +now: Maybe<&2, W.W>, +allowance: W.W, +input: J.Val, +counter: Bool, +d2: J.Val) -> J.Val & String:
  match cv:
    case True{}:
      latch.Duel.stamped(d2, input, tune, now, allowance)
    case False{}:
      latch.Duel.tick(d2, tune, now, counter)
# A stamped press is never rejudged at arrival time (counter = false after it).
def latch.Duel.stamped(+d: J.Val, +input: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>, +allowance: W.W) -> J.Val & String:
  latch.Duel.stamped.k1(now, d, input, tune, now, allowance)

def latch.Duel.stamped.k3(cv: Bool, +d: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>, +sample: W.W, +start: W.W, +ok: Bool) -> J.Val & String:
  match cv:
    case True{}:
      latch.Duel.judged(d, tune, now, W.sat_sub(W.of_u32(gc.u(d, "windup")), W.sub(sample, start)))
    case False{}:
      latch.Duel.tick(d, tune, now, False{})

def latch.Duel.stamped.k2(cv: Bool, +d: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>, +allowance: W.W, +n: W.W, +sample: W.W) -> J.Val & String:
  match cv:
    case True{}:
      latch.Duel.tick(d, tune, now, False{})
    case False{}:
      +start = W.of_j(J.get(d, "tell_at"))
      +ok = Bool.and(W.ge(sample, start), Bool.and(W.le(sample, n), Bool.and(W.le(W.sub(n, sample), allowance), Bool.and(Bool.not(gc.b(d, "attempted")), Bool.or(String.eq(gc.s(d, "beat"), "Tell"), String.eq(gc.s(d, "beat"), "Miss"))))))
      latch.Duel.stamped.k3(ok, d, tune, now, sample, start, ok)

def latch.Duel.stamped.k1(sv0: Maybe<&2, W.W>, +d: J.Val, +input: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>, +allowance: W.W) -> J.Val & String:
  match sv0:
    case None{}:
      latch.Duel.tick(d, tune, now, False{})
    case Some{+n}:
      +sample = W.of_j(J.get(input, "latch_tick"))
      latch.Duel.stamped.k2(J.is_null(J.get(d, "tell_at")), d, tune, now, allowance, n, sample)
def latch.Duel.judged(+d: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>, +remaining: W.W) -> J.Val & String:
  +d1 = gc.sb(d, "attempted", True{})
  latch.Duel.judged.k1(Bool.and(Bool.not(W.eq(remaining, W.zero())), Bool.and(W.le(remaining, W.of_u32(gc.u(tune, "latch_window"))), U32.is_eq(gc.u(d1, "guard"), gc.u(d1, "height")))), tune, now, remaining, d1)

def latch.Duel.judged.k2(cv: Bool, +tune: J.Val, +remaining: W.W, +d1: J.Val) -> J.Val & String:
  match cv:
    case True{}:
      latch.Duel.clean(gc.su(gc.su(d1, "chain", gc.u(d1, "miss_chain")), "misses", (gc.u(d1, "misses") - 1 : U32)), W.lo32(remaining), tune)
    case False{}:
      latch.Duel.clean(d1, W.lo32(remaining), tune)

def latch.Duel.judged.k3(cv: Bool, +tune: J.Val, +now: Maybe<&2, W.W>, +d1: J.Val) -> J.Val & String:
  match cv:
    case True{}:
      latch.Duel.fail(d1, tune)
    case False{}:
      latch.Duel.tick(d1, tune, now, False{})

def latch.Duel.judged.k1(cv: Bool, +tune: J.Val, +now: Maybe<&2, W.W>, +remaining: W.W, +d1: J.Val) -> J.Val & String:
  match cv:
    case True{}:
      latch.Duel.judged.k2(String.eq(gc.s(d1, "beat"), "Miss"), tune, remaining, d1)
    case False{}:
      latch.Duel.judged.k3(String.eq(gc.s(d1, "beat"), "Tell"), tune, now, d1)
# The beat's own clock.
def latch.Duel.tick(+d: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>, +counter: Bool) -> J.Val & String:
  latch.Duel.tick.k1(U32.is_gt(gc.u(d, "freeze"), 0), d, tune, now, counter)

def latch.Duel.tick.k3(cv: Bool, +d: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>, +counter: Bool, +beat: String) -> J.Val & String:
  match cv:
    case True{}:
      latch.Duel.tell(d, tune, counter)
    case False{}:
      latch.Duel.rest(gc.su(d, "ticks", gc.ssub(gc.u(d, "ticks"), 1)), tune, now)

def latch.Duel.tick.k2(cv: Bool, +d: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>, +counter: Bool, +beat: String) -> J.Val & String:
  match cv:
    case True{}:
      (d, "")
    case False{}:
      latch.Duel.tick.k3(String.eq(beat, "Tell"), d, tune, now, counter, beat)

def latch.Duel.tick.k1(cv: Bool, +d: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>, +counter: Bool) -> J.Val & String:
  match cv:
    case True{}:
      (gc.su(d, "freeze", (gc.u(d, "freeze") - 1 : U32)), "")
    case False{}:
      +beat = gc.s(d, "beat")
      latch.Duel.tick.k2(String.eq(beat, "Defeat"), d, tune, now, counter, beat)
def latch.Duel.tell(+d: J.Val, +tune: J.Val, +counter: Bool) -> J.Val & String:
  latch.Duel.tell.k1(counter, d, tune, counter)

def latch.Duel.tell.k2(cv: Bool, +d: J.Val, +tune: J.Val) -> J.Val & String:
  match cv:
    case True{}:
      latch.Duel.clean(d, gc.u(d, "ticks"), tune)
    case False{}:
      latch.Duel.fail(gc.sb(d, "attempted", True{}), tune)

def latch.Duel.tell.k3(cv: Bool, +tune: J.Val, +d1: J.Val) -> J.Val & String:
  match cv:
    case True{}:
      latch.Duel.fail(d1, tune)
    case False{}:
      (d1, "")

def latch.Duel.tell.k1(cv: Bool, +d: J.Val, +tune: J.Val, +counter: Bool) -> J.Val & String:
  match cv:
    case True{}:
      latch.Duel.tell.k2(Bool.and(U32.is_le(gc.u(d, "ticks"), gc.u(tune, "latch_window")), U32.is_eq(gc.u(d, "guard"), gc.u(d, "height"))), d, tune)
    case False{}:
      +d1 = gc.su(d, "ticks", gc.ssub(gc.u(d, "ticks"), 1))
      latch.Duel.tell.k3(U32.is_zero(gc.u(d1, "ticks")), tune, d1)
def latch.Duel.rest(+d: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>) -> J.Val & String:
  latch.Duel.rest.k1(Bool.not(U32.is_zero(gc.u(d, "ticks"))), d, tune, now)

def latch.Duel.rest.k3(cv: Bool, +d: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>) -> J.Val & String:
  match cv:
    case True{}:
      +d1 = gc.su(gc.su(d, "height", latch.Duel.next_height(d)), "attack", (gc.u(d, "attack") + 1 : U32))
      +d2 = gc.sb(gc.ss(d1, "beat", "Tell"), "attempted", False{})
      +d3 = latch.Duel.tell_at(d2, now)
      (gc.su(gc.su(d3, "windup", gc.u(tune, "latch_tell")), "ticks", gc.u(tune, "latch_tell")), "play_card")
    case False{}:
      (gc.su(gc.ss(d, "beat", "Rest"), "ticks", gc.ssub(gc.u(tune, "latch_rest"), (gc.u(d, "counters") * 3 : U32))), "")

def latch.Duel.rest.k2(cv: Bool, +d: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>) -> J.Val & String:
  match cv:
    case True{}:
      (gc.ss(d, "beat", "Defeat"), "spoil_pickup")
    case False{}:
      latch.Duel.rest.k3(Bool.or(String.eq(gc.s(d, "beat"), "Rest"), String.eq(gc.s(d, "beat"), "Miss")), d, tune, now)

def latch.Duel.rest.k1(cv: Bool, +d: J.Val, +tune: J.Val, +now: Maybe<&2, W.W>) -> J.Val & String:
  match cv:
    case True{}:
      (d, "")
    case False{}:
      latch.Duel.rest.k2(U32.is_eq(gc.u(d, "counters"), 3), d, tune, now)
# tell_at = now.map(|tick| tick + 1), left out when None.
def latch.Duel.tell_at(+d: J.Val, +now: Maybe<&2, W.W>) -> J.Val:
  latch.Duel.tell_at.k1(now, d, now)

def latch.Duel.tell_at.k1(sv0: Maybe<&2, W.W>, +d: J.Val, +now: Maybe<&2, W.W>) -> J.Val:
  match sv0:
    case None{}:
      J.del(d, "tell_at")
    case Some{+n}:
      J.set(d, "tell_at", W.to_j(W.add_u32(n, 1)))
# pub fn late_bot_input(&self, recover) / bot_input(&self, early): the bots' keys.
def latch.Duel.late_bot_input(+d: J.Val, +recover: U32) -> J.Val:
  +fire = Bool.and(String.eq(gc.s(d, "beat"), "Miss"), Bool.and(U32.is_eq(gc.u(d, "ticks"), recover), Bool.not(gc.b(d, "fire_key"))))
  gc.sb(gc.si(rules.Input.default(), "move_y", gc.u(d, "height")), "fire", fire)
def latch.Duel.bot_input(+d: J.Val, +early: U32) -> J.Val:
  +fire = Bool.and(String.eq(gc.s(d, "beat"), "Tell"), Bool.and(U32.is_le(gc.u(d, "ticks"), gc.umax(early, 1)), Bool.not(gc.b(d, "fire_key"))))
  gc.sb(gc.si(rules.Input.default(), "move_y", gc.u(d, "height")), "fire", fire)
# Session::new(seats, seed)
def latch.Session.new(+seats: List<&2, U32>, +seed: J.Val) -> J.Val:
  +s0 = J.set(J.set(J.obj(), "duels", latch.duels(seats, seed)), "seed", seed)
  +s1 = gc.su(J.set(s0, "order", J.JA{Nil{}}), "left", latch.LENGTH())
  gc.snull(gc.snull(gc.sb(gc.sb(s1, "key", True{}), "won", False{}), "finish"), "finish_at")
def latch.duels(+seats: List<&2, U32>, +seed: J.Val) -> J.Val:
  latch.duels.k1(seats, seats, seed)

def latch.duels.k1(sv0: List<&2, U32>, +seats: List<&2, U32>, +seed: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      J.obj()
    case Con{+id, +t}:
      J.set(latch.duels(t, seed), gc.key(id), latch.Duel.new(seed))
# The ordering key of knight `id`: counters (more first), misses, error.
def latch.score.less(+a: J.Val, +b: J.Val) -> Bool:
  Bool.or(U32.is_gt(gc.u(a, "counters"), gc.u(b, "counters")), Bool.and(U32.is_eq(gc.u(a, "counters"), gc.u(b, "counters")), Bool.or(U32.is_lt(gc.u(a, "misses"), gc.u(b, "misses")), Bool.and(U32.is_eq(gc.u(a, "misses"), gc.u(b, "misses")), U32.is_lt(gc.u(a, "error"), gc.u(b, "error"))))))
def latch.score.eq(+a: J.Val, +b: J.Val) -> Bool:
  Bool.and(U32.is_eq(gc.u(a, "counters"), gc.u(b, "counters")), Bool.and(U32.is_eq(gc.u(a, "misses"), gc.u(b, "misses")), U32.is_eq(gc.u(a, "error"), gc.u(b, "error"))))
# Session::place(id): 1 + how many duels score strictly better.
def latch.Session.place(+s: J.Val, +id: U32) -> U32:
  (1 + latch.count_better(gc.vals(J.get(s, "duels")), gc.seat(J.get(s, "duels"), id)) : U32)
def latch.count_better(+ds: List<&2, J.Val>, +me: J.Val) -> U32:
  latch.count_better.k1(ds, ds, me)

def latch.count_better.k1(sv0: List<&2, J.Val>, +ds: List<&2, J.Val>, +me: J.Val) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+d, +t}:
      (gc.pu(latch.score.less(d, me), 1, 0) + latch.count_better(t, me) : U32)
# Session::payout(id)
def latch.Session.payout(+s: J.Val, +id: U32) -> U32:
  +order = gc.us(J.get(s, "order"))
  latch.Session.payout.k1(order, s, id, order)

def latch.Session.payout.k1(sv0: List<&2, U32>, +s: J.Val, +id: U32, +order: List<&2, U32>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+first, +t}:
      latch.payout.go(s, id, gc.seat(J.get(s, "duels"), first))
def latch.payout.go(+s: J.Val, +id: U32, +top: J.Val) -> U32:
  latch.payout.go.k1(Bool.or(U32.is_gt(gc.u(s, "left"), 0), Bool.not(latch.score.eq(gc.seat(J.get(s, "duels"), id), top))), s, id, top)

def latch.payout.go.k1(cv: Bool, +s: J.Val, +id: U32, +top: J.Val) -> U32:
  match cv:
    case True{}:
      0
    case False{}:
      +tied = latch.count_equal(J.int_fields(J.get(s, "duels")), top, 4294967295, 0)
      +before = latch.count_equal(J.int_fields(J.get(s, "duels")), top, id, 0)
      +total = (latch.GOLD_PER_SEAT() * gc.len(gc.vals(J.get(s, "duels"))) : U32)
      (U32.div(total, tied) + gc.pu(U32.is_lt(before, U32.mod(total, tied)), 1, 0) : U32)
# Duels with the top score and an id below `below`.
def latch.count_equal(+ds: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +top: J.Val, +below: U32, +n: U32) -> U32:
  latch.count_equal.k1(ds, ds, top, below, n)

def latch.count_equal.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +ds: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +top: J.Val, +below: U32, +n: U32) -> U32:
  match sv0:
    case Nil{}:
      n
    case Con{(+k, +d), +t}:
      +hit = Bool.and(U32.is_lt(gc.id(k), below), latch.score.eq(d, top))
      latch.count_equal(t, top, below, gc.pu(hit, (n + 1 : U32), n))
# fn latch_showing(&self)
def latch.Run.latch_showing(+run: J.Val) -> Bool:
  Bool.and(String.eq(J.str(J.get(rules.Run.room(run), "kind")), "smithy"), Bool.not(J.is_null(J.get(run, "latch"))))
# Is knight `id` standing at the bay (alive, awake, here, in the room, within 3.0)?
def latch.at_bay(+run: J.Val, +h: J.Val, +id: U32) -> Bool:
  Bool.and(U32.is_gt(gc.u(h, "hp"), 0), Bool.and(Bool.not(gc.b(h, "stone")), Bool.and(Bool.not(gc.b(h, "away")), Bool.and(Bool.not(gc.has_seat(J.get(J.get(run, "exits"), "outside"), id)), F32.is_lt(RS.f_hypot((gc.f(h, "x") - latch.BAY.x() : F32), (gc.f(h, "y") - latch.BAY.y() : F32)), 3.0)))))
def latch.pressed(+run: J.Val, +inputs: J.Val, +ids: List<&2, U32>) -> Bool:
  latch.pressed.k1(ids, run, inputs, ids)

def latch.pressed.k1(sv0: List<&2, U32>, +run: J.Val, +inputs: J.Val, +ids: List<&2, U32>) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+id, +t}:
      +i = gc.seat(inputs, id)
      +h = gc.seat(J.get(run, "players"), id)
      +here = Bool.and(rules.Input.valid(i), Bool.and(gc.b(i, "interact"), Bool.and(Bool.not(J.is_null(h)), latch.at_bay(run, h, id))))
      Bool.or(here, latch.pressed(run, inputs, t))
# fn tick_latch(&mut self, inputs)
def latch.Run.tick_latch(+run: J.Val, +inputs: J.Val) -> J.Val:
  latch.Run.tick_latch.k1(Bool.not(String.eq(J.str(J.get(rules.Run.room(run), "kind")), "smithy")), run, inputs)

def latch.Run.tick_latch.k2(cv: Bool, +run: J.Val, +inputs: J.Val, +pressed: Bool) -> J.Val:
  match cv:
    case True{}:
      gc.ifj(pressed, _ => latch.Run.start_latch(run), _ => run)
    case False{}:
      latch.tick.session(J.set(run, "latch", J.JNull{}), inputs, J.get(run, "latch"))

def latch.Run.tick_latch.k1(cv: Bool, +run: J.Val, +inputs: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.set(run, "latch", J.JNull{})
    case False{}:
      +pressed = latch.pressed(run, inputs, gc.ids(inputs))
      latch.Run.tick_latch.k2(J.is_null(J.get(run, "latch")), run, inputs, pressed)
def latch.tick.session(+run: J.Val, +inputs: J.Val, +s0: J.Val) -> J.Val:
  +duels = latch.keep_duels(run, J.get(s0, "duels"), gc.ids(J.get(s0, "duels")))
  +order = latch.keep_order(duels, gc.us(J.get(s0, "order")))
  +s = J.set(J.set(s0, "duels", duels), "order", gc.of_us(order))
  latch.tick.session.k1(J.is_null(J.get(duels, "1")), run, inputs, duels, s)

def latch.tick.session.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +duels: J.Val, +s: J.Val) -> J.Val:
  match cv:
    case True{}:
      gc.ifj(U32.is_zero(gc.len(gc.vals(duels))), _ => run, _ => latch.tick.live(run, inputs, s))
    case False{}:
      latch.tick.live(run, inputs, s)
# duels.retain(|id, _| players.contains_key(id) && !outside.contains_key(id))
def latch.keep_duels(+run: J.Val, +duels: J.Val, +ids: List<&2, U32>) -> J.Val:
  latch.keep_duels.k1(ids, run, duels, ids)

def latch.keep_duels.k1(sv0: List<&2, U32>, +run: J.Val, +duels: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      J.obj()
    case Con{+id, +t}:
      +keep = Bool.and(gc.has_seat(J.get(run, "players"), id), Bool.not(gc.has_seat(J.get(J.get(run, "exits"), "outside"), id)))
      gc.ifj(keep, _ => J.set(latch.keep_duels(run, duels, t), gc.key(id), gc.seat(duels, id)), _ => latch.keep_duels(run, duels, t))
def latch.keep_order(+duels: J.Val, +order: List<&2, U32>) -> List<&2, U32>:
  latch.keep_order.k1(order, duels, order)

def latch.keep_order.k1(sv0: List<&2, U32>, +duels: J.Val, +order: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      gc.ifx_us(gc.has_seat(duels, id), id, latch.keep_order(duels, t))
def latch.tick.live(+run: J.Val, +inputs: J.Val, +s: J.Val) -> J.Val:
  latch.tick.live.k1(U32.is_zero(gc.u(s, "left")), run, inputs, s)

def latch.tick.live.k2(cv: Bool, +run: J.Val, +s: J.Val, +take: Bool) -> J.Val:
  match cv:
    case True{}:
      latch.Run.start_latch(run)
    case False{}:
      J.set(run, "latch", gc.sb(s, "key", take))

def latch.tick.live.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +s: J.Val) -> J.Val:
  match cv:
    case True{}:
      +take = latch.any_interact(J.get(s, "duels"), inputs, gc.ids(inputs))
      latch.tick.live.k2(Bool.and(take, Bool.not(gc.b(s, "key"))), run, s, take)
    case False{}:
      +s1 = gc.su(s, "left", (gc.u(s, "left") - 1 : U32))
      latch.tick.duels(run, inputs, s1, gc.ids(J.get(s1, "duels")), Bool.not(J.is_null(J.get(s1, "finish"))))
def latch.any_interact(+duels: J.Val, +inputs: J.Val, +ids: List<&2, U32>) -> Bool:
  latch.any_interact.k1(ids, duels, inputs, ids)

def latch.any_interact.k1(sv0: List<&2, U32>, +duels: J.Val, +inputs: J.Val, +ids: List<&2, U32>) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+id, +t}:
      +i = gc.seat(inputs, id)
      Bool.or(Bool.and(gc.has_seat(duels, id), Bool.and(rules.Input.valid(i), gc.b(i, "interact"))), latch.any_interact(duels, inputs, t))
# for (id, d) in duels: the seat steps, unless the match is finishing.
def latch.tick.duels(+run: J.Val, +inputs: J.Val, +s: J.Val, +ids: List<&2, U32>, +finishing: Bool) -> J.Val:
  latch.tick.duels.k1(ids, run, inputs, s, ids, finishing)

def latch.tick.duels.k3(cv: Bool, +run: J.Val, +inputs: J.Val, +s: J.Val, +finishing: Bool, +id: U32, +t: List<&2, U32>, +input: J.Val, +d: J.Val, +win: Bool) -> J.Val:
  match cv:
    case True{}:
      latch.tick.duels(run, inputs, s, t, finishing)
    case False{}:
      +input2 = gc.ifj(Bool.and(finishing, Bool.not(win)), _ => gc.sb(input, "fire", False{}), _ => input)
      latch.tick.step(run, inputs, s, t, finishing, id, d, input2)

def latch.tick.duels.k2(cv: Bool, +run: J.Val, +inputs: J.Val, +s: J.Val, +finishing: Bool, +id: U32, +t: List<&2, U32>, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      latch.tick.duels(run, inputs, s, t, finishing)
    case False{}:
      +input = gc.seat(inputs, id)
      +d = gc.seat(J.get(s, "duels"), id)
      +win = Bool.and(Bool.not(J.is_null(J.get(s, "finish_at"))), Bool.and(Bool.not(J.is_null(J.get(input, "latch_tick"))), W.le(W.of_j(J.get(input, "latch_tick")), W.of_j(J.get(s, "finish_at")))))
      latch.tick.duels.k3(Bool.and(finishing, Bool.and(Bool.not(win), Bool.not(Bool.or(String.eq(gc.s(d, "beat"), "Clean"), String.eq(gc.s(d, "beat"), "Defeat"))))), run, inputs, s, finishing, id, t, input, d, win)

def latch.tick.duels.k1(sv0: List<&2, U32>, +run: J.Val, +inputs: J.Val, +s: J.Val, +ids: List<&2, U32>, +finishing: Bool) -> J.Val:
  match sv0:
    case Nil{}:
      latch.tick.end(run, s)
    case Con{+id, +t}:
      +h = gc.seat(J.get(run, "players"), id)
      latch.tick.duels.k2(Bool.or(J.is_null(h), Bool.or(gc.b(h, "away"), gc.b(h, "stone"))), run, inputs, s, finishing, id, t, h)
def latch.tick.step(+run: J.Val, +inputs: J.Val, +s: J.Val, +t: List<&2, U32>, +finishing: Bool, +id: U32, +d: J.Val, +input: J.Val) -> J.Val:
  +r = latch.Duel.step_at(d, input, J.get(run, "tune"), Some{W.of_j(J.get(run, "tick"))}, W.of_j(J.get(J.get(run, "latch_input_age"), gc.key(id))))
  latch.tick.step.k1(r, run, inputs, s, t, finishing, id)

def latch.tick.step.k1(pr: J.Val & String, +run: J.Val, +inputs: J.Val, +s: J.Val, +t: List<&2, U32>, +finishing: Bool, +id: U32) -> J.Val:
  (+d2, +sound) = pr
  +s2 = J.set(s, "duels", gc.put_seat(J.get(s, "duels"), id, d2))
  +run2 = gc.ifj(String.is_empty(sound), _ => run, _ => gc.sound(run, sound))
  latch.tick.duels(run2, inputs, s2, t, finishing)
# After the seats: the finish clock, the order, the purse.
def latch.tick.end(+run: J.Val, +s: J.Val) -> J.Val:
  +s1 = gc.ifj(J.is_null(J.get(s, "finish")), _ => s, _ => gc.su(s, "finish", gc.ssub(gc.u(s, "finish"), 1)))
  +s2 = latch.tick.finish_set(run, s1)
  latch.tick.end.k1(Bool.or(Bool.and(Bool.not(J.is_null(J.get(s2, "finish"))), U32.is_zero(gc.u(s2, "finish"))), U32.is_zero(gc.u(s2, "left"))), run, s2)

def latch.tick.end.k1(cv: Bool, +run: J.Val, +s2: J.Val) -> J.Val:
  match cv:
    case True{}:
      latch.tick.payout(run, s2)
    case False{}:
      J.set(run, "latch", s2)
def latch.any_counters3(+ds: List<&2, J.Val>) -> Bool:
  latch.any_counters3.k1(ds, ds)

def latch.any_counters3.k1(sv0: List<&2, J.Val>, +ds: List<&2, J.Val>) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+d, +t}:
      Bool.or(U32.is_eq(gc.u(d, "counters"), 3), latch.any_counters3(t))
def latch.tick.finish_set(+run: J.Val, +s: J.Val) -> J.Val:
  latch.tick.finish_set.k1(Bool.and(J.is_null(J.get(s, "finish")), latch.any_counters3(gc.vals(J.get(s, "duels")))), run, s)

def latch.tick.finish_set.k1(cv: Bool, +run: J.Val, +s: J.Val) -> J.Val:
  match cv:
    case True{}:
      gc.su(J.set(s, "finish_at", J.get(run, "tick")), "finish", (gc.u(J.get(run, "tune"), "latch_stop") + gc.u(J.get(run, "tune"), "latch_recover") : U32))
    case False{}:
      s
# Sort the duels' ids by (counters desc, misses, error, id); insertion sort.
def latch.sort_ids(+ids: List<&2, U32>, +duels: J.Val) -> List<&2, U32>:
  latch.sort_ids.k1(ids, ids, duels)

def latch.sort_ids.k1(sv0: List<&2, U32>, +ids: List<&2, U32>, +duels: J.Val) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      latch.insert_id(id, latch.sort_ids(t, duels), duels)
def latch.insert_id(+id: U32, +sorted: List<&2, U32>, +duels: J.Val) -> List<&2, U32>:
  latch.insert_id.k1(sorted, id, sorted, duels)

def latch.insert_id.k2(cv: Bool, +id: U32, +duels: J.Val, +h: U32, +t: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      id <> (h <> t)
    case False{}:
      h <> latch.insert_id(id, t, duels)

def latch.insert_id.k1(sv0: List<&2, U32>, +id: U32, +sorted: List<&2, U32>, +duels: J.Val) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      [id]
    case Con{+h, +t}:
      latch.insert_id.k2(latch.before(id, h, duels), id, duels, h, t)
def latch.before(+a: U32, +b: U32, +duels: J.Val) -> Bool:
  +da = gc.seat(duels, a)
  +db = gc.seat(duels, b)
  Bool.or(latch.score.less(da, db), Bool.and(latch.score.eq(da, db), U32.is_lt(a, b)))
def latch.tick.payout(+run: J.Val, +s: J.Val) -> J.Val:
  +order = latch.sort_ids(gc.ids(J.get(s, "duels")), J.get(s, "duels"))
  +s1 = gc.sb(gc.sb(gc.su(J.set(s, "order", gc.of_us(order)), "left", 0), "key", True{}), "won", latch.any_counters3(gc.vals(J.get(s, "duels"))))
  +top = gc.u(gc.seat(J.get(s1, "duels"), gc.nth_u(order, 0)), "counters")
  +rec = J.get(J.get(J.get(J.get(run, "home"), "countryside"), "games"), "latch")
  +rec1 = gc.su(rec, "best", gc.umax(gc.u(rec, "best"), top))
  +rec2 = gc.ifj(gc.b(s1, "won"), _ => gc.su(rec1, "wins", gc.umin(gc.sadd(gc.u(rec1, "wins"), 1), gc.u(rec1, "plays"))), _ => rec1)
  +r1 = latch.set_record(run, rec2)
  +r2 = J.set(r1, "players", latch.pay_players(J.get(r1, "players"), s1, gc.ids(J.get(r1, "players"))))
  J.set(gc.sound(r2, "spoil_pickup"), "latch", s1)
def latch.set_record(+run: J.Val, +rec: J.Val) -> J.Val:
  +home = J.get(run, "home")
  +cs = J.get(home, "countryside")
  +games = gc.score_put(J.get(cs, "games"), "latch", rec)
  J.set(run, "home", J.set(home, "countryside", J.set(cs, "games", games)))
def latch.pay_players(+players: J.Val, +s: J.Val, +ids: List<&2, U32>) -> J.Val:
  latch.pay_players.k1(ids, players, s, ids)

def latch.pay_players.k2(cv: Bool, +players: J.Val, +s: J.Val, +id: U32, +t: List<&2, U32>, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      +laurel = U32.is_eq(latch.Session.place(s, id), 1)
      +h1 = gc.sb(h, "laurel", laurel)
      +h2 = J.set(h1, "carried", realm.Spoils.add(J.get(h1, "carried"), "gold", latch.Session.payout(s, id)))
      +h3 = gc.ifj(laurel, _ => gc.snull(h2, "booby"), _ => h2)
      latch.pay_players(gc.put_seat(players, id, h3), s, t)
    case False{}:
      latch.pay_players(players, s, t)

def latch.pay_players.k1(sv0: List<&2, U32>, +players: J.Val, +s: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      players
    case Con{+id, +t}:
      +h = gc.seat(players, id)
      latch.pay_players.k2(gc.has_seat(J.get(s, "duels"), id), players, s, id, t, h)
# fn start_latch(&mut self)
def latch.Run.start_latch(+run: J.Val) -> J.Val:
  +r = loot.Rng.next(W.of_j(J.get(run, "rng")))
  latch.Run.start_latch.k1(r, run)

def latch.Run.start_latch.k2(cv: Bool, +r1: J.Val, +session: J.Val) -> J.Val:
  match cv:
    case True{}:
      r1
    case False{}:
      +r2 = J.set(r1, "latch", session)
      +rec = J.get(J.get(J.get(J.get(r2, "home"), "countryside"), "games"), "latch")
      +r3 = latch.set_record(r2, gc.su(rec, "plays", gc.sadd(gc.u(rec, "plays"), 1)))
      gc.sound(r3, "play_card")

def latch.Run.start_latch.k1(pr: W.W & W.W, +run: J.Val) -> J.Val:
  (+rng, +seed) = pr
  +r1 = J.set(run, "rng", W.to_j(rng))
  +seats = latch.seats(r1, gc.ids(J.get(r1, "players")))
  +session = latch.Session.new(seats, W.to_j(seed))
  latch.Run.start_latch.k2(U32.is_zero(gc.len(gc.vals(J.get(session, "duels")))), r1, session)
def latch.seats(+run: J.Val, +ids: List<&2, U32>) -> List<&2, U32>:
  latch.seats.k1(ids, run, ids)

def latch.seats.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      +h = gc.seat(J.get(run, "players"), id)
      +ok = Bool.and(U32.is_gt(gc.u(h, "hp"), 0), Bool.and(Bool.not(gc.b(h, "stone")), Bool.and(Bool.not(gc.b(h, "away")), Bool.not(gc.has_seat(J.get(J.get(run, "exits"), "outside"), id)))))
      gc.ifx_us(ok, id, latch.seats(run, t))
