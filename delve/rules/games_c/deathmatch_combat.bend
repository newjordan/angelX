# Hit the sorted targets in order, rank by rank: each takes `aoe::part(damage, rank)`.
def deathmatch.strike(+s: J.Val, +owner: U32, +ts: List<&2, GcTgt>, +rank: U32, +damage: U32) -> J.Val:
