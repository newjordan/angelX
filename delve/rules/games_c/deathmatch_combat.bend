    case Con{+h, +t}:
      deathmatch.tsort.ins.k2(deathmatch.tless(x, h), x, h, t)
def deathmatch.tless(+a: GcTgt, +b: GcTgt) -> Bool:
  deathmatch.tless.k1(a, a, b)

def deathmatch.tless.k2(sv0: GcTgt, +b: GcTgt, +ad: F32, +aid: U32) -> Bool:
  match sv0:
    case GcTgt{+bd, +bid, +bx, +by}:
