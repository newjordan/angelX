# generated by bx.py from deathmatch_combat.bx: edit the .bx, not this file
# crates/delve/src/rules/deathmatch/combat.rs — the PvP seam: the Delve's arms and cards, with knights
# as their targets. A Field is {owner, x, y, radius, damage, left, wait, kind} (kind: "Hazard" |
# "Turret" | "Decoy" | "Hedge", no rename).

# Field::blocks(x, y, r): only a hedge blocks, with a door in its east side.
def deathmatch.Field.blocks(+f: J.Val, +x: F32, +y: F32, +r: F32) -> Bool:
  deathmatch.Field.blocks.k1(Bool.not(String.eq(gc.s(f, "kind"), "Hedge")), f, x, y, r)

def deathmatch.Field.blocks.k1(cv: Bool, +f: J.Val, +x: F32, +y: F32, +r: F32) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      +radius = gc.f(f, "radius")
      +dx = RS.f_abs((x - gc.f(f, "x") : F32))
      +dy = RS.f_abs((y - gc.f(f, "y") : F32))
      +gate = Bool.and(F32.is_gt(x, gc.f(f, "x")), F32.is_lt(dy, (1.2 - r : F32)))
      +side = Bool.and(F32.is_lt(RS.f_abs((dx - radius : F32)), (r + 0.25 : F32)), Bool.and(F32.is_lt(dy, (radius + r : F32)), Bool.not(gate)))
      Bool.or(side, Bool.and(F32.is_lt(RS.f_abs((dy - radius : F32)), (r + 0.25 : F32)), F32.is_lt(dx, (radius + r : F32))))
# Session::visible(a, b): a sight line that no hedge cuts.
def deathmatch.Session.visible(+s: J.Val, +ax: F32, +ay: F32, +bx: F32, +by: F32) -> Bool:
  deathmatch.Session.visible.k1(deathmatch.sight(ax, ay, bx, by), s, ax, ay, bx, by)

def deathmatch.Session.visible.k1(cv: Bool, +s: J.Val, +ax: F32, +ay: F32, +bx: F32, +by: F32) -> Bool:
  match cv:
    case True{}:
      +n = RS.f_as_u32(RS.f_max(F32.ceil((RS.f_hypot((bx - ax : F32), (by - ay : F32)) * 5.0 : F32)), 1.0))
      deathmatch.visible.go(J.items(J.get(s, "fields")), 0, n, ax, ay, bx, by)
    case False{}:
      False{}
