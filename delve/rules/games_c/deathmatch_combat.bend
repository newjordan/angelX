# Sort targets by (distance, id): insertion, stable.
def deathmatch.tsort(+ts: List<&2, GcTgt>) -> List<&2, GcTgt>:
  deathmatch.tsort.k1(ts, ts)

def deathmatch.tsort.k1(sv0: List<&2, GcTgt>, +ts: List<&2, GcTgt>) -> List<&2, GcTgt>:
  match sv0:
    case Nil{}:
