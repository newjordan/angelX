# The shared orbit layout: n morningstars round the knight.
def deathmatch.orbit_points(+h: J.Val, +id: U32, +tick: W.W) -> List<&2, GcPt>:
  +n = gc.umin(gc.u(J.get(h, "bonus"), "orbit"), cards.cap("orbit"))
  deathmatch.orbit.go(h, id, tick, 0, n)
def deathmatch.orbit.go(+h: J.Val, +id: U32, +tick: W.W, +k: U32, +n: U32) -> List<&2, GcPt>:
  deathmatch.orbit.go.k1(U32.is_ge(k, n), h, id, tick, k, n)

def deathmatch.orbit.go.k1(cv: Bool, +h: J.Val, +id: U32, +tick: W.W, +k: U32, +n: U32) -> List<&2, GcPt>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      +a = ((((W.as_f32(tick) * rules.ORBIT_SPIN() : F32) * rules.DT() : F32) + ((RS.u_as_f32(k) * deathmatch.TAU() : F32) / RS.u_as_f32(n) : F32) : F32) + RS.u_as_f32(id) : F32)
      GcPt{(gc.f(h, "x") + (F32.cos(a) * rules.ORBIT_RADIUS() : F32) : F32), (gc.f(h, "y") + (F32.sin(a) * rules.ORBIT_RADIUS() : F32) : F32)} <> deathmatch.orbit.go(h, id, tick, (k + 1 : U32), n)
# The points swept over the last ORBIT_EVERY ticks.
def deathmatch.swept(+h: J.Val, +id: U32, +ticks: U32, +back: U32) -> List<&2, GcPt>:
  deathmatch.swept.k1(U32.is_ge(back, rules.ORBIT_EVERY()), h, id, ticks, back)

def deathmatch.swept.k1(cv: Bool, +h: J.Val, +id: U32, +ticks: U32, +back: U32) -> List<&2, GcPt>:
  match cv:
    case True{}:
      Nil{}
    case False{}:
      List.append(&2, GcPt, deathmatch.orbit_points(h, id, W.of_u32(gc.ssub(ticks, back))), deathmatch.swept(h, id, ticks, (back + 1 : U32)))
def deathmatch.near_any(+ps: List<&2, GcPt>, +x: F32, +y: F32, +r: F32) -> Bool:
  deathmatch.near_any.k1(ps, ps, x, y, r)

def deathmatch.near_any.k2(sv0: GcPt, +x: F32, +y: F32, +r: F32, +p: GcPt, +t: List<&2, GcPt>) -> Bool:
  match sv0:
    case GcPt{+px, +py}:
      Bool.or(F32.is_le(RS.f_hypot((x - px : F32), (y - py : F32)), r), deathmatch.near_any(t, x, y, r))

def deathmatch.near_any.k1(sv0: List<&2, GcPt>, +ps: List<&2, GcPt>, +x: F32, +y: F32, +r: F32) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+p, +t}:
      deathmatch.near_any.k2(p, x, y, r, p, t)
# fn orbits(&mut self, owner)
def deathmatch.Session.orbits(+s: J.Val, +owner: U32) -> J.Val:
  +h = deathmatch.H(s, owner)
  deathmatch.Session.orbits.k1(U32.is_zero(gc.u(J.get(h, "bonus"), "orbit")), s, owner, h)

def deathmatch.Session.orbits.k1(cv: Bool, +s: J.Val, +owner: U32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      s
    case False{}:
      +damage = hero.Hero.scaled(h, rules.ORBIT_DAMAGE())
      +swept = deathmatch.swept(h, owner, gc.u(s, "ticks"), 0)
      +fx = gc.f(h, "x")
      +fy = gc.f(h, "y")
      +ts = deathmatch.orbit.targets(s, owner, swept, fx, fy, gc.ids(J.get(s, "fighters")))
      deathmatch.strike(s, owner, deathmatch.tsort(ts), 0, damage)
def deathmatch.orbit.targets(+s: J.Val, +owner: U32, +swept: List<&2, GcPt>, +fx: F32, +fy: F32, +ids: List<&2, U32>) -> List<&2, GcTgt>:
  deathmatch.orbit.targets.k1(ids, s, owner, swept, fx, fy, ids)

def deathmatch.orbit.targets.k2(cv: Bool, +s: J.Val, +owner: U32, +swept: List<&2, GcPt>, +fx: F32, +fy: F32, +id: U32, +t: List<&2, U32>, +px: F32, +py: F32, +hit: Bool) -> List<&2, GcTgt>:
  match cv:
    case True{}:
      GcTgt{RS.f_hypot((px - fx : F32), (py - fy : F32)), id, (px - fx : F32), (py - fy : F32)} <> deathmatch.orbit.targets(s, owner, swept, fx, fy, t)
    case False{}:
      deathmatch.orbit.targets(s, owner, swept, fx, fy, t)

def deathmatch.orbit.targets.k1(sv0: List<&2, U32>, +s: J.Val, +owner: U32, +swept: List<&2, GcPt>, +fx: F32, +fy: F32, +ids: List<&2, U32>) -> List<&2, GcTgt>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      +f = deathmatch.F(s, id)
      +px = gc.f(J.get(f, "hero"), "x")
      +py = gc.f(J.get(f, "hero"), "y")
      +hit = Bool.and(Bool.not(U32.is_eq(id, owner)), Bool.and(deathmatch.Fighter.alive(f), Bool.and(deathmatch.near_any(swept, px, py, (rules.HERO_RADIUS() + 0.8 : F32)), deathmatch.Session.visible(s, fx, fy, px, py))))
      deathmatch.orbit.targets.k2(hit, s, owner, swept, fx, fy, id, t, px, py, hit)
# fn melee(&mut self, owner, reach, arc, damage)
def deathmatch.Session.melee(+s: J.Val, +owner: U32, +reach: F32, +arc: F32, +damage: U32) -> J.Val:
  +f = deathmatch.F(s, owner)
  +ts = deathmatch.melee.targets(s, owner, reach, arc, gc.f(J.get(f, "hero"), "x"), gc.f(J.get(f, "hero"), "y"), gc.f(f, "yaw"), gc.ids(J.get(s, "fighters")))
  deathmatch.strike(s, owner, deathmatch.tsort(ts), 0, damage)
def deathmatch.melee.targets(+s: J.Val, +owner: U32, +reach: F32, +arc: F32, +ax: F32, +ay: F32, +yaw: F32, +ids: List<&2, U32>) -> List<&2, GcTgt>:
  deathmatch.melee.targets.k1(ids, s, owner, reach, arc, ax, ay, yaw, ids)

def deathmatch.melee.targets.k2(cv: Bool, +s: J.Val, +owner: U32, +reach: F32, +arc: F32, +ax: F32, +ay: F32, +yaw: F32, +id: U32, +t: List<&2, U32>, +dx: F32, +dy: F32, +dist: F32, +hit: Bool) -> List<&2, GcTgt>:
  match cv:
    case True{}:
      GcTgt{dist, id, dx, dy} <> deathmatch.melee.targets(s, owner, reach, arc, ax, ay, yaw, t)
    case False{}:
      deathmatch.melee.targets(s, owner, reach, arc, ax, ay, yaw, t)

def deathmatch.melee.targets.k1(sv0: List<&2, U32>, +s: J.Val, +owner: U32, +reach: F32, +arc: F32, +ax: F32, +ay: F32, +yaw: F32, +ids: List<&2, U32>) -> List<&2, GcTgt>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      +f = deathmatch.F(s, id)
      +px = gc.f(J.get(f, "hero"), "x")
      +py = gc.f(J.get(f, "hero"), "y")
      +dx = (px - ax : F32)
      +dy = (py - ay : F32)
      +turn0 = (F32.atan2(dy, dx) - yaw : F32)
      +turn = RS.f_abs(F32.atan2(F32.sin(turn0), F32.cos(turn0)))
      +dist = RS.f_hypot(dx, dy)
      +hit = Bool.and(Bool.not(U32.is_eq(id, owner)), Bool.and(deathmatch.Fighter.alive(f), Bool.and(F32.is_le(dist, (reach + rules.HERO_RADIUS() : F32)), Bool.and(F32.is_le(turn, (RS.f_to_radians(arc) / 2.0 : F32)), deathmatch.Session.visible(s, ax, ay, px, py)))))
      deathmatch.melee.targets.k2(hit, s, owner, reach, arc, ax, ay, yaw, id, t, dx, dy, dist, hit)
# fn bolt(&mut self, id, kind, damage, speed, life, burst, stun)
def deathmatch.Session.bolt(+s: J.Val, +id: U32, +kind: String, +damage: U32, +speed: F32, +life: U32, +burst: U32, +stun: U32) -> J.Val:
  +h = deathmatch.H(s, id)
  +traits = gc.su(gc.su(rules.ShotTraits.of(J.get(h, "bonus")), "owner", id), "burst", burst)
  +p0 = gc.sf(gc.sf(gc.sf(gc.sf(J.obj(), "x", (gc.f(h, "x") + (gc.f(h, "aim_x") * 0.6 : F32) : F32)), "y", (gc.f(h, "y") + (gc.f(h, "aim_y") * 0.6 : F32) : F32)), "vx", (gc.f(h, "aim_x") * speed : F32)), "vy", (gc.f(h, "aim_y") * speed : F32))
  +p1 = gc.sb(gc.ss(p0, "kind", kind), "hostile", False{})
  +p2 = gc.snull(gc.snull(gc.su(gc.su(J.set(p1, "damage", J.JU{damage}), "pierce", 0), "ttl", life), "look"), "last_hit")
  +p3 = J.set(gc.sb(p2, "empowered", False{}), "traits", gc.su(traits, "stun", stun))
  J.set(s, "shots", J.push(J.get(s, "shots"), p3))
# fn field(&mut self, owner, at, radius, damage, left, kind)
def deathmatch.Session.field(+s: J.Val, +owner: U32, +x: F32, +y: F32, +radius: F32, +damage: U32, +left: U32, +kind: String) -> J.Val:
  +h = deathmatch.H(s, owner)
  deathmatch.Session.field.k1(Bool.and(U32.is_lt(gc.len(J.items(J.get(s, "fields"))), 32), Bool.and(deathmatch.open(x, y), deathmatch.sight(gc.f(h, "x"), gc.f(h, "y"), x, y))), s, owner, x, y, radius, damage, left, kind, h)

def deathmatch.Session.field.k1(cv: Bool, +s: J.Val, +owner: U32, +x: F32, +y: F32, +radius: F32, +damage: U32, +left: U32, +kind: String, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      +f0 = gc.sf(gc.sf(gc.sf(gc.su(J.obj(), "owner", owner), "x", x), "y", y), "radius", radius)
      +f1 = gc.ss(gc.su(gc.su(gc.su(f0, "damage", damage), "left", left), "wait", 0), "kind", kind)
      gc.push(s, "fields", f1)
    case False{}:
      s
# pub(super) fn tick_fields(&mut self)
def deathmatch.Session.tick_fields(+s: J.Val) -> J.Val:
  +fs = J.items(J.get(s, "fields"))
  +r = deathmatch.tick_fields.go(fs, J.set(s, "fields", J.JA{Nil{}}), J.JA{Nil{}})
  deathmatch.Session.tick_fields.k1(r)

def deathmatch.Session.tick_fields.k1(pr: J.Val & J.Val) -> J.Val:
  (+s2, +kept) = pr
  J.set(s2, "fields", kept)
def deathmatch.tick_fields.go(+fs: List<&2, J.Val>, +s: J.Val, +kept: J.Val) -> J.Val & J.Val:
  deathmatch.tick_fields.go.k1(fs, fs, s, kept)

def deathmatch.tick_fields.go.k2(cv: Bool, +s: J.Val, +kept: J.Val, +f: J.Val, +t: List<&2, J.Val>, +left: U32, +wait: U32) -> J.Val & J.Val:
  match cv:
    case True{}:
      +wait2 = gc.pu(String.eq(gc.s(f, "kind"), "Turret"), 20, 10)
      +s2 = deathmatch.Session.area(s, gc.u(f, "owner"), gc.f(f, "x"), gc.f(f, "y"), gc.f(f, "radius"), gc.u(f, "damage"))
      deathmatch.tick_fields.keep(t, s2, kept, gc.su(gc.su(f, "left", left), "wait", wait2), left)
    case False{}:
      deathmatch.tick_fields.keep(t, s, kept, gc.su(gc.su(f, "left", left), "wait", wait), left)

def deathmatch.tick_fields.go.k1(sv0: List<&2, J.Val>, +fs: List<&2, J.Val>, +s: J.Val, +kept: J.Val) -> J.Val & J.Val:
  match sv0:
    case Nil{}:
      (s, kept)
    case Con{+f, +t}:
      +left = gc.ssub(gc.u(f, "left"), 1)
      +wait = gc.ssub(gc.u(f, "wait"), 1)
      deathmatch.tick_fields.go.k2(Bool.and(U32.is_zero(wait), U32.is_gt(gc.u(f, "damage"), 0)), s, kept, f, t, left, wait)
def deathmatch.tick_fields.keep(+t: List<&2, J.Val>, +s: J.Val, +kept: J.Val, +f: J.Val, +left: U32) -> J.Val & J.Val:
  deathmatch.tick_fields.go(t, s, gc.ifj(U32.is_gt(left, 0), _ => J.push(kept, f), _ => kept))
# fn hit(&mut self, owner, target, damage, way) -> bool
def deathmatch.Session.hit(+s: J.Val, +owner: U32, +target: U32, +damage: U32, +wx: F32, +wy: F32) -> J.Val & Bool:
  deathmatch.Session.hit.k1(Bool.or(U32.is_eq(owner, target), Bool.or(Bool.not(J.is_null(J.get(s, "winner"))), Bool.not(gc.has_seat(J.get(s, "fighters"), owner)))), s, owner, target, damage, wx, wy)

def deathmatch.Session.hit.k4(pr: J.Val & Bool, +s: J.Val, +target: U32) -> J.Val & Bool:
  (+h2, +ignored) = pr
  (deathmatch.setH(s, target, h2), False{})

def deathmatch.Session.hit.k3(cv: Bool, +s: J.Val, +owner: U32, +target: U32, +damage: U32, +wx: F32, +wy: F32, +h: J.Val, +aim_dot: F32) -> J.Val & Bool:
  match cv:
    case True{}:
      +t = shield.Hero.shield_turned(h, damage)
      deathmatch.Session.hit.k4(t, s, target)
    case False{}:
      deathmatch.hit.land(s, owner, target, damage, h, gc.u(h, "hp"))

def deathmatch.Session.hit.k2(cv: Bool, +s: J.Val, +owner: U32, +target: U32, +damage: U32, +wx: F32, +wy: F32, +f: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      (s, False{})
    case False{}:
      +h = J.get(f, "hero")
      +aim_dot = (((wx * gc.f(h, "aim_x") : F32) + (wy * gc.f(h, "aim_y") : F32)) : F32)
      deathmatch.Session.hit.k3(Bool.or(shield.turns(h, wx, wy), Bool.and(gc.b(h, "walling"), F32.is_gt(F32.neg(aim_dot), 0.0))), s, owner, target, damage, wx, wy, h, aim_dot)

def deathmatch.Session.hit.k1(cv: Bool, +s: J.Val, +owner: U32, +target: U32, +damage: U32, +wx: F32, +wy: F32) -> J.Val & Bool:
  match cv:
    case True{}:
      (s, False{})
    case False{}:
      +f = deathmatch.F(s, target)
      deathmatch.Session.hit.k2(Bool.or(J.is_null(f), Bool.not(Bool.and(deathmatch.Fighter.alive(f), U32.is_zero(gc.u(f, "protection"))))), s, owner, target, damage, wx, wy, f)
def deathmatch.hit.land(+s: J.Val, +owner: U32, +target: U32, +damage: U32, +h: J.Val, +before: U32) -> J.Val & Bool:
  +h1 = gear.Hero.dress(hero.Hero.hurt(gc.su(h, "hit_ward", 0), damage))
  +s1 = deathmatch.setH(s, target, h1)
  deathmatch.hit.land.k1(U32.is_eq(gc.u(h1, "hp"), before), owner, target, before, h1, s1)

def deathmatch.hit.land.k2(cv: Bool, +owner: U32, +target: U32, +h1: J.Val, +s1: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      (deathmatch.hit.kill(s1, owner, target), True{})
    case False{}:
      (s1, True{})

def deathmatch.hit.land.k1(cv: Bool, +owner: U32, +target: U32, +before: U32, +h1: J.Val, +s1: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      (s1, False{})
    case False{}:
      deathmatch.hit.land.k2(U32.is_zero(gc.u(h1, "hp")), owner, target, h1, s1)
# The victim falls: respawn clock, a death; the killer a kill, the feed a line, ten kills the round.
def deathmatch.hit.kill(+s: J.Val, +owner: U32, +target: U32) -> J.Val:
  +fv = deathmatch.F(s, target)
  +fv1 = gc.su(gc.su(fv, "respawn", deathmatch.RESPAWN()), "deaths", gc.sadd16(gc.u(fv, "deaths"), 1))
  +s1 = deathmatch.setF(s, target, fv1)
  +fk = deathmatch.F(s1, owner)
  +fk1 = gc.su(fk, "kills", (gc.u(fk, "kills") + 1 : U32))
  +s2 = deathmatch.setF(s1, owner, fk1)
  +frag = gc.su(gc.su(gc.su(J.obj(), "killer", owner), "victim", target), "tick", gc.u(s2, "ticks"))
  +feed = J.push(J.get(s2, "feed"), frag)
  +feed2 = gc.ifj(U32.is_gt(gc.len(J.items(feed)), 5), _ => gc.remove(feed, 0), _ => feed)
  +s3 = J.set(s2, "feed", feed2)
  gc.ifj(U32.is_eq(gc.u(fk1, "kills"), deathmatch.GOAL()), _ => gc.su(J.set(s3, "winner", J.JU{owner}), "ended", 0), _ => s3)
# book.get(id): the card by name, or null.
def gc.book_get.go(+cards: List<&2, J.Val>, +id: String) -> J.Val:
  gc.book_get.go.k1(cards, cards, id)

def gc.book_get.go.k1(sv0: List<&2, J.Val>, +cards: List<&2, J.Val>, +id: String) -> J.Val:
  match sv0:
    case Nil{}:
      J.JNull{}
    case Con{+c, +t}:
      gc.ifj(String.eq(gc.s(c, "id"), id), _ => c, _ => gc.book_get.go(t, id))
def gc.book_get(+book: J.Val, +id: String) -> J.Val:
  gc.book_get.go(J.items(J.get(book, "cards")), id)
# Does knight `id`'s forged weapon have a melee worth swinging? Returns the melee object or null:
# a pure blade always, one with bolts only with another fighter within reach.
def deathmatch.forged_melee(+s: J.Val, +id: U32) -> J.Val:
  +h = deathmatch.H(s, id)
  +w = J.get(h, "forged")
  +m = J.get(w, "melee")
  deathmatch.forged_melee.k1(Bool.or(J.is_null(w), J.is_null(m)), s, id, h, w, m)

def deathmatch.forged_melee.k2(cv: Bool, +s: J.Val, +id: U32, +h: J.Val, +w: J.Val, +m: J.Val) -> J.Val:
  match cv:
    case True{}:
      m
    case False{}:
      gc.ifj(deathmatch.other_within(s, id, gc.ids(J.get(s, "fighters")), gc.f(h, "x"), gc.f(h, "y"), gc.f(m, "reach")), _ => m, _ => J.JNull{})

def deathmatch.forged_melee.k1(cv: Bool, +s: J.Val, +id: U32, +h: J.Val, +w: J.Val, +m: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.JNull{}
    case False{}:
      deathmatch.forged_melee.k2(Bool.and(J.is_null(J.get(w, "bolt")), J.is_null(J.get(w, "throw"))), s, id, h, w, m)
def deathmatch.other_within(+s: J.Val, +me: U32, +ids: List<&2, U32>, +x: F32, +y: F32, +reach: F32) -> Bool:
  deathmatch.other_within.k1(ids, s, me, ids, x, y, reach)

def deathmatch.other_within.k1(sv0: List<&2, U32>, +s: J.Val, +me: U32, +ids: List<&2, U32>, +x: F32, +y: F32, +reach: F32) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+id, +t}:
      +f = deathmatch.F(s, id)
      +near = Bool.and(Bool.not(U32.is_eq(id, me)), Bool.and(deathmatch.Fighter.alive(f), F32.is_le(RS.f_hypot((gc.f(J.get(f, "hero"), "x") - x : F32), (gc.f(J.get(f, "hero"), "y") - y : F32)), reach)))
      Bool.or(near, deathmatch.other_within(s, me, t, x, y, reach))
# fn attack(&mut self, id, input, book, seed)
def deathmatch.Session.attack(+s: J.Val, +id: U32, +input: J.Val, +book: J.Val, +seed: W.W) -> J.Val:
  +f = deathmatch.F(s, id)
  deathmatch.Session.attack.k1(Bool.or(Bool.not(J.is_null(J.get(s, "winner"))), Bool.or(Bool.not(deathmatch.Fighter.alive(f)), U32.is_gt(gc.u(f, "stun"), 0))), s, id, input, book, seed, f)

def deathmatch.Session.attack.k1(cv: Bool, +s: J.Val, +id: U32, +input: J.Val, +book: J.Val, +seed: W.W, +f: J.Val) -> J.Val:
  match cv:
    case True{}:
      s
    case False{}:
      +s1 = gc.ifj(gc.b(input, "cycle"), _ => deathmatch.cycle(s, id), _ => s)
      +s2 = deathmatch.attack.cast(s1, id, gc.u(input, "cast"), book)
      +s3 = deathmatch.attack.play(s2, id, gc.u(input, "play"), book)
      +s4 = deathmatch.attack.bomb(s3, id, gc.b(input, "bomb"))
      +s5 = deathmatch.attack.spin(s4, id)
      deathmatch.attack.swing(s5, id, input, book, seed)
def deathmatch.cycle(+s: J.Val, +id: U32) -> J.Val:
  +r = hero.Hero.cycle_hand(deathmatch.H(s, id))
  deathmatch.cycle.k1(r, s, id)

def deathmatch.cycle.k1(pr: J.Val & Bool, +s: J.Val, +id: U32) -> J.Val:
  (+h2, +moved) = pr
  deathmatch.setH(s, id, h2)
# Spell slot 1-4: a ready slot casts its card.
def deathmatch.attack.cast(+s: J.Val, +id: U32, +cast: U32, +book: J.Val) -> J.Val:
  +h = deathmatch.H(s, id)
  deathmatch.attack.cast.k1(Bool.or(U32.is_zero(cast), U32.is_gt(cast, cards.SPELL_SLOTS())), s, id, cast, book, h)

def deathmatch.attack.cast.k2(cv: Bool, +s: J.Val, +id: U32, +h: J.Val, +slot: U32, +card: J.Val) -> J.Val:
  match cv:
    case True{}:
      +h2 = J.set(h, "spell_cooldowns", J.set_nth(J.get(h, "spell_cooldowns"), slot, J.JU{spell_upgrades.Hero.spell_wait(h, card)}))
      deathmatch.Session.card(deathmatch.setH(s, id, h2), id, card)
    case False{}:
      s

def deathmatch.attack.cast.k1(cv: Bool, +s: J.Val, +id: U32, +cast: U32, +book: J.Val, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      s
    case False{}:
      +slot = (cast - 1 : U32)
      +name = J.nth(J.get(h, "spells"), slot)
      +card = gc.ifj(J.is_null(name), _ => J.JNull{}, _ => gc.book_get(book, J.str(name)))
      deathmatch.attack.cast.k2(Bool.and(U32.is_zero(J.u32(J.nth(J.get(h, "spell_cooldowns"), slot))), Bool.not(J.is_null(card))), s, id, h, slot, card)
def deathmatch.attack.play(+s: J.Val, +id: U32, +play: U32, +book: J.Val) -> J.Val:
  +h = deathmatch.H(s, id)
  deathmatch.attack.play.k1(U32.is_zero(play), s, id, play, book, h)

def deathmatch.attack.play.k2(cv: Bool, +s: J.Val, +id: U32, +book: J.Val, +h: J.Val, +slot: U32) -> J.Val:
  match cv:
    case True{}:
      +name = J.str(J.nth(J.get(h, "hand"), slot))
      +h2 = gc.su(J.set(h, "hand", gc.remove(J.get(h, "hand"), slot)), "play_cooldown", rules.PLAY_REARM())
      +card = gc.book_get(book, name)
      +s2 = deathmatch.setH(s, id, h2)
      gc.ifj(J.is_null(card), _ => s2, _ => deathmatch.Session.card(s2, id, card))
    case False{}:
      s

def deathmatch.attack.play.k1(cv: Bool, +s: J.Val, +id: U32, +play: U32, +book: J.Val, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      s
    case False{}:
      +slot = (play - 1 : U32)
      deathmatch.attack.play.k2(Bool.and(U32.is_zero(gc.u(h, "play_cooldown")), U32.is_lt(slot, gc.len(J.items(J.get(h, "hand"))))), s, id, book, h, slot)
def deathmatch.attack.bomb(+s: J.Val, +id: U32, +bomb: Bool) -> J.Val:
  +h = deathmatch.H(s, id)
  deathmatch.attack.bomb.k1(Bool.and(bomb, Bool.and(U32.is_gt(gc.u(h, "bombs"), 0), U32.is_zero(gc.u(h, "bomb_cooldown")))), s, id, bomb, h)

def deathmatch.attack.bomb.k1(cv: Bool, +s: J.Val, +id: U32, +bomb: Bool, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      +h2 = gc.su(gc.su(h, "bombs", (gc.u(h, "bombs") - 1 : U32)), "bomb_cooldown", rules.BOMB_REARM())
      +s2 = deathmatch.setF(deathmatch.setH(s, id, h2), id, gc.su(J.set(deathmatch.F(s, id), "hero", h2), "protection", 0))
      deathmatch.Session.area(s2, id, gc.f(h2, "x"), gc.f(h2, "y"), rules.BOMB_CLEAR(), rules.BOMB_DAMAGE())
    case False{}:
      s
def deathmatch.attack.spin(+s: J.Val, +id: U32) -> J.Val:
  +h = deathmatch.H(s, id)
  deathmatch.attack.spin.k1(Bool.and(U32.is_gt(gc.u(h, "spin"), 0), spin.sweeping(gc.ssub(spin.TICKS(), (gc.u(h, "spin") + 1 : U32)))), s, id, h)

def deathmatch.attack.spin.k1(cv: Bool, +s: J.Val, +id: U32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      deathmatch.Session.area(s, id, gc.f(h, "x"), gc.f(h, "y"), spin.REACH(), hero.Hero.scaled(h, 26))
    case False{}:
      s
def deathmatch.guarded(+h: J.Val) -> Bool:
  Bool.or(Bool.not(deathmatch.is_none_u(hero.Hero.rolling(h))), Bool.or(gc.b(h, "shielding"), Bool.or(gc.b(h, "walling"), deathmatch.busy(h))))
def deathmatch.is_none_u(+m: Maybe<&2, U32>) -> Bool:
  deathmatch.is_none_u.k1(m, m)

def deathmatch.is_none_u.k1(sv0: Maybe<&2, U32>, +m: Maybe<&2, U32>) -> Bool:
  match sv0:
    case None{}:
      True{}
    case Some{+v}:
      False{}
def deathmatch.busy(+h: J.Val) -> Bool:
  Bool.or(U32.is_gt(gc.u(J.get(h, "champ"), "windup"), 0), U32.is_gt(gc.u(J.get(h, "champ"), "haul"), 0))
# The sword swing, then the fire key.
def deathmatch.attack.swing(+s: J.Val, +id: U32, +input: J.Val, +book: J.Val, +seed: W.W) -> J.Val:
  +f = deathmatch.F(s, id)
  +h = J.get(f, "hero")
  +guarded = deathmatch.guarded(h)
  deathmatch.attack.swing.k1(Bool.and(gc.b(input, "swing"), Bool.and(U32.is_zero(gc.u(h, "sword_cooldown")), Bool.not(guarded))), s, id, input, book, seed, f, h, guarded)

def deathmatch.attack.swing.k1(cv: Bool, +s: J.Val, +id: U32, +input: J.Val, +book: J.Val, +seed: W.W, +f: J.Val, +h: J.Val, +guarded: Bool) -> J.Val:
  match cv:
    case True{}:
      +h2 = gc.su(h, "sword_cooldown", hero.Hero.cooldown(h, rules.SWORD_REARM()))
      +f2 = gc.su(gc.su(J.set(f, "hero", h2), "flash", 5), "protection", 0)
      +s2 = deathmatch.setF(s, id, f2)
      +s3 = deathmatch.Session.melee(s2, id, rules.SWORD_REACH(), rules.SWORD_ARC(), hero.Hero.scaled(h2, rules.SWORD_DAMAGE()))
      deathmatch.attack.fire(s3, id, input, book, seed)
    case False{}:
      deathmatch.attack.fire(s, id, input, book, seed)
def deathmatch.attack.fire(+s: J.Val, +id: U32, +input: J.Val, +book: J.Val, +seed: W.W) -> J.Val:
  +melee = deathmatch.forged_melee(s, id)
  +f = deathmatch.F(s, id)
  +h = J.get(f, "hero")
  deathmatch.attack.fire.k1(Bool.or(Bool.not(gc.b(input, "fire")), Bool.or(U32.is_gt(gc.u(h, "fire_cooldown"), 0), deathmatch.guarded(h))), s, id, input, book, seed, melee, f, h)

def deathmatch.attack.fire.k1(cv: Bool, +s: J.Val, +id: U32, +input: J.Val, +book: J.Val, +seed: W.W, +melee: J.Val, +f: J.Val, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      s
    case False{}:
      +start = gc.len(J.items(J.get(s, "shots")))
      +s1 = deathmatch.setF(s, id, gc.su(gc.su(f, "protection", 0), "flash", 4))
      +s2 = deathmatch.fire.kind(s1, id, melee, book, seed)
      +s3 = deathmatch.shape_from(s2, start)
      +s4 = gc.ifj(U32.is_gt(gc.u(deathmatch.F(s3, id), "power"), 0), _ => deathmatch.power_from(s3, start), _ => s3)
      J.set(s4, "shots", J.truncate(J.get(s4, "shots"), rules.MAX_PROJECTILES()))
# wishcraft::shape(&mut shots[start..])
def deathmatch.shape_from(+s: J.Val, +start: U32) -> J.Val:
  +shots = J.get(s, "shots")
  +head = J.truncate(shots, start)
  +tail = gc.drop_front(shots, start)
  J.set(s, "shots", J.JA{List.append(&2, J.Val, J.items(head), J.items(wishcraft.shape(tail)))})
# for p in shots[start..]: p.damage = p.damage * 3 / 2
def deathmatch.power_from(+s: J.Val, +start: U32) -> J.Val:
  +shots = J.get(s, "shots")
  +head = J.truncate(shots, start)
  +tail = deathmatch.power_all(J.items(gc.drop_front(shots, start)))
  J.set(s, "shots", J.JA{List.append(&2, J.Val, J.items(head), tail)})
def deathmatch.power_all(+ps: List<&2, J.Val>) -> List<&2, J.Val>:
  deathmatch.power_all.k1(ps, ps)

def deathmatch.power_all.k1(sv0: List<&2, J.Val>, +ps: List<&2, J.Val>) -> List<&2, J.Val>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+p, +t}:
      gc.su(p, "damage", U32.div((gc.u(p, "damage") * 3 : U32), 2)) <> deathmatch.power_all(t)
def deathmatch.fire.kind(+s: J.Val, +id: U32, +melee: J.Val, +book: J.Val, +seed: W.W) -> J.Val:
  +f = deathmatch.F(s, id)
  +h = J.get(f, "hero")
  +power = U32.is_gt(gc.u(f, "power"), 0)
  deathmatch.fire.kind.k1(String.eq(champions.of(h), "alchemist"), s, id, melee, book, seed, h, power)

def deathmatch.fire.kind.k4(pr: J.Val & J.Val, +s: J.Val, +id: U32) -> J.Val:
  (+h2, +shots) = pr
  J.set(deathmatch.setH(s, id, h2), "shots", shots)

def deathmatch.fire.kind.k3(cv: Bool, +s: J.Val, +id: U32, +melee: J.Val, +book: J.Val, +seed: W.W, +h: J.Val, +power: Bool) -> J.Val:
  match cv:
    case True{}:
      +fury = U32.is_gt(gc.u(J.get(h, "champ"), "fury"), 0)
      +h2 = gc.su(h, "fire_cooldown", hero.Hero.cooldown(h, gc.pu(fury, U32.div(gc.u(melee, "every"), 2), gc.u(melee, "every"))))
      +d1 = U32.div((hero.Hero.scaled(h2, gc.u(melee, "damage")) * gc.pu(fury, 3, 2) : U32), 2)
      +damage = U32.div((d1 * gc.pu(power, 3, 2) : U32), 2)
      deathmatch.Session.melee(deathmatch.setH(s, id, h2), id, gc.f(melee, "reach"), gc.f(melee, "arc"), damage)
    case False{}:
      +flying = deathmatch.flying(J.items(J.get(s, "shots")), id)
      +rng = rules.mix(W.xor(W.xor(seed, W.mul_u32(W.of_u32(gc.u(s, "ticks")), 40503)), W.shl(W.of_u32(id), 48)))
      +r = hero.Hero.loose(h, id, book, False{}, rng, flying, J.get(s, "shots"))
      deathmatch.fire.kind.k4(r, s, id)

def deathmatch.fire.kind.k2(cv: Bool, +s: J.Val, +id: U32, +melee: J.Val, +book: J.Val, +seed: W.W, +h: J.Val, +power: Bool) -> J.Val:
  match cv:
    case True{}:
      +h2 = gc.su(h, "fire_cooldown", hero.Hero.cooldown(h, 9))
      +damage = U32.div((hero.Hero.scaled(h2, 6) * gc.pu(power, 3, 2) : U32), 2)
      deathmatch.Session.melee(deathmatch.setH(s, id, h2), id, 1.5, 100.0, damage)
    case False{}:
      deathmatch.fire.kind.k3(Bool.not(J.is_null(melee)), s, id, melee, book, seed, h, power)

def deathmatch.fire.kind.k1(cv: Bool, +s: J.Val, +id: U32, +melee: J.Val, +book: J.Val, +seed: W.W, +h: J.Val, +power: Bool) -> J.Val:
  match cv:
    case True{}:
      +h2 = gc.su(h, "fire_cooldown", hero.Hero.cooldown(h, champions.FLASK_REARM()))
      +s2 = deathmatch.setH(s, id, h2)
      deathmatch.Session.bolt(s2, id, "ember", hero.Hero.scaled(h2, champions.FLASK_DAMAGE()), 16.0, 18, 100, 0)
    case False{}:
      deathmatch.fire.kind.k2(gear.Hero.unarmed(h), s, id, melee, book, seed, h, power)
def deathmatch.flying(+ps: List<&2, J.Val>, +id: U32) -> U32:
  deathmatch.flying.k1(ps, ps, id)

def deathmatch.flying.k1(sv0: List<&2, J.Val>, +ps: List<&2, J.Val>, +id: U32) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+p, +t}:
      (gc.pu(U32.is_eq(gc.u(J.get(p, "traits"), "owner"), id), 1, 0) + deathmatch.flying(t, id) : U32)
def deathmatch.mend(+s: J.Val, +id: U32, +amount: U32) -> J.Val:
  +r = stakes.Hero.mend(deathmatch.H(s, id), amount, 1)
  deathmatch.mend.k1(r, s, id)

def deathmatch.mend.k1(pr: J.Val & U32, +s: J.Val, +id: U32) -> J.Val:
  (+h2, +gain) = pr
  deathmatch.setH(s, id, h2)
# fn card(&mut self, id, card)
def deathmatch.Session.card(+s: J.Val, +id: U32, +card: J.Val) -> J.Val:
  +f = deathmatch.F(s, id)
  +f1 = gc.su(gc.su(f, "protection", 0), "flash", 5)
  +r = hero.Hero.spend(J.get(f1, "hero"), card)
  deathmatch.Session.card.k1(r, s, id, card, f1)

def deathmatch.Session.card.k2(pr: U32 & U32, +s: J.Val, +id: U32, +card: J.Val, +f1: J.Val, +h: J.Val) -> J.Val:
  (+score, +nova) = pr
  +s1 = deathmatch.setF(s, id, J.set(f1, "hero", h))
  +aimx = (gc.f(h, "x") + (gc.f(h, "aim_x") * 6.0 : F32) : F32)
  +aimy = (gc.f(h, "y") + (gc.f(h, "aim_y") * 6.0 : F32) : F32)
  +damage = spell_upgrades.Hero.spell_damage(h, gc.s(card, "id"), 40)
  +start = gc.len(J.items(J.get(s1, "shots")))
  +s2 = deathmatch.card.casts(s1, id, card, J.items(J.get(card, "effects")))
  +s3 = deathmatch.shape_from(s2, start)
  +s4 = gc.ifj(U32.is_gt(gc.u(deathmatch.F(s3, id), "power"), 0), _ => deathmatch.power_from(s3, start), _ => s3)
  +s5 = gc.ifj(U32.is_gt(nova, 0), _ => deathmatch.Session.area(s4, id, gc.f(h, "x"), gc.f(h, "y"), 9.0, nova), _ => s4)
  +s6 = deathmatch.card.effects(s5, id, J.items(J.get(card, "effects")), gc.f(h, "x"), gc.f(h, "y"), aimx, aimy, damage)
  +s7 = deathmatch.card.named(s6, id, gc.s(card, "id"), aimx, aimy)
  J.set(s7, "shots", J.truncate(J.get(s7, "shots"), rules.MAX_PROJECTILES()))

def deathmatch.Session.card.k1(pr: J.Val & U32 & U32, +s: J.Val, +id: U32, +card: J.Val, +f1: J.Val) -> J.Val:
  (+h, +sn) = pr
  deathmatch.Session.card.k2(sn, s, id, card, f1, h)
# for effect in effects: if Cast(shape): hero.spell_shots(shape, card.id, id, shots)
def deathmatch.card.casts(+s: J.Val, +id: U32, +card: J.Val, +es: List<&2, J.Val>) -> J.Val:
  deathmatch.card.casts.k1(es, s, id, card, es)

def deathmatch.card.casts.k2(cv: Bool, +s: J.Val, +id: U32, +card: J.Val, +e: J.Val, +t: List<&2, J.Val>) -> J.Val:
  match cv:
    case True{}:
      +shots = spells.Hero.spell_shots(deathmatch.H(s, id), J.str(J.get(e, "cast")), gc.s(card, "id"), id, J.get(s, "shots"))
      deathmatch.card.casts(J.set(s, "shots", shots), id, card, t)
    case False{}:
      deathmatch.card.casts(s, id, card, t)

def deathmatch.card.casts.k1(sv0: List<&2, J.Val>, +s: J.Val, +id: U32, +card: J.Val, +es: List<&2, J.Val>) -> J.Val:
  match sv0:
    case Nil{}:
      s
    case Con{+e, +t}:
      deathmatch.card.casts.k2(J.has(e, "cast"), s, id, card, e, t)
# The second pass over the effects: rips, cabbages, hedges, decoys, turrets.
def deathmatch.card.effects(+s: J.Val, +id: U32, +es: List<&2, J.Val>, +x: F32, +y: F32, +aimx: F32, +aimy: F32, +damage: U32) -> J.Val:
  deathmatch.card.effects.k1(es, s, id, es, x, y, aimx, aimy, damage)

def deathmatch.card.effects.k1(sv0: List<&2, J.Val>, +s: J.Val, +id: U32, +es: List<&2, J.Val>, +x: F32, +y: F32, +aimx: F32, +aimy: F32, +damage: U32) -> J.Val:
  match sv0:
    case Nil{}:
      s
    case Con{+e, +t}:
      +s2 = deathmatch.card.effect(s, id, e, x, y, aimx, aimy, damage)
      deathmatch.card.effects(s2, id, t, x, y, aimx, aimy, damage)
def deathmatch.card.effect(+s: J.Val, +id: U32, +e: J.Val, +x: F32, +y: F32, +aimx: F32, +aimy: F32, +damage: U32) -> J.Val:
  deathmatch.card.effect.k1(J.has(e, "rip"), s, id, e, x, y, aimx, aimy, damage)

def deathmatch.card.effect.k8(cv: Bool, +s: J.Val, +id: U32, +e: J.Val, +x: F32, +y: F32) -> J.Val:
  match cv:
    case True{}:
      deathmatch.Session.field(s, id, x, y, 10.0, gc.umax(J.u32(J.get(e, "warden")), 8), (8 * rules.HZ() : U32), "Turret")
    case False{}:
      s

def deathmatch.card.effect.k7(cv: Bool, +s: J.Val, +id: U32, +e: J.Val, +x: F32, +y: F32) -> J.Val:
  match cv:
    case True{}:
      deathmatch.Session.field(s, id, x, y, 10.0, gc.umax(J.u32(J.get(e, "totem")), 8), (8 * rules.HZ() : U32), "Turret")
    case False{}:
      deathmatch.card.effect.k8(J.has(e, "warden"), s, id, e, x, y)

def deathmatch.card.effect.k6(cv: Bool, +s: J.Val, +id: U32, +e: J.Val, +x: F32, +y: F32) -> J.Val:
  match cv:
    case True{}:
      deathmatch.Session.field(s, id, x, y, 10.0, gc.umax(J.u32(J.get(e, "ghoul")), 8), (8 * rules.HZ() : U32), "Turret")
    case False{}:
      deathmatch.card.effect.k7(J.has(e, "totem"), s, id, e, x, y)

def deathmatch.card.effect.k5(cv: Bool, +s: J.Val, +id: U32, +e: J.Val, +x: F32, +y: F32) -> J.Val:
  match cv:
    case True{}:
      deathmatch.Session.field(s, id, x, y, 10.0, gc.umax(J.u32(J.nth(J.get(e, "summon"), 0)), 8), (8 * rules.HZ() : U32), "Turret")
    case False{}:
      deathmatch.card.effect.k6(J.has(e, "ghoul"), s, id, e, x, y)

def deathmatch.card.effect.k4(cv: Bool, +s: J.Val, +id: U32, +e: J.Val, +x: F32, +y: F32) -> J.Val:
  match cv:
    case True{}:
      deathmatch.Session.field(s, id, x, y, 1.0, 0, (5 * rules.HZ() : U32), "Decoy")
    case False{}:
      deathmatch.card.effect.k5(J.has(e, "summon"), s, id, e, x, y)

def deathmatch.card.effect.k3(cv: Bool, +s: J.Val, +id: U32, +e: J.Val, +x: F32, +y: F32, +aimx: F32, +aimy: F32) -> J.Val:
  match cv:
    case True{}:
      deathmatch.Session.field(s, id, aimx, aimy, 3.0, 0, (5 * rules.HZ() : U32), "Hedge")
    case False{}:
      deathmatch.card.effect.k4(J.has(e, "imposture"), s, id, e, x, y)

def deathmatch.card.effect.k2(cv: Bool, +s: J.Val, +id: U32, +e: J.Val, +x: F32, +y: F32, +aimx: F32, +aimy: F32, +damage: U32) -> J.Val:
  match cv:
    case True{}:
      +n = J.u32(J.get(e, "cabbages"))
      deathmatch.Session.field(s, id, aimx, aimy, 3.2, damage, gc.umax((gc.umin(n, 8) * 10 : U32), 10), "Hazard")
    case False{}:
      deathmatch.card.effect.k3(J.has(e, "hedge"), s, id, e, x, y, aimx, aimy)

def deathmatch.card.effect.k1(cv: Bool, +s: J.Val, +id: U32, +e: J.Val, +x: F32, +y: F32, +aimx: F32, +aimy: F32, +damage: U32) -> J.Val:
  match cv:
    case True{}:
      +n = J.u32(J.get(e, "rip"))
      deathmatch.mend(deathmatch.Session.area(s, id, aimx, aimy, 4.0, n), id, U32.div(n, 2))
    case False{}:
      deathmatch.card.effect.k2(J.has(e, "cabbages"), s, id, e, x, y, aimx, aimy, damage)
# The champions' own spells, by card id.
def deathmatch.card.named(+s: J.Val, +id: U32, +name: String, +aimx: F32, +aimy: F32) -> J.Val:
  +h = deathmatch.H(s, id)
  deathmatch.card.named.k1(String.eq(name, "storm-hammer"), s, id, name, aimx, aimy, h)

def deathmatch.card.named.k7(pr: F32 & F32, +s: J.Val, +id: U32, +h: J.Val) -> J.Val:
  (+nx, +ny) = pr
  deathmatch.setH(s, id, gc.sf(gc.sf(h, "x", nx), "y", ny))

def deathmatch.card.named.k10(cv: Bool, +s: J.Val, +id: U32, +name: String, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      deathmatch.mend(s, id, spell_upgrades.Hero.spell_power(h, name, champions.ELIXIR_MEND()))
    case False{}:
      s

def deathmatch.card.named.k9(cv: Bool, +s: J.Val, +id: U32, +name: String, +aimx: F32, +aimy: F32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      +st = spell_upgrades.Hero.spell_step(h, name)
      deathmatch.Session.field(s, id, aimx, aimy, gc.f(st, "quick_reach"), spell_upgrades.Hero.spell_damage(h, name, champions.QUICK_DAMAGE()), gc.u(st, "quick_life"), "Hazard")
    case False{}:
      deathmatch.card.named.k10(String.eq(name, "elixir"), s, id, name, h)

def deathmatch.card.named.k8(cv: Bool, +s: J.Val, +id: U32, +name: String, +aimx: F32, +aimy: F32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      deathmatch.Session.field(s, id, aimx, aimy, 3.0, champions.FOUL_POWER(), (5 * rules.HZ() : U32), "Hazard")
    case False{}:
      deathmatch.card.named.k9(String.eq(name, "quickfire"), s, id, name, aimx, aimy, h)

def deathmatch.card.named.k6(cv: Bool, +s: J.Val, +id: U32, +name: String, +aimx: F32, +aimy: F32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      +reach = gc.f(spell_upgrades.Hero.spell_step(h, name), "haul_reach")
      +p = rules.Grid.halted(deathmatch.room(), False{}, (gc.f(h, "x"), gc.f(h, "y")), ((gc.f(h, "aim_x") * reach : F32), (gc.f(h, "aim_y") * reach : F32)))
      deathmatch.card.named.k7(p, s, id, h)
    case False{}:
      deathmatch.card.named.k8(String.eq(name, "miasma-flask"), s, id, name, aimx, aimy, h)

def deathmatch.card.named.k5(cv: Bool, +s: J.Val, +id: U32, +name: String, +aimx: F32, +aimy: F32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      +c = J.set(deathmatch.stance(h), "rot", J.get(spell_upgrades.Hero.spell_step(h, name), "rot"))
      deathmatch.setH(s, id, deathmatch.put_champ(h, c))
    case False{}:
      deathmatch.card.named.k6(String.eq(name, "chain-haul"), s, id, name, aimx, aimy, h)

def deathmatch.card.named.k4(cv: Bool, +s: J.Val, +id: U32, +name: String, +aimx: F32, +aimy: F32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      deathmatch.Session.bolt(s, id, "blade", spell_upgrades.Hero.spell_damage(h, name, champions.HOOK_DAMAGE()), champions.HOOK_SPEED(), 18, 0, 30)
    case False{}:
      deathmatch.card.named.k5(String.eq(name, "rot"), s, id, name, aimx, aimy, h)

def deathmatch.card.named.k3(cv: Bool, +s: J.Val, +id: U32, +name: String, +aimx: F32, +aimy: F32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      +c = J.set(deathmatch.stance(h), "fury", J.get(spell_upgrades.Hero.spell_step(h, name), "fury"))
      deathmatch.setH(s, id, deathmatch.put_champ(h, c))
    case False{}:
      deathmatch.card.named.k4(String.eq(name, "meat-hook"), s, id, name, aimx, aimy, h)

def deathmatch.card.named.k2(cv: Bool, +s: J.Val, +id: U32, +name: String, +aimx: F32, +aimy: F32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      +c = J.set(deathmatch.stance(h), "windup", J.JU{champions.SLAM_WINDUP()})
      deathmatch.setH(s, id, deathmatch.put_champ(h, c))
    case False{}:
      deathmatch.card.named.k3(String.eq(name, "brute-force"), s, id, name, aimx, aimy, h)

def deathmatch.card.named.k1(cv: Bool, +s: J.Val, +id: U32, +name: String, +aimx: F32, +aimy: F32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      deathmatch.Session.bolt(s, id, "sacred", spell_upgrades.Hero.spell_damage(h, name, champions.HAMMER_DAMAGE()), champions.HAMMER_SPEED(), champions.HAMMER_LIFE(), 100, 30)
    case False{}:
      deathmatch.card.named.k2(String.eq(name, "groundslam"), s, id, name, aimx, aimy, h)
# fn fly(&mut self): the shots in flight, one at a time, in order.
def deathmatch.Session.fly(+s: J.Val) -> J.Val:
  +orbs = deathmatch.orbs(s, gc.ids(J.get(s, "fighters")))
  +r = deathmatch.fly.go(J.items(J.get(s, "shots")), J.set(s, "shots", J.JA{Nil{}}), orbs, Nil{}, Nil{})
  deathmatch.Session.fly.k1(r, r)

def deathmatch.Session.fly.k1(sv0: GcFly, +r: GcFly) -> J.Val:
  match sv0:
    case GcFly{+s2, +children, +out}:
      +s3 = deathmatch.fly.embers(s2, out)
      +kept = deathmatch.fly.alive(out)
      +room = gc.ssub(rules.MAX_PROJECTILES(), gc.len(kept))
      J.set(s3, "shots", J.JA{List.append(&2, J.Val, kept, J.items(J.truncate(J.JA{children}, room)))})
# the orbits of living, unprotected fighters
def deathmatch.orbs(+s: J.Val, +ids: List<&2, U32>) -> List<&2, GcOrb>:
  deathmatch.orbs.k1(ids, s, ids)

def deathmatch.orbs.k2(cv: Bool, +s: J.Val, +id: U32, +t: List<&2, U32>, +f: J.Val) -> List<&2, GcOrb>:
  match cv:
    case True{}:
      List.append(&2, GcOrb, deathmatch.orb_of(id, deathmatch.orbit_points(J.get(f, "hero"), id, W.of_u32(gc.u(s, "ticks")))), deathmatch.orbs(s, t))
    case False{}:
      deathmatch.orbs(s, t)

def deathmatch.orbs.k1(sv0: List<&2, U32>, +s: J.Val, +ids: List<&2, U32>) -> List<&2, GcOrb>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      +f = deathmatch.F(s, id)
      deathmatch.orbs.k2(Bool.and(deathmatch.Fighter.alive(f), U32.is_zero(gc.u(f, "protection"))), s, id, t, f)
def deathmatch.orb_of(+id: U32, +ps: List<&2, GcPt>) -> List<&2, GcOrb>:
  deathmatch.orb_of.k1(ps, id, ps)

def deathmatch.orb_of.k2(sv0: GcPt, +id: U32, +p: GcPt, +t: List<&2, GcPt>) -> List<&2, GcOrb>:
  match sv0:
    case GcPt{+x, +y}:
      GcOrb{id, x, y} <> deathmatch.orb_of(id, t)

def deathmatch.orb_of.k1(sv0: List<&2, GcPt>, +id: U32, +ps: List<&2, GcPt>) -> List<&2, GcOrb>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+p, +t}:
      deathmatch.orb_of.k2(p, id, p, t)
def deathmatch.fly.alive(+ps: List<&2, J.Val>) -> List<&2, J.Val>:
  deathmatch.fly.alive.k1(ps, ps)

def deathmatch.fly.alive.k1(sv0: List<&2, J.Val>, +ps: List<&2, J.Val>) -> List<&2, J.Val>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+p, +t}:
      gc.ifx_j(U32.is_gt(gc.u(p, "ttl"), 0), p, deathmatch.fly.alive(t))
def gc.ifx_j(+yes: Bool, +p: J.Val, +rest: List<&2, J.Val>) -> List<&2, J.Val>:
  match yes:
    case True{}:
      p <> rest
    case False{}:
      rest
# A spent flask bursts and sets the ground alight (for the Alchemist that threw it).
def deathmatch.fly.embers(+s: J.Val, +ps: List<&2, J.Val>) -> J.Val:
  deathmatch.fly.embers.k1(ps, s, ps)

def deathmatch.fly.embers.k2(cv: Bool, +s: J.Val, +p: J.Val, +t: List<&2, J.Val>, +owner: U32) -> J.Val:
  match cv:
    case True{}:
      +s1 = deathmatch.Session.area(s, owner, gc.f(p, "x"), gc.f(p, "y"), champions.FLASK_BURST(), gc.u(p, "damage"))
      +s2 = deathmatch.Session.field(s1, owner, gc.f(p, "x"), gc.f(p, "y"), champions.FLASK_FIRE(), U32.div(gc.u(p, "damage"), 4), champions.FLASK_FIRE_LIFE(), "Hazard")
      deathmatch.fly.embers(s2, t)
    case False{}:
      deathmatch.fly.embers(s, t)

def deathmatch.fly.embers.k1(sv0: List<&2, J.Val>, +s: J.Val, +ps: List<&2, J.Val>) -> J.Val:
  match sv0:
    case Nil{}:
      s
    case Con{+p, +t}:
      +owner = gc.u(J.get(p, "traits"), "owner")
      deathmatch.fly.embers.k2(Bool.and(U32.is_zero(gc.u(p, "ttl")), Bool.and(String.eq(gc.s(p, "kind"), "ember"), Bool.and(gc.has_seat(J.get(s, "fighters"), owner), String.eq(champions.of(deathmatch.H(s, owner)), "alchemist")))), s, p, t, owner)
def deathmatch.fly.go(+shots: List<&2, J.Val>, +s: J.Val, +orbs: List<&2, GcOrb>, +children: List<&2, J.Val>, +out: List<&2, J.Val>) -> GcFly:
  deathmatch.fly.go.k1(shots, shots, s, orbs, children, out)

def deathmatch.fly.go.k3(sv0: GcShot, +orbs: List<&2, GcOrb>, +out: List<&2, J.Val>, +t: List<&2, J.Val>, +r: GcShot) -> GcFly:
  match sv0:
    case GcShot{+s2, +p2, +children2}:
      deathmatch.fly.go(t, s2, orbs, children2, p2 <> out)

def deathmatch.fly.go.k2(cv: Bool, +s: J.Val, +orbs: List<&2, GcOrb>, +children: List<&2, J.Val>, +out: List<&2, J.Val>, +p: J.Val, +t: List<&2, J.Val>) -> GcFly:
  match cv:
    case True{}:
      deathmatch.fly.go(t, s, orbs, children, p <> out)
    case False{}:
      +r = deathmatch.fly.shot(s, gc.su(p, "ttl", (gc.u(p, "ttl") - 1 : U32)), orbs, children)
      deathmatch.fly.go.k3(r, orbs, out, t, r)

def deathmatch.fly.go.k1(sv0: List<&2, J.Val>, +shots: List<&2, J.Val>, +s: J.Val, +orbs: List<&2, GcOrb>, +children: List<&2, J.Val>, +out: List<&2, J.Val>) -> GcFly:
  match sv0:
    case Nil{}:
      GcFly{s, children, List.reverse(&2, J.Val, out)}
    case Con{+p, +t}:
      deathmatch.fly.go.k2(Bool.or(U32.is_zero(gc.u(p, "ttl")), Bool.not(J.is_null(J.get(s, "winner")))), s, orbs, children, out, p, t)
# The nearest living, unprotected fighter in sight of the shot (not its owner); 0 for none.
def deathmatch.target(+s: J.Val, +owner: U32, +px: F32, +py: F32, +ids: List<&2, U32>, +best: U32, +bestd: F32) -> U32:
  deathmatch.target.k1(ids, s, owner, px, py, ids, best, bestd)

def deathmatch.target.k2(cv: Bool, +s: J.Val, +owner: U32, +px: F32, +py: F32, +best: U32, +bestd: F32, +id: U32, +t: List<&2, U32>, +ok: Bool, +d: F32) -> U32:
  match cv:
    case True{}:
      deathmatch.target(s, owner, px, py, t, id, d)
    case False{}:
      deathmatch.target(s, owner, px, py, t, best, bestd)

def deathmatch.target.k1(sv0: List<&2, U32>, +s: J.Val, +owner: U32, +px: F32, +py: F32, +ids: List<&2, U32>, +best: U32, +bestd: F32) -> U32:
  match sv0:
    case Nil{}:
      best
    case Con{+id, +t}:
      +f = deathmatch.F(s, id)
      +fx = gc.f(J.get(f, "hero"), "x")
      +fy = gc.f(J.get(f, "hero"), "y")
      +ok = Bool.and(Bool.not(U32.is_eq(id, owner)), Bool.and(deathmatch.Fighter.alive(f), Bool.and(U32.is_zero(gc.u(f, "protection")), deathmatch.sight(px, py, fx, fy))))
      +d = RS.f_hypot((fx - px : F32), (fy - py : F32))
      deathmatch.target.k2(Bool.and(ok, Bool.or(U32.is_zero(best), F32.is_lt(d, bestd))), s, owner, px, py, best, bestd, id, t, ok, d)
# fn fly's per-shot body, after the ttl tick.
def deathmatch.fly.shot(+s: J.Val, +p: J.Val, +orbs: List<&2, GcOrb>, +children: List<&2, J.Val>) -> GcShot:
  +owner = gc.u(J.get(p, "traits"), "owner")
  +target = deathmatch.target(s, owner, gc.f(p, "x"), gc.f(p, "y"), gc.ids(J.get(s, "fighters")), 0, 0.0)
  +tr = J.get(p, "traits")
  +p1 = gc.ifj(U32.is_eq(gc.u(tr, "back"), 1), _ => deathmatch.fly.out(p), _ => p)
  deathmatch.fly.shot.k1(U32.is_eq(gc.u(J.get(p1, "traits"), "back"), 2), s, orbs, children, owner, target, tr, p1)

def deathmatch.fly.shot.k2(cv: Bool, +s: J.Val, +orbs: List<&2, GcOrb>, +children: List<&2, J.Val>, +owner: U32, +target: U32, +tr: J.Val, +p1: J.Val) -> GcShot:
  match cv:
    case True{}:
      deathmatch.fly.move(s, deathmatch.fly.home(s, p1, owner, target), orbs, children, owner)
    case False{}:
      deathmatch.fly.move(s, p1, orbs, children, owner)

def deathmatch.fly.shot.k1(cv: Bool, +s: J.Val, +orbs: List<&2, GcOrb>, +children: List<&2, J.Val>, +owner: U32, +target: U32, +tr: J.Val, +p1: J.Val) -> GcShot:
  match cv:
    case True{}:
      deathmatch.fly.back(s, p1, orbs, children, owner)
    case False{}:
      deathmatch.fly.shot.k2(Bool.and(U32.is_gt(gc.u(tr, "homing"), 0), Bool.not(U32.is_zero(target))), s, orbs, children, owner, target, tr, p1)
# A thrown blade flying out: the leg counts down, and at zero turns for home (it may strike again).
def deathmatch.fly.out(+p: J.Val) -> J.Val:
  +tr = J.get(p, "traits")
  +out = gc.ssub(gc.u(tr, "out"), 1)
  deathmatch.fly.out.k1(U32.is_zero(out), p, tr, out)

def deathmatch.fly.out.k1(cv: Bool, +p: J.Val, +tr: J.Val, +out: U32) -> J.Val:
  match cv:
    case True{}:
      gc.snull(J.set(p, "traits", gc.su(gc.su(tr, "out", out), "back", 2)), "last_hit")
    case False{}:
      J.set(p, "traits", gc.su(tr, "out", out))
# A returning blade flies at its owner's hand; within 0.7 it is caught.
def deathmatch.fly.back(+s: J.Val, +p: J.Val, +orbs: List<&2, GcOrb>, +children: List<&2, J.Val>, +owner: U32) -> GcShot:
  deathmatch.fly.back.k1(gc.has_seat(J.get(s, "fighters"), owner), s, p, orbs, children, owner)

def deathmatch.fly.back.k2(cv: Bool, +s: J.Val, +p: J.Val, +orbs: List<&2, GcOrb>, +children: List<&2, J.Val>, +owner: U32, +f: J.Val, +d: F32) -> GcShot:
  match cv:
    case True{}:
      GcShot{s, gc.su(p, "ttl", 0), children}
    case False{}:
      +speed = RS.f_hypot(gc.f(p, "vx"), gc.f(p, "vy"))
      +p3 = gc.sf(gc.sf(p, "vx", (((gc.f(J.get(f, "hero"), "x") - gc.f(p, "x") : F32) / d : F32) * speed : F32)), "vy", (((gc.f(J.get(f, "hero"), "y") - gc.f(p, "y") : F32) / d : F32) * speed : F32))
      deathmatch.fly.move(s, p3, orbs, children, owner)

def deathmatch.fly.back.k1(cv: Bool, +s: J.Val, +p: J.Val, +orbs: List<&2, GcOrb>, +children: List<&2, J.Val>, +owner: U32) -> GcShot:
  match cv:
    case True{}:
      +f = deathmatch.F(s, owner)
      +d = RS.f_hypot((gc.f(J.get(f, "hero"), "x") - gc.f(p, "x") : F32), (gc.f(J.get(f, "hero"), "y") - gc.f(p, "y") : F32))
      deathmatch.fly.back.k2(F32.is_lt(d, 0.7), s, p, orbs, children, owner, f, d)
    case False{}:
      deathmatch.fly.move(s, p, orbs, children, owner)
# A homing shot bends toward the nearest fighter, or a decoy nearer than it.
def deathmatch.fly.home(+s: J.Val, +p: J.Val, +owner: U32, +target: U32) -> J.Val:
  +f = deathmatch.F(s, target)
  +aim = deathmatch.decoy_aim(J.items(J.get(s, "fields")), owner, gc.f(p, "x"), gc.f(p, "y"), gc.f(J.get(f, "hero"), "x"), gc.f(J.get(f, "hero"), "y"))
  deathmatch.fly.home.k1(aim, p)

def deathmatch.fly.home.k1(pr: F32 & F32, +p: J.Val) -> J.Val:
  (+ax, +ay) = pr
  +now = F32.atan2(gc.f(p, "vy"), gc.f(p, "vx"))
  +want = F32.atan2((ay - gc.f(p, "y") : F32), (ax - gc.f(p, "x") : F32))
  +turn = F32.atan2(F32.sin((want - now : F32)), F32.cos((want - now : F32)))
  +lim = ((rules.HOMING_TURN() * RS.u_as_f32(gc.u(J.get(p, "traits"), "homing")) : F32) * rules.DT() : F32)
  +a = (now + RS.f_clamp(turn, F32.neg(lim), lim) : F32)
  +speed = RS.f_hypot(gc.f(p, "vx"), gc.f(p, "vy"))
  gc.sf(gc.sf(p, "vx", (F32.cos(a) * speed : F32)), "vy", (F32.sin(a) * speed : F32))
def deathmatch.decoy_aim(+fs: List<&2, J.Val>, +owner: U32, +px: F32, +py: F32, +ax: F32, +ay: F32) -> F32 & F32:
  deathmatch.decoy_aim.k1(fs, fs, owner, px, py, ax, ay)

def deathmatch.decoy_aim.k3(cv: Bool, +owner: U32, +px: F32, +py: F32, +ax: F32, +ay: F32, +f: J.Val, +t: List<&2, J.Val>) -> F32 & F32:
  match cv:
    case True{}:
      deathmatch.decoy_aim(t, owner, px, py, gc.f(f, "x"), gc.f(f, "y"))
    case False{}:
      deathmatch.decoy_aim(t, owner, px, py, ax, ay)

def deathmatch.decoy_aim.k2(cv: Bool, +owner: U32, +px: F32, +py: F32, +ax: F32, +ay: F32, +f: J.Val, +t: List<&2, J.Val>) -> F32 & F32:
  match cv:
    case True{}:
      deathmatch.decoy_aim.k3(F32.is_lt(RS.f_hypot((gc.f(f, "x") - px : F32), (gc.f(f, "y") - py : F32)), RS.f_hypot((ax - px : F32), (ay - py : F32))), owner, px, py, ax, ay, f, t)
    case False{}:
      deathmatch.decoy_aim(t, owner, px, py, ax, ay)

def deathmatch.decoy_aim.k1(sv0: List<&2, J.Val>, +fs: List<&2, J.Val>, +owner: U32, +px: F32, +py: F32, +ax: F32, +ay: F32) -> F32 & F32:
  match sv0:
    case Nil{}:
      (ax, ay)
    case Con{+f, +t}:
      deathmatch.decoy_aim.k2(Bool.and(String.eq(gc.s(f, "kind"), "Decoy"), Bool.not(U32.is_eq(gc.u(f, "owner"), owner))), owner, px, py, ax, ay, f, t)
# A Maybe<(x, y)> as a GcPt and a flag (0, 0 when none).
def deathmatch.pt_of(+m: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>) -> GcPt:
  deathmatch.pt_of.k1(m, m)

def deathmatch.pt_of.k1(sv0: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +m: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>) -> GcPt:
  match sv0:
    case None{}:
      GcPt{0.0, 0.0}
    case Some{(+x, +y)}:
      GcPt{x, y}
def deathmatch.has_pt(+m: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>) -> Bool:
  deathmatch.has_pt.k1(m, m)

def deathmatch.has_pt.k1(sv0: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +m: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>) -> Bool:
  match sv0:
    case None{}:
      False{}
    case Some{+v}:
      True{}
# Does any other fighter's orbit stop the step from -> to?
def deathmatch.orbit_stops(+orbs: List<&2, GcOrb>, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32) -> Bool:
  deathmatch.orbit_stops.k1(orbs, orbs, owner, fx, fy, tx, ty)

def deathmatch.orbit_stops.k2(sv0: GcOrb, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +o: GcOrb, +t: List<&2, GcOrb>) -> Bool:
  match sv0:
    case GcOrb{+id, +x, +y}:
      +hit = Bool.and(Bool.not(U32.is_eq(id, owner)), deathmatch.is_some_f(shield.entry(fx, fy, tx, ty, x, y, 0.9)))
      Bool.or(hit, deathmatch.orbit_stops(t, owner, fx, fy, tx, ty))

def deathmatch.orbit_stops.k1(sv0: List<&2, GcOrb>, +orbs: List<&2, GcOrb>, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+o, +t}:
      deathmatch.orbit_stops.k2(o, owner, fx, fy, tx, ty, o, t)
def deathmatch.is_some_f(+m: Maybe<&2, F32>) -> Bool:
  deathmatch.is_some_f.k1(m, m)

def deathmatch.is_some_f.k1(sv0: Maybe<&2, F32>, +m: Maybe<&2, F32>) -> Bool:
  match sv0:
    case None{}:
      False{}
    case Some{+v}:
      True{}
def deathmatch.or_f(+m: Maybe<&2, F32>, +d: F32) -> F32:
  deathmatch.or_f.k1(m, m, d)

def deathmatch.or_f.k1(sv0: Maybe<&2, F32>, +m: Maybe<&2, F32>, +d: F32) -> F32:
  match sv0:
    case None{}:
      d
    case Some{+v}:
      v
# A hedge in the way of the step, at 1/8-unit marks: the first point blocked.
def deathmatch.hedge_stop(+fs: List<&2, J.Val>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +i: U32, +n: U32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  deathmatch.hedge_stop.k1(U32.is_gt(i, n), fs, fx, fy, tx, ty, i, n)

def deathmatch.hedge_stop.k2(cv: Bool, +fs: List<&2, J.Val>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +i: U32, +n: U32, +px: F32, +py: F32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  match cv:
    case True{}:
      Some{(px, py)}
    case False{}:
      deathmatch.hedge_stop(fs, fx, fy, tx, ty, (i + 1 : U32), n)

def deathmatch.hedge_stop.k1(cv: Bool, +fs: List<&2, J.Val>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +i: U32, +n: U32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  match cv:
    case True{}:
      None{}
    case False{}:
      +t = (RS.u_as_f32(i) / RS.u_as_f32(n) : F32)
      +px = (fx + ((tx - fx : F32) * t : F32) : F32)
      +py = (fy + ((ty - fy : F32) * t : F32) : F32)
      deathmatch.hedge_stop.k2(deathmatch.fields_block(fs, px, py, 0.1), fs, fx, fy, tx, ty, i, n, px, py)
def deathmatch.first_some(+a: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +fs: List<&2, J.Val>, +fx: F32, +fy: F32, +tx: F32, +ty: F32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  deathmatch.first_some.k1(a, a, fs, fx, fy, tx, ty)

def deathmatch.first_some.k1(sv0: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +a: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +fs: List<&2, J.Val>, +fx: F32, +fy: F32, +tx: F32, +ty: F32) -> Maybe<&2, Sigma<&2, &2, F32, _ => F32>>:
  match sv0:
    case Some{+v}:
      Some{v}
    case None{}:
      deathmatch.hedge_stop(fs, fx, fy, tx, ty, 1, RS.f_as_u32(RS.f_max(F32.ceil((RS.f_hypot((tx - fx : F32), (ty - fy : F32)) * 8.0 : F32)), 1.0)))
# The earliest entry into any enemy decoy; 2.0 when none.
def deathmatch.decoy_t(+fs: List<&2, J.Val>, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +best: F32) -> F32:
  deathmatch.decoy_t.k1(fs, fs, owner, fx, fy, tx, ty, best)

def deathmatch.decoy_t.k2(cv: Bool, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +best: F32, +f: J.Val, +t: List<&2, J.Val>) -> F32:
  match cv:
    case True{}:
      deathmatch.decoy_t(t, owner, fx, fy, tx, ty, deathmatch.min_entry(shield.entry(fx, fy, tx, ty, gc.f(f, "x"), gc.f(f, "y"), 0.5), best))
    case False{}:
      deathmatch.decoy_t(t, owner, fx, fy, tx, ty, best)

def deathmatch.decoy_t.k1(sv0: List<&2, J.Val>, +fs: List<&2, J.Val>, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +best: F32) -> F32:
  match sv0:
    case Nil{}:
      best
    case Con{+f, +t}:
      deathmatch.decoy_t.k2(Bool.and(String.eq(gc.s(f, "kind"), "Decoy"), Bool.not(U32.is_eq(gc.u(f, "owner"), owner))), owner, fx, fy, tx, ty, best, f, t)
def deathmatch.min_entry(+m: Maybe<&2, F32>, +best: F32) -> F32:
  deathmatch.min_entry.k1(m, m, best)

def deathmatch.min_entry.k1(sv0: Maybe<&2, F32>, +m: Maybe<&2, F32>, +best: F32) -> F32:
  match sv0:
    case None{}:
      best
    case Some{+v}:
      RS.f_min(v, best)
# Is a decoy entered before `t` along the step?
def deathmatch.decoy_before(+fs: List<&2, J.Val>, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +t: F32) -> Bool:
  deathmatch.decoy_before.k1(fs, fs, owner, fx, fy, tx, ty, t)

def deathmatch.decoy_before.k1(sv0: List<&2, J.Val>, +fs: List<&2, J.Val>, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +t: F32) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+f, +rest}:
      +hit = Bool.and(String.eq(gc.s(f, "kind"), "Decoy"), Bool.and(Bool.not(U32.is_eq(gc.u(f, "owner"), owner)), deathmatch.lt_entry(shield.entry(fx, fy, tx, ty, gc.f(f, "x"), gc.f(f, "y"), 0.5), t)))
      Bool.or(hit, deathmatch.decoy_before(rest, owner, fx, fy, tx, ty, t))
def deathmatch.lt_entry(+m: Maybe<&2, F32>, +t: F32) -> Bool:
  deathmatch.lt_entry.k1(m, m, t)

def deathmatch.lt_entry.k1(sv0: Maybe<&2, F32>, +m: Maybe<&2, F32>, +t: F32) -> Bool:
  match sv0:
    case None{}:
      False{}
    case Some{+d}:
      F32.is_lt(d, t)
# fn fly's movement: orbit stop, stone, decoy, the knights it meets, and the end of the step.
def deathmatch.fly.move(+s: J.Val, +p: J.Val, +orbs: List<&2, GcOrb>, +children: List<&2, J.Val>, +owner: U32) -> GcShot:
  +fx = gc.f(p, "x")
  +fy = gc.f(p, "y")
  +tx = (fx + (gc.f(p, "vx") * rules.DT() : F32) : F32)
  +ty = (fy + (gc.f(p, "vy") * rules.DT() : F32) : F32)
  deathmatch.fly.move.k1(deathmatch.orbit_stops(orbs, owner, fx, fy, tx, ty), s, p, orbs, children, owner, fx, fy, tx, ty)

def deathmatch.fly.move.k2(sv0: GcShot, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +stone: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +decoy_t: F32, +wall_t: F32, +r: GcShot) -> GcShot:
  match sv0:
    case GcShot{+s2, +p2, +children2}:
      deathmatch.fly.finish(s2, p2, children2, fx, fy, tx, ty, stone, decoy_t, wall_t)

def deathmatch.fly.move.k1(cv: Bool, +s: J.Val, +p: J.Val, +orbs: List<&2, GcOrb>, +children: List<&2, J.Val>, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32) -> GcShot:
  match cv:
    case True{}:
      GcShot{s, gc.su(p, "ttl", 0), children}
    case False{}:
      +stone = deathmatch.first_some(rules.Grid.shot_stop_body(deathmatch.room(), False{}, (fx, fy), (tx, ty), 0.10), J.items(J.get(s, "fields")), fx, fy, tx, ty)
      +decoy_t = deathmatch.decoy_t(J.items(J.get(s, "fields")), owner, fx, fy, tx, ty, 2.0)
      +sp = deathmatch.pt_of(stone)
      +wall_t = gc.pf(deathmatch.has_pt(stone), (RS.f_hypot((gc.f_pt_x(sp) - fx : F32), (gc.f_pt_y(sp) - fy : F32)) / RS.f_max(RS.f_hypot((tx - fx : F32), (ty - fy : F32)), 0.001) : F32), 2.0)
      +stone_t = RS.f_min(wall_t, decoy_t)
      +hits = deathmatch.hitsort(deathmatch.meets_all(s, p, owner, fx, fy, tx, ty, stone_t, gc.ids(J.get(s, "fighters"))))
      +r = deathmatch.fly.hits(s, p, hits, fx, fy, tx, ty, owner, children)
      deathmatch.fly.move.k2(r, fx, fy, tx, ty, stone, decoy_t, wall_t, r)
def gc.f_pt_x(+p: GcPt) -> F32:
  gc.f_pt_x.k1(p, p)

def gc.f_pt_x.k1(sv0: GcPt, +p: GcPt) -> F32:
  match sv0:
    case GcPt{+x, +y}:
      x
def gc.f_pt_y(+p: GcPt) -> F32:
  gc.f_pt_y.k1(p, p)

def gc.f_pt_y.k1(sv0: GcPt, +p: GcPt) -> F32:
  match sv0:
    case GcPt{+x, +y}:
      y
# The knights the step meets, before the stone: (t, id, blocked).
def deathmatch.meets_all(+s: J.Val, +p: J.Val, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +stone_t: F32, +ids: List<&2, U32>) -> List<&2, GcHit>:
  deathmatch.meets_all.k1(ids, s, p, owner, fx, fy, tx, ty, stone_t, ids)

def deathmatch.meets_all.k2(cv: Bool, +s: J.Val, +p: J.Val, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +stone_t: F32, +id: U32, +t: List<&2, U32>, +h: J.Val, +fresh: Bool, +body: F32) -> List<&2, GcHit>:
  match cv:
    case True{}:
      deathmatch.meet_one(shield.meets(h, gc.f(h, "x"), gc.f(h, "y"), fx, fy, tx, ty, body), id, stone_t, deathmatch.meets_all(s, p, owner, fx, fy, tx, ty, stone_t, t))
    case False{}:
      deathmatch.meets_all(s, p, owner, fx, fy, tx, ty, stone_t, t)

def deathmatch.meets_all.k1(sv0: List<&2, U32>, +s: J.Val, +p: J.Val, +owner: U32, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +stone_t: F32, +ids: List<&2, U32>) -> List<&2, GcHit>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      +f = deathmatch.F(s, id)
      +h = J.get(f, "hero")
      +fresh = Bool.and(Bool.not(U32.is_eq(id, owner)), Bool.and(deathmatch.Fighter.alive(f), Bool.and(U32.is_zero(gc.u(f, "protection")), Bool.not(gc.opt_is(J.get(p, "last_hit"), id)))))
      +body = ((rules.HERO_RADIUS() + 0.16 : F32) + (RS.u_as_f32(gc.u(J.get(p, "traits"), "size")) * wishcraft.SIZE_REACH() : F32) : F32)
      deathmatch.meets_all.k2(fresh, s, p, owner, fx, fy, tx, ty, stone_t, id, t, h, fresh, body)
def deathmatch.meet_one(+m: Maybe<&2, J.Val>, +id: U32, +stone_t: F32, +rest: List<&2, GcHit>) -> List<&2, GcHit>:
  deathmatch.meet_one.k1(m, m, id, stone_t, rest)

def deathmatch.meet_one.k2(cv: Bool, +id: U32, +stone_t: F32, +rest: List<&2, GcHit>, +v: J.Val) -> List<&2, GcHit>:
  match cv:
    case True{}:
      GcHit{gc.f(v, "t"), id, gc.b(v, "shield")} <> rest
    case False{}:
      rest

def deathmatch.meet_one.k1(sv0: Maybe<&2, J.Val>, +m: Maybe<&2, J.Val>, +id: U32, +stone_t: F32, +rest: List<&2, GcHit>) -> List<&2, GcHit>:
  match sv0:
    case None{}:
      rest
    case Some{+v}:
      deathmatch.meet_one.k2(F32.is_lt(gc.f(v, "t"), stone_t), id, stone_t, rest, v)
def deathmatch.hitsort(+hs: List<&2, GcHit>) -> List<&2, GcHit>:
  deathmatch.hitsort.k1(hs, hs)

def deathmatch.hitsort.k1(sv0: List<&2, GcHit>, +hs: List<&2, GcHit>) -> List<&2, GcHit>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      deathmatch.hitsort.ins(h, deathmatch.hitsort(t))
def deathmatch.hitsort.ins(+x: GcHit, +sorted: List<&2, GcHit>) -> List<&2, GcHit>:
  deathmatch.hitsort.ins.k1(sorted, x, sorted)

def deathmatch.hitsort.ins.k2(cv: Bool, +x: GcHit, +h: GcHit, +t: List<&2, GcHit>) -> List<&2, GcHit>:
  match cv:
    case True{}:
      x <> (h <> t)
    case False{}:
      h <> deathmatch.hitsort.ins(x, t)

def deathmatch.hitsort.ins.k1(sv0: List<&2, GcHit>, +x: GcHit, +sorted: List<&2, GcHit>) -> List<&2, GcHit>:
  match sv0:
    case Nil{}:
      [x]
    case Con{+h, +t}:
      deathmatch.hitsort.ins.k2(deathmatch.hless(x, h), x, h, t)
def deathmatch.hless(+a: GcHit, +b: GcHit) -> Bool:
  deathmatch.hless.k1(a, a, b)

def deathmatch.hless.k2(sv0: GcHit, +b: GcHit, +at: F32, +aid: U32) -> Bool:
  match sv0:
    case GcHit{+bt, +bid, +bb}:
      Bool.or(F32.is_lt(at, bt), Bool.and(F32.is_eq(at, bt), U32.is_lt(aid, bid)))

def deathmatch.hless.k1(sv0: GcHit, +a: GcHit, +b: GcHit) -> Bool:
  match sv0:
    case GcHit{+at, +aid, +ab}:
      deathmatch.hless.k2(b, b, at, aid)
# After the hits: a spent shot is done; a decoy nearer than any wall stops it; a wall stops,
# bounces or ends it; otherwise it moves on.
def deathmatch.fly.finish(+s: J.Val, +p: J.Val, +children: List<&2, J.Val>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +stone: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +decoy_t: F32, +wall_t: F32) -> GcShot:
  deathmatch.fly.finish.k1(U32.is_zero(gc.u(p, "ttl")), s, p, children, fx, fy, tx, ty, stone, decoy_t, wall_t)

def deathmatch.fly.finish.k5(cv: Bool, +s: J.Val, +p: J.Val, +children: List<&2, J.Val>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +tr: J.Val) -> GcShot:
  match cv:
    case True{}:
      +p1 = J.set(p, "traits", gc.su(tr, "bounce", (gc.u(tr, "bounce") - 1 : U32)))
      +p2 = gc.ifj(deathmatch.has_pt(rules.Grid.shot_stop(deathmatch.room(), False{}, (fx, fy), (tx, fy))), _ => gc.sf(p1, "vx", F32.neg(gc.f(p1, "vx"))), _ => p1)
      +p3 = gc.ifj(deathmatch.has_pt(rules.Grid.shot_stop(deathmatch.room(), False{}, (fx, fy), (fx, ty))), _ => gc.sf(p2, "vy", F32.neg(gc.f(p2, "vy"))), _ => p2)
      GcShot{s, p3, children}
    case False{}:
      GcShot{s, gc.su(p, "ttl", 0), children}

def deathmatch.fly.finish.k4(cv: Bool, +s: J.Val, +p: J.Val, +children: List<&2, J.Val>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +tr: J.Val) -> GcShot:
  match cv:
    case True{}:
      GcShot{s, gc.su(p, "ttl", 0), children}
    case False{}:
      deathmatch.fly.finish.k5(U32.is_gt(gc.u(tr, "bounce"), 0), s, p, children, fx, fy, tx, ty, tr)

def deathmatch.fly.finish.k3(cv: Bool, +s: J.Val, +p: J.Val, +children: List<&2, J.Val>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +stone: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>) -> GcShot:
  match cv:
    case True{}:
      +tr = J.get(p, "traits")
      deathmatch.fly.finish.k4(U32.is_eq(gc.u(tr, "back"), 2), s, p, children, fx, fy, tx, ty, tr)
    case False{}:
      GcShot{s, gc.sf(gc.sf(p, "x", tx), "y", ty), children}

def deathmatch.fly.finish.k2(cv: Bool, +s: J.Val, +p: J.Val, +children: List<&2, J.Val>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +stone: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +decoy_t: F32, +wall_t: F32) -> GcShot:
  match cv:
    case True{}:
      GcShot{s, gc.su(p, "ttl", 0), children}
    case False{}:
      deathmatch.fly.finish.k3(deathmatch.has_pt(stone), s, p, children, fx, fy, tx, ty, stone)

def deathmatch.fly.finish.k1(cv: Bool, +s: J.Val, +p: J.Val, +children: List<&2, J.Val>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +stone: Maybe<&2, Sigma<&2, &2, F32, _ => F32>>, +decoy_t: F32, +wall_t: F32) -> GcShot:
  match cv:
    case True{}:
      GcShot{s, p, children}
    case False{}:
      deathmatch.fly.finish.k2(F32.is_lt(decoy_t, wall_t), s, p, children, fx, fy, tx, ty, stone, decoy_t, wall_t)
# The sorted hits, one by one.
def deathmatch.fly.hits(+s: J.Val, +p: J.Val, +hs: List<&2, GcHit>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +owner: U32, +children: List<&2, J.Val>) -> GcShot:
  deathmatch.fly.hits.k1(hs, s, p, hs, fx, fy, tx, ty, owner, children)

def deathmatch.fly.hits.k5(pr: J.Val & Bool, +s: J.Val, +p: J.Val, +children: List<&2, J.Val>, +id: U32) -> GcShot:
  (+h2, +ig) = pr
  GcShot{deathmatch.setH(s, id, h2), gc.su(p, "ttl", 0), children}

def deathmatch.fly.hits.k4(cv: Bool, +s: J.Val, +p: J.Val, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +owner: U32, +children: List<&2, J.Val>, +rest: List<&2, GcHit>, +t: F32, +id: U32, +blocked: Bool) -> GcShot:
  match cv:
    case True{}:
      +r = shield.Hero.shield_turned(deathmatch.H(s, id), gc.u(p, "damage"))
      deathmatch.fly.hits.k5(r, s, p, children, id)
    case False{}:
      deathmatch.fly.strike(s, p, rest, fx, fy, tx, ty, owner, children, id, t)

def deathmatch.fly.hits.k3(cv: Bool, +s: J.Val, +p: J.Val, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +owner: U32, +children: List<&2, J.Val>, +rest: List<&2, GcHit>, +t: F32, +id: U32, +blocked: Bool) -> GcShot:
  match cv:
    case True{}:
      GcShot{s, gc.su(p, "ttl", 0), children}
    case False{}:
      deathmatch.fly.hits.k4(blocked, s, p, fx, fy, tx, ty, owner, children, rest, t, id, blocked)

def deathmatch.fly.hits.k2(sv0: GcHit, +s: J.Val, +p: J.Val, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +owner: U32, +children: List<&2, J.Val>, +h: GcHit, +rest: List<&2, GcHit>) -> GcShot:
  match sv0:
    case GcHit{+t, +id, +blocked}:
      deathmatch.fly.hits.k3(deathmatch.decoy_before(J.items(J.get(s, "fields")), owner, fx, fy, tx, ty, t), s, p, fx, fy, tx, ty, owner, children, rest, t, id, blocked)

def deathmatch.fly.hits.k1(sv0: List<&2, GcHit>, +s: J.Val, +p: J.Val, +hs: List<&2, GcHit>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +owner: U32, +children: List<&2, J.Val>) -> GcShot:
  match sv0:
    case Nil{}:
      GcShot{s, p, children}
    case Con{+h, +rest}:
      deathmatch.fly.hits.k2(h, s, p, fx, fy, tx, ty, owner, children, h, rest)
def deathmatch.fly.strike(+s: J.Val, +p: J.Val, +rest: List<&2, GcHit>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +owner: U32, +children: List<&2, J.Val>, +id: U32, +t: F32) -> GcShot:
  +ax = (fx + ((tx - fx : F32) * t : F32) : F32)
  +ay = (fy + ((ty - fy : F32) * t : F32) : F32)
  +tr = J.get(p, "traits")
  +r = deathmatch.Session.hit(s, owner, id, aoe.part(gc.u(p, "damage"), gc.u(tr, "struck")), gc.f(p, "vx"), gc.f(p, "vy"))
  deathmatch.fly.strike.k1(r, p, rest, fx, fy, tx, ty, owner, children, id, ax, ay, tr)

def deathmatch.fly.strike.k2(cv: Bool, +p: J.Val, +rest: List<&2, GcHit>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +owner: U32, +children: List<&2, J.Val>, +id: U32, +ax: F32, +ay: F32, +tr: J.Val, +s2: J.Val, +landed: Bool) -> GcShot:
  match cv:
    case True{}:
      +p3 = J.set(p, "traits", gc.su(tr, "struck", gc.umin((gc.u(tr, "struck") + 1 : U32), 255)))
      +s3 = deathmatch.fly.landed(s2, p3, owner, id, ax, ay)
      deathmatch.fly.after(s3, J.set(p3, "last_hit", J.JU{id}), rest, fx, fy, tx, ty, owner, children, ax, ay)
    case False{}:
      deathmatch.fly.after(s2, J.set(p, "last_hit", J.JU{id}), rest, fx, fy, tx, ty, owner, children, ax, ay)

def deathmatch.fly.strike.k1(pr: J.Val & Bool, +p: J.Val, +rest: List<&2, GcHit>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +owner: U32, +children: List<&2, J.Val>, +id: U32, +ax: F32, +ay: F32, +tr: J.Val) -> GcShot:
  (+s2, +landed) = pr
  deathmatch.fly.strike.k2(landed, p, rest, fx, fy, tx, ty, owner, children, id, ax, ay, tr, s2, landed)
# After a contact: a piercing shot goes on; otherwise it turns home, forks, or ends.
def deathmatch.fly.after(+s: J.Val, +p: J.Val, +rest: List<&2, GcHit>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +owner: U32, +children: List<&2, J.Val>, +ax: F32, +ay: F32) -> GcShot:
  deathmatch.fly.after.k1(U32.is_zero(gc.u(p, "pierce")), s, p, rest, fx, fy, tx, ty, owner, children, ax, ay)

def deathmatch.fly.after.k4(cv: Bool, +s: J.Val, +children: List<&2, J.Val>, +ax: F32, +ay: F32, +p1: J.Val, +tr: J.Val) -> GcShot:
  match cv:
    case True{}:
      GcShot{s, gc.su(p1, "ttl", 0), deathmatch.fork(children, p1, ax, ay)}
    case False{}:
      GcShot{s, gc.su(p1, "ttl", 0), children}

def deathmatch.fly.after.k3(cv: Bool, +s: J.Val, +children: List<&2, J.Val>, +ax: F32, +ay: F32, +p1: J.Val, +turned: Bool) -> GcShot:
  match cv:
    case True{}:
      GcShot{s, p1, children}
    case False{}:
      +tr = J.get(p1, "traits")
      deathmatch.fly.after.k4(Bool.and(U32.is_gt(gc.u(tr, "fork"), 0), U32.is_zero(gc.u(tr, "back"))), s, children, ax, ay, p1, tr)

def deathmatch.fly.after.k2(pr: J.Val & Bool, +s: J.Val, +children: List<&2, J.Val>, +ax: F32, +ay: F32) -> GcShot:
  (+p1, +turned) = pr
  deathmatch.fly.after.k3(turned, s, children, ax, ay, p1, turned)

def deathmatch.fly.after.k1(cv: Bool, +s: J.Val, +p: J.Val, +rest: List<&2, GcHit>, +fx: F32, +fy: F32, +tx: F32, +ty: F32, +owner: U32, +children: List<&2, J.Val>, +ax: F32, +ay: F32) -> GcShot:
  match cv:
    case True{}:
      +th = wishcraft.turn_home(p)
      deathmatch.fly.after.k2(th, s, children, ax, ay)
    case False{}:
      deathmatch.fly.hits(s, gc.su(p, "pierce", (gc.u(p, "pierce") - 1 : U32)), rest, fx, fy, tx, ty, owner, children)
# Two children turn 0.6 rad either way, one fork the less, flying on from the contact.
def deathmatch.fork(+children: List<&2, J.Val>, +p: J.Val, +ax: F32, +ay: F32) -> List<&2, J.Val>:
  +c1 = deathmatch.fork.one(children, p, F32.neg(rules.FORK_TURN()), ax, ay)
  deathmatch.fork.one(c1, p, rules.FORK_TURN(), ax, ay)
def deathmatch.fork.one(+children: List<&2, J.Val>, +p: J.Val, +turn: F32, +ax: F32, +ay: F32) -> List<&2, J.Val>:
  deathmatch.fork.one.k1(U32.is_lt(gc.len(children), rules.MAX_PROJECTILES()), children, p, turn, ax, ay)

def deathmatch.fork.one.k1(cv: Bool, +children: List<&2, J.Val>, +p: J.Val, +turn: F32, +ax: F32, +ay: F32) -> List<&2, J.Val>:
  match cv:
    case True{}:
      +sn = F32.sin(turn)
      +cs = F32.cos(turn)
      +tr = J.get(p, "traits")
      +fork = (gc.u(tr, "fork") - 1 : U32)
      +tr2 = gc.sz(tr, "fork", fork)
      +c0 = gc.sf(gc.sf(gc.sf(gc.sf(p, "vx", (((gc.f(p, "vx") * cs : F32) - (gc.f(p, "vy") * sn : F32)) : F32)), "vy", (((gc.f(p, "vx") * sn : F32) + (gc.f(p, "vy") * cs : F32)) : F32)), "x", ax), "y", ay)
      List.append(&2, J.Val, children, [J.set(gc.su(c0, "ttl", gc.umax(gc.u(p, "ttl"), rules.FORK_TTL())), "traits", tr2)])
    case False{}:
      children
# A shot that hurt a knight: stun, chill, burning, knock-back (a hook drags them in), the burst, the
# chain, the thrower's lifesteal and a fart cloud.
def deathmatch.fly.landed(+s: J.Val, +p: J.Val, +owner: U32, +id: U32, +ax: F32, +ay: F32) -> J.Val:
  +tr = J.get(p, "traits")
  +hook = Bool.and(String.eq(gc.s(p, "kind"), "blade"), Bool.and(U32.is_gt(gc.u(tr, "stun"), 0), String.eq(champions.of(deathmatch.H(s, owner)), "butcher")))
  +ch = deathmatch.H(s, owner)
  +f = deathmatch.F(s, id)
  +h = J.get(f, "hero")
  +f1 = gc.su(f, "stun", gc.umax(gc.u(f, "stun"), gc.umin(gc.u(tr, "stun"), rules.HZ())))
  +h1 = gc.su(h, "chilled", gc.umax(gc.u(h, "chilled"), (gc.u(tr, "chill") * lich.CHILL() : U32)))
  +f2 = gc.ifj(Bool.or(gc.b(tr, "fire"), U32.is_gt(gc.u(tr, "poison"), 0)), _ => gc.su(gc.su(f1, "burn", (2 * rules.HZ() : U32)), "burner", owner), _ => f1)
  +knock = wishcraft.knock(p)
  +u = rules.unit(gc.f(p, "vx"), gc.f(p, "vy"))
  deathmatch.fly.landed.k1(u, s, p, owner, id, ax, ay, tr, hook, ch, h1, f2, knock)

def deathmatch.fly.landed.k2(pr: F32 & F32, +s: J.Val, +p: J.Val, +owner: U32, +id: U32, +ax: F32, +ay: F32, +tr: J.Val, +hook: Bool, +ch: J.Val, +h1: J.Val, +f2: J.Val) -> J.Val:
  (+kx, +ky) = pr
  +hx = gc.f(ch, "x")
  +hy = gc.f(ch, "y")
  +h2 = deathmatch.drag(gc.sf(gc.sf(h1, "x", kx), "y", ky), hook, hx, hy)
  +s1 = deathmatch.setF(s, id, J.set(f2, "hero", h2))
  +s2 = gc.ifj(U32.is_gt(gc.u(tr, "burst"), 0), _ => deathmatch.Session.area(s1, owner, ax, ay, 2.8, U32.div((gc.u(p, "damage") * gc.u(tr, "burst") : U32), 100)), _ => s1)
  +s3 = gc.ifj(U32.is_gt(gc.u(tr, "chain"), 0), _ => deathmatch.chain(s2, p, owner, id, ax, ay, gc.ids(J.get(s2, "fighters")), gc.u(tr, "chain")), _ => s2)
  +s4 = deathmatch.vamp(s3, p, owner)
  deathmatch.fart(s4, p, owner, ax, ay)

def deathmatch.fly.landed.k1(pr: F32 & F32, +s: J.Val, +p: J.Val, +owner: U32, +id: U32, +ax: F32, +ay: F32, +tr: J.Val, +hook: Bool, +ch: J.Val, +h1: J.Val, +f2: J.Val, +knock: F32) -> J.Val:
  (+ux, +uy) = pr
  +k = rules.Grid.halted(deathmatch.room(), False{}, (gc.f(h1, "x"), gc.f(h1, "y")), ((ux * knock : F32), (uy * knock : F32)))
  deathmatch.fly.landed.k2(k, s, p, owner, id, ax, ay, tr, hook, ch, h1, f2)
# The Butcher's hook: pulled to within 1.4 of the caster.
def deathmatch.drag(+h: J.Val, +hook: Bool, +cx: F32, +cy: F32) -> J.Val:
  deathmatch.drag.k1(hook, h, hook, cx, cy)

def deathmatch.drag.k2(pr: F32 & F32, +h: J.Val) -> J.Val:
  (+kx, +ky) = pr
  gc.sf(gc.sf(h, "x", kx), "y", ky)

def deathmatch.drag.k1(cv: Bool, +h: J.Val, +hook: Bool, +cx: F32, +cy: F32) -> J.Val:
  match cv:
    case True{}:
      +dx = (cx - gc.f(h, "x") : F32)
      +dy = (cy - gc.f(h, "y") : F32)
      +dist = RS.f_max(RS.f_hypot(dx, dy), 0.01)
      +pull = RS.f_max((dist - 1.4 : F32), 0.0)
      +k = rules.Grid.halted(deathmatch.room(), False{}, (gc.f(h, "x"), gc.f(h, "y")), (((dx / dist : F32) * pull : F32), ((dy / dist : F32) * pull : F32)))
      deathmatch.drag.k2(k, h)
    case False{}:
      h
# The chain: up to `n` other fighters within 5 of the contact and in sight, each hit for half.
def deathmatch.chain(+s: J.Val, +p: J.Val, +owner: U32, +id: U32, +ax: F32, +ay: F32, +ids: List<&2, U32>, +n: U32) -> J.Val:
  deathmatch.chain.k1(U32.is_zero(n), s, p, owner, id, ax, ay, ids, n)

def deathmatch.chain.k4(pr: J.Val & Bool, +p: J.Val, +owner: U32, +id: U32, +ax: F32, +ay: F32, +n: U32, +t: List<&2, U32>) -> J.Val:
  (+s2, +landed) = pr
  deathmatch.chain(s2, p, owner, id, ax, ay, t, (n - 1 : U32))

def deathmatch.chain.k3(cv: Bool, +s: J.Val, +p: J.Val, +owner: U32, +id: U32, +ax: F32, +ay: F32, +n: U32, +o: U32, +t: List<&2, U32>, +near: Bool) -> J.Val:
  match cv:
    case True{}:
      +r = deathmatch.Session.hit(s, owner, o, U32.div(gc.u(p, "damage"), 2), gc.f(p, "vx"), gc.f(p, "vy"))
      deathmatch.chain.k4(r, p, owner, id, ax, ay, n, t)
    case False{}:
      deathmatch.chain(s, p, owner, id, ax, ay, t, n)

def deathmatch.chain.k2(sv0: List<&2, U32>, +s: J.Val, +p: J.Val, +owner: U32, +id: U32, +ax: F32, +ay: F32, +ids: List<&2, U32>, +n: U32) -> J.Val:
  match sv0:
    case Nil{}:
      s
    case Con{+o, +t}:
      +f = deathmatch.F(s, o)
      +px = gc.f(J.get(f, "hero"), "x")
      +py = gc.f(J.get(f, "hero"), "y")
      +near = Bool.and(Bool.not(U32.is_eq(o, owner)), Bool.and(Bool.not(U32.is_eq(o, id)), Bool.and(deathmatch.Fighter.alive(f), Bool.and(F32.is_lt(RS.f_hypot((px - ax : F32), (py - ay : F32)), 5.0), deathmatch.Session.visible(s, ax, ay, px, py)))))
      deathmatch.chain.k3(near, s, p, owner, id, ax, ay, n, o, t, near)

def deathmatch.chain.k1(cv: Bool, +s: J.Val, +p: J.Val, +owner: U32, +id: U32, +ax: F32, +ay: F32, +ids: List<&2, U32>, +n: U32) -> J.Val:
  match cv:
    case True{}:
      s
    case False{}:
      deathmatch.chain.k2(ids, s, p, owner, id, ax, ay, ids, n)
# The thrower leeches a share of the damage (and the shot's own mend) while alive.
def deathmatch.vamp(+s: J.Val, +p: J.Val, +owner: U32) -> J.Val:
  +f = deathmatch.F(s, owner)
  deathmatch.vamp.k1(Bool.and(Bool.not(J.is_null(f)), deathmatch.Fighter.alive(f)), s, p, owner, f)

def deathmatch.vamp.k2(pr: J.Val & U32, +s: J.Val, +owner: U32) -> J.Val:
  (+h2, +gain) = pr
  deathmatch.setH(s, owner, h2)

def deathmatch.vamp.k1(cv: Bool, +s: J.Val, +p: J.Val, +owner: U32, +f: J.Val) -> J.Val:
  match cv:
    case True{}:
      +h = J.get(f, "hero")
      +vamp = gc.umin(gc.u(J.get(h, "bonus"), "vamp"), 20)
      +r = stakes.Hero.leech(h, (U32.div((gc.u(p, "damage") * vamp : U32), 100) + gc.u(J.get(p, "traits"), "mend") : U32), 3)
      deathmatch.vamp.k2(r, s, owner)
    case False{}:
      s
# Fart Bombs: a sulphur cloud where it struck, every 2s / N.
def deathmatch.fart(+s: J.Val, +p: J.Val, +owner: U32, +ax: F32, +ay: F32) -> J.Val:
  +fart = gc.u(J.get(p, "traits"), "fart")
  +f = deathmatch.F(s, owner)
  deathmatch.fart.k1(Bool.and(U32.is_gt(fart, 0), U32.is_zero(gc.u(f, "fart_wait"))), s, owner, ax, ay, fart, f)

def deathmatch.fart.k1(cv: Bool, +s: J.Val, +owner: U32, +ax: F32, +ay: F32, +fart: U32, +f: J.Val) -> J.Val:
  match cv:
    case True{}:
      +s1 = deathmatch.setF(s, owner, gc.su(f, "fart_wait", U32.div((2 * rules.HZ() : U32), fart)))
      deathmatch.Session.field(s1, owner, ax, ay, 2.0, hero.Hero.scaled(J.get(f, "hero"), skills.POISON_BASE()), (3 * rules.HZ() : U32), "Hazard")
    case False{}:
      s
