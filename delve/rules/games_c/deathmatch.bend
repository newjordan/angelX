# crates/delve/src/rules/deathmatch.rs — Knights Wish: a first-to-ten free-for-all behind each
# knight's own eyes. The Session is the J object of `Run::deathmatch`; its fighters are
# J objects keyed by seat, each holding its own copy of the knight's Hero.

def deathmatch.GOAL() -> U32:
  10
def deathmatch.TITLE() -> U32:
  (3 * rules.HZ() : U32)
def deathmatch.RESPAWN() -> U32:
  (2 * rules.HZ() : U32)
def deathmatch.PROTECTION() -> U32:
  (2 * rules.HZ() : U32)
def deathmatch.PODIUM() -> U32:
  (6 * rules.HZ() : U32)
def deathmatch.PICKUP_REST() -> U32:
  (15 * rules.HZ() : U32)
def deathmatch.POWER_TIME() -> U32:
  (8 * rules.HZ() : U32)
def deathmatch.PACE() -> F32:
  9.0
def deathmatch.TURN() -> F32:
  2.6
def deathmatch.TAU() -> F32:
  6.2831855
# SPAWNS[i]
def deathmatch.SPAWN.x(+i: U32) -> F32:
  gc.nth_f([5.0, 43.0, 43.0, 5.0, 17.0, 31.0, 23.0, 25.0], i)
def deathmatch.SPAWN.y(+i: U32) -> F32:
  gc.nth_f([5.0, 31.0, 5.0, 31.0, 17.0, 21.0, 9.0, 29.0], i)
# PICKUPS[k] = (x, y, kind): 0 health, 1 armor, 2 power
def deathmatch.PICKUP.x(+k: U32) -> F32:
  gc.nth_f([9.0, 39.0, 9.0, 39.0, 25.0], k)
def deathmatch.PICKUP.y(+k: U32) -> F32:
  gc.nth_f([13.0, 23.0, 25.0, 11.0, 17.0], k)
def deathmatch.PICKUP.kind(+k: U32) -> U32:
  gc.nth_u([0, 0, 1, 1, 2], k)
# room(): the arena's own Room (24x18 tiles from MAP), as far as the Grid reads it.
def deathmatch.room() -> J.Val:
  J.set(J.set(J.set(J.set(J.obj(), "kind", J.JS{"kingdom"}), "cols", J.JU{24}), "rows", J.JU{18}), "tiles", J.JS{"25#10.2#10.2#10.2#10.2#2.2#14.2#2.2#2.2#2.3#4.3#2.2#2.2#6.3#4.3#6.2#22.4#18.6#6.2#2.2#6.6#6.2#2.2#6.4#22.2#22.2#6.3#4.3#6.2#2.2#2.3#4.3#2.2#2.2#2.2#14.2#2.2#10.2#10.2#10.2#10.25#"})
# open(x, y): grid().clear(x, y, HERO_RADIUS, Mover::Hero)
def deathmatch.open(+x: F32, +y: F32) -> Bool:
  rules.Grid.clear(deathmatch.room(), False{}, x, y, rules.HERO_RADIUS(), 0)
# sight(a, b): every fifth of a unit along the line is open.
def deathmatch.sight(+ax: F32, +ay: F32, +bx: F32, +by: F32) -> Bool:
  +n = RS.f_as_u32(RS.f_max(F32.ceil((RS.f_hypot((bx - ax : F32), (by - ay : F32)) * 5.0 : F32)), 1.0))
  deathmatch.sight.go(0, n, ax, ay, bx, by)
def deathmatch.sight.go(+i: U32, +n: U32, +ax: F32, +ay: F32, +bx: F32, +by: F32) -> Bool:
  deathmatch.sight.go.k1(U32.is_gt(i, n), i, n, ax, ay, bx, by)

def deathmatch.sight.go.k2(cv: Bool, +i: U32, +n: U32, +ax: F32, +ay: F32, +bx: F32, +by: F32, +f: F32) -> Bool:
  match cv:
    case True{}:
      deathmatch.sight.go((i + 1 : U32), n, ax, ay, bx, by)
    case False{}:
      False{}

def deathmatch.sight.go.k1(cv: Bool, +i: U32, +n: U32, +ax: F32, +ay: F32, +bx: F32, +by: F32) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      +f = (RS.u_as_f32(i) / RS.u_as_f32(n) : F32)
      deathmatch.sight.go.k2(rules.Grid.open(deathmatch.room(), False{}, (ax + ((bx - ax : F32) * f : F32) : F32), (ay + ((by - ay : F32) * f : F32) : F32), 0), i, n, ax, ay, bx, by, f)
# Fighter::alive()
def deathmatch.Fighter.alive(+f: J.Val) -> Bool:
  Bool.and(gc.b(f, "connected"), Bool.and(U32.is_gt(gc.u(J.get(f, "hero"), "hp"), 0), U32.is_zero(gc.u(f, "respawn"))))
# A stance (hero.champ) with every field, defaults for the ones left out; written back with the
# key dropped while idle (serde skip_serializing_if = Stance::idle).
def deathmatch.stance(+h: J.Val) -> J.Val:
  +c = J.get(h, "champ")
  +c1 = gc.zeros(J.obj(), ["windup", "fury", "rot", "haul", "cast", "spell"])
  +c2 = gc.sf(gc.sf(c1, "haul_x", 0.0), "haul_y", 0.0)
  deathmatch.stance.fill(c2, c, ["windup", "fury", "rot", "haul", "cast", "spell"])
def deathmatch.stance.fill(+base: J.Val, +c: J.Val, +names: List<&2, String>) -> J.Val:
  deathmatch.stance.fill.k1(names, base, c, names)

def deathmatch.stance.fill.k1(sv0: List<&2, String>, +base: J.Val, +c: J.Val, +names: List<&2, String>) -> J.Val:
  match sv0:
    case Nil{}:
      J.set(J.set(base, "haul_x", gc.ifj(J.has(c, "haul_x"), _ => J.get(c, "haul_x"), _ => J.JF{0.0})), "haul_y", gc.ifj(J.has(c, "haul_y"), _ => J.get(c, "haul_y"), _ => J.JF{0.0}))
    case Con{+k, +t}:
      deathmatch.stance.fill(gc.ifj(J.has(c, k), _ => J.set(base, k, J.get(c, k)), _ => base), c, t)
def deathmatch.stance.idle(+c: J.Val) -> Bool:
  Bool.and(U32.is_zero(gc.u(c, "windup")), Bool.and(U32.is_zero(gc.u(c, "fury")), Bool.and(U32.is_zero(gc.u(c, "rot")), Bool.and(U32.is_zero(gc.u(c, "haul")), Bool.and(F32.is_eq(gc.f(c, "haul_x"), 0.0), Bool.and(F32.is_eq(gc.f(c, "haul_y"), 0.0), Bool.and(U32.is_zero(gc.u(c, "cast")), U32.is_zero(gc.u(c, "spell")))))))))
def deathmatch.put_champ(+h: J.Val, +c: J.Val) -> J.Val:
  gc.ifj(deathmatch.stance.idle(c), _ => J.del(h, "champ"), _ => J.set(h, "champ", c))
# hero.champ = Default::default()
def deathmatch.clear_champ(+h: J.Val) -> J.Val:
  J.del(h, "champ")
# Fighter::new(hero, slot, book)
def deathmatch.Fighter.new(+hero: J.Val, +slot: U32, +book: J.Val) -> J.Val:
  +h0 = hero.Hero.rebonus(hero, book)
  +h1 = gc.su(gc.su(gc.su(h0, "hp", gc.u(h0, "max_hp")), "invulnerable", 0), "fire_cooldown", 0)
  +h2 = gc.sb(gc.sb(gc.sb(J.set(h1, "spell_cooldowns", gc.of_us([0, 0, 0, 0])), "stone", False{}), "vigil", False{}), "aloft", False{})
  +h3 = gc.su(gc.su(gc.su(gc.snull(J.del(h2, "idle"), "booby"), "incoming", 100), "hit_ward", 0), "dash_ticks", 0)
  +h4 = gc.su(gc.su(J.del(h3, "flee_ticks"), "dash_cooldown", 0), "privy", 0)
  +h5 = deathmatch.clear_champ(h4)
  +px = deathmatch.SPAWN.x(U32.mod(slot, 8))
  +py = deathmatch.SPAWN.y(U32.mod(slot, 8))
  +h6 = gc.sf(gc.sf(h5, "x", px), "y", py)
  +f0 = gc.sf(J.set(J.obj(), "hero", h6), "yaw", F32.atan2((18.0 - py : F32), (24.0 - px : F32)))
  +f1 = gc.zeros(f0, ["kills", "deaths", "respawn", "power", "flash", "stun", "burn", "burner", "fart_wait"])
  gc.sb(gc.su(gc.sf(f1, "bob", 0.0), "protection", deathmatch.PROTECTION()), "connected", True{})
# Session::new(players, book): the first six seated (not absent) knights, in seat order.
def deathmatch.Session.new(+players: J.Val, +book: J.Val) -> J.Val:
  +s0 = J.set(J.obj(), "fighters", deathmatch.fighters(players, book, gc.ids(players), 0))
  +s1 = gc.zeros(s0, ["ticks", "ended", "purse"])
  +s2 = J.set(J.set(J.set(J.set(s1, "shots", J.JA{Nil{}}), "pickups", gc.of_us([0, 0, 0, 0, 0])), "feed", J.JA{Nil{}}), "ante", J.obj())
  gc.snull(J.set(s2, "fields", J.JA{Nil{}}), "winner")
def deathmatch.fighters(+players: J.Val, +book: J.Val, +ids: List<&2, U32>, +n: U32) -> J.Val:
  deathmatch.fighters.k1(ids, players, book, ids, n)

def deathmatch.fighters.k3(cv: Bool, +players: J.Val, +book: J.Val, +n: U32, +id: U32, +t: List<&2, U32>, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.obj()
    case False{}:
      J.set(deathmatch.fighters(players, book, t, (n + 1 : U32)), gc.key(id), deathmatch.Fighter.new(h, n, book))

def deathmatch.fighters.k2(cv: Bool, +players: J.Val, +book: J.Val, +n: U32, +id: U32, +t: List<&2, U32>, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      deathmatch.fighters(players, book, t, n)
    case False{}:
      deathmatch.fighters.k3(U32.is_ge(n, rules.MAX_PLAYERS()), players, book, n, id, t, h)

def deathmatch.fighters.k1(sv0: List<&2, U32>, +players: J.Val, +book: J.Val, +ids: List<&2, U32>, +n: U32) -> J.Val:
  match sv0:
    case Nil{}:
      J.obj()
    case Con{+id, +t}:
      +h = gc.seat(players, id)
      deathmatch.fighters.k2(gc.b(h, "absent"), players, book, n, id, t, h)
# Session::order(): ids by kills (most first), deaths (fewest), then id.
def deathmatch.Session.order(+s: J.Val) -> List<&2, U32>:
  deathmatch.sort(gc.ids(J.get(s, "fighters")), J.get(s, "fighters"))
def deathmatch.sort(+ids: List<&2, U32>, +fs: J.Val) -> List<&2, U32>:
  deathmatch.sort.k1(ids, ids, fs)

def deathmatch.sort.k1(sv0: List<&2, U32>, +ids: List<&2, U32>, +fs: J.Val) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      deathmatch.sort.ins(id, deathmatch.sort(t, fs), fs)
def deathmatch.sort.ins(+id: U32, +sorted: List<&2, U32>, +fs: J.Val) -> List<&2, U32>:
  deathmatch.sort.ins.k1(sorted, id, sorted, fs)

def deathmatch.sort.ins.k2(cv: Bool, +id: U32, +fs: J.Val, +h: U32, +t: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      id <> (h <> t)
    case False{}:
      h <> deathmatch.sort.ins(id, t, fs)

def deathmatch.sort.ins.k1(sv0: List<&2, U32>, +id: U32, +sorted: List<&2, U32>, +fs: J.Val) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      [id]
    case Con{+h, +t}:
      deathmatch.sort.ins.k2(deathmatch.before(id, h, fs), id, fs, h, t)
def deathmatch.before(+a: U32, +b: U32, +fs: J.Val) -> Bool:
  +fa = gc.seat(fs, a)
  +fb = gc.seat(fs, b)
  Bool.or(U32.is_gt(gc.u(fa, "kills"), gc.u(fb, "kills")), Bool.and(U32.is_eq(gc.u(fa, "kills"), gc.u(fb, "kills")), Bool.or(U32.is_lt(gc.u(fa, "deaths"), gc.u(fb, "deaths")), Bool.and(U32.is_eq(gc.u(fa, "deaths"), gc.u(fb, "deaths")), U32.is_lt(a, b)))))
# fighter and hero accessors
def deathmatch.F(+s: J.Val, +id: U32) -> J.Val:
  gc.seat(J.get(s, "fighters"), id)
def deathmatch.setF(+s: J.Val, +id: U32, +f: J.Val) -> J.Val:
  J.set(s, "fighters", gc.put_seat(J.get(s, "fighters"), id, f))
def deathmatch.setH(+s: J.Val, +id: U32, +h: J.Val) -> J.Val:
  deathmatch.setF(s, id, J.set(deathmatch.F(s, id), "hero", h))
def deathmatch.H(+s: J.Val, +id: U32) -> J.Val:
  J.get(deathmatch.F(s, id), "hero")
# The closest any other living fighter stands to (px, py), starting from 100.
def deathmatch.clearance(+s: J.Val, +me: U32, +px: F32, +py: F32, +ids: List<&2, U32>, +best: F32) -> F32:
  deathmatch.clearance.k1(ids, s, me, px, py, ids, best)

def deathmatch.clearance.k2(cv: Bool, +s: J.Val, +me: U32, +px: F32, +py: F32, +best: F32, +id: U32, +t: List<&2, U32>, +f: J.Val) -> F32:
  match cv:
    case True{}:
      deathmatch.clearance(s, me, px, py, t, RS.f_min(best, RS.f_hypot((px - gc.f(J.get(f, "hero"), "x") : F32), (py - gc.f(J.get(f, "hero"), "y") : F32))))
    case False{}:
      deathmatch.clearance(s, me, px, py, t, best)

def deathmatch.clearance.k1(sv0: List<&2, U32>, +s: J.Val, +me: U32, +px: F32, +py: F32, +ids: List<&2, U32>, +best: F32) -> F32:
  match sv0:
    case Nil{}:
      best
    case Con{+id, +t}:
      +f = deathmatch.F(s, id)
      deathmatch.clearance.k2(Bool.and(Bool.not(U32.is_eq(id, me)), deathmatch.Fighter.alive(f)), s, me, px, py, best, id, t, f)
# The spawn farthest from the living (the earliest among equals).
def deathmatch.pick_spawn(+s: J.Val, +me: U32, +i: U32, +best: U32, +bestc: F32) -> U32:
  deathmatch.pick_spawn.k1(U32.is_ge(i, 8), s, me, i, best, bestc)

def deathmatch.pick_spawn.k2(cv: Bool, +s: J.Val, +me: U32, +i: U32, +best: U32, +bestc: F32, +c: F32) -> U32:
  match cv:
    case True{}:
      deathmatch.pick_spawn(s, me, (i + 1 : U32), i, c)
    case False{}:
      deathmatch.pick_spawn(s, me, (i + 1 : U32), best, bestc)

def deathmatch.pick_spawn.k1(cv: Bool, +s: J.Val, +me: U32, +i: U32, +best: U32, +bestc: F32) -> U32:
  match cv:
    case True{}:
      best
    case False{}:
      +c = deathmatch.clearance(s, me, deathmatch.SPAWN.x(i), deathmatch.SPAWN.y(i), gc.ids(J.get(s, "fighters")), 100.0)
      deathmatch.pick_spawn.k2(F32.is_gt(c, bestc), s, me, i, best, bestc, c)
# fn spawn(&mut self, id)
def deathmatch.Session.spawn(+s: J.Val, +id: U32) -> J.Val:
  +i = deathmatch.pick_spawn(s, id, 1, 0, deathmatch.clearance(s, id, deathmatch.SPAWN.x(0), deathmatch.SPAWN.y(0), gc.ids(J.get(s, "fighters")), 100.0))
  +px = deathmatch.SPAWN.x(i)
  +py = deathmatch.SPAWN.y(i)
  +f = deathmatch.F(s, id)
  +h0 = gc.su(gc.sf(gc.sf(J.get(f, "hero"), "x", px), "y", py), "hp", gc.u(J.get(f, "hero"), "max_hp"))
  +h1 = gear.Hero.dress(h0)
  +h2 = gc.su(h1, "armor", gc.umin(gc.u(J.get(h1, "bonus"), "armor"), rules.MAX_ARMOR()))
  +h3 = gc.sb(gc.sb(gc.su(gc.su(h2, "invulnerable", 0), "dash_ticks", 0), "shielding", False{}), "walling", False{})
  +h4 = gc.su(deathmatch.clear_champ(h3), "fire_cooldown", 0)
  +h5 = J.set(h4, "spell_cooldowns", gc.of_us([0, 0, 0, 0]))
  +f1 = gc.sf(J.set(f, "hero", h5), "yaw", F32.atan2((18.0 - py : F32), (24.0 - px : F32)))
  +f2 = gc.su(gc.su(gc.su(gc.su(f1, "protection", deathmatch.PROTECTION()), "power", 0), "stun", 0), "burn", 0)
  deathmatch.setF(s, id, f2)
# Fighter::walk_arena(input, fields): a step that a hedge forbids is taken back.
def deathmatch.Fighter.walk_arena(+f: J.Val, +input: J.Val, +fields: J.Val) -> J.Val:
  +f1 = deathmatch.Fighter.walk(f, input)
  +h = J.get(f1, "hero")
  deathmatch.Fighter.walk_arena.k1(deathmatch.fields_block(J.items(fields), gc.f(h, "x"), gc.f(h, "y"), rules.HERO_RADIUS()), f, fields, f1, h)

def deathmatch.Fighter.walk_arena.k1(cv: Bool, +f: J.Val, +fields: J.Val, +f1: J.Val, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.set(f1, "hero", gc.sf(gc.sf(J.get(f1, "hero"), "x", gc.f(J.get(f, "hero"), "x")), "y", gc.f(J.get(f, "hero"), "y")))
    case False{}:
      f1
def deathmatch.fields_block(+fs: List<&2, J.Val>, +x: F32, +y: F32, +r: F32) -> Bool:
  deathmatch.fields_block.k1(fs, fs, x, y, r)

def deathmatch.fields_block.k1(sv0: List<&2, J.Val>, +fs: List<&2, J.Val>, +x: F32, +y: F32, +r: F32) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+h, +t}:
      Bool.or(deathmatch.Field.blocks(h, x, y, r), deathmatch.fields_block(t, x, y, r))
# Fighter::walk(input)
def deathmatch.Fighter.walk(+f: J.Val, +input: J.Val) -> J.Val:
  deathmatch.Fighter.walk.k1(Bool.or(Bool.not(deathmatch.Fighter.alive(f)), U32.is_gt(gc.u(f, "stun"), 0)), f, input)

def deathmatch.Fighter.walk.k2(pr: F32 & F32, +f: J.Val, +input: J.Val, +yaw: F32, +s: F32, +c: F32) -> J.Val:
  (+mx, +my) = pr
  deathmatch.Fighter.walk2(J.set(f, "yaw", J.JF{yaw}), input, c, s, mx, my)

def deathmatch.Fighter.walk.k1(cv: Bool, +f: J.Val, +input: J.Val) -> J.Val:
  match cv:
    case True{}:
      f
    case False{}:
      +yaw = RS.f_rem_euclid((gc.f(f, "yaw") + ((RS.i_as_f32(gc.u(input, "aim_x")) * deathmatch.TURN() : F32) * rules.DT() : F32) : F32), deathmatch.TAU())
      +s = F32.sin(yaw)
      +c = F32.cos(yaw)
      +forward = F32.neg(RS.i_as_f32(gc.u(input, "move_y")))
      +strafe = RS.i_as_f32(gc.u(input, "move_x"))
      +m = rules.unit(((c * forward : F32) - (s * strafe : F32) : F32), ((s * forward : F32) + (c * strafe : F32) : F32))
      deathmatch.Fighter.walk.k2(m, f, input, yaw, s, c)
def deathmatch.Fighter.walk2(+f: J.Val, +input: J.Val, +c: F32, +s: F32, +mx: F32, +my: F32) -> J.Val:
  +keys = gc.su(gc.su(input, "aim_x", 0), "aim_y", 0)
  +k = hero.Hero.own_keys(J.get(f, "hero"), keys, False{}, True{})
  deathmatch.Fighter.walk2.k1(k, f, c, s, mx, my)

def deathmatch.Fighter.walk2.k5(pr: F32 & F32, +f: J.Val, +h3: J.Val, +bx: F32, +by: F32) -> J.Val:
  (+nx, +ny) = pr
  +h4 = gc.sf(gc.sf(h3, "x", nx), "y", ny)
  J.set(gc.sf(f, "bob", (gc.f(f, "bob") + (RS.f_hypot((nx - bx : F32), (ny - by : F32)) * 1.8 : F32) : F32)), "hero", h4)

def deathmatch.Fighter.walk2.k4(pr: F32 & F32, +f: J.Val, +h3: J.Val, +dx: F32) -> J.Val:
  (+dy, +speed) = pr
  +bx = gc.f(h3, "x")
  +by = gc.f(h3, "y")
  +p = rules.Grid.slide(deathmatch.room(), False{}, (bx, by), (((dx * speed : F32) * rules.DT() : F32), ((dy * speed : F32) * rules.DT() : F32)), rules.HERO_RADIUS(), 0)
  deathmatch.Fighter.walk2.k5(p, f, h3, bx, by)

def deathmatch.Fighter.walk2.k3(pr: F32 & F32 & F32, +f: J.Val, +h3: J.Val) -> J.Val:
  (+dx, +rest) = pr
  deathmatch.Fighter.walk2.k4(rest, f, h3, dx)

def deathmatch.Fighter.walk2.k2(pr: J.Val & F32 & F32 & F32, +f: J.Val) -> J.Val:
  (+h3, +step) = pr
  deathmatch.Fighter.walk2.k3(step, f, h3)

def deathmatch.Fighter.walk2.k1(pr: J.Val & J.Val, +f: J.Val, +c: F32, +s: F32, +mx: F32, +my: F32) -> J.Val:
  (+h0, +guarded) = pr
  +h1 = gc.sf(gc.sf(h0, "aim_x", c), "aim_y", s)
  +h2 = gc.ifj(U32.is_eq(gc.u(h1, "dash_ticks"), rules.ROLL_TICKS()), _ => gc.ifj(Bool.or(F32.is_ne(mx, 0.0), F32.is_ne(my, 0.0)), _ => gc.sf(gc.sf(h1, "dash_x", mx), "dash_y", my), _ => gc.sf(gc.sf(h1, "dash_x", c), "dash_y", s)), _ => h1)
  +pace = ((deathmatch.PACE() * RS.u_as_f32((100 + gc.u(J.get(h2, "bonus"), "speed") : U32)) : F32) / 100.0 : F32)
  +pace2 = (pace * gc.pf(U32.is_gt(gc.u(h2, "chilled"), 0), lich.CHILL_PACE(), 1.0) : F32)
  +st = hero.Hero.own_step(h2, mx, my, deathmatch.room(), False{}, 19.0, pace2)
  deathmatch.Fighter.walk2.k2(st, f)
# fn step(&mut self, inputs, book, seed)
def deathmatch.Session.step(+s: J.Val, +inputs: J.Val, +book: J.Val, +seed: W.W) -> J.Val:
  deathmatch.Session.step.k1(Bool.not(J.is_null(J.get(s, "winner"))), s, inputs, book, seed)

def deathmatch.Session.step.k3(cv: Bool, +inputs: J.Val, +book: J.Val, +seed: W.W, +s1: J.Val) -> J.Val:
  match cv:
    case True{}:
      s1
    case False{}:
      +s2 = J.set(s1, "pickups", gc.of_us(deathmatch.cool(gc.us(J.get(s1, "pickups")))))
      +s3 = deathmatch.turns(s2, inputs, book, seed, gc.ids(J.get(s2, "fighters")))
      +s4 = gc.ifj(J.is_null(J.get(s3, "winner")), _ => deathmatch.Session.tick_fields(deathmatch.Session.fly(s3)), _ => s3)
      J.set(s4, "feed", J.JA{deathmatch.feed_keep(J.items(J.get(s4, "feed")), gc.u(s4, "ticks"))})

def deathmatch.Session.step.k2(cv: Bool, +s: J.Val, +inputs: J.Val, +book: J.Val, +seed: W.W) -> J.Val:
  match cv:
    case True{}:
      s
    case False{}:
      +s1 = gc.su(s, "ticks", gc.sadd(gc.u(s, "ticks"), 1))
      deathmatch.Session.step.k3(U32.is_le(gc.u(s1, "ticks"), deathmatch.TITLE()), inputs, book, seed, s1)

def deathmatch.Session.step.k1(cv: Bool, +s: J.Val, +inputs: J.Val, +book: J.Val, +seed: W.W) -> J.Val:
  match cv:
    case True{}:
      gc.su(s, "ended", (gc.u(s, "ended") + 1 : U32))
    case False{}:
      deathmatch.Session.step.k2(U32.is_lt(deathmatch.connected(gc.vals(J.get(s, "fighters"))), 2), s, inputs, book, seed)
def deathmatch.connected(+fs: List<&2, J.Val>) -> U32:
  deathmatch.connected.k1(fs, fs)

def deathmatch.connected.k1(sv0: List<&2, J.Val>, +fs: List<&2, J.Val>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+h, +t}:
      (gc.pu(gc.b(h, "connected"), 1, 0) + deathmatch.connected(t) : U32)
def deathmatch.cool(+xs: List<&2, U32>) -> List<&2, U32>:
  deathmatch.cool.k1(xs, xs)

def deathmatch.cool.k1(sv0: List<&2, U32>, +xs: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      gc.ssub(h, 1) <> deathmatch.cool(t)
# feed.retain(|f| ticks.saturating_sub(f.tick) < 6 * HZ)
def deathmatch.feed_keep(+fs: List<&2, J.Val>, +ticks: U32) -> List<&2, J.Val>:
  deathmatch.feed_keep.k1(fs, fs, ticks)

def deathmatch.feed_keep.k1(sv0: List<&2, J.Val>, +fs: List<&2, J.Val>, +ticks: U32) -> List<&2, J.Val>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      gc.ifx_j(U32.is_lt(gc.ssub(ticks, gc.u(h, "tick")), (6 * rules.HZ() : U32)), h, deathmatch.feed_keep(t, ticks))
# The fighters, one by one in seat order; a won round ends the loop (the rest of the turn is skipped).
def deathmatch.turns(+s: J.Val, +inputs: J.Val, +book: J.Val, +seed: W.W, +ids: List<&2, U32>) -> J.Val:
  deathmatch.turns.k1(ids, s, inputs, book, seed, ids)

def deathmatch.turns.k3(cv: Bool, +s: J.Val, +inputs: J.Val, +book: J.Val, +seed: W.W, +id: U32, +t: List<&2, U32>, +f: J.Val) -> J.Val:
  match cv:
    case True{}:
      +respawn = (gc.u(f, "respawn") - 1 : U32)
      +s1 = deathmatch.setF(s, id, gc.su(f, "respawn", respawn))
      deathmatch.turns(gc.ifj(U32.is_zero(respawn), _ => deathmatch.Session.spawn(s1, id), _ => s1), inputs, book, seed, t)
    case False{}:
      deathmatch.turn(s, inputs, book, seed, id, t, f)

def deathmatch.turns.k2(cv: Bool, +s: J.Val, +inputs: J.Val, +book: J.Val, +seed: W.W, +id: U32, +t: List<&2, U32>, +f: J.Val) -> J.Val:
  match cv:
    case True{}:
      deathmatch.turns(s, inputs, book, seed, t)
    case False{}:
      deathmatch.turns.k3(U32.is_gt(gc.u(f, "respawn"), 0), s, inputs, book, seed, id, t, f)

def deathmatch.turns.k1(sv0: List<&2, U32>, +s: J.Val, +inputs: J.Val, +book: J.Val, +seed: W.W, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      s
    case Con{+id, +t}:
      +f = deathmatch.F(s, id)
      deathmatch.turns.k2(Bool.not(gc.b(f, "connected")), s, inputs, book, seed, id, t, f)
# One living fighter's turn.
def deathmatch.turn(+s: J.Val, +inputs: J.Val, +book: J.Val, +seed: W.W, +id: U32, +t: List<&2, U32>, +f: J.Val) -> J.Val:
  +h = J.get(f, "hero")
  +f1 = gc.su(gc.su(gc.su(gc.su(gc.su(f, "protection", gc.ssub(gc.u(f, "protection"), 1)), "power", gc.ssub(gc.u(f, "power"), 1)), "flash", gc.ssub(gc.u(f, "flash"), 1)), "stun", gc.ssub(gc.u(f, "stun"), 1)), "fart_wait", gc.ssub(gc.u(f, "fart_wait"), 1))
  +h1 = gc.ifj(U32.is_zero(U32.mod(gc.u(s, "ticks"), rules.HZ())), _ => gc.su(gc.su(h, "leeched", 0), "passive", 0), _ => h)
  +h2 = gc.su(gc.su(gc.su(gc.su(gc.su(gc.su(h1, "chilled", gc.ssub(gc.u(h1, "chilled"), 1)), "invulnerable", gc.ssub(gc.u(h1, "invulnerable"), 1)), "fire_cooldown", gc.ssub(gc.u(h1, "fire_cooldown"), 1)), "sword_cooldown", gc.ssub(gc.u(h1, "sword_cooldown"), 1)), "play_cooldown", gc.ssub(gc.u(h1, "play_cooldown"), 1)), "bomb_cooldown", gc.ssub(gc.u(h1, "bomb_cooldown"), 1))
  +c = deathmatch.stance(h2)
  +h3 = deathmatch.put_champ(h2, gc.su(c, "fury", gc.ssub(gc.u(c, "fury"), 1)))
  +h4 = J.set(h3, "spell_cooldowns", gc.of_us(deathmatch.cool(gc.us(J.get(h3, "spell_cooldowns")))))
  +input = gc.input(inputs, id)
  +f2 = deathmatch.Fighter.walk_arena(J.set(f1, "hero", h4), input, J.get(s, "fields"))
  +s1 = deathmatch.setF(s, id, f2)
  +s2 = deathmatch.burn(s1, id)
  +s3 = deathmatch.blows(s2, id)
  +s4 = gc.ifj(Bool.and(U32.is_zero(gc.u(deathmatch.F(s3, id), "protection")), U32.is_zero(U32.mod(gc.u(s3, "ticks"), rules.ORBIT_EVERY()))), _ => deathmatch.Session.orbits(s3, id), _ => s3)
  +s5 = deathmatch.Session.attack(s4, id, input, book, seed)
  deathmatch.turn.k1(Bool.not(J.is_null(J.get(s5, "winner"))), inputs, book, seed, id, t, s5)

def deathmatch.turn.k2(cv: Bool, +inputs: J.Val, +book: J.Val, +seed: W.W, +id: U32, +t: List<&2, U32>, +s5: J.Val, +f3: J.Val) -> J.Val:
  match cv:
    case True{}:
      deathmatch.turns(s5, inputs, book, seed, t)
    case False{}:
      deathmatch.turns(deathmatch.pickups(s5, id, 0), inputs, book, seed, t)

def deathmatch.turn.k1(cv: Bool, +inputs: J.Val, +book: J.Val, +seed: W.W, +id: U32, +t: List<&2, U32>, +s5: J.Val) -> J.Val:
  match cv:
    case True{}:
      s5
    case False{}:
      +f3 = deathmatch.F(s5, id)
      deathmatch.turn.k2(Bool.not(deathmatch.Fighter.alive(f3)), inputs, book, seed, id, t, s5, f3)
# The burn: it eases a tick, and every fifteenth the one who set it fires for 4.
def deathmatch.burn(+s: J.Val, +id: U32) -> J.Val:
  +f = deathmatch.F(s, id)
  deathmatch.burn.k1(U32.is_gt(gc.u(f, "burn"), 0), s, id, f)

def deathmatch.burn.k3(pr: J.Val & Bool) -> J.Val:
  (+s2, +landed) = pr
  s2

def deathmatch.burn.k2(cv: Bool, +id: U32, +f: J.Val, +burn: U32, +s1: J.Val) -> J.Val:
  match cv:
    case True{}:
      +r = deathmatch.Session.hit(s1, gc.u(f, "burner"), id, 4, 0.0, 0.0)
      deathmatch.burn.k3(r)
    case False{}:
      s1

def deathmatch.burn.k1(cv: Bool, +s: J.Val, +id: U32, +f: J.Val) -> J.Val:
  match cv:
    case True{}:
      +burn = (gc.u(f, "burn") - 1 : U32)
      +s1 = deathmatch.setF(s, id, gc.su(f, "burn", burn))
      deathmatch.burn.k2(U32.is_zero(U32.mod(burn, 15)), id, f, burn, s1)
    case False{}:
      s
# The champion's slam and rot: wind-up and rot run down; both strike on their beats.
def deathmatch.blows(+s: J.Val, +id: U32) -> J.Val:
  +h = deathmatch.H(s, id)
  +c = deathmatch.stance(h)
  +slam = U32.is_eq(gc.u(c, "windup"), 1)
  +windup = gc.ssub(gc.u(c, "windup"), 1)
  +rot = gc.ssub(gc.u(c, "rot"), 1)
  +rot_hit = Bool.and(U32.is_gt(rot, 0), U32.is_zero(U32.mod(rot, champions.ROT_EVERY())))
  +s1 = deathmatch.setH(s, id, deathmatch.put_champ(h, gc.su(gc.su(c, "windup", windup), "rot", rot)))
  +at_x = gc.f(h, "x")
  +at_y = gc.f(h, "y")
  +slam_reach = gc.f(spell_upgrades.Hero.spell_step(h, "groundslam"), "slam_reach")
  +slam_damage = spell_upgrades.Hero.spell_damage(h, "groundslam", champions.SLAM_DAMAGE())
  +rot_reach = gc.f(spell_upgrades.Hero.spell_step(h, "rot"), "rot_reach")
  +rot_damage = spell_upgrades.Hero.spell_damage(h, "rot", champions.ROT_DAMAGE())
  +s2 = gc.ifj(slam, _ => deathmatch.Session.area(s1, id, at_x, at_y, slam_reach, slam_damage), _ => s1)
  gc.ifj(rot_hit, _ => deathmatch.Session.area(s2, id, at_x, at_y, rot_reach, rot_damage), _ => s2)
# The pickups a living fighter walks over.
def deathmatch.pickups(+s: J.Val, +id: U32, +k: U32) -> J.Val:
  deathmatch.pickups.k1(U32.is_ge(k, 5), s, id, k)

def deathmatch.pickups.k5(cv: Bool, +s: J.Val, +id: U32, +k: U32, +f: J.Val, +kind: U32) -> J.Val:
  match cv:
    case True{}:
      deathmatch.taken(deathmatch.setF(s, id, gc.su(f, "power", deathmatch.POWER_TIME())), id, k)
    case False{}:
      deathmatch.pickups(s, id, (k + 1 : U32))

def deathmatch.pickups.k4(cv: Bool, +s: J.Val, +id: U32, +k: U32, +f: J.Val, +h: J.Val, +kind: U32) -> J.Val:
  match cv:
    case True{}:
      deathmatch.taken(deathmatch.setH(s, id, gc.su(h, "armor", gc.umin((gc.u(h, "armor") + 2 : U32), rules.MAX_ARMOR()))), id, k)
    case False{}:
      deathmatch.pickups.k5(U32.is_eq(kind, 2), s, id, k, f, kind)

def deathmatch.pickups.k3(cv: Bool, +s: J.Val, +id: U32, +k: U32, +f: J.Val, +h: J.Val, +kind: U32) -> J.Val:
  match cv:
    case True{}:
      deathmatch.taken(deathmatch.setH(s, id, gc.su(h, "hp", gc.umin((gc.u(h, "hp") + 35 : U32), gc.u(h, "max_hp")))), id, k)
    case False{}:
      deathmatch.pickups.k4(Bool.and(U32.is_eq(kind, 1), U32.is_lt(gc.u(h, "armor"), rules.MAX_ARMOR())), s, id, k, f, h, kind)

def deathmatch.pickups.k2(cv: Bool, +s: J.Val, +id: U32, +k: U32, +f: J.Val, +h: J.Val, +rest: U32) -> J.Val:
  match cv:
    case True{}:
      deathmatch.pickups(s, id, (k + 1 : U32))
    case False{}:
      +kind = deathmatch.PICKUP.kind(k)
      deathmatch.pickups.k3(Bool.and(U32.is_eq(kind, 0), U32.is_lt(gc.u(h, "hp"), gc.u(h, "max_hp"))), s, id, k, f, h, kind)

def deathmatch.pickups.k1(cv: Bool, +s: J.Val, +id: U32, +k: U32) -> J.Val:
  match cv:
    case True{}:
      s
    case False{}:
      +f = deathmatch.F(s, id)
      +h = J.get(f, "hero")
      +rest = J.u32(J.nth(J.get(s, "pickups"), k))
      deathmatch.pickups.k2(Bool.or(U32.is_gt(rest, 0), F32.is_gt(RS.f_hypot((deathmatch.PICKUP.x(k) - gc.f(h, "x") : F32), (deathmatch.PICKUP.y(k) - gc.f(h, "y") : F32)), 1.2)), s, id, k, f, h, rest)
def deathmatch.taken(+s: J.Val, +id: U32, +k: U32) -> J.Val:
  deathmatch.pickups(J.set(s, "pickups", J.set_nth(J.get(s, "pickups"), k, J.JU{deathmatch.PICKUP_REST()})), id, (k + 1 : U32))
# fn deathmatch_showing(&self)
def deathmatch.Run.deathmatch_showing(+run: J.Val) -> Bool:
  Bool.not(J.is_null(J.get(run, "deathmatch")))
# pub fn start_deathmatch(&mut self)
def deathmatch.Run.start_deathmatch(+run: J.Val) -> J.Val:
  deathmatch.Run.start_deathmatch.k1(Bool.or(Bool.not(String.eq(J.str(J.get(rules.Run.room(run), "kind")), "forest")), Bool.not(J.is_null(J.get(run, "deathmatch")))), run)

def deathmatch.Run.start_deathmatch.k1(cv: Bool, +run: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +r1 = J.set(run, "forest", forest.Forest.leave(J.get(run, "forest")))
      +s0 = deathmatch.Session.new(J.get(r1, "players"), J.get(r1, "book"))
      +s1 = J.set(s0, "ante", deathmatch.ante(J.get(r1, "players"), gc.ids(J.get(r1, "players")), J.get(s0, "fighters")))
      gc.found(J.set(r1, "deathmatch", s1), 0, "Knights Wish: WASD moves, arrows turn, F fires, Space guards, 1-4 cast. First to ten.")
# ante: a tenth of the gold carried, for each seated fighter.
def deathmatch.ante(+players: J.Val, +ids: List<&2, U32>, +fighters: J.Val) -> J.Val:
  deathmatch.ante.k1(ids, players, ids, fighters)

def deathmatch.ante.k2(cv: Bool, +players: J.Val, +fighters: J.Val, +id: U32, +t: List<&2, U32>) -> J.Val:
  match cv:
    case True{}:
      J.set(deathmatch.ante(players, t, fighters), gc.key(id), J.JU{U32.div(realm.Spoils.get(J.get(gc.seat(players, id), "carried"), "gold"), 10)})
    case False{}:
      deathmatch.ante(players, t, fighters)

def deathmatch.ante.k1(sv0: List<&2, U32>, +players: J.Val, +ids: List<&2, U32>, +fighters: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      J.obj()
    case Con{+id, +t}:
      deathmatch.ante.k2(gc.has_seat(fighters, id), players, fighters, id, t)
# pub(super) fn tick_deathmatch(&mut self, inputs)
def deathmatch.Run.tick_deathmatch(+run: J.Val, +inputs: J.Val) -> J.Val:
  +s = J.get(run, "deathmatch")
  deathmatch.Run.tick_deathmatch.k1(J.is_null(s), run, inputs, s)

def deathmatch.Run.tick_deathmatch.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +s: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +crossroads = Bool.not(J.is_null(J.get(run, "crossroads")))
      +s1 = deathmatch.arrivals(run, s, crossroads, gc.ids(J.get(run, "players")))
      +s2 = J.set(s1, "fighters", deathmatch.connect(run, J.get(s1, "fighters"), crossroads, gc.ids(J.get(s1, "fighters"))))
      deathmatch.Run.tick_deathmatch.go(J.set(run, "deathmatch", J.JNull{}), inputs, s2, crossroads)
# Seats arriving late get their real kit, unless the round is won, the crossroads holds, or they are outside.
def deathmatch.arrivals(+run: J.Val, +s: J.Val, +crossroads: Bool, +ids: List<&2, U32>) -> J.Val:
  deathmatch.arrivals.k1(ids, run, s, crossroads, ids)

def deathmatch.arrivals.k2(cv: Bool, +run: J.Val, +s: J.Val, +crossroads: Bool, +id: U32, +t: List<&2, U32>, +h: J.Val, +skip: Bool) -> J.Val:
  match cv:
    case True{}:
      +s1 = J.set(s, "fighters", gc.put_seat(J.get(s, "fighters"), id, deathmatch.Fighter.new(h, gc.ssub(id, 1), J.get(run, "book"))))
      +s2 = J.set(s1, "ante", gc.put_seat(J.get(s1, "ante"), id, J.JU{U32.div(realm.Spoils.get(J.get(h, "carried"), "gold"), 10)}))
      deathmatch.arrivals(run, s2, crossroads, t)
    case False{}:
      deathmatch.arrivals(run, s, crossroads, t)

def deathmatch.arrivals.k1(sv0: List<&2, U32>, +run: J.Val, +s: J.Val, +crossroads: Bool, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      s
    case Con{+id, +t}:
      +h = gc.seat(J.get(run, "players"), id)
      +skip = Bool.or(crossroads, Bool.or(gc.b(h, "absent"), gc.has_seat(J.get(J.get(run, "exits"), "outside"), id)))
      deathmatch.arrivals.k2(Bool.and(Bool.not(skip), Bool.and(J.is_null(J.get(s, "winner")), Bool.not(gc.has_seat(J.get(s, "fighters"), id)))), run, s, crossroads, id, t, h, skip)
# Each fighter is connected while its seat is here (not away, not absent), and inside the room.
def deathmatch.connect(+run: J.Val, +fs: J.Val, +crossroads: Bool, +ids: List<&2, U32>) -> J.Val:
  deathmatch.connect.k1(ids, run, fs, crossroads, ids)

def deathmatch.connect.k1(sv0: List<&2, U32>, +run: J.Val, +fs: J.Val, +crossroads: Bool, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      fs
    case Con{+id, +t}:
      +h = gc.seat(J.get(run, "players"), id)
      +here = Bool.and(Bool.not(J.is_null(h)), Bool.and(Bool.not(gc.b(h, "away")), Bool.not(gc.b(h, "absent"))))
      +inside = Bool.or(crossroads, Bool.not(gc.has_seat(J.get(J.get(run, "exits"), "outside"), id)))
      deathmatch.connect(run, gc.put_seat(fs, id, gc.sb(gc.seat(fs, id), "connected", Bool.and(here, inside))), crossroads, t)
def deathmatch.kills_sum(+fs: List<&2, J.Val>) -> U32:
  deathmatch.kills_sum.k1(fs, fs)

def deathmatch.kills_sum.k1(sv0: List<&2, J.Val>, +fs: List<&2, J.Val>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+h, +t}:
      (gc.u(h, "kills") + deathmatch.kills_sum(t) : U32)
def deathmatch.Run.tick_deathmatch.go(+run: J.Val, +inputs: J.Val, +s: J.Val, +crossroads: Bool) -> J.Val:
  +before_none = J.is_null(J.get(s, "winner"))
  +kills = deathmatch.kills_sum(gc.vals(J.get(s, "fighters")))
  +tick = gc.u(s, "ticks")
  +s1 = deathmatch.Session.step(s, inputs, J.get(run, "book"), W.of_j(J.get(run, "seed")))
  +r1 = gc.ifj(Bool.and(before_none, U32.is_gt(gc.u(s1, "ticks"), tick)), _ => deathmatch.fire_sounds(run, s1, gc.ids(J.get(s1, "fighters"))), _ => run)
  +r2 = gc.ifj(U32.is_gt(deathmatch.kills_sum(gc.vals(J.get(s1, "fighters"))), kills), _ => gc.sound(r1, "hit"), _ => r1)
  deathmatch.Run.tick_deathmatch.go.k1(Bool.and(Bool.not(crossroads), Bool.and(before_none, Bool.not(J.is_null(J.get(s1, "winner"))))), crossroads, before_none, s1, r2)

def deathmatch.Run.tick_deathmatch.go.k1(cv: Bool, +crossroads: Bool, +before_none: Bool, +s1: J.Val, +r2: J.Val) -> J.Val:
  match cv:
    case True{}:
      deathmatch.podium(r2, s1)
    case False{}:
      deathmatch.Run.tick_deathmatch.end(r2, s1, crossroads)
# The sound of each shot loosed this tick (flash == 4 on a living fighter).
def deathmatch.fire_sounds(+run: J.Val, +s: J.Val, +ids: List<&2, U32>) -> J.Val:
  deathmatch.fire_sounds.k1(ids, run, s, ids)

def deathmatch.fire_sounds.k2(cv: Bool, +run: J.Val, +s: J.Val, +t: List<&2, U32>, +f: J.Val) -> J.Val:
  match cv:
    case True{}:
      deathmatch.fire_sounds(gc.sound(run, deathmatch.shot_sound(J.get(f, "hero"))), s, t)
    case False{}:
      deathmatch.fire_sounds(run, s, t)

def deathmatch.fire_sounds.k1(sv0: List<&2, U32>, +run: J.Val, +s: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      +f = deathmatch.F(s, id)
      deathmatch.fire_sounds.k2(Bool.and(deathmatch.Fighter.alive(f), U32.is_eq(gc.u(f, "flash"), 4)), run, s, t, f)
def deathmatch.shot_sound(+h: J.Val) -> String:
  deathmatch.shot_sound.k1(Bool.or(Bool.not(J.is_null(J.get(J.get(h, "forged"), "melee"))), gear.Hero.unarmed(h)), h)

def deathmatch.shot_sound.k1(cv: Bool, +h: J.Val) -> String:
  match cv:
    case True{}:
      "swing"
    case False{}:
      deathmatch.shot_sound_of(classes.shot_sound(h), gc.s(h, "weapon"))
def deathmatch.shot_sound_of(+m: Maybe<&2, String>, +weapon: String) -> String:
  deathmatch.shot_sound_of.k1(m, m, weapon)

def deathmatch.shot_sound_of.k3(cv: Bool, +weapon: String) -> String:
  match cv:
    case True{}:
      "shot_crossbow"
    case False{}:
      gc.ps(String.eq(weapon, "handgonne"), "shot_handgonne", "shot_spark")

def deathmatch.shot_sound_of.k2(cv: Bool, +weapon: String) -> String:
  match cv:
    case True{}:
      "shot_bow"
    case False{}:
      deathmatch.shot_sound_of.k3(String.eq(weapon, "crossbow"), weapon)

def deathmatch.shot_sound_of.k1(sv0: Maybe<&2, String>, +m: Maybe<&2, String>, +weapon: String) -> String:
  match sv0:
    case Some{+name}:
      name
    case None{}:
      deathmatch.shot_sound_of.k2(String.eq(weapon, "bow"), weapon)
# The round is won: stakes change hands, the winner takes the purse, the winner sound.
def deathmatch.podium(+run: J.Val, +s: J.Val) -> J.Val:
  +winner = gc.u(s, "winner")
  +r = deathmatch.stakes(run, s, winner, J.fields(J.get(s, "ante")), 0)
  deathmatch.podium.k1(r, s, winner)

def deathmatch.podium.k1(pr: J.Val & J.Val, +s: J.Val, +winner: U32) -> J.Val:
  (+run1, +purse) = pr
  +s1 = J.set(s, "purse", purse)
  +run2 = gc.ifj(gc.has_seat(J.get(run1, "players"), winner), _ => deathmatch.collect(run1, winner, J.u32(purse)), _ => run1)
  deathmatch.Run.tick_deathmatch.end(gc.cue(gc.sound(run2, "play_card"), "pastime_won"), s1, False{})
# for (seat, stake) in ante: the seat pays min(stake, gold) into the purse; the winner wears the laurel.
def deathmatch.stakes(+run: J.Val, +s: J.Val, +winner: U32, +ante: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +purse: U32) -> J.Val & J.Val:
  deathmatch.stakes.k1(ante, run, s, winner, ante, purse)

def deathmatch.stakes.k2(cv: Bool, +run: J.Val, +s: J.Val, +winner: U32, +purse: U32, +stake: J.Val, +t: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +seat: U32, +h: J.Val) -> J.Val & J.Val:
  match cv:
    case True{}:
      deathmatch.stakes(run, s, winner, t, purse)
    case False{}:
      +amount = gc.umin(J.u32(stake), realm.Spoils.get(J.get(h, "carried"), "gold"))
      +h1 = gc.sb(J.set(h, "carried", realm.Spoils.take(J.get(h, "carried"), gc.su(J.obj(), "gold", amount))), "laurel", U32.is_eq(seat, winner))
      deathmatch.stakes(J.set(run, "players", gc.put_seat(J.get(run, "players"), seat, h1)), s, winner, t, (purse + amount : U32))

def deathmatch.stakes.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +run: J.Val, +s: J.Val, +winner: U32, +ante: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +purse: U32) -> J.Val & J.Val:
  match sv0:
    case Nil{}:
      (run, J.JU{purse})
    case Con{(+k, +stake), +t}:
      +seat = gc.id(k)
      +h = gc.seat(J.get(run, "players"), seat)
      deathmatch.stakes.k2(J.is_null(h), run, s, winner, purse, stake, t, seat, h)
def deathmatch.collect(+run: J.Val, +winner: U32, +purse: U32) -> J.Val:
  +h = gc.seat(J.get(run, "players"), winner)
  J.set(run, "players", gc.put_seat(J.get(run, "players"), winner, J.set(h, "carried", realm.Spoils.add(J.get(h, "carried"), "gold", purse))))
# The round's end: after the podium the knights go home.
def deathmatch.Run.tick_deathmatch.end(+run: J.Val, +s: J.Val, +crossroads: Bool) -> J.Val:
  +r1 = J.set(run, "deathmatch", s)
  deathmatch.Run.tick_deathmatch.end.k1(Bool.and(Bool.not(crossroads), Bool.and(Bool.not(J.is_null(J.get(s, "winner"))), U32.is_ge(gc.u(s, "ended"), deathmatch.PODIUM()))), s, crossroads, r1)

def deathmatch.Run.tick_deathmatch.end.k1(cv: Bool, +s: J.Val, +crossroads: Bool, +r1: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.set(deathmatch.leave_all(r1, gc.ids(J.get(r1, "players"))), "deathmatch", J.JNull{})
    case False{}:
      r1
def deathmatch.leave_all(+run: J.Val, +ids: List<&2, U32>) -> J.Val:
  deathmatch.leave_all.k1(ids, run, ids)

def deathmatch.leave_all.k2(pr: J.Val & Bool, +t: List<&2, U32>) -> J.Val:
  (+run2, +left) = pr
  deathmatch.leave_all(run2, t)

def deathmatch.leave_all.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      +r = activity.Run.leave_activity(run, id)
      deathmatch.leave_all.k2(r, t)
