# pub fn average(records, item) -> (average, count)
def votes.average(+records: J.Val, +item: String) -> F32 & U32:
  +r = votes.average.go(gc.vals_any(records), item, 0, 0)
  votes.average.k1(r)

def votes.average.k1(pr: U32 & U32) -> F32 & U32:
  (+sum, +count) = pr
  (gc.pf(U32.is_zero(count), 0.0, (RS.u_as_f32(sum) / RS.u_as_f32(count) : F32)), count)
def votes.average.go(+rs: List<&2, J.Val>, +item: String, +sum: U32, +count: U32) -> U32 & U32:
  votes.average.go.k1(rs, rs, item, sum, count)

def votes.average.go.k2(cv: Bool, +item: String, +sum: U32, +count: U32, +t: List<&2, J.Val>, +n: U32) -> U32 & U32:
  match cv:
    case True{}:
      votes.average.go(t, item, (sum + n : U32), (count + 1 : U32))
    case False{}:
      votes.average.go(t, item, sum, count)

def votes.average.go.k1(sv0: List<&2, J.Val>, +rs: List<&2, J.Val>, +item: String, +sum: U32, +count: U32) -> U32 & U32:
  match sv0:
    case Nil{}:
      (sum, count)
    case Con{+h, +t}:
      +n = votes.stars(J.get(h, item))
      votes.average.go.k2(Bool.and(U32.is_ge(n, 1), U32.is_le(n, 5)), item, sum, count, t, n)
def votes.State.average(+st: J.Val, +item: String) -> F32 & U32:
  votes.average(J.get(st, "records"), item)
