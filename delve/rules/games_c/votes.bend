def votes.State.rate(+st: J.Val, +id: U32, +name: String, +act: String, +action: J.Val, +item: String) -> J.Val:
  +records = J.get(st, "records")
  +ratings = J.get(records, name)
  +old = J.get(ratings, item)
  +stars = votes.stars(old)
  +next = votes.next_rating(act, action, stars)
  +st1 = J.set(st, "records", J.set(records, name, gc.pj(J.is_null(ratings), J.obj(), ratings)))
  votes.State.rate.k1(J.eq(old, next), name, item, old, next, st1)

def votes.State.rate.k1(cv: Bool, +name: String, +item: String, +old: J.Val, +next: J.Val, +st1: J.Val) -> J.Val:
  match cv:
    case True{}:
      st1
    case False{}:
      +ratings1 = gc.pj(J.is_null(next), J.del(J.get(J.get(st1, "records"), name), item), J.set(J.get(J.get(st1, "records"), name), item, next))
      +change = J.set(J.set(J.set(J.obj(), "player", J.JS{name}), "item", J.JS{item}), "rating", next)
      +st2 = J.set(st1, "records", J.set(J.get(st1, "records"), name, ratings1))
      gc.push(gc.sb(st2, "dirty", True{}), "changes", change)
