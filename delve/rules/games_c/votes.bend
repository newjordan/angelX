# The rating a command sets (null clears it).
def votes.next_rating(+act: String, +action: J.Val, +stars: U32) -> J.Val:
  votes.next_rating.k1(String.eq(act, "rate"), act, action, stars)

def votes.next_rating.k4(cv: Bool, +act: String) -> J.Val:
