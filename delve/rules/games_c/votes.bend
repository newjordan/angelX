# fn ballot_inputs(&mut self, inputs) -> Option<BTreeMap<u32, Input>>
def votes.Run.ballot_inputs(+run: J.Val, +inputs: J.Val) -> J.Val & Maybe<&2, J.Val>:
  +r1 = votes.Run.ballot_inputs.arrive(run, gc.b(J.get(run, "playtest"), "ready"), gc.ids(J.get(run, "players")))
  +r2 = J.set(r1, "playtest", J.set(J.get(r1, "playtest"), "seats", votes.cool(J.get(J.get(r1, "playtest"), "seats"), gc.ids(J.get(J.get(r1, "playtest"), "seats")))))
  votes.Run.ballot_inputs.k1(votes.nothing_to_strip(r2, inputs, gc.ids(inputs)), inputs, r2)

def votes.Run.ballot_inputs.k2(pr: J.Val & J.Val) -> J.Val & Maybe<&2, J.Val>:
  (+run3, +out) = pr
  (run3, Some{out})

def votes.Run.ballot_inputs.k1(cv: Bool, +inputs: J.Val, +r2: J.Val) -> J.Val & Maybe<&2, J.Val>:
  match cv:
    case True{}:
      (r2, None{})
    case False{}:
      +r3 = votes.ballot(r2, inputs, gc.ids(inputs), J.obj())
      votes.Run.ballot_inputs.k2(r3)
def votes.Run.ballot_inputs.arrive(+run: J.Val, +ready: Bool, +ids: List<&2, U32>) -> J.Val:
  votes.Run.ballot_inputs.arrive.k1(ready, run, ready, ids)

def votes.Run.ballot_inputs.arrive.k1(cv: Bool, +run: J.Val, +ready: Bool, +ids: List<&2, U32>) -> J.Val:
  match cv:
    case True{}:
      votes.arrive_all(run, ids)
    case False{}:
      run
def votes.arrive_all(+run: J.Val, +ids: List<&2, U32>) -> J.Val:
  votes.arrive_all.k1(ids, run, ids)

def votes.arrive_all.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      votes.arrive_all(J.set(run, "playtest", votes.State.arrive(J.get(run, "playtest"), id, gc.s(gc.seat(J.get(run, "players"), id), "name"))), t)
# for seat in seats.values_mut() { seat.hint = seat.hint.saturating_sub(1) }
def votes.cool(+seats: J.Val, +ids: List<&2, U32>) -> J.Val:
  votes.cool.k1(ids, seats, ids)

def votes.cool.k1(sv0: List<&2, U32>, +seats: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      seats
    case Con{+id, +t}:
      votes.cool(gc.put_seat(seats, id, gc.su(gc.seat(seats, id), "hint", gc.ssub(gc.u(gc.seat(seats, id), "hint"), 1))), t)
# inputs.iter().all(|(id, input)| !input.skip_plate && input.vote.is_none() && !open(id))
def votes.nothing_to_strip(+run: J.Val, +inputs: J.Val, +ids: List<&2, U32>) -> Bool:
  votes.nothing_to_strip.k1(ids, run, inputs, ids)

def votes.nothing_to_strip.k1(sv0: List<&2, U32>, +run: J.Val, +inputs: J.Val, +ids: List<&2, U32>) -> Bool:
  match sv0:
    case Nil{}:
      True{}
    case Con{+id, +t}:
      +i = gc.seat(inputs, id)
      Bool.and(Bool.and(Bool.not(gc.b(i, "skip_plate")), J.is_null(J.get(i, "vote"))), Bool.and(Bool.not(votes.State.open(J.get(run, "playtest"), id)), votes.nothing_to_strip(run, inputs, t)))
def votes.ballot(+run: J.Val, +inputs: J.Val, +ids: List<&2, U32>, +out: J.Val) -> J.Val & J.Val:
  votes.ballot.k1(ids, run, inputs, ids, out)

def votes.ballot.k1(sv0: List<&2, U32>, +run: J.Val, +inputs: J.Val, +ids: List<&2, U32>, +out: J.Val) -> J.Val & J.Val:
  match sv0:
    case Nil{}:
      (run, out)
    case Con{+id, +t}:
      votes.ballot.one(run, inputs, id, t, out, gc.seat(inputs, id))
def votes.ballot.one(+run: J.Val, +inputs: J.Val, +id: U32, +t: List<&2, U32>, +out: J.Val, +input: J.Val) -> J.Val & J.Val:
  votes.ballot.one.k1(gc.b(input, "skip_plate"), run, inputs, id, t, out, input)

def votes.ballot.one.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +id: U32, +t: List<&2, U32>, +out: J.Val, +input: J.Val) -> J.Val & J.Val:
  match cv:
    case True{}:
      votes.ballot(run, inputs, t, gc.put_seat(out, id, rules.Input.default()))
    case False{}:
      +was_open = votes.State.open(J.get(run, "playtest"), id)
      +run1 = gc.ifj(J.is_null(J.get(input, "vote")), _ => run, _ => votes.Run.vote_command(run, id, J.get(input, "vote")))
      +keep = Bool.or(was_open, Bool.or(votes.State.open(J.get(run1, "playtest"), id), Bool.not(J.is_null(J.get(input, "vote")))))
      votes.ballot(run1, inputs, t, gc.put_seat(out, id, gc.pj(keep, rules.Input.default(), input)))
