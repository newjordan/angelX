# crates/delve/src/rules/colosseum.rs — the kingdom's hall for the knight-against-knight games.
# RoomKind and pastimes::Game are their snake_case serde names (String).

def colosseum.NAME() -> String:
  "Colosseum"

# CELLS[i] = (kind, (cx, cy))
def colosseum.CELLS.kind(+i: U32) -> String:
  gc.nth_s(["colosseum_hall", "keg_yard", "gander_hall"], i)

def colosseum.CELLS.cx(+i: U32) -> U32:
  gc.nth_u([12, 13, 14], i)

def colosseum.CELLS.cy() -> U32:
  RS.i_neg(12)

def colosseum.ROOMS(+i: U32) -> String:
  colosseum.CELLS.kind(i)

def colosseum.GAMES(+i: U32) -> String:
  gc.nth_s(["powder", "gander"], i)

def colosseum.is_room(+kind: String) -> Bool:
  Bool.or(String.eq(kind, "colosseum_hall"), Bool.or(String.eq(kind, "keg_yard"), String.eq(kind, "gander_hall")))

def colosseum.is_arena(+kind: String) -> Bool:
  Bool.or(String.eq(kind, "keg_yard"), String.eq(kind, "gander_hall"))

# arena(game) -> Option<RoomKind>: "" for none.
def colosseum.arena(+game: String) -> String:
  if String.eq(game, "powder"):
    "keg_yard"
  else:
    if String.eq(game, "gander"):
      "gander_hall"
    else:
      ""

# game_in(kind) -> Option<Game>: the first of GAMES whose arena is `kind`, "" for none.
def colosseum.game_in(+kind: String) -> String:
  if String.eq(colosseum.arena("powder"), kind):
    "powder"
  else:
    if String.eq(colosseum.arena("gander"), kind):
      "gander"
    else:
      ""

def colosseum.label(+kind: String) -> String:
  if String.eq(kind, "keg_yard"):
    "POWDER KEG YARD"
  else:
    if String.eq(kind, "gander_hall"):
      "GANDER JOUST HALL"
    else:
      "THE COLOSSEUM"

def colosseum.words(+game: String) -> String:
  if String.eq(game, "gander"):
    "FLAP, CLIMB, STOMP"
  else:
    "DROP, DODGE, OUTLAST"

# Tile rectangles are (column, row, width, height).
def colosseum.WALL() -> GcRect:
  GcRect{1, 1, 22, 2}

def colosseum.GATES(+i: U32) -> GcRect:
  GcRect{gc.nth_u([4, 18], i), 2, 2, 1}

def colosseum.GREAT_DOOR() -> GcRect:
  GcRect{11, 12, 2, 1}

def colosseum.ARRIVAL() -> F32 & F32:
  (12.0, 10.4)

def colosseum.GATE_FRONT(+i: U32) -> F32 & F32:
  (gc.nth_f([5.0, 19.0], i), 4.6)

def colosseum.BOARDS(+i: U32) -> GcRect:
  GcRect{gc.nth_u([2, 15], i), 7, 7, 1}

def colosseum.YARD_STANDS(+i: U32) -> GcRect:
  GcRect{gc.nth_u([6, 18, 6], i), gc.nth_u([1, 2, 12], i), gc.nth_u([17, 5, 17], i), gc.nth_u([1, 10, 1], i)}

def colosseum.YARD_GATE() -> GcRect:
  GcRect{2, 12, 2, 1}

def colosseum.YARD_ARRIVAL() -> F32 & F32:
  (3.0, 10.4)

def colosseum.HALL_GATE() -> GcRect:
  GcRect{1, 9, 2, 2}

def colosseum.HALL_ARRIVAL() -> F32 & F32:
  (12.5, 7.7)

# DOORS[i] as the world's Entrance: id, the room it stands in, its stair tiles,
# the room it leads to and where it arrives (tiles), and its board.
def colosseum.DOORS(+i: U32) -> J.Val:
  colosseum.DOORS.go(i, colosseum.door_at(i))

def colosseum.door_at(+i: U32) -> GcRect:
  if U32.is_eq(i, 0):
    colosseum.GREAT_DOOR()
  else:
    if U32.is_eq(i, 1):
      colosseum.GATES(0)
    else:
      if U32.is_eq(i, 2):
        colosseum.GATES(1)
      else:
        if U32.is_eq(i, 3):
          colosseum.YARD_GATE()
        else:
          colosseum.HALL_GATE()

def colosseum.door_front(+i: U32) -> F32 & F32:
  if U32.is_eq(i, 0):
    world.COURTYARD_ARRIVAL()
  else:
    if U32.is_eq(i, 1):
      colosseum.YARD_ARRIVAL()
    else:
      if U32.is_eq(i, 2):
        colosseum.HALL_ARRIVAL()
      else:
        if U32.is_eq(i, 3):
          colosseum.GATE_FRONT(0)
        else:
          colosseum.GATE_FRONT(1)

def colosseum.DOORS.go(+i: U32, +at: GcRect) -> J.Val:
  match at as GcRect:
    case GcRect{x: U32, y: U32, w: U32, h: U32}:
      colosseum.DOORS.fin(i, x, y, w, h, colosseum.door_front(i))

def colosseum.DOORS.fin(+i: U32, +x: U32, +y: U32, +w: U32, +h: U32, +front: F32 & F32) -> J.Val:
  (fx: F32, fy: F32) = front
  J.set(J.set(J.set(J.set(J.set(J.obj(), "id", J.JS{gc.nth_s(["colosseum-out", "colosseum-kegs", "colosseum-gander", "kegs-out", "gander-out"], i)}), "room", J.JS{gc.nth_s(["colosseum_hall", "colosseum_hall", "colosseum_hall", "keg_yard", "gander_hall"], i)}), "at", J.JA{[J.JU{x}, J.JU{y}, J.JU{w}, J.JU{h}]}), "to", J.set(J.set(J.obj(), "room", J.JS{gc.nth_s(["gate", "keg_yard", "gander_hall", "colosseum_hall", "colosseum_hall"], i)}), "front", gc.pairf(fx, fy))), "label", J.JS{gc.nth_s(["THE KINGDOM", "POWDER KEG", "GANDER JOUST", "COLOSSEUM HALL", "COLOSSEUM HALL"], i)})

# blocks(kind): its rectangles.
def colosseum.blocks(+kind: String) -> List<&2, GcRect>:
  if String.eq(kind, "colosseum_hall"):
    [colosseum.WALL(), colosseum.BOARDS(0), colosseum.BOARDS(1)]
  else:
    if String.eq(kind, "keg_yard"):
      [colosseum.YARD_STANDS(0), colosseum.YARD_STANDS(1), colosseum.YARD_STANDS(2)]
    else:
      Nil{}

# pub fn room(kind, cell) -> Room: solid rock, the floor inside the wall ring,
# the kind's blocks, and the stair tiles of every door standing in it.
def colosseum.room(+kind: String, +cx: U32, +cy: U32) -> J.Val:
  r0: J.Val = layout.Room.solid_rock(cx, cy)
  r1: J.Val = J.set(r0, "kind", J.JS{kind})
  r2: J.Val = colosseum.floor(r1, 1, 1)
  r3: J.Val = colosseum.fill_all(r2, colosseum.blocks(kind), TileBlock{})
  colosseum.stairs(r3, kind, 0)

# for y in 1..ROWS-1 { for x in 1..COLS-1 { set(x, y, Floor) } }
def colosseum.floor(+room: J.Val, +x: U32, +y: U32) -> J.Val:
  if U32.is_ge(y, 13):
    room
  else:
    if U32.is_ge(x, 23):
      colosseum.floor(room, 1, (y + 1 : U32))
    else:
      colosseum.floor(layout.Room.set(room, x, y, TileFloor{}), (x + 1 : U32), y)

def colosseum.fill_all(+room: J.Val, +rects: List<&2, GcRect>, +tile: LayTile) -> J.Val:
  match rects as List<&2, GcRect>:
    case Nil{}:
      room
    case Con{h, t}:
      colosseum.fill_all(colosseum.fill(room, h, tile), t, tile)

def colosseum.fill(+room: J.Val, +at: GcRect, +tile: LayTile) -> J.Val:
  match at as GcRect:
    case GcRect{x: U32, y: U32, w: U32, h: U32}:
      colosseum.fill_rows(room, x, y, w, (y + h : U32), x, tile)

def colosseum.fill_rows(+room: J.Val, +x: U32, +y: U32, +w: U32, +end: U32, +x0: U32, +tile: LayTile) -> J.Val:
  if U32.is_ge(y, end):
    room
  else:
    colosseum.fill_rows(colosseum.fill_cols(room, x0, y, w, tile), x0, (y + 1 : U32), w, end, x0, tile)

def colosseum.fill_cols(+room: J.Val, +x: U32, +y: U32, +w: U32, +tile: LayTile) -> J.Val:
  if U32.is_zero(w):
    room
  else:
    colosseum.fill_cols(layout.Room.set(room, x, y, tile), (x + 1 : U32), y, (w - 1 : U32), tile)

# for e in DOORS.iter().filter(|e| e.room == kind): its stair tiles.
def colosseum.stairs(+room: J.Val, +kind: String, +i: U32) -> J.Val:
  if U32.is_ge(i, 5):
    room
  else:
    if String.eq(J.str(J.get(colosseum.DOORS(i), "room")), kind):
      colosseum.stairs(colosseum.fill(room, colosseum.door_at(i), TileStairs{}), kind, (i + 1 : U32))
    else:
      colosseum.stairs(room, kind, (i + 1 : U32))

# fn arena_heat_on(&self): is_arena(self.room().kind) && self.pastimes.heat.is_some()
def colosseum.Run.arena_heat_on(+run: J.Val) -> Bool:
  Bool.and(colosseum.is_arena(J.str(J.get(rules.Run.room(run), "kind"))), Bool.not(J.is_null(J.get(J.get(run, "pastimes"), "heat"))))

# fn arena_return(&self) -> Option<exits::Entry>: the hall's gate in front of the arena's own.
def colosseum.Run.arena_return(+run: J.Val) -> Maybe<&2, J.Val>:
  colosseum.Run.arena_return.go(run, colosseum.game_gate(J.str(J.get(rules.Run.room(run), "kind"))))

# The index of the GAMES entry whose arena is `kind`, or 99.
def colosseum.game_gate(+kind: String) -> U32:
  if String.eq(colosseum.arena("powder"), kind):
    0
  else:
    if String.eq(colosseum.arena("gander"), kind):
      1
    else:
      99

def colosseum.Run.arena_return.go(+run: J.Val, +gate: U32) -> Maybe<&2, J.Val>:
  if U32.is_eq(gate, 99):
    None{}
  else:
    colosseum.Run.arena_return.hall(run, gate, world.room_of(J.get(run, "dungeon"), "colosseum_hall"))

def colosseum.Run.arena_return.hall(+run: J.Val, +gate: U32, +at: Maybe<&2, U32>) -> Maybe<&2, J.Val>:
  match at:
    case None{}:
      None{}
    case Some{hall}:
      Some{J.set(J.set(J.obj(), "at", J.JU{hall}), "party", colosseum.party(J.get(run, "players"), gc.ids(J.get(run, "players")), 0, gc.len_u(gc.ids(J.get(run, "players"))), colosseum.GATE_FRONT(gate)))}

# The party's spots: slot s stands at (x*2 + (s - (count-1)/2)*2.4, y*2).
def colosseum.party(+players: J.Val, +ids: List<&2, U32>, +slot: U32, +n: U32, +front: F32 & F32) -> J.Val:
  (x: F32, y: F32) = front
  colosseum.party.go(ids, slot, RS.u_as_f32(n), x, y)

def colosseum.party.go(+ids: List<&2, U32>, +slot: U32, +count: F32, +x: F32, +y: F32) -> J.Val:
  match ids as List<&2, U32>:
    case Nil{}:
      J.obj()
    case Con{id, t}:
      offset: F32 = ((RS.u_as_f32(slot) - (count - 1.0 : F32) / 2.0 : F32) * 2.4 : F32)
      J.set(colosseum.party.go(t, (slot + 1 : U32), count, x, y), gc.key(id), gc.pairf((x * layout.TILE_UNITS() + offset : F32), (y * layout.TILE_UNITS() : F32)))
