# pub fn room(kind, cell, door) -> Room
def nooks.room(+kind: String, +cx: U32, +cy: U32, +door: U32) -> J.Val:
  +r0 = J.set(layout.Room.solid_rock(cx, cy), "kind", J.JS{kind})
  +r1 = nooks.fill(r0, GcRect{1, 1, (layout.COLS() - 2 : U32), (layout.ROWS() - 2 : U32)}, TileFloor{})
  +r2 = nooks.fill_all(r1, nooks.blocks(kind), TileBlock{})
  layout.Room.open_door(r2, door)
# pub fn add_nook(floor: &mut Floor) -> bool: (floor, added)
def nooks.add_nook(+floor: J.Val) -> J.Val & Bool:
  +rooms = J.items(J.get(floor, "rooms"))
  +depth = gc.u(floor, "depth")
  nooks.add_nook.k1(Bool.or(U32.is_zero(depth), Bool.or(U32.is_ge(depth, rules.DEEPEST()), Bool.or(U32.is_ge(gc.len(rooms), 63), nooks.any_nook(rooms)))), floor, rooms, depth)

def nooks.add_nook.k1(cv: Bool, +floor: J.Val, +rooms: List<&2, J.Val>, +depth: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      (floor, False{})
    case False{}:
      +kind = nooks.for_floor(gc.s(floor, "pack"), depth)
      nooks.add.hosts(floor, kind, 0)
def nooks.any_nook(+rooms: List<&2, J.Val>) -> Bool:
  nooks.any_nook.k1(rooms, rooms)

def nooks.any_nook.k1(sv0: List<&2, J.Val>, +rooms: List<&2, J.Val>) -> Bool:
