def nooks.fill(+room: J.Val, +at: GcRect, +tile: LayTile) -> J.Val:
  nooks.fill.k1(at, room, at, tile)

def nooks.fill.k1(sv0: GcRect, +room: J.Val, +at: GcRect, +tile: LayTile) -> J.Val:
  match sv0:
