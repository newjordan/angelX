    case Nil{}:
      False{}
    case Con{+h, +t}:
      Bool.or(nooks.RoomKind.nook(gc.s(h, "kind")), nooks.any_nook(t))
# Does the host kind match the `want` row (0 fight; 1 hall; 2 treasure; 3 start or sanctuary)?
def nooks.wanted(+want: U32, +kind: String) -> Bool:
  nooks.wanted.k1(U32.is_eq(want, 0), want, kind)

def nooks.wanted.k3(cv: Bool, +want: U32, +kind: String) -> Bool:
  match cv:
    case True{}:
      String.eq(kind, "treasure")
    case False{}:
      Bool.or(String.eq(kind, "start"), String.eq(kind, "sanctuary"))

def nooks.wanted.k2(cv: Bool, +want: U32, +kind: String) -> Bool:
  match cv:
    case True{}:
      String.eq(kind, "hall")
    case False{}:
      nooks.wanted.k3(U32.is_eq(want, 2), want, kind)

def nooks.wanted.k1(cv: Bool, +want: U32, +kind: String) -> Bool:
  match cv:
    case True{}:
      String.eq(kind, "fight")
    case False{}:
      nooks.wanted.k2(U32.is_eq(want, 1), want, kind)
# The outer loops: want rows, then lonely true/false.
def nooks.add.hosts(+floor: J.Val, +kind: String, +step: U32) -> J.Val & Bool:
  nooks.add.hosts.k1(U32.is_ge(step, 8), floor, kind, step)

def nooks.add.hosts.k3(cv: Bool, +kind: String, +step: U32, +f2: J.Val, +done: Bool) -> J.Val & Bool:
  match cv:
    case True{}:
      (f2, True{})
    case False{}:
      nooks.add.hosts(f2, kind, (step + 1 : U32))

def nooks.add.hosts.k2(pr: J.Val & Bool, +kind: String, +step: U32) -> J.Val & Bool:
  (+f2, +done) = pr
  nooks.add.hosts.k3(done, kind, step, f2, done)

def nooks.add.hosts.k1(cv: Bool, +floor: J.Val, +kind: String, +step: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      (floor, False{})
    case False{}:
      +r = nooks.add.rows(floor, kind, U32.div(step, 2), U32.is_eq(U32.mod(step, 2), 0), gc.len(J.items(J.get(floor, "rooms"))))
      nooks.add.hosts.k2(r, kind, step)
# for i in (0..len).rev(): the room `i` as host; `n` is the number of rooms still to try (from the back).
def nooks.add.rows(+floor: J.Val, +kind: String, +want: U32, +lonely: Bool, +n: U32) -> J.Val & Bool:
  nooks.add.rows.k1(U32.is_zero(n), floor, kind, want, lonely, n)

def nooks.add.rows.k4(cv: Bool, +kind: String, +want: U32, +lonely: Bool, +i: U32, +f2: J.Val, +done: Bool) -> J.Val & Bool:
  match cv:
    case True{}:
      (f2, True{})
    case False{}:
      nooks.add.rows(f2, kind, want, lonely, i)

def nooks.add.rows.k3(pr: J.Val & Bool, +kind: String, +want: U32, +lonely: Bool, +i: U32) -> J.Val & Bool:
  (+f2, +done) = pr
  nooks.add.rows.k4(done, kind, want, lonely, i, f2, done)

def nooks.add.rows.k2(cv: Bool, +floor: J.Val, +kind: String, +want: U32, +lonely: Bool, +i: U32, +host: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      nooks.add.rows(floor, kind, want, lonely, i)
    case False{}:
      +r = nooks.add.dirs(floor, kind, lonely, i, host, 0)
      nooks.add.rows.k3(r, kind, want, lonely, i)

def nooks.add.rows.k1(cv: Bool, +floor: J.Val, +kind: String, +want: U32, +lonely: Bool, +n: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      (floor, False{})
    case False{}:
      +i = (n - 1 : U32)
      +host = J.nth(J.get(floor, "rooms"), i)
      nooks.add.rows.k2(Bool.or(Bool.not(nooks.wanted(want, gc.s(host, "kind"))), Bool.or(layout.Room.great(host), Bool.or(U32.is_ne(gc.u(host, "cols"), layout.COLS()), U32.is_ne(gc.u(host, "rows"), layout.ROWS())))), floor, kind, want, lonely, i, host)
def nooks.dir.at(+kind: String, +k: U32) -> U32:
  nooks.dir.at.k1(String.eq(kind, "bellows"), kind, k)

def nooks.dir.at.k1(cv: Bool, +kind: String, +k: U32) -> U32:
  match cv:
    case True{}:
      gc.nth_u([1, 3, 0], k)
    case False{}:
      gc.nth_u([1, 3, 0, 2], k)
def nooks.dir.len(+kind: String) -> U32:
  gc.pu(String.eq(kind, "bellows"), 3, 4)
# DIRS = [(0, -1), (1, 0), (0, 1), (-1, 0)] as i32 two's complement
def nooks.DIRS.dx(+d: U32) -> U32:
  gc.nth_u([0, 1, 0, RS.i_neg(1)], d)
def nooks.DIRS.dy(+d: U32) -> U32:
  gc.nth_u([RS.i_neg(1), 0, 1, 0], d)
def nooks.taken(+rooms: List<&2, J.Val>, +cx: U32, +cy: U32) -> Bool:
  nooks.taken.k1(rooms, rooms, cx, cy)

def nooks.taken.k1(sv0: List<&2, J.Val>, +rooms: List<&2, J.Val>, +cx: U32, +cy: U32) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+h, +t}:
      Bool.or(Bool.and(U32.is_eq(gc.nu(J.get(h, "cell"), 0), cx), U32.is_eq(gc.nu(J.get(h, "cell"), 1), cy)), nooks.taken(t, cx, cy))
def nooks.touching(+rooms: List<&2, J.Val>, +cx: U32, +cy: U32, +d: U32) -> U32:
  nooks.touching.k1(U32.is_ge(d, 4), rooms, cx, cy, d)

def nooks.touching.k1(cv: Bool, +rooms: List<&2, J.Val>, +cx: U32, +cy: U32, +d: U32) -> U32:
  match cv:
    case True{}:
      0
    case False{}:
      (gc.pu(nooks.taken(rooms, RS.i_add(cx, nooks.DIRS.dx(d)), RS.i_add(cy, nooks.DIRS.dy(d))), 1, 0) + nooks.touching(rooms, cx, cy, (d + 1 : U32)) : U32)
def nooks.add.dirs(+floor: J.Val, +kind: String, +lonely: Bool, +i: U32, +host: J.Val, +k: U32) -> J.Val & Bool:
  nooks.add.dirs.k1(U32.is_ge(k, nooks.dir.len(kind)), floor, kind, lonely, i, host, k)

def nooks.add.dirs.k4(cv: Bool, +floor: J.Val, +kind: String, +lonely: Bool, +i: U32, +host: J.Val, +k: U32, +dir: U32, +cx: U32, +cy: U32, +opened: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      +f2 = J.set(floor, "rooms", J.set_nth(J.get(floor, "rooms"), i, opened))
      (J.set(f2, "rooms", J.push(J.get(f2, "rooms"), nooks.room(kind, cx, cy, U32.mod((dir + 2 : U32), 4)))), True{})
    case False{}:
      nooks.add.dirs(floor, kind, lonely, i, host, (k + 1 : U32))

def nooks.add.dirs.k3(cv: Bool, +floor: J.Val, +kind: String, +lonely: Bool, +i: U32, +host: J.Val, +k: U32, +dir: U32, +cx: U32, +cy: U32, +rooms: List<&2, J.Val>) -> J.Val & Bool:
  match cv:
    case True{}:
      nooks.add.dirs(floor, kind, lonely, i, host, (k + 1 : U32))
    case False{}:
      +opened = layout.Room.open_door(host, dir)
      nooks.add.dirs.k4(layout.connected(opened), floor, kind, lonely, i, host, k, dir, cx, cy, opened)

def nooks.add.dirs.k2(cv: Bool, +floor: J.Val, +kind: String, +lonely: Bool, +i: U32, +host: J.Val, +k: U32, +dir: U32, +cx: U32, +cy: U32, +rooms: List<&2, J.Val>, +off: Bool) -> J.Val & Bool:
  match cv:
    case True{}:
      nooks.add.dirs(floor, kind, lonely, i, host, (k + 1 : U32))
    case False{}:
      nooks.add.dirs.k3(Bool.and(lonely, U32.is_gt(nooks.touching(rooms, cx, cy, 0), 1)), floor, kind, lonely, i, host, k, dir, cx, cy, rooms)

def nooks.add.dirs.k1(cv: Bool, +floor: J.Val, +kind: String, +lonely: Bool, +i: U32, +host: J.Val, +k: U32) -> J.Val & Bool:
  match cv:
    case True{}:
      (floor, False{})
    case False{}:
      +dir = nooks.dir.at(kind, k)
      +cx = RS.i_add(gc.nu(J.get(host, "cell"), 0), nooks.DIRS.dx(dir))
      +cy = RS.i_add(gc.nu(J.get(host, "cell"), 1), nooks.DIRS.dy(dir))
      +rooms = J.items(J.get(floor, "rooms"))
      +off = Bool.or(nooks.taken(rooms, cx, cy), Bool.or(RS.i_lt(cx, RS.i_neg(16)), Bool.or(RS.i_gt(cx, 16), Bool.or(RS.i_lt(cy, RS.i_neg(16)), RS.i_gt(cy, 16)))))
      nooks.add.dirs.k2(off, floor, kind, lonely, i, host, k, dir, cx, cy, rooms, off)
# reading::mimics(floor): which lecterns bite (a mask of three).
def nooks.reading.shape(+rooms: List<&2, J.Val>, +h: W.W) -> W.W:
  nooks.reading.shape.k1(rooms, rooms, h)

def nooks.reading.shape.k1(sv0: List<&2, J.Val>, +rooms: List<&2, J.Val>, +h: W.W) -> W.W:
  match sv0:
    case Nil{}:
      h
    case Con{+r, +t}:
      +cell = J.get(r, "cell")
      +v = RS.i_add(RS.i_mul(gc.nu(cell, 0), 23), gc.nu(cell, 1))
      nooks.reading.shape(t, W.add(W.mul_u32(h, 41), nooks.sext(v)))
# an i32 sign-extended into a u64
def nooks.sext(+v: U32) -> W.W:
  nooks.sext.k1(U32.is_ge(v, 2147483648), v)

def nooks.sext.k1(cv: Bool, +v: U32) -> W.W:
  match cv:
    case True{}:
      W.W{4294967295, v}
    case False{}:
      W.of_u32(v)
def nooks.reading.mimics(+dungeon: J.Val) -> U32:
  +shape = nooks.reading.shape(J.items(J.get(dungeon, "rooms")), W.xor(W.of_u32(gc.u(dungeon, "depth")), W.of_u32(45068)))
  nooks.reading.mask(shape, 0, 0)
def nooks.reading.mask(+shape: W.W, +k: U32, +mask: U32) -> U32:
  nooks.reading.mask.k1(U32.is_ge(RS.u_count_ones(mask), 3), shape, k, mask)

def nooks.reading.mask.k1(cv: Bool, +shape: W.W, +k: U32, +mask: U32) -> U32:
  match cv:
    case True{}:
      mask
    case False{}:
      nooks.reading.mask(shape, (k + 1 : U32), U32.or(mask, U32.shln(1, U32.to_nat(W.rem_u32(rules.mix(W.xor(shape, W.of_u32(k))), 8)))))
# Run::ready_nook()
def nooks.Run.ready_nook(+run: J.Val) -> J.Val:
  +at = nooks.first_nook(J.items(J.get(J.get(run, "dungeon"), "rooms")), 0)
  nooks.Run.ready_nook.k1(U32.is_eq(at, 4294967295), run, at)

def nooks.Run.ready_nook.k1(cv: Bool, +run: J.Val, +at: U32) -> J.Val:
  match cv:
    case True{}:
      J.set(run, "nook", J.JNull{})
    case False{}:
      +kind = gc.s(J.nth(J.get(J.get(run, "dungeon"), "rooms"), at), "kind")
      +n0 = gc.su(gc.su(J.obj(), "room", at), "pot", 12)
      J.set(run, "nook", nooks.Nook.new(n0, gc.pu(String.eq(kind, "reading"), nooks.reading.mimics(J.get(run, "dungeon")), 0)))
def nooks.first_nook(+rooms: List<&2, J.Val>, +i: U32) -> U32:
  nooks.first_nook.k1(rooms, rooms, i)

def nooks.first_nook.k2(cv: Bool, +i: U32, +h: J.Val, +t: List<&2, J.Val>) -> U32:
  match cv:
    case True{}:
      i
    case False{}:
      nooks.first_nook(t, (i + 1 : U32))

def nooks.first_nook.k1(sv0: List<&2, J.Val>, +rooms: List<&2, J.Val>, +i: U32) -> U32:
  match sv0:
    case Nil{}:
      4294967295
    case Con{+h, +t}:
      nooks.first_nook.k2(nooks.RoomKind.nook(gc.s(h, "kind")), i, h, t)
# Nook { room, pot: SCOOPS, mimics, ..Default::default() }
def nooks.Nook.new(+n: J.Val, +mimics: U32) -> J.Val:
  +a = gc.zeros(n, ["t", "held", "raised", "cook", "beat", "caught", "opened", "heat", "last", "fallen", "next", "stalled", "round", "shown", "pos"])
  +b = gc.falses(gc.su(a, "mimics", mimics), ["done", "running"])
  +c = J.set(J.set(J.set(b, "score", J.obj()), "jars", J.obj()), "brews", J.obj())
  gc.snull(c, "lit")
# Run::nook_players(): the knights who can act.
def nooks.Run.nook_players(+run: J.Val) -> List<&2, U32>:
  nooks.players.go(J.get(run, "players"), gc.ids(J.get(run, "players")))
def nooks.players.go(+hs: J.Val, +ids: List<&2, U32>) -> List<&2, U32>:
  nooks.players.go.k1(ids, hs, ids)

def nooks.players.go.k1(sv0: List<&2, U32>, +hs: J.Val, +ids: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      +h = gc.seat(hs, id)
      gc.ifx_us(Bool.and(U32.is_gt(gc.u(h, "hp"), 0), Bool.and(Bool.not(gc.b(h, "stone")), U32.is_zero(gc.u(h, "privy")))), id, nooks.players.go(hs, t))
# Run::nook_near(id, at, reach)
def nooks.Run.nook_near(+run: J.Val, +id: U32, +x: F32, +y: F32, +reach: F32) -> Bool:
  +h = gc.seat(J.get(run, "players"), id)
  Bool.and(Bool.not(J.is_null(h)), F32.is_lt(RS.f_hypot((gc.f(h, "x") - (x * layout.TILE_UNITS() : F32) : F32), (gc.f(h, "y") - (y * layout.TILE_UNITS() : F32) : F32)), reach))
# *nook.score.entry(id).or_default() += 1 (and the same for any counter map)
def nooks.bump(+nook: J.Val, +field: String, +id: U32) -> J.Val:
  +m = J.get(nook, field)
  J.set(nook, field, gc.put_seat(m, id, J.JU{(J.u32(gc.seat(m, id)) + 1 : U32)}))
# has(bits, id): bits & 1 << (id & 7) != 0
def nooks.has(+bits: U32, +id: U32) -> Bool:
  gc.has_bit(bits, U32.and(id, 7))
# Run::nook_raise(nook, kind, at)
def nooks.Run.nook_raise(+run: J.Val, +nook: J.Val, +kind: String, +x: F32, +y: F32) -> GcRN:
  nooks.Run.nook_raise.k1(U32.is_ge(gc.u(nook, "raised"), nooks.RAISE_CAP()), run, nook, kind, x, y)

def nooks.Run.nook_raise.k1(cv: Bool, +run: J.Val, +nook: J.Val, +kind: String, +x: F32, +y: F32) -> GcRN:
  match cv:
    case True{}:
      GcRN{run, nook}
    case False{}:
      GcRN{nooks.spawn(run, kind, (x * layout.TILE_UNITS() : F32), (y * layout.TILE_UNITS() : F32)), gc.su(nook, "raised", (gc.u(nook, "raised") + 1 : U32))}
def nooks.spawn(+run: J.Val, +kind: String, +x: F32, +y: F32) -> J.Val:
  +r = rules.Run.spawn_at(run, kind, x, y)
  nooks.spawn.k1(r)

def nooks.spawn.k1(pr: J.Val & Maybe<&2, U32>) -> J.Val:
  (+run2, +id) = pr
  run2
# Run::nook_crown(nook) -> Option<u32> (0 for none): the best scorer wears the laurel when the party is more than one.
def nooks.Run.nook_crown(+run: J.Val, +nook: J.Val) -> J.Val & U32:
  +best = nooks.best(J.int_fields(J.get(nook, "score")), 0, 0)
  nooks.Run.nook_crown.k1(U32.is_zero(best), run, best)

def nooks.Run.nook_crown.k2(cv: Bool, +run: J.Val, +best: U32) -> J.Val & U32:
  match cv:
    case True{}:
      (J.set(run, "players", nooks.laurels(J.get(run, "players"), gc.ids(J.get(run, "players")), best)), best)
    case False{}:
      (run, best)

def nooks.Run.nook_crown.k1(cv: Bool, +run: J.Val, +best: U32) -> J.Val & U32:
  match cv:
    case True{}:
      (run, 0)
    case False{}:
      nooks.Run.nook_crown.k2(U32.is_gt(rules.Run.party_len(run), 1), run, best)
# max_by_key(|(id, n)| (n, Reverse(id))): the highest score, the lowest id among equals.
def nooks.best(+xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +id: U32, +n: U32) -> U32:
  nooks.best.k1(xs, xs, id, n)

def nooks.best.k2(cv: Bool, +id: U32, +n: U32, +k: String, +v: J.Val, +t: List<&2, Sigma<&2, &2, String, _ => J.Val>>) -> U32:
  match cv:
    case True{}:
      nooks.best(t, gc.id(k), J.u32(v))
    case False{}:
      nooks.best(t, id, n)

def nooks.best.k1(sv0: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +xs: List<&2, Sigma<&2, &2, String, _ => J.Val>>, +id: U32, +n: U32) -> U32:
  match sv0:
    case Nil{}:
      id
    case Con{(+k, +v), +t}:
      nooks.best.k2(Bool.or(U32.is_zero(id), U32.is_gt(J.u32(v), n)), id, n, k, v, t)
def nooks.laurels(+players: J.Val, +ids: List<&2, U32>, +best: U32) -> J.Val:
  nooks.laurels.k1(ids, players, ids, best)

def nooks.laurels.k1(sv0: List<&2, U32>, +players: J.Val, +ids: List<&2, U32>, +best: U32) -> J.Val:
  match sv0:
    case Nil{}:
      players
    case Con{+id, +t}:
      nooks.laurels(gc.put_seat(players, id, gc.sb(gc.seat(players, id), "laurel", U32.is_eq(id, best))), t, best)
def nooks.upper_name(+run: J.Val, +id: U32) -> String:
  nooks.upper_name.k1(U32.is_zero(id), run, id)

def nooks.upper_name.k1(cv: Bool, +run: J.Val, +id: U32) -> String:
  match cv:
    case True{}:
      ""
    case False{}:
      String.to_upper(gc.s(gc.seat(J.get(run, "players"), id), "name"))
# hero.carried.add(Gold, n) for knight `id`; hero.hurt(n)
def nooks.gold(+run: J.Val, +id: U32, +n: U32) -> J.Val:
  +h = gc.seat(J.get(run, "players"), id)
  nooks.gold.k1(J.is_null(h), run, id, n, h)

def nooks.gold.k1(cv: Bool, +run: J.Val, +id: U32, +n: U32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      J.set(run, "players", gc.put_seat(J.get(run, "players"), id, J.set(h, "carried", realm.Spoils.add(J.get(h, "carried"), "gold", n))))
def nooks.hurt(+run: J.Val, +id: U32, +n: U32) -> J.Val:
  +h = gc.seat(J.get(run, "players"), id)
  nooks.hurt.k1(J.is_null(h), run, id, n, h)

def nooks.hurt.k1(cv: Bool, +run: J.Val, +id: U32, +n: U32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      J.set(run, "players", gc.put_seat(J.get(run, "players"), id, hero.Hero.hurt(h, n)))
# Run::tick_nook(inputs)
def nooks.Run.tick_nook(+run: J.Val, +inputs: J.Val) -> J.Val:
  +nook = J.get(run, "nook")
  nooks.Run.tick_nook.k1(J.is_null(nook), run, inputs, nook)

def nooks.Run.tick_nook.k2(cv: Bool, +run: J.Val, +inputs: J.Val, +pressed: U32, +nook1: J.Val, +run1: J.Val) -> J.Val:
  match cv:
    case True{}:
      nooks.tick.kind(run1, inputs, gc.su(nook1, "t", gc.sadd(gc.u(nook1, "t"), 1)), pressed, gc.s(J.nth(J.get(J.get(run1, "dungeon"), "rooms"), gc.u(nook1, "room")), "kind"))
    case False{}:
      J.set(run1, "nook", nook1)

def nooks.Run.tick_nook.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +nook: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +held = nooks.held(run, inputs, gc.ids(J.get(run, "players")), 0)
      +pressed = U32.and(held, U32.not(gc.u(nook, "held")))
      +nook1 = gc.su(nook, "held", held)
      +run1 = J.set(run, "nook", J.JNull{})
      nooks.Run.tick_nook.k2(Bool.and(U32.is_eq(gc.u(run, "at"), gc.u(nook1, "room")), Bool.and(Bool.not(gc.b(nook1, "done")), U32.is_lt(gc.u(nook1, "room"), gc.len(J.items(J.get(J.get(run1, "dungeon"), "rooms")))))), run, inputs, pressed, nook1, run1)
# the bits of knights holding E
def nooks.held(+run: J.Val, +inputs: J.Val, +ids: List<&2, U32>, +bits: U32) -> U32:
  nooks.held.k1(ids, run, inputs, ids, bits)

def nooks.held.k1(sv0: List<&2, U32>, +run: J.Val, +inputs: J.Val, +ids: List<&2, U32>, +bits: U32) -> U32:
  match sv0:
    case Nil{}:
      bits
    case Con{+id, +t}:
      nooks.held(run, inputs, t, gc.pu(gc.pressed_interact(inputs, id), U32.or(bits, gc.bit(U32.and(id, 7))), bits))
def nooks.tick.kind(+run: J.Val, +inputs: J.Val, +nook: J.Val, +pressed: U32, +kind: String) -> J.Val:
  +r = nooks.tick.dispatch(run, inputs, nook, pressed, kind)
  nooks.tick.kind.k1(r, r)

def nooks.tick.kind.k1(sv0: GcRN, +r: GcRN) -> J.Val:
  match sv0:
    case GcRN{+run2, +nook2}:
      J.set(run2, "nook", nook2)
def nooks.tick.dispatch(+run: J.Val, +inputs: J.Val, +nook: J.Val, +pressed: U32, +kind: String) -> GcRN:
  nooks.tick.dispatch.k1(String.eq(kind, "kitchen"), run, inputs, nook, pressed, kind)

def nooks.tick.dispatch.k6(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +kind: String) -> GcRN:
  match cv:
    case True{}:
      nooks.Run.tick_loft(run, nook, pressed)
    case False{}:
      GcRN{run, nook}

def nooks.tick.dispatch.k5(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +kind: String) -> GcRN:
  match cv:
    case True{}:
      nooks.Run.tick_still(run, nook, pressed)
    case False{}:
      nooks.tick.dispatch.k6(String.eq(kind, "loft"), run, nook, pressed, kind)

def nooks.tick.dispatch.k4(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +kind: String) -> GcRN:
  match cv:
    case True{}:
      nooks.Run.tick_ossuary(run, nook, pressed)
    case False{}:
      nooks.tick.dispatch.k5(String.eq(kind, "still"), run, nook, pressed, kind)

def nooks.tick.dispatch.k3(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +kind: String) -> GcRN:
  match cv:
    case True{}:
      nooks.Run.tick_bellows(run, nook, pressed)
    case False{}:
      nooks.tick.dispatch.k4(String.eq(kind, "ossuary"), run, nook, pressed, kind)

def nooks.tick.dispatch.k2(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +kind: String) -> GcRN:
  match cv:
    case True{}:
      nooks.Run.tick_reading(run, nook, pressed)
    case False{}:
      nooks.tick.dispatch.k3(String.eq(kind, "bellows"), run, nook, pressed, kind)

def nooks.tick.dispatch.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +nook: J.Val, +pressed: U32, +kind: String) -> GcRN:
  match cv:
    case True{}:
      nooks.Run.tick_kitchen(run, nook, inputs, pressed)
    case False{}:
      nooks.tick.dispatch.k2(String.eq(kind, "reading"), run, nook, pressed, kind)
# --- Grubb's Kitchen ---------------------------------------------------------

def nooks.BEATS(+i: U32) -> U32:
  gc.nth_u([75, 50, 95, 40, 60, 85], U32.mod(i, 6))
def nooks.beat_len(+beat: U32) -> U32:
  (nooks.BEATS(beat) + 15 + 40 : U32)
# cook(nook): 0 Stirring, 1 Turning, 2 Looking
def nooks.cook(+nook: J.Val) -> U32:
  +stir = nooks.BEATS(gc.u(nook, "beat"))
  nooks.cook.k1(U32.is_lt(gc.u(nook, "cook"), stir), nook, stir)

def nooks.cook.k1(cv: Bool, +nook: J.Val, +stir: U32) -> U32:
  match cv:
    case True{}:
      0
    case False{}:
      gc.pu(U32.is_lt(gc.u(nook, "cook"), (stir + 15 : U32)), 1, 2)
def nooks.Run.tick_kitchen(+run: J.Val, +nook: J.Val, +inputs: J.Val, +pressed: U32) -> GcRN:
  nooks.Run.tick_kitchen.k1(U32.is_zero(gc.u(nook, "pot")), run, nook, inputs, pressed)

def nooks.Run.tick_kitchen.k2(sv0: GcRN, +r2: GcRN) -> GcRN:
  match sv0:
    case GcRN{+run3, +nook3}:
      nooks.kitchen.end(run3, nook3)

def nooks.Run.tick_kitchen.k1(cv: Bool, +run: J.Val, +nook: J.Val, +inputs: J.Val, +pressed: U32) -> GcRN:
  match cv:
    case True{}:
      GcRN{run, nook}
    case False{}:
      +n1 = gc.su(nook, "cook", (gc.u(nook, "cook") + 1 : U32))
      +n2 = gc.ifj(U32.is_ge(gc.u(n1, "cook"), nooks.beat_len(gc.u(n1, "beat"))), _ => gc.su(gc.su(gc.su(n1, "cook", 0), "beat", U32.mod((gc.u(n1, "beat") + 1 : U32), 6)), "caught", 0), _ => n1)
      +state = nooks.cook(n2)
      +r1 = gc.ifj(Bool.and(U32.is_eq(state, 2), U32.is_eq(gc.u(n2, "cook"), (nooks.BEATS(gc.u(n2, "beat")) + 15 : U32))), _ => gc.sound(run, "boss_roar"), _ => run)
      +take = W.rem_u32(gc.tick(run), 2)
      +r2 = nooks.kitchen.each(r1, n2, inputs, pressed, state, take, nooks.Run.nook_players(r1))
      nooks.Run.tick_kitchen.k2(r2, r2)
def nooks.kitchen.end(+run: J.Val, +nook: J.Val) -> GcRN:
  nooks.kitchen.end.k1(U32.is_zero(gc.u(nook, "pot")), run, nook)

def nooks.kitchen.end.k2(pr: J.Val & U32, +nook: J.Val) -> GcRN:
  (+run1, +best) = pr
  +name = nooks.upper_name(run1, best)
  GcRN{gc.found(gc.sound(run1, "chest_open"), 0, "THE POT'S EMPTY! " ++ name ++ " ATE MOST."), gc.sb(nook, "done", True{})}

def nooks.kitchen.end.k1(cv: Bool, +run: J.Val, +nook: J.Val) -> GcRN:
  match cv:
    case True{}:
      +c = nooks.Run.nook_crown(run, gc.sb(nook, "done", True{}))
      nooks.kitchen.end.k2(c, nook)
    case False{}:
      GcRN{run, nook}
def nooks.kitchen.each(+run: J.Val, +nook: J.Val, +inputs: J.Val, +pressed: U32, +state: U32, +take: U32, +ids: List<&2, U32>) -> GcRN:
  nooks.kitchen.each.k1(ids, run, nook, inputs, pressed, state, take, ids)

def nooks.kitchen.each.k4(sv0: GcRN, +inputs: J.Val, +pressed: U32, +state: U32, +take: U32, +t: List<&2, U32>, +r: GcRN) -> GcRN:
  match sv0:
    case GcRN{+run2, +nook2}:
      nooks.kitchen.each(run2, nook2, inputs, pressed, state, take, t)

def nooks.kitchen.each.k3(cv: Bool, +run: J.Val, +nook: J.Val, +inputs: J.Val, +pressed: U32, +state: U32, +take: U32, +id: U32, +t: List<&2, U32>, +fidget: Bool) -> GcRN:
  match cv:
    case True{}:
      +r = nooks.kitchen.caught(run, nook, id, take)
      nooks.kitchen.each.k4(r, inputs, pressed, state, take, t, r)
    case False{}:
      nooks.kitchen.each(run, nook, inputs, pressed, state, take, t)

def nooks.kitchen.each.k5(cv: Bool, +run: J.Val, +nook: J.Val, +inputs: J.Val, +pressed: U32, +state: U32, +take: U32, +id: U32, +t: List<&2, U32>) -> GcRN:
  match cv:
    case True{}:
      +n1 = nooks.bump(gc.su(nook, "pot", (gc.u(nook, "pot") - 1 : U32)), "score", id)
      +r1 = gc.found(gc.sound(nooks.gold(run, id, 3), "gold"), id, "SLURP! A COIN!")
      nooks.kitchen.each(r1, n1, inputs, pressed, state, take, t)
    case False{}:
      nooks.kitchen.each(run, nook, inputs, pressed, state, take, t)

def nooks.kitchen.each.k2(cv: Bool, +run: J.Val, +nook: J.Val, +inputs: J.Val, +pressed: U32, +state: U32, +take: U32, +id: U32, +t: List<&2, U32>, +fidget: Bool) -> GcRN:
  match cv:
    case True{}:
      nooks.kitchen.each.k3(Bool.and(fidget, Bool.not(nooks.has(gc.u(nook, "caught"), id))), run, nook, inputs, pressed, state, take, id, t, fidget)
    case False{}:
      nooks.kitchen.each.k5(Bool.and(nooks.has(pressed, id), Bool.and(nooks.Run.nook_near(run, id, 12.0, 4.0, 4.4), U32.is_gt(gc.u(nook, "pot"), 0))), run, nook, inputs, pressed, state, take, id, t)

def nooks.kitchen.each.k1(sv0: List<&2, U32>, +run: J.Val, +nook: J.Val, +inputs: J.Val, +pressed: U32, +state: U32, +take: U32, +ids: List<&2, U32>) -> GcRN:
  match sv0:
    case Nil{}:
      GcRN{run, nook}
    case Con{+id, +t}:
      +input = gc.input(inputs, id)
      +fidget = Bool.or(U32.is_ne(gc.u(input, "move_x"), 0), Bool.or(U32.is_ne(gc.u(input, "move_y"), 0), Bool.or(gc.b(input, "fire"), Bool.or(gc.b(input, "dash"), nooks.has(pressed, id)))))
      nooks.kitchen.each.k2(U32.is_eq(state, 2), run, nook, inputs, pressed, state, take, id, t, fidget)
# The cook looks and a knight fidgets: the ladle, a shove away from the pot, a shout for cousins.
def nooks.kitchen.caught(+run: J.Val, +nook: J.Val, +id: U32, +take: U32) -> GcRN:
  +n1 = gc.su(nook, "caught", U32.or(gc.u(nook, "caught"), gc.bit(U32.and(id, 7))))
  +r1 = nooks.kitchen.ladle(nooks.hurt(run, id, 10), nook, id)
  +r2 = gc.found(gc.sound(gc.sound(r1, "clang"), chatter.clip(id, "oof", take)), id, "CAUGHT! COUSINS!")
  nooks.Run.nook_raise(r2, n1, "goblin", 12.0, 6.5)
# The shove: away from the pot's middle by 3.0, only onto floor.
def nooks.kitchen.ladle(+run: J.Val, +nook: J.Val, +id: U32) -> J.Val:
  +h = gc.seat(J.get(run, "players"), id)
  +hx = gc.f(h, "x")
  +hy = gc.f(h, "y")
  +dx = (hx - (12.0 * layout.TILE_UNITS() : F32) : F32)
  +dy = (hy - (4.0 * layout.TILE_UNITS() : F32) : F32)
  +len = RS.f_max(RS.f_hypot(dx, dy), 0.01)
  +tx = (hx + ((dx / len : F32) * 3.0 : F32) : F32)
  +ty = (hy + ((dy / len : F32) * 3.0 : F32) : F32)
  +room = J.nth(J.get(J.get(run, "dungeon"), "rooms"), gc.u(nook, "room"))
  nooks.kitchen.ladle.k1(nooks.is_floor(layout.Room.tile(room, RS.f_as_i32((tx / layout.TILE_UNITS() : F32)), RS.f_as_i32((ty / layout.TILE_UNITS() : F32)))), run, id, h, tx, ty, room)

def nooks.kitchen.ladle.k1(cv: Bool, +run: J.Val, +id: U32, +h: J.Val, +tx: F32, +ty: F32, +room: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.set(run, "players", gc.put_seat(J.get(run, "players"), id, gc.sf(gc.sf(h, "x", tx), "y", ty)))
    case False{}:
      run
def nooks.is_floor(+t: LayTile) -> Bool:
  nooks.is_floor.k1(t, t)

def nooks.is_floor.k1(sv0: LayTile, +t: LayTile) -> Bool:
  match sv0:
    case TileFloor{}:
      True{}
    case _:
      False{}
# --- The Quiet Room ----------------------------------------------------------

def nooks.TITLES(+i: U32) -> String:
  gc.nth_s(["SOUP FOR KNIGHTS, VOL. II", "HOW TO PET A DRAGON (BRIEFLY)", "1001 GOOSE GRIEVANCES", "ON PRIVIES, AND WHY", "A HISTORY OF THE SOCK", "BOOKS ARE NOT TEETH", "THE WEEK MERLIN WAS A TOAD", "MAUD'S TAB, ABRIDGED"], i)
def nooks.Run.tick_reading(+run: J.Val, +nook: J.Val, +pressed: U32) -> GcRN:
  +r = nooks.reading.each(run, nook, pressed, nooks.Run.nook_players(run))
  nooks.Run.tick_reading.k1(r, r)

def nooks.Run.tick_reading.k3(pr: J.Val & U32, +nook2: J.Val) -> GcRN:
  (+run3, +best) = pr
  GcRN{gc.found(gc.sound(run3, "chest_open"), 0, "ALL READ! " ++ nooks.upper_name(run3, best) ++ " READ MOST."), gc.sb(nook2, "done", True{})}

def nooks.Run.tick_reading.k2(cv: Bool, +run2: J.Val, +nook2: J.Val, +real: U32) -> GcRN:
  match cv:
    case True{}:
      +c = nooks.Run.nook_crown(run2, gc.sb(nook2, "done", True{}))
      nooks.Run.tick_reading.k3(c, nook2)
    case False{}:
      GcRN{run2, nook2}

def nooks.Run.tick_reading.k1(sv0: GcRN, +r: GcRN) -> GcRN:
  match sv0:
    case GcRN{+run2, +nook2}:
      +real = U32.and(U32.not(gc.u(nook2, "mimics")), 255)
      nooks.Run.tick_reading.k2(U32.is_eq(U32.and(gc.u(nook2, "opened"), real), real), run2, nook2, real)
def nooks.reading.each(+run: J.Val, +nook: J.Val, +pressed: U32, +ids: List<&2, U32>) -> GcRN:
  nooks.reading.each.k1(ids, run, nook, pressed, ids)

def nooks.reading.each.k5(sv0: GcRN, +pressed: U32, +t: List<&2, U32>, +r2: GcRN) -> GcRN:
  match sv0:
    case GcRN{+run2, +nook2}:
      nooks.reading.each(run2, nook2, pressed, t)

def nooks.reading.each.k4(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +id: U32, +t: List<&2, U32>, +i: U32, +n1: J.Val) -> GcRN:
  match cv:
    case True{}:
      +r1 = gc.found(gc.sound(nooks.hurt(run, id, 10), "mimic"), id, "IT BITES!")
      +r2 = nooks.Run.nook_raise(r1, n1, "mimic", (RS.u_as_f32(nooks.LECTERN.c(i)) + 0.5 : F32), (RS.u_as_f32(nooks.LECTERN.r(i)) + 2.2 : F32))
      nooks.reading.each.k5(r2, pressed, t, r2)
    case False{}:
      +r1 = gc.found(gc.sound(nooks.gold(run, id, 4), "card_pickup"), id, nooks.TITLES(i))
      nooks.reading.each(r1, nooks.bump(n1, "score", id), pressed, t)

def nooks.reading.each.k3(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +id: U32, +t: List<&2, U32>, +i: U32) -> GcRN:
  match cv:
    case True{}:
      nooks.reading.each(run, nook, pressed, t)
    case False{}:
      +n1 = gc.su(nook, "opened", U32.or(gc.u(nook, "opened"), gc.bit(i)))
      nooks.reading.each.k4(gc.has_bit(gc.u(nook, "mimics"), i), run, nook, pressed, id, t, i, n1)

def nooks.reading.each.k2(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +id: U32, +t: List<&2, U32>) -> GcRN:
  match cv:
    case True{}:
      +i = nooks.reading.find(run, nook, id, 0)
      nooks.reading.each.k3(U32.is_ge(i, 8), run, nook, pressed, id, t, i)
    case False{}:
      nooks.reading.each(run, nook, pressed, t)

def nooks.reading.each.k1(sv0: List<&2, U32>, +run: J.Val, +nook: J.Val, +pressed: U32, +ids: List<&2, U32>) -> GcRN:
  match sv0:
    case Nil{}:
      GcRN{run, nook}
    case Con{+id, +t}:
      nooks.reading.each.k2(nooks.has(pressed, id), run, nook, pressed, id, t)
# The first unopened lectern the knight stands at, or 8.
def nooks.reading.find(+run: J.Val, +nook: J.Val, +id: U32, +i: U32) -> U32:
  nooks.reading.find.k1(U32.is_ge(i, 8), run, nook, id, i)

def nooks.reading.find.k2(cv: Bool, +run: J.Val, +nook: J.Val, +id: U32, +i: U32) -> U32:
  match cv:
    case True{}:
      i
    case False{}:
      nooks.reading.find(run, nook, id, (i + 1 : U32))

def nooks.reading.find.k1(cv: Bool, +run: J.Val, +nook: J.Val, +id: U32, +i: U32) -> U32:
  match cv:
    case True{}:
      8
    case False{}:
      nooks.reading.find.k2(Bool.and(Bool.not(gc.has_bit(gc.u(nook, "opened"), i)), nooks.Run.nook_near(run, id, (RS.u_as_f32(nooks.LECTERN.c(i)) + 0.5 : F32), (RS.u_as_f32(nooks.LECTERN.r(i)) + 1.6 : F32), nooks.REACH())), run, nook, id, i)
# --- The Great Bellows -------------------------------------------------------

def nooks.HANDLE.x(+s: U32) -> F32:
  gc.nth_f([5.5, 18.5], s)
def nooks.Run.tick_bellows(+run: J.Val, +nook: J.Val, +pressed: U32) -> GcRN:
  +n1 = gc.ifj(U32.is_zero(U32.mod(gc.u(nook, "t"), 4)), _ => gc.su(nook, "heat", gc.ssub(gc.u(nook, "heat"), 1)), _ => nook)
  +before = gc.u(n1, "heat")
  +r = nooks.bellows.each(run, n1, pressed, nooks.Run.nook_players(run))
  nooks.Run.tick_bellows.k1(r, before, r)

def nooks.Run.tick_bellows.k1(sv0: GcRN, +before: U32, +r: GcRN) -> GcRN:
  match sv0:
    case GcRN{+run2, +nook2}:
      nooks.bellows.imps(run2, nook2, before)
def nooks.bellows.each(+run: J.Val, +nook: J.Val, +pressed: U32, +ids: List<&2, U32>) -> GcRN:
  nooks.bellows.each.k1(ids, run, nook, pressed, ids)

def nooks.bellows.each.k4(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +id: U32, +t: List<&2, U32>, +side: U32) -> GcRN:
  match cv:
    case True{}:
      nooks.bellows.each(gc.found(run, id, "OTHER SIDE!"), nook, pressed, t)
    case False{}:
      +n1 = gc.su(gc.su(nook, "last", (side + 1 : U32)), "heat", gc.umin((gc.u(nook, "heat") + 8 : U32), 100))
      nooks.bellows.each(gc.sound(run, "vent_fire"), nooks.bump(n1, "score", id), pressed, t)

def nooks.bellows.each.k3(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +id: U32, +t: List<&2, U32>, +side: U32) -> GcRN:
  match cv:
    case True{}:
      nooks.bellows.each(run, nook, pressed, t)
    case False{}:
      nooks.bellows.each.k4(U32.is_eq(gc.u(nook, "last"), (side + 1 : U32)), run, nook, pressed, id, t, side)

def nooks.bellows.each.k2(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +id: U32, +t: List<&2, U32>) -> GcRN:
  match cv:
    case True{}:
      +side = gc.pu(nooks.Run.nook_near(run, id, nooks.HANDLE.x(0), 5.0, nooks.REACH()), 0, gc.pu(nooks.Run.nook_near(run, id, nooks.HANDLE.x(1), 5.0, nooks.REACH()), 1, 2))
      nooks.bellows.each.k3(U32.is_ge(side, 2), run, nook, pressed, id, t, side)
    case False{}:
      nooks.bellows.each(run, nook, pressed, t)

def nooks.bellows.each.k1(sv0: List<&2, U32>, +run: J.Val, +nook: J.Val, +pressed: U32, +ids: List<&2, U32>) -> GcRN:
  match sv0:
    case Nil{}:
      GcRN{run, nook}
    case Con{+id, +t}:
      nooks.bellows.each.k2(nooks.has(pressed, id), run, nook, pressed, id, t)
def nooks.bellows.imps(+run: J.Val, +nook: J.Val, +before: U32) -> GcRN:
  nooks.bellows.imps.k1(Bool.and(U32.is_lt(before, 50), Bool.and(U32.is_ge(gc.u(nook, "heat"), 50), U32.is_zero(gc.u(nook, "raised")))), run, nook, before)

def nooks.bellows.imps.k3(sv0: GcRN, +r2: GcRN) -> GcRN:
  match sv0:
    case GcRN{+run3, +nook3}:
      nooks.bellows.roar(run3, nook3)

def nooks.bellows.imps.k2(sv0: GcRN, +r1: GcRN) -> GcRN:
  match sv0:
    case GcRN{+run2, +nook2}:
      +r2 = nooks.Run.nook_raise(run2, nook2, "imp", 16.0, 7.0)
      nooks.bellows.imps.k3(r2, r2)

def nooks.bellows.imps.k1(cv: Bool, +run: J.Val, +nook: J.Val, +before: U32) -> GcRN:
  match cv:
    case True{}:
      +r1 = nooks.Run.nook_raise(gc.found(run, 0, "THE HEAT WAKES IMPS!"), nook, "imp", 8.0, 7.0)
      nooks.bellows.imps.k2(r1, r1)
    case False{}:
      nooks.bellows.roar(run, nook)
def nooks.bellows.roar(+run: J.Val, +nook: J.Val) -> GcRN:
  nooks.bellows.roar.k1(U32.is_ge(gc.u(nook, "heat"), 100), run, nook)

def nooks.bellows.roar.k2(pr: J.Val & U32, +nook: J.Val) -> GcRN:
  (+run2, +tempered) = pr
  +run3 = J.set(run2, "shake", J.JU{gc.umax(gc.u(run2, "shake"), 4)})
  GcRN{gc.found(gc.sound(run3, "hell_gate_rise"), 0, gc.ps(U32.is_gt(tempered, 0), "THE FORGE ROARS! ARMS TEMPERED.", "THE FORGE ROARS!")), gc.sb(nook, "done", True{})}

def nooks.bellows.roar.k1(cv: Bool, +run: J.Val, +nook: J.Val) -> GcRN:
  match cv:
    case True{}:
      +r = nooks.temper(run, gc.ids(J.get(run, "players")), 0, nooks.Run.nook_players(run))
      nooks.bellows.roar.k2(r, nook)
    case False{}:
      GcRN{run, nook}
# for id in nook_players(): temper a knight with a plain arm.
def nooks.temper(+run: J.Val, +all: List<&2, U32>, +n: U32, +ids: List<&2, U32>) -> J.Val & U32:
  nooks.temper.k1(ids, run, all, n, ids)

def nooks.temper.k2(cv: Bool, +run: J.Val, +all: List<&2, U32>, +n: U32, +id: U32, +t: List<&2, U32>, +h: J.Val) -> J.Val & U32:
  match cv:
    case True{}:
      +h2 = gc.su(h, "temper", (gc.u(h, "temper") + 1 : U32))
      +r1 = gc.cue(J.set(run, "players", gc.put_seat(J.get(run, "players"), id, h2)), "temper:" ++ U32.show(gc.u(h2, "temper")))
      nooks.temper(r1, all, (n + 1 : U32), t)
    case False{}:
      nooks.temper(run, all, n, t)

def nooks.temper.k1(sv0: List<&2, U32>, +run: J.Val, +all: List<&2, U32>, +n: U32, +ids: List<&2, U32>) -> J.Val & U32:
  match sv0:
    case Nil{}:
      (run, n)
    case Con{+id, +t}:
      +h = gc.seat(J.get(run, "players"), id)
      nooks.temper.k2(Bool.and(Bool.not(String.eq(gc.s(h, "weapon"), "fists")), Bool.and(J.is_null(J.get(h, "forged")), U32.is_lt(gc.u(h, "temper"), feel.TEMPER_MAX()))), run, all, n, id, t, h)
# --- The Bone Dominoes -------------------------------------------------------

# PATH[i] in tiles: (col, row)
def nooks.PATH.c(+k: U32) -> U32:
  nooks.PATH.c.k1(U32.is_lt(k, 18), k)

def nooks.PATH.c.k2(cv: Bool, +k: U32) -> U32:
  match cv:
    case True{}:
      20
    case False{}:
      (20 - (k - 24 : U32) : U32)

def nooks.PATH.c.k1(cv: Bool, +k: U32) -> U32:
  match cv:
    case True{}:
      (3 + k : U32)
    case False{}:
      nooks.PATH.c.k2(U32.is_lt(k, 24), k)
def nooks.PATH.r(+k: U32) -> U32:
  nooks.PATH.r.k1(U32.is_lt(k, 18), k)

def nooks.PATH.r.k2(cv: Bool, +k: U32) -> U32:
  match cv:
    case True{}:
      (4 + (k - 18 : U32) : U32)
    case False{}:
      10

def nooks.PATH.r.k1(cv: Bool, +k: U32) -> U32:
  match cv:
    case True{}:
      3
    case False{}:
      nooks.PATH.r.k2(U32.is_lt(k, 24), k)
def nooks.at.x(+i: U32) -> F32:
  (RS.u_as_f32(nooks.PATH.c(i)) + 0.5 : F32)
def nooks.at.y(+i: U32) -> F32:
  (RS.u_as_f32(nooks.PATH.r(i)) + 0.5 : F32)
def nooks.is_gap(+i: U32) -> Bool:
  Bool.or(U32.is_eq(i, 12), Bool.or(U32.is_eq(i, 21), U32.is_eq(i, 33)))
# The first knight (by id) who pressed E and stands near the path's head.
def nooks.ossuary.starter(+run: J.Val, +pressed: U32, +ids: List<&2, U32>) -> U32:
  nooks.ossuary.starter.k1(ids, run, pressed, ids)

def nooks.ossuary.starter.k1(sv0: List<&2, U32>, +run: J.Val, +pressed: U32, +ids: List<&2, U32>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+id, +t}:
      gc.pu(Bool.and(nooks.has(pressed, id), nooks.Run.nook_near(run, id, nooks.at.x(0), nooks.at.y(0), nooks.REACH())), id, nooks.ossuary.starter(run, pressed, t))
# The first knight within 1.6 of tile `i`.
def nooks.ossuary.stander(+run: J.Val, +i: U32, +ids: List<&2, U32>) -> U32:
  nooks.ossuary.stander.k1(ids, run, i, ids)

def nooks.ossuary.stander.k2(cv: Bool, +run: J.Val, +i: U32, +id: U32, +t: List<&2, U32>) -> U32:
  match cv:
    case True{}:
      id
    case False{}:
      nooks.ossuary.stander(run, i, t)

def nooks.ossuary.stander.k1(sv0: List<&2, U32>, +run: J.Val, +i: U32, +ids: List<&2, U32>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+id, +t}:
      nooks.ossuary.stander.k2(nooks.Run.nook_near(run, id, nooks.at.x(i), nooks.at.y(i), 1.6), run, i, id, t)
def nooks.Run.tick_ossuary(+run: J.Val, +nook: J.Val, +pressed: U32) -> GcRN:
  nooks.Run.tick_ossuary.k1(U32.is_gt(gc.u(nook, "stalled"), 0), run, nook, pressed)

def nooks.Run.tick_ossuary.k3(cv: Bool, +run: J.Val, +nook: J.Val, +id: U32) -> GcRN:
  match cv:
    case True{}:
      GcRN{run, nook}
    case False{}:
      GcRN{gc.found(gc.sound(run, "bones_clatter"), id, "CLACK! FILL THE GAPS!"), gc.su(gc.su(gc.sb(nook, "running", True{}), "fallen", 0), "next", 4)}

def nooks.Run.tick_ossuary.k4(cv: Bool, +run: J.Val, +next: U32, +n1: J.Val) -> GcRN:
  match cv:
    case True{}:
      GcRN{run, n1}
    case False{}:
      nooks.ossuary.fall(run, gc.su(n1, "next", 4))

def nooks.Run.tick_ossuary.k2(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32) -> GcRN:
  match cv:
    case True{}:
      +id = nooks.ossuary.starter(run, pressed, nooks.Run.nook_players(run))
      nooks.Run.tick_ossuary.k3(U32.is_zero(id), run, nook, id)
    case False{}:
      +next = gc.ssub(gc.u(nook, "next"), 1)
      +n1 = gc.su(nook, "next", next)
      nooks.Run.tick_ossuary.k4(U32.is_gt(next, 0), run, next, n1)

def nooks.Run.tick_ossuary.k1(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32) -> GcRN:
  match cv:
    case True{}:
      +stalled = (gc.u(nook, "stalled") - 1 : U32)
      +n1 = gc.su(nook, "stalled", stalled)
      GcRN{run, gc.ifj(U32.is_zero(stalled), _ => gc.su(n1, "fallen", 0), _ => n1)}
    case False{}:
      nooks.Run.tick_ossuary.k2(Bool.not(gc.b(nook, "running")), run, nook, pressed)
def nooks.ossuary.fall(+run: J.Val, +nook: J.Val) -> GcRN:
  +i = gc.u(nook, "fallen")
  nooks.ossuary.fall.k1(nooks.is_gap(i), run, nook, i)

def nooks.ossuary.fall.k3(sv0: GcRN, +r2: GcRN) -> GcRN:
  match sv0:
    case GcRN{+run2, +nook2}:
      nooks.Run.nook_raise(run2, nook2, "skeleton", 12.0, 9.0)

def nooks.ossuary.fall.k2(cv: Bool, +run: J.Val, +nook: J.Val, +i: U32, +id: U32) -> GcRN:
  match cv:
    case True{}:
      +n1 = gc.su(gc.sb(nook, "running", False{}), "stalled", (2 * rules.HZ() : U32))
      +r1 = gc.found(gc.sound(run, "bones_clatter"), 0, "THE LINE STOPS. BONES RISE!")
      +r2 = nooks.Run.nook_raise(r1, n1, "skeleton", nooks.at.x(i), nooks.at.y(i))
      nooks.ossuary.fall.k3(r2, r2)
    case False{}:
      +r1 = gc.found(gc.sound(run, "knight_fall"), id, "TIMBER!")
      nooks.ossuary.advance(r1, nooks.bump(nook, "score", id))

def nooks.ossuary.fall.k1(cv: Bool, +run: J.Val, +nook: J.Val, +i: U32) -> GcRN:
  match cv:
    case True{}:
      +id = nooks.ossuary.stander(run, i, nooks.Run.nook_players(run))
      nooks.ossuary.fall.k2(U32.is_zero(id), run, nook, i, id)
    case False{}:
      nooks.ossuary.advance(gc.ifj(U32.is_eq(U32.mod(i, 3), 0), _ => gc.sound(run, "bones_clatter"), _ => run), nook)
def nooks.ossuary.advance(+run: J.Val, +nook: J.Val) -> GcRN:
  +n1 = gc.su(nook, "fallen", (gc.u(nook, "fallen") + 1 : U32))
  nooks.ossuary.advance.k1(U32.is_eq(gc.u(n1, "fallen"), 42), run, n1)

def nooks.ossuary.advance.k2(pr: J.Val & U32, +n1: J.Val) -> GcRN:
  (+r2, +best) = pr
  GcRN{gc.found(gc.sound(gc.sound(r2, "circle_toll"), "chest_open"), 0, "DONG! THE COFFER OPENS: 8 GOLD EACH."), gc.sb(gc.sb(n1, "running", False{}), "done", True{})}

def nooks.ossuary.advance.k1(cv: Bool, +run: J.Val, +n1: J.Val) -> GcRN:
  match cv:
    case True{}:
      +r1 = nooks.pay_all(run, 8, nooks.Run.nook_players(run))
      +c = nooks.Run.nook_crown(r1, gc.sb(gc.sb(n1, "running", False{}), "done", True{}))
      nooks.ossuary.advance.k2(c, n1)
    case False{}:
      GcRN{run, n1}
def nooks.pay_all(+run: J.Val, +n: U32, +ids: List<&2, U32>) -> J.Val:
  nooks.pay_all.k1(ids, run, n, ids)

def nooks.pay_all.k1(sv0: List<&2, U32>, +run: J.Val, +n: U32, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      nooks.pay_all(nooks.gold(run, id, n), n, t)
# --- Mother Mort's Still -----------------------------------------------------

def nooks.JAR.x(+j: U32) -> F32:
  gc.nth_f([7.5, 12.0, 16.5], j)
def nooks.JAR.y(+j: U32) -> F32:
  gc.nth_f([7.5, 8.5, 7.5], j)
def nooks.JAR.spoil(+j: U32) -> String:
  gc.nth_s(["bone", "wax", "ore"], j)
def nooks.JAR.word(+j: U32) -> String:
  gc.nth_s(["BONE", "WAX", "ORE"], j)
def nooks.Run.tick_still(+run: J.Val, +nook: J.Val, +pressed: U32) -> GcRN:
  nooks.still.each(run, nook, pressed, nooks.Run.nook_players(run))
def nooks.still.jar(+run: J.Val, +id: U32) -> U32:
  gc.pu(nooks.Run.nook_near(run, id, nooks.JAR.x(0), nooks.JAR.y(0), nooks.REACH()), 0, gc.pu(nooks.Run.nook_near(run, id, nooks.JAR.x(1), nooks.JAR.y(1), nooks.REACH()), 1, gc.pu(nooks.Run.nook_near(run, id, nooks.JAR.x(2), nooks.JAR.y(2), nooks.REACH()), 2, 3)))
def nooks.still.each(+run: J.Val, +nook: J.Val, +pressed: U32, +ids: List<&2, U32>) -> GcRN:
  nooks.still.each.k1(ids, run, nook, pressed, ids)

def nooks.still.each.k4(sv0: GcRN, +pressed: U32, +t: List<&2, U32>, +r: GcRN) -> GcRN:
  match sv0:
    case GcRN{+run2, +nook2}:
      nooks.still.each(run2, nook2, pressed, t)

def nooks.still.each.k3(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +id: U32, +t: List<&2, U32>, +j: U32) -> GcRN:
  match cv:
    case True{}:
      nooks.still.each(run, nook, pressed, t)
    case False{}:
      +r = nooks.still.brew(run, nook, id, j)
      nooks.still.each.k4(r, pressed, t, r)

def nooks.still.each.k2(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +id: U32, +t: List<&2, U32>) -> GcRN:
  match cv:
    case True{}:
      +j = nooks.still.jar(run, id)
      nooks.still.each.k3(U32.is_ge(j, 3), run, nook, pressed, id, t, j)
    case False{}:
      nooks.still.each(run, nook, pressed, t)

def nooks.still.each.k1(sv0: List<&2, U32>, +run: J.Val, +nook: J.Val, +pressed: U32, +ids: List<&2, U32>) -> GcRN:
  match sv0:
    case Nil{}:
      GcRN{run, nook}
    case Con{+id, +t}:
      nooks.still.each.k2(nooks.has(pressed, id), run, nook, pressed, id, t)
def nooks.still.brew(+run: J.Val, +nook: J.Val, +id: U32, +j: U32) -> GcRN:
  +h = gc.seat(J.get(run, "players"), id)
  nooks.still.brew.k1(U32.is_ge(J.u32(gc.seat(J.get(nook, "brews"), id)), 2), run, nook, id, j, h)

def nooks.still.brew.k4(cv: Bool, +nook: J.Val, +id: U32, +j: U32, +r1: J.Val, +first: U32) -> GcRN:
  match cv:
    case True{}:
      GcRN{gc.found(r1, id, nooks.JAR.word(j) ++ " IN. ONE MORE."), J.set(nook, "jars", gc.put_seat(J.get(nook, "jars"), id, J.JU{(j + 1 : U32)}))}
    case False{}:
      +n1 = J.set(nook, "jars", J.del(J.get(nook, "jars"), gc.key(id)))
      +n2 = nooks.bump(nooks.bump(n1, "brews", id), "score", id)
      nooks.still.mix(r1, n2, id, gc.umin((first - 1 : U32), j), gc.umax((first - 1 : U32), j))

def nooks.still.brew.k3(cv: Bool, +run: J.Val, +nook: J.Val, +id: U32, +j: U32, +h: J.Val) -> GcRN:
  match cv:
    case True{}:
      GcRN{gc.found(run, id, "NO " ++ nooks.JAR.word(j) ++ " ON YOU."), nook}
    case False{}:
      +h1 = J.set(h, "carried", realm.Spoils.take(J.get(h, "carried"), gc.su(J.obj(), nooks.JAR.spoil(j), 1)))
      +r1 = gc.sound(J.set(run, "players", gc.put_seat(J.get(run, "players"), id, h1)), "holy_water")
      +first = J.u32(gc.seat(J.get(nook, "jars"), id))
      nooks.still.brew.k4(U32.is_zero(first), nook, id, j, r1, first)

def nooks.still.brew.k2(cv: Bool, +run: J.Val, +nook: J.Val, +id: U32, +j: U32, +h: J.Val) -> GcRN:
  match cv:
    case True{}:
      GcRN{run, nook}
    case False{}:
      nooks.still.brew.k3(U32.is_zero(realm.Spoils.get(J.get(h, "carried"), nooks.JAR.spoil(j))), run, nook, id, j, h)

def nooks.still.brew.k1(cv: Bool, +run: J.Val, +nook: J.Val, +id: U32, +j: U32, +h: J.Val) -> GcRN:
  match cv:
    case True{}:
      GcRN{gc.found(run, id, "SHE SAYS: ENOUGH."), nook}
    case False{}:
      nooks.still.brew.k2(J.is_null(h), run, nook, id, j, h)
def nooks.still.mix(+run: J.Val, +nook: J.Val, +id: U32, +a: U32, +b: U32) -> GcRN:
  +r = nooks.still.said(run, id, a, b)
  nooks.still.mix.k1(r, nook, id)

def nooks.still.mix.k2(cv: Bool, +nook: J.Val, +r3: J.Val, +total: U32) -> GcRN:
  match cv:
    case True{}:
      nooks.Run.nook_raise(gc.sound(r3, "gas_release"), nook, "slime", 12.0, 6.2)
    case False{}:
      GcRN{r3, nook}

def nooks.still.mix.k1(pr: J.Val & String, +nook: J.Val, +id: U32) -> GcRN:
  (+run2, +said) = pr
  +r3 = gc.found(run2, id, said)
  +total = nooks.score_total(gc.vals(J.get(nook, "score")))
  nooks.still.mix.k2(U32.is_zero(U32.mod(total, 3)), nook, r3, total)
def nooks.score_total(+vs: List<&2, J.Val>) -> U32:
  nooks.score_total.k1(vs, vs)

def nooks.score_total.k1(sv0: List<&2, J.Val>, +vs: List<&2, J.Val>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+h, +t}:
      (J.u32(h) + nooks.score_total(t) : U32)
def nooks.still.said(+run: J.Val, +id: U32, +a: U32, +b: U32) -> J.Val & String:
  +h = gc.seat(J.get(run, "players"), id)
  nooks.still.said.k1(U32.is_eq(a, b), run, id, a, b, h)

def nooks.still.said.k3(cv: Bool, +run: J.Val, +id: U32, +a: U32, +b: U32, +h: J.Val) -> J.Val & String:
  match cv:
    case True{}:
      (nooks.set_hero(run, id, nooks.card_or(h, "thunder-scroll", "bombs")), "A THUNDER SCROLL!")
    case False{}:
      (nooks.set_hero(run, id, nooks.more_bombs(h)), "A BOMB! CAREFUL.")

def nooks.still.said.k2(cv: Bool, +run: J.Val, +id: U32, +a: U32, +b: U32, +h: J.Val) -> J.Val & String:
  match cv:
    case True{}:
      (nooks.set_hero(run, id, nooks.card_or(h, "potion", "hp")), "A HEALING POTION!")
    case False{}:
      nooks.still.said.k3(Bool.and(U32.is_eq(a, 1), U32.is_eq(b, 2)), run, id, a, b, h)

def nooks.still.said.k1(cv: Bool, +run: J.Val, +id: U32, +a: U32, +b: U32, +h: J.Val) -> J.Val & String:
  match cv:
    case True{}:
      (hexer.Run.hex(run, id), "RIBBIT. WRONG MIX.")
    case False{}:
      nooks.still.said.k2(Bool.and(U32.is_eq(a, 0), U32.is_eq(b, 1)), run, id, a, b, h)
def nooks.set_hero(+run: J.Val, +id: U32, +h: J.Val) -> J.Val:
  J.set(run, "players", gc.put_seat(J.get(run, "players"), id, h))
# A card into the hand, or (hand full) the fallback: "hp" mends 20, "bombs" adds one bomb.
def nooks.card_or(+h: J.Val, +card: String, +fallback: String) -> J.Val:
  nooks.card_or.k1(U32.is_lt(gc.len(J.items(J.get(h, "hand"))), cards.HAND()), h, card, fallback)

def nooks.card_or.k2(cv: Bool, +h: J.Val, +fallback: String) -> J.Val:
  match cv:
    case True{}:
      gc.su(h, "hp", gc.umin((gc.u(h, "hp") + 20 : U32), gc.u(h, "max_hp")))
    case False{}:
      nooks.more_bombs(h)

def nooks.card_or.k1(cv: Bool, +h: J.Val, +card: String, +fallback: String) -> J.Val:
  match cv:
    case True{}:
      gc.push_s(h, "hand", card)
    case False{}:
      nooks.card_or.k2(String.eq(fallback, "hp"), h, fallback)
def nooks.more_bombs(+h: J.Val) -> J.Val:
  gc.su(h, "bombs", gc.umin((gc.u(h, "bombs") + 1 : U32), rules.MAX_BOMBS()))
# --- The Bell Loft -----------------------------------------------------------

def nooks.SEQ.len(+r: U32) -> U32:
  gc.nth_u([3, 4, 5], r)
def nooks.SEQ.at(+r: U32, +k: U32) -> U32:
  nooks.SEQ.at.k1(U32.is_eq(r, 0), r, k)

def nooks.SEQ.at.k2(cv: Bool, +r: U32, +k: U32) -> U32:
  match cv:
    case True{}:
      gc.nth_u([3, 1, 0, 2], k)
    case False{}:
      gc.nth_u([1, 3, 2, 0, 3], k)

def nooks.SEQ.at.k1(cv: Bool, +r: U32, +k: U32) -> U32:
  match cv:
    case True{}:
      gc.nth_u([0, 2, 1], k)
    case False{}:
      nooks.SEQ.at.k2(U32.is_eq(r, 1), r, k)
def nooks.show_len(+r: U32) -> U32:
  (16 + (nooks.SEQ.len(r) * 26 : U32) : U32)
# Show: 0 YourTurn, 1 Ringing(None), 2 + b  Ringing(Some(b))
def nooks.show(+nook: J.Val) -> U32:
  nooks.show.go(gc.u(nook, "round"), gc.u(nook, "shown"))
def nooks.show.go(+r: U32, +shown: U32) -> U32:
  nooks.show.go.k1(Bool.or(U32.is_ge(r, 3), U32.is_ge(shown, nooks.show_len(r))), r, shown)

def nooks.show.go.k2(cv: Bool, +r: U32, +shown: U32) -> U32:
  match cv:
    case True{}:
      1
    case False{}:
      +t = (shown - 16 : U32)
      +k = U32.div(t, 26)
      gc.pu(Bool.and(U32.is_lt(U32.mod(t, 26), 18), U32.is_lt(k, nooks.SEQ.len(r))), (2 + nooks.SEQ.at(r, k) : U32), 1)

def nooks.show.go.k1(cv: Bool, +r: U32, +shown: U32) -> U32:
  match cv:
    case True{}:
      0
    case False{}:
      nooks.show.go.k2(U32.is_lt(shown, 16), r, shown)
def nooks.under.x(+b: U32) -> F32:
  (RS.u_as_f32(nooks.BELL.c(b)) + 0.5 : F32)
def nooks.under.y() -> F32:
  (3.0 + 1.8 : F32)
def nooks.Run.tick_loft(+run: J.Val, +nook: J.Val, +pressed: U32) -> GcRN:
  +lit = J.get(nook, "lit")
  +n1 = gc.ifj(J.is_null(lit), _ => nook, _ => nooks.loft.fade(nook, gc.ssub(gc.nu(lit, 1), 1), gc.nu(lit, 0)))
  +r = gc.u(n1, "round")
  nooks.Run.tick_loft.k1(U32.is_lt(gc.u(n1, "shown"), nooks.show_len(r)), run, pressed, n1, r)

def nooks.Run.tick_loft.k1(cv: Bool, +run: J.Val, +pressed: U32, +n1: J.Val, +r: U32) -> GcRN:
  match cv:
    case True{}:
      +before = nooks.show(n1)
      +n2 = gc.su(n1, "shown", (gc.u(n1, "shown") + 1 : U32))
      +after = nooks.show(n2)
      GcRN{gc.ifj(Bool.and(U32.is_ge(after, 2), U32.is_ne(before, after)), _ => gc.sound(run, "circle_toll"), _ => run), n2}
    case False{}:
      nooks.loft.each(run, n1, pressed, r, nooks.Run.nook_players(run))
# lit = Some((b, t - 1)) kept while t > 0
def nooks.loft.fade(+nook: J.Val, +t: U32, +b: U32) -> J.Val:
  nooks.loft.fade.k1(U32.is_zero(t), nook, t, b)

def nooks.loft.fade.k1(cv: Bool, +nook: J.Val, +t: U32, +b: U32) -> J.Val:
  match cv:
    case True{}:
      gc.snull(nook, "lit")
    case False{}:
      J.set(nook, "lit", gc.pairu(b, t))
def nooks.loft.bell(+run: J.Val, +id: U32) -> U32:
  gc.pu(nooks.Run.nook_near(run, id, nooks.under.x(0), nooks.under.y(), nooks.REACH()), 0, gc.pu(nooks.Run.nook_near(run, id, nooks.under.x(1), nooks.under.y(), nooks.REACH()), 1, gc.pu(nooks.Run.nook_near(run, id, nooks.under.x(2), nooks.under.y(), nooks.REACH()), 2, gc.pu(nooks.Run.nook_near(run, id, nooks.under.x(3), nooks.under.y(), nooks.REACH()), 3, 4))))
def nooks.loft.each(+run: J.Val, +nook: J.Val, +pressed: U32, +r: U32, +ids: List<&2, U32>) -> GcRN:
  nooks.loft.each.k1(ids, run, nook, pressed, r, ids)

def nooks.loft.each.k4(cv: Bool, +run: J.Val, +pressed: U32, +r: U32, +id: U32, +t: List<&2, U32>, +b: U32, +n1: J.Val) -> GcRN:
  match cv:
    case True{}:
      nooks.loft.ring(gc.sound(run, "circle_toll"), nooks.bump(gc.su(n1, "pos", (gc.u(n1, "pos") + 1 : U32)), "score", id), id, r, pressed, t)
    case False{}:
      +n2 = gc.su(gc.su(n1, "pos", 0), "shown", 0)
      +r1 = gc.found(gc.sound(run, "boss_roar"), id, "GONG! WRONG BELL.")
      nooks.Run.nook_raise(r1, n2, "wraith", 12.0, 7.0)

def nooks.loft.each.k3(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +r: U32, +id: U32, +t: List<&2, U32>, +b: U32) -> GcRN:
  match cv:
    case True{}:
      nooks.loft.each(run, nook, pressed, r, t)
    case False{}:
      +n1 = J.set(nook, "lit", gc.pairu(b, 12))
      nooks.loft.each.k4(U32.is_eq(nooks.SEQ.at(r, gc.u(n1, "pos")), b), run, pressed, r, id, t, b, n1)

def nooks.loft.each.k2(cv: Bool, +run: J.Val, +nook: J.Val, +pressed: U32, +r: U32, +id: U32, +t: List<&2, U32>) -> GcRN:
  match cv:
    case True{}:
      +b = nooks.loft.bell(run, id)
      nooks.loft.each.k3(U32.is_ge(b, 4), run, nook, pressed, r, id, t, b)
    case False{}:
      nooks.loft.each(run, nook, pressed, r, t)

def nooks.loft.each.k1(sv0: List<&2, U32>, +run: J.Val, +nook: J.Val, +pressed: U32, +r: U32, +ids: List<&2, U32>) -> GcRN:
  match sv0:
    case Nil{}:
      GcRN{run, nook}
    case Con{+id, +t}:
      nooks.loft.each.k2(nooks.has(pressed, id), run, nook, pressed, r, id, t)
# A right bell: the phrase may be complete.
def nooks.loft.ring(+run: J.Val, +nook: J.Val, +id: U32, +r: U32, +pressed: U32, +t: List<&2, U32>) -> GcRN:
  nooks.loft.ring.k1(U32.is_eq(gc.u(nook, "pos"), nooks.SEQ.len(r)), run, nook, id, r, pressed, t)

def nooks.loft.ring.k3(pr: J.Val & U32, +n2: J.Val) -> GcRN:
  (+r2, +best) = pr
  GcRN{gc.found(gc.sound(r2, "wish_grant"), 0, "THE HYMN! ALL MENDED."), n2}

def nooks.loft.ring.k2(cv: Bool, +run: J.Val, +id: U32, +n1: J.Val) -> GcRN:
  match cv:
    case True{}:
      +n2 = gc.sb(gc.su(gc.su(n1, "round", 2), "shown", nooks.show_len(2)), "done", True{})
      +r1 = nooks.hymn(run, nooks.Run.nook_players(run))
      +c = nooks.Run.nook_crown(r1, n2)
      nooks.loft.ring.k3(c, n2)
    case False{}:
      GcRN{gc.found(run, id, "BRAVO! AGAIN, LONGER."), n1}

def nooks.loft.ring.k1(cv: Bool, +run: J.Val, +nook: J.Val, +id: U32, +r: U32, +pressed: U32, +t: List<&2, U32>) -> GcRN:
  match cv:
    case True{}:
      +n1 = gc.su(gc.su(gc.su(nook, "pos", 0), "shown", 0), "round", (gc.u(nook, "round") + 1 : U32))
      nooks.loft.ring.k2(U32.is_eq(gc.u(n1, "round"), 3), run, id, n1)
    case False{}:
      nooks.loft.each(run, nook, pressed, r, t)
# Everyone mended and paid six gold.
def nooks.hymn(+run: J.Val, +ids: List<&2, U32>) -> J.Val:
  nooks.hymn.k1(ids, run, ids)

def nooks.hymn.k1(sv0: List<&2, U32>, +run: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+id, +t}:
      +h = gc.seat(J.get(run, "players"), id)
      nooks.hymn(nooks.gold(nooks.set_hero(run, id, gc.su(h, "hp", gc.u(h, "max_hp"))), id, 6), t)
