# Case wrappers for latch.rs: unpack the recorded input, call the port, pack the recorded output.

def gcase.latch.Duel.step_at(+i: J.Val) -> J.Val:
  r: J.Val & String = latch.Duel.step_at(J.get(i, "d"), J.get(i, "input"), J.get(i, "tune"), gc.maybe_w(J.get(i, "now")), W.of_j(J.get(i, "allowance")))
  (d: J.Val, sound: String) = r
  J.set(J.set(J.obj(), "d", d), "ret", gc.ret_s(sound))

def gcase.latch.Session.place(+i: J.Val) -> J.Val:
  J.set(J.obj(), "ret", J.JU{latch.Session.place(J.get(i, "s"), gc.u(i, "id"))})

def gcase.latch.Session.payout(+i: J.Val) -> J.Val:
  J.set(J.obj(), "ret", J.JU{latch.Session.payout(J.get(i, "s"), gc.u(i, "id"))})

def gcase.latch.timing(+i: J.Val) -> J.Val:
  J.set(J.obj(), "ret", J.JS{latch.timing(gc.u(i, "ticks"))})
