# Ball::new()
def mossbell.Ball.new() -> J.Val:
  +b0 = gc.si(gc.si(gc.si(gc.si(J.obj(), "x", (145 * 256 : U32)), "y", (122 * 256 : U32)), "vx", 0), "vy", 0)
  +b1 = J.set(b0, "trail", J.JA{[gc.pairu(145, 122), gc.pairu(145, 122), gc.pairu(145, 122), gc.pairu(145, 122)]})
  +b2 = gc.zeros(b1, ["score", "drains", "chain", "lit", "attack", "hit", "freeze", "left", "right", "burst"])
  +b3 = gc.su(gc.su(gc.su(b2, "hp", 6), "beat_left", 120), "save", 1)
  +b4 = gc.ss(b3, "beat", "Idle")
  +b5 = J.set(b4, "flash", J.JA{[J.JU{0}, J.JU{0}, J.JU{0}]})
  gc.snull(J.set(b5, "impact", gc.pairu(145, 122)), "jackpot_at")
# Ball::contact(x, y)
def mossbell.Ball.contact(+b: J.Val, +x: U32, +y: U32) -> J.Val:
  gc.su(J.set(b, "impact", gc.pairu(x, y)), "burst", 12)
# fn circle(&mut self, cx, cy, r, bounce) -> bool
def mossbell.Ball.circle(+b: J.Val, +cx: U32, +cy: U32, +r: U32, +bounce: U32) -> J.Val & Bool:
  +dx0 = RS.i_sub(gc.u(b, "x"), cx)
  +dy0 = RS.i_sub(gc.u(b, "y"), cy)
  +zero = Bool.and(U32.is_zero(dx0), U32.is_zero(dy0))
  +dx = gc.pu(zero, 1, dx0)
  +dy = gc.pu(zero, RS.i_neg(256), dy0)
  +d2 = W.add(W.mul(gc.l_of(dx), gc.l_of(dx)), W.mul(gc.l_of(dy), gc.l_of(dy)))
  +r2 = W.mul(W.of_u32(r), W.of_u32(r))
  mossbell.Ball.circle.k1(W.ge(d2, r2), b, cx, cy, r, bounce, dx, dy, d2, r2)

def mossbell.Ball.circle.k1(cv: Bool, +b: J.Val, +cx: U32, +cy: U32, +r: U32, +bounce: U32, +dx: U32, +dy: U32, +d2: W.W, +r2: W.W) -> J.Val & Bool:
  match cv:
    case True{}:
      (b, False{})
    case False{}:
      mossbell.Ball.circle2(b, cx, cy, r, bounce, dx, dy, d2)
def mossbell.Ball.circle2(+b: J.Val, +cx: U32, +cy: U32, +r: U32, +bounce: U32, +dx: U32, +dy: U32, +d2: W.W) -> J.Val & Bool:
  +d = RS.u_isqrt(W.lo32(d2))
  +closing = W.add(W.mul(gc.l_of(gc.u(b, "vx")), gc.l_of(dx)), W.mul(gc.l_of(gc.u(b, "vy")), gc.l_of(dy)))
  +dm = RS.i_max(d, 1)
  +b1 = gc.si(gc.si(b, "x", RS.i_add(cx, RS.i_div(RS.i_mul(dx, r), dm))), "y", RS.i_add(cy, RS.i_div(RS.i_mul(dy, r), dm)))
  mossbell.Ball.circle2.k1(gc.l_neg_p(closing), bounce, dx, dy, d2, closing, b1)

def mossbell.Ball.circle2.k1(cv: Bool, +bounce: U32, +dx: U32, +dy: U32, +d2: W.W, +closing: W.W, +b1: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      +den = W.mul(d2, W.of_u32(100))
      +dvx = gc.l_div(W.mul(W.mul(closing, gc.l_of(dx)), W.of_u32((100 + bounce : U32))), den)
      +dvy = gc.l_div(W.mul(W.mul(closing, gc.l_of(dy)), W.of_u32((100 + bounce : U32))), den)
      (gc.si(gc.si(b1, "vx", RS.i_sub(gc.u(b1, "vx"), W.lo32(dvx))), "vy", RS.i_sub(gc.u(b1, "vy"), W.lo32(dvy))), True{})
    case False{}:
      (b1, False{})
# fn rail(&mut self, a, b, bounce) -> bool: the segment's nearest point is a circle of radius 3.
def mossbell.Ball.rail(+b: J.Val, +ax0: U32, +ay0: U32, +bx0: U32, +by0: U32, +bounce: U32) -> J.Val & Bool:
  +ax = (ax0 * 256 : U32)
  +ay = (ay0 * 256 : U32)
  +dx = RS.i_mul(RS.i_sub(bx0, ax0), 256)
  +dy = RS.i_mul(RS.i_sub(by0, ay0), 256)
  +length = W.add(W.mul(gc.l_of(dx), gc.l_of(dx)), W.mul(gc.l_of(dy), gc.l_of(dy)))
  +dot0 = W.add(W.mul(gc.l_of(RS.i_sub(gc.u(b, "x"), ax)), gc.l_of(dx)), W.mul(gc.l_of(RS.i_sub(gc.u(b, "y"), ay)), gc.l_of(dy)))
  +dot = gc.l_clamp(dot0, W.zero(), length)
  +cx = RS.i_add(ax, W.lo32(gc.l_div(W.mul(gc.l_of(dx), dot), length)))
  +cy = RS.i_add(ay, W.lo32(gc.l_div(W.mul(gc.l_of(dy), dot), length)))
  mossbell.Ball.circle(b, cx, cy, (3 * 256 : U32), bounce)
def mossbell.in_range(+v: U32, +lo: U32, +hi: U32) -> Bool:
  Bool.and(RS.i_ge(v, lo), RS.i_le(v, hi))
# Ball::step(stroke, tune, age, seed, tick)
def mossbell.Ball.step(+b: J.Val, +stroke: J.Val, +tune: J.Val, +age: U32, +seed: W.W, +tick: W.W) -> J.Val:
  +b1 = gc.ifj(gc.b(stroke, "left"), _ => gc.su(b, "left", 5), _ => b)
  +b2 = gc.ifj(gc.b(stroke, "right"), _ => gc.su(b1, "right", 5), _ => b1)
  +fl = mossbell.cool3(gc.us(J.get(b2, "flash")))
  +b3 = gc.su(gc.su(J.set(b2, "flash", gc.of_us(fl)), "hit", gc.ssub(gc.u(b2, "hit"), 1)), "burst", gc.ssub(gc.u(b2, "burst"), 1))
  +b4 = mossbell.beat(b3, seed)
  mossbell.Ball.step.k1(U32.is_gt(gc.u(b4, "freeze"), 0), stroke, tune, age, seed, tick, b4)

def mossbell.Ball.step.k3(cv: Bool, +stroke: J.Val, +tune: J.Val, +save: U32, +b5: J.Val) -> J.Val:
  match cv:
    case True{}:
      gc.si(gc.si(gc.si(gc.si(gc.si(gc.su(J.set(b5, "trail", mossbell.trail0()), "save", 0), "x", (145 * 256 : U32)), "y", (122 * 256 : U32)), "vx", 0), "vy", RS.i_neg(gc.u(tune, "moss_launch"))), "unused", 0)
    case False{}:
      b5

def mossbell.Ball.step.k2(cv: Bool, +stroke: J.Val, +tune: J.Val, +age: U32, +seed: W.W, +tick: W.W, +b4: J.Val) -> J.Val:
  match cv:
    case True{}:
      +save = (gc.u(b4, "save") - 1 : U32)
      +b5 = gc.su(b4, "save", save)
      mossbell.Ball.step.k3(Bool.or(U32.is_zero(save), gc.b(stroke, "launch")), stroke, tune, save, b5)
    case False{}:
      mossbell.Ball.move(b4, stroke, tune, age, seed, tick)

def mossbell.Ball.step.k1(cv: Bool, +stroke: J.Val, +tune: J.Val, +age: U32, +seed: W.W, +tick: W.W, +b4: J.Val) -> J.Val:
