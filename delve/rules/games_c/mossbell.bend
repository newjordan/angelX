def mossbell.trail0() -> J.Val:
  J.JA{[gc.pairu(145, 122), gc.pairu(145, 122), gc.pairu(145, 122), gc.pairu(145, 122)]}
def mossbell.cool3(+xs: List<&2, U32>) -> List<&2, U32>:
  mossbell.cool3.k1(xs, xs)

def mossbell.cool3.k1(sv0: List<&2, U32>, +xs: List<&2, U32>) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      gc.ssub(h, 1) <> mossbell.cool3(t)
# The boss's beat machine: tell, strike, rest.
def mossbell.beat(+b: J.Val, +seed: W.W) -> J.Val:
  mossbell.beat.k1(U32.is_zero(gc.u(b, "hp")), b, seed)

def mossbell.beat.k5(cv: Bool, +b1: J.Val, +beat: String) -> J.Val:
  match cv:
    case True{}:
      gc.su(gc.ss(b1, "beat", "Crown"), "beat_left", 12)
    case False{}:
      gc.su(gc.ss(b1, "beat", "Idle"), "beat_left", (90 + (gc.u(b1, "hp") * 10 : U32) : U32))

def mossbell.beat.k4(cv: Bool, +b1: J.Val, +beat: String) -> J.Val:
  match cv:
    case True{}:
      gc.su(gc.ss(b1, "beat", "Root"), "beat_left", 12)
    case False{}:
      mossbell.beat.k5(String.eq(beat, "CrownTell"), b1, beat)

def mossbell.beat.k3(cv: Bool, +seed: W.W, +b1: J.Val, +beat: String) -> J.Val:
  match cv:
    case True{}:
      +tell = U32.is_zero(U32.and((gc.u(b1, "attack") + W.lo32(seed) : U32), 1))
      gc.su(gc.su(gc.ss(b1, "beat", gc.ps(tell, "RootTell", "CrownTell")), "attack", (gc.u(b1, "attack") + 1 : U32)), "beat_left", gc.pu(U32.is_gt(gc.u(b1, "hp"), 2), 36, 30))
    case False{}:
      mossbell.beat.k4(String.eq(beat, "RootTell"), b1, beat)

def mossbell.beat.k2(cv: Bool, +seed: W.W, +left: U32, +b1: J.Val) -> J.Val:
  match cv:
    case True{}:
      +beat = gc.s(b1, "beat")
      mossbell.beat.k3(Bool.or(String.eq(beat, "Idle"), String.eq(beat, "Flinch")), seed, b1, beat)
    case False{}:
      b1

def mossbell.beat.k1(cv: Bool, +b: J.Val, +seed: W.W) -> J.Val:
  match cv:
    case True{}:
      gc.ss(b, "beat", "Defeat")
    case False{}:
      +left = gc.ssub(gc.u(b, "beat_left"), 1)
      +b1 = gc.su(b, "beat_left", left)
      mossbell.beat.k2(U32.is_zero(left), seed, left, b1)
# trail.rotate_right(1); trail[0] = (x, y)
def mossbell.trail_push(+trail: J.Val, +x: U32, +y: U32) -> J.Val:
  J.JA{gc.pairi(x, y) <> List.take(&2, J.Val, J.items(trail), 3n)}
def mossbell.Ball.move(+b: J.Val, +stroke: J.Val, +tune: J.Val, +age: U32, +seed: W.W, +tick: W.W) -> J.Val:
  +trail = J.get(b, "trail")
  +t1 = mossbell.trail_push(trail, RS.i_div(gc.u(b, "x"), 256), RS.i_div(gc.u(b, "y"), 256))
  +nudge = gc.u(stroke, "nudge")
  +b1 = gc.si(J.set(b, "trail", t1), "vx", RS.i_add(gc.u(b, "vx"), RS.i_mul(nudge, gc.u(tune, "moss_nudge"))))
  +b2 = gc.ifj(U32.is_ne(nudge, 0), _ => gc.si(b1, "vy", RS.i_sub(gc.u(b1, "vy"), RS.i_div(gc.u(tune, "moss_nudge"), 2))), _ => b1)
  +b3 = gc.ifj(Bool.and(RS.i_gt(gc.u(b2, "x"), (140 * 256 : U32)), Bool.and(RS.i_lt(gc.u(b2, "y"), (22 * 256 : U32)), U32.is_zero(gc.u(b2, "vx")))), _ => gc.si(b2, "vx", RS.i_neg((360 + U32.and(W.lo32(W.rotl(seed, U32.mod(age, 64))), 63) : U32))), _ => b2)
  +b4 = mossbell.swing(b3, gc.b(stroke, "left"), True{}, tune)
  +b5 = mossbell.swing(b4, gc.b(stroke, "right"), False{}, tune)
  +b6 = gc.si(b5, "vy", RS.i_add(gc.u(b5, "vy"), gc.u(tune, "moss_gravity")))
  +b7 = mossbell.sub(b6, tune, 4, gc.u(tune, "moss_bounce"), tick)
  +b8 = gc.si(gc.si(b7, "x", RS.i_clamp(gc.u(b7, "x"), 0, (160 * 256 : U32))), "y", RS.i_clamp(gc.u(b7, "y"), 0, (146 * 256 : U32)))
  +b9 = gc.su(gc.su(b8, "left", gc.ssub(gc.u(b8, "left"), 1)), "right", gc.ssub(gc.u(b8, "right"), 1))
  gc.ifj(Bool.and(U32.is_zero(gc.u(b9, "hp")), Bool.and(U32.is_eq(gc.u(b9, "lit"), 7), J.is_null(J.get(b9, "jackpot_at")))), _ => J.set(gc.su(J.set(b9, "jackpot_at", W.to_j(tick)), "burst", 16), "impact", gc.pairu(80, 63)), _ => b9)
# A flipper swung with the ball on it knocks it up and across.
def mossbell.swing(+b: J.Val, +swing: Bool, +left: Bool, +tune: J.Val) -> J.Val:
  +bx = RS.i_div(gc.u(b, "x"), 256)
  +along = gc.pu(left, RS.i_sub(bx, 37), RS.i_sub(123, bx))
  mossbell.swing.k1(Bool.and(swing, Bool.and(mossbell.in_range(along, 0, 33), RS.i_gt(gc.u(b, "vy"), 0))), b, swing, left, tune, along)

def mossbell.swing.k2(cv: Bool, +b: J.Val, +left: Bool, +tune: J.Val, +along: U32, +raised: U32, +resting: U32, +y: U32) -> J.Val:
  match cv:
    case True{}:
      +vx = gc.pu(left, RS.i_add(320, RS.i_mul(along, 12)), RS.i_sub(RS.i_neg(320), RS.i_mul(along, 12)))
      +b1 = gc.si(gc.si(gc.si(b, "y", RS.i_sub(raised, 1024)), "vy", RS.i_neg(gc.u(tune, "moss_flipper"))), "vx", vx)
      gc.su(mossbell.Ball.contact(b1, RS.i_div(gc.u(b1, "x"), 256), RS.i_div(gc.u(b1, "y"), 256)), "freeze", 2)
    case False{}:
      b

def mossbell.swing.k1(cv: Bool, +b: J.Val, +swing: Bool, +left: Bool, +tune: J.Val, +along: U32) -> J.Val:
  match cv:
    case True{}:
      +raised = RS.i_sub((119 * 256 : U32), RS.i_div(RS.i_mul(RS.i_mul(along, 8), 256), 33))
      +resting = RS.i_add((119 * 256 : U32), RS.i_div(RS.i_mul(RS.i_mul(along, 11), 256), 33))
      +y = gc.u(b, "y")
      mossbell.swing.k2(Bool.and(RS.i_ge(y, RS.i_sub(raised, 768)), RS.i_le(y, RS.i_add(resting, 768))), b, left, tune, along, raised, resting, y)
    case False{}:
      b
# The four sub-steps of a tick; a drain ends them.
def mossbell.sub(+b: J.Val, +tune: J.Val, +n: U32, +bounce: U32, +tick: W.W) -> J.Val:
  mossbell.sub.k1(U32.is_zero(n), b, tune, n, bounce, tick)

def mossbell.sub.k3(cv: Bool, +tune: J.Val, +n: U32, +bounce: U32, +tick: W.W, +b2: J.Val, +drained: Bool) -> J.Val:
  match cv:
    case True{}:
      b2
    case False{}:
      mossbell.sub(b2, tune, (n - 1 : U32), bounce, tick)

def mossbell.sub.k2(pr: J.Val & Bool, +tune: J.Val, +n: U32, +bounce: U32, +tick: W.W) -> J.Val:
  (+b2, +drained) = pr
  mossbell.sub.k3(drained, tune, n, bounce, tick, b2, drained)

def mossbell.sub.k1(cv: Bool, +b: J.Val, +tune: J.Val, +n: U32, +bounce: U32, +tick: W.W) -> J.Val:
  match cv:
    case True{}:
      b
    case False{}:
      +r = mossbell.sub1(b, tune, bounce)
      mossbell.sub.k2(r, tune, n, bounce, tick)
def mossbell.sub1(+b: J.Val, +tune: J.Val, +bounce: U32) -> J.Val & Bool:
  +b1 = gc.si(gc.si(b, "x", RS.i_add(gc.u(b, "x"), RS.i_div(gc.u(b, "vx"), 4))), "y", RS.i_add(gc.u(b, "y"), RS.i_div(gc.u(b, "vy"), 4)))
  +b2 = gc.ifj(RS.i_lt(gc.u(b1, "x"), (7 * 256 : U32)), _ => gc.si(gc.si(b1, "x", (7 * 256 : U32)), "vx", RS.i_div(RS.i_mul(RS.i_abs(gc.u(b1, "vx")), bounce), 100)), _ => b1)
  +b3 = gc.ifj(RS.i_gt(gc.u(b2, "x"), (153 * 256 : U32)), _ => gc.si(gc.si(b2, "x", (153 * 256 : U32)), "vx", RS.i_div(RS.i_mul(RS.i_neg(RS.i_abs(gc.u(b2, "vx"))), bounce), 100)), _ => b2)
  +b4 = gc.ifj(RS.i_lt(gc.u(b3, "y"), (6 * 256 : U32)), _ => gc.si(gc.si(b3, "y", (6 * 256 : U32)), "vy", RS.i_div(RS.i_mul(RS.i_abs(gc.u(b3, "vy")), bounce), 100)), _ => b3)
  +r1 = mossbell.Ball.rail(b4, 8, 98, 38, 123, bounce)
  mossbell.sub1.k1(r1, tune, bounce)

def mossbell.sub1.k2(cv: Bool, +b12: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      +b13 = gc.su(gc.su(gc.su(gc.su(b12, "drains", (gc.u(b12, "drains") + 1 : U32)), "chain", 0), "lit", 0), "save", 12)
      +b14 = gc.si(gc.si(gc.si(gc.si(b13, "x", (145 * 256 : U32)), "y", (122 * 256 : U32)), "vx", 0), "vy", 0)
      (mossbell.Ball.contact(b14, 80, 134), True{})
    case False{}:
      (b12, False{})

def mossbell.sub1.k1(pr: J.Val & Bool, +tune: J.Val, +bounce: U32) -> J.Val & Bool:
  (+b5, +h1) = pr
  +b6 = mossbell.right_rail(b5, bounce)
  +b7 = mossbell.flippers(b6, tune, bounce)
  +b8 = mossbell.bumpers(b7, bounce, 0)
  +b9 = mossbell.boss(b8, bounce)
  +b10 = gc.ifj(Bool.and(String.eq(gc.s(b9, "beat"), "Root"), mossbell.in_range(gc.u(b9, "y"), (72 * 256 : U32), (82 * 256 : U32))), _ => gc.si(gc.si(b9, "vx", gc.pu(U32.is_zero(U32.and(gc.u(b9, "attack"), 1)), 850, RS.i_neg(850))), "vy", 250), _ => b9)
  +b11 = gc.ifj(Bool.and(String.eq(gc.s(b10, "beat"), "Crown"), Bool.and(mossbell.in_range(gc.u(b10, "x"), (60 * 256 : U32), (100 * 256 : U32)), mossbell.in_range(gc.u(b10, "y"), (20 * 256 : U32), (43 * 256 : U32)))), _ => gc.si(b10, "vy", 900), _ => b10)
  +b12 = gc.si(gc.si(b11, "vx", RS.i_clamp(gc.u(b11, "vx"), RS.i_neg(2200), 2200)), "vy", RS.i_clamp(gc.u(b11, "vy"), RS.i_neg(2200), 2200))
  mossbell.sub1.k2(RS.i_gt(gc.u(b12, "y"), (143 * 256 : U32)), b12)
# if !(x > 140Q && vy < 0) { rail((152,98),(122,123)) }
def mossbell.right_rail(+b: J.Val, +bounce: U32) -> J.Val:
  mossbell.right_rail.k1(Bool.and(RS.i_gt(gc.u(b, "x"), (140 * 256 : U32)), RS.i_lt(gc.u(b, "vy"), 0)), b, bounce)

def mossbell.right_rail.k2(pr: J.Val & Bool) -> J.Val:
  (+b2, +h) = pr
  b2

def mossbell.right_rail.k1(cv: Bool, +b: J.Val, +bounce: U32) -> J.Val:
  match cv:
    case True{}:
      b
    case False{}:
      +r = mossbell.Ball.rail(b, 152, 98, 122, 123, bounce)
      mossbell.right_rail.k2(r)
# Each flipper's rail; a live swing from a falling ball kicks it.
def mossbell.flippers(+b: J.Val, +tune: J.Val, +bounce: U32) -> J.Val:
  +lact = gc.u(b, "left")
  +ract = gc.u(b, "right")
  +b1 = mossbell.flipper(b, tune, bounce, True{}, 37, 119, 70, gc.pu(U32.is_gt(lact, 0), 111, 130), lact)
  mossbell.flipper(b1, tune, bounce, False{}, 123, 119, 90, gc.pu(U32.is_gt(ract, 0), 111, 130), ract)
def mossbell.flipper(+b: J.Val, +tune: J.Val, +bounce: U32, +left: Bool, +ax: U32, +ay: U32, +tx: U32, +ty: U32, +active: U32) -> J.Val:
  +falling = RS.i_gt(gc.u(b, "vy"), 0)
  +r = mossbell.Ball.rail(b, ax, ay, tx, ty, bounce)
  mossbell.flipper.k1(r, tune, left, active, falling)

def mossbell.flipper.k2(cv: Bool, +tune: J.Val, +left: Bool, +active: U32, +falling: Bool, +b1: J.Val, +hit: Bool) -> J.Val:
  match cv:
    case True{}:
      +bx = RS.i_div(gc.u(b1, "x"), 256)
      +vx = gc.pu(left, RS.i_add(320, RS.i_mul(RS.i_sub(bx, 37), 12)), RS.i_sub(RS.i_neg(320), RS.i_mul(RS.i_sub(123, bx), 12)))
      +b2 = gc.si(gc.si(b1, "vy", RS.i_neg(gc.u(tune, "moss_flipper"))), "vx", vx)
      gc.su(mossbell.Ball.contact(b2, RS.i_div(gc.u(b2, "x"), 256), RS.i_div(gc.u(b2, "y"), 256)), "freeze", 2)
    case False{}:
      b1

def mossbell.flipper.k1(pr: J.Val & Bool, +tune: J.Val, +left: Bool, +active: U32, +falling: Bool) -> J.Val:
  (+b1, +hit) = pr
  mossbell.flipper.k2(Bool.and(hit, Bool.and(U32.is_gt(active, 0), falling)), tune, left, active, falling, b1, hit)
def mossbell.bumpers(+b: J.Val, +bounce: U32, +i: U32) -> J.Val:
  mossbell.bumpers.k1(U32.is_ge(i, 3), b, bounce, i)

def mossbell.bumpers.k3(cv: Bool, +bounce: U32, +i: U32, +x: U32, +y: U32, +b1: J.Val, +hit: Bool) -> J.Val:
  match cv:
    case True{}:
      +lit = U32.or(gc.u(b1, "lit"), gc.bit(i))
      +b2 = gc.su(gc.su(J.set(b1, "flash", J.set_nth(J.get(b1, "flash"), i, J.JU{12})), "score", (gc.u(b1, "score") + 25 : U32)), "lit", lit)
      +b3 = gc.si(gc.su(b2, "chain", RS.u_count_ones(lit)), "vx", RS.i_add(gc.u(b2, "vx"), gc.pu(RS.i_gt(gc.u(b2, "x"), (x * 256 : U32)), 90, RS.i_neg(90))))
      mossbell.bumpers(mossbell.Ball.contact(gc.si(b3, "vy", RS.i_sub(gc.u(b3, "vy"), 100)), x, y), bounce, (i + 1 : U32))
    case False{}:
      mossbell.bumpers(b1, bounce, (i + 1 : U32))

def mossbell.bumpers.k2(pr: J.Val & Bool, +bounce: U32, +i: U32, +x: U32, +y: U32) -> J.Val:
  (+b1, +hit) = pr
  mossbell.bumpers.k3(Bool.and(hit, U32.is_zero(J.u32(J.nth(J.get(b1, "flash"), i)))), bounce, i, x, y, b1, hit)

def mossbell.bumpers.k1(cv: Bool, +b: J.Val, +bounce: U32, +i: U32) -> J.Val:
  match cv:
    case True{}:
      b
    case False{}:
      +x = mossbell.BUMPER.x(i)
      +y = mossbell.BUMPER.y(i)
      +r = mossbell.Ball.circle(b, (x * 256 : U32), (y * 256 : U32), ((mossbell.BUMPER.r(i) + 3 : U32) * 256 : U32), bounce)
      mossbell.bumpers.k2(r, bounce, i, x, y)
# The Moss Boss: a hit costs it a point; at zero it is beaten.
def mossbell.boss(+b: J.Val, +bounce: U32) -> J.Val:
  mossbell.boss.k1(U32.is_zero(gc.u(b, "hp")), b, bounce)

def mossbell.boss.k4(cv: Bool, +hp: U32, +b2: J.Val) -> J.Val:
  match cv:
    case True{}:
      gc.ss(gc.su(b2, "score", (gc.u(b2, "score") + 300 : U32)), "beat", "Defeat")
    case False{}:
      gc.su(gc.ss(b2, "beat", "Flinch"), "beat_left", 12)

def mossbell.boss.k3(cv: Bool, +b1: J.Val, +hit: Bool) -> J.Val:
  match cv:
    case True{}:
      +hp = (gc.u(b1, "hp") - 1 : U32)
      +b2 = mossbell.Ball.contact(gc.su(gc.su(gc.su(b1, "hp", hp), "score", (gc.u(b1, "score") + 100 : U32)), "hit", 10), 80, 33)
      mossbell.boss.k4(U32.is_zero(hp), hp, b2)
    case False{}:
      b1

def mossbell.boss.k2(pr: J.Val & Bool) -> J.Val:
  (+b1, +hit) = pr
  mossbell.boss.k3(Bool.and(hit, U32.is_zero(gc.u(b1, "hit"))), b1, hit)

def mossbell.boss.k1(cv: Bool, +b: J.Val, +bounce: U32) -> J.Val:
  match cv:
    case True{}:
      b
    case False{}:
      +r = mossbell.Ball.circle(b, (80 * 256 : U32), (27 * 256 : U32), (19 * 256 : U32), bounce)
      mossbell.boss.k2(r)
# Stroke::merge(&mut self, other)
def mossbell.Stroke.merge(+a: J.Val, +o: J.Val) -> J.Val:
  +s1 = gc.sb(gc.sb(a, "left", Bool.or(gc.b(a, "left"), gc.b(o, "left"))), "right", Bool.or(gc.b(a, "right"), gc.b(o, "right")))
  +s2 = gc.ifj(U32.is_ne(gc.u(o, "nudge"), 0), _ => J.set(s1, "nudge", J.get(o, "nudge")), _ => s1)
  gc.sb(s2, "launch", Bool.or(gc.b(a, "launch"), gc.b(o, "launch")))
def mossbell.Stroke.new(+left: Bool, +right: Bool, +nudge: U32, +launch: Bool) -> J.Val:
  gc.sb(gc.si(gc.sb(gc.sb(J.obj(), "left", left), "right", right), "nudge", nudge), "launch", launch)
# Table::new(seed)
def mossbell.Table.new(+seed: J.Val) -> J.Val:
  +t0 = J.set(J.set(J.obj(), "ball", mossbell.Ball.new()), "seed", seed)
  +t1 = J.set(t0, "keys", J.JA{[J.JBool{False{}}, J.JBool{False{}}, J.JBool{False{}}, J.JBool{False{}}]})
  J.set(t1, "history", J.JA{Nil{}})
def mossbell.key(+t: J.Val, +i: U32) -> Bool:
  J.bool(J.nth(J.get(t, "keys"), i))
# Table::step(input, tune, age, tick, allowance)
def mossbell.Table.step(+t: J.Val, +input: J.Val, +tune: J.Val, +age: U32, +tick: W.W, +allowance: W.W) -> J.Val:
  +lt = J.get(input, "latch_tick")
  +ok = Bool.and(rules.Input.valid(input), Bool.or(J.is_null(lt), Bool.and(W.le(W.of_j(lt), tick), W.le(W.sub(tick, W.of_j(lt)), allowance))))
  +i = gc.ifj(ok, _ => input, _ => rules.Input.default())
  +k0 = Bool.or(gc.neg(gc.u(i, "move_x")), gc.b(i, "fire"))
  +k1 = Bool.or(Bool.and(U32.is_ne(gc.u(i, "move_x"), 0), Bool.not(gc.neg(gc.u(i, "move_x")))), gc.b(i, "fire"))
  +k2 = gc.neg(gc.u(i, "move_y"))
  +k3 = gc.b(i, "fire")
  +left_side = RS.i_lt(gc.u(J.get(t, "ball"), "x"), (80 * 256 : U32))
  +nudge = gc.pu(left_side, 1, RS.i_neg(1))
  +stroke = mossbell.Stroke.new(Bool.and(k0, Bool.not(mossbell.key(t, 0))), Bool.and(k1, Bool.not(mossbell.key(t, 1))), gc.pu(Bool.and(k2, Bool.not(mossbell.key(t, 2))), nudge, 0), Bool.and(k3, Bool.not(mossbell.key(t, 3))))
  +t1 = J.set(t, "keys", J.JA{[J.JBool{k0}, J.JBool{k1}, J.JBool{k2}, J.JBool{k3}]})
  mossbell.Table.step.k1(J.is_null(lt), tune, age, tick, lt, k0, k1, k2, k3, nudge, stroke, t1)

def mossbell.Table.step.k2(cv: Bool, +tune: J.Val, +age: U32, +tick: W.W, +k2: Bool, +t1: J.Val, +stamped: J.Val, +sample: W.W) -> J.Val:
  match cv:
    case True{}:
      +t2 = mossbell.Table.replay(t1, sample, stamped, k2)
      mossbell.Table.record(t2, mossbell.Stroke.new(False{}, False{}, 0, False{}), tune, age, tick)
    case False{}:
      mossbell.Table.record(t1, gc.ifj(W.gt(sample, tick), _ => mossbell.Stroke.new(False{}, False{}, 0, False{}), _ => stamped), tune, age, tick)

def mossbell.Table.step.k1(cv: Bool, +tune: J.Val, +age: U32, +tick: W.W, +lt: J.Val, +k0: Bool, +k1: Bool, +k2: Bool, +k3: Bool, +nudge: U32, +stroke: J.Val, +t1: J.Val) -> J.Val:
  match cv:
    case True{}:
      mossbell.Table.record(t1, stroke, tune, age, tick)
    case False{}:
      +stamped = mossbell.Stroke.new(k0, k1, gc.pu(k2, nudge, 0), k3)
      +sample = W.of_j(lt)
      mossbell.Table.step.k2(W.lt(sample, tick), tune, age, tick, k2, t1, stamped, sample)
# A late stamped press rewinds to its tick and replays the history with the stroke merged in.
def mossbell.Table.replay(+t: J.Val, +sample: W.W, +stroke: J.Val, +nudging: Bool) -> J.Val:
  +at = mossbell.position(J.items(J.get(t, "history")), sample, 0)
  mossbell.Table.replay.k1(U32.is_eq(at, 4294967295), t, stroke, nudging, at)

def mossbell.Table.replay.k2(pr: J.Val & J.Val, +t: J.Val, +at: U32, +hist1: J.Val) -> J.Val:
  (+ball, +redone) = pr
  J.set(J.set(t, "ball", ball), "history", J.JA{List.append(&2, J.Val, J.items(J.truncate(hist1, at)), J.items(redone))})

def mossbell.Table.replay.k1(cv: Bool, +t: J.Val, +stroke: J.Val, +nudging: Bool, +at: U32) -> J.Val:
  match cv:
    case True{}:
      t
    case False{}:
      +h = J.nth(J.get(t, "history"), at)
      +s1 = gc.ifj(nudging, _ => gc.si(stroke, "nudge", gc.pu(RS.i_lt(gc.u(J.get(h, "before"), "x"), (80 * 256 : U32)), 1, RS.i_neg(1))), _ => stroke)
      +h2 = J.set(h, "stroke", mossbell.Stroke.merge(J.get(h, "stroke"), s1))
      +hist1 = J.set_nth(J.get(t, "history"), at, h2)
      +r = mossbell.rerun(J.items(gc.drop_front(hist1, at)), J.get(h2, "before"), J.get(t, "seed"), Nil{})
      mossbell.Table.replay.k2(r, t, at, hist1)
def mossbell.position(+hs: List<&2, J.Val>, +sample: W.W, +i: U32) -> U32:
  mossbell.position.k1(hs, hs, sample, i)

def mossbell.position.k2(cv: Bool, +sample: W.W, +i: U32, +h: J.Val, +t: List<&2, J.Val>) -> U32:
  match cv:
    case True{}:
      i
    case False{}:
      mossbell.position(t, sample, (i + 1 : U32))

def mossbell.position.k1(sv0: List<&2, J.Val>, +hs: List<&2, J.Val>, +sample: W.W, +i: U32) -> U32:
  match sv0:
    case Nil{}:
      4294967295
    case Con{+h, +t}:
      mossbell.position.k2(W.eq(W.of_j(J.get(h, "tick")), sample), sample, i, h, t)
# Replay the samples: each remembers the ball before it, then steps it.
def mossbell.rerun(+hs: List<&2, J.Val>, +ball: J.Val, +seed: J.Val, +acc: List<&2, J.Val>) -> J.Val & J.Val:
  mossbell.rerun.k1(hs, hs, ball, seed, acc)

def mossbell.rerun.k1(sv0: List<&2, J.Val>, +hs: List<&2, J.Val>, +ball: J.Val, +seed: J.Val, +acc: List<&2, J.Val>) -> J.Val & J.Val:
  match sv0:
    case Nil{}:
      (ball, J.JA{List.reverse(&2, J.Val, acc)})
    case Con{+h, +t}:
      +h2 = J.set(h, "before", ball)
      +b2 = mossbell.Ball.step(ball, J.get(h, "stroke"), J.get(h, "tune"), gc.u(h, "age"), W.of_j(seed), W.of_j(J.get(h, "tick")))
      mossbell.rerun(t, b2, seed, h2 <> acc)
# History gets this tick's sample (30 kept), then the ball steps.
def mossbell.Table.record(+t: J.Val, +stroke: J.Val, +tune: J.Val, +age: U32, +tick: W.W) -> J.Val:
  +sample = J.set(J.set(gc.su(J.set(J.obj(), "tick", W.to_j(tick)), "age", age), "before", J.get(t, "ball")), "stroke", stroke)
  +hist = J.push(J.get(t, "history"), J.set(sample, "tune", tune))
  +hist2 = gc.ifj(U32.is_gt(gc.len(J.items(hist)), rules.HZ()), _ => gc.drop_front(hist, 1), _ => hist)
  J.set(J.set(t, "history", hist2), "ball", mossbell.Ball.step(J.get(t, "ball"), stroke, tune, age, W.of_j(J.get(t, "seed")), tick))
# Table::bot_input()
def mossbell.Table.bot_input(+t: J.Val) -> J.Val:
  +b = J.get(t, "ball")
  +fire = Bool.or(U32.is_gt(gc.u(b, "save"), 0), Bool.and(RS.i_gt(gc.u(b, "vy"), 0), Bool.and(RS.i_gt(gc.u(b, "y"), (103 * 256 : U32)), Bool.and(RS.i_lt(gc.u(b, "y"), (124 * 256 : U32)), Bool.not(mossbell.key(t, 3))))))
  +up = Bool.and(RS.i_gt(gc.u(b, "y"), (127 * 256 : U32)), Bool.not(mossbell.key(t, 2)))
  gc.sb(gc.si(rules.Input.default(), "move_y", gc.pu(up, RS.i_neg(1), 0)), "fire", fire)
# Session::new(seats, seed)
def mossbell.Session.new(+seats: List<&2, U32>, +seed: J.Val) -> J.Val:
  +s0 = J.set(J.set(J.obj(), "tables", mossbell.tables(seats, seed)), "seed", seed)
  +s1 = gc.su(gc.su(s0, "started", 0), "left", mossbell.LENGTH())
  gc.snull(J.set(gc.sb(J.set(s1, "order", J.JA{Nil{}}), "key", True{}), "jackpot", J.JA{Nil{}}), "jackpot_tick")
def mossbell.tables(+seats: List<&2, U32>, +seed: J.Val) -> J.Val:
  mossbell.tables.k1(seats, seats, seed)

def mossbell.tables.k1(sv0: List<&2, U32>, +seats: List<&2, U32>, +seed: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      J.obj()
    case Con{+id, +t}:
      J.set(mossbell.tables(t, seed), gc.key(id), mossbell.Table.new(seed))
# Session::points(id), score(id) as a key
def mossbell.Session.points(+s: J.Val, +id: U32) -> U32:
  (gc.u(J.get(gc.seat(J.get(s, "tables"), id), "ball"), "score") + gc.pu(gc.has_u(id, gc.us(J.get(s, "jackpot"))), 500, 0) : U32)
def mossbell.Session.score(+s: J.Val, +id: U32) -> GcSc:
  +b = J.get(gc.seat(J.get(s, "tables"), id), "ball")
  GcSc{mossbell.Session.points(s, id), gc.u(b, "drains"), gc.ifw(J.is_null(J.get(b, "jackpot_at")), W.max_value(), W.of_j(J.get(b, "jackpot_at")))}
# a < b: more points first, then fewer drains, then the earlier jackpot
def mossbell.sc_lt(+a: GcSc, +b: GcSc) -> Bool:
  mossbell.sc_lt.k1(a, a, b)

def mossbell.sc_lt.k2(sv0: GcSc, +b: GcSc, +ap: U32, +ad: U32, +aj: W.W) -> Bool:
  match sv0:
    case GcSc{+bp, +bd, +bj}:
      Bool.or(U32.is_gt(ap, bp), Bool.and(U32.is_eq(ap, bp), Bool.or(U32.is_lt(ad, bd), Bool.and(U32.is_eq(ad, bd), W.lt(aj, bj)))))

def mossbell.sc_lt.k1(sv0: GcSc, +a: GcSc, +b: GcSc) -> Bool:
  match sv0:
    case GcSc{+ap, +ad, +aj}:
      mossbell.sc_lt.k2(b, b, ap, ad, aj)
def mossbell.sc_eq(+a: GcSc, +b: GcSc) -> Bool:
  mossbell.sc_eq.k1(a, a, b)

def mossbell.sc_eq.k2(sv0: GcSc, +b: GcSc, +ap: U32, +ad: U32, +aj: W.W) -> Bool:
  match sv0:
    case GcSc{+bp, +bd, +bj}:
      Bool.and(U32.is_eq(ap, bp), Bool.and(U32.is_eq(ad, bd), W.eq(aj, bj)))

def mossbell.sc_eq.k1(sv0: GcSc, +a: GcSc, +b: GcSc) -> Bool:
  match sv0:
    case GcSc{+ap, +ad, +aj}:
      mossbell.sc_eq.k2(b, b, ap, ad, aj)
def mossbell.Session.place(+s: J.Val, +id: U32) -> U32:
  (1 + mossbell.count_lt(s, gc.ids(J.get(s, "tables")), mossbell.Session.score(s, id)) : U32)
def mossbell.count_lt(+s: J.Val, +ids: List<&2, U32>, +me: GcSc) -> U32:
  mossbell.count_lt.k1(ids, s, ids, me)

def mossbell.count_lt.k1(sv0: List<&2, U32>, +s: J.Val, +ids: List<&2, U32>, +me: GcSc) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+r, +t}:
      (gc.pu(mossbell.sc_lt(mossbell.Session.score(s, r), me), 1, 0) + mossbell.count_lt(s, t, me) : U32)
# Session::race(): who has the earliest jackpot
def mossbell.Session.race(+s: J.Val) -> J.Val:
  +m = mossbell.min_jackpot(gc.vals(J.get(s, "tables")), J.JNull{})
  +s1 = J.set(s, "jackpot_tick", m)
  J.set(s1, "jackpot", gc.of_us(mossbell.jackpot_ids(s1, gc.ids(J.get(s1, "tables")), m)))
def mossbell.min_jackpot(+ts: List<&2, J.Val>, +best: J.Val) -> J.Val:
  mossbell.min_jackpot.k1(ts, ts, best)

def mossbell.min_jackpot.k2(cv: Bool, +best: J.Val, +rest: List<&2, J.Val>, +j: J.Val) -> J.Val:
  match cv:
    case True{}:
      mossbell.min_jackpot(rest, best)
    case False{}:
      mossbell.min_jackpot(rest, gc.ifj(Bool.or(J.is_null(best), W.lt(W.of_j(j), W.of_j(best))), _ => j, _ => best))

def mossbell.min_jackpot.k1(sv0: List<&2, J.Val>, +ts: List<&2, J.Val>, +best: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      best
    case Con{+t, +rest}:
      +j = J.get(J.get(t, "ball"), "jackpot_at")
      mossbell.min_jackpot.k2(J.is_null(j), best, rest, j)
def mossbell.jackpot_ids(+s: J.Val, +ids: List<&2, U32>, +m: J.Val) -> List<&2, U32>:
  mossbell.jackpot_ids.k1(ids, s, ids, m)

def mossbell.jackpot_ids.k1(sv0: List<&2, U32>, +s: J.Val, +ids: List<&2, U32>, +m: J.Val) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      +j = J.get(J.get(gc.seat(J.get(s, "tables"), id), "ball"), "jackpot_at")
      gc.ifx_us(Bool.and(Bool.not(J.is_null(j)), Bool.and(Bool.not(J.is_null(m)), W.eq(W.of_j(j), W.of_j(m)))), id, mossbell.jackpot_ids(s, t, m))
# Session::payout(id)
def mossbell.Session.payout(+s: J.Val, +id: U32) -> U32:
  +order = gc.us(J.get(s, "order"))
  mossbell.Session.payout.k1(order, s, id, order)

def mossbell.Session.payout.k1(sv0: List<&2, U32>, +s: J.Val, +id: U32, +order: List<&2, U32>) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+first, +t}:
      mossbell.payout.go(s, id, mossbell.Session.score(s, first))
def mossbell.payout.go(+s: J.Val, +id: U32, +top: GcSc) -> U32:
  mossbell.payout.go.k1(Bool.or(U32.is_gt(gc.u(s, "left"), 0), Bool.not(mossbell.sc_eq(mossbell.Session.score(s, id), top))), s, id, top)

def mossbell.payout.go.k1(cv: Bool, +s: J.Val, +id: U32, +top: GcSc) -> U32:
  match cv:
    case True{}:
      0
    case False{}:
      +tied = mossbell.count_eq(s, gc.ids(J.get(s, "tables")), top, 4294967295)
      +before = mossbell.count_eq(s, gc.ids(J.get(s, "tables")), top, id)
      +pot = (mossbell.GOLD_PER_SEAT() * gc.len(gc.vals(J.get(s, "tables"))) : U32)
      (U32.div(pot, tied) + gc.pu(U32.is_lt(before, U32.mod(pot, tied)), 1, 0) : U32)
def mossbell.count_eq(+s: J.Val, +ids: List<&2, U32>, +top: GcSc, +below: U32) -> U32:
  mossbell.count_eq.k1(ids, s, ids, top, below)

def mossbell.count_eq.k1(sv0: List<&2, U32>, +s: J.Val, +ids: List<&2, U32>, +top: GcSc, +below: U32) -> U32:
  match sv0:
    case Nil{}:
      0
    case Con{+r, +t}:
      (gc.pu(Bool.and(U32.is_lt(r, below), mossbell.sc_eq(mossbell.Session.score(s, r), top)), 1, 0) + mossbell.count_eq(s, t, top, below) : U32)
# fn mossbell_showing(&self)
def mossbell.Run.mossbell_showing(+run: J.Val) -> Bool:
  Bool.and(String.eq(J.str(J.get(rules.Run.room(run), "kind")), "bathhouse"), Bool.not(J.is_null(J.get(run, "mossbell"))))
# fn tick_mossbell(&mut self, inputs)
def mossbell.Run.tick_mossbell(+run: J.Val, +inputs: J.Val) -> J.Val:
  mossbell.Run.tick_mossbell.k1(Bool.not(String.eq(J.str(J.get(rules.Run.room(run), "kind")), "bathhouse")), run, inputs)

def mossbell.Run.tick_mossbell.k2(cv: Bool, +run: J.Val, +inputs: J.Val, +pressed: Bool) -> J.Val:
  match cv:
    case True{}:
      gc.ifj(pressed, _ => mossbell.Run.start_mossbell(run), _ => run)
    case False{}:
      mossbell.tick.session(J.set(run, "mossbell", J.JNull{}), inputs, J.get(run, "mossbell"))

def mossbell.Run.tick_mossbell.k1(cv: Bool, +run: J.Val, +inputs: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.set(run, "mossbell", J.JNull{})
    case False{}:
      +pressed = mossbell.pressed(run, inputs, gc.ids(inputs))
      mossbell.Run.tick_mossbell.k2(J.is_null(J.get(run, "mossbell")), run, inputs, pressed)
def mossbell.pressed(+run: J.Val, +inputs: J.Val, +ids: List<&2, U32>) -> Bool:
  mossbell.pressed.k1(ids, run, inputs, ids)

def mossbell.pressed.k1(sv0: List<&2, U32>, +run: J.Val, +inputs: J.Val, +ids: List<&2, U32>) -> Bool:
  match sv0:
    case Nil{}:
      False{}
    case Con{+id, +t}:
      +i = gc.seat(inputs, id)
      +h = gc.seat(J.get(run, "players"), id)
      +here = Bool.and(rules.Input.valid(i), Bool.and(gc.b(i, "interact"), Bool.and(Bool.not(J.is_null(h)), mossbell.at_bay(run, h, id))))
      Bool.or(here, mossbell.pressed(run, inputs, t))
def mossbell.at_bay(+run: J.Val, +h: J.Val, +id: U32) -> Bool:
  Bool.and(U32.is_gt(gc.u(h, "hp"), 0), Bool.and(Bool.not(gc.b(h, "stone")), Bool.and(Bool.not(gc.b(h, "away")), Bool.and(Bool.not(gc.has_seat(J.get(J.get(run, "exits"), "outside"), id)), F32.is_lt(RS.f_hypot((gc.f(h, "x") - mossbell.BAY.x() : F32), (gc.f(h, "y") - mossbell.BAY.y() : F32)), 3.0)))))
def mossbell.tick.session(+run: J.Val, +inputs: J.Val, +s0: J.Val) -> J.Val:
  +tables = latch.keep_duels(run, J.get(s0, "tables"), gc.ids(J.get(s0, "tables")))
  +order = latch.keep_order(tables, gc.us(J.get(s0, "order")))
  +s = mossbell.Session.race(J.set(J.set(s0, "tables", tables), "order", gc.of_us(order)))
  mossbell.tick.session.k1(U32.is_zero(gc.len(gc.vals(tables))), run, inputs, tables, s)

def mossbell.tick.session.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +tables: J.Val, +s: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      mossbell.tick.live(run, inputs, s)
def mossbell.tick.live(+run: J.Val, +inputs: J.Val, +s: J.Val) -> J.Val:
  mossbell.tick.live.k1(U32.is_zero(gc.u(s, "left")), run, inputs, s)

def mossbell.tick.live.k2(cv: Bool, +run: J.Val, +s: J.Val, +take: Bool) -> J.Val:
  match cv:
    case True{}:
      mossbell.Run.start_mossbell(run)
    case False{}:
      J.set(run, "mossbell", gc.sb(s, "key", take))

def mossbell.tick.live.k4(cv: Bool, +s3: J.Val, +run3: J.Val) -> J.Val:
  match cv:
    case True{}:
      mossbell.tick.payout(run3, s3)
    case False{}:
      J.set(run3, "mossbell", s3)

def mossbell.tick.live.k3(pr: J.Val & J.Val, +s1: J.Val) -> J.Val:
  (+run2, +s2) = pr
  +s3 = mossbell.Session.race(s2)
  +run3 = gc.ifj(Bool.not(J.eq(J.get(s3, "jackpot"), J.get(s1, "jackpot"))), _ => gc.sound(run2, "spoil_pickup"), _ => run2)
  mossbell.tick.live.k4(U32.is_zero(gc.u(s3, "left")), s3, run3)

def mossbell.tick.live.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +s: J.Val) -> J.Val:
  match cv:
    case True{}:
      +take = latch.any_interact(J.get(s, "tables"), inputs, gc.ids(inputs))
      mossbell.tick.live.k2(Bool.and(take, Bool.not(gc.b(s, "key"))), run, s, take)
    case False{}:
      +age = (mossbell.LENGTH() - gc.u(s, "left") : U32)
      +s1 = gc.su(s, "left", (gc.u(s, "left") - 1 : U32))
      +r = mossbell.tick.tables(run, inputs, s1, age, gc.ids(J.get(s1, "tables")))
      mossbell.tick.live.k3(r, s1)
def mossbell.tick.tables(+run: J.Val, +inputs: J.Val, +s: J.Val, +age: U32, +ids: List<&2, U32>) -> J.Val & J.Val:
  mossbell.tick.tables.k1(ids, run, inputs, s, age, ids)

def mossbell.tick.tables.k2(cv: Bool, +run: J.Val, +inputs: J.Val, +s: J.Val, +age: U32, +id: U32, +t: List<&2, U32>, +h: J.Val) -> J.Val & J.Val:
  match cv:
    case True{}:
      mossbell.tick.tables(run, inputs, s, age, t)
    case False{}:
      +table = gc.seat(J.get(s, "tables"), id)
      +old = J.get(table, "ball")
      +t2 = mossbell.Table.step(table, gc.seat(inputs, id), J.get(run, "tune"), age, gc.tick(run), W.of_j(J.get(J.get(run, "latch_input_age"), gc.key(id))))
      +nb = J.get(t2, "ball")
      +r1 = gc.ifj(U32.is_gt(gc.u(nb, "score"), gc.u(old, "score")), _ => gc.sound(run, gc.ps(U32.is_lt(gc.u(nb, "hp"), gc.u(old, "hp")), "hit", "clang")), _ => run)
      +r2 = gc.ifj(U32.is_gt(gc.u(nb, "drains"), gc.u(old, "drains")), _ => gc.sound(r1, "play_card"), _ => r1)
      mossbell.tick.tables(r2, inputs, J.set(s, "tables", gc.put_seat(J.get(s, "tables"), id, t2)), age, t)

def mossbell.tick.tables.k1(sv0: List<&2, U32>, +run: J.Val, +inputs: J.Val, +s: J.Val, +age: U32, +ids: List<&2, U32>) -> J.Val & J.Val:
  match sv0:
    case Nil{}:
      (run, s)
    case Con{+id, +t}:
      +h = gc.seat(J.get(run, "players"), id)
      mossbell.tick.tables.k2(Bool.or(J.is_null(h), Bool.or(gc.b(h, "away"), gc.b(h, "stone"))), run, inputs, s, age, id, t, h)
# The match is over: order, record, purses.
def mossbell.tick.payout(+run: J.Val, +s: J.Val) -> J.Val:
  +order = mossbell.sort_ids(gc.ids(J.get(s, "tables")), s)
  +s1 = gc.sb(J.set(s, "order", gc.of_us(order)), "key", True{})
  +rec = J.get(J.get(J.get(J.get(run, "home"), "countryside"), "games"), "mossbell")
  +top = gc.umin(gc.u(J.get(gc.seat(J.get(s1, "tables"), gc.nth_u(order, 0)), "ball"), "score"), 1000)
  +rec1 = gc.su(rec, "best", gc.umax(gc.u(rec, "best"), top))
  +rec2 = gc.ifj(U32.is_gt(gc.len(J.items(J.get(s1, "jackpot"))), 0), _ => gc.su(rec1, "wins", gc.umin(gc.sadd(gc.u(rec1, "wins"), 1), gc.u(rec1, "plays"))), _ => rec1)
  +r1 = mossbell.set_record(run, rec2)
  +r2 = J.set(r1, "players", mossbell.pay_players(J.get(r1, "players"), s1, gc.ids(J.get(r1, "players"))))
  J.set(gc.sound(r2, "spoil_pickup"), "mossbell", s1)
def mossbell.sort_ids(+ids: List<&2, U32>, +s: J.Val) -> List<&2, U32>:
  mossbell.sort_ids.k1(ids, ids, s)

def mossbell.sort_ids.k1(sv0: List<&2, U32>, +ids: List<&2, U32>, +s: J.Val) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      Nil{}
    case Con{+id, +t}:
      mossbell.insert_id(id, mossbell.sort_ids(t, s), s)
def mossbell.insert_id(+id: U32, +sorted: List<&2, U32>, +s: J.Val) -> List<&2, U32>:
  mossbell.insert_id.k1(sorted, id, sorted, s)

def mossbell.insert_id.k2(cv: Bool, +id: U32, +s: J.Val, +h: U32, +t: List<&2, U32>, +a: GcSc, +b: GcSc) -> List<&2, U32>:
  match cv:
    case True{}:
      id <> (h <> t)
    case False{}:
      h <> mossbell.insert_id(id, t, s)

def mossbell.insert_id.k1(sv0: List<&2, U32>, +id: U32, +sorted: List<&2, U32>, +s: J.Val) -> List<&2, U32>:
  match sv0:
    case Nil{}:
      [id]
    case Con{+h, +t}:
      +a = mossbell.Session.score(s, id)
      +b = mossbell.Session.score(s, h)
      mossbell.insert_id.k2(Bool.or(mossbell.sc_lt(a, b), Bool.and(mossbell.sc_eq(a, b), U32.is_lt(id, h))), id, s, h, t, a, b)
def mossbell.set_record(+run: J.Val, +rec: J.Val) -> J.Val:
  +home = J.get(run, "home")
  +cs = J.get(home, "countryside")
  +games = gc.score_put(J.get(cs, "games"), "mossbell", rec)
  J.set(run, "home", J.set(home, "countryside", J.set(cs, "games", games)))
def mossbell.pay_players(+players: J.Val, +s: J.Val, +ids: List<&2, U32>) -> J.Val:
  mossbell.pay_players.k1(ids, players, s, ids)

def mossbell.pay_players.k2(cv: Bool, +players: J.Val, +s: J.Val, +id: U32, +t: List<&2, U32>, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      +laurel = U32.is_eq(mossbell.Session.place(s, id), 1)
      +h1 = gc.sb(h, "laurel", laurel)
      +h2 = J.set(h1, "carried", realm.Spoils.add(J.get(h1, "carried"), "gold", mossbell.Session.payout(s, id)))
      mossbell.pay_players(gc.put_seat(players, id, gc.ifj(laurel, _ => gc.snull(h2, "booby"), _ => h2)), s, t)
    case False{}:
      mossbell.pay_players(players, s, t)

def mossbell.pay_players.k1(sv0: List<&2, U32>, +players: J.Val, +s: J.Val, +ids: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      players
    case Con{+id, +t}:
      +h = gc.seat(players, id)
      mossbell.pay_players.k2(gc.has_seat(J.get(s, "tables"), id), players, s, id, t, h)
# fn start_mossbell(&mut self)
def mossbell.Run.start_mossbell(+run: J.Val) -> J.Val:
  +r = loot.Rng.next(W.of_j(J.get(run, "rng")))
  mossbell.Run.start_mossbell.k1(r, run)

def mossbell.Run.start_mossbell.k2(cv: Bool, +r1: J.Val, +s1: J.Val) -> J.Val:
  match cv:
    case True{}:
      r1
    case False{}:
      +rec = J.get(J.get(J.get(J.get(r1, "home"), "countryside"), "games"), "mossbell")
      +r2 = mossbell.set_record(J.set(r1, "mossbell", s1), gc.su(rec, "plays", gc.sadd(gc.u(rec, "plays"), 1)))
      gc.sound(r2, "play_card")

def mossbell.Run.start_mossbell.k1(pr: W.W & W.W, +run: J.Val) -> J.Val:
  (+rng, +seed) = pr
  +r1 = J.set(run, "rng", W.to_j(rng))
  +s = gc.su(mossbell.Session.new(latch.seats(r1, gc.ids(J.get(r1, "players"))), W.to_j(seed)), "started", 0)
  +s1 = J.set(s, "started", W.to_j(W.add_u32(gc.tick(r1), 1)))
  mossbell.Run.start_mossbell.k2(U32.is_zero(gc.len(gc.vals(J.get(s1, "tables")))), r1, s1)
