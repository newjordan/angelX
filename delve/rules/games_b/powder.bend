      J.set(c1, "burned", J.push(J.get(c1, "burned"), gb.su(gb.su(J.obj(), "t", t), "owner", gb.u(kg, "owner"))))
    case False{}:
      pastimes.powder.arm.at.k3(pastimes.powder.at_tile(J.items(J.get(p, "kegs")), c, r), kg, reach, d, step, c, r, p, c1)

def pastimes.powder.arm.at.k1(cv: Bool, +kg: J.Val, +reach: U32, +d: U32, +step: U32, +c: U32, +r: U32, +p: J.Val, +t: U32, +c1: J.Val) -> J.Val:
  match cv:
    case True{}:
      c1
    case False{}:
      pastimes.powder.arm.at.k2(pastimes.powder.has_tile(J.items(J.get(p, "bales")), t), kg, reach, d, step, c, r, p, t, c1)
# The first keg at a tile burns down to 1.
def pastimes.powder.shorten(+ks: List<&2, J.Val>, +c: U32, +r: U32) -> List<&2, J.Val>:
  match ks:
    case Nil{}:
      []
    case Con{+k, +t}:
      pastimes.powder.shorten.k1(Bool.and(U32.is_eq(gb.u(k, "col"), c), U32.is_eq(gb.u(k, "row"), r)), c, r, k, t)

def pastimes.powder.shorten.k1(cv: Bool, +c: U32, +r: U32, +k: J.Val, +t: List<&2, J.Val>) -> List<&2, J.Val>:
  match cv:
    case True{}:
      gb.su(k, "left", U32.min(gb.u(k, "left"), 1)) <> t
    case False{}:
      k <> pastimes.powder.shorten(t, c, r)
# This keg's flames laid on the yard, each with a scorch under it unless one is there.
def pastimes.powder.lay(+ctx: J.Val, +arms: List<&2, J.Val>) -> J.Val:
  match arms:
    case Nil{}:
      ctx
    case Con{+f, +t}:
      +p = J.get(ctx, "p")
      +sc = Bool.pick(J.Val, pastimes.powder.at_tile(J.items(J.get(p, "scorch")), gb.u(f, "col"), gb.u(f, "row")), J.get(p, "scorch"), J.push(J.get(p, "scorch"), gb.su(gb.su(gb.su(J.obj(), "col", gb.u(f, "col")), "row", gb.u(f, "row")), "left", 200)))
      +p1 = J.set(J.set(p, "scorch", sc), "flames", J.push(J.get(p, "flames"), f))
      pastimes.powder.lay(J.set(ctx, "p", p1), t)
# Powder::drops: the bales that give up a charm when burned.
def pastimes.powder.drops(+bales: List<&2, J.Val>, +seed: U32, +i: U32) -> List<&2, J.Val>:
  match bales:
    case Nil{}:
      []
    case Con{+t, +rest}:
      pastimes.powder.drops.k1(U32.is_eq(U32.mod((i + seed : U32), 3), 1), seed, i, t, rest)

def pastimes.powder.drops.k1(cv: Bool, +seed: U32, +i: U32, +t: J.Val, +rest: List<&2, J.Val>) -> List<&2, J.Val>:
  match cv:
    case True{}:
      t <> pastimes.powder.drops(rest, seed, (i + 1 : U32))
    case False{}:
      pastimes.powder.drops(rest, seed, (i + 1 : U32))
# The burned bales leave: each counts for its keg's owner, some leave a charm.
def pastimes.powder.burn(+p: J.Val, +burned: List<&2, J.Val>, +drops: List<&2, J.Val>) -> J.Val:
  match burned:
    case Nil{}:
      p
    case Con{+b, +t}:
      +tile = gb.u(b, "t")
      +owner = U32.show(gb.u(b, "owner"))
      +p1 = J.set(p, "bales", J.JA{pastimes.powder.without(J.items(J.get(p, "bales")), tile)})
      +p2 = J.set(p1, "burned", J.set(J.get(p1, "burned"), owner, J.JU{(gb.u(J.get(p1, "burned"), owner) + 1 : U32)}))
      +p3 = Bool.pick(J.Val, pastimes.powder.has_tile(drops, tile), J.set(p2, "charms", J.push(J.get(p2, "charms"), gb.su(gb.su(gb.su(J.obj(), "col", U32.mod(tile, 11)), "row", U32.div(tile, 11)), "kind", U32.mod(U32.div(tile, 7), 3)))), p2)
      pastimes.powder.burn(p3, t, drops)
def pastimes.powder.without(+xs: List<&2, J.Val>, +t: U32) -> List<&2, J.Val>:
  match xs:
    case Nil{}:
      []
    case Con{+h, +rest}:
      pastimes.powder.without.k1(U32.is_eq(J.u32(h), t), t, h, rest)

def pastimes.powder.without.k1(cv: Bool, +t: U32, +h: J.Val, +rest: List<&2, J.Val>) -> List<&2, J.Val>:
  match cv:
    case True{}:
      pastimes.powder.without(rest, t)
    case False{}:
      h <> pastimes.powder.without(rest, t)
# The ids of the living knights standing in fresh fire.
def pastimes.powder.caught(+p: J.Val, +ks: List<&2, J.Val>) -> List<&2, U32>:
  match ks:
    case Nil{}:
      []
    case Con{+k, +t}:
      pastimes.powder.caught.k1(Bool.and(gb.b(k, "alive"), pastimes.powder.fresh_at(J.items(J.get(p, "flames")), pastimes.powder.tile_c(gb.u(k, "x")), pastimes.powder.tile_r(gb.u(k, "y")))), p, k, t)

def pastimes.powder.caught.k1(cv: Bool, +p: J.Val, +k: J.Val, +t: List<&2, J.Val>) -> List<&2, U32>:
  match cv:
    case True{}:
      gb.u(k, "id") <> pastimes.powder.caught(p, t)
    case False{}:
      pastimes.powder.caught(p, t)
# The living knights standing on a charm: [{id, i}] by the charm's place in
# the list at that moment.
def pastimes.powder.takes(+p: J.Val, +ks: List<&2, J.Val>) -> List<&2, J.Val>:
  match ks:
    case Nil{}:
      []
    case Con{+k, +t}:
      +i = pastimes.powder.charm_at(J.items(J.get(p, "charms")), pastimes.powder.tile_c(gb.u(k, "x")), pastimes.powder.tile_r(gb.u(k, "y")), 0)
      pastimes.powder.takes.k1(Bool.and(gb.b(k, "alive"), U32.is_lt(i, 1000)), p, k, t, i)

def pastimes.powder.takes.k1(cv: Bool, +p: J.Val, +k: J.Val, +t: List<&2, J.Val>, +i: U32) -> List<&2, J.Val>:
  match cv:
    case True{}:
      gb.su(gb.su(J.obj(), "id", gb.u(k, "id")), "i", i) <> pastimes.powder.takes(p, t)
    case False{}:
      pastimes.powder.takes(p, t)
def pastimes.powder.charm_at(+cs: List<&2, J.Val>, +c: U32, +r: U32, +i: U32) -> U32:
  match cs:
    case Nil{}:
      1000
    case Con{+h, +t}:
      pastimes.powder.charm_at.k1(Bool.and(U32.is_eq(gb.u(h, "col"), c), U32.is_eq(gb.u(h, "row"), r)), c, r, i, h, t)

def pastimes.powder.charm_at.k1(cv: Bool, +c: U32, +r: U32, +i: U32, +h: J.Val, +t: List<&2, J.Val>) -> U32:
  match cv:
    case True{}:
      i
    case False{}:
      pastimes.powder.charm_at(t, c, r, (i + 1 : U32))
def pastimes.powder.soot(+ks: List<&2, J.Val>, +ids: List<&2, U32>) -> List<&2, J.Val>:
  match ks:
    case Nil{}:
      []
    case Con{+k, +t}:
      pastimes.powder.soot.k1(pastimes.powder.has_id(ids, gb.u(k, "id")), ids, k, t)

def pastimes.powder.soot.k1(cv: Bool, +ids: List<&2, U32>, +k: J.Val, +t: List<&2, J.Val>) -> List<&2, J.Val>:
  match cv:
    case True{}:
      gb.su(gb.sb(k, "alive", False{}), "soot", 30) <> pastimes.powder.soot(t, ids)
    case False{}:
      k <> pastimes.powder.soot(t, ids)
def pastimes.powder.nth_remove(+xs: List<&2, J.Val>, +i: U32) -> J.Val & List<&2, J.Val>:
  match xs:
    case Nil{}:
      (J.JNull{}, [])
    case Con{+h, +t}:
      pastimes.powder.nth_remove.k1(U32.is_eq(i, 0), i, h, t)

def pastimes.powder.nth_remove.k2(pr: J.Val & List<&2, J.Val>, +h: J.Val) -> J.Val & List<&2, J.Val>:
  (+x, +rest) = pr
  (x, h <> rest)

def pastimes.powder.nth_remove.k1(cv: Bool, +i: U32, +h: J.Val, +t: List<&2, J.Val>) -> J.Val & List<&2, J.Val>:
  match cv:
    case True{}:
      (h, t)
    case False{}:
      pastimes.powder.nth_remove.k2(pastimes.powder.nth_remove(t, (i - 1 : U32)), h)
# The takes in reverse order: each charm leaves the yard and does its work.
def pastimes.powder.take(+p: J.Val, +takes: List<&2, J.Val>, +picked: List<&2, U32>) -> J.Val & List<&2, U32>:
  match takes:
    case Nil{}:
      (p, picked)
    case Con{+tk, +t}:
      pastimes.powder.take.k1(pastimes.powder.take(p, t, picked), tk)

def pastimes.powder.take.k4(cv: Bool, +picked1: List<&2, U32>, +charm: J.Val, +p2: J.Val, +id: U32, +k: J.Val) -> J.Val & List<&2, U32>:
  match cv:
    case True{}:
      (p2, picked1)
    case False{}:
      (J.set(p2, "knights", J.JA{pastimes.powder.charmed(J.items(J.get(p2, "knights")), id, gb.u(charm, "kind"))}), List.append(&2, U32, picked1, [id]))

def pastimes.powder.take.k3(cv: Bool, +tk: J.Val, +p1: J.Val, +picked1: List<&2, U32>, +charm: J.Val, +left: List<&2, J.Val>) -> J.Val & List<&2, U32>:
  match cv:
    case True{}:
      (p1, picked1)
    case False{}:
      +p2 = J.set(p1, "charms", J.JA{left})
      +id = gb.u(tk, "id")
      +k = pastimes.find_by(J.items(J.get(p2, "knights")), "id", id)
      pastimes.powder.take.k4(J.is_null(k), picked1, charm, p2, id, k)

def pastimes.powder.take.k2(pr: J.Val & List<&2, J.Val>, +tk: J.Val, +p1: J.Val, +picked1: List<&2, U32>) -> J.Val & List<&2, U32>:
  (+charm, +left) = pr
  pastimes.powder.take.k3(J.is_null(charm), tk, p1, picked1, charm, left)

def pastimes.powder.take.k1(pr: J.Val & List<&2, U32>, +tk: J.Val) -> J.Val & List<&2, U32>:
  (+p1, +picked1) = pr
  pastimes.powder.take.k2(pastimes.powder.nth_remove(J.items(J.get(p1, "charms")), gb.u(tk, "i")), tk, p1, picked1)
def pastimes.powder.charmed(+ks: List<&2, J.Val>, +id: U32, +kind: U32) -> List<&2, J.Val>:
  match ks:
    case Nil{}:
      []
    case Con{+k, +t}:
      pastimes.powder.charmed.k1(U32.is_eq(gb.u(k, "id"), id), id, kind, k, t)

def pastimes.powder.charmed.k1(cv: Bool, +id: U32, +kind: U32, +k: J.Val, +t: List<&2, J.Val>) -> List<&2, J.Val>:
  match cv:
    case True{}:
      pastimes.powder.charm_apply(k, kind) <> t
    case False{}:
      k <> pastimes.powder.charmed(t, id, kind)
def pastimes.powder.charm_apply(+k: J.Val, +kind: U32) -> J.Val:
  pastimes.powder.charm_apply.k1(U32.is_eq(kind, 0), k, kind)

def pastimes.powder.charm_apply.k2(cv: Bool, +k: J.Val, +kind: U32) -> J.Val:
  match cv:
    case True{}:
      gb.sb(k, "boots", True{})
    case False{}:
      gb.su(gb.sb(k, "spare", True{}), "stock", 12)

def pastimes.powder.charm_apply.k1(cv: Bool, +k: J.Val, +kind: U32) -> J.Val:
  match cv:
    case True{}:
      gb.su(k, "blast", 6)
    case False{}:
      pastimes.powder.charm_apply.k2(U32.is_eq(kind, 1), k, kind)
# Flames and scorch burn down; the shockwave and the chain flash fade.
def pastimes.powder.age(+xs: List<&2, J.Val>) -> List<&2, J.Val>:
  match xs:
    case Nil{}:
      []
    case Con{+f, +t}:
      +left = (gb.u(f, "left") - 1 : U32)
      pastimes.powder.age.k1(U32.is_gt(left, 0), f, t, left)

def pastimes.powder.age.k1(cv: Bool, +f: J.Val, +t: List<&2, J.Val>, +left: U32) -> List<&2, J.Val>:
  match cv:
    case True{}:
      gb.su(f, "left", left) <> pastimes.powder.age(t)
    case False{}:
      pastimes.powder.age(t)
def pastimes.powder.fade(+p: J.Val) -> J.Val:
  +p1 = gb.su(J.set(J.set(p, "flames", J.JA{pastimes.powder.age(J.items(J.get(p, "flames")))}), "scorch", J.JA{pastimes.powder.age(J.items(J.get(p, "scorch")))}), "chain_shockwave", gb.ssub(gb.u(p, "chain_shockwave"), 1))
  +cf = J.get(p1, "chain_flash")
  pastimes.powder.fade.k1(J.is_null(cf), p1, cf)

def pastimes.powder.fade.k2(cv: Bool, +p1: J.Val, +cf: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.set(p1, "chain_flash", gb.as(cf, 0, (gb.ag(cf, 0) - 1 : U32)))
    case False{}:
      J.set(p1, "chain_flash", J.JNull{})

def pastimes.powder.fade.k1(cv: Bool, +p1: J.Val, +cf: J.Val) -> J.Val:
  match cv:
    case True{}:
      p1
    case False{}:
      pastimes.powder.fade.k2(U32.is_gt(gb.ag(cf, 0), 0), p1, cf)
# Powder::step -> (yard, (sooted ids, (burned, (boom, picked ids)))).
def pastimes.powder.Powder.step(+p: J.Val, +inputs: J.Val, +tapped: List<&2, U32>) -> J.Val & (List<&2, U32> & (Bool & (Bool & List<&2, U32>))):
  +ks = J.items(J.get(p, "knights"))
  pastimes.powder.Powder.step.k1(pastimes.powder.plan(p, inputs, tapped, ks, pastimes.powder.count_alive(ks), [], []), p, ks)

def pastimes.powder.Powder.step.k3(pr: J.Val & List<&2, U32>, +boom: Bool, +burned: List<&2, J.Val>, +sooted: List<&2, U32>) -> J.Val & (List<&2, U32> & (Bool & (Bool & List<&2, U32>))):
  (+p8, +picked) = pr
  (pastimes.powder.fade(p8), (sooted, (Bool.not(List.is_empty(&2, J.Val, burned)), (boom, picked))))

def pastimes.powder.Powder.step.k2(pr: List<&2, J.Val> & List<&2, J.Val>, +drops: List<&2, J.Val>, +p3: J.Val) -> J.Val & (List<&2, U32> & (Bool & (Bool & List<&2, U32>))):
  (+live, +boomed) = pr
  +p4 = J.set(p3, "kegs", J.JA{live})
  +boom = Bool.or(Bool.not(List.is_empty(&2, J.Val, drops)), Bool.not(List.is_empty(&2, J.Val, boomed)))
  +ctx = pastimes.powder.blasts(J.set(J.set(J.set(J.set(J.obj(), "p", p4), "arms", J.JA{[]}), "burned", J.JA{[]}), "chain", J.JNull{}), boomed)
  +p5 = pastimes.powder.chain(J.get(ctx, "p"), J.get(ctx, "chain"))
  +burned = J.items(J.get(ctx, "burned"))
  +p6 = Bool.pick(J.Val, List.is_empty(&2, J.Val, burned), p5, pastimes.powder.burn(p5, burned, pastimes.powder.drops(J.items(J.get(p5, "bales")), gb.u(p5, "seed"), 0)))
  +ks6 = J.items(J.get(p6, "knights"))
  +sooted = pastimes.powder.caught(p6, ks6)
  +takes = pastimes.powder.takes(p6, ks6)
  +p7 = J.set(p6, "knights", J.JA{pastimes.powder.soot(ks6, sooted)})
  pastimes.powder.Powder.step.k3(pastimes.powder.take(p7, takes, []), boom, burned, sooted)

def pastimes.powder.Powder.step.k1(pr: List<&2, J.Val> & List<&2, J.Val>, +p: J.Val, +ks: List<&2, J.Val>) -> J.Val & (List<&2, U32> & (Bool & (Bool & List<&2, U32>))):
  (+moves, +drops) = pr
  +p1 = J.set(p, "knights", J.JA{pastimes.powder.apply_moves(ks, moves)})
  +p2 = pastimes.powder.apply_drops(p1, drops)
  +p3 = J.set(p2, "knights", J.JA{pastimes.powder.soot_down(J.items(J.get(p2, "knights")))})
  pastimes.powder.Powder.step.k2(pastimes.powder.fuse(J.items(J.get(p3, "kegs"))), drops, p3)
def pastimes.powder.chain(+p: J.Val, +pair: J.Val) -> J.Val:
  pastimes.powder.chain.k1(J.is_null(pair), p, pair)

def pastimes.powder.chain.k1(cv: Bool, +p: J.Val, +pair: J.Val) -> J.Val:
  match cv:
    case True{}:
      p
    case False{}:
      J.set(gb.su(p, "chain_shockwave", 6), "chain_flash", J.JA{[J.JU{6}, J.nth(pair, 0), J.nth(pair, 1), J.nth(pair, 2), J.nth(pair, 3)]})
def pastimes.powder.PX0() -> F32:
  6.0
def pastimes.powder.PY0() -> F32:
  2.0
# Run::tick_kegs
def pastimes.powder.Run.tick_kegs(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  +p = J.get(round, "powder")
  pastimes.powder.Run.tick_kegs.k1(J.is_null(p), run, round, inputs, elig, tapped, p)

def pastimes.powder.Run.tick_kegs.k2(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +tapped: List<&2, U32>, +p: J.Val, +owner: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run, 0, "The sappers left. Kegs parked."), (round, False{}))
    case False{}:
      pastimes.powder.tick(run, round, p, inputs, tapped, gb.u(owner, "id"))

def pastimes.powder.Run.tick_kegs.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +p: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (run, (round, False{}))
    case False{}:
      +owner = pastimes.powder.owner(J.items(J.get(p, "knights")), elig)
      pastimes.powder.Run.tick_kegs.k2(J.is_null(owner), run, round, inputs, tapped, p, owner)
# The first living knight in the elig list's seats, else the first seated.
def pastimes.powder.owner(+ks: List<&2, J.Val>, +elig: List<&2, J.Val>) -> J.Val:
  +alive = pastimes.powder.owner.pick(ks, elig, True{})
  Bool.pick(J.Val, J.is_null(alive), pastimes.powder.owner.pick(ks, elig, False{}), alive)
def pastimes.powder.owner.pick(+ks: List<&2, J.Val>, +elig: List<&2, J.Val>, +need_alive: Bool) -> J.Val:
  match ks:
    case Nil{}:
      J.JNull{}
    case Con{+k, +t}:
      pastimes.powder.owner.pick.k1(Bool.and(pastimes.has_el(elig, gb.u(k, "id")), Bool.or(Bool.not(need_alive), gb.b(k, "alive"))), elig, need_alive, k, t)

def pastimes.powder.owner.pick.k1(cv: Bool, +elig: List<&2, J.Val>, +need_alive: Bool, +k: J.Val, +t: List<&2, J.Val>) -> J.Val:
  match cv:
    case True{}:
      k
    case False{}:
      pastimes.powder.owner.pick(t, elig, need_alive)
def pastimes.powder.tick(+run: J.Val, +round: J.Val, +p: J.Val, +inputs: J.Val, +tapped: List<&2, U32>, +owner: U32) -> J.Val & (J.Val & Bool):
  +prev_kegs = J.len(J.get(p, "kegs"))
  pastimes.powder.tick.k1(pastimes.powder.Powder.step(p, inputs, tapped), run, round, owner, prev_kegs)

def pastimes.powder.tick.k5(cv: Bool, +owner: U32, +p1: J.Val, +run7: J.Val, +empty: Bool, +r4: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run7, owner, "Out of kegs!"), (r4, False{}))
    case False{}:
      (run7, (r4, pastimes.powder.has_id(pastimes.powder.Powder.alive(p1), owner)))

def pastimes.powder.tick.k4(pr: Bool & List<&2, U32>, +run: J.Val, +round: J.Val, +owner: U32, +prev_kegs: U32, +p1: J.Val, +sooted: List<&2, U32>, +burned: Bool) -> J.Val & (J.Val & Bool):
  (+boom, +picked) = pr
  +run1 = J.set(run, "players", pastimes.powder.seat(J.items(J.get(p1, "knights")), J.get(run, "players"), 0))
  +run2 = Bool.pick(J.Val, U32.is_gt(J.len(J.get(p1, "kegs")), prev_kegs), gb.sound(run1, "bomb_toss"), run1)
  +run3 = Bool.pick(J.Val, boom, gb.sound(run2, "bomb"), run2)
  +shock = U32.is_gt(gb.u(p1, "chain_shockwave"), 0)
  +run4 = Bool.pick(J.Val, shock, gb.sound(J.set(run3, "shake", J.JU{U32.max(gb.u(run3, "shake"), 8)}), "boss_roar"), run3)
  +run5 = Bool.pick(J.Val, burned, gb.sound(run4, "vent_fire"), run4)
  +run6 = pastimes.powder.picks(run5, picked)
  +prev = gb.u(round, "progress")
  +progress = U32.min(gb.u(J.get(p1, "burned"), U32.show(owner)), 8)
  +r1 = gb.su(round, "progress", progress)
  +r2 = Bool.pick(J.Val, U32.is_gt(progress, prev), pastimes.popup(r1, "BURN!", 12, 5), r1)
  +run7 = pastimes.powder.sooted(run6, sooted, owner)
  +heat = J.get(pastimes.ps(run7), "heat")
  +last = Bool.and(Bool.and(Bool.not(J.is_null(heat)), String.eq(gb.s(heat, "game"), "powder")), Bool.and(U32.is_gt(J.len(J.get(heat, "seats")), 1), U32.is_eq((gb.field_len(J.get(heat, "done")) + 1 : U32), J.len(J.get(heat, "seats")))))
  +r3 = Bool.pick(J.Val, last, gb.su(r2, "progress", U32.max(gb.u(r2, "progress"), 8)), r2)
  +me = pastimes.find_by(J.items(J.get(p1, "knights")), "id", owner)
  +stock_left = Bool.pick(U32, J.is_null(me), 0, gb.u(me, "stock"))
  +empty = Bool.and(Bool.and(U32.is_eq(stock_left, 0), U32.is_eq(J.len(J.get(p1, "kegs")), 0)), Bool.and(U32.is_gt(J.len(J.get(p1, "bales")), 12), U32.is_le(U32.from_nat(List.length(&2, U32, pastimes.powder.Powder.alive(p1))), 1)))
  +r4 = J.set(r3, "powder", p1)
  pastimes.powder.tick.k5(empty, owner, p1, run7, empty, r4)

def pastimes.powder.tick.k3(pr: Bool & Bool & List<&2, U32>, +run: J.Val, +round: J.Val, +owner: U32, +prev_kegs: U32, +p1: J.Val, +sooted: List<&2, U32>) -> J.Val & (J.Val & Bool):
  (+burned, +rest3) = pr
  pastimes.powder.tick.k4(rest3, run, round, owner, prev_kegs, p1, sooted, burned)

def pastimes.powder.tick.k2(pr: List<&2, U32> & Bool & (Bool & List<&2, U32>), +run: J.Val, +round: J.Val, +owner: U32, +prev_kegs: U32, +p1: J.Val) -> J.Val & (J.Val & Bool):
  (+sooted, +rest2) = pr
  pastimes.powder.tick.k3(rest2, run, round, owner, prev_kegs, p1, sooted)

def pastimes.powder.tick.k1(pr: J.Val & List<&2, U32> & (Bool & (Bool & List<&2, U32>)), +run: J.Val, +round: J.Val, +owner: U32, +prev_kegs: U32) -> J.Val & (J.Val & Bool):
  (+p1, +rest) = pr
  pastimes.powder.tick.k2(rest, run, round, owner, prev_kegs, p1)
# Each knight's hero put in the yard (or on the bench once sooted).
def pastimes.powder.seat(+ks: List<&2, J.Val>, +players: J.Val, +i: U32) -> J.Val:
  match ks:
    case Nil{}:
      players
    case Con{+k, +t}:
      +id = U32.show(gb.u(k, "id"))
      +h = J.get(players, id)
      pastimes.powder.seat.k1(J.is_null(h), players, i, k, t, id, h)

def pastimes.powder.seat.k1(cv: Bool, +players: J.Val, +i: U32, +k: J.Val, +t: List<&2, J.Val>, +id: String, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.powder.seat(t, players, (i + 1 : U32))
    case False{}:
      +x = Bool.pick(F32, gb.b(k, "alive"), ((6.0 + (RS.u_as_f32(gb.u(k, "x")) / 256.0 : F32) : F32) * 2.0 : F32), (2.5 * 2.0 : F32))
      +y = Bool.pick(F32, gb.b(k, "alive"), (((2.0 + (RS.u_as_f32(gb.u(k, "y")) / 256.0 : F32) : F32) + 0.3 : F32) * 2.0 : F32), ((7.0 + (1.1 * RS.u_as_f32(i) : F32) : F32) * 2.0 : F32))
      pastimes.powder.seat(t, J.set(players, id, gb.sf(gb.sf(h, "x", x), "y", y)), (i + 1 : U32))
def pastimes.powder.picks(+run: J.Val, +picked: List<&2, U32>) -> J.Val:
  match picked:
    case Nil{}:
      run
    case Con{+id, +t}:
      pastimes.powder.picks(gb.sound(run, "spoil_pickup"), t)
def pastimes.powder.sooted(+run: J.Val, +ids: List<&2, U32>, +owner: U32) -> J.Val:
  pastimes.powder.sooted.k1(List.is_empty(&2, U32, ids), run, ids, owner)

def pastimes.powder.sooted.k1(cv: Bool, +run: J.Val, +ids: List<&2, U32>, +owner: U32) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +who = Bool.pick(String, pastimes.powder.has_id(ids, owner), "Knight " ++ U32.show(owner), "a friend (" ++ pastimes.powder.join(ids) ++ ")")
      gb.found(gb.sound(run, "hit_blast"), 0, "Sooted! " ++ who ++ " out of this heat.")
def pastimes.powder.join(+ids: List<&2, U32>) -> String:
  match ids:
    case Nil{}:
      ""
    case Con{+id, +t}:
      pastimes.powder.join.k1(List.is_empty(&2, U32, t), id, t)

def pastimes.powder.join.k1(cv: Bool, +id: U32, +t: List<&2, U32>) -> String:
  match cv:
    case True{}:
      U32.show(id)
    case False{}:
      U32.show(id) ++ "," ++ pastimes.powder.join(t)
def pastimes.case.powder_step(+i: J.Val) -> J.Val:
  pastimes.case.powder_step.k1(pastimes.powder.Powder.step(J.get(i, "s"), J.get(i, "inputs"), pastimes.ids_of(J.get(i, "tapped"))))

def pastimes.case.powder_step.k4(pr: Bool & List<&2, U32>, +p1: J.Val, +sooted: List<&2, U32>, +burned: Bool) -> J.Val:
  (+boom, +picked) = pr
  J.set(J.set(J.obj(), "s", p1), "ret", J.JA{[pastimes.ids_json(sooted), J.JBool{burned}, J.JBool{boom}, pastimes.ids_json(picked)]})

def pastimes.case.powder_step.k3(pr: Bool & Bool & List<&2, U32>, +p1: J.Val, +sooted: List<&2, U32>) -> J.Val:
  (+burned, +rest3) = pr
  pastimes.case.powder_step.k4(rest3, p1, sooted, burned)

def pastimes.case.powder_step.k2(pr: List<&2, U32> & Bool & (Bool & List<&2, U32>), +p1: J.Val) -> J.Val:
  (+sooted, +rest2) = pr
  pastimes.case.powder_step.k3(rest2, p1, sooted)

def pastimes.case.powder_step.k1(pr: J.Val & List<&2, U32> & (Bool & (Bool & List<&2, U32>))) -> J.Val:
  (+p1, +rest) = pr
  pastimes.case.powder_step.k2(rest, p1)
def case.pastimes.powder.Powder.step(+i: J.Val) -> J.Val:
  pastimes.case.powder_step(i)
