def pastimes.powder.plan(+p: J.Val, +inputs: J.Val, +tapped: List<&2, U32>, +ks: List<&2, J.Val>, +alive: U32, +moves: List<&2, J.Val>, +drops: List<&2, J.Val>) -> List<&2, J.Val> & List<&2, J.Val>:
