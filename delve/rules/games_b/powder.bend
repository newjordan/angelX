      J.set(J.set(c1, "p", p1), "chain", J.JA{[J.JU{gb.u(kg, "col")}, J.JU{gb.u(kg, "row")}, J.JU{c}, J.JU{r}]})
    case False{}:
      pastimes.powder.arm(c1, kg, reach, d, (step + 1 : U32))

def pastimes.powder.arm.at.k2(cv: Bool, +kg: J.Val, +reach: U32, +d: U32, +step: U32, +c: U32, +r: U32, +p: J.Val, +t: U32, +c1: J.Val) -> J.Val:
