def pastimes.powder.DC(+d: U32) -> U32:
  match d:
    case 0:
      1
    case 1:
      RS.i_neg(1)
    case _:
      0
def pastimes.powder.DR(+d: U32) -> U32:
  match d:
    case 2:
      1
    case 3:
      RS.i_neg(1)
    case _:
      0
# A blast pass's context: {p: the yard, arms: this keg's flames, burned:
# [{t, owner}], chain: null or [x1, y1, x2, y2]}.
def pastimes.powder.blasts(+ctx: J.Val, +boomed: List<&2, J.Val>) -> J.Val:
  match boomed:
    case Nil{}:
      ctx
    case Con{+kg, +t}:
      pastimes.powder.blasts(pastimes.powder.blast(ctx, kg), t)
def pastimes.powder.blast(+ctx: J.Val, +kg: J.Val) -> J.Val:
  +owner = pastimes.find_by(J.items(J.get(J.get(ctx, "p"), "knights")), "id", gb.u(kg, "owner"))
  +reach = Bool.pick(U32, J.is_null(owner), 3, gb.u(owner, "blast"))
  +c0 = J.set(ctx, "arms", J.JA{[pastimes.powder.flame(gb.u(kg, "col"), gb.u(kg, "row"), 4)]})
  +c1 = pastimes.powder.arm(pastimes.powder.arm(pastimes.powder.arm(pastimes.powder.arm(c0, kg, reach, 0, 1), kg, reach, 1, 1), kg, reach, 2, 1), kg, reach, 3, 1)
  pastimes.powder.lay(c1, J.items(J.get(c1, "arms")))
# One arm of the blast: out to `reach`, stopped by a post, a bale or a keg.
def pastimes.powder.arm(+ctx: J.Val, +kg: J.Val, +reach: U32, +d: U32, +step: U32) -> J.Val:
  pastimes.powder.arm.k1(U32.is_gt(step, reach), ctx, kg, reach, d, step)

def pastimes.powder.arm.k2(cv: Bool, +ctx: J.Val, +kg: J.Val, +reach: U32, +d: U32, +step: U32, +c: U32, +r: U32) -> J.Val:
  match cv:
    case True{}:
      ctx
    case False{}:
      pastimes.powder.arm.at(ctx, kg, reach, d, step, c, r)

def pastimes.powder.arm.k1(cv: Bool, +ctx: J.Val, +kg: J.Val, +reach: U32, +d: U32, +step: U32) -> J.Val:
  match cv:
    case True{}:
      ctx
    case False{}:
      +c = RS.i_add(gb.u(kg, "col"), RS.i_mul(pastimes.powder.DC(d), step))
      +r = RS.i_add(gb.u(kg, "row"), RS.i_mul(pastimes.powder.DR(d), step))
      pastimes.powder.arm.k2(Bool.or(Bool.or(RS.i_lt(c, 0), RS.i_ge(c, 11)), Bool.or(RS.i_lt(r, 0), RS.i_ge(r, 9))), ctx, kg, reach, d, step, c, r)
def pastimes.powder.arm.at(+ctx: J.Val, +kg: J.Val, +reach: U32, +d: U32, +step: U32, +c: U32, +r: U32) -> J.Val:
  +p = J.get(ctx, "p")
  +t = (r * 11 + c : U32)
  +c1 = J.set(ctx, "arms", J.push(J.get(ctx, "arms"), pastimes.powder.flame(c, r, d)))
  pastimes.powder.arm.at.k1(pastimes.powder.post(c, r, 0), kg, reach, d, step, c, r, p, t, c1)

def pastimes.powder.arm.at.k3(cv: Bool, +kg: J.Val, +reach: U32, +d: U32, +step: U32, +c: U32, +r: U32, +p: J.Val, +c1: J.Val) -> J.Val:
