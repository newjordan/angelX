  +used = (J.len(J.get(p, "kegs")) + U32.from_nat(List.length(&2, J.Val, drops)) : U32)
  +drop = Bool.and(Bool.and(pastimes.tapped_has(tapped, gb.u(k, "id")), U32.is_gt(gb.u(k, "stock"), 0)), Bool.and(U32.is_lt(used, cap), Bool.and(Bool.not(pastimes.powder.Powder.solid(p, c, r)), Bool.not(pastimes.powder.fresh_at(J.items(J.get(p, "flames")), c, r)))))
  +m = gb.su(gb.su(gb.su(J.obj(), "id", gb.u(k, "id")), "x", x), "y", y)
