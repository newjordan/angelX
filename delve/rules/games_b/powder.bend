def pastimes.powder.plan.k2(pr: U32 & U32, +p: J.Val, +inputs: J.Val, +tapped: List<&2, U32>, +alive: U32, +moves: List<&2, J.Val>, +drops: List<&2, J.Val>, +k: J.Val, +t: List<&2, J.Val>) -> List<&2, J.Val> & List<&2, J.Val>:
