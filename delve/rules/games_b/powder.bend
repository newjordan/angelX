    case Nil{}:
      p
    case Con{+d, +t}:
      +keg = gb.su(gb.su(gb.su(gb.su(J.obj(), "col", gb.u(d, "col")), "row", gb.u(d, "row")), "left", 90), "owner", gb.u(d, "id"))
