# generated by bx.py from pastimes_arms.bx: edit the .bx, not this file
# crates/delve/src/rules/pastimes.rs — play_round's `match round.game` arms.
# Each answers (run, (round, still_going)).

def pastimes.play.game(+run: J.Val, +round: J.Val, +gi: U32, +shown: U32, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  match gi:
    case 0:
      pastimes.arm.broadsheet(run, round, elig, tapped)
    case 1:
      pastimes.arm.barrel(run, round, inputs, elig, 1)
    case 2:
      pastimes.arm.turnip(run, round, shown, elig, tapped)
    case 3:
      pastimes.arm.barrel(run, round, inputs, elig, 3)
    case 4:
      pastimes.arm.cheese(run, round, inputs, elig, tapped)
    case 5:
      pastimes.arm.hobbyhorse(run, round, elig, tapped)
    case 6:
      pastimes.arm.sled(run, round, inputs, elig)
    case 7:
      pastimes.put.Run.tick_put(run, round, inputs, elig)
    case 8:
      pastimes.cart.Run.tick_cart(run, round, inputs, elig, tapped)
    case 9:
      pastimes.arm.surf(run, round, inputs, elig, tapped)
    case 10:
      pastimes.arm.volley(run, round, inputs, elig, tapped)
    case 11:
      pastimes.arm.halfpipe(run, round, inputs, elig, tapped)
    case 12:
      pastimes.arm.chariot(run, round, inputs, elig, tapped)
    case 13:
      pastimes.trencher.Run.tick_trencher(run, round, inputs, elig, tapped)
    case 14:
      pastimes.arm.duckshoot(run, round, inputs, elig, tapped)
    case 15:
      pastimes.longbow.Run.tick_longbow(run, round, inputs, elig)
    case 16:
      pastimes.powder.Run.tick_kegs(run, round, inputs, elig, tapped)
    case 17:
      (run, (round, True{}))
    case _:
      pastimes.siege.Run.tick_siege(run, round, inputs, elig)
# ---- Broadsheet Boy: deliver the paper to the right doors ------------------

def pastimes.arm.broadsheet(+run: J.Val, +round: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  pastimes.broadsheet.each(run, round, elig, tapped)
def pastimes.broadsheet.each(+run: J.Val, +round: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  match tapped:
    case Nil{}:
      (run, (round, True{}))
    case Con{+id, +rest}:
      +me = pastimes.find_el(elig, id)
      pastimes.broadsheet.each.k1(J.is_null(me), run, round, elig, id, rest, me)

def pastimes.broadsheet.each.k2(pr: J.Val & J.Val, +elig: List<&2, J.Val>, +rest: List<&2, U32>) -> J.Val & (J.Val & Bool):
  (+run2, +round2) = pr
  pastimes.broadsheet.each(run2, round2, elig, rest)

def pastimes.broadsheet.each.k1(cv: Bool, +run: J.Val, +round: J.Val, +elig: List<&2, J.Val>, +id: U32, +rest: List<&2, U32>, +me: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      pastimes.broadsheet.each(run, round, elig, rest)
    case False{}:
      pastimes.broadsheet.each.k2(pastimes.broadsheet.one(run, round, id, gb.f(me, "x"), gb.f(me, "y")), elig, rest)
# The nearest mailbox within 3.0, as an index, or 5 for none.
def pastimes.broadsheet.mailbox(+x: F32, +y: F32, +i: U32, +best: U32, +bd: F32) -> U32:
  match i:
    case 5:
      best
    case _:
      +d = RS.f_hypot((x - (pastimes.MAILBOX_X(i) * 2.0 : F32) : F32), (y - (pastimes.MAILBOX_Y(i) * 2.0 : F32) : F32))
      +take = Bool.and(F32.is_lt(d, 3.0), Bool.or(U32.is_eq(best, 5), F32.is_lt(d, bd)))
      pastimes.broadsheet.mailbox(x, y, (i + 1 : U32), Bool.pick(U32, take, i, best), Bool.pick(F32, take, d, bd))
def pastimes.broadsheet.one(+run: J.Val, +round: J.Val, +id: U32, +x: F32, +y: F32) -> J.Val & J.Val:
  +i = pastimes.broadsheet.mailbox(x, y, 0, 5, 0.0)
  +bit = U32.shln(1, U32.to_nat(i))
  pastimes.broadsheet.one.k1(Bool.and(U32.is_lt(i, 5), U32.is_eq(U32.and(gb.u(round, "tried"), bit), 0)), run, round, id, i, bit)

def pastimes.broadsheet.one.k2(cv: Bool, +run: J.Val, +round: J.Val, +id: U32, +i: U32, +bit: U32, +r1: J.Val) -> J.Val & J.Val:
  match cv:
    case True{}:
      +r2 = pastimes.popup(pastimes.progress1(r1), "+75", RS.f_as_i32(pastimes.MAILBOX_X(i)), RS.f_as_i32(pastimes.MAILBOX_Y(i)))
      (gb.found(gb.sound(run, "card_pickup"), id, "Delivered: 'Local knight mistakes goose for dragon'."), r2)
    case False{}:
      (gb.found(gb.sound(run, "clang"), id, "Not a subscriber! -25"), pastimes.mistake(r1))

def pastimes.broadsheet.one.k1(cv: Bool, +run: J.Val, +round: J.Val, +id: U32, +i: U32, +bit: U32) -> J.Val & J.Val:
  match cv:
    case True{}:
      +r1 = gb.su(round, "tried", U32.or(gb.u(round, "tried"), bit))
      pastimes.broadsheet.one.k2(U32.is_ne(U32.and(gb.u(round, "recipients"), bit), 0), run, round, id, i, bit, r1)
    case False{}:
      (run, round)
# ---- Barrel-board Derby / Washtub Regatta: reach the next mark -------------

def pastimes.arm.barrel(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +gi: U32) -> J.Val & (J.Val & Bool):
  +run1 = Bool.pick(J.Val, U32.is_eq(gi, 3), pastimes.washtub.stroke(run, inputs, elig), run)
  +i = gb.u(round, "progress")
  pastimes.arm.barrel.k1(Bool.pick(F32 & F32, U32.is_eq(gi, 1), (pastimes.FLAG_X(i), pastimes.FLAG_Y(i)), pastimes.wake(i, gb.tick(run))), round, elig, gi, run1)

def pastimes.arm.barrel.k2(cv: Bool, +round: J.Val, +elig: List<&2, J.Val>, +gi: U32, +run1: J.Val, +tx: F32, +ty: F32) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      +r1 = pastimes.popup(pastimes.progress1(round), Bool.pick(String, U32.is_eq(gi, 1), "FLAG!", "RING!"), RS.f_as_i32(tx), RS.f_as_i32(ty))
      (gb.sound(run1, "spoil_pickup"), (r1, True{}))
    case False{}:
      (run1, (round, True{}))

def pastimes.arm.barrel.k1(pr: F32 & F32, +round: J.Val, +elig: List<&2, J.Val>, +gi: U32, +run1: J.Val) -> J.Val & (J.Val & Bool):
  (+tx, +ty) = pr
  pastimes.arm.barrel.k2(pastimes.near(elig, tx, ty, 1.5), round, elig, gi, run1, tx, ty)
# The paddle's stroke sound: every half second while someone moves.
def pastimes.washtub.stroke(+run: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>) -> J.Val:
  pastimes.washtub.stroke.k1(Bool.and(U32.is_eq(W.rem_u32(gb.tick(run), 15), 0), pastimes.washtub.moving(inputs, elig)), run, inputs, elig)

def pastimes.washtub.stroke.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>) -> J.Val:
  match cv:
    case True{}:
      gb.sound(run, "wave_gate")
    case False{}:
      run
def pastimes.washtub.moving(+inputs: J.Val, +elig: List<&2, J.Val>) -> Bool:
  match elig:
    case Nil{}:
      False{}
    case Con{+e, +t}:
      +i = J.get(inputs, U32.show(gb.u(e, "id")))
      Bool.or(Bool.and(Bool.and(Bool.not(J.is_null(i)), rules.Input.valid(i)), Bool.or(Bool.or(U32.is_ne(gb.i(i, "move_x"), 0), U32.is_ne(gb.i(i, "move_y"), 0)), Bool.or(U32.is_ne(gb.i(i, "aim_x"), 0), U32.is_ne(gb.i(i, "aim_y"), 0)))), pastimes.washtub.moving(inputs, t))
# ---- Turnip Keepy-uppy: kick it as it lands ---------------------------------

def pastimes.arm.turnip(+run: J.Val, +round: J.Val, +shown: U32, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  +elapsed = gb.ssub(600, shown)
  +beat = U32.div(elapsed, 30)
  +phase = U32.mod(elapsed, 30)
  +hit = pastimes.turnip.hit(tapped, elig)
  pastimes.arm.turnip.k1(Bool.and(hit, Bool.not(Bool.and(Bool.not(J.is_null(J.get(round, "last_beat"))), U32.is_eq(gb.u(round, "last_beat"), beat)))), run, round, beat, phase, hit)

def pastimes.arm.turnip.k2(cv: Bool, +phase: U32, +r1: J.Val, +run1: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.sound(run1, "spoil_pickup"), (pastimes.popup(pastimes.progress1(r1), "PERFECT!", 19, 10), True{}))
    case False{}:
      (gb.found(run1, 0, "Too soon! Kick as it lands."), (pastimes.mistake(r1), True{}))

def pastimes.arm.turnip.k1(cv: Bool, +run: J.Val, +round: J.Val, +beat: U32, +phase: U32, +hit: Bool) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      +r1 = gb.su(round, "last_beat", beat)
      +run1 = gb.sound(run, "swing")
      pastimes.arm.turnip.k2(U32.is_le(phase, 6), phase, r1, run1)
    case False{}:
      (run, (round, True{}))
# Some tapping knight stands within 2.2 of the turnip's pad.
def pastimes.turnip.hit(+tapped: List<&2, U32>, +elig: List<&2, J.Val>) -> Bool:
  match tapped:
    case Nil{}:
      False{}
    case Con{+id, +rest}:
      +me = pastimes.find_el(elig, id)
      Bool.or(Bool.and(Bool.not(J.is_null(me)), F32.is_lt(RS.f_hypot((gb.f(me, "x") - 38.0 : F32), (gb.f(me, "y") - 20.0 : F32)), 2.2)), pastimes.turnip.hit(rest, elig))
# ---- Cheese Chuck: throw the cheese at the basket ----------------------------

def pastimes.arm.cheese(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  +cheese = J.get(round, "cheese")
  pastimes.arm.cheese.k1(J.is_null(cheese), run, round, inputs, elig, tapped, cheese)

def pastimes.arm.cheese.k2(pr: J.Val & J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  (+run1, +round1) = pr
  pastimes.cheese.throw(run1, round1, inputs, elig, tapped)

def pastimes.arm.cheese.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +cheese: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      pastimes.cheese.throw(run, round, inputs, elig, tapped)
    case False{}:
      pastimes.arm.cheese.k2(pastimes.cheese.fly(run, J.set(round, "cheese", J.JNull{}), cheese), inputs, elig, tapped)
def pastimes.cheese.fly(+run: J.Val, +round: J.Val, +cheese: J.Val) -> J.Val & J.Val:
  +cx = RS.i_add(gb.i(cheese, "x"), gb.i(cheese, "dx"))
  +cy = RS.i_add(gb.i(cheese, "y"), gb.i(cheese, "dy"))
  +left = gb.ssub(gb.u(cheese, "left"), 1)
  +x = (RS.i_as_f32(cx) / 256.0 : F32)
  +y = (RS.i_as_f32(cy) / 256.0 : F32)
  pastimes.cheese.fly.k1(pastimes.cheese_target(round), run, round, cheese, cx, cy, left, x, y)

def pastimes.cheese.fly.k3(cv: Bool, +run: J.Val, +round: J.Val, +c1: J.Val, +tile: String) -> J.Val & J.Val:
  match cv:
    case True{}:
      (gb.sound(run, "rock_land"), gb.su(round, "mistakes", (gb.u(round, "mistakes") + 1 : U32)))
    case False{}:
      (run, J.set(round, "cheese", c1))

def pastimes.cheese.fly.k2(cv: Bool, +run: J.Val, +round: J.Val, +x: F32, +y: F32, +bx: F32, +by: F32, +c1: J.Val) -> J.Val & J.Val:
  match cv:
    case True{}:
      +r1 = pastimes.popup(gb.su(pastimes.progress1(round), "hazard_left", 10), "HIT!", RS.f_as_i32(bx), RS.f_as_i32(by))
      (gb.sound(run, "hit"), r1)
    case False{}:
      +tile = J.str(layout.Room.tile(rules.Run.room(run), RS.f_as_i32(F32.floor(x)), RS.f_as_i32(F32.floor(y))))
      pastimes.cheese.fly.k3(Bool.or(Bool.not(pastimes.cheese.valid(c1)), Bool.or(String.eq(tile, "wall"), String.eq(tile, "block"))), run, round, c1, tile)

def pastimes.cheese.fly.k1(pr: F32 & F32, +run: J.Val, +round: J.Val, +cheese: J.Val, +cx: U32, +cy: U32, +left: U32, +x: F32, +y: F32) -> J.Val & J.Val:
  (+bx, +by) = pr
  +c1 = gb.su(gb.si(gb.si(cheese, "x", cx), "y", cy), "left", left)
  pastimes.cheese.fly.k2(F32.is_le(RS.f_hypot((x - bx : F32), (y - by : F32)), 0.75), run, round, x, y, bx, by, c1)
# Cheese::valid
def pastimes.cheese.valid(+c: J.Val) -> Bool:
  +ax = RS.i_abs(gb.i(c, "dx"))
  +ay = RS.i_abs(gb.i(c, "dy"))
  Bool.and(Bool.and(Bool.and(RS.i_ge(gb.i(c, "x"), 0), RS.i_lt(gb.i(c, "x"), 6144)), Bool.and(RS.i_ge(gb.i(c, "y"), 0), RS.i_lt(gb.i(c, "y"), 3584))), Bool.and(Bool.and(U32.is_le(ax, 108), U32.is_le(ay, 108)), Bool.and(U32.is_gt((ax + ay : U32), 0), Bool.and(U32.is_gt(gb.u(c, "left"), 0), U32.is_le(gb.u(c, "left"), 60)))))
# A fresh throw: from the first tapping knight at the line.
def pastimes.cheese.throw(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  +can = Bool.and(Bool.and(J.is_null(J.get(round, "cheese")), U32.is_lt(gb.u(round, "shots"), 12)), U32.is_lt(gb.u(round, "progress"), 5))
  +who = pastimes.cheese.thrower(elig, tapped)
  pastimes.cheese.throw.k1(Bool.and(can, Bool.not(J.is_null(who))), run, round, inputs, can, who)

def pastimes.cheese.throw.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +can: Bool, +who: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      pastimes.cheese.launch(run, round, J.get(inputs, U32.show(gb.u(who, "id"))), gb.f(who, "x"), gb.f(who, "y"))
    case False{}:
      pastimes.cheese.end(run, round)
def pastimes.cheese.thrower(+elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val:
  match elig:
    case Nil{}:
      J.JNull{}
    case Con{+e, +t}:
      pastimes.cheese.thrower.k1(Bool.and(pastimes.tapped_has(tapped, gb.u(e, "id")), F32.is_lt(RS.f_hypot((gb.f(e, "x") - 8.0 : F32), (gb.f(e, "y") - 12.0 : F32)), 2.4)), tapped, e, t)

def pastimes.cheese.thrower.k1(cv: Bool, +tapped: List<&2, U32>, +e: J.Val, +t: List<&2, J.Val>) -> J.Val:
  match cv:
    case True{}:
      e
    case False{}:
      pastimes.cheese.thrower(t, tapped)
def pastimes.cheese.launch(+run: J.Val, +round: J.Val, +input: J.Val, +x: F32, +y: F32) -> J.Val & (J.Val & Bool):
  +ax0 = RS.i_as_f32(gb.i(input, "aim_x"))
  +ay0 = RS.i_as_f32(gb.i(input, "aim_y"))
  +length = RS.f_hypot(ax0, ay0)
  +big = F32.is_gt(length, 0.1)
  +ax = Bool.pick(F32, big, (ax0 / length : F32), 1.0)
  +ay = Bool.pick(F32, big, (ay0 / length : F32), 0.0)
  +c = gb.su(gb.si(gb.si(gb.si(gb.si(J.obj(), "x", RS.f_as_i32(RS.f_round((x / 2.0 * 256.0 : F32)))), "y", RS.f_as_i32(RS.f_round((y / 2.0 * 256.0 : F32)))), "dx", RS.f_as_i32(RS.f_round((ax * 108.0 : F32)))), "dy", RS.f_as_i32(RS.f_round((ay * 108.0 : F32)))), "left", 60)
  pastimes.cheese.end(gb.sound(run, "play_card"), gb.su(J.set(round, "cheese", c), "shots", (gb.u(round, "shots") + 1 : U32)))
def pastimes.cheese.end(+run: J.Val, +round: J.Val) -> J.Val & (J.Val & Bool):
  pastimes.cheese.end.k1(Bool.and(Bool.and(U32.is_eq(gb.u(round, "shots"), 12), J.is_null(J.get(round, "cheese"))), U32.is_lt(gb.u(round, "progress"), 5)), run, round)

def pastimes.cheese.end.k1(cv: Bool, +run: J.Val, +round: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run, 0, "Out of cheese!"), (round, False{}))
    case False{}:
      (run, (round, True{}))
# ---- Hobbyhorse Hurdles: jump the fences -------------------------------------

def pastimes.arm.hobbyhorse(+run: J.Val, +round: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  +fence = RS.i_mul(RS.i_add(6, RS.i_mul(gb.u(round, "progress"), 3)), 256)
  +riders = pastimes.hobby.retain(gb.entries(J.get(round, "riders")), elig, J.obj())
  pastimes.arm.hobbyhorse.k1(pastimes.hobby.each(run, J.set(round, "riders", riders), fence, elig, tapped, False{}))

def pastimes.arm.hobbyhorse.k3(cv: Bool, +run2: J.Val, +round2: J.Val, +cleared: Bool) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      +p = gb.u(round2, "progress")
      (gb.sound(run2, "spoil_pickup"), (pastimes.popup(pastimes.progress1(round2), "CLEAR!", (6 + p * 3 : U32), 7), True{}))
    case False{}:
      (run2, (round2, True{}))

def pastimes.arm.hobbyhorse.k2(pr: J.Val & Bool, +run2: J.Val) -> J.Val & (J.Val & Bool):
  (+round2, +cleared) = pr
  pastimes.arm.hobbyhorse.k3(cleared, run2, round2, cleared)

def pastimes.arm.hobbyhorse.k1(pr: J.Val & J.Val & Bool) -> J.Val & (J.Val & Bool):
  (+run2, +rest) = pr
  pastimes.arm.hobbyhorse.k2(rest, run2)
def pastimes.hobby.retain(+rs: List<&2, J.Val>, +elig: List<&2, J.Val>, +m: J.Val) -> J.Val:
  match rs:
    case Nil{}:
      m
    case Con{+e, +t}:
      pastimes.hobby.retain.k1(pastimes.has_el(elig, gb.id(gb.s(e, "k"))), elig, m, e, t)

def pastimes.hobby.retain.k1(cv: Bool, +elig: List<&2, J.Val>, +m: J.Val, +e: J.Val, +t: List<&2, J.Val>) -> J.Val:
  match cv:
    case True{}:
      pastimes.hobby.retain(t, elig, J.set(m, gb.s(e, "k"), J.get(e, "v")))
    case False{}:
      pastimes.hobby.retain(t, elig, m)
def pastimes.hobby.each(+run: J.Val, +round: J.Val, +fence: U32, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +cleared: Bool) -> J.Val & (J.Val & Bool):
  match elig:
    case Nil{}:
      (run, (round, cleared))
    case Con{+e, +t}:
      +id = gb.u(e, "id")
      +x = RS.f_as_i32((gb.f(e, "x") / 2.0 * 256.0 : F32))
      +y = RS.f_as_i32((gb.f(e, "y") / 2.0 * 256.0 : F32))
      +rider0 = J.get(J.get(round, "riders"), U32.show(id))
      +rider = Bool.pick(J.Val, J.is_null(rider0), gb.su(gb.su(gb.si(gb.si(J.obj(), "x", x), "y", y), "air_left", 0), "rest_left", 0), rider0)
      +air0 = gb.ssub(gb.u(rider, "air_left"), 1)
      +rest0 = gb.ssub(gb.u(rider, "rest_left"), 1)
      +jump = Bool.and(pastimes.tapped_has(tapped, id), U32.is_eq(rest0, 0))
      +air = Bool.pick(U32, jump, 10, air0)
      +rest = Bool.pick(U32, jump, 12, rest0)
      +run1 = Bool.pick(J.Val, jump, gb.sound(run, "roll"), run)
      +rx = gb.i(rider, "x")
      +ry = gb.i(rider, "y")
      +cross = Bool.and(Bool.and(Bool.not(cleared), RS.i_lt(rx, fence)), Bool.and(Bool.and(RS.i_ge(x, fence), U32.is_le(RS.u_abs_diff(x, rx), 256)), Bool.and(Bool.and(U32.is_le(RS.u_abs_diff(y, ry), 256), pastimes.in_lane(y)), pastimes.in_lane(ry))))
      +cleared2 = Bool.or(cleared, Bool.and(cross, U32.is_gt(air, 0)))
      +slip = Bool.and(Bool.and(cross, U32.is_eq(air, 0)), U32.is_eq(gb.u(round, "hazard_left"), 0))
      +round1 = Bool.pick(J.Val, slip, gb.su(pastimes.mistake(round), "hazard_left", 15), round)
      +run2 = Bool.pick(J.Val, slip, gb.sound(run1, "clang"), run1)
      +r2 = gb.su(gb.su(gb.si(gb.si(J.obj(), "x", x), "y", y), "air_left", air), "rest_left", rest)
      pastimes.hobby.each(run2, J.set(round1, "riders", J.set(J.get(round1, "riders"), U32.show(id), r2)), fence, t, tapped, cleared2)
def pastimes.in_lane(+y: U32) -> Bool:
  Bool.and(RS.i_ge(y, 1408), RS.i_le(y, 2176))
# ---- Squire Sled Slalom --------------------------------------------------------

def pastimes.arm.sled(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>) -> J.Val & (J.Val & Bool):
  +sled = J.get(round, "sled")
  pastimes.arm.sled.k1(Bool.not(pastimes.has_el(elig, gb.u(sled, "driver"))), run, round, inputs, elig, sled)

def pastimes.arm.sled.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +sled: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run, 0, "Squire parked."), (round, False{}))
    case False{}:
      pastimes.sled.steer(run, round, sled, pastimes.input_of(inputs, gb.u(sled, "driver")))
def pastimes.sled.steer(+run: J.Val, +round: J.Val, +sled: J.Val, +input: J.Val) -> J.Val & (J.Val & Bool):
  +steer = gb.axis(input, "aim_y", "move_y")
  +dy0 = gb.i(sled, "dy")
  +dy1 = Bool.pick(U32, U32.is_eq(steer, 0), RS.i_div(RS.i_mul(dy0, 7), 8), RS.i_clamp(RS.i_add(dy0, RS.i_mul(steer, 4)), RS.i_neg(32), 32))
  +fire = gb.b(input, "fire")
  +dy2 = Bool.pick(U32, fire, RS.i_div(RS.i_mul(dy1, 3), 4), dy1)
  +x = RS.i_add(gb.i(sled, "x"), Bool.pick(U32, fire, 6, 12))
  +y0 = RS.i_add(gb.i(sled, "y"), dy2)
  +out = Bool.or(RS.i_lt(y0, 1024), RS.i_gt(y0, 2560))
  +y = Bool.pick(U32, out, RS.i_clamp(y0, 1024, 2560), y0)
  +dy = Bool.pick(U32, out, 0, dy2)
  +bump = Bool.and(out, U32.is_eq(gb.u(round, "hazard_left"), 0))
  +s1 = gb.si(gb.si(gb.si(sled, "x", x), "y", y), "dy", dy)
  +r1 = Bool.pick(J.Val, bump, gb.su(pastimes.mistake(round), "hazard_left", 30), round)
  +run1 = Bool.pick(J.Val, bump, gb.sound(run, "clang"), run)
  pastimes.sled.gate(run1, J.set(r1, "sled", s1), s1)
def pastimes.sled.gate(+run: J.Val, +round: J.Val, +sled: J.Val) -> J.Val & (J.Val & Bool):
  +p = gb.u(round, "progress")
  +gx = pastimes.SLED_GATE_X(p)
  +gy = pastimes.SLED_GATE_Y(p)
  pastimes.sled.gate.k1(RS.i_ge(gb.i(sled, "x"), RS.i_mul(gx, 256)), run, round, sled, p, gx, gy)

def pastimes.sled.gate.k2(cv: Bool, +run: J.Val, +round: J.Val, +sled: J.Val, +p: U32, +gx: U32, +gy: U32) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(gb.sound(run, "clang"), 0, "Missed gate " ++ U32.show((p + 1 : U32)) ++ "!"), (round, False{}))
    case False{}:
      (gb.sound(run, "spoil_pickup"), (pastimes.popup(pastimes.progress1(round), "GATE!", RS.i_clamp(gx, 2, 22), RS.i_clamp(gy, 2, 12)), True{}))

def pastimes.sled.gate.k1(cv: Bool, +run: J.Val, +round: J.Val, +sled: J.Val, +p: U32, +gx: U32, +gy: U32) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      pastimes.sled.gate.k2(U32.is_gt(RS.u_abs_diff(gb.i(sled, "y"), RS.i_mul(gy, 256)), 256), run, round, sled, p, gx, gy)
    case False{}:
      (run, (round, True{}))
# ---- Shield Surf ---------------------------------------------------------------

def pastimes.arm.surf(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  +surf = J.get(round, "surf")
  +owner = gb.u(surf, "owner")
  pastimes.arm.surf.k1(Bool.not(pastimes.has_el(elig, owner)), run, round, inputs, elig, tapped, surf, owner)

def pastimes.arm.surf.k4(cv: Bool, +run: J.Val, +owner: U32, +ret: J.Val, +r1: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.sound(run, "spoil_pickup"), (pastimes.popup(pastimes.progress1(r1), "WAVE!", 12, 6), True{}))
    case False{}:
      (gb.sound(gb.found(run, owner, "Wipeout on wave " ++ U32.show((gb.u(r1, "progress") + 1 : U32)) ++ "!"), "hit"), (r1, False{}))

def pastimes.arm.surf.k3(cv: Bool, +run: J.Val, +owner: U32, +ret: J.Val, +r1: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (run, (r1, True{}))
    case False{}:
      pastimes.arm.surf.k4(gb.b(J.set(J.obj(), "v", ret), "v"), run, owner, ret, r1)

def pastimes.arm.surf.k2(pr: J.Val & J.Val, +run: J.Val, +round: J.Val, +owner: U32) -> J.Val & (J.Val & Bool):
  (+s1, +ret) = pr
  +r1 = J.set(round, "surf", s1)
  pastimes.arm.surf.k3(J.is_null(ret), run, owner, ret, r1)

def pastimes.arm.surf.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +surf: J.Val, +owner: U32) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run, 0, "Surfer retired."), (round, False{}))
    case False{}:
      pastimes.arm.surf.k2(pastimes.surf.Surf.step(surf, pastimes.input_of(inputs, owner), pastimes.tapped_has(tapped, owner), gb.u(round, "progress")), run, round, owner)
# ---- Belfry Bat-and-Ball -----------------------------------------------------------

def pastimes.arm.volley(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  +v = J.get(round, "volley")
  +owner = gb.u(v, "owner")
  pastimes.arm.volley.k1(Bool.not(pastimes.has_el(elig, owner)), run, round, inputs, elig, tapped, v, owner)

def pastimes.arm.volley.k2(pr: J.Val & J.Val, +run: J.Val, +round: J.Val, +v: J.Val) -> J.Val & (J.Val & Bool):
  (+v1, +ret) = pr
  pastimes.volley.after(run, round, v, v1)

def pastimes.arm.volley.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +v: J.Val, +owner: U32) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run, 0, "Bat retired."), (round, False{}))
    case False{}:
      pastimes.arm.volley.k2(pastimes.volley.Volley.step(v, pastimes.input_of(inputs, owner), pastimes.tapped_has(tapped, owner)), run, round, v)
def pastimes.volley.after(+run: J.Val, +round: J.Val, +v: J.Val, +v1: J.Val) -> J.Val & (J.Val & Bool):
  +run1 = Bool.pick(J.Val, Bool.and(U32.is_eq(gb.u(v, "paddle_flash"), 0), U32.is_gt(gb.u(v1, "paddle_flash"), 0)), gb.sound(run, "swing"), run)
  +r1 = gb.su(J.set(round, "volley", v1), "progress", gb.popcount(gb.u(v1, "bells")))
  +rung = U32.is_ne(gb.u(v, "bells"), gb.u(v1, "bells"))
  +r2 = Bool.pick(J.Val, rung, pastimes.popup(r1, "DING!", 12, 6), r1)
  +run2 = Bool.pick(J.Val, rung, gb.sound(run1, "circle_toll"), run1)
  +lost = U32.is_ne(gb.u(v, "lives"), gb.u(v1, "lives"))
  +r3 = Bool.pick(J.Val, lost, pastimes.mistake(r2), r2)
  +run3 = Bool.pick(J.Val, lost, gb.sound(run2, "clang"), run2)
  pastimes.volley.after.k1(U32.is_eq(gb.u(v1, "lives"), 0), v1, r3, run3)

def pastimes.volley.after.k1(cv: Bool, +v1: J.Val, +r3: J.Val, +run3: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run3, gb.u(v1, "owner"), "Three turnips lost!"), (r3, False{}))
    case False{}:
      (run3, (r3, True{}))
# ---- Jester's Half-pipe --------------------------------------------------------------

def pastimes.arm.halfpipe(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  +h = J.get(round, "halfpipe")
  +owner = gb.u(h, "owner")
  pastimes.arm.halfpipe.k1(Bool.not(pastimes.has_el(elig, owner)), run, round, inputs, elig, tapped, h, owner)

def pastimes.arm.halfpipe.k2(pr: J.Val & J.Val, +run: J.Val, +round: J.Val, +direction: U32, +tap: Bool, +pump: U32, +was_ground: Bool) -> J.Val & (J.Val & Bool):
  (+h1, +ret) = pr
  pastimes.halfpipe.landed(run, J.set(round, "halfpipe", h1), h1, ret, Bool.and(Bool.and(was_ground, Bool.not(tap)), U32.is_eq(pump, direction)))

def pastimes.arm.halfpipe.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +h: J.Val, +owner: U32) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run, 0, "Jester retired."), (round, False{}))
    case False{}:
      +input = pastimes.input_of(inputs, owner)
      +direction = pastimes.halfpipe.Halfpipe.direction(gb.u(round, "progress"), gb.u(round, "mistakes"))
      +tap = pastimes.tapped_has(tapped, owner)
      +pump = RS.i_signum(gb.axis(input, "aim_x", "move_x"))
      +was_ground = U32.is_eq(gb.u(h, "flight"), 0)
      pastimes.arm.halfpipe.k2(pastimes.halfpipe.Halfpipe.step(h, input, tap, direction), run, round, direction, tap, pump, was_ground)
def pastimes.halfpipe.landed(+run: J.Val, +round: J.Val, +h: J.Val, +ret: J.Val, +pumped: Bool) -> J.Val & (J.Val & Bool):
  pastimes.halfpipe.landed.k1(J.is_null(ret), run, round, h, ret, pumped)

def pastimes.halfpipe.landed.k3(cv: Bool, +h: J.Val, +pumped: Bool, +r1: J.Val, +run1: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run1, gb.u(h, "owner"), "Three helmets dented! Step off J, then retry."), (r1, False{}))
    case False{}:
      pastimes.halfpipe.pumped(run1, r1, h, pumped)

def pastimes.halfpipe.landed.k2(cv: Bool, +run: J.Val, +round: J.Val, +h: J.Val, +ret: J.Val, +pumped: Bool) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      pastimes.halfpipe.pumped(gb.sound(run, "spoil_pickup"), pastimes.popup(pastimes.progress1(round), "NICE!", 12, 6), h, pumped)
    case False{}:
      +r1 = gb.su(round, "mistakes", (gb.u(round, "mistakes") + 1 : U32))
      +run1 = gb.sound(run, "hero_hurt")
      pastimes.halfpipe.landed.k3(U32.is_eq(gb.u(r1, "mistakes"), 3), h, pumped, r1, run1)

def pastimes.halfpipe.landed.k1(cv: Bool, +run: J.Val, +round: J.Val, +h: J.Val, +ret: J.Val, +pumped: Bool) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      pastimes.halfpipe.pumped(run, round, h, pumped)
    case False{}:
      pastimes.halfpipe.landed.k2(gb.b(J.set(J.obj(), "v", ret), "v"), run, round, h, ret, pumped)
def pastimes.halfpipe.pumped(+run: J.Val, +round: J.Val, +h: J.Val, +pumped: Bool) -> J.Val & (J.Val & Bool):
  (Bool.pick(J.Val, pumped, gb.sound(run, "roll"), run), (J.set(round, "halfpipe", pastimes.halfpipe.Halfpipe.tick_vfx(J.get(round, "halfpipe"))), True{}))
# ---- Cabbage and Roll Racing ------------------------------------------------------------

def pastimes.arm.chariot(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  +c = J.get(round, "chariot")
  +owner = gb.u(c, "owner")
  pastimes.arm.chariot.k1(Bool.not(pastimes.has_el(elig, owner)), run, round, inputs, elig, tapped, c, owner)

def pastimes.arm.chariot.k2(pr: J.Val & J.Val, +run: J.Val, +round: J.Val, +c: J.Val) -> J.Val & (J.Val & Bool):
  (+c1, +ret) = pr
  pastimes.chariot.after(run, round, c, c1, ret)

def pastimes.arm.chariot.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +c: J.Val, +owner: U32) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run, 0, "Driver retired."), (round, False{}))
    case False{}:
      pastimes.arm.chariot.k2(pastimes.chariot.Chariot.step(c, pastimes.input_of(inputs, owner), pastimes.tapped_has(tapped, owner)), run, round, c)
def pastimes.chariot.after(+run: J.Val, +round: J.Val, +c: J.Val, +c1: J.Val, +ret: J.Val) -> J.Val & (J.Val & Bool):
  +run1 = Bool.pick(J.Val, Bool.and(U32.is_gt(gb.u(c1, "reload"), 0), U32.is_eq(gb.u(c, "reload"), 0)), gb.sound(run, "vent_fire"), run)
  +bogged = U32.is_gt(gb.u(c1, "bog"), gb.u(c, "bog"))
  +r1 = Bool.pick(J.Val, bogged, pastimes.mistake(round), round)
  +run2 = Bool.pick(J.Val, bogged, gb.sound(run1, "hero_hurt"), run1)
  +r2 = gb.su(J.set(r1, "chariot", c1), "progress", U32.div(gb.u(c1, "distance"), 4096))
  +lap = U32.is_gt(U32.div(gb.u(c1, "distance"), 4096), U32.div(gb.u(c, "distance"), 4096))
  +r3 = Bool.pick(J.Val, lap, pastimes.popup(r2, "LAP!", 12, 6), r2)
  +run3 = Bool.pick(J.Val, lap, gb.sound(run2, "spoil_pickup"), run2)
  pastimes.chariot.after.k1(U32.is_eq(J.u32(ret), 0), c1, ret, r3, run3)

def pastimes.chariot.after.k2(cv: Bool, +c1: J.Val, +ret: J.Val, +r3: J.Val, +run3: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (run3, (r3, True{}))
    case False{}:
      pastimes.chariot.verdict(run3, r3, ret, gb.u(c1, "owner"))

def pastimes.chariot.after.k1(cv: Bool, +c1: J.Val, +ret: J.Val, +r3: J.Val, +run3: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (run3, (r3, True{}))
    case False{}:
      pastimes.chariot.after.k2(J.is_null(J.set(J.obj(), "n", ret)), c1, ret, r3, run3)
def pastimes.chariot.verdict(+run: J.Val, +round: J.Val, +ret: J.Val, +owner: U32) -> J.Val & (J.Val & Bool):
  match ret:
    case J.JI{+n}:
      (gb.found(run, owner, "Outraced by a goat!"), (round, False{}))
    case _:
      (run, (round, True{}))
# ---- Carnival Duck Range ---------------------------------------------------------------------

def pastimes.arm.duckshoot(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & (J.Val & Bool):
  +d = J.get(round, "duckshoot")
  +owner = gb.u(d, "owner")
  pastimes.arm.duckshoot.k1(Bool.not(pastimes.has_el(elig, owner)), run, round, inputs, elig, tapped, d, owner)

def pastimes.arm.duckshoot.k2(pr: J.Val & J.Val, +run: J.Val, +round: J.Val, +tap: Bool) -> J.Val & (J.Val & Bool):
  (+d1, +ret) = pr
  pastimes.duck.after(run, J.set(round, "duckshoot", d1), d1, ret, tap)

def pastimes.arm.duckshoot.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +d: J.Val, +owner: U32) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run, 0, "Gun retired."), (round, False{}))
    case False{}:
      +tap = pastimes.tapped_has(tapped, owner)
      pastimes.arm.duckshoot.k2(pastimes.duckshoot.DuckShoot.step(d, pastimes.input_of(inputs, owner), tap), run, round, tap)
def pastimes.duck.after(+run: J.Val, +round: J.Val, +d: J.Val, +ret: J.Val, +tap: Bool) -> J.Val & (J.Val & Bool):
  +run1 = pastimes.duck.hit(run, ret, tap)
  +r1 = pastimes.duck.score(round, ret)
  pastimes.duck.after.k1(Bool.and(Bool.and(U32.is_ge(gb.u(d, "shots"), 40), U32.is_lt(gb.u(r1, "progress"), 10)), U32.is_eq(gb.u(d, "shots"), 40)), d, run1, r1)

def pastimes.duck.after.k1(cv: Bool, +d: J.Val, +run1: J.Val, +r1: J.Val) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run1, gb.u(d, "owner"), "Out of BBs!"), (r1, False{}))
    case False{}:
      (run1, (r1, True{}))
def pastimes.duck.hit(+run: J.Val, +ret: J.Val, +tap: Bool) -> J.Val:
  pastimes.duck.hit.k1(J.is_null(ret), run, ret, tap)

def pastimes.duck.hit.k1(cv: Bool, +run: J.Val, +ret: J.Val, +tap: Bool) -> J.Val:
  match cv:
    case True{}:
      Bool.pick(J.Val, tap, gb.sound(gb.sound(run, "shot_handgonne"), "clang"), run)
    case False{}:
      gb.sound(run, "hit")
def pastimes.duck.score(+round: J.Val, +ret: J.Val) -> J.Val:
  pastimes.duck.score.k1(J.is_null(ret), round, ret)

def pastimes.duck.score.k1(cv: Bool, +round: J.Val, +ret: J.Val) -> J.Val:
  match cv:
    case True{}:
      round
    case False{}:
      +far = U32.is_eq(J.u32(ret), 2)
      +r1 = gb.su(round, "progress", U32.min((gb.u(round, "progress") + Bool.pick(U32, far, 2, 1) : U32), 10))
      pastimes.popup(r1, Bool.pick(String, far, "LONG!", "HIT!"), 12, 4)
