def pastimes.ps(+run: J.Val) -> J.Val:
  J.get(run, "pastimes")
def pastimes.with(+run: J.Val, +st: J.Val) -> J.Val:
  J.set(run, "pastimes", st)
# Run::tick_pastimes
def pastimes.Run.tick_pastimes(+run: J.Val, +inputs: J.Val) -> J.Val:
  +room = gb.s(rules.Run.room(run), "kind")
  pastimes.Run.tick_pastimes.k1(Bool.not(pastimes.room_has_game(room, 0)), run, inputs, room)

def pastimes.Run.tick_pastimes.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +room: String) -> J.Val:
  match cv:
    case True{}:
      pastimes.with(run, pastimes.State.leave(pastimes.ps(run)))
    case False{}:
      +elig = pastimes.eligible(run)
      +held = pastimes.pressing(elig, inputs)
      +tapped = pastimes.fresh(held, J.get(pastimes.ps(run), "fire"))
      +run1 = pastimes.with(run, J.set(pastimes.ps(run), "fire", pastimes.ids_json(held)))
      pastimes.tick.kegs(run1, inputs, room, elig, tapped)
def pastimes.tick.kegs(+run: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val:
  +round = J.get(pastimes.ps(run), "round")
  pastimes.tick.kegs.k1(Bool.and(Bool.not(J.is_null(J.get(run, "crossroads"))), Bool.and(Bool.not(J.is_null(round)), String.eq(gb.s(round, "game"), "powder"))), run, inputs, room, elig, tapped, round)

def pastimes.tick.kegs.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +round: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.Run.tick_crossroads_kegs(run, inputs, elig, tapped)
    case False{}:
      pastimes.tick.pads(run, inputs, room, elig, tapped)
# The pads: which game's start mark a knight stands on, newly.
def pastimes.occupied(+elig: List<&2, J.Val>, +room: String, +i: U32, +acc: U32) -> U32:
  match i:
    case 19:
      acc
    case _:
      pastimes.occupied.k1(pastimes.Game.start(i), elig, room, i, acc)

def pastimes.occupied.k1(pr: F32 & F32, +elig: List<&2, J.Val>, +room: String, +i: U32, +acc: U32) -> U32:
  (+sx, +sy) = pr
  +on = Bool.and(String.eq(pastimes.Game.room(i), room), pastimes.near(elig, sx, sy, 1.25))
  pastimes.occupied(elig, room, (i + 1 : U32), Bool.pick(U32, on, U32.or(acc, U32.shln(1, U32.to_nat(i))), acc))
def pastimes.tick.pads(+run: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val:
  +occupied = pastimes.occupied(elig, room, 0, 0)
  +st = pastimes.ps(run)
  +pressed = U32.and(occupied, U32.not(gb.u(st, "pads")))
  +run1 = pastimes.with(run, gb.su(st, "pads", occupied))
  pastimes.tick.pads.k1(List.is_empty(&2, J.Val, elig), inputs, room, elig, tapped, pressed, run1)

def pastimes.tick.pads.k2(cv: Bool, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +pressed: U32, +run1: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.tick.idle(pastimes.with(run1, J.set(pastimes.ps(run1), "round", J.JNull{})), room, elig, pressed)
    case False{}:
      pastimes.tick.heat(run1, inputs, room, elig, tapped)

def pastimes.tick.pads.k1(cv: Bool, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +pressed: U32, +run1: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.with(run1, J.set(J.set(J.set(pastimes.ps(run1), "round", J.JNull{}), "heats", J.obj()), "heat", J.JNull{}))
    case False{}:
      pastimes.tick.pads.k2(J.is_null(J.get(pastimes.ps(run1), "heat")), inputs, room, elig, tapped, pressed, run1)
# No heat under way: one pad pressed starts its game.
def pastimes.tick.idle(+run: J.Val, +room: String, +elig: List<&2, J.Val>, +pressed: U32) -> J.Val:
  pastimes.tick.idle.k1(U32.is_eq(gb.popcount(pressed), 1), run, elig, pressed)

def pastimes.tick.idle.k3(cv: Bool, +run: J.Val, +elig: List<&2, J.Val>, +gi: U32, +starter: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      pastimes.start(run, gi, elig, gb.u(starter, "id"), gb.f(starter, "x"), gb.f(starter, "y"))

def pastimes.tick.idle.k2(pr: F32 & F32, +run: J.Val, +elig: List<&2, J.Val>, +gi: U32) -> J.Val:
  (+sx, +sy) = pr
  +starter = pastimes.starter(elig, sx, sy)
  pastimes.tick.idle.k3(J.is_null(starter), run, elig, gi, starter)

def pastimes.tick.idle.k1(cv: Bool, +run: J.Val, +elig: List<&2, J.Val>, +pressed: U32) -> J.Val:
  match cv:
    case True{}:
      +gi = RS.u_trailing_zeros(pressed)
      pastimes.tick.idle.k2(pastimes.Game.start(gi), run, elig, gi)
    case False{}:
      run
def pastimes.starter(+elig: List<&2, J.Val>, +sx: F32, +sy: F32) -> J.Val:
  match elig:
    case Nil{}:
      J.JNull{}
    case Con{+e, +t}:
      pastimes.starter.k1(F32.is_lt(RS.f_hypot((gb.f(e, "x") - (sx * 2.0 : F32) : F32), (gb.f(e, "y") - (sy * 2.0 : F32) : F32)), 1.25), sx, sy, e, t)

def pastimes.starter.k1(cv: Bool, +sx: F32, +sy: F32, +e: J.Val, +t: List<&2, J.Val>) -> J.Val:
  match cv:
    case True{}:
      e
    case False{}:
      pastimes.starter(t, sx, sy)
def pastimes.rec_path() -> List<&2, String>:
  ["home", "countryside", "games"]
# Start a game: the plays count, a round for the starter and one for each
# friend, a heat, the Powder yard they share, the door and the word.
def pastimes.start(+run: J.Val, +gi: U32, +elig: List<&2, J.Val>, +starter: U32, +sx: F32, +sy: F32) -> J.Val:
  +rec = J.at(run, pastimes.rec_path())
  +rotation = U32.mod(pastimes.Records.plays_for(rec, gi), 5)
  +run1 = J.put(run, pastimes.rec_path(), pastimes.Records.add_play(rec, gi))
  +run2 = Bool.pick(J.Val, U32.is_eq(gi, 12), pastimes.with(run1, J.set(pastimes.ps(run1), "wager", J.JNull{})), run1)
  +seat_ids = pastimes.elig_ids(elig)
  +lead = gb.su(pastimes.new_round(gi, starter, sx, sy, rotation, seat_ids), "intro_ticks", 30)
  +heats = pastimes.friends(elig, starter, gi, rotation, seat_ids, J.obj())
  +seats = pastimes.hall(starter, seat_ids)
  +heat = J.set(J.set(J.set(J.set(J.obj(), "game", J.JS{pastimes.Game.of(gi)}), "seats", pastimes.ids_json(seats)), "done", J.obj()), "standing", J.obj())
  +st1 = J.set(J.set(J.set(pastimes.ps(run2), "round", lead), "heats", heats), "heat", heat)
  +st2 = Bool.pick(J.Val, U32.is_eq(gi, 16), pastimes.share_yard(st1, seats), st1)
  +crowd = U32.from_nat(List.length(&2, U32, seats))
  +text = Bool.pick(String, U32.is_gt(crowd, 1), pastimes.Game.name(gi) ++ "! Everyone plays. Best wins.", pastimes.Game.name(gi) ++ " begins!")
  gb.found(gb.sound(pastimes.with(run2, st2), "door_open"), 0, text)
# Each friend's round of their own (the intro is up for all of them).
def pastimes.friends(+elig: List<&2, J.Val>, +starter: U32, +gi: U32, +rotation: U32, +seats: List<&2, U32>, +m: J.Val) -> J.Val:
  match elig:
    case Nil{}:
      m
    case Con{+e, +t}:
      +id = gb.u(e, "id")
      pastimes.friends.k1(U32.is_eq(id, starter), starter, gi, rotation, seats, m, e, t, id)

def pastimes.friends.k1(cv: Bool, +starter: U32, +gi: U32, +rotation: U32, +seats: List<&2, U32>, +m: J.Val, +e: J.Val, +t: List<&2, J.Val>, +id: U32) -> J.Val:
  match cv:
    case True{}:
      pastimes.friends(t, starter, gi, rotation, seats, m)
    case False{}:
      pastimes.friends(t, starter, gi, rotation, seats, J.set(m, U32.show(id), gb.su(pastimes.new_round(gi, id, gb.f(e, "x"), gb.f(e, "y"), rotation, seats), "intro_ticks", 30)))
# Powder Keg: every seat's round holds the one yard, built for the whole heat.
def pastimes.share_yard(+st: J.Val, +seats: List<&2, U32>) -> J.Val:
  +seed = gb.u(J.get(J.get(st, "round"), "powder"), "seed")
  +yard = pastimes.powder.Powder.new(seats, seed)
  +st1 = J.set(st, "round", J.set(J.get(st, "round"), "powder", yard))
  J.set(st1, "heats", pastimes.heats_yard(gb.entries(J.get(st1, "heats")), yard, J.obj()))
def pastimes.heats_yard(+es: List<&2, J.Val>, +yard: J.Val, +m: J.Val) -> J.Val:
  match es:
    case Nil{}:
      m
    case Con{+e, +t}:
      pastimes.heats_yard(t, yard, J.set(m, gb.s(e, "k"), J.set(J.get(e, "v"), "powder", yard)))
# A heat is under way: the shared Gander hall, or each seat's own round.
def pastimes.tick.heat(+run: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val:
  +round = J.get(pastimes.ps(run), "round")
  pastimes.tick.heat.k1(Bool.and(Bool.not(J.is_null(round)), String.eq(gb.s(round, "game"), "gander")), run, inputs, room, elig, tapped, round)

def pastimes.tick.heat.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +round: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.tick.gander(run, inputs, elig, tapped)
    case False{}:
      +heat = J.get(pastimes.ps(run), "heat")
      +run2 = pastimes.seats_loop(run, inputs, room, elig, tapped, pastimes.ids_of(J.get(heat, "seats")), 0)
      +run3 = pastimes.tick.crown(run2)
      pastimes.push_ambient(run3, room)
# Everyone has finished: the best is crowned.
def pastimes.tick.crown(+run: J.Val) -> J.Val:
  +st = pastimes.ps(run)
  +heat = J.get(st, "heat")
  pastimes.tick.crown.k1(Bool.and(Bool.and(J.is_null(J.get(st, "round")), gb.is_empty(J.get(st, "heats"))), Bool.not(J.is_null(heat))), run, st, heat)

def pastimes.tick.crown.k1(cv: Bool, +run: J.Val, +st: J.Val, +heat: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.judge_heat(pastimes.with(run, J.set(st, "heat", J.JNull{})), heat)
    case False{}:
      run
# The seats in order: each plays its own round; a race won stops the rest.
def pastimes.seats_loop(+run: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +seats: List<&2, U32>, +n: U32) -> J.Val:
  match seats:
    case Nil{}:
      run
    case Con{+id, +rest}:
      pastimes.seats_loop.k1(pastimes.seat_turn(run, inputs, room, elig, tapped, id, n), inputs, room, elig, tapped, n, rest)

def pastimes.seats_loop.k2(cv: Bool, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +n: U32, +rest: List<&2, U32>, +run2: J.Val, +stop: Bool) -> J.Val:
  match cv:
    case True{}:
      run2
    case False{}:
      pastimes.seats_loop(run2, inputs, room, elig, tapped, rest, (n + 1 : U32))

def pastimes.seats_loop.k1(pr: J.Val & Bool, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +n: U32, +rest: List<&2, U32>) -> J.Val:
  (+run2, +stop) = pr
  pastimes.seats_loop.k2(stop, inputs, room, elig, tapped, n, rest, run2, stop)
def pastimes.seat_turn(+run: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +id: U32, +n: U32) -> J.Val & Bool:
  +st = pastimes.ps(run)
  +round = Bool.pick(J.Val, U32.is_eq(n, 0), J.get(st, "round"), J.get(J.get(st, "heats"), U32.show(id)))
  pastimes.seat_turn.k1(J.is_null(round), run, inputs, room, elig, tapped, id, n, st, round)

def pastimes.seat_turn.k2(pr: J.Val & PsPlayed, +id: U32, +n: U32) -> J.Val & Bool:
  (+run2, +played) = pr
  pastimes.seat_after(run2, played, id, n)

def pastimes.seat_turn.k1(cv: Bool, +run: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +id: U32, +n: U32, +st: J.Val, +round: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      (run, False{})
    case False{}:
      +st1 = Bool.pick(J.Val, U32.is_eq(n, 0), J.set(st, "round", J.JNull{}), J.set(st, "heats", J.del(J.get(st, "heats"), U32.show(id))))
      pastimes.seat_turn.k2(pastimes.seat_play(pastimes.with(run, st1), round, inputs, room, elig, tapped, id, n), id, n)
# The round's turn: the shared yard's lead ticks it all; a friend mirrors
# their knight's standing in it; anything else plays for its own seat.
def pastimes.seat_play(+run: J.Val, +round: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +id: U32, +n: U32) -> J.Val & PsPlayed:
  +game = gb.s(round, "game")
  pastimes.seat_play.k1(Bool.and(String.eq(game, "powder"), U32.is_gt(n, 0)), run, round, inputs, room, elig, tapped, id, n, game)

def pastimes.seat_play.k3(cv: Bool, +run: J.Val, +round: J.Val, +id: U32, +p: J.Val) -> J.Val & PsPlayed:
  match cv:
    case True{}:
      (run, pastimes.lost(round))
    case False{}:
      +r1 = gb.su(gb.su(round, "progress", U32.min(gb.u(J.get(p, "burned"), U32.show(id)), 8)), "left", gb.ssub(gb.u(round, "left"), 1))
      (run, PsGoing{r1})

def pastimes.seat_play.k2(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +id: U32, +p: J.Val) -> J.Val & PsPlayed:
  match cv:
    case True{}:
      pastimes.Run.play_round(run, round, inputs, elig, tapped)
    case False{}:
      pastimes.seat_play.k3(Bool.or(Bool.not(pastimes.powder.Powder.alive_has(p, id)), U32.is_eq(gb.u(round, "left"), 0)), run, round, id, p)

def pastimes.seat_play.k5(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +id: U32, +game: String) -> J.Val & PsPlayed:
  match cv:
    case True{}:
      pastimes.Run.play_round(run, round, inputs, pastimes.only(elig, id), pastimes.taps_of(tapped, id))
    case False{}:
      (run, pastimes.lost(round))

def pastimes.seat_play.k4(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +id: U32, +game: String) -> J.Val & PsPlayed:
  match cv:
    case True{}:
      pastimes.Run.play_round(run, round, inputs, elig, tapped)
    case False{}:
      pastimes.seat_play.k5(String.eq(pastimes.Game.room(pastimes.Game.index(game)), room), run, round, inputs, room, elig, tapped, id, game)

def pastimes.seat_play.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +room: String, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +id: U32, +n: U32, +game: String) -> J.Val & PsPlayed:
  match cv:
    case True{}:
      +lead = J.get(pastimes.ps(run), "round")
      +p = J.get(lead, "powder")
      pastimes.seat_play.k2(J.is_null(p), run, round, inputs, elig, tapped, id, p)
    case False{}:
      pastimes.seat_play.k4(String.eq(game, "powder"), run, round, inputs, room, elig, tapped, id, game)
def pastimes.played_progress(+p: PsPlayed) -> U32:
  match p:
    case PsGoing{+r}:
      gb.u(r, "progress")
    case PsOver{+n, +pts}:
      n
def pastimes.seat_after(+run: J.Val, +played: PsPlayed, +id: U32, +n: U32) -> J.Val & Bool:
  +st = pastimes.ps(run)
  +heat = J.get(st, "heat")
  +need = pastimes.Game.need(pastimes.Game.index(gb.s(heat, "game")))
  +run1 = Bool.pick(J.Val, J.is_null(heat), run, pastimes.with(run, J.set(st, "heat", J.set(heat, "standing", J.set(J.get(heat, "standing"), U32.show(id), J.JU{U32.min(pastimes.played_progress(played), need)})))))
  pastimes.seat_place(run1, played, id, n)
def pastimes.seat_place(+run: J.Val, +played: PsPlayed, +id: U32, +n: U32) -> J.Val & Bool:
  +st = pastimes.ps(run)
  pastimes.seat_place.k1(played, run, played, id, n, st)

def pastimes.seat_place.k2(cv: Bool, +run: J.Val, +id: U32, +n: U32, +st: J.Val, +r: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      (pastimes.with(run, J.set(st, "round", r)), False{})
    case False{}:
      (pastimes.with(run, J.set(st, "heats", J.set(J.get(st, "heats"), U32.show(id), r))), False{})

def pastimes.seat_place.k3(cv: Bool, +points: J.Val, +run1: J.Val) -> J.Val & Bool:
  match cv:
    case True{}:
      (run1, False{})
    case False{}:
      (pastimes.end_heat_rounds(run1), True{})

def pastimes.seat_place.k1(sv0: PsPlayed, +run: J.Val, +played: PsPlayed, +id: U32, +n: U32, +st: J.Val) -> J.Val & Bool:
  match sv0:
    case PsGoing{+r}:
      pastimes.seat_place.k2(U32.is_eq(n, 0), run, id, n, st, r)
    case PsOver{+progress, +points}:
      +heat = J.get(st, "heat")
      +fin = J.set(gb.su(J.obj(), "progress", progress), "points", points)
      +run1 = Bool.pick(J.Val, J.is_null(heat), run, pastimes.with(run, J.set(st, "heat", J.set(heat, "done", J.set(J.get(heat, "done"), U32.show(id), fin)))))
      pastimes.seat_place.k3(J.is_null(points), points, run1)
# Stops every round still going, keeping how far each got.
def pastimes.end_heat_rounds(+run: J.Val) -> J.Val:
  +st = pastimes.ps(run)
  +heat = J.get(st, "heat")
  pastimes.end_heat_rounds.k1(J.is_null(heat), run, st, heat)

def pastimes.end_heat_rounds.k1(cv: Bool, +run: J.Val, +st: J.Val, +heat: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +lead = Bool.pick(U32, List.is_empty(&2, J.Val, J.items(J.get(heat, "seats"))), 0, J.u32(J.nth(J.get(heat, "seats"), 0)))
      +round = J.get(st, "round")
      +done1 = Bool.pick(J.Val, J.is_null(round), J.get(heat, "done"), pastimes.done_keep(J.get(heat, "done"), lead, round))
      +done2 = pastimes.done_heats(gb.entries(J.get(st, "heats")), done1)
      pastimes.with(run, J.set(J.set(J.set(st, "round", J.JNull{}), "heats", J.obj()), "heat", J.set(heat, "done", done2)))
# done.entry(id).or_insert(Finish { progress, points: None }).
def pastimes.done_keep(+done: J.Val, +id: U32, +round: J.Val) -> J.Val:
  pastimes.done_keep.k1(J.has(done, U32.show(id)), done, id, round)

def pastimes.done_keep.k1(cv: Bool, +done: J.Val, +id: U32, +round: J.Val) -> J.Val:
  match cv:
    case True{}:
      done
    case False{}:
      J.set(done, U32.show(id), J.set(gb.su(J.obj(), "progress", gb.u(round, "progress")), "points", J.JNull{}))
def pastimes.done_heats(+es: List<&2, J.Val>, +done: J.Val) -> J.Val:
  match es:
    case Nil{}:
      done
    case Con{+e, +t}:
      pastimes.done_heats(t, pastimes.done_keep(done, gb.id(gb.s(e, "k")), J.get(e, "v")))
# Heat::winner: the seat with the best (points?, points, progress), the
# earlier seat on a tie; 0 for none.
def pastimes.Heat.winner(+heat: J.Val) -> J.Val:
  pastimes.winner.go(J.items(J.get(heat, "seats")), J.get(heat, "done"), J.JNull{})
def pastimes.winner.go(+seats: List<&2, J.Val>, +done: J.Val, +best: J.Val) -> J.Val:
  match seats:
    case Nil{}:
      best
    case Con{+s, +t}:
      +f = J.get(done, U32.show(J.u32(s)))
      pastimes.winner.go.k1(J.is_null(f), done, best, s, t, f)

def pastimes.winner.go.k2(cv: Bool, +done: J.Val, +best: J.Val, +s: J.Val, +t: List<&2, J.Val>, +f: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.winner.go(t, done, s)
    case False{}:
      pastimes.winner.go(t, done, best)

def pastimes.winner.go.k1(cv: Bool, +done: J.Val, +best: J.Val, +s: J.Val, +t: List<&2, J.Val>, +f: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.winner.go(t, done, best)
    case False{}:
      pastimes.winner.go.k2(Bool.or(J.is_null(best), pastimes.fin_better(f, J.get(done, U32.show(J.u32(best))))), done, best, s, t, f)
def pastimes.fin_better(+a: J.Val, +b: J.Val) -> Bool:
  +pa = J.get(a, "points")
  +pb = J.get(b, "points")
  +ha = Bool.not(J.is_null(pa))
  +hb = Bool.not(J.is_null(pb))
  pastimes.fin_better.k1(Bool.not(Bool.xor(ha, hb)), a, b, pa, pb, ha, hb)

def pastimes.fin_better.k2(cv: Bool, +a: J.Val, +b: J.Val, +pa: J.Val, +pb: J.Val) -> Bool:
  match cv:
    case True{}:
      U32.is_gt(gb.u(a, "progress"), gb.u(b, "progress"))
    case False{}:
      U32.is_gt(J.u32(pa), J.u32(pb))

def pastimes.fin_better.k1(cv: Bool, +a: J.Val, +b: J.Val, +pa: J.Val, +pb: J.Val, +ha: Bool, +hb: Bool) -> Bool:
  match cv:
    case True{}:
      pastimes.fin_better.k2(U32.is_eq(J.u32(pa), J.u32(pb)), a, b, pa, pb)
    case False{}:
      ha
# Run::judge_heat: the best is crowned before the party.
def pastimes.judge_heat(+run: J.Val, +heat: J.Val) -> J.Val:
  pastimes.judge_heat.k1(Bool.not(J.is_null(J.get(run, "crossroads"))), run, heat)

def pastimes.judge_heat.k3(cv: Bool, +run: J.Val, +heat: J.Val, +w: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      pastimes.crown(run, heat, J.u32(w))

def pastimes.judge_heat.k2(cv: Bool, +run: J.Val, +heat: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +w = pastimes.Heat.winner(heat)
      pastimes.judge_heat.k3(J.is_null(w), run, heat, w)

def pastimes.judge_heat.k1(cv: Bool, +run: J.Val, +heat: J.Val) -> J.Val:
  match cv:
    case True{}:
      crossroads.Run.finish_crossroads(run, pastimes.rank_seats(pastimes.ids_of(J.get(heat, "seats")), J.get(heat, "done")))
    case False{}:
      pastimes.judge_heat.k2(U32.is_lt(J.len(J.get(heat, "seats")), 2), run, heat)
def pastimes.crown(+run: J.Val, +heat: J.Val, +winner: U32) -> J.Val:
  +hero = J.get(J.get(run, "players"), U32.show(winner))
  +name = Bool.pick(String, J.is_null(hero), "A knight", gb.s(hero, "name"))
  +gi = pastimes.Game.index(gb.s(heat, "game"))
  +run1 = J.set(run, "players", pastimes.stakes(J.items(J.get(heat, "seats")), J.get(run, "players"), winner, gb.s(heat, "game")))
  +run2 = gb.found(run1, 0, gb.upper(name) ++ " WINS THE " ++ pastimes.Game.name(gi) ++ "!")
  gb.cue(gb.sound(run2, "play_card"), "pastime_won")
# The stakes are worn: a laurel for the winner, the booby prize for the rest.
def pastimes.stakes(+seats: List<&2, J.Val>, +players: J.Val, +winner: U32, +game: String) -> J.Val:
  match seats:
    case Nil{}:
      players
    case Con{+s, +t}:
      +id = J.u32(s)
      +h = J.get(players, U32.show(id))
      pastimes.stakes.k1(J.is_null(h), players, winner, game, t, id, h)

def pastimes.stakes.k1(cv: Bool, +players: J.Val, +winner: U32, +game: String, +t: List<&2, J.Val>, +id: U32, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.stakes(t, players, winner, game)
    case False{}:
      +win = U32.is_eq(id, winner)
      pastimes.stakes(t, J.set(players, U32.show(id), J.set(gb.sb(h, "laurel", win), "booby", Bool.pick(J.Val, win, J.JNull{}, J.JS{game}))), winner, game)
# The seats sorted best first (points?, points, progress), ties by seat id.
def pastimes.rank_seats(+seats: List<&2, U32>, +done: J.Val) -> List<&2, U32>:
  match seats:
    case Nil{}:
      []
    case Con{+s, +t}:
      pastimes.rank_ins(s, pastimes.rank_seats(t, done), done)
def pastimes.rank_ins(+s: U32, +sorted: List<&2, U32>, +done: J.Val) -> List<&2, U32>:
  match sorted:
    case Nil{}:
      [s]
    case Con{+h, +t}:
      pastimes.rank_ins.k1(pastimes.rank_before(s, h, done), s, done, h, t)

def pastimes.rank_ins.k1(cv: Bool, +s: U32, +done: J.Val, +h: U32, +t: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      s <> (h <> t)
    case False{}:
      h <> pastimes.rank_ins(s, t, done)
def pastimes.rank_before(+a: U32, +b: U32, +done: J.Val) -> Bool:
  +fa = J.get(done, U32.show(a))
  +fb = J.get(done, U32.show(b))
  pastimes.rank_before.k1(Bool.and(J.is_null(fa), J.is_null(fb)), a, b, fa, fb)

def pastimes.rank_before.k4(cv: Bool, +a: U32, +b: U32, +fa: J.Val, +fb: J.Val) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      Bool.and(Bool.not(pastimes.fin_better(fb, fa)), U32.is_lt(a, b))

def pastimes.rank_before.k3(cv: Bool, +a: U32, +b: U32, +fa: J.Val, +fb: J.Val) -> Bool:
  match cv:
    case True{}:
      True{}
    case False{}:
      pastimes.rank_before.k4(pastimes.fin_better(fa, fb), a, b, fa, fb)

def pastimes.rank_before.k2(cv: Bool, +a: U32, +b: U32, +fa: J.Val, +fb: J.Val) -> Bool:
  match cv:
    case True{}:
      False{}
    case False{}:
      pastimes.rank_before.k3(J.is_null(fb), a, b, fa, fb)

def pastimes.rank_before.k1(cv: Bool, +a: U32, +b: U32, +fa: J.Val, +fb: J.Val) -> Bool:
  match cv:
    case True{}:
      U32.is_lt(a, b)
    case False{}:
      pastimes.rank_before.k2(J.is_null(fa), a, b, fa, fb)
# The shared Gander hall ticks once for the whole heat.
def pastimes.tick.gander(+run: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val:
  +round = J.get(pastimes.ps(run), "round")
  +run1 = pastimes.with(run, J.set(pastimes.ps(run), "round", J.JNull{}))
  pastimes.tick.gander.k1(pastimes.gander.Run.tick_gander(run1, round, inputs, elig, tapped))

def pastimes.tick.gander.k3(cv: Bool, +over: Bool, +run3: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.finish_gander_heat(run3)
    case False{}:
      run3

def pastimes.tick.gander.k2(pr: J.Val & Bool, +run2: J.Val) -> J.Val:
  (+round2, +going) = pr
  +round3 = gb.su(round2, "left", gb.ssub(gb.u(round2, "left"), 1))
  +st = pastimes.ps(run2)
  +heat = J.get(st, "heat")
  +heat2 = Bool.pick(J.Val, J.is_null(heat), heat, J.set(heat, "standing", pastimes.gander.standing(J.items(J.get(J.get(round3, "gander"), "seats")), J.items(J.get(J.get(round3, "gander"), "tally")), J.get(heat, "standing"), 8)))
  +over = Bool.or(Bool.or(Bool.not(going), U32.is_eq(gb.u(round3, "left"), 0)), pastimes.gander.won(J.items(J.get(J.get(round3, "gander"), "tally"))))
  +run3 = pastimes.with(run2, J.set(J.set(st, "heat", heat2), "round", round3))
  pastimes.tick.gander.k3(over, over, run3)

def pastimes.tick.gander.k1(pr: J.Val & J.Val & Bool) -> J.Val:
  (+run2, +rest) = pr
  pastimes.tick.gander.k2(rest, run2)
def pastimes.gander.standing(+seats: List<&2, J.Val>, +tally: List<&2, J.Val>, +standing: J.Val, +need: U32) -> J.Val:
  match seats:
    case Nil{}:
      standing
    case Con{+s, +t}:
      +tl = Bool.pick(U32, List.is_empty(&2, J.Val, tally), 0, J.u32(Maybe.default(&2, J.Val, List.head(&2, J.Val, tally), J.JU{0})))
      pastimes.gander.standing(t, List.drop(&2, J.Val, tally, 1n), J.set(standing, U32.show(J.u32(s)), J.JU{U32.min(tl, need)}), need)
def pastimes.gander.won(+tally: List<&2, J.Val>) -> Bool:
  match tally:
    case Nil{}:
      False{}
    case Con{+t, +rest}:
      Bool.or(U32.is_ge(J.u32(t), 8), pastimes.gander.won(rest))
# The shared Gander hall is over: each seat finishes with its unhorsings,
# the most takes the crown and the winner's ride pays the purse.
def pastimes.finish_gander_heat(+run: J.Val) -> J.Val:
  +st = pastimes.ps(run)
  +round = J.get(st, "round")
  +heat = J.get(st, "heat")
  pastimes.finish_gander_heat.k1(J.is_null(round), run, st, round, heat)

def pastimes.finish_gander_heat.k3(cv: Bool, +round: J.Val, +heat: J.Val, +run1: J.Val, +g: J.Val) -> J.Val:
  match cv:
    case True{}:
      run1
    case False{}:
      +finishes = pastimes.gander.finishes(J.items(J.get(g, "seats")), J.items(J.get(g, "tally")), 8, J.obj())
      +crowned = J.set(J.set(J.set(J.set(J.obj(), "game", J.get(heat, "game")), "seats", J.get(heat, "seats")), "standing", J.get(heat, "standing")), "done", finishes)
      +w = pastimes.Heat.winner(crowned)
      +run2 = Bool.pick(J.Val, J.is_null(w), gb.cue(gb.sound(gb.sound(gb.found(run1, 0, "GANDER JOUST: time!"), "clang"), "hero_hurt"), "pastime_won"), pastimes.gander.pay(run1, round, crowned, J.u32(w)))
      pastimes.judge_heat(run2, crowned)

def pastimes.finish_gander_heat.k2(cv: Bool, +run: J.Val, +st: J.Val, +round: J.Val, +heat: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      +run1 = pastimes.with(run, J.set(J.set(J.set(st, "round", J.JNull{}), "heat", J.JNull{}), "heats", J.obj()))
      +g = J.get(round, "gander")
      pastimes.finish_gander_heat.k3(J.is_null(g), round, heat, run1, g)

def pastimes.finish_gander_heat.k1(cv: Bool, +run: J.Val, +st: J.Val, +round: J.Val, +heat: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      pastimes.finish_gander_heat.k2(J.is_null(heat), run, st, round, heat)
def pastimes.gander.finishes(+seats: List<&2, J.Val>, +tally: List<&2, J.Val>, +need: U32, +m: J.Val) -> J.Val:
  match seats:
    case Nil{}:
      m
    case Con{+s, +t}:
      +tl = Bool.pick(U32, List.is_empty(&2, J.Val, tally), 0, J.u32(Maybe.default(&2, J.Val, List.head(&2, J.Val, tally), J.JU{0})))
      pastimes.gander.finishes(t, List.drop(&2, J.Val, tally, 1n), need, J.set(m, U32.show(J.u32(s)), J.set(gb.su(J.obj(), "progress", U32.min(tl, need)), "points", J.JNull{})))
def pastimes.gander.pay(+run: J.Val, +round: J.Val, +crowned: J.Val, +w: U32) -> J.Val:
  +progress = gb.u(J.get(J.get(crowned, "done"), U32.show(w)), "progress")
  +result = RS.u_clamp(gb.ssub((progress * 75 + U32.div(gb.u(round, "left"), 30) * 5 : U32), (gb.u(round, "mistakes") * 25 : U32)), 25, 1000)
  +rec = J.at(run, pastimes.rec_path())
  +g = J.get(rec, "gander")
  +g1 = gb.su(gb.su(g, "best", U32.max(gb.u(g, "best"), result)), "wins", U32.min(gb.sadd(gb.u(g, "wins"), 1), gb.u(g, "plays")))
  +run1 = J.put(run, pastimes.rec_path(), J.set(rec, "gander", g1))
  +run2 = J.put(J.set(run1, "score", J.JU{gb.sadd(gb.u(run1, "score"), result)}), ["marks", "country:game:17"], J.JU{1})
  +run3 = gb.found(run2, 0, "GANDER JOUST complete! +" ++ U32.show(result) ++ ". Best " ++ U32.show(gb.u(g1, "best")) ++ ".")
  gb.cue(gb.sound(gb.sound(run3, "spoil_pickup"), "gold"), "pastime_won")
# Run::tick_crossroads_kegs: the crossroads keeps one yard, including after
# its starter is sooted. Survival decides places, then bales burned, then
# seat order.
def pastimes.Run.tick_crossroads_kegs(+run: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val:
  +st = pastimes.ps(run)
  +round = gb.su(J.get(st, "round"), "left", gb.ssub(gb.u(J.get(st, "round"), "left"), 1))
  +run1 = pastimes.with(run, J.set(st, "round", J.JNull{}))
  pastimes.Run.tick_crossroads_kegs.k1(U32.is_gt(gb.u(round, "left"), 0), inputs, elig, tapped, round, run1)

def pastimes.Run.tick_crossroads_kegs.k3(pr: J.Val & Bool, +run2: J.Val) -> J.Val:
  (+round2, +going) = pr
  pastimes.kegs.settle(run2, round2, going)

def pastimes.Run.tick_crossroads_kegs.k2(pr: J.Val & J.Val & Bool) -> J.Val:
  (+run2, +rest) = pr
  pastimes.Run.tick_crossroads_kegs.k3(rest, run2)

def pastimes.Run.tick_crossroads_kegs.k1(cv: Bool, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +round: J.Val, +run1: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.Run.tick_crossroads_kegs.k2(pastimes.powder.Run.tick_kegs(run1, round, inputs, elig, tapped))
    case False{}:
      pastimes.kegs.settle(run1, round, False{})
def pastimes.kegs.settle(+run: J.Val, +round: J.Val, +going: Bool) -> J.Val:
  +st = pastimes.ps(run)
  +heat = J.get(st, "heat")
  +yard = J.get(round, "powder")
  +alive = pastimes.powder.Powder.alive(yard)
  +elapsed = gb.ssub(1800, gb.u(round, "left"))
  +seats = pastimes.ids_of(J.get(heat, "seats"))
  +heat2 = pastimes.kegs.standing(heat, yard, alive, seats, elapsed)
  +nseats = U32.from_nat(List.length(&2, U32, seats))
  +n_alive = U32.from_nat(List.length(&2, U32, alive))
  +over = Bool.or(Bool.or(Bool.not(going), Bool.and(U32.is_gt(nseats, 1), U32.is_le(n_alive, 1))), Bool.and(U32.is_eq(nseats, 1), U32.is_ge(gb.u(round, "progress"), 8)))
  pastimes.kegs.settle.k1(over, run, round, st, seats, heat2, over)

def pastimes.kegs.settle.k1(cv: Bool, +run: J.Val, +round: J.Val, +st: J.Val, +seats: List<&2, U32>, +heat2: J.Val, +over: Bool) -> J.Val:
  match cv:
    case True{}:
      +heat3 = pastimes.kegs.finish(heat2, seats)
      pastimes.judge_heat(pastimes.with(run, J.set(J.set(st, "heat", J.JNull{}), "heats", J.obj())), heat3)
    case False{}:
      pastimes.with(run, J.set(J.set(J.set(st, "heat", heat2), "round", round), "heats", pastimes.heats_all(gb.entries(J.get(st, "heats")), round, J.obj())))
def pastimes.heats_all(+es: List<&2, J.Val>, +round: J.Val, +m: J.Val) -> J.Val:
  match es:
    case Nil{}:
      m
    case Con{+e, +t}:
      pastimes.heats_all(t, round, J.set(m, gb.s(e, "k"), round))
# Each seat's standing; those out of the yard are done, ranked by how long
# they lasted.
def pastimes.kegs.standing(+heat: J.Val, +yard: J.Val, +alive: List<&2, U32>, +seats: List<&2, U32>, +elapsed: U32) -> J.Val:
  match seats:
    case Nil{}:
      heat
    case Con{+id, +t}:
      +progress = U32.min(gb.u(J.get(yard, "burned"), U32.show(id)), 8)
      +h1 = J.set(heat, "standing", J.set(J.get(heat, "standing"), U32.show(id), J.JU{progress}))
      +fin = J.set(gb.su(J.obj(), "progress", progress), "points", J.JU{U32.div((elapsed * 999 : U32), 1800)})
      +h2 = Bool.pick(J.Val, Bool.or(pastimes.powder.has_id(alive, id), J.has(J.get(h1, "done"), U32.show(id))), h1, J.set(h1, "done", J.set(J.get(h1, "done"), U32.show(id), fin)))
      pastimes.kegs.standing(h2, yard, alive, t, elapsed)
def pastimes.kegs.finish(+heat: J.Val, +seats: List<&2, U32>) -> J.Val:
  match seats:
    case Nil{}:
      heat
    case Con{+id, +t}:
      +fin = J.set(gb.su(J.obj(), "progress", gb.u(J.get(heat, "standing"), U32.show(id))), "points", J.JU{1000})
      pastimes.kegs.finish(Bool.pick(J.Val, J.has(J.get(heat, "done"), U32.show(id)), heat, J.set(heat, "done", J.set(J.get(heat, "done"), U32.show(id), fin))), t)
# Run::start_crossroads_pastime: the crossroads' first seat starts the
# game for the table: Powder's one yard, or the Gander hall.
def pastimes.Run.start_crossroads_pastime(+run: J.Val, +gi: U32) -> J.Val:
  +seats = pastimes.ids_of(J.get(J.get(run, "crossroads"), "seats"))
  pastimes.Run.start_crossroads_pastime.k1(seats, run, gi, seats)

def pastimes.Run.start_crossroads_pastime.k1(sv0: List<&2, U32>, +run: J.Val, +gi: U32, +seats: List<&2, U32>) -> J.Val:
  match sv0:
    case Nil{}:
      run
    case Con{+owner, +rest}:
      pastimes.cross.start(run, gi, seats, owner, rest)
def pastimes.cross.start(+run: J.Val, +gi: U32, +seats: List<&2, U32>, +owner: U32, +rest: List<&2, U32>) -> J.Val:
  pastimes.cross.start.k1(pastimes.Game.start(gi), run, gi, seats, owner, rest)

def pastimes.cross.start.k2(cv: Bool, +run: J.Val, +gi: U32, +seats: List<&2, U32>, +rest: List<&2, U32>, +round: J.Val, +rec: J.Val, +heat: J.Val) -> J.Val:
  match cv:
    case True{}:
      +yard = pastimes.powder.Powder.new(seats, W.rem_u32(W.of_j(J.get(run, "seed")), 7))
      +round2 = J.set(round, "powder", yard)
      +run1 = J.set(run, "players", pastimes.powder.seat_start(J.items(J.get(yard, "knights")), J.get(run, "players")))
      +run2 = J.put(run1, pastimes.rec_path(), pastimes.Records.add_play(rec, 16))
      pastimes.with(run2, J.set(J.set(J.set(pastimes.ps(run2), "heats", pastimes.heats_all(gb.entries(pastimes.ids_obj(rest)), round2, J.obj())), "round", round2), "heat", heat))
    case False{}:
      +run1 = J.put(run, pastimes.rec_path(), pastimes.Records.add_play(rec, 17))
      pastimes.with(run1, J.set(J.set(pastimes.ps(run1), "round", round), "heat", heat))

def pastimes.cross.start.k1(pr: F32 & F32, +run: J.Val, +gi: U32, +seats: List<&2, U32>, +owner: U32, +rest: List<&2, U32>) -> J.Val:
  (+ax, +ay) = pr
  +round = pastimes.new_round(gi, owner, ax, ay, 0, seats)
  +rec = J.at(run, pastimes.rec_path())
  +heat = J.set(J.set(J.set(J.set(J.obj(), "game", J.JS{pastimes.Game.of(gi)}), "seats", pastimes.ids_json(seats)), "done", J.obj()), "standing", J.obj())
  pastimes.cross.start.k2(U32.is_eq(gi, 16), run, gi, seats, rest, round, rec, heat)
# {id: null} for each id (so `heats_all` can fill them).
def pastimes.ids_obj(+ids: List<&2, U32>) -> J.Val:
  pastimes.ids_obj.go(ids, J.obj())
def pastimes.ids_obj.go(+ids: List<&2, U32>, +m: J.Val) -> J.Val:
  match ids:
    case Nil{}:
      m
    case Con{+id, +t}:
      pastimes.ids_obj.go(t, J.set(m, U32.show(id), J.JNull{}))
# The hero of each knight put in the yard where its sapper stands.
def pastimes.powder.seat_start(+ks: List<&2, J.Val>, +players: J.Val) -> J.Val:
  match ks:
    case Nil{}:
      players
    case Con{+k, +t}:
      +id = U32.show(gb.u(k, "id"))
      +h = J.get(players, id)
      pastimes.powder.seat_start.k1(J.is_null(h), players, k, t, id, h)

def pastimes.powder.seat_start.k1(cv: Bool, +players: J.Val, +k: J.Val, +t: List<&2, J.Val>, +id: String, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.powder.seat_start(t, players)
    case False{}:
      +x = ((6.0 + (RS.u_as_f32(gb.u(k, "x")) / 256.0 : F32) : F32) * 2.0 : F32)
      +y = ((((2.0 + (RS.u_as_f32(gb.u(k, "y")) / 256.0 : F32) : F32) + 0.3 : F32)) * 2.0 : F32)
      pastimes.powder.seat_start(t, J.set(players, id, gb.sf(gb.sf(h, "x", x), "y", y)))
# State::depart: a knight leaves; the rest play on, a lead's yard passes on.
def pastimes.State.depart(+st: J.Val, +id: U32, +remaining: List<&2, U32>) -> J.Val:
  +st1 = J.set(st, "fire", gb.set_rm(J.get(st, "fire"), id))
  pastimes.State.depart.k1(remaining, id, remaining, st1)

def pastimes.State.depart.k2(cv: Bool, +id: U32, +next: U32, +st2: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.depart.solo(st2, id, next)
    case False{}:
      pastimes.depart.heat(st2, id)

def pastimes.State.depart.k1(sv0: List<&2, U32>, +id: U32, +remaining: List<&2, U32>, +st1: J.Val) -> J.Val:
  match sv0:
    case Nil{}:
      pastimes.State.leave(st1)
    case Con{+next, +rest}:
      +st2 = Bool.pick(J.Val, Bool.and(Bool.not(J.is_null(J.get(st1, "wager_owner"))), U32.is_eq(gb.u(st1, "wager_owner"), id)), J.set(st1, "wager_owner", J.JU{next}), st1)
      pastimes.State.depart.k2(J.is_null(J.get(st2, "heat")), id, next, st2)
def pastimes.depart.heat(+st: J.Val, +id: U32) -> J.Val:
  +heat = J.get(st, "heat")
  +lead = Bool.and(Bool.not(List.is_empty(&2, J.Val, J.items(J.get(heat, "seats")))), U32.is_eq(J.u32(J.nth(J.get(heat, "seats"), 0)), id))
  pastimes.depart.heat.k1(lead, st, id, heat, lead)

def pastimes.depart.heat.k2(cv: Bool, +st: J.Val, +id: U32, +heat: J.Val, +round: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.depart.yard(st, id, heat, round)
    case False{}:
      pastimes.depart.done(J.set(st, "round", J.JNull{}), id)

def pastimes.depart.heat.k1(cv: Bool, +st: J.Val, +id: U32, +heat: J.Val, +lead: Bool) -> J.Val:
  match cv:
    case True{}:
      +round = J.get(st, "round")
      pastimes.depart.heat.k2(Bool.and(Bool.not(J.is_null(round)), String.eq(gb.s(round, "game"), "powder")), st, id, heat, round)
    case False{}:
      pastimes.depart.done(J.set(st, "heats", J.del(J.get(st, "heats"), U32.show(id))), id)
# The leaver's done entry goes; the heat keeps its standing.
def pastimes.depart.done(+st: J.Val, +id: U32) -> J.Val:
  +heat = J.get(st, "heat")
  J.set(st, "heat", J.set(heat, "done", J.del(J.get(heat, "done"), U32.show(id))))
# The shared courtyard needs a seat to carry it: when the starter departs,
# the next knight's round takes the yard over.
def pastimes.depart.yard(+st: J.Val, +id: U32, +heat: J.Val, +round: J.Val) -> J.Val:
  +next_owner = pastimes.depart.next_owner(pastimes.ids_of(J.get(heat, "seats")), id, J.get(heat, "done"))
  pastimes.depart.yard.k1(U32.is_eq(next_owner, 0), st, id, heat, round, next_owner)

def pastimes.depart.yard.k1(cv: Bool, +st: J.Val, +id: U32, +heat: J.Val, +round: J.Val, +next_owner: U32) -> J.Val:
  match cv:
    case True{}:
      pastimes.depart.done(J.set(st, "round", J.JNull{}), id)
    case False{}:
      +friend = J.get(J.get(st, "heats"), U32.show(next_owner))
      +powder = Bool.pick(J.Val, Bool.or(J.is_null(friend), J.is_null(J.get(friend, "powder"))), J.get(round, "powder"), J.get(friend, "powder"))
      +r1 = J.set(J.set(round, "powder", powder), "game", J.JS{"powder"})
      +seats = pastimes.cons(next_owner, pastimes.depart.drop_id(pastimes.ids_of(J.get(heat, "seats")), id))
      +st1 = J.set(J.set(st, "round", r1), "heats", J.del(J.get(st, "heats"), U32.show(next_owner)))
      +heat2 = J.set(J.set(heat, "seats", pastimes.ids_json(seats)), "done", J.del(J.get(heat, "done"), U32.show(id)))
      J.set(st1, "heat", heat2)
def pastimes.depart.next_owner(+seats: List<&2, U32>, +id: U32, +done: J.Val) -> U32:
  match seats:
    case Nil{}:
      0
    case Con{+s, +t}:
      pastimes.depart.next_owner.k1(Bool.and(Bool.not(U32.is_eq(s, id)), Bool.not(J.has(done, U32.show(s)))), id, done, s, t)

def pastimes.depart.next_owner.k1(cv: Bool, +id: U32, +done: J.Val, +s: U32, +t: List<&2, U32>) -> U32:
  match cv:
    case True{}:
      s
    case False{}:
      pastimes.depart.next_owner(t, id, done)
def pastimes.depart.drop_id(+seats: List<&2, U32>, +id: U32) -> List<&2, U32>:
  match seats:
    case Nil{}:
      []
    case Con{+s, +t}:
      pastimes.depart.drop_id.k1(U32.is_eq(s, id), id, s, t)

def pastimes.depart.drop_id.k1(cv: Bool, +id: U32, +s: U32, +t: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      pastimes.depart.drop_id(t, id)
    case False{}:
      s <> pastimes.depart.drop_id(t, id)
# No heat: the round's owner seats pass to the next knight.
def pastimes.depart.solo(+st: J.Val, +id: U32, +next: U32) -> J.Val:
  +r = J.get(st, "round")
  pastimes.depart.solo.k1(J.is_null(r), st, id, next, r)

def pastimes.depart.solo.k1(cv: Bool, +st: J.Val, +id: U32, +next: U32, +r: J.Val) -> J.Val:
  match cv:
    case True{}:
      st
    case False{}:
      +r1 = J.set(r, "riders", J.del(J.get(r, "riders"), U32.show(id)))
      +r2 = pastimes.depart.owner(r1, "sled", "driver", id, next)
      +r3 = pastimes.depart.owner(r2, "cart", "driver", id, next)
      +r4 = pastimes.depart.owner(pastimes.depart.owner(pastimes.depart.owner(r3, "put", "owner", id, next), "surf", "owner", id, next), "volley", "owner", id, next)
      +r5 = pastimes.depart.owner(pastimes.depart.owner(pastimes.depart.owner(r4, "halfpipe", "owner", id, next), "chariot", "owner", id, next), "trencher", "owner", id, next)
      +r6 = pastimes.depart.owner(pastimes.depart.owner(pastimes.depart.owner(r5, "duckshoot", "owner", id, next), "longbow", "owner", id, next), "siege", "owner", id, next)
      J.set(st, "round", r6)
# A sub-game's owner (or driver) field passes to `next` when it was `id`.
def pastimes.depart.owner(+r: J.Val, +game: String, +field: String, +id: U32, +next: U32) -> J.Val:
  +g = J.get(r, game)
  pastimes.depart.owner.k1(Bool.and(Bool.not(J.is_null(g)), U32.is_eq(gb.u(g, field), id)), r, game, field, id, next, g)

def pastimes.depart.owner.k1(cv: Bool, +r: J.Val, +game: String, +field: String, +id: U32, +next: U32, +g: J.Val) -> J.Val:
  match cv:
    case True{}:
      J.set(r, game, gb.su(g, field, next))
    case False{}:
      r
def case.pastimes.Run.tick_pastimes(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", pastimes.case.norm(pastimes.Run.tick_pastimes(J.get(input, "run"), J.get(input, "inputs"))))
def case.pastimes.Run.tick_pastimes.arena(+input: J.Val) -> J.Val:
  case.pastimes.Run.tick_pastimes(input)
# The product starts every round with its intro up (`#[cfg(not(test))]`);
# the Rust test build the cases are recorded from does not. Cases compare
# with the intro cleared.
def pastimes.case.norm(+run: J.Val) -> J.Val:
  +st = pastimes.ps(run)
  +r = J.get(st, "round")
  +r1 = Bool.pick(J.Val, J.is_null(r), r, gb.su(r, "intro_ticks", 0))
  pastimes.with(run, J.set(J.set(st, "round", r1), "heats", pastimes.case.norm.heats(gb.entries(J.get(st, "heats")), J.obj())))
def pastimes.case.norm.heats(+es: List<&2, J.Val>, +m: J.Val) -> J.Val:
  match es:
    case Nil{}:
      m
    case Con{+e, +t}:
      pastimes.case.norm.heats(t, J.set(m, gb.s(e, "k"), gb.su(J.get(e, "v"), "intro_ticks", 0)))
def pastimes.cons(+x: U32, +xs: List<&2, U32>) -> List<&2, U32>:
  x <> xs
def case.pastimes.State.depart(+i: J.Val) -> J.Val:
  J.set(J.obj(), "s", pastimes.State.depart(J.get(i, "s"), gb.u(i, "id"), pastimes.ids_of(J.get(i, "remaining"))))
def case.pastimes.Run.start_crossroads_pastime(+i: J.Val) -> J.Val:
  J.set(J.obj(), "run", pastimes.Run.start_crossroads_pastime(J.get(i, "run"), pastimes.Game.index(gb.s(i, "game"))))
