# One more play of game i (saturating).
def pastimes.Records.add_play(+rec: J.Val, +i: U32) -> J.Val:
  pastimes.Records.add_play.k1(U32.is_lt(i, 4), rec, i)

def pastimes.Records.add_play.k1(cv: Bool, +rec: J.Val, +i: U32) -> J.Val:
  match cv:
    case True{}:
      J.set(rec, "plays", gb.as(J.get(rec, "plays"), i, gb.sadd(gb.ag(J.get(rec, "plays"), i), 1)))
    case False{}:
      J.set(rec, pastimes.Game.score_key(i), gb.su(J.get(rec, pastimes.Game.score_key(i)), "plays", gb.sadd(gb.u(J.get(rec, pastimes.Game.score_key(i)), "plays"), 1)))
# A win with a result: best = max, wins = (wins + 1).min(plays).
def pastimes.Records.add_win(+rec: J.Val, +i: U32, +result: U32) -> J.Val:
  pastimes.Records.add_win.k1(U32.is_lt(i, 4), rec, i, result)

def pastimes.Records.add_win.k1(cv: Bool, +rec: J.Val, +i: U32, +result: U32) -> J.Val:
  match cv:
    case True{}:
      +r1 = J.set(rec, "best", gb.as(J.get(rec, "best"), i, U32.max(gb.ag(J.get(rec, "best"), i), result)))
      J.set(r1, "wins", gb.as(J.get(r1, "wins"), i, U32.min(gb.sadd(gb.ag(J.get(r1, "wins"), i), 1), gb.ag(J.get(r1, "plays"), i))))
    case False{}:
      +k = pastimes.Game.score_key(i)
      +s = J.get(rec, k)
      J.set(rec, k, gb.su(gb.su(s, "best", U32.max(gb.u(s, "best"), result)), "wins", U32.min(gb.sadd(gb.u(s, "wins"), 1), gb.u(s, "plays"))))
