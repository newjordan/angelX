# State::leave: everything back to the default.
def pastimes.State.leave(+st: J.Val) -> J.Val:
  +s0 = J.set(J.set(J.set(J.obj(), "round", J.JNull{}), "wager", J.JNull{}), "wager_owner", J.JNull{})
  +s1 = gb.su(gb.sb(gb.su(s0, "wager_pick", 0), "wager_key", False{}), "pads", 0)
  J.set(J.set(J.set(s1, "fire", J.JA{[]}), "heats", J.obj()), "heat", J.JNull{})
# A new round for `game` (by index), owned by `owner`.
def pastimes.new_round(+gi: U32, +owner: U32, +ax: F32, +ay: F32, +rotation: U32, +seats: List<&2, U32>) -> J.Val:
  +game = pastimes.Game.of(gi)
  +r0 = J.set(J.obj(), "game", J.JS{game})
  +r1 = gb.su(gb.su(gb.su(gb.su(r0, "left", pastimes.Game.time(gi)), "progress", 0), "tried", 0), "recipients", pastimes.recipients(rotation))
  +r2 = gb.su(gb.su(J.set(r1, "last_beat", J.JNull{}), "mistakes", 0), "hazard_left", 0)
  +r3 = J.set(J.set(r2, "cheese", J.JNull{}), "shots", J.JU{0})
  +r4 = J.set(J.set(J.set(J.set(r3, "put", pastimes.when(U32.is_eq(gi, 7), pastimes.put.Put.new(owner))), "cart", pastimes.when(U32.is_eq(gi, 8), pastimes.cart.Cart.new(owner))), "surf", pastimes.when(U32.is_eq(gi, 9), pastimes.surf.Surf.new(owner))), "volley", pastimes.when(U32.is_eq(gi, 10), pastimes.volley.Volley.new(owner)))
  +r5 = J.set(J.set(J.set(J.set(r4, "halfpipe", pastimes.when(U32.is_eq(gi, 11), pastimes.halfpipe.Halfpipe.new(owner))), "chariot", pastimes.when(U32.is_eq(gi, 12), pastimes.chariot.Chariot.new(owner))), "trencher", pastimes.when(U32.is_eq(gi, 13), pastimes.trencher.Trencher.new(owner))), "duckshoot", pastimes.when(U32.is_eq(gi, 14), pastimes.duckshoot.DuckShoot.new(owner)))
  +r6 = J.set(J.set(r5, "longbow", pastimes.when(U32.is_eq(gi, 15), pastimes.longbow.Longbow.new(owner))), "powder", pastimes.when(U32.is_eq(gi, 16), pastimes.powder.Powder.new([owner], U32.mod((rotation + owner * 3 : U32), 7))))
  +r7 = J.set(J.set(r6, "gander", pastimes.when(U32.is_eq(gi, 17), pastimes.gander.Gander.new(pastimes.hall(owner, seats)))), "siege", pastimes.when(U32.is_eq(gi, 18), pastimes.siege.Siege.new(owner)))
  +r8 = J.set(J.set(r7, "riders", pastimes.riders(gi, owner, ax, ay)), "sled", pastimes.when(U32.is_eq(gi, 6), pastimes.sled_new(owner)))
  gb.su(gb.si(gb.si(gb.ss(gb.su(gb.su(r8, "score_popup", 0), "streak", 0), "score_popup_text", ""), "score_popup_x", 0), "score_popup_y", 0), "intro_ticks", 0)
# `cond.then(|| v)` as null or the value.
def pastimes.when(+c: Bool, +v: J.Val) -> J.Val:
  Bool.pick(J.Val, c, v, J.JNull{})
# 1 << ((i + rotation) % 5) for i in [0, 2, 3], or'd.
def pastimes.recipients(+rotation: U32) -> U32:
  U32.or(U32.or(U32.shln(1, U32.to_nat(U32.mod(rotation, 5))), U32.shln(1, U32.to_nat(U32.mod((2 + rotation : U32), 5)))), U32.shln(1, U32.to_nat(U32.mod((3 + rotation : U32), 5))))
# The shared hall: the owner, then every other seat in the room.
def pastimes.hall(+owner: U32, +seats: List<&2, U32>) -> List<&2, U32>:
  owner <> pastimes.others(seats, owner)
def pastimes.others(+seats: List<&2, U32>, +owner: U32) -> List<&2, U32>:
  match seats:
    case Nil{}:
      []
    case Con{+id, +t}:
      pastimes.others.k1(U32.is_eq(id, owner), owner, id, t)

def pastimes.others.k1(cv: Bool, +owner: U32, +id: U32, +t: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      pastimes.others(t, owner)
    case False{}:
      id <> pastimes.others(t, owner)
# The Hobbyhorse rider map: the owner's place at the start (1/256 tiles).
def pastimes.riders(+gi: U32, +owner: U32, +ax: F32, +ay: F32) -> J.Val:
  pastimes.riders.k1(U32.is_eq(gi, 5), gi, owner, ax, ay)

def pastimes.riders.k1(cv: Bool, +gi: U32, +owner: U32, +ax: F32, +ay: F32) -> J.Val:
  match cv:
    case True{}:
      J.set(J.obj(), U32.show(owner), gb.su(gb.su(gb.si(gb.si(J.obj(), "x", RS.f_as_i32((ax / 2.0 * 256.0 : F32))), "y", RS.f_as_i32((ay / 2.0 * 256.0 : F32))), "air_left", 0), "rest_left", 0))
    case False{}:
      J.obj()
def pastimes.sled_new(+owner: U32) -> J.Val:
  gb.su(gb.si(gb.si(gb.si(J.obj(), "x", 768), "y", 1792), "dy", 0), "driver", owner)
