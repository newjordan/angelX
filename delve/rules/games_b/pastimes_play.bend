def pastimes.wake(+i: U32, +tick: W.W) -> F32 & F32:
  +a = (U32.to_f32(W.rem_u32(tick, 240)) / 240.0 : F32)
  +b = (a * 6.2831855 : F32)
  +phase = (b + U32.to_f32(i) : F32)
  (pastimes.WAKE_X(i), (pastimes.WAKE_Y(i) + (F32.sin(phase) * 0.35 : F32) : F32))
# fn nuisance: the goose / jester / duck's place at a tick.
def pastimes.nuisance(+game: String, +tick: W.W) -> F32 & F32:
  +a = (U32.to_f32(W.rem_u32(tick, 300)) / 300.0 : F32)
  +phase = (a * 6.2831855 : F32)
  pastimes.nuisance.k1(Bool.or(String.eq(game, "broadsheet"), String.eq(game, "barrel")), game, phase)

def pastimes.nuisance.k1(cv: Bool, +game: String, +phase: F32) -> F32 & F32:
  match cv:
    case True{}:
      ((12.0 + (F32.sin(phase) * 7.0 : F32) : F32), (7.0 + F32.cos(phase) : F32))
    case False{}:
      ((16.0 + (F32.sin(phase) * 2.0 : F32) : F32), (7.0 + F32.cos(phase) : F32))
# fn cheese_target: the basket's place.
def pastimes.cheese_target(+round: J.Val) -> F32 & F32:
  +age = gb.ssub(pastimes.Game.time(4), gb.u(round, "left"))
  +phase = U32.mod((age + gb.u(round, "progress") * 15 : U32), 120)
  +wave = (U32.to_f32(U32.min(phase, (120 - phase : U32))) / 60.0 : F32)
  ((15.0 + (U32.to_f32(U32.mod(gb.u(round, "progress"), 3)) * 2.0 : F32) : F32), (4.5 + (wave * 4.0 : F32) : F32))
# Whether some eligible knight is within `reach` of a point (tiles).
def pastimes.near(+elig: List<&2, J.Val>, +tx: F32, +ty: F32, +reach: F32) -> Bool:
  match elig:
    case Nil{}:
      False{}
    case Con{+e, +t}:
      Bool.or(F32.is_lt(RS.f_hypot((gb.f(e, "x") - (tx * 2.0 : F32) : F32), (gb.f(e, "y") - (ty * 2.0 : F32) : F32)), reach), pastimes.near(t, tx, ty, reach))
# Run::play_round
def pastimes.Run.play_round(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & PsPlayed:
  pastimes.Run.play_round.k1(U32.is_gt(gb.u(round, "intro_ticks"), 0), run, round, inputs, elig, tapped)

def pastimes.Run.play_round.k2(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & PsPlayed:
  match cv:
    case True{}:
      pastimes.play.clock(run, gb.su(round, "intro_ticks", 0), inputs, elig, tapped)
    case False{}:
      (run, PsGoing{gb.su(round, "intro_ticks", (gb.u(round, "intro_ticks") - 1 : U32))})

def pastimes.Run.play_round.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & PsPlayed:
  match cv:
    case True{}:
      pastimes.Run.play_round.k2(pastimes.any_fire(gb.entries(inputs)), run, round, inputs, elig, tapped)
    case False{}:
      pastimes.play.clock(run, round, inputs, elig, tapped)
def pastimes.any_fire(+fs: List<&2, J.Val>) -> Bool:
  match fs:
    case Nil{}:
      False{}
    case Con{+e, +t}:
      Bool.or(Bool.and(rules.Input.valid(J.get(e, "v")), gb.b(J.get(e, "v"), "fire")), pastimes.any_fire(t))
def pastimes.lost(+round: J.Val) -> PsPlayed:
  PsOver{gb.u(round, "progress"), J.JNull{}}
def pastimes.play.clock(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & PsPlayed:
  +shown = gb.u(round, "left")
  +r1 = gb.su(round, "left", gb.ssub(shown, 1))
  +gi = pastimes.Game.index(gb.s(round, "game"))
  pastimes.play.clock.k1(U32.is_eq(gb.u(r1, "left"), 0), run, round, inputs, elig, tapped, shown, r1, gi)

def pastimes.play.clock.k2(pr: J.Val & J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +shown: U32, +gi: U32) -> J.Val & PsPlayed:
  (+run3, +r3) = pr
  pastimes.play.arm(run3, r3, gi, shown, gb.u(round, "progress"), inputs, elig, tapped)

def pastimes.play.clock.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>, +shown: U32, +r1: J.Val, +gi: U32) -> J.Val & PsPlayed:
  match cv:
    case True{}:
      +f = gb.found(gb.sound(gb.sound(run, "clang"), "hero_hurt"), 0, pastimes.Game.name(gi) ++ ": time! " ++ U32.show(gb.u(r1, "progress")) ++ "/" ++ U32.show(pastimes.Game.need(gi)) ++ ".")
      (gb.cue(f, "pastime_lost"), pastimes.lost(r1))
    case False{}:
      +r2 = gb.su(gb.su(r1, "hazard_left", gb.ssub(gb.u(r1, "hazard_left"), 1)), "score_popup", gb.ssub(gb.u(r1, "score_popup"), 1))
      pastimes.play.clock.k2(pastimes.play.nuisance(run, r2, gb.s(r2, "game"), elig), round, inputs, elig, tapped, shown, gi)
# The goose, the jester or the royal duck takes a toll on the first three.
def pastimes.play.nuisance(+run: J.Val, +round: J.Val, +game: String, +elig: List<&2, J.Val>) -> J.Val & J.Val:
  +here = Bool.or(Bool.or(String.eq(game, "broadsheet"), String.eq(game, "barrel")), String.eq(game, "washtub"))
  pastimes.play.nuisance.k1(pastimes.nuisance(game, gb.tick(run)), run, round, game, elig, here)

def pastimes.play.nuisance.k2(cv: Bool, +run: J.Val, +round: J.Val, +game: String, +hit: Bool) -> J.Val & J.Val:
  match cv:
    case True{}:
      +text = Bool.pick(String, String.eq(game, "broadsheet"), "HONK! The goose has eaten your editorial. -25", Bool.pick(String, String.eq(game, "barrel"), "A jester demands a toll in dignity. -25", "The royal duck disapproves. -25"))
      +run1 = gb.found(run, 0, text)
      (gb.sound(run1, Bool.pick(String, String.eq(game, "barrel"), "hit", "wave_gate")), pastimes.mistake(gb.su(round, "hazard_left", 30)))
    case False{}:
      (run, round)

def pastimes.play.nuisance.k1(pr: F32 & F32, +run: J.Val, +round: J.Val, +game: String, +elig: List<&2, J.Val>, +here: Bool) -> J.Val & J.Val:
  (+nx, +ny) = pr
  +hit = Bool.and(Bool.and(here, U32.is_eq(gb.u(round, "hazard_left"), 0)), Bool.and(Bool.not(Bool.and(String.eq(game, "broadsheet"), pastimes.has_plot(run))), pastimes.near(elig, nx, ny, 1.2)))
  pastimes.play.nuisance.k2(hit, run, round, game, hit)
# Country::has(0): the first plot is built.
def pastimes.has_plot(+run: J.Val) -> Bool:
  U32.is_ne(U32.and(gb.u(J.get(J.get(run, "home"), "countryside"), "built"), 1), 0)
# One game's arm, then the milestone sounds and the win check.
def pastimes.play.arm(+run: J.Val, +round: J.Val, +gi: U32, +shown: U32, +prev: U32, +inputs: J.Val, +elig: List<&2, J.Val>, +tapped: List<&2, U32>) -> J.Val & PsPlayed:
  pastimes.play.arm.k1(pastimes.play.game(run, round, gi, shown, inputs, elig, tapped), gi, prev)

def pastimes.play.arm.k3(cv: Bool, +gi: U32, +prev: U32, +run2: J.Val, +round2: J.Val, +ok: Bool) -> J.Val & PsPlayed:
  match cv:
    case True{}:
      pastimes.play.after(run2, round2, gi, prev)
    case False{}:
      (run2, pastimes.lost(round2))

def pastimes.play.arm.k2(pr: J.Val & Bool, +gi: U32, +prev: U32, +run2: J.Val) -> J.Val & PsPlayed:
  (+round2, +ok) = pr
  pastimes.play.arm.k3(ok, gi, prev, run2, round2, ok)

def pastimes.play.arm.k1(pr: J.Val & J.Val & Bool, +gi: U32, +prev: U32) -> J.Val & PsPlayed:
  (+run2, +rest) = pr
  pastimes.play.arm.k2(rest, gi, prev, run2)
# The score milestones' sounds, the streak, and a finished round's purse.
def pastimes.play.after(+run: J.Val, +round: J.Val, +gi: U32, +prev: U32) -> J.Val & PsPlayed:
  +need = pastimes.Game.need(gi)
  +progress = gb.u(round, "progress")
  +gained = U32.is_gt(progress, prev)
  +streak = Bool.pick(U32, gained, U32.min(gb.sadd(gb.u(round, "streak"), 1), 20), Bool.pick(U32, U32.is_eq(progress, prev), 0, gb.u(round, "streak")))
  +r1 = gb.su(round, "streak", streak)
  +half = Bool.and(gained, Bool.and(U32.is_lt(prev, U32.div(need, 2)), U32.is_ge(progress, U32.div(need, 2))))
  +full = Bool.and(gained, Bool.and(U32.is_lt(prev, need), U32.is_ge(progress, need)))
  +combo = Bool.and(gained, U32.is_ge(streak, 3))
  +s1 = Bool.pick(J.Val, half, gb.sound(run, "card_pickup"), run)
  +s2 = Bool.pick(J.Val, full, gb.sound(s1, "wish_grant"), s1)
  +s3 = Bool.pick(J.Val, combo, gb.sound(s2, "spell_cast"), s2)
  pastimes.play.after.k1(Bool.and(Bool.not(U32.is_eq(gi, 17)), U32.is_ge(progress, need)), gi, need, progress, r1, s3)

def pastimes.play.after.k1(cv: Bool, +gi: U32, +need: U32, +progress: U32, +r1: J.Val, +s3: J.Val) -> J.Val & PsPlayed:
  match cv:
    case True{}:
      pastimes.play.win(s3, r1, gi)
    case False{}:
      (s3, PsGoing{r1})
# A won round: the result, the records, the realm's marks, the fanfare.
def pastimes.play.win(+run: J.Val, +round: J.Val, +gi: U32) -> J.Val & PsPlayed:
  +progress = gb.u(round, "progress")
  +result = Bool.pick(U32, U32.is_eq(gi, 18), U32.min((U32.min(gb.u(J.get(round, "siege"), "damage"), 65535) * 5 + U32.min(gb.u(J.get(round, "siege"), "soldiers"), 255) * 25 : U32), 1000), RS.u_clamp(gb.ssub((progress * 75 + U32.div(gb.u(round, "left"), 30) * 5 : U32), (gb.u(round, "mistakes") * 25 : U32)), 25, 1000))
  +rec = J.get(J.get(J.get(run, "home"), "countryside"), "games")
  +prev_best = pastimes.Records.best_for(rec, gi)
  +rec2 = pastimes.Records.add_win(rec, gi, result)
  +run1 = J.set(run, "home", J.set(J.get(run, "home"), "countryside", J.set(J.get(J.get(run, "home"), "countryside"), "games", rec2)))
  +run2 = J.put(J.set(run1, "score", J.JU{gb.sadd(gb.u(run1, "score"), result)}), ["marks", "country:game:" ++ U32.show(gi)], J.JU{1})
  +run3 = gb.found(run2, 0, pastimes.Game.name(gi) ++ " complete! +" ++ U32.show(result) ++ ". Best " ++ U32.show(pastimes.Records.best_for(rec2, gi)) ++ ".")
  +run4 = Bool.pick(J.Val, U32.is_gt(result, prev_best), gb.sound(gb.sound(run3, "wish_grant"), "gold"), gb.sound(gb.sound(run3, "spoil_pickup"), "gold"))
  (gb.cue(run4, "pastime_won"), PsOver{progress, J.JU{result}})
