# The wake rings: (x, y) of ring i at a tick.
def pastimes.WAKE_X(+i: U32) -> F32:
  match i:
    case 0:
      7.0
    case 1:
      10.0
    case 2:
      13.0
    case 3:
      16.0
    case 4:
      19.0
    case _:
