def cat.heel.k1(cv: Bool, +run: J.Val, +cat: J.Val, +owner: J.Val) -> J.Val & J.Val:
  match cv:
    case True{}:
      (run, cat)
    case False{}:
      +sx = (gb.f(owner, "x") + 1.4 : F32)
      +sy = (gb.f(owner, "y") + 0.9 : F32)
      +far = RS.f_hypot((sx - gb.f(cat, "x") : F32), (sy - gb.f(cat, "y") : F32))
      cat.heel.k2(F32.is_gt(far, 14.0), run, cat, sx, sy, far)
def case.cat.Run.tick_tallow(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", cat.Run.tick_tallow(J.get(input, "run")))
def case.cat.Run.pet_tallow(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", cat.Run.pet_tallow(J.get(input, "run"), J.get(input, "inputs")))
def case.cat.Run.bring_tallow(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", cat.Run.bring_tallow(J.get(input, "run")))
def case.cat.Run.tallow_follows(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", cat.Run.tallow_follows(J.get(input, "run")))
