# fn shiny: a card worth fetching: a take card with a spoil effect.
def cat.shiny(+card: J.Val) -> Bool:
  Bool.and(String.eq(J.str(J.get(card, "kind")), "take"), cat.shiny.effects(J.items(J.get(card, "effects"))))
def cat.shiny.effects(+es: List<&2, J.Val>) -> Bool:
  match es:
    case Nil{}:
      False{}
    case Con{+e, +t}:
      Bool.or(cat.spoil_effect(e), cat.shiny.effects(t))
