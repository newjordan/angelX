# A live, non-boss, non-dummy monster past its telegraph and within reach.
def cat.startles(+e: J.Val, +cx: F32, +cy: F32) -> Bool:
  +fit = Bool.and(Bool.and(U32.is_gt(gb.u(e, "hp"), 0), J.is_null(J.get(e, "boss"))), Bool.and(Bool.not(String.eq(gb.s(e, "kind"), "dummy")), U32.is_ge(gb.u(e, "age"), 30)))
  Bool.and(fit, F32.is_lt(RS.f_hypot((gb.f(e, "x") - cx : F32), (gb.f(e, "y") - cy : F32)), (3.0 + monsters.Enemy.radius(e) : F32)))
# Walk toward a point at a pace, sliding along walls; the distance she had
# to go. Up against a corner for half a second she is simply there.
def cat.walk(+cat: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32, +pace: F32) -> J.Val & F32:
  +d = RS.f_hypot((tx - gb.f(cat, "x") : F32), (ty - gb.f(cat, "y") : F32))
  cat.walk.k1(F32.is_gt(d, 0.05), cat, room, barred, tx, ty, pace, d)

def cat.walk.k1(cv: Bool, +cat: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32, +pace: F32, +d: F32) -> J.Val & F32:
  match cv:
    case True{}:
      cat.walk.move(cat, room, barred, tx, ty, pace, d)
    case False{}:
      (gb.sb(cat, "moving", F32.is_gt(d, 0.3)), d)
def cat.walk.move(+cat: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32, +pace: F32, +d: F32) -> J.Val & F32:
  +step = RS.f_min((pace * 0.033333335 : F32), d)
  +cx = gb.f(cat, "x")
  +cy = gb.f(cat, "y")
  cat.walk.move.k1(rules.unit((tx - cx : F32), (ty - cy : F32)), cat, room, barred, tx, ty, d, step, cx, cy)

def cat.walk.move.k3(cv: Bool, +tx: F32, +ty: F32, +d: F32, +stuck: U32, +c1: J.Val) -> J.Val & F32:
  match cv:
    case True{}:
      (gb.su(gb.sf(gb.sf(c1, "x", tx), "y", ty), "stuck", 0), 0.0)
    case False{}:
