# Anything shiny lying about? Else stay at her knight's heel.
def cat.fetch(+run: J.Val, +cat: J.Val, +owner: J.Val) -> J.Val & J.Val:
  +room = rules.Run.room(run)
  +best = cat.nearest(J.items(J.get(room, "items")), J.get(run, "book"), gb.f(cat, "x"), gb.f(cat, "y"), 0, J.JNull{})
  cat.fetch.k1(J.is_null(best), run, cat, owner, room, best)

def cat.fetch.k1(cv: Bool, +run: J.Val, +cat: J.Val, +owner: J.Val, +room: J.Val, +best: J.Val) -> J.Val & J.Val:
  match cv:
    case True{}:
      cat.heel(run, J.set(cat, "fetching", J.JNull{}), owner)
    case False{}:
      cat.go_fetch(run, cat, room, J.u32(J.nth(best, 0)))
# The nearest shiny item within 12 of her, as [index, distance], or null.
def cat.nearest(+items: List<&2, J.Val>, +book: J.Val, +cx: F32, +cy: F32, +i: U32, +best: J.Val) -> J.Val:
  match items:
    case Nil{}:
      best
    case Con{+it, +t}:
      +d = RS.f_hypot((gb.f(it, "x") - cx : F32), (gb.f(it, "y") - cy : F32))
      +take = Bool.and(cat.shiny(cards.Book.get(book, gb.s(it, "card"))), Bool.and(F32.is_lt(d, 12.0), Bool.or(J.is_null(best), F32.is_lt(d, J.f32(J.nth(best, 1))))))
      cat.nearest(t, book, cx, cy, (i + 1 : U32), Bool.pick(J.Val, take, J.JA{[J.JU{i}, J.JF{d}]}, best))
def cat.go_fetch(+run: J.Val, +cat: J.Val, +room: J.Val, +n: U32) -> J.Val & J.Val:
  +items = J.items(J.get(room, "items"))
  +it = J.nth(J.JA{items}, n)
  +ix = gb.f(it, "x")
  +iy = gb.f(it, "y")
  cat.go_fetch.k1(cat.walk(J.set(cat, "fetching", gb.pair(ix, iy)), room, rules.Run.barred(run), ix, iy, 10.0), run, room, n, items, it)

def cat.go_fetch.k2(cv: Bool, +run: J.Val, +room: J.Val, +n: U32, +items: List<&2, J.Val>, +it: J.Val, +cat2: J.Val, +d: F32) -> J.Val & J.Val:
  match cv:
    case True{}:
      (gb.set_room(run, J.set(room, "items", J.JA{gb.swap_remove(items, n)})), J.set(J.set(cat2, "carrying", J.get(it, "card")), "fetching", J.JNull{}))
    case False{}:
      (run, cat2)

def cat.go_fetch.k1(pr: J.Val & F32, +run: J.Val, +room: J.Val, +n: U32, +items: List<&2, J.Val>, +it: J.Val) -> J.Val & J.Val:
  (+cat2, +d) = pr
  cat.go_fetch.k2(F32.is_lt(d, 0.8), run, room, n, items, it, cat2, d)
# At her knight's heel, unhurried.
