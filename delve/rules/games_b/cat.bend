def cat.heel.k4(pr: J.Val & F32, +run: J.Val) -> J.Val & J.Val:
  (+cat2, +d) = pr
  (run, cat2)

def cat.heel.k3(cv: Bool, +run: J.Val, +cat: J.Val, +sx: F32, +sy: F32, +far: F32) -> J.Val & J.Val:
