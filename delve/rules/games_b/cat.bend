def cat.walk.move.k2(pr: F32 & F32, +cat: J.Val, +tx: F32, +ty: F32, +d: F32, +step: F32, +cx: F32, +cy: F32, +ux: F32) -> J.Val & F32:
  (+nx, +ny) = pr
  +moved = RS.f_hypot((nx - cx : F32), (ny - cy : F32))
  +stuck = Bool.pick(U32, F32.is_lt(moved, (step * 0.2 : F32)), (gb.u(cat, "stuck") + 1 : U32), 0)
  +c1 = gb.sb(gb.sf(gb.sf(cat, "x", nx), "y", ny), "left", F32.is_lt(ux, 0.0))
  cat.walk.move.k3(U32.is_gt(stuck, 15), tx, ty, d, stuck, c1)

def cat.walk.move.k1(pr: F32 & F32, +cat: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32, +d: F32, +step: F32, +cx: F32, +cy: F32) -> J.Val & F32:
