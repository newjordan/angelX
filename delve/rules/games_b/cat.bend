def cat.deliver(+run: J.Val, +cat: J.Val, +id: U32, +card: String) -> J.Val & J.Val:
  +found = cards.Book.get(J.get(run, "book"), card)
  +hero = J.get(J.get(run, "players"), U32.show(id))
  +run2 = Bool.pick(J.Val, Bool.or(J.is_null(found), J.is_null(hero)), run, cat.spend(run, id, hero, found))
  +cat2 = J.set(gb.su(cat, "fetched", (gb.u(cat, "fetched") + 1 : U32)), "carrying", J.JNull{})
  +run3 = gb.cue(gb.sound(run2, "card_pickup"), "tallow_fetch")
  cat.deliver.k1(U32.is_ge(gb.u(cat2, "fetched"), 10), cat2, run3)

