def cat.heel.k2(cv: Bool, +run: J.Val, +cat: J.Val, +sx: F32, +sy: F32, +far: F32) -> J.Val & J.Val:
  match cv:
    case True{}:
      (run, gb.sf(gb.sf(cat, "x", sx), "y", sy))
