  Bool.or(Bool.or(Bool.or(J.has(e, "gold"), J.has(e, "bone")), Bool.or(J.has(e, "wax"), J.has(e, "ore"))), Bool.or(Bool.or(J.has(e, "gem"), J.has(e, "ember")), J.has(e, "scale")))
