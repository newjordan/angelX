# The siege proper: the dial, the reload, the volley, the flight of stones.
def pastimes.siege.fight(+s: J.Val, +input: J.Val, +tapped: Bool) -> J.Val & J.Val:
  +aim_up = Bool.or(RS.i_lt(gb.i(input, "aim_y"), 0), RS.i_lt(gb.i(input, "move_y"), 0))
  +aim_dn = Bool.or(RS.i_gt(gb.i(input, "aim_y"), 0), RS.i_gt(gb.i(input, "move_y"), 0))
  +pw_up = Bool.or(RS.i_gt(gb.i(input, "aim_x"), 0), RS.i_gt(gb.i(input, "move_x"), 0))
  +pw_dn = Bool.or(RS.i_lt(gb.i(input, "aim_x"), 0), RS.i_lt(gb.i(input, "move_x"), 0))
  +aim1 = Bool.pick(U32, aim_up, U32.min((gb.u(s, "aim") + 1 : U32), 10), gb.u(s, "aim"))
  +aim2 = Bool.pick(U32, aim_dn, gb.ssub(aim1, 1), aim1)
  +pow1 = Bool.pick(U32, pw_up, U32.min((gb.u(s, "power") + 1 : U32), 10), gb.u(s, "power"))
  +pow2 = Bool.pick(U32, pw_dn, gb.ssub(pow1, 1), pow1)
  +s1 = gb.su(gb.su(s, "aim", aim2), "power", pow2)
  pastimes.siege.fight.reload(s1, tapped)
def pastimes.siege.fight.reload(+s: J.Val, +tapped: Bool) -> J.Val & J.Val:
  +reload = gb.u(s, "reload")
  +r1 = gb.ssub(reload, 1)
  +fling = Bool.and(Bool.and(U32.is_gt(reload, 0), U32.is_eq(r1, 0)), Bool.and(Bool.and(U32.is_le(gb.u(s, "soldiers"), 2), U32.is_gt(gb.u(s, "soldiers"), 0)), Bool.not(gb.b(s, "flung"))))
  +s1 = gb.sb(gb.su(gb.su(gb.su(gb.su(gb.su(s, "reload", r1), "limp", gb.ssub(gb.u(s, "limp"), 1)), "splat", gb.ssub(gb.u(s, "splat"), 1)), "moon", gb.ssub(gb.u(s, "moon"), 1)), "felled", gb.ssub(gb.u(s, "felled"), 1)), "flung", Bool.or(gb.b(s, "flung"), fling))
  +vl = (gb.u(s1, "volley_left") - 1 : U32)
  +s2 = gb.su(s1, "volley_left", vl)
  +s3 = Bool.pick(J.Val, U32.is_eq(vl, 0), gb.si(gb.su(s2, "volley_left", 60), "wind", pastimes.siege.next_wind(s2)), s2)
  +loaded = Bool.and(Bool.and(U32.is_eq(gb.u(s3, "reload"), 0), J.is_null(J.get(s3, "shot"))), U32.is_gt(gb.u(s3, "stones"), 0))
  pastimes.siege.fight.reload.k1(Bool.and(tapped, loaded), tapped, s3, loaded)

