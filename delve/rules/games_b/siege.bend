# The stone in flight: gravity, wind, a hit on the keep or the ground.
def pastimes.siege.step_shot(+s: J.Val) -> J.Val:
  +sh = J.get(s, "shot")
  pastimes.siege.step_shot.k1(J.is_null(sh), s, sh)

def pastimes.siege.step_shot.k1(cv: Bool, +s: J.Val, +sh: J.Val) -> J.Val:
  match cv:
    case True{}:
      s
    case False{}:
      +vy = RS.i_add(gb.i(sh, "vy"), 8)
      +x = RS.i_add(gb.i(sh, "x"), RS.i_add(gb.i(sh, "vx"), gb.i(sh, "wind")))
      +y = RS.i_add(gb.i(sh, "y"), vy)
      +sh1 = gb.si(gb.si(gb.si(sh, "vy", vy), "x", x), "y", y)
      pastimes.siege.step_shot.go(J.set(s, "shot", J.JNull{}), sh1, RS.i_div(x, 16), RS.i_div(y, 16))
def pastimes.siege.step_shot.go(+s: J.Val, +sh: J.Val, +px: U32, +py: U32) -> J.Val:
  pastimes.siege.step_shot.go.k1(Bool.and(RS.i_ge(px, 264), RS.i_lt(px, 300)), s, sh, px, py)

def pastimes.siege.step_shot.go.k3(cv: Bool, +s: J.Val, +sh: J.Val, +px: U32, +py: U32, +col: U32, +from_top: U32, +i: U32) -> J.Val:
  match cv:
    case True{}:
      pastimes.siege.step_shot.hit(s, sh, col, from_top)
    case False{}:
      pastimes.siege.step_shot.ground(s, sh, px, py)

def pastimes.siege.step_shot.go.k2(cv: Bool, +s: J.Val, +sh: J.Val, +px: U32, +py: U32, +col: U32, +base: U32, +rows: U32, +from_top: U32) -> J.Val:
  match cv:
    case True{}:
      +i = (col * rows + from_top : U32)
      pastimes.siege.step_shot.go.k3(Bool.and(U32.is_lt(i, J.len(J.get(J.get(s, "keep"), "blocks"))), U32.is_gt(gb.ag(J.get(J.get(s, "keep"), "blocks"), i), 0)), s, sh, px, py, col, from_top, i)
    case False{}:
      pastimes.siege.step_shot.ground(s, sh, px, py)

def pastimes.siege.step_shot.go.k1(cv: Bool, +s: J.Val, +sh: J.Val, +px: U32, +py: U32) -> J.Val:
  match cv:
    case True{}:
      +col = RS.i_div(RS.i_sub(px, 264), 12)
      +base = RS.i_sub(176, pastimes.siege.ground_at(s, RS.i_add(264, RS.i_add(RS.i_mul(col, 12), 6))))
      +rows = gb.u(J.get(s, "keep"), "rows")
      +from_top = RS.i_sub(RS.i_div(RS.i_add(RS.i_sub(base, py), 9), 10), 1)
      pastimes.siege.step_shot.go.k2(Bool.and(RS.i_lt(py, base), Bool.and(RS.i_ge(from_top, 0), RS.i_lt(from_top, rows))), s, sh, px, py, col, base, rows, from_top)
    case False{}:
      pastimes.siege.step_shot.ground(s, sh, px, py)
def pastimes.siege.step_shot.hit(+s: J.Val, +sh: J.Val, +col: U32, +row: U32) -> J.Val:
  pastimes.siege.step_shot.hit.k1(pastimes.siege.Keep.hit(J.get(s, "keep"), col, row, pastimes.siege.ammo_damage(gb.s(sh, "ammo"))), s, sh)

def pastimes.siege.step_shot.hit.k2(cv: Bool, +keep: J.Val, +s3: J.Val) -> J.Val:
  match cv:
    case True{}:
      gb.su(gb.su(s3, "taken", (gb.u(s3, "taken") + 1 : U32)), "cheer", 45)
    case False{}:
      s3

def pastimes.siege.step_shot.hit.k1(pr: J.Val & U32, +s: J.Val, +sh: J.Val) -> J.Val:
  (+keep, +done) = pr
  +s1 = gb.su(J.set(s, "keep", keep), "damage", (gb.u(s, "damage") + done : U32))
  +s2 = Bool.pick(J.Val, gb.b(sh, "flung"), gb.su(s1, "limp", 60), s1)
  +s3 = pastimes.siege.landed(s2, gb.i(sh, "x"), True{})
  pastimes.siege.step_shot.hit.k2(Bool.and(Bool.not(gb.b(keep, "banner")), U32.is_eq(gb.u(s3, "cheer"), 0)), keep, s3)
def pastimes.siege.step_shot.ground(+s: J.Val, +sh: J.Val, +px: U32, +py: U32) -> J.Val:
  +ground = RS.i_sub(176, pastimes.siege.ground_at(s, px))
  pastimes.siege.step_shot.ground.k1(Bool.or(RS.i_ge(py, ground), RS.i_ge(px, 384)), s, sh, px, py, ground)

def pastimes.siege.step_shot.ground.k1(cv: Bool, +s: J.Val, +sh: J.Val, +px: U32, +py: U32, +ground: U32) -> J.Val:
  match cv:
    case True{}:
      +s1 = pastimes.siege.dig(s, px)
      +s2 = Bool.pick(J.Val, gb.b(sh, "flung"), gb.su(s1, "limp", 60), s1)
      pastimes.siege.landed(s2, gb.i(sh, "x"), RS.i_lt(px, 264))
    case False{}:
      J.set(s, "shot", sh)
# The castle's pots: a timer, a toss at the engine's side, a wound if close.
def pastimes.siege.step_keep_shot(+s: J.Val) -> J.Val:
  +s1 = gb.su(s, "pot", gb.ssub(gb.u(s, "pot"), 1))
  +cs = J.get(s1, "castle_shot")
  +keep = J.get(s1, "keep")
  pastimes.siege.step_keep_shot.k1(J.is_null(cs), s1, cs, keep)

def pastimes.siege.step_keep_shot.k3(cv: Bool, +s1: J.Val, +keep: J.Val, +left: U32) -> J.Val:
  match cv:
    case True{}:
      +off = pastimes.siege.POT_LAND(U32.mod(gb.u(keep, "volleys"), 5))
      +land = RS.i_add(36, off)
      +dist = RS.i_sub(276, land)
      +vx = RS.i_div(RS.i_mul(RS.i_neg(dist), 16), 45)
      +k2 = gb.su(gb.su(keep, "shot_left", 90), "volleys", (gb.u(keep, "volleys") + 1 : U32))
      gb.si(gb.su(J.set(J.set(s1, "keep", k2), "castle_shot", pastimes.siege.shot(RS.i_mul(276, 16), RS.i_mul(126, 16), vx, RS.i_neg(180), 0, "boulder", False{})), "pot", 10), "pot_land", land)
    case False{}:
      J.set(s1, "keep", gb.su(keep, "shot_left", left))

def pastimes.siege.step_keep_shot.k2(cv: Bool, +s1: J.Val, +keep: J.Val) -> J.Val:
  match cv:
    case True{}:
      s1
    case False{}:
      +left = gb.ssub(gb.u(keep, "shot_left"), 1)
      pastimes.siege.step_keep_shot.k3(U32.is_eq(left, 0), s1, keep, left)

def pastimes.siege.step_keep_shot.k4(cv: Bool, +s1: J.Val, +cs: J.Val, +vy: U32, +x: U32, +y: U32, +px: U32, +py: U32) -> J.Val:
  match cv:
    case True{}:
      pastimes.siege.wound(J.set(s1, "castle_shot", J.JNull{}), px)
    case False{}:
      J.set(s1, "castle_shot", gb.si(gb.si(gb.si(cs, "vy", vy), "x", x), "y", y))

def pastimes.siege.step_keep_shot.k1(cv: Bool, +s1: J.Val, +cs: J.Val, +keep: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.siege.step_keep_shot.k2(Bool.or(U32.is_eq(gb.u(keep, "defenders"), 0), Bool.not(gb.b(keep, "banner"))), s1, keep)
    case False{}:
      +vy = RS.i_add(gb.i(cs, "vy"), 8)
      +x = RS.i_add(gb.i(cs, "x"), gb.i(cs, "vx"))
      +y = RS.i_add(gb.i(cs, "y"), vy)
      +px = RS.i_div(x, 16)
      +py = RS.i_div(y, 16)
      pastimes.siege.step_keep_shot.k4(Bool.or(RS.i_ge(py, RS.i_sub(176, pastimes.siege.ground_at(s1, px))), RS.i_le(px, 0)), s1, cs, vy, x, y, px, py)
def pastimes.siege.wound(+s: J.Val, +px: U32) -> J.Val:
  pastimes.siege.wound.k1(Bool.and(U32.is_le(RS.u_abs_diff(px, gb.i(s, "pot_land")), 14), U32.is_gt(gb.u(s, "soldiers"), 0)), s, px)

def pastimes.siege.wound.k1(cv: Bool, +s: J.Val, +px: U32) -> J.Val:
  match cv:
    case True{}:
      +lost = (gb.u(s, "lost") + 1 : U32)
      +slot = U32.min(gb.u(s, "taken"), 4)
      pastimes.siege.grave_at(gb.su(gb.su(gb.su(s, "soldiers", (gb.u(s, "soldiers") - 1 : U32)), "lost", lost), "felled", 30), slot, lost)
    case False{}:
      s
def pastimes.siege.grave_at(+s: J.Val, +slot: U32, +lost: U32) -> J.Val:
  J.set(s, "graves", gb.as(J.get(s, "graves"), slot, gb.ssub(U32.min(lost, 7), 1)))
# Run::tick_siege
def pastimes.siege.Run.tick_siege(+run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>) -> J.Val & (J.Val & Bool):
  +b = J.get(round, "siege")
  +owner = gb.u(b, "owner")
  pastimes.siege.Run.tick_siege.k1(Bool.not(pastimes.has_el(elig, owner)), run, round, inputs, elig, b, owner)

def pastimes.siege.Run.tick_siege.k2(pr: J.Val & J.Val, +run: J.Val, +round: J.Val, +b: J.Val) -> J.Val & (J.Val & Bool):
  (+b1, +ret) = pr
  pastimes.siege.tick.after(run, round, b, b1, Bool.and(Bool.not(J.is_null(ret)), gb.b(J.set(J.obj(), "v", ret), "v")))

def pastimes.siege.Run.tick_siege.k1(cv: Bool, +run: J.Val, +round: J.Val, +inputs: J.Val, +elig: List<&2, J.Val>, +b: J.Val, +owner: U32) -> J.Val & (J.Val & Bool):
  match cv:
    case True{}:
      (gb.found(run, 0, "ENGINE ABANDONED."), (round, False{}))
    case False{}:
      +inp = pastimes.input_of(inputs, owner)
      pastimes.siege.Run.tick_siege.k2(pastimes.siege.Siege.step(b, inp, gb.b(inp, "fire")), run, round, b)
def pastimes.siege.tick.after(+run: J.Val, +round: J.Val, +b: J.Val, +b1: J.Val, +alive: Bool) -> J.Val & (J.Val & Bool):
  +run1 = Bool.pick(J.Val, Bool.and(J.is_null(J.get(b, "shot")), Bool.not(J.is_null(J.get(b1, "shot")))), gb.sound(run, "bomb_toss"), run)
  +run2 = Bool.pick(J.Val, U32.is_eq(gb.u(b1, "splat"), 6), gb.sound(run1, "bomb"), run1)
  +taken = gb.u(b1, "taken")
  +breach = U32.is_gt(taken, gb.u(round, "progress"))
  +r1 = Bool.pick(J.Val, breach, pastimes.popup(gb.su(round, "progress", taken), "BREACH!", 12, 6), gb.su(round, "progress", taken))
  +run3 = Bool.pick(J.Val, breach, gb.sound(run2, "wall_up"), run2)
  +r2 = Bool.pick(J.Val, Bool.or(Bool.not(J.is_null(J.get(b1, "shot"))), Bool.not(J.is_null(J.get(b1, "castle_shot")))), gb.su(r1, "hazard_left", 4), r1)
  +run4 = Bool.pick(J.Val, Bool.and(U32.is_eq(gb.u(b1, "cheer"), 45), U32.is_eq(taken, gb.u(r2, "progress"))), gb.sound(run3, "spoil_pickup"), run3)
  +run5 = Bool.pick(J.Val, U32.is_eq(gb.u(b1, "mourn"), 45), gb.sound(run4, "hero_hurt"), run4)
  +run6 = Bool.pick(J.Val, U32.is_eq(gb.u(b1, "moon"), 45), gb.sound(run5, "clang"), run5)
  (run6, (J.set(r2, "siege", b1), alive))
def pastimes.case.siege_step(+i: J.Val) -> J.Val:
  pastimes.case.siege_step.k1(pastimes.siege.Siege.step(J.get(i, "s"), J.get(i, "input"), gb.b(i, "tapped")))

def pastimes.case.siege_step.k1(pr: J.Val & J.Val) -> J.Val:
  (+s, +ret) = pr
  J.set(J.set(J.obj(), "s", s), "ret", ret)
def case.pastimes.siege.Siege.step(+i: J.Val) -> J.Val:
  pastimes.case.siege_step(i)
