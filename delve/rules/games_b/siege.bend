def pastimes.siege.event(+s: J.Val) -> J.Val:
  +leg = gb.u(s, "leg")
  +paid = Bool.and(Bool.and(U32.is_eq(leg, 1), gb.b(s, "event_f")), U32.is_gt(gb.u(s, "stones"), 0))
  +loss0 = Bool.pick(U32, paid, 0, Bool.pick(U32, gb.b(s, "event_f"), 2, 1))
  +hungry = U32.is_eq(gb.u(s, "food"), 0)
  +loss = (loss0 + Bool.to_u32(hungry) : U32)
  +before = gb.u(s, "soldiers")
  +after = gb.ssub(before, loss)
  +gone = (before - after : U32)
  +lost = (gb.u(s, "lost") + gone : U32)
  +leg_notice = Bool.pick(U32, U32.is_eq(leg, 1), 3, Bool.pick(U32, U32.is_eq(leg, 2), 4, Bool.pick(U32, U32.is_eq(leg, 3), 5, Bool.pick(U32, U32.is_eq(leg, 4), 8, 9))))
  +notice = Bool.pick(U32, paid, 6, Bool.pick(U32, Bool.and(hungry, U32.is_gt(gone, 0)), 6, Bool.pick(U32, U32.is_gt(gone, 0), leg_notice, 7)))
  +s1 = gb.su(gb.su(gb.su(gb.su(gb.su(s, "soldiers", after), "lost", lost), "food", gb.ssub(gb.u(s, "food"), 1)), "stones", Bool.pick(U32, paid, (gb.u(s, "stones") - 1 : U32), gb.u(s, "stones"))), "notice", notice)
