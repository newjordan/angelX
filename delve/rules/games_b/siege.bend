  pastimes.siege.fight.after(gb.su(gb.su(J.set(s4, "shot", shot), "stones", (gb.u(s4, "stones") - 1 : U32)), "reload", pastimes.siege.reload_ticks(s4)))

def pastimes.siege.fight.reload.k1(cv: Bool, +tapped: Bool, +s3: J.Val, +loaded: Bool) -> J.Val & J.Val:
