  +stun = pastimes.gander.rd(g, i, "stun")
  +seat = pastimes.gander.rd(g, i, "seat")
  +nk = pastimes.gander.near_knight(g, count, x0, 0, 4294967295, 0)
  +target_x = Bool.pick(U32, Bool.or(knight, U32.is_eq(nk, 4294967295)), x0, pastimes.gander.rd(g, Bool.pick(U32, U32.is_eq(nk, 4294967295), 0, nk), "x"))
  +dy0 = pastimes.gander.rd(g, i, "dy")
  +y0 = pastimes.gander.rd(g, i, "y")
  +flap = Bool.pick(Bool, knight, Bool.and(pastimes.tapped_has(tapped, seat), U32.is_eq(stun, 0)), Bool.and(Bool.or(RS.i_gt(dy0, 42), RS.i_gt(y0, RS.i_add(pastimes.gander.rd(g, i, "lane"), 96))), U32.is_eq(stun, 0)))
  +dy1 = RS.i_clamp(RS.i_add(dy0, 14), RS.i_neg(48), 96)
  +dy2 = Bool.pick(U32, flap, RS.i_min(dy1, RS.i_neg(52)), dy1)
  +c1 = Bool.pick(J.Val, Bool.and(flap, knight), J.set(c, "run", gb.sound(J.get(c, "run"), "swing")), c)
  +inp = J.get(inputs, U32.show(seat))
  +lean = Bool.pick(U32, knight, Bool.pick(U32, Bool.and(Bool.not(J.is_null(inp)), rules.Input.valid(inp)), gb.i(inp, "aim_x"), 0), Bool.pick(U32, U32.is_eq(U32.mod(i, 2), 0), RS.i_signum(RS.i_sub(target_x, x0)), 0))
  +dx0 = pastimes.gander.rd(g, i, "dx")
  +dx1 = Bool.pick(U32, U32.is_eq(stun, 0), RS.i_clamp(RS.i_add(dx0, RS.i_mul(lean, 28)), RS.i_neg(72), 72), dx0)
  +x1 = RS.i_clamp(RS.i_add(x0, dx1), 256, 5632)
  +y1 = RS.i_add(y0, dy2)
  +top = RS.i_lt(y1, 640)
  +low = RS.i_gt(y1, 2816)
  +y2 = Bool.pick(U32, top, 640, Bool.pick(U32, low, 2816, y1))
  +dy3 = Bool.pick(U32, top, RS.i_max(dy2, 0), Bool.pick(U32, low, 0, dy2))
