      pastimes.gander.mistake_ctx(J.set(pastimes.gander.with_g(c, g1), "run", run))
    case False{}:
      +g1 = pastimes.gander.wru(pastimes.gander.wru(g, i, "down", 20), i, "stun", 0)
      pastimes.gander.felled(pastimes.gander.with_g(c, g1), i)
def pastimes.gander.mistake_ctx(+c: J.Val) -> J.Val:
  J.set(c, "round", pastimes.mistake(J.get(c, "round")))
# felled: a unhorsed rider's egg drops on the ledge it was over, if that
# ledge has none yet.
def pastimes.gander.felled(+c: J.Val, +v: U32) -> J.Val:
  +g = pastimes.gander.cg(c)
  +x = pastimes.gander.rd(g, v, "x")
  +y = pastimes.gander.rd(g, v, "y")
  +k = pastimes.gander.ledge_under(x, y, 0)
  pastimes.gander.felled.k1(U32.is_ge(k, 3), c, v, g, x, k)

def pastimes.gander.felled.k2(cv: Bool, +c: J.Val, +v: U32, +g: J.Val, +x: U32, +row: U32) -> J.Val:
  match cv:
    case True{}:
      c
    case False{}:
      +egg = gb.su(gb.si(gb.si(gb.si(J.obj(), "x", x), "row", row), "dir", pastimes.gander.rd(g, v, "face")), "left", 150)
      pastimes.gander.with_g(c, J.set(g, "eggs", J.push(J.get(g, "eggs"), egg)))

def pastimes.gander.felled.k1(cv: Bool, +c: J.Val, +v: U32, +g: J.Val, +x: U32, +k: U32) -> J.Val:
  match cv:
    case True{}:
      c
    case False{}:
      +row = pastimes.gander.LEDGE_ROW(k)
      pastimes.gander.felled.k2(pastimes.gander.egg_on(J.items(J.get(g, "eggs")), row), c, v, g, x, row)
def pastimes.gander.ledge_under(+x: U32, +y: U32, +k: U32) -> U32:
  pastimes.gander.ledge_under.k1(U32.is_ge(k, 3), x, y, k)

def pastimes.gander.ledge_under.k2(cv: Bool, +x: U32, +y: U32, +k: U32, +hit: Bool) -> U32:
  match cv:
    case True{}:
      k
    case False{}:
      pastimes.gander.ledge_under(x, y, (k + 1 : U32))

def pastimes.gander.ledge_under.k1(cv: Bool, +x: U32, +y: U32, +k: U32) -> U32:
  match cv:
    case True{}:
      3
    case False{}:
      +row = pastimes.gander.LEDGE_ROW(k)
      +hit = Bool.and(Bool.and(RS.i_ge(y, RS.i_mul(RS.i_sub(row, 1), 256)), RS.i_le(y, RS.i_mul(RS.i_add(row, 2), 256))), Bool.and(RS.i_ge(x, (pastimes.gander.LEDGE_X0(k) * 256 : U32)), RS.i_le(x, (pastimes.gander.LEDGE_X1(k) * 256 : U32))))
      pastimes.gander.ledge_under.k2(hit, x, y, k, hit)
def pastimes.gander.egg_on(+es: List<&2, J.Val>, +row: U32) -> Bool:
  match es:
    case Nil{}:
      False{}
    case Con{+e, +t}:
      Bool.or(U32.is_eq(gb.u(e, "row"), row), pastimes.gander.egg_on(t, row))
# ---- collisions --------------------------------------------------------------------------------------

# Whether rider i may take part in a clack this moment.
def pastimes.gander.free(+g: J.Val, +i: U32) -> Bool:
  Bool.and(Bool.and(U32.is_eq(pastimes.gander.rd(g, i, "stun"), 0), U32.is_eq(pastimes.gander.rd(g, i, "down"), 0)), U32.is_eq(pastimes.gander.rd(g, i, "clash"), 0))
def pastimes.gander.touching(+g: J.Val, +a: U32, +b: U32) -> Bool:
  Bool.and(U32.is_lt(RS.u_abs_diff(pastimes.gander.rd(g, a, "x"), pastimes.gander.rd(g, b, "x")), 200), U32.is_lt(RS.u_abs_diff(pastimes.gander.rd(g, a, "y"), pastimes.gander.rd(g, b, "y")), 176))
# The pairs touching now, as a*8+b in ascending order.
def pastimes.gander.pairs(+g: J.Val, +n: U32, +a: U32, +b: U32, +acc: List<&2, U32>) -> List<&2, U32>:
  pastimes.gander.pairs.k1(U32.is_ge(a, n), g, n, a, b, acc)

def pastimes.gander.pairs.k2(cv: Bool, +g: J.Val, +n: U32, +a: U32, +b: U32, +acc: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      pastimes.gander.pairs(g, n, (a + 1 : U32), (a + 2 : U32), acc)
    case False{}:
      +hit = Bool.and(Bool.and(pastimes.gander.free(g, a), pastimes.gander.free(g, b)), pastimes.gander.touching(g, a, b))
      pastimes.gander.pairs(g, n, a, (b + 1 : U32), Bool.pick(List<&2, U32>, hit, List.append(&2, U32, acc, [(a * 8 + b : U32)]), acc))

def pastimes.gander.pairs.k1(cv: Bool, +g: J.Val, +n: U32, +a: U32, +b: U32, +acc: List<&2, U32>) -> List<&2, U32>:
  match cv:
    case True{}:
      acc
    case False{}:
      pastimes.gander.pairs.k2(U32.is_ge(b, n), g, n, a, b, acc)
def pastimes.gander.clacks(+c: J.Val, +count: U32) -> J.Val:
  +g = pastimes.gander.cg(c)
  +n = (count + 3 : U32)
  pastimes.gander.clack_each(c, pastimes.gander.pairs(g, n, 0, 1, []))
def pastimes.gander.clack_each(+c: J.Val, +ps: List<&2, U32>) -> J.Val:
  match ps:
    case Nil{}:
      c
    case Con{+p, +t}:
      pastimes.gander.clack_each(pastimes.gander.clack_pair(c, U32.div(p, 8), U32.mod(p, 8)), t)
def pastimes.gander.clack_pair(+c: J.Val, +a: U32, +b: U32) -> J.Val:
  +g = pastimes.gander.cg(c)
  +skip = Bool.or(Bool.or(U32.is_ne(pastimes.gander.rd(g, a, "clash"), 0), U32.is_ne(pastimes.gander.rd(g, b, "clash"), 0)), Bool.or(U32.is_gt(pastimes.gander.rd(g, a, "stun"), 0), U32.is_gt(pastimes.gander.rd(g, b, "stun"), 0)))
  pastimes.gander.clack_pair.k1(skip, c, a, b, g, skip)

def pastimes.gander.clack_pair.k3(cv: Bool, +c: J.Val, +a: U32, +b: U32, +g: J.Val, +below: Bool) -> J.Val:
  match cv:
    case True{}:
      pastimes.gander.decide(c, b, a)
    case False{}:
      +da = RS.i_neg(RS.i_clamp(RS.i_mul(RS.i_signum(pastimes.gander.rd(g, a, "dx")), 48), RS.i_neg(72), 72))
      +db = RS.i_neg(RS.i_clamp(RS.i_mul(RS.i_signum(pastimes.gander.rd(g, b, "dx")), 48), RS.i_neg(72), 72))
      +g1 = pastimes.gander.wr(pastimes.gander.wr(pastimes.gander.wru(pastimes.gander.wru(g, a, "clash", b), b, "clash", a), a, "dx", da), b, "dx", db)
      pastimes.gander.with_g(c, g1)

def pastimes.gander.clack_pair.k2(cv: Bool, +c: J.Val, +a: U32, +b: U32, +g: J.Val, +above: Bool, +below: Bool) -> J.Val:
  match cv:
    case True{}:
      pastimes.gander.decide(c, a, b)
    case False{}:
      pastimes.gander.clack_pair.k3(below, c, a, b, g, below)

def pastimes.gander.clack_pair.k1(cv: Bool, +c: J.Val, +a: U32, +b: U32, +g: J.Val, +skip: Bool) -> J.Val:
  match cv:
    case True{}:
      c
    case False{}:
      +above = RS.i_lt(RS.i_add(pastimes.gander.rd(g, a, "y"), 40), pastimes.gander.rd(g, b, "y"))
      +below = RS.i_lt(RS.i_add(pastimes.gander.rd(g, b, "y"), 40), pastimes.gander.rd(g, a, "y"))
      pastimes.gander.clack_pair.k2(above, c, a, b, g, above, below)
# `w` is above `v`: a knight winning clacks; a rival winning unhorses a knight
# or knocks another rival down.
def pastimes.gander.decide(+c: J.Val, +w: U32, +v: U32) -> J.Val:
  +g = pastimes.gander.cg(c)
  pastimes.gander.decide.k1(U32.is_eq(pastimes.gander.rd(g, w, "who"), 0), c, w, v, g)

def pastimes.gander.decide.k2(cv: Bool, +c: J.Val, +v: U32, +g: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.gander.unhorse_knight(c, v)
    case False{}:
      +c1 = pastimes.gander.felled(c, v)
      pastimes.gander.with_g(c1, pastimes.gander.wru(pastimes.gander.cg(c1), v, "down", 20))

def pastimes.gander.decide.k1(cv: Bool, +c: J.Val, +w: U32, +v: U32, +g: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.gander.clack(c, w, v)
    case False{}:
      pastimes.gander.decide.k2(U32.is_eq(pastimes.gander.rd(g, v, "who"), 0), c, v, g)
def pastimes.gander.popup_at(+c: J.Val, +text: String, +i: U32) -> J.Val:
  +g = pastimes.gander.cg(c)
  J.set(c, "round", pastimes.popup(J.get(c, "round"), text, RS.i_div(pastimes.gander.rd(g, i, "x"), 256), RS.i_div(pastimes.gander.rd(g, i, "y"), 256)))
def pastimes.gander.tally_up(+g: J.Val, +i: U32) -> J.Val:
  J.set(g, "tally", J.set_nth(J.get(g, "tally"), i, J.JU{U32.min(gb.sadd(J.u32(J.nth(J.get(g, "tally"), i)), 1), 8)}))
def pastimes.gander.clack(+c: J.Val, +w: U32, +v: U32) -> J.Val:
  +g = pastimes.gander.cg(c)
  +seat = pastimes.gander.rd(g, w, "seat")
  +c1 = pastimes.gander.popup_at(pastimes.gander.with_g(c, pastimes.gander.tally_up(g, w)), "CLACK!", w)
  +g2 = pastimes.gander.wru(pastimes.gander.wru(pastimes.gander.cg(c1), w, "clash", v), v, "clash", w)
  +g3 = Bool.pick(J.Val, U32.is_eq(pastimes.gander.rd(g2, v, "who"), 0), pastimes.gander.wr(pastimes.gander.wru(g2, v, "stun", 9), v, "dy", 0), pastimes.gander.wru(pastimes.gander.wru(g2, v, "down", 20), v, "stun", 0))
  +c2 = J.set(pastimes.gander.with_g(c1, g3), "run", gb.found(gb.sound(J.get(c1, "run"), "clang"), seat, "CLACK! OFF IT COMES."))
  pastimes.gander.felled(c2, v)
def pastimes.gander.unhorse_knight(+c: J.Val, +v: U32) -> J.Val:
  +g = pastimes.gander.cg(c)
  +seat = pastimes.gander.rd(g, v, "seat")
  +g1 = pastimes.gander.wr(pastimes.gander.wru(pastimes.gander.wru(g, v, "stun", 9), v, "clash", 0), v, "dy", 0)
  +c1 = pastimes.mistake_ctx(J.set(pastimes.gander.with_g(c, g1), "run", gb.found(gb.sound(gb.sound(J.get(c, "run"), "hit"), "knight_fall"), seat, "UNHORSED! CLIMB AGAIN.")))
  pastimes.gander.felled(c1, v)
def pastimes.mistake_ctx(+c: J.Val) -> J.Val:
  J.set(c, "round", pastimes.mistake(J.get(c, "round")))
# A clash ends when the other is gone or the riders have drawn apart.
def pastimes.gander.unclash(+c: J.Val, +i: U32) -> J.Val:
  +g = pastimes.gander.cg(c)
  pastimes.gander.unclash.k1(U32.is_ge(i, J.len(J.get(g, "riders"))), c, i, g)

def pastimes.gander.unclash.k1(cv: Bool, +c: J.Val, +i: U32, +g: J.Val) -> J.Val:
  match cv:
    case True{}:
      c
    case False{}:
      +cl = pastimes.gander.rd(g, i, "clash")
      +gone = Bool.and(U32.is_ne(cl, 0), Bool.or(Bool.or(U32.is_ge(cl, J.len(J.get(g, "riders"))), U32.is_gt(pastimes.gander.rd(g, Bool.pick(U32, U32.is_ge(cl, J.len(J.get(g, "riders"))), 0, cl), "down"), 0)), Bool.not(pastimes.gander.touching(g, i, Bool.pick(U32, U32.is_ge(cl, J.len(J.get(g, "riders"))), 0, cl)))))
      pastimes.gander.unclash(pastimes.gander.with_g(c, Bool.pick(J.Val, gone, pastimes.gander.wru(g, i, "clash", 0), g)), (i + 1 : U32))
# ---- the eggs -------------------------------------------------------------------------------------------

def pastimes.gander.eggs_turn(+c: J.Val, +count: U32) -> J.Val:
  +g = pastimes.gander.cg(c)
  +n = J.len(J.get(g, "eggs"))
  pastimes.gander.eggs_turn.k1(pastimes.gander.eggs_each(c, count, n, 1000), count)

def pastimes.gander.eggs_turn.k2(cv: Bool, +count: U32, +c1: J.Val, +hatch: U32) -> J.Val:
  match cv:
    case True{}:
      pastimes.gander.hatch(c1, count, hatch)
    case False{}:
      c1

def pastimes.gander.eggs_turn.k1(pr: J.Val & U32, +count: U32) -> J.Val:
  (+c1, +hatch) = pr
  pastimes.gander.eggs_turn.k2(U32.is_lt(hatch, 1000), count, c1, hatch)
# Eggs from the last to the first; the lowest to run out hatches.
def pastimes.gander.eggs_each(+c: J.Val, +count: U32, +k: U32, +hatch: U32) -> J.Val & U32:
  pastimes.gander.eggs_each.k1(U32.is_eq(k, 0), c, count, k, hatch)

def pastimes.gander.eggs_each.k4(cv: Bool, +count: U32, +hatch: U32, +i: U32, +t: U32, +g2: J.Val, +c2: J.Val) -> J.Val & U32:
  match cv:
    case True{}:
      +seat = pastimes.gander.rd(g2, t, "seat")
      +c3 = pastimes.gander.popup_at(pastimes.gander.with_g(c2, pastimes.gander.tally_up(g2, t)), "EGG!", t)
      pastimes.gander.eggs_each(J.set(c3, "run", gb.found(gb.sound(J.get(c3, "run"), "spoil_pickup"), seat, "EGG! A BONUS CLACK.")), count, i, hatch)
    case False{}:
      pastimes.gander.eggs_each(c2, count, i, hatch)

def pastimes.gander.eggs_each.k3(cv: Bool, +c: J.Val, +count: U32, +hatch: U32, +i: U32, +g1: J.Val, +t: U32) -> J.Val & U32:
  match cv:
    case True{}:
      pastimes.gander.eggs_each(pastimes.gander.with_g(c, g1), count, i, hatch)
    case False{}:
      +g2 = J.set(g1, "eggs", J.JA{pastimes.gander.drop_nth(J.items(J.get(g1, "eggs")), i)})
      +c2 = pastimes.gander.with_g(c, g2)
      pastimes.gander.eggs_each.k4(Bool.and(U32.is_eq(pastimes.gander.rd(g2, t, "who"), 0), U32.is_lt(t, count)), count, hatch, i, t, g2, c2)

def pastimes.gander.eggs_each.k2(cv: Bool, +c: J.Val, +count: U32, +hatch: U32, +i: U32, +e: J.Val, +x: U32, +left: U32, +g1: J.Val) -> J.Val & U32:
  match cv:
    case True{}:
      pastimes.gander.eggs_each(pastimes.gander.with_g(c, g1), count, i, i)
    case False{}:
      +t = pastimes.gander.egg_touch(g1, x, gb.u(e, "row"), 0)
      pastimes.gander.eggs_each.k3(U32.is_ge(t, 100), c, count, hatch, i, g1, t)

def pastimes.gander.eggs_each.k1(cv: Bool, +c: J.Val, +count: U32, +k: U32, +hatch: U32) -> J.Val & U32:
  match cv:
    case True{}:
      (c, hatch)
    case False{}:
      +i = (k - 1 : U32)
      +g = pastimes.gander.cg(c)
      +e = J.nth(J.get(g, "eggs"), i)
      +ledge = pastimes.gander.ledge_row(gb.u(e, "row"), 0)
      +lo = (pastimes.gander.LEDGE_X0(ledge) * 256 + 16 : U32)
      +hi = (pastimes.gander.LEDGE_X1(ledge) * 256 - 16 : U32)
      +x = RS.i_clamp(RS.i_add(gb.i(e, "x"), RS.i_mul(gb.i(e, "dir"), 40)), lo, hi)
      +dir = Bool.pick(U32, Bool.or(U32.is_eq(x, lo), U32.is_eq(x, hi)), RS.i_neg(gb.i(e, "dir")), gb.i(e, "dir"))
      +left = gb.ssub(gb.u(e, "left"), 1)
      +e1 = gb.su(gb.si(gb.si(e, "x", x), "dir", dir), "left", left)
      +g1 = J.set(g, "eggs", J.set_nth(J.get(g, "eggs"), i, e1))
      pastimes.gander.eggs_each.k2(U32.is_eq(left, 0), c, count, hatch, i, e, x, left, g1)
def pastimes.gander.ledge_row(+row: U32, +k: U32) -> U32:
  pastimes.gander.ledge_row.k1(Bool.or(U32.is_ge(k, 3), U32.is_eq(pastimes.gander.LEDGE_ROW(k), row)), row, k)

def pastimes.gander.ledge_row.k1(cv: Bool, +row: U32, +k: U32) -> U32:
  match cv:
    case True{}:
      U32.min(k, 2)
    case False{}:
      pastimes.gander.ledge_row(row, (k + 1 : U32))
def pastimes.gander.drop_nth(+xs: List<&2, J.Val>, +i: U32) -> List<&2, J.Val>:
  match xs:
    case Nil{}:
      []
    case Con{+h, +t}:
      pastimes.gander.drop_nth.k1(U32.is_eq(i, 0), i, h, t)

def pastimes.gander.drop_nth.k1(cv: Bool, +i: U32, +h: J.Val, +t: List<&2, J.Val>) -> List<&2, J.Val>:
  match cv:
    case True{}:
      t
    case False{}:
      h <> pastimes.gander.drop_nth(t, (i - 1 : U32))
# The first rider (not stunned, not down) touching an egg, or 100.
def pastimes.gander.egg_touch(+g: J.Val, +ex: U32, +row: U32, +i: U32) -> U32:
  pastimes.gander.egg_touch.k1(U32.is_ge(i, J.len(J.get(g, "riders"))), g, ex, row, i)

def pastimes.gander.egg_touch.k2(cv: Bool, +g: J.Val, +ex: U32, +row: U32, +i: U32, +hit: Bool) -> U32:
  match cv:
    case True{}:
      i
    case False{}:
      pastimes.gander.egg_touch(g, ex, row, (i + 1 : U32))

def pastimes.gander.egg_touch.k1(cv: Bool, +g: J.Val, +ex: U32, +row: U32, +i: U32) -> U32:
  match cv:
    case True{}:
      100
    case False{}:
      +hit = Bool.and(Bool.and(U32.is_eq(pastimes.gander.rd(g, i, "stun"), 0), U32.is_eq(pastimes.gander.rd(g, i, "down"), 0)), Bool.and(U32.is_lt(RS.u_abs_diff(pastimes.gander.rd(g, i, "x"), ex), 128), U32.is_lt(RS.u_abs_diff(pastimes.gander.rd(g, i, "y"), (row * 256 : U32)), 128)))
      pastimes.gander.egg_touch.k2(hit, g, ex, row, i, hit)
# An egg hatches into the first downed rival's slot (or the first rival's).
def pastimes.gander.hatch(+c: J.Val, +count: U32, +k: U32) -> J.Val:
  +g = pastimes.gander.cg(c)
  +e = J.nth(J.get(g, "eggs"), k)
  +g1 = J.set(g, "eggs", J.JA{pastimes.gander.drop_nth(J.items(J.get(g, "eggs")), k)})
  +slot = pastimes.gander.down_slot(g1, count, count)
  +dir = gb.i(e, "dir")
  +row = gb.i(e, "row")
  +g2 = pastimes.gander.wr(pastimes.gander.wr(pastimes.gander.wr(g1, slot, "x", RS.i_clamp(gb.i(e, "x"), 256, 5632)), slot, "y", RS.i_mul(RS.i_max(RS.i_sub(row, 2), 2), 256)), slot, "dx", Bool.pick(U32, RS.i_gt(dir, 0), 40, RS.i_neg(40)))
  +g3 = pastimes.gander.wr(pastimes.gander.wr(pastimes.gander.wr(g2, slot, "dy", 0), slot, "face", dir), slot, "lane", RS.i_mul(row, 256))
  +g4 = pastimes.gander.wru(pastimes.gander.wru(pastimes.gander.wru(g3, slot, "stun", 0), slot, "clash", 0), slot, "down", 0)
  J.set(pastimes.gander.with_g(c, g4), "run", gb.found(gb.sound(J.get(c, "run"), "clang"), 0, "AN EGG HATCHED! A RIVAL RIDES."))
# The first rival slot (count..count+3) that is down, else `count`.
def pastimes.gander.down_slot(+g: J.Val, +count: U32, +i: U32) -> U32:
  pastimes.gander.down_slot.k1(U32.is_ge(i, (count + 3 : U32)), g, count, i)

def pastimes.gander.down_slot.k2(cv: Bool, +g: J.Val, +count: U32, +i: U32) -> U32:
  match cv:
    case True{}:
      i
    case False{}:
      pastimes.gander.down_slot(g, count, (i + 1 : U32))

def pastimes.gander.down_slot.k1(cv: Bool, +g: J.Val, +count: U32, +i: U32) -> U32:
  match cv:
    case True{}:
      count
    case False{}:
      pastimes.gander.down_slot.k2(U32.is_gt(pastimes.gander.rd(g, i, "down"), 0), g, count, i)
# ---- the heroes follow their riders -----------------------------------------------------------------------

def pastimes.gander.seat_heroes(+c: J.Val, +i: U32) -> J.Val:
  +g = pastimes.gander.cg(c)
  +seats = J.get(g, "seats")
  pastimes.gander.seat_heroes.k1(U32.is_ge(i, 6), c, i, g, seats)

def pastimes.gander.seat_heroes.k3(cv: Bool, +c: J.Val, +i: U32, +g: J.Val, +seat: U32, +run: J.Val, +h: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.gander.seat_heroes(c, (i + 1 : U32))
    case False{}:
      +x = (RS.i_as_f32(pastimes.gander.rd(g, i, "x")) / 256.0 * 2.0 : F32)
      +y = (RS.i_as_f32(pastimes.gander.rd(g, i, "y")) / 256.0 * 2.0 : F32)
      pastimes.gander.seat_heroes(J.set(c, "run", J.set(run, "players", J.set(J.get(run, "players"), U32.show(seat), gb.sf(gb.sf(h, "x", x), "y", y)))), (i + 1 : U32))

def pastimes.gander.seat_heroes.k2(cv: Bool, +c: J.Val, +i: U32, +g: J.Val, +seats: J.Val) -> J.Val:
  match cv:
    case True{}:
      pastimes.gander.seat_heroes(c, (i + 1 : U32))
    case False{}:
      +seat = J.u32(J.nth(seats, i))
      +run = J.get(c, "run")
      +h = J.get(J.get(run, "players"), U32.show(seat))
      pastimes.gander.seat_heroes.k3(Bool.or(U32.is_eq(seat, 0), J.is_null(h)), c, i, g, seat, run, h)

def pastimes.gander.seat_heroes.k1(cv: Bool, +c: J.Val, +i: U32, +g: J.Val, +seats: J.Val) -> J.Val:
  match cv:
    case True{}:
      c
    case False{}:
      pastimes.gander.seat_heroes.k2(U32.is_ge(i, J.len(seats)), c, i, g, seats)
