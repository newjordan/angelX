# crates/delve/src/rules/dares.rs — Fortune's dares.

def dares.CLOCK() -> U32:
  7200

def dares.QUICK() -> U32:
  1350

# DareKind::word
def dares.DareKind.word(+kind: String) -> String:
  if String.eq(kind, "untouched"):
    "untouched"
  else:
    if String.eq(kind, "stand_firm"):
      "stand_firm"
    else:
      if String.eq(kind, "against_the_clock"):
        "clock"
      else:
        if String.eq(kind, "pathfinder"):
          "pathfinder"
        else:
          if String.eq(kind, "make_it_quick"):
            "quick"
          else:
            "unstoppable"

# DareKind::need (private): how many of its moment the dare needs.
def dares.DareKind.need(+kind: String) -> U32:
  if Bool.or(String.eq(kind, "untouched"), String.eq(kind, "unstoppable")):
    2
  else:
    if String.eq(kind, "pathfinder"):
      3
    else:
      1

# Whether a dare of this kind is judged once, at the stairs.
def dares.judged_at_stairs(+kind: String) -> Bool:
  Bool.or(String.eq(kind, "stand_firm"), String.eq(kind, "against_the_clock"))

# Run::floor_has_guardian
def dares.Run.floor_has_guardian(+run: J.Val) -> Bool:
  dungeon: J.Val = J.get(run, "dungeon")
  gates: J.Val = J.get(run, "boss_gates")
  if Bool.not(J.is_null(J.get(dungeon, "open"))):
    dares.open_guardian(J.items(J.get(run, "enemies")))
  else:
    if Bool.not(J.is_null(gates)):
      dares.gated_guardian(gates, J.nth(J.get(dungeon, "rooms"), gb.u(gates, "guardian")))
    else:
      dares.rooms_guardian(J.items(J.get(dungeon, "rooms")), dares.has_boss(J.items(J.get(run, "bosses")), gb.s(dungeon, "pack")), Bool.and(String.eq(gb.s(dungeon, "pack"), "swamp"), U32.is_lt(gb.u(dungeon, "depth"), 3)))

def dares.open_guardian(+es: List<&2, J.Val>) -> Bool:
  match es:
    case Nil{}:
      False{}
    case Con{e: J.Val, t: List<&2, J.Val>}:
      Bool.or(Bool.and(U32.is_gt(gb.u(e, "hp"), 0), Bool.or(Bool.not(J.is_null(J.get(e, "boss"))), String.eq(gb.s(e, "kind"), "dragon"))), dares.open_guardian(t))

def dares.gated_guardian(+g: J.Val, +room: J.Val) -> Bool:
  kind: String = gb.s(room, "kind")
  Bool.and(Bool.not(gb.b(g, "guardian_defeated")), Bool.or(Bool.not(J.is_null(J.get(g, "guardian_boss"))), Bool.or(String.eq(kind, "lair"), String.eq(kind, "threshold"))))

def dares.has_boss(+bs: List<&2, J.Val>, +pack: String) -> Bool:
  match bs:
    case Nil{}:
      False{}
    case Con{b: J.Val, t: List<&2, J.Val>}:
      Bool.or(String.eq(gb.s(b, "only_in"), pack), dares.has_boss(t, pack))

def dares.rooms_guardian(+rs: List<&2, J.Val>, +has_boss: Bool, +swamp_above: Bool) -> Bool:
  match rs:
    case Nil{}:
      False{}
    case Con{r: J.Val, t: List<&2, J.Val>}:
      kind: String = gb.s(r, "kind")
      guard: Bool = Bool.or(Bool.or(String.eq(kind, "lair"), String.eq(kind, "threshold")), Bool.and(String.eq(kind, "stairs"), Bool.and(has_boss, Bool.not(swamp_above))))
      Bool.or(Bool.and(Bool.not(gb.b(r, "cleared")), guard), dares.rooms_guardian(t, has_boss, swamp_above))

# Run::call_dare: a new floor: Fortune calls her dare.
def dares.Run.call_dare(+run: J.Val) -> J.Val:
  depth: U32 = gb.u(J.get(run, "dungeon"), "depth")
  if U32.is_eq(depth, 0):
    J.set(run, "dare", J.JNull{})
  else:
    dares.call(run, depth, dares.kinds(U32.is_ge(depth, 6), dares.Run.floor_has_guardian(run)))

# The dares the floor allows, in Fortune's order.
def dares.kinds(+bottom: Bool, +guardian: Bool) -> List<&2, String>:
  dares.kinds.keep(["untouched", "stand_firm", "against_the_clock", "pathfinder", "make_it_quick", "unstoppable"], bottom, guardian)

def dares.kinds.keep(+ks: List<&2, String>, +bottom: Bool, +guardian: Bool) -> List<&2, String>:
  match ks:
    case Nil{}:
      []
    case Con{k: String, t: List<&2, String>}:
      allowed: Bool = Bool.and(Bool.or(Bool.not(bottom), Bool.not(Bool.or(Bool.or(String.eq(k, "stand_firm"), String.eq(k, "against_the_clock")), String.eq(k, "make_it_quick")))), Bool.or(guardian, Bool.not(String.eq(k, "make_it_quick"))))
      if allowed:
        k <> dares.kinds.keep(t, bottom, guardian)
      else:
        dares.kinds.keep(t, bottom, guardian)

def dares.call(+run: J.Val, +depth: U32, +kinds: List<&2, String>) -> J.Val:
  (rng: W.W, i: U32) = loot.Rng.below(W.of_j(J.get(run, "rng")), U32.from_nat(List.length(&2, String, kinds)))
  kind: String = dares.nth(kinds, i)
  d0: J.Val = J.set(J.obj(), "kind", J.JS{kind})
  d1: J.Val = gb.sw(d0, "since", gb.tick(run))
  d2: J.Val = gb.su(gb.sb(gb.sb(d1, "kept", False{}), "broken", False{}), "count", 0)
  gb.cue(J.set(J.set(run, "rng", W.to_j(rng)), "dare", J.set(d2, "rose", J.JNull{})), "dare:" ++ dares.DareKind.word(kind))

def dares.nth(+ks: List<&2, String>, +i: U32) -> String:
  match ks:
    case Nil{}:
      ""
    case Con{k: String, t: List<&2, String>}:
      if U32.is_eq(i, 0):
        k
      else:
        dares.nth(t, (i - 1 : U32))

# Run::watch_dare: the moments called since `heard` and the sounds since
# `sounded` keep the dare or break it.
def dares.Run.watch_dare(+run: J.Val, +heard: U32, +sounded: U32) -> J.Val:
  dare: J.Val = J.get(run, "dare")
  if Bool.or(J.is_null(dare), Bool.or(gb.b(dare, "kept"), gb.b(dare, "broken"))):
    run
  else:
    dares.watch(run, dare, gb.from(J.get(run, "cues"), heard), gb.from(J.get(run, "sounds"), sounded))

def dares.watch(+run: J.Val, +dare: J.Val, +cues: List<&2, J.Val>, +sounds: List<&2, J.Val>) -> J.Val:
  d1: J.Val = dares.judge(dare, gb.s(dare, "kind"), cues, sounds, gb.tick(run))
  d2: J.Val = Bool.pick(J.Val, Bool.and(Bool.not(dares.judged_at_stairs(gb.s(d1, "kind"))), U32.is_ge(gb.u(d1, "count"), dares.DareKind.need(gb.s(d1, "kind")))), gb.sb(d1, "kept", True{}), d1)
  run2: J.Val = Bool.pick(J.Val, gb.b(d2, "broken"), gb.cue(run, "dare_broken"), run)
  dares.watch.done(J.set(run2, "dare", d2), gb.b(d2, "kept"))

def dares.watch.done(+run: J.Val, +kept: Bool) -> J.Val:
  if kept:
    dares.Run.pay_dare(run)
  else:
    run

# The dare after this tick's moments, by kind.
def dares.judge(+d: J.Val, +kind: String, +cues: List<&2, J.Val>, +sounds: List<&2, J.Val>, +tick: W.W) -> J.Val:
  if String.eq(kind, "untouched"):
    gb.su(d, "count", (gb.u(d, "count") + gb.heads_eq(cues, "flawless") : U32))
  else:
    if String.eq(kind, "unstoppable"):
      gb.su(d, "count", (gb.u(d, "count") + gb.heads_eq(cues, "slay4") : U32))
    else:
      if String.eq(kind, "pathfinder"):
        gb.su(d, "count", (gb.u(d, "count") + gb.heads_eq(cues, "room_clear") + gb.heads_eq(cues, "flawless") : U32))
      else:
        if String.eq(kind, "stand_firm"):
          gb.sb(d, "broken", Bool.or(gb.b(d, "broken"), gb.any_eq(sounds, "roll")))
        else:
          if String.eq(kind, "against_the_clock"):
            gb.sb(d, "broken", Bool.or(gb.b(d, "broken"), W.gt(W.sat_sub(tick, W.of_j(J.get(d, "since"))), W.of_u32(7200))))
          else:
            dares.judge.quick(d, cues, tick)

# Make It Quick: the guardian felled within forty-five seconds of rising.
def dares.judge.quick(+d: J.Val, +cues: List<&2, J.Val>, +tick: W.W) -> J.Val:
  rose: J.Val = Bool.pick(J.Val, Bool.and(J.is_null(J.get(d, "rose")), Bool.or(gb.any_head(cues, "boss_rise"), gb.any_eq(cues, "lair"))), W.to_j(tick), J.get(d, "rose"))
  fell: Bool = Bool.or(gb.any_head(cues, "boss_fall"), gb.any_eq(cues, "victory"))
  d1: J.Val = J.set(d, "rose", rose)
  if J.is_null(rose):
    d1
  else:
    dares.judge.quick.at(d1, fell, W.sat_sub(tick, W.of_j(rose)))

def dares.judge.quick.at(+d: J.Val, +fell: Bool, +since: W.W) -> J.Val:
  if Bool.and(fell, W.le(since, W.of_u32(1350))):
    gb.su(d, "count", 1)
  else:
    if W.gt(since, W.of_u32(1350)):
      gb.sb(d, "broken", True{})
    else:
      d

# Run::settle_dare: the party takes the stairs: a dare judged there is kept
# if it was not broken on the way.
def dares.Run.settle_dare(+run: J.Val) -> J.Val:
  dare: J.Val = J.get(run, "dare")
  if Bool.or(J.is_null(dare), Bool.or(gb.b(dare, "kept"), gb.b(dare, "broken"))):
    run
  else:
    if dares.judged_at_stairs(gb.s(dare, "kind")):
      dares.Run.pay_dare(J.set(run, "dare", gb.sb(dare, "kept", True{})))
    else:
      run

# Run::pay_dare: Fortune's purse: gold and a gem for every knight standing.
def dares.Run.pay_dare(+run: J.Val) -> J.Val:
  depth: U32 = gb.u(J.get(run, "dungeon"), "depth")
  run1: J.Val = J.set(run, "players", dares.pay(gb.heroes(run), J.get(run, "players"), depth))
  run2: J.Val = feats.Run.notice(gb.su(run1, "dares_kept", (gb.u(run1, "dares_kept") + 1 : U32)), "daredevil")
  run3: J.Val = Bool.pick(J.Val, U32.is_ge(gb.u(run2, "dares_kept"), 5), feats.Run.notice(run2, "fortunes_favourite"), run2)
  gb.sound(gb.cue(run3, "dare_kept"), "wheel_land")

def dares.pay(+hs: List<&2, J.Val>, +players: J.Val, +depth: U32) -> J.Val:
  match hs:
    case Nil{}:
      players
    case Con{h: J.Val, t: List<&2, J.Val>}:
      if U32.is_gt(gb.u(h, "hp"), 0):
        c1: J.Val = realm.Spoils.add(gb.field(h, "carried"), "gold", (60 + 20 * depth : U32))
        dares.pay(t, J.set(players, U32.show(gb.hid(h)), J.set(gb.bare(h), "carried", realm.Spoils.add(c1, "gem", 1))), depth)
      else:
        dares.pay(t, players, depth)

def case.dares.Run.floor_has_guardian(+input: J.Val) -> J.Val:
  J.set(J.set(J.obj(), "run", J.get(input, "run")), "ret", J.JBool{dares.Run.floor_has_guardian(J.get(input, "run"))})

def case.dares.Run.call_dare(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", dares.Run.call_dare(J.get(input, "run")))

def case.dares.Run.watch_dare(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", dares.Run.watch_dare(J.get(input, "run"), gb.u(input, "heard"), gb.u(input, "sounded")))

def case.dares.Run.settle_dare(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", dares.Run.settle_dare(J.get(input, "run")))
