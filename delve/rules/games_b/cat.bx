# crates/delve/src/rules/cat.rs — Lady Tallow, Blaise's cat.

def cat.PET_MEND() -> U32:
  2

# fn shiny: a card worth fetching: a take card with a spoil effect.
def cat.shiny(+card: J.Val) -> Bool:
  Bool.and(String.eq(J.str(J.get(card, "kind")), "take"), cat.shiny.effects(J.items(J.get(card, "effects"))))

def cat.shiny.effects(+es: List<&2, J.Val>) -> Bool:
  match es:
    case Nil{}:
      False{}
    case Con{e, t}:
      Bool.or(cat.spoil_effect(e), cat.shiny.effects(t))

def cat.spoil_effect(+e: J.Val) -> Bool:
  Bool.or(Bool.or(Bool.or(J.has(e, "gold"), J.has(e, "bone")), Bool.or(J.has(e, "wax"), J.has(e, "ore"))), Bool.or(Bool.or(J.has(e, "gem"), J.has(e, "ember")), J.has(e, "scale")))

# Run::tallow_home: her knight's place: the first one standing, else the
# first one at all, else the middle of the floor.
def cat.Run.tallow_home(+run: J.Val) -> F32 & F32:
  hs: List<&2, J.Val> = gb.heroes(run)
  hero: J.Val = Bool.pick(J.Val, J.is_null(gb.standing(hs)), gb.first(hs), gb.standing(hs))
  if J.is_null(hero):
    (24.0, 14.0)
  else:
    (gb.f(hero, "x"), gb.f(hero, "y"))

# Run::bring_tallow: down the stair, if the hearth is warm enough.
def cat.Run.bring_tallow(+run: J.Val) -> J.Val:
  warm: Bool = U32.is_ge(home.Home.level(J.get(run, "home"), "hearth"), 2)
  (hx: F32, hy: F32) = cat.Run.tallow_home(run)
  if warm:
    gb.cue(J.set(run, "cat", cat.new((hx + 1.2 : F32), (hy + 0.8 : F32))), "tallow")
  else:
    J.set(run, "cat", J.JNull{})

def cat.new(+x: F32, +y: F32) -> J.Val:
  c0: J.Val = gb.sf(gb.sf(J.obj(), "x", x), "y", y)
  c1: J.Val = J.set(J.set(c0, "fetching", J.JNull{}), "carrying", J.JNull{})
  c2: J.Val = gb.su(gb.su(gb.sb(gb.sb(c1, "left", False{}), "moving", False{}), "hiss", 30), "hissed", 0)
  J.set(gb.su(gb.su(gb.su(c2, "fetched", 0), "stuck", 0), "petted", 0), "pet_held", J.JA{[]})

# Run::tallow_follows: a new room: she is already there, beside her knight.
def cat.Run.tallow_follows(+run: J.Val) -> J.Val:
  (hx: F32, hy: F32) = cat.Run.tallow_home(run)
  cat: J.Val = J.get(run, "cat")
  if J.is_null(cat):
    run
  else:
    J.set(run, "cat", J.set(gb.sf(gb.sf(cat, "x", (hx + 1.2 : F32)), "y", (hy + 0.8 : F32)), "fetching", J.JNull{}))

# Run::pet_tallow: E beside her: a scratch behind the ears.
def cat.Run.pet_tallow(+run: J.Val, +inputs: J.Val) -> J.Val:
  cat: J.Val = J.get(run, "cat")
  if J.is_null(cat):
    run
  else:
    cat.pet.fold(run, cat, inputs, gb.heroes(run), J.get(run, "players"), 0)

# Walk the seats in order: `cat` carries pet_held and the hero updates;
# `petted` is the last seat that got a scratch (0 for none).
def cat.pet.fold(+run: J.Val, +cat: J.Val, +inputs: J.Val, +hs: List<&2, J.Val>, +players: J.Val, +petted: U32) -> J.Val:
  match hs:
    case Nil{}:
      cat.pet.done(run, cat, players, petted)
    case Con{h: J.Val, t: List<&2, J.Val>}:
      (cat2: J.Val, rest: J.Val & U32) = cat.pet.one(cat, h, J.get(inputs, U32.show(gb.hid(h))), petted)
      (h2: J.Val, who: U32) = rest
      cat.pet.fold(run, cat2, inputs, t, J.set(players, U32.show(gb.hid(h)), gb.bare(h2)), who)

def cat.pet.done(+run: J.Val, +cat: J.Val, +players: J.Val, +petted: U32) -> J.Val:
  run1: J.Val = J.set(J.set(run, "players", players), "cat", cat)
  if U32.is_eq(petted, 0):
    run1
  else:
    gb.found(gb.sound(J.set(run1, "cat", gb.sw(cat, "petted", gb.tick(run1))), chatter.clip(petted, "hehe", W.rem_u32(gb.tick(run1), 2))), petted, "PURRR")

def cat.pet.one(+cat: J.Val, +h: J.Val, +input: J.Val, +petted: U32) -> J.Val & (J.Val & U32):
  id: U32 = gb.hid(h)
  down: Bool = Bool.and(rules.Input.valid(input), gb.b(input, "interact"))
  held: J.Val = J.get(cat, "pet_held")
  if down:
    cat.pet.down(cat, h, id, gb.set_has(held, id), petted)
  else:
    (J.set(cat, "pet_held", gb.set_rm(held, id)), (h, petted))

def cat.pet.down(+cat: J.Val, +h: J.Val, +id: U32, +already: Bool, +petted: U32) -> J.Val & (J.Val & U32):
  cat1: J.Val = J.set(cat, "pet_held", gb.set_ins(J.get(cat, "pet_held"), id))
  far: Bool = F32.is_gt(RS.f_hypot((gb.f(h, "x") - gb.f(cat, "x") : F32), (gb.f(h, "y") - gb.f(cat, "y") : F32)), 3.0)
  if Bool.or(already, Bool.or(U32.is_eq(gb.u(h, "hp"), 0), far)):
    (cat1, (h, petted))
  else:
    (cat1, (gb.su(h, "hp", U32.min((gb.u(h, "hp") + 2 : U32), gb.u(h, "max_hp"))), id))

# Her tick: hiss, fetch, carry, follow.
def cat.Run.tick_tallow(+run: J.Val) -> J.Val:
  cat: J.Val = J.get(run, "cat")
  if J.is_null(cat):
    run
  else:
    cat.tick.go(J.set(run, "cat", J.JNull{}), J.set(cat, "hiss", J.JU{gb.ssub(gb.u(cat, "hiss"), 1)}))

def cat.tick.go(+run: J.Val, +cat: J.Val) -> J.Val:
  (run2: J.Val, cat2: J.Val) = cat.hiss(run, cat)
  (run3: J.Val, cat3: J.Val) = cat.act(run2, cat2, gb.standing(gb.heroes(run2)))
  J.set(run3, "cat", cat3)

# A monster too close: HSSSS.
def cat.hiss(+run: J.Val, +cat: J.Val) -> J.Val & J.Val:
  if U32.is_eq(gb.u(cat, "hiss"), 0):
    (es: List<&2, J.Val>, startled: Bool) = cat.startle(J.items(J.get(run, "enemies")), gb.f(cat, "x"), gb.f(cat, "y"))
    if startled:
      (gb.cue(J.set(run, "enemies", J.JA{es}), "tallow_hiss"), gb.sw(gb.su(cat, "hiss", 180), "hissed", gb.tick(run)))
    else:
      (run, cat)
  else:
    (run, cat)

def cat.startle(+es: List<&2, J.Val>, +cx: F32, +cy: F32) -> List<&2, J.Val> & Bool:
  match es:
    case Nil{}:
      ([], False{})
    case Con{e: J.Val, t: List<&2, J.Val>}:
      (rest: List<&2, J.Val>, hit: Bool) = cat.startle(t, cx, cy)
      if cat.startles(e, cx, cy):
        (J.set(e, "frozen", J.JU{U32.max(gb.u(e, "frozen"), 30)}) <> rest, True{})
      else:
        (e <> rest, hit)

# A live, non-boss, non-dummy monster past its telegraph and within reach.
def cat.startles(+e: J.Val, +cx: F32, +cy: F32) -> Bool:
  fit: Bool = Bool.and(Bool.and(U32.is_gt(gb.u(e, "hp"), 0), J.is_null(J.get(e, "boss"))), Bool.and(Bool.not(String.eq(gb.s(e, "kind"), "dummy")), U32.is_ge(gb.u(e, "age"), 30)))
  Bool.and(fit, F32.is_lt(RS.f_hypot((gb.f(e, "x") - cx : F32), (gb.f(e, "y") - cy : F32)), (3.0 + monsters.Enemy.radius(e) : F32)))

# Walk toward a point at a pace, sliding along walls; the distance she had
# to go. Up against a corner for half a second she is simply there.
def cat.walk(+cat: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32, +pace: F32) -> J.Val & F32:
  d: F32 = RS.f_hypot((tx - gb.f(cat, "x") : F32), (ty - gb.f(cat, "y") : F32))
  if F32.is_gt(d, 0.05):
    cat.walk.move(cat, room, barred, tx, ty, pace, d)
  else:
    (gb.sb(cat, "moving", F32.is_gt(d, 0.3)), d)

def cat.walk.move(+cat: J.Val, +room: J.Val, +barred: Bool, +tx: F32, +ty: F32, +pace: F32, +d: F32) -> J.Val & F32:
  step: F32 = RS.f_min((pace * 0.033333335 : F32), d)
  cx: F32 = gb.f(cat, "x")
  cy: F32 = gb.f(cat, "y")
  (ux: F32, uy: F32) = rules.unit((tx - cx : F32), (ty - cy : F32))
  (nx: F32, ny: F32) = rules.Grid.slide(room, barred, (cx, cy), ((ux * step : F32), (uy * step : F32)), 0.35, 0)
  moved: F32 = RS.f_hypot((nx - cx : F32), (ny - cy : F32))
  stuck: U32 = Bool.pick(U32, F32.is_lt(moved, (step * 0.2 : F32)), (gb.u(cat, "stuck") + 1 : U32), 0)
  c1: J.Val = gb.sb(gb.sf(gb.sf(cat, "x", nx), "y", ny), "left", F32.is_lt(ux, 0.0))
  if U32.is_gt(stuck, 15):
    (gb.su(gb.sf(gb.sf(c1, "x", tx), "y", ty), "stuck", 0), 0.0)
  else:
    (gb.sb(gb.su(c1, "stuck", stuck), "moving", F32.is_gt(d, 0.3)), d)

def cat.act(+run: J.Val, +cat: J.Val, +owner: J.Val) -> J.Val & J.Val:
  carrying: J.Val = J.get(cat, "carrying")
  if J.is_null(carrying):
    cat.fetch(run, cat, owner)
  else:
    cat.bring(run, cat, owner, J.str(carrying))

# Bringing it home.
def cat.bring(+run: J.Val, +cat: J.Val, +owner: J.Val, +card: String) -> J.Val & J.Val:
  if J.is_null(owner):
    (run, cat)
  else:
    (cat2: J.Val, d: F32) = cat.walk(cat, rules.Run.room(run), rules.Run.barred(run), gb.f(owner, "x"), gb.f(owner, "y"), 10.0)
    if F32.is_lt(d, 1.2):
      cat.deliver(run, cat2, gb.hid(owner), card)
    else:
      (run, cat2)

def cat.deliver(+run: J.Val, +cat: J.Val, +id: U32, +card: String) -> J.Val & J.Val:
  found: J.Val = cards.Book.get(J.get(run, "book"), card)
  hero: J.Val = J.get(J.get(run, "players"), U32.show(id))
  run2: J.Val = Bool.pick(J.Val, Bool.or(J.is_null(found), J.is_null(hero)), run, cat.spend(run, id, hero, found))
  cat2: J.Val = J.set(gb.su(cat, "fetched", (gb.u(cat, "fetched") + 1 : U32)), "carrying", J.JNull{})
  run3: J.Val = gb.cue(gb.sound(run2, "card_pickup"), "tallow_fetch")
  if U32.is_ge(gb.u(cat2, "fetched"), 10):
    (feats.Run.notice(run3, "cat_person"), cat2)
  else:
    (run3, cat2)

def cat.spend(+run: J.Val, +id: U32, +hero: J.Val, +found: J.Val) -> J.Val:
  (h2: J.Val, rest: U32 & U32) = hero.Hero.spend(hero, found, gb.u(run, "score"), 0)
  (score: U32, nova: U32) = rest
  J.set(J.set(run, "score", J.JU{score}), "players", J.set(J.get(run, "players"), U32.show(id), h2))

# Anything shiny lying about? Else stay at her knight's heel.
def cat.fetch(+run: J.Val, +cat: J.Val, +owner: J.Val) -> J.Val & J.Val:
  room: J.Val = rules.Run.room(run)
  best: J.Val = cat.nearest(J.items(J.get(room, "items")), J.get(run, "book"), gb.f(cat, "x"), gb.f(cat, "y"), 0, J.JNull{})
  if J.is_null(best):
    cat.heel(run, J.set(cat, "fetching", J.JNull{}), owner)
  else:
    cat.go_fetch(run, cat, room, J.u32(J.nth(best, 0)))

# The nearest shiny item within 12 of her, as [index, distance], or null.
def cat.nearest(+items: List<&2, J.Val>, +book: J.Val, +cx: F32, +cy: F32, +i: U32, +best: J.Val) -> J.Val:
  match items:
    case Nil{}:
      best
    case Con{it: J.Val, t: List<&2, J.Val>}:
      d: F32 = RS.f_hypot((gb.f(it, "x") - cx : F32), (gb.f(it, "y") - cy : F32))
      take: Bool = Bool.and(cat.shiny(cards.Book.get(book, gb.s(it, "card"))), Bool.and(F32.is_lt(d, 12.0), Bool.or(J.is_null(best), F32.is_lt(d, J.f32(J.nth(best, 1))))))
      cat.nearest(t, book, cx, cy, (i + 1 : U32), Bool.pick(J.Val, take, J.JA{[J.JU{i}, J.JF{d}]}, best))

def cat.go_fetch(+run: J.Val, +cat: J.Val, +room: J.Val, +n: U32) -> J.Val & J.Val:
  items: List<&2, J.Val> = J.items(J.get(room, "items"))
  it: J.Val = J.nth(J.JA{items}, n)
  ix: F32 = gb.f(it, "x")
  iy: F32 = gb.f(it, "y")
  (cat2: J.Val, d: F32) = cat.walk(J.set(cat, "fetching", gb.pair(ix, iy)), room, rules.Run.barred(run), ix, iy, 10.0)
  if F32.is_lt(d, 0.8):
    (gb.set_room(run, J.set(room, "items", J.JA{gb.swap_remove(items, n)})), J.set(J.set(cat2, "carrying", J.get(it, "card")), "fetching", J.JNull{}))
  else:
    (run, cat2)

# At her knight's heel, unhurried.
def cat.heel(+run: J.Val, +cat: J.Val, +owner: J.Val) -> J.Val & J.Val:
  if J.is_null(owner):
    (run, cat)
  else:
    sx: F32 = (gb.f(owner, "x") + 1.4 : F32)
    sy: F32 = (gb.f(owner, "y") + 0.9 : F32)
    far: F32 = RS.f_hypot((sx - gb.f(cat, "x") : F32), (sy - gb.f(cat, "y") : F32))
    if F32.is_gt(far, 14.0):
      (run, gb.sf(gb.sf(cat, "x", sx), "y", sy))
    else:
      if F32.is_gt(far, 1.0):
        (cat2: J.Val, d: F32) = cat.walk(cat, rules.Run.room(run), rules.Run.barred(run), sx, sy, Bool.pick(F32, F32.is_gt(far, 4.0), 10.0, 5.0))
        (run, cat2)
      else:
        (run, gb.sb(cat, "moving", False{}))

def case.cat.Run.tick_tallow(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", cat.Run.tick_tallow(J.get(input, "run")))

def case.cat.Run.pet_tallow(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", cat.Run.pet_tallow(J.get(input, "run"), J.get(input, "inputs")))

def case.cat.Run.bring_tallow(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", cat.Run.bring_tallow(J.get(input, "run")))

def case.cat.Run.tallow_follows(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", cat.Run.tallow_follows(J.get(input, "run")))
