# The dare after this tick's moments, by kind.
def dares.judge(+d: J.Val, +kind: String, +cues: List<&2, J.Val>, +sounds: List<&2, J.Val>, +tick: W.W) -> J.Val:
  dares.judge.k1(String.eq(kind, "untouched"), d, kind, cues, sounds, tick)

def dares.judge.k5(cv: Bool, +d: J.Val, +kind: String, +cues: List<&2, J.Val>, +tick: W.W) -> J.Val:
  match cv:
    case True{}:
      gb.sb(d, "broken", Bool.or(gb.b(d, "broken"), W.gt(W.sat_sub(tick, W.of_j(J.get(d, "since"))), W.of_u32(7200))))
    case False{}:
      dares.judge.quick(d, cues, tick)

def dares.judge.k4(cv: Bool, +d: J.Val, +kind: String, +cues: List<&2, J.Val>, +sounds: List<&2, J.Val>, +tick: W.W) -> J.Val:
  match cv:
    case True{}:
      gb.sb(d, "broken", Bool.or(gb.b(d, "broken"), gb.any_eq(sounds, "roll")))
    case False{}:
      dares.judge.k5(String.eq(kind, "against_the_clock"), d, kind, cues, tick)

def dares.judge.k3(cv: Bool, +d: J.Val, +kind: String, +cues: List<&2, J.Val>, +sounds: List<&2, J.Val>, +tick: W.W) -> J.Val:
  match cv:
    case True{}:
      gb.su(d, "count", (gb.u(d, "count") + gb.heads_eq(cues, "room_clear") + gb.heads_eq(cues, "flawless") : U32))
    case False{}:
      dares.judge.k4(String.eq(kind, "stand_firm"), d, kind, cues, sounds, tick)

def dares.judge.k2(cv: Bool, +d: J.Val, +kind: String, +cues: List<&2, J.Val>, +sounds: List<&2, J.Val>, +tick: W.W) -> J.Val:
  match cv:
    case True{}:
      gb.su(d, "count", (gb.u(d, "count") + gb.heads_eq(cues, "slay4") : U32))
    case False{}:
      dares.judge.k3(String.eq(kind, "pathfinder"), d, kind, cues, sounds, tick)

def dares.judge.k1(cv: Bool, +d: J.Val, +kind: String, +cues: List<&2, J.Val>, +sounds: List<&2, J.Val>, +tick: W.W) -> J.Val:
  match cv:
    case True{}:
      gb.su(d, "count", (gb.u(d, "count") + gb.heads_eq(cues, "flawless") : U32))
    case False{}:
      dares.judge.k2(String.eq(kind, "unstoppable"), d, kind, cues, sounds, tick)
# Make It Quick: the guardian felled within forty-five seconds of rising.
def dares.judge.quick(+d: J.Val, +cues: List<&2, J.Val>, +tick: W.W) -> J.Val:
  +rose = Bool.pick(J.Val, Bool.and(J.is_null(J.get(d, "rose")), Bool.or(gb.any_head(cues, "boss_rise"), gb.any_eq(cues, "lair"))), W.to_j(tick), J.get(d, "rose"))
  +fell = Bool.or(gb.any_head(cues, "boss_fall"), gb.any_eq(cues, "victory"))
  +d1 = J.set(d, "rose", rose)
  dares.judge.quick.k1(J.is_null(rose), tick, rose, fell, d1)

def dares.judge.quick.k1(cv: Bool, +tick: W.W, +rose: J.Val, +fell: Bool, +d1: J.Val) -> J.Val:
  match cv:
    case True{}:
      d1
    case False{}:
      dares.judge.quick.at(d1, fell, W.sat_sub(tick, W.of_j(rose)))
def dares.judge.quick.at(+d: J.Val, +fell: Bool, +since: W.W) -> J.Val:
  dares.judge.quick.at.k1(Bool.and(fell, W.le(since, W.of_u32(1350))), d, fell, since)

def dares.judge.quick.at.k2(cv: Bool, +d: J.Val, +since: W.W) -> J.Val:
  match cv:
    case True{}:
      gb.sb(d, "broken", True{})
    case False{}:
      d

def dares.judge.quick.at.k1(cv: Bool, +d: J.Val, +fell: Bool, +since: W.W) -> J.Val:
  match cv:
    case True{}:
      gb.su(d, "count", 1)
    case False{}:
      dares.judge.quick.at.k2(W.gt(since, W.of_u32(1350)), d, since)
# Run::settle_dare: the party takes the stairs: a dare judged there is kept
# if it was not broken on the way.
def dares.Run.settle_dare(+run: J.Val) -> J.Val:
  +dare = J.get(run, "dare")
  dares.Run.settle_dare.k1(Bool.or(J.is_null(dare), Bool.or(gb.b(dare, "kept"), gb.b(dare, "broken"))), run, dare)

def dares.Run.settle_dare.k2(cv: Bool, +run: J.Val, +dare: J.Val) -> J.Val:
  match cv:
    case True{}:
      dares.Run.pay_dare(J.set(run, "dare", gb.sb(dare, "kept", True{})))
    case False{}:
      run

def dares.Run.settle_dare.k1(cv: Bool, +run: J.Val, +dare: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      dares.Run.settle_dare.k2(dares.judged_at_stairs(gb.s(dare, "kind")), run, dare)
# Run::pay_dare: Fortune's purse: gold and a gem for every knight standing.
def dares.Run.pay_dare(+run: J.Val) -> J.Val:
  +depth = gb.u(J.get(run, "dungeon"), "depth")
  +run1 = J.set(run, "players", dares.pay(gb.heroes(run), J.get(run, "players"), depth))
  +run2 = feats.Run.notice(gb.su(run1, "dares_kept", (gb.u(run1, "dares_kept") + 1 : U32)), "daredevil")
  +run3 = Bool.pick(J.Val, U32.is_ge(gb.u(run2, "dares_kept"), 5), feats.Run.notice(run2, "fortunes_favourite"), run2)
  gb.sound(gb.cue(run3, "dare_kept"), "wheel_land")
def dares.pay(+hs: List<&2, J.Val>, +players: J.Val, +depth: U32) -> J.Val:
  match hs:
    case Nil{}:
      players
    case Con{+h, +t}:
      dares.pay.k1(U32.is_gt(gb.u(h, "hp"), 0), players, depth, h, t)

def dares.pay.k1(cv: Bool, +players: J.Val, +depth: U32, +h: J.Val, +t: List<&2, J.Val>) -> J.Val:
  match cv:
    case True{}:
      +c1 = realm.Spoils.add(gb.field(h, "carried"), "gold", (60 + 20 * depth : U32))
      dares.pay(t, J.set(players, U32.show(gb.hid(h)), J.set(gb.bare(h), "carried", realm.Spoils.add(c1, "gem", 1))), depth)
    case False{}:
      dares.pay(t, players, depth)
def case.dares.Run.floor_has_guardian(+input: J.Val) -> J.Val:
  J.set(J.set(J.obj(), "run", J.get(input, "run")), "ret", J.JBool{dares.Run.floor_has_guardian(J.get(input, "run"))})
def case.dares.Run.call_dare(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", dares.Run.call_dare(J.get(input, "run")))
def case.dares.Run.watch_dare(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", dares.Run.watch_dare(J.get(input, "run"), gb.u(input, "heard"), gb.u(input, "sounded")))
def case.dares.Run.settle_dare(+input: J.Val) -> J.Val:
  J.set(J.obj(), "run", dares.Run.settle_dare(J.get(input, "run")))
