def dares.open_guardian(+es: List<&2, J.Val>) -> Bool:
  match es:
    case Nil{}:
      False{}
    case Con{+e, +t}:
      Bool.or(Bool.and(U32.is_gt(gb.u(e, "hp"), 0), Bool.or(Bool.not(J.is_null(J.get(e, "boss"))), String.eq(gb.s(e, "kind"), "dragon"))), dares.open_guardian(t))
def dares.gated_guardian(+g: J.Val, +room: J.Val) -> Bool:
  +kind = gb.s(room, "kind")
  Bool.and(Bool.not(gb.b(g, "guardian_defeated")), Bool.or(Bool.not(J.is_null(J.get(g, "guardian_boss"))), Bool.or(String.eq(kind, "lair"), String.eq(kind, "threshold"))))
def dares.has_boss(+bs: List<&2, J.Val>, +pack: String) -> Bool:
  match bs:
    case Nil{}:
      False{}
    case Con{+b, +t}:
      Bool.or(String.eq(gb.s(b, "only_in"), pack), dares.has_boss(t, pack))
def dares.rooms_guardian(+rs: List<&2, J.Val>, +has_boss: Bool, +swamp_above: Bool) -> Bool:
  match rs:
    case Nil{}:
      False{}
    case Con{+r, +t}:
      +kind = gb.s(r, "kind")
      +guard = Bool.or(Bool.or(String.eq(kind, "lair"), String.eq(kind, "threshold")), Bool.and(String.eq(kind, "stairs"), Bool.and(has_boss, Bool.not(swamp_above))))
      Bool.or(Bool.and(Bool.not(gb.b(r, "cleared")), guard), dares.rooms_guardian(t, has_boss, swamp_above))
# Run::call_dare: a new floor: Fortune calls her dare.
def dares.Run.call_dare(+run: J.Val) -> J.Val:
  +depth = gb.u(J.get(run, "dungeon"), "depth")
  dares.Run.call_dare.k1(U32.is_eq(depth, 0), run, depth)

def dares.Run.call_dare.k1(cv: Bool, +run: J.Val, +depth: U32) -> J.Val:
  match cv:
    case True{}:
      J.set(run, "dare", J.JNull{})
    case False{}:
      dares.call(run, depth, dares.kinds(U32.is_ge(depth, 6), dares.Run.floor_has_guardian(run)))
# The dares the floor allows, in Fortune's order.
def dares.kinds(+bottom: Bool, +guardian: Bool) -> List<&2, String>:
  dares.kinds.keep(["untouched", "stand_firm", "against_the_clock", "pathfinder", "make_it_quick", "unstoppable"], bottom, guardian)
def dares.kinds.keep(+ks: List<&2, String>, +bottom: Bool, +guardian: Bool) -> List<&2, String>:
  match ks:
    case Nil{}:
      []
    case Con{+k, +t}:
      +allowed = Bool.and(Bool.or(Bool.not(bottom), Bool.not(Bool.or(Bool.or(String.eq(k, "stand_firm"), String.eq(k, "against_the_clock")), String.eq(k, "make_it_quick")))), Bool.or(guardian, Bool.not(String.eq(k, "make_it_quick"))))
      dares.kinds.keep.k1(allowed, bottom, guardian, k, t, allowed)

def dares.kinds.keep.k1(cv: Bool, +bottom: Bool, +guardian: Bool, +k: String, +t: List<&2, String>, +allowed: Bool) -> List<&2, String>:
  match cv:
    case True{}:
      k <> dares.kinds.keep(t, bottom, guardian)
    case False{}:
      dares.kinds.keep(t, bottom, guardian)
def dares.call(+run: J.Val, +depth: U32, +kinds: List<&2, String>) -> J.Val:
  dares.call.k1(loot.Rng.below(W.of_j(J.get(run, "rng")), U32.from_nat(List.length(&2, String, kinds))), run, kinds)

def dares.call.k1(pr: W.W & U32, +run: J.Val, +kinds: List<&2, String>) -> J.Val:
  (+rng, +i) = pr
  +kind = dares.nth(kinds, i)
  +d0 = J.set(J.obj(), "kind", J.JS{kind})
  +d1 = gb.sw(d0, "since", gb.tick(run))
  +d2 = gb.su(gb.sb(gb.sb(d1, "kept", False{}), "broken", False{}), "count", 0)
  gb.cue(J.set(J.set(run, "rng", W.to_j(rng)), "dare", J.set(d2, "rose", J.JNull{})), "dare:" ++ dares.DareKind.word(kind))
def dares.nth(+ks: List<&2, String>, +i: U32) -> String:
  match ks:
    case Nil{}:
      ""
    case Con{+k, +t}:
      dares.nth.k1(U32.is_eq(i, 0), i, k, t)

def dares.nth.k1(cv: Bool, +i: U32, +k: String, +t: List<&2, String>) -> String:
  match cv:
    case True{}:
      k
    case False{}:
      dares.nth(t, (i - 1 : U32))
# Run::watch_dare: the moments called since `heard` and the sounds since
# `sounded` keep the dare or break it.
def dares.Run.watch_dare(+run: J.Val, +heard: U32, +sounded: U32) -> J.Val:
  +dare = J.get(run, "dare")
  dares.Run.watch_dare.k1(Bool.or(J.is_null(dare), Bool.or(gb.b(dare, "kept"), gb.b(dare, "broken"))), run, heard, sounded, dare)

def dares.Run.watch_dare.k1(cv: Bool, +run: J.Val, +heard: U32, +sounded: U32, +dare: J.Val) -> J.Val:
  match cv:
    case True{}:
      run
    case False{}:
      dares.watch(run, dare, gb.from(J.get(run, "cues"), heard), gb.from(J.get(run, "sounds"), sounded))
def dares.watch(+run: J.Val, +dare: J.Val, +cues: List<&2, J.Val>, +sounds: List<&2, J.Val>) -> J.Val:
  +d1 = dares.judge(dare, gb.s(dare, "kind"), cues, sounds, gb.tick(run))
  +d2 = Bool.pick(J.Val, Bool.and(Bool.not(dares.judged_at_stairs(gb.s(d1, "kind"))), U32.is_ge(gb.u(d1, "count"), dares.DareKind.need(gb.s(d1, "kind")))), gb.sb(d1, "kept", True{}), d1)
  +run2 = Bool.pick(J.Val, gb.b(d2, "broken"), gb.cue(run, "dare_broken"), run)
  dares.watch.done(J.set(run2, "dare", d2), gb.b(d2, "kept"))
def dares.watch.done(+run: J.Val, +kept: Bool) -> J.Val:
  dares.watch.done.k1(kept, run, kept)

def dares.watch.done.k1(cv: Bool, +run: J.Val, +kept: Bool) -> J.Val:
