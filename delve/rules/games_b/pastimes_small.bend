def pastimes.halfpipe.fly(+h: J.Val, +axis: U32, +direction: U32) -> J.Val & J.Val:
  +flight = (gb.u(h, "flight") + 1 : U32)
  +spin = Bool.pick(U32, U32.is_eq(axis, direction), U32.min(gb.sadd(gb.u(h, "spin"), 16), 576), Bool.pick(U32, U32.is_ne(axis, 0), gb.ssub(gb.u(h, "spin"), 16), gb.u(h, "spin")))
