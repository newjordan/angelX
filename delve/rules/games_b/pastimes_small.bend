# Barrels passed this tick: lap 0..3, barrel 0..4; hitting one bogs the cart.
def pastimes.chariot.barrels(+c: J.Val, +before: U32, +distance: U32, +lap: U32, +k: U32) -> J.Val:
  match lap:
    case 3:
      c
    case _:
      +obstacle = (lap * 4096 + pastimes.chariot.BARREL_POS(k) : U32)
      +hit = Bool.and(Bool.and(U32.is_lt(before, obstacle), U32.is_ge(distance, obstacle)), U32.is_lt(RS.u_abs_diff(gb.u(c, "lane"), pastimes.chariot.BARREL_LANE(k)), 90))
      +c1 = Bool.pick(J.Val, hit, gb.su(c, "bog", 45), c)
      pastimes.chariot.barrels(c1, before, distance, Bool.pick(U32, U32.is_eq(k, 3), (lap + 1 : U32), lap), Bool.pick(U32, U32.is_eq(k, 3), 0, (k + 1 : U32)))
def pastimes.chariot.PACE(+i: U32) -> U32:
