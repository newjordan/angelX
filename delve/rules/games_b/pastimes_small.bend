  J.set(gb.su(gb.su(gb.su(v1, "paddle_flash", 0), "miss_flash", 0), "miss_x", 3072), "bell_shimmer", J.JA{[J.JU{0}, J.JU{0}, J.JU{0}, J.JU{0}]})
# Volley::step -> (self, Option<u8>).
def pastimes.volley.Volley.step(+v: J.Val, +input: J.Val, +tapped: Bool) -> J.Val & J.Val:
  +v1 = gb.su(gb.su(J.set(v, "bell_ring", gb.sat1(J.get(v, "bell_ring"))), "paddle_flash", gb.ssub(gb.u(v, "paddle_flash"), 1)), "miss_flash", gb.ssub(gb.u(v, "miss_flash"), 1))
  +v2 = J.set(v1, "bell_shimmer", pastimes.volley.shimmer(J.items(J.get(v, "bell_shimmer")), gb.u(v, "bells"), 0))
  +paddle = RS.i_clamp(RS.i_add(gb.i(v, "paddle"), RS.i_mul(RS.i_signum(gb.axis(input, "aim_x", "move_x")), 40)), 1536, 4608)
  +v3 = gb.si(v2, "paddle", paddle)
  +ball = J.get(v3, "ball")
  pastimes.volley.Volley.step.k1(J.is_null(ball), tapped, paddle, v3, ball)

def pastimes.volley.Volley.step.k1(cv: Bool, +tapped: Bool, +paddle: U32, +v3: J.Val, +ball: J.Val) -> J.Val & J.Val:
  match cv:
    case True{}:
