    case False{}:
      pastimes.volley.fly(J.set(v3, "ball", J.JNull{}), ball)
def pastimes.volley.shimmer(+xs: List<&2, J.Val>, +bells: U32, +i: U32) -> J.Val:
  J.JA{pastimes.volley.shimmer.go(xs, bells, i)}
def pastimes.volley.shimmer.go(+xs: List<&2, J.Val>, +bells: U32, +i: U32) -> List<&2, J.Val>:
  match xs:
    case Nil{}:
      []
    case Con{+h, +t}:
      +s = J.u32(h)
      +ns = Bool.pick(U32, gb.bit(bells, i), 0, Bool.pick(U32, U32.is_eq(s, 0), 8, (s - 1 : U32)))
      J.JU{ns} <> pastimes.volley.shimmer.go(t, bells, (i + 1 : U32))
def pastimes.volley.serve(+v: J.Val, +tapped: Bool, +paddle: U32) -> J.Val & J.Val:
  pastimes.volley.serve.k1(tapped, v, tapped, paddle)

def pastimes.volley.serve.k1(cv: Bool, +v: J.Val, +tapped: Bool, +paddle: U32) -> J.Val & J.Val:
  match cv:
    case True{}:
      +b0 = gb.si(gb.si(gb.si(gb.si(J.obj(), "x", paddle), "y", 2559), "dx", 24), "dy", RS.i_neg(48))
      (J.set(J.set(v, "ball", b0), "ball_trail", J.JA{[]}), J.JU{0})
    case False{}:
      (v, J.JU{0})
def pastimes.volley.fly(+v: J.Val, +ball: J.Val) -> J.Val & J.Val:
  +trail0 = J.push(J.get(v, "ball_trail"), J.JA{[J.of_i32(gb.i(ball, "x")), J.of_i32(gb.i(ball, "y"))]})
  +trail = Bool.pick(J.Val, U32.is_gt(J.len(trail0), 10), J.JA{List.drop(&2, J.Val, J.items(trail0), 1n)}, trail0)
  +x0 = RS.i_add(gb.i(ball, "x"), gb.i(ball, "dx"))
  +y0 = RS.i_add(gb.i(ball, "y"), gb.i(ball, "dy"))
  +dx0 = gb.i(ball, "dx")
  +left = RS.i_lt(x0, 1536)
  +right = RS.i_gt(x0, 4608)
  +x1 = Bool.pick(U32, left, RS.i_sub(3072, x0), Bool.pick(U32, right, RS.i_sub(9216, x0), x0))
  +dx1 = Bool.pick(U32, left, RS.i_abs(dx0), Bool.pick(U32, right, RS.i_neg(RS.i_abs(dx0)), dx0))
  pastimes.volley.fly.top(J.set(v, "ball_trail", trail), x1, y0, dx1, gb.i(ball, "dy"))
def pastimes.volley.fly.top(+v: J.Val, +x: U32, +y: U32, +dx: U32, +dy: U32) -> J.Val & J.Val:
  +hit = Bool.and(RS.i_le(y, 1024), RS.i_lt(dy, 0))
  +y1 = Bool.pick(U32, hit, RS.i_sub(2048, y), y)
  +dy1 = Bool.pick(U32, hit, 48, dy)
  +i = U32.min(RS.i_div(RS.i_sub(x, 1536), 768), 3)
  +bit = U32.shln(1, U32.to_nat(i))
  +fresh = Bool.and(hit, U32.is_eq(U32.and(gb.u(v, "bells"), bit), 0))
  +v1 = Bool.pick(J.Val, hit, J.set(v, "bell_ring", gb.as(J.get(v, "bell_ring"), i, 10)), v)
  +v2 = Bool.pick(J.Val, fresh, gb.su(v1, "bells", U32.or(gb.u(v, "bells"), bit)), v1)
  pastimes.volley.fly.paddle(v2, x, y1, dx, dy1, Bool.to_u32(fresh))
def pastimes.volley.fly.paddle(+v: J.Val, +x: U32, +y: U32, +dx: U32, +dy: U32, +added: U32) -> J.Val & J.Val:
  +at = Bool.and(RS.i_ge(y, 2560), RS.i_gt(dy, 0))
  pastimes.volley.fly.paddle.k1(at, v, x, y, dx, dy, added, at)

def pastimes.volley.fly.paddle.k2(cv: Bool, +v: J.Val, +x: U32, +y: U32, +dx: U32, +added: U32) -> J.Val & J.Val:
  match cv:
    case True{}:
      (gb.su(gb.su(gb.si(v, "miss_x", gb.i(v, "paddle")), "miss_flash", 6), "lives", (gb.u(v, "lives") - 1 : U32)), J.JNull{})
    case False{}:
      pastimes.volley.fly.bounce(v, x, y, dx, added)

def pastimes.volley.fly.paddle.k1(cv: Bool, +v: J.Val, +x: U32, +y: U32, +dx: U32, +dy: U32, +added: U32, +at: Bool) -> J.Val & J.Val:
  match cv:
    case True{}:
      pastimes.volley.fly.paddle.k2(RS.i_gt(RS.i_abs(RS.i_sub(x, gb.i(v, "paddle"))), 320), v, x, y, dx, added)
    case False{}:
      (J.set(v, "ball", pastimes.volley.ball(x, y, dx, dy)), J.JU{added})
def pastimes.volley.fly.bounce(+v: J.Val, +x: U32, +y: U32, +dx: U32, +added: U32) -> J.Val & J.Val:
  +offset = RS.i_clamp(RS.i_sub(x, gb.i(v, "paddle")), RS.i_neg(288), 288)
  +d = RS.i_div(offset, 6)
  +ndx = Bool.pick(U32, U32.is_lt(RS.i_abs(d), 8), Bool.pick(U32, RS.i_lt(dx, 0), RS.i_neg(8), 8), d)
  (J.set(gb.su(v, "paddle_flash", 10), "ball", pastimes.volley.ball(x, RS.i_sub(5120, y), ndx, RS.i_neg(48))), J.JU{added})
def pastimes.volley.ball(+x: U32, +y: U32, +dx: U32, +dy: U32) -> J.Val:
  gb.si(gb.si(gb.si(gb.si(J.obj(), "x", x), "y", y), "dx", dx), "dy", dy)
# ---- duckshoot.rs ---------------------------------------------------------

def pastimes.duckshoot.RAIL_K(+i: U32) -> U32:
  match i:
    case 0:
      17
    case 1:
      12
    case _:
      9
def pastimes.duckshoot.RAIL_SY(+i: U32) -> U32:
  match i:
    case 0:
      163
    case 1:
      139
    case _:
      128
def pastimes.duckshoot.HIT_W(+i: U32) -> U32:
  match i:
    case 0:
      10
    case 1:
      8
    case _:
      7
def pastimes.duckshoot.HIT_H(+i: U32) -> U32:
  match i:
    case 0:
      12
    case 1:
      10
    case _:
      9
def pastimes.duckshoot.duck(+x: U32, +vx: U32) -> J.Val:
  gb.su(gb.si(gb.si(J.obj(), "x", x), "vx", vx), "down", 0)
def pastimes.duckshoot.DuckShoot.new(+owner: U32) -> J.Val:
  +d0 = gb.su(gb.su(gb.su(gb.su(J.obj(), "owner", owner), "ax", 192), "ay", 130), "shots", 0)
  J.set(gb.su(d0, "flash", 0), "ducks", J.JA{[pastimes.duckshoot.duck(RS.i_neg(900), 150), pastimes.duckshoot.duck(400, RS.i_neg(110)), pastimes.duckshoot.duck(1200, 75)]})
# DuckShoot::screen_x
def pastimes.duckshoot.DuckShoot.screen_x(+lane: U32, +rail: U32) -> U32:
  RS.i_add(192, RS.i_div(RS.i_mul(lane, pastimes.duckshoot.RAIL_K(rail)), 256))
# DuckShoot::step -> (self, Option<rail>).
def pastimes.duckshoot.DuckShoot.step(+d: J.Val, +input: J.Val, +tapped: Bool) -> J.Val & J.Val:
  +ax = RS.i_clamp(RS.i_add(gb.i(d, "ax"), RS.i_mul(gb.axis(input, "aim_x", "move_x"), 6)), 8, 376)
  +ay = RS.i_clamp(RS.i_add(gb.i(d, "ay"), RS.i_mul(gb.axis(input, "aim_y", "move_y"), 6)), 24, 200)
  +d1 = gb.su(gb.si(gb.si(d, "ax", ax), "ay", ay), "flash", gb.ssub(gb.u(d, "flash"), 1))
  +d2 = J.set(d1, "ducks", J.JA{pastimes.duckshoot.drift(J.items(J.get(d1, "ducks")))})
  pastimes.duckshoot.DuckShoot.step.k1(Bool.or(Bool.not(tapped), U32.is_ge(gb.u(d2, "shots"), 40)), tapped, ax, ay, d2)

def pastimes.duckshoot.DuckShoot.step.k1(cv: Bool, +tapped: Bool, +ax: U32, +ay: U32, +d2: J.Val) -> J.Val & J.Val:
  match cv:
    case True{}:
      (d2, J.JNull{})
    case False{}:
      pastimes.duckshoot.shoot(gb.su(gb.su(d2, "shots", (gb.u(d2, "shots") + 1 : U32)), "flash", 3), ax, ay, 0)
def pastimes.duckshoot.drift(+ds: List<&2, J.Val>) -> List<&2, J.Val>:
  match ds:
    case Nil{}:
      []
    case Con{+h, +t}:
      pastimes.duckshoot.drift.one(h) <> pastimes.duckshoot.drift(t)
def pastimes.duckshoot.drift.one(+duck: J.Val) -> J.Val:
  +vx = gb.i(duck, "vx")
  +x = RS.i_add(gb.i(duck, "x"), vx)
  +over = RS.i_gt(x, 1800)
  +under = RS.i_lt(x, RS.i_neg(1800))
  +x1 = Bool.pick(U32, over, RS.i_sub(3600, x), Bool.pick(U32, under, RS.i_sub(RS.i_neg(3600), x), x))
  +vx1 = Bool.pick(U32, Bool.or(over, under), RS.i_neg(vx), vx)
  pastimes.duckshoot.drift.down(gb.su(gb.si(gb.si(duck, "x", x1), "vx", vx1), "down", gb.u(duck, "down")))
def pastimes.duckshoot.drift.down(+duck: J.Val) -> J.Val:
  +down = gb.u(duck, "down")
  +d1 = U32.min((down + 1 : U32), 30)
  +reset = U32.is_eq(d1, 30)
  +x_home = Bool.pick(U32, RS.i_lt(gb.i(duck, "vx"), 0), 1800, RS.i_neg(1800))
  pastimes.duckshoot.drift.down.k1(U32.is_gt(down, 0), duck, down, d1, reset, x_home)

def pastimes.duckshoot.drift.down.k1(cv: Bool, +duck: J.Val, +down: U32, +d1: U32, +reset: Bool, +x_home: U32) -> J.Val:
  match cv:
    case True{}:
      gb.si(gb.su(duck, "down", Bool.pick(U32, reset, 0, d1)), "x", Bool.pick(U32, reset, x_home, gb.i(duck, "x")))
    case False{}:
      duck
# The first rail whose live duck is under the sights goes down.
def pastimes.duckshoot.shoot(+d: J.Val, +ax: U32, +ay: U32, +rail: U32) -> J.Val & J.Val:
  match rail:
    case 3:
      (d, J.JNull{})
    case _:
      +duck = J.nth(J.get(d, "ducks"), rail)
      +sx = pastimes.duckshoot.DuckShoot.screen_x(gb.i(duck, "x"), rail)
      +hit = Bool.and(U32.is_eq(gb.u(duck, "down"), 0), Bool.and(RS.i_le(RS.i_abs(RS.i_sub(ax, sx)), pastimes.duckshoot.HIT_W(rail)), RS.i_le(RS.i_abs(RS.i_sub(ay, pastimes.duckshoot.RAIL_SY(rail))), pastimes.duckshoot.HIT_H(rail))))
      pastimes.duckshoot.shoot.k1(hit, d, ax, ay, rail, duck, hit)

def pastimes.duckshoot.shoot.k1(cv: Bool, +d: J.Val, +ax: U32, +ay: U32, +rail: U32, +duck: J.Val, +hit: Bool) -> J.Val & J.Val:
  match cv:
    case True{}:
      (J.set(d, "ducks", J.set_nth(J.get(d, "ducks"), rail, gb.su(duck, "down", 1))), J.JU{rail})
    case False{}:
      pastimes.duckshoot.shoot(d, ax, ay, (rail + 1 : U32))
# ---- cases ------------------------------------------------------------------

def pastimes.case.out(r: J.Val & J.Val) -> J.Val:
  pastimes.case.out.k1(r)

def pastimes.case.out.k1(pr: J.Val & J.Val) -> J.Val:
  (+s, +ret) = pr
  J.set(J.set(J.obj(), "s", s), "ret", ret)
def case.pastimes.surf.Surf.step(+i: J.Val) -> J.Val:
  pastimes.case.out(pastimes.surf.Surf.step(J.get(i, "s"), J.get(i, "input"), gb.b(i, "tapped"), gb.u(i, "wave")))
def case.pastimes.halfpipe.Halfpipe.step(+i: J.Val) -> J.Val:
  pastimes.case.out(pastimes.halfpipe.Halfpipe.step(J.get(i, "s"), J.get(i, "input"), gb.b(i, "tapped"), gb.i(i, "direction")))
def case.pastimes.halfpipe.Halfpipe.tick_vfx(+i: J.Val) -> J.Val:
  J.set(J.obj(), "s", pastimes.halfpipe.Halfpipe.tick_vfx(J.get(i, "s")))
def case.pastimes.volley.Volley.step(+i: J.Val) -> J.Val:
  pastimes.case.out(pastimes.volley.Volley.step(J.get(i, "s"), J.get(i, "input"), gb.b(i, "tapped")))
def case.pastimes.duckshoot.DuckShoot.step(+i: J.Val) -> J.Val:
  pastimes.case.out(pastimes.duckshoot.DuckShoot.step(J.get(i, "s"), J.get(i, "input"), gb.b(i, "tapped")))
def case.pastimes.chariot.Chariot.step(+i: J.Val) -> J.Val:
  pastimes.case.out(pastimes.chariot.Chariot.step(J.get(i, "s"), J.get(i, "input"), gb.b(i, "tapped")))
