# Surf::step: one tick of the wave; Some(cleared) when a wave breaks.
def pastimes.surf.Surf.step(+s: J.Val, +input: J.Val, +tapped: Bool, +wave: U32) -> J.Val & J.Val:
  +axis = gb.axis(input, "aim_x", "move_x")
  +push = Bool.pick(U32, RS.i_lt(axis, 0), RS.i_neg(4), Bool.pick(U32, RS.i_gt(axis, 0), 4, 0))
  +lean = RS.i_clamp(RS.i_add(gb.i(s, "lean"), push), RS.i_neg(100), 100)
  +target = pastimes.surf.WAVE_LEANS(wave)
  +phase = gb.u(s, "phase")
  +crest = U32.is_ge(phase, 75)
  +near = RS.i_le(RS.i_abs(RS.i_sub(lean, target)), 16)
  +brace = Bool.and(Bool.and(tapped, crest), near)
  +braced = Bool.or(gb.b(s, "braced"), brace)
  +s1 = gb.su(gb.sb(gb.si(s, "lean", lean), "braced", braced), "brace_flash", gb.ssub(Bool.pick(U32, brace, 4, gb.u(s, "brace_flash")), 1))
  +s2 = gb.su(gb.su(s1, "crest_glow", gb.ssub(Bool.pick(U32, crest, 6, gb.u(s, "crest_glow")), 1)), "splash", gb.ssub(gb.u(s, "splash"), 1))
  +s3 = gb.su(s2, "spray", Bool.pick(U32, near, 2, gb.ssub(gb.u(s, "spray"), 1)))
  +s4 = gb.su(s3, "phase", (phase + 1 : U32))
  pastimes.surf.Surf.step.k1(U32.is_lt((phase + 1 : U32), 90), phase, near, braced, s4)

