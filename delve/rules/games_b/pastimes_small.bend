# The rival `i..3` to stun: lowest distance among those ahead in reach, or 3.
def pastimes.chariot.target(+c: J.Val, +i: U32, +best: U32) -> U32:
  match i:
    case 3:
      best
    case _:
      +r = gb.ag(J.get(c, "rivals"), i)
      +d = gb.u(c, "distance")
      +ok = Bool.and(Bool.and(U32.is_ge(r, d), U32.is_lt((r - d : U32), 640)), U32.is_lt(RS.u_abs_diff(gb.u(c, "lane"), (i * 256 : U32)), 90))
      +better = Bool.and(ok, Bool.or(U32.is_eq(best, 3), U32.is_lt(r, gb.ag(J.get(c, "rivals"), best))))
      pastimes.chariot.target(c, (i + 1 : U32), Bool.pick(U32, better, i, best))
def pastimes.chariot.Chariot.step.drive(+c: J.Val, +throttle: U32) -> J.Val & J.Val:
  +bog = gb.u(c, "bog")
  +target = Bool.pick(U32, U32.is_gt(bog, 0), 6, Bool.pick(U32, RS.i_lt(throttle, 0), 20, Bool.pick(U32, RS.i_gt(throttle, 0), 8, 15)))
  +speed0 = gb.u(c, "speed")
  +speed = Bool.pick(U32, U32.is_lt(speed0, target), (speed0 + 1 : U32), U32.max(gb.ssub(speed0, 1), target))
  +before = gb.u(c, "distance")
  +distance = U32.min(gb.sadd(before, speed), 12288)
  +c1 = gb.su(gb.su(gb.su(c, "speed", speed), "bog", gb.ssub(bog, 1)), "distance", distance)
  +c2 = pastimes.chariot.barrels(c1, before, distance, 0, 0)
  +c3 = Bool.pick(J.Val, U32.is_gt(U32.div(distance, 4096), U32.div(before, 4096)), gb.su(c2, "cabbages", 3), c2)
  pastimes.chariot.Chariot.step.drive.k1(U32.is_eq(distance, 12288), distance, c3)

def pastimes.chariot.Chariot.step.drive.k1(cv: Bool, +distance: U32, +c3: J.Val) -> J.Val & J.Val:
  match cv:
    case True{}:
      (c3, J.JU{1})
    case False{}:
