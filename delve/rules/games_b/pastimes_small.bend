# Chariot::step -> (self, result): 1 home, -1 outraced, 0 racing.
def pastimes.chariot.Chariot.step(+c: J.Val, +input: J.Val, +tapped: Bool) -> J.Val & J.Val:
  +steer = RS.i_signum(gb.axis(input, "aim_x", "move_x"))
