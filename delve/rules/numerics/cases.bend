# numerics case wrappers (generated by delve/tests/numerics/gen_wrappers.py)
# Floats ride the case files as JSON floats, or "nan" / "inf" / "-inf".

def numerics.cases.in_f.s(is_nan: Bool, is_nnan: Bool, is_inf: Bool, is_ninf: Bool) -> F32:
  Bool.pick(F32, is_nan, numerics.cases.nan(), Bool.pick(F32, is_nnan, RS.f_from_bits(4290772992), Bool.pick(F32, is_inf, numerics.cases.inf(), numerics.cases.ninf())))

def numerics.cases.nan() -> F32:
  RS.f_from_bits(2143289344)

def numerics.cases.inf() -> F32:
  RS.f_from_bits(2139095040)

def numerics.cases.ninf() -> F32:
  RS.f_from_bits(4286578688)

def numerics.cases.in_f(+v: J.Val) -> F32:
  match v:
    case J.JS{+s}:
      numerics.cases.in_f.s(String.eq(s, "nan"), String.eq(s, "-nan"), String.eq(s, "inf"), String.eq(s, "-inf"))
    case _:
      J.f32(v)

def numerics.cases.out_f.k(is_nan: Bool, is_inf: Bool, is_ninf: Bool, +x: F32) -> J.Val:
  match is_nan:
    case True{}:
      J.JS{"nan"}
    case False{}:
      numerics.cases.out_f.i(is_inf, is_ninf, x)

def numerics.cases.out_f.i(is_inf: Bool, is_ninf: Bool, +x: F32) -> J.Val:
  match is_inf:
    case True{}:
      J.JS{"inf"}
    case False{}:
      numerics.cases.out_f.n(is_ninf, x)

def numerics.cases.out_f.n(is_ninf: Bool, +x: F32) -> J.Val:
  match is_ninf:
    case True{}:
      J.JS{"-inf"}
    case False{}:
      J.JF{x}

def numerics.cases.out_mu(+m: Maybe<&2, U32>) -> J.Val:
  match m:
    case Some{+v}:
      J.of_u32(v)
    case None{}:
      J.JNull{}

def numerics.cases.out_mw(+m: Maybe<&2, W.W>) -> J.Val:
  match m:
    case Some{+v}:
      W.to_j(v)
    case None{}:
      J.JNull{}

def numerics.cases.out_c(c: Cmp) -> J.Val:
  match c:
    case LT{}:
      J.of_i32(4294967295)
    case EQ{}:
      J.JU{0}
    case GT{}:
      J.JU{1}

def numerics.cases.out_f(+x: F32) -> J.Val:
  numerics.cases.out_f.k(RS.f_is_nan(x), F32.is_eq(x, numerics.cases.inf()), F32.is_eq(x, numerics.cases.ninf()), x)

